[67.450223, "o", "sed -n '1,200p' environment/codebase/reproduction_result.json\r\n\u001b[?2004l\r"]
[67.451039, "o", "{\r\n  \"runnable\": false,\r\n  \"result_same\": false,\r\n  \"comparison_tolerance\": null,\r\n  \"problems\": {},\r\n  \"error\": \"ValueError: mutable default <class 'config.TrainingConfig'> for field training is not allowed: use default_factory\",\r\n  \"mismatches\": []\r\n"]
[67.451065, "o", "}\r\n"]
