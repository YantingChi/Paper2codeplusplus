[368.149377, "o", "{\r\n  \"runnable\": true,\r\n  \"result_same\": false,\r\n  \"comparison_tolerance\": 1e-06,\r\n  \"problems\": {\r\n    \"Townsend\": {\r\n      \"cases\": [\r\n        {\r\n          \"iteration\": 1,\r\n          \"candidate\": [\r\n            -1.0,\r\n            0.25\r\n          ],\r\n          \"feasible\": false,\r\n          \"objective\": null\r\n        },\r\n        {\r\n"]
[368.149392, "o", "          \"iteration\": 2,\r\n          \"candidate\": [\r\n            1.5,\r\n            1.5\r\n          ],\r\n          \"feasible\": true,\r\n          \"objective\": 0.16425371170043945\r\n        },\r\n        {\r\n          \"iteration\": 3,\r\n          \"candidate\": [\r\n            -2.0,\r\n            -2.0\r\n          ],\r\n          \"feasible\": false,\r\n          \"objective\": null\r\n        },\r\n        {\r\n          \"iteration\": 4,\r\n          \"candidate\": [\r\n"]
[368.149443, "o", "            -2.0,\r\n            1.5\r\n          ],\r\n          \"feasible\": false,\r\n          \"objective\": null\r\n        },\r\n        {\r\n          \"iteration\": 5,\r\n          \"candidate\": [\r\n            0.0,\r\n            1.7\r\n          ],\r\n          \"feasible\": true,\r\n          \"objective\": -0.9713773727416992\r\n        },\r\n        {\r\n          \"iteration\": 6,\r\n          \"candidate\": [\r\n            2.2,\r\n            1.6\r\n          ],\r\n          \"feasible\": true,\r\n          \"objective\": -3.0226582288742065\r\n        }\r\n      ],\r\n      \"metrics\": {\r\n        \"best_objective\": -3.0226582288742065,\r\n        \"feasibility_ratio\": 0.5,\r\n        \"total_evaluations\": 6\r\n      }\r\n    },\r\n    \"Simionescu\": {\r\n      \"cases\": [\r\n        {\r\n          \"iteration\": 1,\r\n          \"candidate\": [\r\n            0.0,\r\n            0.0\r\n          ],\r\n          \"feasible\": true,\r\n          \"objective\": 0.0\r\n        },\r\n        {\r\n          \"iteration\": 2,\r\n          \"candidate\": [\r\n            0.9,\r\n            0.0\r\n          ],\r\n          \"feasible\": false,\r\n          \"objective\": null\r\n        },\r\n        {\r\n          \"iteration\": 3,\r\n          \"candidate\": [\r\n            1.1,\r\n            0.0\r\n          ],\r\n          \"feasible\": false,\r\n          \"objective\": null\r\n        },\r\n        {\r\n          \"iteration\": 4,\r\n          \"candidate\": [\r\n            0.5,\r\n            0.5\r\n          ],\r\n          \"feasible\": true,\r\n          \"objective\": 0.02500000037252903\r\n        },\r\n        {\r\n          \"iteration\": 5,\r\n"]
[368.149491, "o", "          \"candidate\": [\r\n            1.0,\r\n            0.5\r\n          ],\r\n          \"feasible\": true,\r\n          \"objective\": 0.30000001192092896\r\n        },\r\n        {\r\n          \"iteration\": 6,\r\n          \"candidate\": [\r\n            -0.8,\r\n            0.4\r\n          ],\r\n          \"feasible\": true,\r\n          \"objective\": 1.408000111579895\r\n        }\r\n      ],\r\n      \"metrics\": {\r\n        \"best_objective\": 0.0,\r\n        \"feasibility_ratio\": 0.6666666666666666,\r\n        \"total_evaluations\": 6\r\n      }\r\n    },\r\n    \"LSQ\": {\r\n      \"cases\": [\r\n        {\r\n          \"iteration\": 1,\r\n          \"candidate\": [\r\n            0.1,\r\n            0.1\r\n          ],\r\n          \"feasible\": true,\r\n          \"objective\": 0.20000000298023224\r\n        },\r\n        {\r\n          \"iteration\": 2,\r\n          \"candidate\": [\r\n            0.6,\r\n            0.1\r\n          ],\r\n          \"feasible\": true,\r\n          \"objective\": 0.7000000476837158\r\n        },\r\n        {\r\n          \"iteration\": 3,\r\n          \"candidate\": [\r\n            0.2,\r\n            0.6\r\n          ],\r\n          \"feasible\": true,\r\n          \"objective\": 0.800000011920929\r\n        },\r\n        {\r\n          \"iteration\": 4,\r\n          \"candidate\": [\r\n            0.8,\r\n            0.7\r\n          ],\r\n          \"feasible\": false,\r\n          \"objective\": null\r\n        },\r\n        {\r\n          \"iteration\": 5,\r\n          \"candidate\": [\r\n            0.5,\r\n            0.5\r\n          ],\r\n          \"feasible\": true,\r\n          \"objective\": 1.0\r\n"]
