[368.149537, "o", "  \"error\": null,\r\n  \"mismatches\": [\r\n    \"Townsend: feasibility mismatch at case 1\",\r\n    \"Townsend: objective mismatch at case 1\",\r\n    \"Townsend: feasibility mismatch at case 5\",\r\n    \"Townsend: objective mismatch at case 5\",\r\n    \"Townsend: feasibility mismatch at case 6\",\r\n    \"Townsend: objective mismatch at case 6\",\r\n    \"Townsend: metric mismatch for best_objective\",\r\n    \"Townsend: metric mismatch for feasibility_ratio\",\r\n    \"Simionescu: feasibility mismatch at case 2\",\r\n    \"Simionescu: objective mismatch at case 2\",\r\n    \"Simionescu: feasibility mismatch at case 3\",\r\n    \"Simionescu: objective mismatch at case 3\",\r\n    \"Simionescu: feasibility mismatch at case 5\",\r\n    \"Simionescu: objective mismatch at case 5\",\r\n    \"Simionescu: feasibility mismatch at case 6\",\r\n    \"Simionescu: objective mismatch at case 6\",\r\n    \"LSQ: feasibility mismatch at case 1\",\r\n    \"LSQ: objective mismatch at case 1\",\r\n    \"LSQ: feasibility mismatch at case 2\",\r\n    \"LSQ: objective mismatch at case 2\",\r\n    \"LSQ: feasibility mismatch at case 3\",\r\n    \"LSQ: objective mismatch at case 3\",\r\n    \"LSQ: feasibility mismatch at case 4\",\r\n    \"LSQ: objective mismatch at case 4\",\r\n    \"LSQ: metric mismatch for best_objective\",\r\n    \"LSQ: metric mismatch for feasibility_ratio\"\r\n  ]\r\n}\r\n"]
