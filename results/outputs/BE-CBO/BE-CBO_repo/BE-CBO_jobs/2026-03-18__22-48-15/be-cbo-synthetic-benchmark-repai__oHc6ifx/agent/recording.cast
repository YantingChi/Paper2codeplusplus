[199.796084, "o", "-        elif self.problem_name == \"Simionescu\":\r\n\u001b[?2004l\r"]
[199.796094, "o", "\u001b[?2004h> "]
[199.796149, "o", "-            # c(x) = (r_T + r_S cos(n theta))^2 - x1^2 - x2^2 >= 0\r\n\u001b[?2004l\r"]
[199.796169, "o", "\u001b[?2004h> "]
[199.796208, "o", "-            # r_T = 1, r_S = 0.2, n = 8, theta = atan2(x1, x2)\r\n\u001b[?2004l\r"]
[199.796229, "o", "\u001b[?2004h> "]
[199.79625, "o", "-            r_T, r_S, n = 1.0, 0.2, 8.0\r\n\u001b[?2004l\r"]
[199.796271, "o", "\u001b[?2004h> "]
[199.796317, "o", "-            theta = math.atan2(x2, x1)  # BUG: arguments were flipped\r\n\u001b[?2004l\r"]
[199.796336, "o", "\u001b[?2004h> "]
[199.796364, "o", "-            R = r_T + r_S * math.cos(n * theta)\r\n\u001b[?2004l\r"]
[199.796384, "o", "\u001b[?2004h> "]
[199.79641, "o", "-            c = R ** 2 - (x1 ** 2 + x2 ** 2)\r\n\u001b[?2004l\r"]
[199.796429, "o", "\u001b[?2004h> "]
[199.796468, "o", "-            return c < 0  # BUG: strict and wrong direction\r\n\u001b[?2004l\r"]
[199.796488, "o", "\u001b[?2004h> "]
[199.796511, "o", "-        elif self.problem_name == \"LSQ\":\r\n\u001b[?2004l\r"]
[199.796521, "o", "\u001b[?2004h> "]
[199.796579, "o", "-            # c1(x) = x1 + 2 x2 + 0.5 sin(2 pi (x1^2 - 2 x2)) - 1.5 >= 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.796599, "o", "> "]
[199.796623, "o", "-            # c2(x) = 1.5 - x1^2 - x2^2 >= 0\r\n\u001b[?2004l\r"]
[199.796643, "o", "\u001b[?2004h> "]
[199.796701, "o", "-            c1 = x1 + 2 * x2 + 0.5 * math.sin(2 * math.pi * (x1 ** 2 - 2 * x2)) - 1.5\r\n\u001b[?2004l\r"]
[199.79672, "o", "\u001b[?2004h> "]
[199.796745, "o", "-            c2 = 1.5 - (x1 ** 2 + x2 ** 2)\r\n\u001b[?2004l\r"]
[199.796765, "o", "\u001b[?2004h> "]
[199.796815, "o", "-            return (c1 <= 0) or (c2 <= 0)  # BUG: wrong logic and direction\r\n\u001b[?2004l\r"]
[199.796836, "o", "\u001b[?2004h> "]
[199.79686, "o", "-        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.796869, "o", "-            return True\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.796925, "o", "+    def _constraint_feasible(self, x: torch.Tensor) -> bool:\r\n\u001b[?2004l\r"]
[199.796945, "o", "\u001b[?2004h> "]
[199.796987, "o", "+        \"\"\"Return True if x satisfies the hidden constraint(s).\"\"\"\r\n\u001b[?2004l\r"]
[199.797008, "o", "\u001b[?2004h> "]
[199.797032, "o", "+        x1 = float(x[0])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.797066, "o", "+        x2 = float(x[1]) if x.numel() > 1 else 0.0\r\n\u001b[?2004l\r"]
[199.797089, "o", "\u001b[?2004h> "]
[199.797114, "o", "+        # Enforce box bounds first\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.797199, "o", "+        if not torch.all(x >= self.lower_bounds).item() or not torch.all(x <= self.upper_bounds).item():\r\n\u001b[?2004l\r"]
[199.79722, "o", "\u001b[?2004h> "]
[199.797244, "o", "+            return False\r\n\u001b[?2004l\r"]
[199.797267, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.797292, "o", "+        if self.problem_name == \"Townsend\":\r\n\u001b[?2004l\r"]
[199.797313, "o", "\u001b[?2004h> "]
[199.797355, "o", "+            # Appendix B.1.1 constraint region: r^2 <= R(t)^2 where\r\n\u001b[?2004l\r"]
[199.797375, "o", "\u001b[?2004h> "]
[199.797438, "o", "+            # R(t)^2 = (2 cos t - 0.5 cos 2t - 0.25 cos 3t - 0.125 cos 4t)^2 + (2 sin t)^2\r\n\u001b[?2004l\r"]
[199.797458, "o", "\u001b[?2004h> "]
[199.797501, "o", "+            # with t = atan2(x1, x2) (note the order: y=x1, x=x2)\r\n\u001b[?2004l\r"]
[199.797521, "o", "\u001b[?2004h> "]
[199.797542, "o", "+            t = math.atan2(x1, x2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.797553, "o", "> "]
[199.797643, "o", "+            R2 = (2 * math.cos(t) - 0.5 * math.cos(2 * t) - 0.25 * math.cos(3 * t) - 0.125 * math.cos(4 * t)) ** 2 \\\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.797652, "o", "> "]
[199.797689, "o", "+                 + (2 * math.sin(t)) ** 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.797726, "o", "+            c = R2 - (x1 ** 2 + x2 ** 2)\r\n\u001b[?2004l\r"]
[199.797737, "o", "\u001b[?2004h> "]
[199.79777, "o", "+            return c >= 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.797806, "o", "+        elif self.problem_name == \"Simionescu\":\r\n\u001b[?2004l\r"]
[199.797826, "o", "\u001b[?2004h> "]
[199.797885, "o", "+            # Appendix B.1.1: r^2 <= (r_T + r_S cos(n theta))^2, theta = atan2(x1, x2)\r\n\u001b[?2004l\r"]
[199.797905, "o", "\u001b[?2004h> "]
[199.797927, "o", "+            r_T, r_S, n = 1.0, 0.2, 8.0\r\n\u001b[?2004l\r"]
[199.797947, "o", "\u001b[?2004h> "]
[199.797968, "o", "+            theta = math.atan2(x1, x2)\r\n\u001b[?2004l\r"]
[199.797989, "o", "\u001b[?2004h> "]
[199.798015, "o", "+            R = r_T + r_S * math.cos(n * theta)\r\n\u001b[?2004l\r"]
[199.798035, "o", "\u001b[?2004h> "]
[199.798061, "o", "+            c = R ** 2 - (x1 ** 2 + x2 ** 2)\r\n\u001b[?2004l\r"]
[199.798071, "o", "\u001b[?2004h> "]
[199.798104, "o", "+            return c >= 0.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.798136, "o", "+        elif self.problem_name == \"LSQ\":\r\n\u001b[?2004l\r"]
[199.798145, "o", "\u001b[?2004h> "]
[199.798206, "o", "+            # Appendix B.1.1: both constraints must be satisfied (>= 0)\r\n\u001b[?2004l\r"]
[199.798215, "o", "\u001b[?2004h> "]
[199.798284, "o", "+            c1 = x1 + 2 * x2 + 0.5 * math.sin(2 * math.pi * (x1 ** 2 - 2 * x2)) - 1.5\r\n\u001b[?2004l\r"]
[199.798293, "o", "\u001b[?2004h> "]
[199.798329, "o", "+            c2 = 1.5 - (x1 ** 2 + x2 ** 2)\r\n\u001b[?2004l\r"]
[199.798338, "o", "\u001b[?2004h> "]
[199.798377, "o", "+            return (c1 >= 0.0) and (c2 >= 0.0)\r\n\u001b[?2004l\r"]
[199.798386, "o", "\u001b[?2004h> "]
[199.798407, "o", "+        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.798425, "o", "+            return True\r\n\u001b[?2004l\r"]
[199.798433, "o", "\u001b[?2004h> @@\r\n\u001b[?2004l\r"]
[199.798442, "o", "\u001b[?2004h> "]
[199.798502, "o", "-    def evaluate(self, x_list: Tuple[float, ...]) -> Dict[str, Any]:\r\n\u001b[?2004l\r"]
[199.798511, "o", "\u001b[?2004h> "]
[199.798568, "o", "+    def evaluate(self, x_list: Tuple[float, ...]) -> Dict[str, Any]:\r\n\u001b[?2004l\r"]
[199.798577, "o", "\u001b[?2004h> "]
[199.798585, "o", "         \"\"\"\r\n\u001b[?2004l\r"]
[199.798608, "o", "\u001b[?2004h> "]
[199.798624, "o", "         Evaluate a candidate point.\r\n\u001b[?2004l\r"]
[199.798633, "o", "\u001b[?2004h> @@\r\n\u001b[?2004l\r"]
[199.798641, "o", "\u001b[?2004h> "]
[199.798685, "o", "-        feasible = self._constraint_feasible(x)\r\n\u001b[?2004l\r"]
[199.798694, "o", "\u001b[?2004h> "]
[199.798714, "o", "-        if not feasible:\r\n\u001b[?2004l\r\u001b[?2004h"]
[199.798723, "o", "> "]
[199.798802, "o", "-            self.logger.info(f\"Candidate {candidate} is infeasible as per constraint evaluation.\")\r\n\u001b[?2004l\r"]
[199.798811, "o", "\u001b[?2004h> "]
[199.798878, "o", "-            return {\"candidate\": candidate, \"feasible\": False, \"objective\": None}\r\n\u001b[?2004l\r"]
[199.798886, "o", "\u001b[?2004h> "]
[199.798925, "o", "+        feasible = self._constraint_feasible(x)\r\n\u001b[?2004l\r"]
[199.79894, "o", "\u001b[?2004h> "]
[199.798954, "o", "+        if not feasible:\r\n\u001b[?2004l\r"]
[199.798963, "o", "\u001b[?2004h> "]
[199.799044, "o", "+            self.logger.info(f\"Candidate {candidate} is infeasible as per constraint evaluation.\")\r\n\u001b[?2004l\r"]
[199.799053, "o", "\u001b[?2004h> "]
[199.799118, "o", "+            return {\"candidate\": candidate, \"feasible\": False, \"objective\": None}\r\n\u001b[?2004l\r"]
[199.799127, "o", "\u001b[?2004h> @@\r\n\u001b[?2004l\r"]
[199.799136, "o", "\u001b[?2004h> "]
[199.799175, "o", "-        objective_value = self._objective(x)\r\n\u001b[?2004l\r"]
[199.79919, "o", "\u001b[?2004h> "]
[199.799222, "o", "+        objective_value = self._objective(x)\r\n\u001b[?2004l\r"]
[199.79923, "o", "\u001b[?2004h> "]
[199.79931, "o", "         return {\"candidate\": candidate, \"feasible\": True, \"objective\": float(objective_value)}\r\n\u001b[?2004l\r"]
[199.799319, "o", "\u001b[?2004h> "]
[199.799338, "o", "*** End Patch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[199.799347, "o", "PATCH\r\n\u001b[?2004l\r"]
