[44.428575, "o", "{\r\n  \"comparison_tolerance\": 1e-06,\r\n  \"problems\": {\r\n    \"Townsend\": {\r\n"]
[44.428594, "o", "      \"points\": [\r\n        [-1.0, 0.25],\r\n        [1.5, 1.5],\r\n        [-2.0, -2.0],\r\n        [-2.0, 1.5],\r\n        [0.0, 1.7],\r\n        [2.2, 1.6]\r\n      ]\r\n    },\r\n    \"Simionescu\": {\r\n      \"points\": [\r\n        [0.0, 0.0],\r\n        [0.9, 0.0],\r\n        [1.1, 0.0],\r\n        [0.5, 0.5],\r\n        [1.0, 0.5],\r\n        [-0.8, 0.4]\r\n      ]\r\n"]
[44.428614, "o", "    },\r\n    \"LSQ\": {\r\n      \"points\": [\r\n        [0.1, 0.1],\r\n        [0.6, 0.1],\r\n        [0.2, 0.6],\r\n        [0.8, 0.7],\r\n        [0.5, 0.5],\r\n        [0.9, 0.2]\r\n      ]\r\n    }\r\n  }\r\n}\r\n"]
