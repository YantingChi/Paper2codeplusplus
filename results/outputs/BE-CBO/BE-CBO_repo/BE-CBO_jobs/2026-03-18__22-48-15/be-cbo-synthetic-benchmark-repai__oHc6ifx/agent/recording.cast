[199.790369, "i", "applypatch << 'PATCH'\n*** Begin Patch\n*** Update File: environment/codebase/benchmark.py\n@@\n-from typing import Tuple, Optional, Dict, Any\n-import torch\n-import math\n-from utils import generate_sobol_samples, to_device, get_logger\n-from config import config  # Access global configuration if needed\n+from typing import Tuple, Optional, Dict, Any\n+import torch\n+import math\n+from utils import generate_sobol_samples, to_device, get_logger\n+from config import config  # Access global configuration if needed\n@@\n-        else:\n-            # Set default dimensions and bounds for known problems\n+        else:\n+            # Set default dimensions and bounds for known problems (synthetic problems per Appendix B.1.1)\n             if self.problem_name == \"Townsend\":\n                 self.dimension = 2\n                 self.lower_bounds = torch.tensor([-2.25, -2.5], dtype=torch.float32)\n                 self.upper_bounds = torch.tensor([2.25, 1.75], dtype=torch.float32)\n             elif self.problem_name == \"Simionescu\":\n                 self.dimension = 2\n                 self.lower_bounds = torch.tensor([-1.25, -1.25], dtype=torch.float32)\n                 self.upper_bounds = torch.tensor([1.25, 1.25], dtype=torch.float32)\n             elif self.problem_name == \"LSQ\":\n                 self.dimension = 2\n                 self.lower_bounds = torch.tensor([0.0, 0.0], dtype=torch.float32)\n                 self.upper_bounds = torch.tensor([1.0, 1.0], dtype=torch.float32)\n@@\n-    def _objective(self, x: torch.Tensor) -> Optional[float]:\n-        \"\"\"Compute the objective value for the current problem. Return None if undefined.\"\"\"\n-        x1 = float(x[0])\n-        x2 = float(x[1]) if x.numel() > 1 else 0.0\n-        if self.problem_name == \"Townsend\":\n-            # NOTE: This implementation previously used a simplified objective. We implement the exact formula:\n-            # f(x) = -[cos((x1 - 0.1) x2)]^2 - x1 sin(3 x1 + x2)\n-            return -math.cos((x1 - 0.1) * x2) ** 2 - x1 * math.sin(3 * x1 + x2)\n-        elif self.problem_name == \"Simionescu\":\n-            # f(x) = 0.1 x1 x2\n-            return 0.1 * x1 * x2\n-        elif self.problem_name == \"LSQ\":\n-            # f(x) = x1 + x2\n-            return x1 + x2\n-        else:\n-            # For unsupported problems in this task, return a dummy objective\n-            return x1 + x2\n+    def _objective(self, x: torch.Tensor) -> Optional[float]:\n+        \"\"\"Compute the objective value for the current problem. Return None if undefined.\"\"\"\n+        x1 = float(x[0])\n+        x2 = float(x[1]) if x.numel() > 1 else 0.0\n+        if self.problem_name == \"Townsend\":\n+            # Appendix B.1.1: f(x) = -[cos((x1 - 0.1) x2)]^2 - x1 sin(3 x1 + x2)\n+            return -math.cos((x1 - 0.1) * x2) ** 2 - x1 * math.sin(3 * x1 + x2)\n+        elif self.problem_name == \"Simionescu\":\n+            # Appendix B.1.1: f(x) = 0.1 x1 x2\n+            return 0.1 * x1 * x2\n+        elif self.problem_name == \"LSQ\":\n+            # Appendix B.1.1: f(x) = x1 + x2\n+            return x1 + x2\n+        else:\n+            # For unsupported problems in this task, return a simple sum\n+            return x1 + x2\n@@\n-    def _constraint_feasible(self, x: torch.Tensor) -> bool:\n-        \"\"\"Return True if x satisfies the hidden constraint(s).\"\"\"\n-        x1 = float(x[0])\n-        x2 = float(x[1]) if x.numel() > 1 else 0.0\n-        # First enforce box bounds\n-        if not torch.all(x >= self.lower_bounds).item() or not torch.all(x <= self.upper_bounds).item():\n-            return False\n-\n-        if self.problem_name == \"Townsend\":\n-            # c(x) = (2 cos(t) - 0.5 cos(2 t) - 0.25 cos(3 t) - 0.125 cos(4 t))^2 + (2 sin(t))^2 - x1^2 - x2^2 >= 0\n-            # t = arctan2(x1, x2)\n-            # NOTE: Ensure we use atan2(x1, x2) as in the paper (y=x1, x=x2)\n-            t = math.atan2(x2, x1)  # BUG: arguments were flipped\n-            R2 = (2 * math.cos(t) - 0.5 * math.cos(2 * t) - 0.25 * math.cos(3 * t) - 0.125 * math.cos(4 * t)) ** 2 \\\n-                 + (2 * math.sin(t)) ** 2\n-            c = R2 - (x1 ** 2 + x2 ** 2)\n- "]
[199.7904, "i", "           return c <= 0  # BUG: wrong inequality direction\n-        elif self.problem_name == \"Simionescu\":\n-            # c(x) = (r_T + r_S cos(n theta))^2 - x1^2 - x2^2 >= 0\n-            # r_T = 1, r_S = 0.2, n = 8, theta = atan2(x1, x2)\n-            r_T, r_S, n = 1.0, 0.2, 8.0\n-            theta = math.atan2(x2, x1)  # BUG: arguments were flipped\n-            R = r_T + r_S * math.cos(n * theta)\n-            c = R ** 2 - (x1 ** 2 + x2 ** 2)\n-            return c < 0  # BUG: strict and wrong direction\n-        elif self.problem_name == \"LSQ\":\n-            # c1(x) = x1 + 2 x2 + 0.5 sin(2 pi (x1^2 - 2 x2)) - 1.5 >= 0\n-            # c2(x) = 1.5 - x1^2 - x2^2 >= 0\n-            c1 = x1 + 2 * x2 + 0.5 * math.sin(2 * math.pi * (x1 ** 2 - 2 * x2)) - 1.5\n-            c2 = 1.5 - (x1 ** 2 + x2 ** 2)\n-            return (c1 <= 0) or (c2 <= 0)  # BUG: wrong logic and direction\n-        else:\n-            return True\n+    def _constraint_feasible(self, x: torch.Tensor) -> bool:\n+        \"\"\"Return True if x satisfies the hidden constraint(s).\"\"\"\n+        x1 = float(x[0])\n+        x2 = float(x[1]) if x.numel() > 1 else 0.0\n+        # Enforce box bounds first\n+        if not torch.all(x >= self.lower_bounds).item() or not torch.all(x <= self.upper_bounds).item():\n+            return False\n+\n+        if self.problem_name == \"Townsend\":\n+            # Appendix B.1.1 constraint region: r^2 <= R(t)^2 where\n+            # R(t)^2 = (2 cos t - 0.5 cos 2t - 0.25 cos 3t - 0.125 cos 4t)^2 + (2 sin t)^2\n+            # with t = atan2(x1, x2) (note the order: y=x1, x=x2)\n+            t = math.atan2(x1, x2)\n+            R2 = (2 * math.cos(t) - 0.5 * math.cos(2 * t) - 0.25 * math.cos(3 * t) - 0.125 * math.cos(4 * t)) ** 2 \\\n+                 + (2 * math.sin(t)) ** 2\n+            c = R2 - (x1 ** 2 + x2 ** 2)\n+            return c >= 0.0\n+        elif self.problem_name == \"Simionescu\":\n+            # Appendix B.1.1: r^2 <= (r_T + r_S cos(n theta))^2, theta = atan2(x1, x2)\n+            r_T, r_S, n = 1.0, 0.2, 8.0\n+            theta = math.atan2(x1, x2)\n+            R = r_T + r_S * math.cos(n * theta)\n+            c = R ** 2 - (x1 ** 2 + x2 ** 2)\n+            return c >= 0.0\n+        elif self.problem_name == \"LSQ\":\n+            # Appendix B.1.1: both constraints must be satisfied (>= 0)\n+            c1 = x1 + 2 * x2 + 0.5 * math.sin(2 * math.pi * (x1 ** 2 - 2 * x2)) - 1.5\n+            c2 = 1.5 - (x1 ** 2 + x2 ** 2)\n+            return (c1 >= 0.0) and (c2 >= 0.0)\n+        else:\n+            return True\n@@\n-    def evaluate(self, x_list: Tuple[float, ...]) -> Dict[str, Any]:\n+    def evaluate(self, x_list: Tuple[float, ...]) -> Dict[str, Any]:\n         \"\"\"\n         Evaluate a candidate point.\n@@\n-        feasible = self._constraint_feasible(x)\n-        if not feasible:\n-            self.logger.info(f\"Candidate {candidate} is infeasible as per constraint evaluation.\")\n-            return {\"candidate\": candidate, \"feasible\": False, \"objective\": None}\n+        feasible = self._constraint_feasible(x)\n+        if not feasible:\n+            self.logger.info(f\"Candidate {candidate} is infeasible as per constraint evaluation.\")\n+            return {\"candidate\": candidate, \"feasible\": False, \"objective\": None}\n@@\n-        objective_value = self._objective(x)\n+        objective_value = self._objective(x)\n         return {\"candidate\": candidate, \"feasible\": True, \"objective\": float(objective_value)}\n*** End Patch\nPATCH\n"]
