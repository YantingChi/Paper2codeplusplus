[246.395965, "o", "      }\r\n    },\r\n    \"LSQ\": {\r\n      \"cases\": [\r\n        {\r\n          \"iteration\": 1,\r\n          \"candidate\": [\r\n            0.1,\r\n            0.1\r\n          ],\r\n"]
[246.395979, "o", "          \"feasible\": true,\r\n          \"objective\": 0.20000000298023224\r\n        },\r\n        {\r\n          \"iteration\": 2,\r\n          \"candidate\": [\r\n            0.6,\r\n            0.1\r\n          ],\r\n          \"feasible\": true,\r\n          \"objective\": 0.7000000476837158\r\n"]
[246.395996, "o", "        },\r\n        {\r\n          \"iteration\": 3,\r\n          \"candidate\": [\r\n            0.2,\r\n            0.6\r\n          ],\r\n          \"feasible\": true,\r\n          \"objective\": 0.800000011920929\r\n        },\r\n        {\r\n          \"iteration\": 4,\r\n          \"candidate\": ["]
