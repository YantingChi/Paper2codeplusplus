[416.910207, "o", "pts = [(-1.0,0.25),(1.5,1.5),(-2.0,-2.0),(-2.0,1.5),(0.0,1.7),(2.2,1.6)]\r\n\u001b[?2004l\r"]
[416.910215, "o", "\u001b[?2004h> "]
[416.910226, "o", "for p in pts:\r\n\u001b[?2004l\r"]
[416.910241, "o", "\u001b[?2004h> "]
[416.910268, "o", "    feas,c,R2 = townsend_feasible(*p)\r\n\u001b[?2004l\r"]
[416.910276, "o", "\u001b[?2004h> "]
[416.910296, "o", "    f = townsend_obj(*p)\r\n\u001b[?2004l\r"]
[416.910303, "o", "\u001b[?2004h> "]
[416.910347, "o", "    print(p, 'feasible=', feas, 'c=', c, 'obj=', f)\r\n\u001b[?2004l\r"]
[416.910357, "o", "\u001b[?2004h> "]
[416.910365, "o", "PY\r\n\u001b[?2004l\r"]
[416.917364, "o", "(-1.0, 0.25) feasible= True c= "]
[416.917372, "o", "3.75128566844732 obj= -1.3079232530820846\r\n(1.5, 1.5) feasible= True "]
[416.917378, "o", "c= 0.44462256441743264 obj= 0.16425365796873892"]
[416.91739, "o", "\r\n(-2.0, -2.0) feasible= False "]
[416.917398, "o", "c= -3.8508725644174326 obj= -2.219072166188421\r\n(-2.0, 1.5) feasible= False "]
[416.917407, "o", "c= -0.869615640000001 obj= 0.9551309171384864\r\n"]
[416.917417, "o", "(0.0, 1.7) feasible= False c= -1.6243749999999997 obj= -0.9713773327641733"]
[416.91745, "o", "\r\n(2.2, 1.6) feasible= False c= -1.9971613430253585 obj= -3.0226591342346225\r\n"]
