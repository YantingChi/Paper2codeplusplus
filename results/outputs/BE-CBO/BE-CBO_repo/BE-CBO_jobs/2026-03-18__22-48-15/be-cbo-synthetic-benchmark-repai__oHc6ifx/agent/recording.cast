[368.256727, "o", "    R2 = (2*math.cos(t) - 0.5*math.cos(2*t) - 0.25*math.cos(3*t) - 0.125*math.cos(4*t))**2 + (2*math.sin(t))**2\r\n\u001b[?2004l\r\u001b[?2004h>     c = R2 - (x1**2 + x2**2)\r\n\u001b[?2004l\r\u001b[?2004h>     return c >= 0, c, R2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def townsend_obj(x1,x2):\r\n\u001b[?2004l\r\u001b[?2004h> "]
