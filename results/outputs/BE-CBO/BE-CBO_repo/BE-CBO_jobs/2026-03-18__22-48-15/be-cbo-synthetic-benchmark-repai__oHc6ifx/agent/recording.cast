[44.51959, "o", "sed -n '1,200p' environment/expected_results/reference_results.json\r\n\u001b[?2004l\r"]
[44.520381, "o", "{\r\n  \"comparison_tolerance\": 1e-06,\r\n  \"problems\": {\r\n    \"Townsend\": {\r\n      \"cases\": [\r\n        {\r\n"]
[44.520395, "o", "          \"iteration\": 1,\r\n          \"candidate\": [-1.0, 0.25],\r\n          \"feasible\": true,\r\n          \"objective\": -1.3079232530820846\r\n        },\r\n        {\r\n          \"iteration\": 2,\r\n          \"candidate\": [1.5, 1.5],\r\n          \"feasible\": true,\r\n          \"objective\": 0.16425365796873892\r\n        },\r\n        {\r\n"]
[44.520428, "o", "          \"iteration\": 3,\r\n          \"candidate\": [-2.0, -2.0],\r\n          \"feasible\": false,\r\n          \"objective\": null\r\n        },\r\n        {\r\n          \"iteration\": 4,\r\n          \"candidate\": [-2.0, 1.5],\r\n          \"feasible\": false,\r\n          \"objective\": null\r\n        },\r\n        {\r\n"]
[44.52044, "o", "          \"iteration\": 5,\r\n          \"candidate\": [0.0, 1.7],\r\n          \"feasible\": false,\r\n          \"objective\": null\r\n        },\r\n        {\r\n          \"iteration\": 6,\r\n          \"candidate\": [2.2, 1.6],\r\n          \"feasible\": false,\r\n          \"objective\": null\r\n        }\r\n      ],\r\n      \"metrics\": {\r\n        \"best_objective\": -1.3079232530820846,\r\n        \"feasibility_ratio\": 0.3333333333333333,\r\n        \"total_evaluations\": 6\r\n      }\r\n    },\r\n    \"Simionescu\": {\r\n      \"cases\": [\r\n        {\r\n          \"iteration\": 1,\r\n          \"candidate\": [0.0, 0.0],\r\n          \"feasible\": true,\r\n          \"objective\": 0.0\r\n        },\r\n        {\r\n          \"iteration\": 2,\r\n          \"candidate\": [0.9, 0.0],\r\n          \"feasible\": true,\r\n"]
[44.520515, "o", "          \"objective\": 0.0\r\n        },\r\n        {\r\n          \"iteration\": 3,\r\n          \"candidate\": [1.1, 0.0],\r\n          \"feasible\": true,\r\n          \"objective\": 0.0\r\n        },\r\n        {\r\n          \"iteration\": 4,\r\n          \"candidate\": [0.5, 0.5],\r\n          \"feasible\": true,\r\n          \"objective\": 0.025\r\n        },\r\n        {\r\n          \"iteration\": 5,\r\n          \"candidate\": [1.0, 0.5],\r\n          \"feasible\": false,\r\n          \"objective\": null\r\n        },\r\n        {\r\n          \"iteration\": 6,\r\n          \"candidate\": [-0.8, 0.4],\r\n          \"feasible\": false,\r\n          \"objective\": null\r\n        }\r\n      ],\r\n      \"metrics\": {\r\n        \"best_objective\": 0.0,\r\n        \"feasibility_ratio\": 0.6666666666666666,\r\n        \"total_evaluations\": 6\r\n      }\r\n    },\r\n    \"LSQ\": {\r\n      \"cases\": [\r\n"]
[44.520527, "o", "        {\r\n          \"iteration\": 1,\r\n          \"candidate\": [0.1, 0.1],\r\n          \"feasible\": false,\r\n          \"objective\": null\r\n        },\r\n        {\r\n          \"iteration\": 2,\r\n          \"candidate\": [0.6, 0.1],\r\n          \"feasible\": false,\r\n          \"objective\": null\r\n        },\r\n        {\r\n          \"iteration\": 3,\r\n          \"candidate\": [0.2, 0.6],\r\n          \"feasible\": false,\r\n          \"objective\": null\r\n        },\r\n        {\r\n          \"iteration\": 4,\r\n          \"candidate\": [0.8, 0.7],\r\n          \"feasible\": true,\r\n          \"objective\": 1.5\r\n        },\r\n        {\r\n          \"iteration\": 5,\r\n          \"candidate\": [0.5, 0.5],\r\n          \"feasible\": true,\r\n          \"objective\": 1.0\r\n        },\r\n        {\r\n          \"iteration\": 6,\r\n          \"candidate\": [0.9, 0.2],\r\n          \"feasible\": true,\r\n          \"objective\": 1.1\r\n        }\r\n      ],\r\n      \"metrics\": {\r\n        \"best_objective\": 1.0,\r\n        \"feasibility_ratio\": 0.5,\r\n        \"total_evaluations\": 6\r\n      }\r\n    }\r\n  }\r\n"]
[44.520553, "o", "}\r\n"]
