[416.909594, "i", "python - << 'PY'\nimport math\n\ndef townsend_feasible(x1,x2):\n    t = math.atan2(x1, x2)  # theta = atan2(x1, x2)\n    R2 = (2*math.cos(t) - 0.5*math.cos(2*t) - 0.25*math.cos(3*t) - 0.125*math.cos(4*t))**2 + (2*math.sin(t))**2\n    c = R2 - (x1**2 + x2**2)\n    return c >= 0, c, R2\n\ndef townsend_obj(x1,x2):\n    return -math.cos((x1 - 0.1)*x2)**2 - x1*math.sin(3*x1 + x2)\n\npts = [(-1.0,0.25),(1.5,1.5),(-2.0,-2.0),(-2.0,1.5),(0.0,1.7),(2.2,1.6)]\nfor p in pts:\n    feas,c,R2 = townsend_feasible(*p)\n    f = townsend_obj(*p)\n    print(p, 'feasible=', feas, 'c=', c, 'obj=', f)\nPY\n"]
[416.909749, "o", "python - << 'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
