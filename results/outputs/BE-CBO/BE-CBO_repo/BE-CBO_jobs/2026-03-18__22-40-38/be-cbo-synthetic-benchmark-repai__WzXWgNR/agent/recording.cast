[96.350157, "o", "python environment/benchmark/run_benchmark.py --repo-dir environment/codebase --cases environment/benchmark/synthetic_cases.json --expected environment/expected_results/reference_results.json --output environment/codebase/reproduction_result.json\r\n\u001b[?2004l\r"]
[97.236836, "o", "\u001b[?2004hroot@56f881c739bc:/workspace# "]
