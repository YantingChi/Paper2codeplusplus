[95.158989, "o", "+                self.lower_bounds = torch.tensor([-2.25, -2.5], dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.158998, "o", "> "]
[95.159112, "o", "+                self.upper_bounds = torch.tensor([2.25, 1.75], dtype=torch.float32)\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.159122, "o", "> "]
[95.159198, "o", "+            elif self.problem_name == \"Simionescu\":\r\n\u001b[?2004l\r"]
[95.159208, "o", "\u001b[?2004h> "]
[95.159304, "o", "+                # Bounds per appendix: [-1.25, -1.25] x [1.25, 1.25]\r\n\u001b[?2004l\r"]
[95.159313, "o", "\u001b[?2004h> "]
[95.159363, "o", "+                self.dimension = 2\r\n\u001b[?2004l\r"]
[95.159377, "o", "\u001b[?2004h> "]
[95.159456, "o", "+                self.lower_bounds = torch.tensor([-1.25, -1.25], dtype=torch.float32)\r\n\u001b[?2004l\r"]
[95.159473, "o", "\u001b[?2004h> "]
[95.159532, "o", "+                self.upper_bounds = torch.tensor([1.25, 1.25], dtype=torch.float32)\r\n\u001b[?2004l\r"]
[95.15954, "o", "\u001b[?2004h> "]
[95.159579, "o", "+            elif self.problem_name == \"LSQ\":\r\n\u001b[?2004l\r"]
[95.159588, "o", "\u001b[?2004h> "]
[95.159633, "o", "+                # Bounds per appendix: [0,0] x [1,1]\r\n\u001b[?2004l\r"]
[95.159647, "o", "\u001b[?2004h> "]
[95.15967, "o", "+                self.dimension = 2\r\n\u001b[?2004l\r"]
[95.159678, "o", "\u001b[?2004h> "]
[95.159744, "o", "+                self.lower_bounds = torch.tensor([0.0, 0.0], dtype=torch.float32)\r\n\u001b[?2004l\r"]
[95.15976, "o", "\u001b[?2004h> "]
[95.159818, "o", "+                self.upper_bounds = torch.tensor([1.0, 1.0], dtype=torch.float32)\r\n\u001b[?2004l\r"]
[95.159826, "o", "\u001b[?2004h> @@\r\n\u001b[?2004l\r"]
[95.159844, "o", "\u001b[?2004h> "]
[95.159873, "o", "-        if self.problem_name == \"Townsend\":\r\n\u001b[?2004l\r"]
[95.159881, "o", "\u001b[?2004h> "]
[95.159944, "o", "-            # Objective: f(x) = -[cos((x0 - 0.1)*x1)]^2 - x0*sin(3*x0 + x1)\r\n\u001b[?2004l\r"]
[95.159953, "o", "\u001b[?2004h> "]
[95.16006, "o", "-            self.objective_fn = lambda x: - (torch.cos((x[0] - 0.1) * x[1]) ** 2).item() - (x[0] * torch.sin(3 * x[0] + x[1])).item()\r\n\u001b[?2004l\r"]
[95.16007, "o", "\u001b[?2004h> "]
[95.160111, "o", "-            # Constraint: Feasible if x0 + x1 >= 0\r\n\u001b[?2004l\r"]
[95.16012, "o", "\u001b[?2004h> "]
[95.160184, "o", "-            self.constraint_fn = lambda x: 1 if (x[0] + x[1]).item() >= 0 else 0\r\n\u001b[?2004l\r"]
[95.160199, "o", "\u001b[?2004h> "]
[95.160228, "o", "+        if self.problem_name == \"Townsend\":\r\n\u001b[?2004l\r"]
[95.160236, "o", "\u001b[?2004h> "]
[95.160309, "o", "+            # Objective per appendix: f(x) = -[cos((x1 - 0.1) x2)]^2 - x1 sin(3 x1 + x2)\r\n\u001b[?2004l\r"]
[95.160324, "o", "\u001b[?2004h> "]
[95.160349, "o", "+            # Here x[0] = x1, x[1] = x2\r\n\u001b[?2004l\r"]
[95.160358, "o", "\u001b[?2004h> "]
[95.160406, "o", "+            def obj_townsend(x: torch.Tensor) -> float:\r\n\u001b[?2004l\r"]
[95.160415, "o", "\u001b[?2004h> "]
[95.160436, "o", "+                return (\r\n\u001b[?2004l\r"]
[95.16045, "o", "\u001b[?2004h> "]
[95.160492, "o", "+                    - (torch.cos((x[0] - 0.1) * x[1]) ** 2)\r\n\u001b[?2004l\r"]
[95.160501, "o", "\u001b[?2004h> "]
[95.16055, "o", "+                    - x[0] * torch.sin(3.0 * x[0] + x[1])\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.160559, "o", "> "]
[95.16058, "o", "+                ).item()\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.160588, "o", "> "]
[95.160623, "o", "+            self.objective_fn = obj_townsend\r\n\u001b[?2004l\r"]
[95.160631, "o", "\u001b[?2004h> +\r\n\u001b[?2004l\r"]
[95.16065, "o", "\u001b[?2004h> "]
[95.160672, "o", "+            # Constraint per appendix:\r\n\u001b[?2004l\r"]
[95.160681, "o", "\u001b[?2004h> "]
[95.160774, "o", "+            # c(x) = (2 cos(t) - 0.5 cos(2 t) - 0.25 cos(3 t) - 0.125 cos(4 t))^2 + (2 sin(t))^2 - x1^2 - x2^2 >= 0\r\n\u001b[?2004l\r"]
[95.160791, "o", "\u001b[?2004h> "]
[95.160814, "o", "+            # with t = arctan2(x1, x2)\r\n\u001b[?2004l\r"]
[95.160823, "o", "\u001b[?2004h> "]
[95.16087, "o", "+            def cons_townsend(x: torch.Tensor) -> int:\r\n\u001b[?2004l\r"]
[95.160878, "o", "\u001b[?2004h> "]
[95.160914, "o", "+                t = torch.atan2(x[0], x[1])\r\n\u001b[?2004l\r"]
[95.160923, "o", "\u001b[?2004h> "]
[95.160956, "o", "+                rx = (2.0 * torch.cos(t)\r\n\u001b[?2004l\r"]
[95.160965, "o", "\u001b[?2004h> "]
[95.161005, "o", "+                      - 0.5 * torch.cos(2.0 * t)\r\n\u001b[?2004l\r"]
[95.16102, "o", "\u001b[?2004h> "]
[95.161052, "o", "+                      - 0.25 * torch.cos(3.0 * t)\r\n\u001b[?2004l\r"]
[95.161061, "o", "\u001b[?2004h> "]
[95.161105, "o", "+                      - 0.125 * torch.cos(4.0 * t))\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.161113, "o", "> "]
[95.161146, "o", "+                ry = 2.0 * torch.sin(t)\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.161162, "o", "> "]
[95.161213, "o", "+                c_val = (rx * rx + ry * ry) - (x[0] * x[0] + x[1] * x[1])\r\n\u001b[?2004l\r"]
[95.161221, "o", "\u001b[?2004h> "]
[95.161267, "o", "+                return 1 if c_val.item() >= 0.0 else 0\r\n\u001b[?2004l\r"]
[95.161276, "o", "\u001b[?2004h> "]
[95.161316, "o", "+            self.constraint_fn = cons_townsend\r\n\u001b[?2004l\r"]
[95.161332, "o", "\u001b[?2004h> @@\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.161373, "o", "-        elif self.problem_name == \"Simionescu\":\r\n\u001b[?2004l\r"]
[95.161381, "o", "\u001b[?2004h> "]
[95.161431, "o", "-            # Objective: f(x) = 0.1*x0*x1 + (x0 - x1)**2\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.161446, "o", "> "]
[95.161511, "o", "-            self.objective_fn = lambda x: (0.1 * x[0] * x[1] + (x[0] - x[1]) ** 2).item()\r\n\u001b[?2004l\r"]
[95.161519, "o", "\u001b[?2004h> "]
[95.161564, "o", "-            # Constraint: Feasible if x0 - x1 <= 0.5\r\n\u001b[?2004l\r"]
[95.161578, "o", "\u001b[?2004h> "]
[95.161638, "o", "-            self.constraint_fn = lambda x: 1 if (x[0] - x[1]).item() <= 0.5 else 0\r\n\u001b[?2004l\r"]
[95.161645, "o", "\u001b[?2004h> "]
[95.161686, "o", "+        elif self.problem_name == \"Simionescu\":\r\n\u001b[?2004l\r"]
[95.161695, "o", "\u001b[?2004h> "]
[95.16174, "o", "+            # Objective per appendix: f(x) = 0.1 x1 x2\r\n\u001b[?2004l\r"]
[95.161749, "o", "\u001b[?2004h> "]
[95.161805, "o", "+            self.objective_fn = lambda x: (0.1 * x[0] * x[1]).item()\r\n\u001b[?2004l\r"]
[95.161813, "o", "\u001b[?2004h> "]
[95.161845, "o", "+            # Constraint per appendix:\r\n\u001b[?2004l\r"]
[95.16186, "o", "\u001b[?2004h> "]
[95.161907, "o", "+            # c(x) = (r_T + r_S cos(n theta))^2 - x1^2 - x2^2 >= 0,\r\n\u001b[?2004l\r"]
[95.161916, "o", "\u001b[?2004h> "]
[95.161962, "o", "+            # r_T=1, r_S=0.2, n=8, theta=atan2(x1,x2)\r\n\u001b[?2004l\r"]
[95.161976, "o", "\u001b[?2004h> "]
[95.162015, "o", "+            def cons_simionescu(x: torch.Tensor) -> int:\r\n\u001b[?2004l\r"]
[95.162023, "o", "\u001b[?2004h> "]
[95.162064, "o", "+                theta = torch.atan2(x[0], x[1])\r\n\u001b[?2004l\r"]
[95.16208, "o", "\u001b[?2004h> "]
[95.162093, "o", "+                r_T = 1.0\r\n\u001b[?2004l\r"]
[95.162101, "o", "\u001b[?2004h> "]
[95.162124, "o", "+                r_S = 0.2\r\n\u001b[?2004l\r"]
[95.162132, "o", "\u001b[?2004h> "]
[95.162152, "o", "+                n = 8.0\r\n\u001b[?2004l\r"]
[95.162167, "o", "\u001b[?2004h> "]
[95.162203, "o", "+                r = r_T + r_S * torch.cos(n * theta)\r\n\u001b[?2004l\r"]
[95.162211, "o", "\u001b[?2004h> "]
[95.162261, "o", "+                c_val = r * r - (x[0] * x[0] + x[1] * x[1])\r\n\u001b[?2004l\r"]
[95.162276, "o", "\u001b[?2004h> "]
[95.162313, "o", "+                return 1 if c_val.item() >= 0.0 else 0\r\n\u001b[?2004l\r"]
[95.162321, "o", "\u001b[?2004h> "]
[95.162363, "o", "+            self.constraint_fn = cons_simionescu\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.162371, "o", "> @@\r\n\u001b[?2004l\r"]
[95.162404, "o", "\u001b[?2004h> "]
[95.162419, "o", "-        elif self.problem_name == \"LSQ\":\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.162427, "o", "> "]
[95.162458, "o", "-            # Objective: f(x) = x0 + x1\r\n\u001b[?2004l\r"]
[95.162473, "o", "\u001b[?2004h> "]
[95.162517, "o", "-            self.objective_fn = lambda x: (x[0] + x[1]).item()\r\n\u001b[?2004l\r"]
[95.162525, "o", "\u001b[?2004h> "]
[95.162572, "o", "-            # Constraint: Feasible if x0^2 + x1^2 <= 1.0\r\n\u001b[?2004l\r"]
[95.162587, "o", "\u001b[?2004h> "]
[95.162654, "o", "-            self.constraint_fn = lambda x: 1 if (x[0] ** 2 + x[1] ** 2).item() <= 1.0 else 0\r\n\u001b[?2004l\r"]
[95.162663, "o", "\u001b[?2004h> "]
[95.162697, "o", "+        elif self.problem_name == \"LSQ\":\r\n\u001b[?2004l\r"]
[95.162712, "o", "\u001b[?2004h> "]
[95.162767, "o", "+            # Objective per appendix: f(x) = x1 + x2 (here x[0]=x1, x[1]=x2)\r\n\u001b[?2004l\r"]
[95.162776, "o", "\u001b[?2004h> "]
[95.162831, "o", "+            self.objective_fn = lambda x: (x[0] + x[1]).item()\r\n\u001b[?2004l\r"]
[95.16284, "o", "\u001b[?2004h> "]
[95.162877, "o", "+            # Constraints per appendix:\r\n\u001b[?2004l\r"]
[95.162892, "o", "\u001b[?2004h> "]
[95.162944, "o", "+            # c1(x) = x1 + 2 x2 + 0.5 sin(2 pi (x1^2 - 2 x2)) - 1.5 >= 0\r\n\u001b[?2004l\r"]
[95.162953, "o", "\u001b[?2004h> "]
[95.16299, "o", "+            # c2(x) = 1.5 - x1^2 - x2^2 >= 0\r\n\u001b[?2004l\r"]
[95.162999, "o", "\u001b[?2004h> "]
[95.16304, "o", "+            def cons_lsq(x: torch.Tensor) -> int:\r\n\u001b[?2004l\r"]
[95.163055, "o", "\u001b[?2004h> "]
[95.163133, "o", "+                c1 = x[0] + 2.0 * x[1] + 0.5 * torch.sin(2.0 * math.pi * (x[0] * x[0] - 2.0 * x[1])) - 1.5\r\n\u001b[?2004l\r"]
[95.163142, "o", "\u001b[?2004h> "]
[95.163188, "o", "+                c2 = 1.5 - (x[0] * x[0] + x[1] * x[1])\r\n\u001b[?2004l\r"]
[95.163197, "o", "\u001b[?2004h> "]
[95.163258, "o", "+                return 1 if (c1.item() >= 0.0 and c2.item() >= 0.0) else 0\r\n\u001b[?2004l\r"]
[95.163267, "o", "\u001b[?2004h> "]
[95.163302, "o", "+            self.constraint_fn = cons_lsq\r\n\u001b[?2004l\r"]
[95.163312, "o", "\u001b[?2004h> "]
[95.163321, "o", "*** End Patch\r\n\u001b[?2004l\r"]
[95.16333, "o", "\u001b[?2004h> "]
[95.163358, "o", "PATCH\r\n\u001b[?2004l\r"]
[95.163532, "o", "bash: applypatch: command not found\r\n"]
[95.163643, "o", "\u001b[?2004h"]
[95.163651, "o", "root@56f881c739bc:/workspace# "]
