[31.04483, "o", "drwxrwxr-x 1 root root  4096 Mar 19 03:40 .\r\ndrwxr-xr-x 1 root root  4096 Mar 19 03:19 ..\r\ndrwxrwxr-x 1 root root  4096 Mar 19 03:19 __pycache__\r\n-rw-rw-r-- 1 root root  8747 Mar 19 03:14 acquisition.py\r\n-rw-rw-r-- 1 root root 13529 Mar 19 03:14 benchmark.py\r\n-rwxrwxr-x 1 root root 62626 Mar 19 03:15 benchmark_materialize.sh\r\n-rw-rw-r-- 1 root root 12796 Mar 19 03:14 botrainer.py\r\n-rw-rw-r-- 1 root root  3818 Mar 19 03:14 config.py\r\n-rw-rw-r-- 1 root root  1042 Mar 19 03:14 config.yaml\r\n-rw-rw-r-- 1 root root 12764 Mar 19 03:14 deep_ensemble.py\r\n-rw-rw-r-- 1 root root  8313 Mar 19 03:14 evaluation.py\r\n-rw-rw-r-- 1 root root  8215 Mar 19 03:14 gp_surrogate.py\r\n-rw-rw-r-- 1 root root  6004 Mar 19 03:14 main.py\r\n-rw-r--r-- 1 root root   247 Mar 19 03:40 reproduction_result.json\r\n-rw-rw-r-- 1 root root  5517 Mar 19 03:14 utils.py\r\n"]
