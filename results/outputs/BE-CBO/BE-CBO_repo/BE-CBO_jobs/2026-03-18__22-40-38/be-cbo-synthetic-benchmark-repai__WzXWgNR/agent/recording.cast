[95.156852, "i", "applypatch << 'PATCH'\n*** Begin Patch\n*** Update File: environment/codebase/benchmark.py\n@@\n-from typing i\n+from typing import Tuple, Optional, Dict, Any\n@@\n-        else:\n-            # Set default dimensions and bounds for known problems\n-            if self.problem_name == \"Townsend\":\n-                self.dimension = 2\n-                self.lower_bounds = torch.tensor([-2.25, -2.5], dtype=torch.float32)\n-                self.upper_bounds = torch.tensor([2.25, 1.75], dtype=torch.float32)\n-            elif self.problem_name == \"Simionescu\":\n-                self.dimension = 2\n-                self.lower_bounds = torch.tensor([-1.25, -1.25], dtype=torch.float32)\n-                self.upper_bounds = torch.tensor([1.25, 1.25], dtype=torch.float32)\n-            elif self.problem_name == \"LSQ\":\n-                self.dimension = 2\n-                self.lower_bounds = torch.tensor([0.0, 0.0], dtype=torch.float32)\n-                self.upper_bounds = torch.tensor([1.0, 1.0], dtype=torch.float32)\n+        else:\n+            # Set default dimensions and bounds for known problems\n+            if self.problem_name == \"Townsend\":\n+                # Bounds per appendix: [-2.25, -2.5] x [2.25, 1.75]\n+                self.dimension = 2\n+                self.lower_bounds = torch.tensor([-2.25, -2.5], dtype=torch.float32)\n+                self.upper_bounds = torch.tensor([2.25, 1.75], dtype=torch.float32)\n+            elif self.problem_name == \"Simionescu\":\n+                # Bounds per appendix: [-1.25, -1.25] x [1.25, 1.25]\n+                self.dimension = 2\n+                self.lower_bounds = torch.tensor([-1.25, -1.25], dtype=torch.float32)\n+                self.upper_bounds = torch.tensor([1.25, 1.25], dtype=torch.float32)\n+            elif self.problem_name == \"LSQ\":\n+                # Bounds per appendix: [0,0] x [1,1]\n+                self.dimension = 2\n+                self.lower_bounds = torch.tensor([0.0, 0.0], dtype=torch.float32)\n+                self.upper_bounds = torch.tensor([1.0, 1.0], dtype=torch.float32)\n@@\n-        if self.problem_name == \"Townsend\":\n-            # Objective: f(x) = -[cos((x0 - 0.1)*x1)]^2 - x0*sin(3*x0 + x1)\n-            self.objective_fn = lambda x: - (torch.cos((x[0] - 0.1) * x[1]) ** 2).item() - (x[0] * torch.sin(3 * x[0] + x[1])).item()\n-            # Constraint: Feasible if x0 + x1 >= 0\n-            self.constraint_fn = lambda x: 1 if (x[0] + x[1]).item() >= 0 else 0\n+        if self.problem_name == \"Townsend\":\n+            # Objective per appendix: f(x) = -[cos((x1 - 0.1) x2)]^2 - x1 sin(3 x1 + x2)\n+            # Here x[0] = x1, x[1] = x2\n+            def obj_townsend(x: torch.Tensor) -> float:\n+                return (\n+                    - (torch.cos((x[0] - 0.1) * x[1]) ** 2)\n+                    - x[0] * torch.sin(3.0 * x[0] + x[1])\n+                ).item()\n+            self.objective_fn = obj_townsend\n+\n+            # Constraint per appendix:\n+            # c(x) = (2 cos(t) - 0.5 cos(2 t) - 0.25 cos(3 t) - 0.125 cos(4 t))^2 + (2 sin(t))^2 - x1^2 - x2^2 >= 0\n+            # with t = arctan2(x1, x2)\n+            def cons_townsend(x: torch.Tensor) -> int:\n+                t = torch.atan2(x[0], x[1])\n+                rx = (2.0 * torch.cos(t)\n+                      - 0.5 * torch.cos(2.0 * t)\n+                      - 0.25 * torch.cos(3.0 * t)\n+                      - 0.125 * torch.cos(4.0 * t))\n+                ry = 2.0 * torch.sin(t)\n+                c_val = (rx * rx + ry * ry) - (x[0] * x[0] + x[1] * x[1])\n+                return 1 if c_val.item() >= 0.0 else 0\n+            self.constraint_fn = cons_townsend\n@@\n-        elif self.problem_name == \"Simionescu\":\n-            # Objective: f(x) = 0.1*x0*x1 + (x0 - x1)**2\n-            self.objective_fn = lambda x: (0.1 * x[0] * x[1] + (x[0] - x[1]) ** 2).item()\n-            # Constraint: Feasible if x0 - x1 <= 0.5\n-            self.constraint_fn = lambda x: 1 if (x[0] - x[1]).item() <= 0.5 else 0\n+        elif self.problem_name == \"Simionescu\":\n+            # Objective per appendix: f(x) = 0.1 x1 x2\n+            self.objective_fn = lambda x: ("]
[95.156961, "i", "0.1 * x[0] * x[1]).item()\n+            # Constraint per appendix:\n+            # c(x) = (r_T + r_S cos(n theta))^2 - x1^2 - x2^2 >= 0,\n+            # r_T=1, r_S=0.2, n=8, theta=atan2(x1,x2)\n+            def cons_simionescu(x: torch.Tensor) -> int:\n+                theta = torch.atan2(x[0], x[1])\n+                r_T = 1.0\n+                r_S = 0.2\n+                n = 8.0\n+                r = r_T + r_S * torch.cos(n * theta)\n+                c_val = r * r - (x[0] * x[0] + x[1] * x[1])\n+                return 1 if c_val.item() >= 0.0 else 0\n+            self.constraint_fn = cons_simionescu\n@@\n-        elif self.problem_name == \"LSQ\":\n-            # Objective: f(x) = x0 + x1\n-            self.objective_fn = lambda x: (x[0] + x[1]).item()\n-            # Constraint: Feasible if x0^2 + x1^2 <= 1.0\n-            self.constraint_fn = lambda x: 1 if (x[0] ** 2 + x[1] ** 2).item() <= 1.0 else 0\n+        elif self.problem_name == \"LSQ\":\n+            # Objective per appendix: f(x) = x1 + x2 (here x[0]=x1, x[1]=x2)\n+            self.objective_fn = lambda x: (x[0] + x[1]).item()\n+            # Constraints per appendix:\n+            # c1(x) = x1 + 2 x2 + 0.5 sin(2 pi (x1^2 - 2 x2)) - 1.5 >= 0\n+            # c2(x) = 1.5 - x1^2 - x2^2 >= 0\n+            def cons_lsq(x: torch.Tensor) -> int:\n+                c1 = x[0] + 2.0 * x[1] + 0.5 * torch.sin(2.0 * math.pi * (x[0] * x[0] - 2.0 * x[1])) - 1.5\n+                c2 = 1.5 - (x[0] * x[0] + x[1] * x[1])\n+                return 1 if (c1.item() >= 0.0 and c2.item() >= 0.0) else 0\n+            self.constraint_fn = cons_lsq\n*** End Patch\nPATCH\n"]
