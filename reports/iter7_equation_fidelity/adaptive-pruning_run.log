## src/data/dataset_loader.py
from __future__ import annotations

from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

from datasets import Dataset, DatasetDict, IterableDataset, IterableDatasetDict, load_dataset
from transformers import AutoTokenizer

from src.config import DataConfig, ModelConfig
from src.data.collators import get_data_collator
from src.data.preprocessors import TaskPreprocessor
from src.utils.logging import get_logger


## @brief Container holding tokenized datasets, tokenizer, collator, and label metadata.
@dataclass
class DatasetBundle:
    ## @brief Initialize DatasetBundle.
    # @param train_dataset Any Tokenized training dataset.
    # @param eval_dataset Any Tokenized evaluation dataset.
    # @param test_dataset Any Tokenized test dataset (optional).
    # @param tokenizer Any Hugging Face tokenizer.
    # @param data_collator Any Data collator callable.
    # @param label_names list[str] Label names (if available, e.g., GLUE).
    def __init__(
        self,
        train_dataset: Any,
        eval_dataset: Any,
        test_dataset: Any,
        tokenizer: Any,
        data_collator: Any,
        label_names: List[str],
    ) -> None:
        self.train_dataset = train_dataset
        self.eval_dataset = eval_dataset
        self.test_dataset = test_dataset
        self.tokenizer = tokenizer
        self.data_collator = data_collator
        self.label_names = label_names

    train_dataset: Any
    eval_dataset: Any
    test_dataset: Any
    tokenizer: Any
    data_collator: Any
    label_names: List[str]


## @brief Load, tokenize, and package datasets for APT experiments.
# @details This module is responsible only for dataset I/O and tokenization plumbing.
# It supports the paper’s tasks: GLUE, SQuAD v2, CNN/DailyMail, and Alpaca-style instruction tuning.
class DatasetLoader:
    ## @brief Create a DatasetLoader.
    # @param config DataConfig Dataset configuration.
    # @param model_config ModelConfig Model configuration.
    def __init__(self, config: DataConfig, model_config: ModelConfig) -> None:
        self._cfg: DataConfig = config
        self._model_cfg: ModelConfig = self._normalize_model_config(model_config)
        self._logger = get_logger("apt.data")

    ## @brief Build a Hugging Face tokenizer for the configured backbone.
    # @details Uses AutoTokenizer.from_pretrained(backbone_name, trust_remote_code=...).
    # For LLaMA-like tokenizers without a pad token, sets pad_token = eos_token for batching.
    # @return Any Tokenizer instance.
    def build_tokenizer(self) -> Any:
        backbone: str = str(self._model_cfg.backbone_name)
        trust_remote_code: bool = bool(getattr(self._model_cfg, "trust_remote_code", False))

        # Prefer fast tokenizer when possible (required for SQuAD offset mappings).
        use_fast: bool = True
        try:
            tokenizer: Any = AutoTokenizer.from_pretrained(
                backbone,
                use_fast=use_fast,
                trust_remote_code=trust_remote_code,
            )
        except Exception as e_fast:
            self._logger.warning(
                "Failed to load fast tokenizer for %s (error=%s). Falling back to slow tokenizer.",
                backbone,
                repr(e_fast),
            )
            tokenizer = AutoTokenizer.from_pretrained(
                backbone,
                use_fast=False,
                trust_remote_code=trust_remote_code,
            )

        # Ensure pad token exists for batching (especially for LLaMA).
        if getattr(tokenizer, "pad_token_id", None) is None:
            eos_token: Optional[str] = getattr(tokenizer, "eos_token", None)
            if eos_token is None:
                raise ValueError(
                    f"Tokenizer for backbone={backbone!r} has no pad_token_id and no eos_token; cannot set padding."
                )
            tokenizer.pad_token = eos_token

        # Common choice; does not affect correctness of metrics.
        if getattr(tokenizer, "padding_side", None) is None:
            tokenizer.padding_side = "right"

        # QA requires a fast tokenizer for offset mappings.
        if self._model_cfg.task_type == "qa" and not bool(getattr(tokenizer, "is_fast", False)):
            raise ValueError(
                "SQuAD v2 preprocessing requires a fast tokenizer (tokenizer.is_fast=True) for offset mappings."
            )

        return tokenizer

    ## @brief Load raw datasets, tokenize them, and build a DatasetBundle.
    # @return DatasetBundle Bundle containing tokenized train/eval/test datasets, tokenizer, and collator.
    def load(self) -> DatasetBundle:
        tokenizer: Any = self.build_tokenizer()
        raw: Any = self._load_raw_dataset()

        train_split: str = str(self._cfg.train_split or "train")
        eval_split: str = str(self._cfg.validation_split or "validation")

        train_ds: Any = self._get_split(raw, train_split)
        eval_ds: Any = self._get_split(raw, eval_split)
        test_ds: Any = self._maybe_get_test_split(raw)

        label_names: List[str] = self._extract_label_names(train_ds)

        preprocessor = TaskPreprocessor(tokenizer=tokenizer, config=self._cfg, model_config=self._model_cfg)
        map_fn = self._select_map_fn(preprocessor)

        # Remove-columns policy:
        # - For QA eval/test we keep raw columns like 'answers', 'context', 'question', and the added metadata
        #   columns so evaluator can postprocess. We do NOT remove columns for QA eval/test.
        # - For training (all tasks) we remove original columns for memory.
        train_remove_cols: Optional[List[str]] = self._columns_to_remove(train_ds, is_train=True)
        eval_remove_cols: Optional[List[str]] = self._columns_to_remove(eval_ds, is_train=False)
        test_remove_cols: Optional[List[str]] = None if test_ds is None else self._columns_to_remove(test_ds, is_train=False)

        tokenized_train: Any = self._map_dataset(
            ds=train_ds,
            fn=map_fn,
            remove_columns=train_remove_cols,
            desc=f"tokenize[{self._cfg.dataset_name}:{train_split}]",
        )
        tokenized_eval: Any = self._map_dataset(
            ds=eval_ds,
            fn=map_fn,
            remove_columns=eval_remove_cols,
            desc=f"tokenize[{self._cfg.dataset_name}:{eval_split}]",
        )
        tokenized_test: Any = None
        if test_ds is not None:
            tokenized_test = self._map_dataset(
                ds=test_ds,
                fn=map_fn,
                remove_columns=test_remove_cols,
                desc=f"tokenize[{self._cfg.dataset_name}:test]",
            )

        # Collator: for QA we must avoid adding metadata into the batch dict because the trainer forwards
        # the batch to model(**batch). Metadata remains in eval dataset columns for post-processing.
        # Therefore, we always build the "training" QA collator variant (include_metadata=False).
        is_train_for_collator: bool = True if self._model_cfg.task_type == "qa" else True
        data_collator: Any = get_data_collator(
            tokenizer=tokenizer,
            data_config=self._cfg,
            model_config=self._model_cfg,
            is_train=is_train_for_collator,
        )

        return DatasetBundle(
            train_dataset=tokenized_train,
            eval_dataset=tokenized_eval,
            test_dataset=tokenized_test,
            tokenizer=tokenizer,
            data_collator=data_collator,
            label_names=label_names,
        )

    ## @brief Normalize ModelConfig.task_type into canonical values expected by TaskPreprocessor.
    # @param model_config ModelConfig Input model config.
    # @return ModelConfig Normalized model config (new instance).
    def _normalize_model_config(self, model_config: ModelConfig) -> ModelConfig:
        raw: str = str(getattr(model_config, "task_type", "") or "").strip().lower()
        mapping: Dict[str, str] = {
            "sequence_classification": "sequence_classification",
            "classification": "sequence_classification",
            "qa": "qa",
            "question_answering": "qa",
            "extractive_qa": "qa",
            "seq2seq": "seq2seq",
            "seq2seq_lm": "seq2seq",
            "text2text": "seq2seq",
            "causal_lm": "causal_lm",
            "causallm": "causal_lm",
            "clm": "causal_lm",
        }
        task_type: str = mapping.get(raw, raw)

        return ModelConfig(
            backbone_name=str(getattr(model_config, "backbone_name", "")),
            task_type=task_type,
            max_length=int(getattr(model_config, "max_length", 0) or 0),
            num_labels=int(getattr(model_config, "num_labels", 0) or 0),
            use_ffn_adapters=bool(getattr(model_config, "use_ffn_adapters", False)),
            trust_remote_code=bool(getattr(model_config, "trust_remote_code", False)),
        )

    ## @brief Load a raw dataset from Hugging Face datasets according to DataConfig.
    # @return Any A DatasetDict/IterableDatasetDict or similar dataset object.
    def _load_raw_dataset(self) -> Any:
        ds_name_raw: str = str(self._cfg.dataset_name or "").strip()
        if not ds_name_raw:
            raise ValueError("DataConfig.dataset_name must be non-empty.")

        ds_name: str = self._canonical_dataset_name(ds_name_raw)
        ds_cfg: str = str(self._cfg.dataset_config_name or "").strip()

        # Known paper datasets:
        if ds_name == "glue":
            if not ds_cfg:
                raise ValueError("GLUE requires data.dataset_config_name (e.g., 'sst2' or 'mnli').")
            return load_dataset("glue", ds_cfg)

        if ds_name == "squad_v2":
            # squad_v2 has no required config.
            return load_dataset("squad_v2")

        if ds_name == "cnn_dailymail":
            if not ds_cfg:
                raise ValueError("CNN/DailyMail requires data.dataset_config_name (e.g., '3.0.0').")
            return load_dataset("cnn_dailymail", ds_cfg)

        # Flexible support: allow local JSON/JSONL datasets (e.g., Alpaca dumps) when dataset_name is "json".
        # Since DataConfig has no data_files field, we interpret dataset_config_name as:
        # - "train=/path/to/train.jsonl,validation=/path/to/val.jsonl,test=/path/to/test.jsonl"
        # - OR a single file path for train only (validation must then be provided via config splits existing).
        if ds_name.lower() in ("json", "jsonl"):
            if not ds_cfg:
                raise ValueError(
                    "JSON dataset loading requires data.dataset_config_name pointing to a file path "
                    "or a 'train=...,validation=...,test=...' mapping string."
                )
            data_files = self._parse_json_data_files(ds_cfg)
            if data_files is None:
                # Single file path -> becomes 'train' split.
                data_files = {"train": ds_cfg}
            return load_dataset("json", data_files=data_files)

        # Default: defer to datasets.load_dataset(dataset_name, dataset_config_name?).
        if ds_cfg:
            return load_dataset(ds_name_raw, ds_cfg)
        return load_dataset(ds_name_raw)

    ## @brief Canonicalize dataset name aliases used in configs.
    # @param dataset_name str Raw dataset name.
    # @return str Canonical dataset name.
    def _canonical_dataset_name(self, dataset_name: str) -> str:
        name: str = dataset_name.strip().lower()
        aliases: Dict[str, str] = {
            "cnndm": "cnn_dailymail",
            "cnn-dailymail": "cnn_dailymail",
            "cnn_dailymail": "cnn_dailymail",
            "squad": "squad_v2",
            "squadv2": "squad_v2",
            "squad-v2": "squad_v2",
            "squad_v2": "squad_v2",
        }
        return aliases.get(name, name)

    ## @brief Parse JSON dataset data_files mapping string.
    # @details Accepts "train=...,validation=...,test=..." separated by commas or semicolons.
    # @param spec str Mapping spec.
    # @return dict[str, str] | None Mapping or None if spec is not a mapping.
    def _parse_json_data_files(self, spec: str) -> Optional[Dict[str, str]]:
        s: str = spec.strip()
        if "=" not in s:
            return None
        parts: List[str] = []
        for chunk in s.replace(";", ",").split(","):
            c: str = chunk.strip()
            if c:
                parts.append(c)
        out: Dict[str, str] = {}
        for part in parts:
            if "=" not in part:
                raise ValueError(f"Invalid json data_files part (expected key=path): {part!r}")
            k, v = part.split("=", 1)
            key: str = k.strip()
            path: str = v.strip()
            if not key or not path:
                raise ValueError(f"Invalid json data_files entry: {part!r}")
            out[key] = path
        return out

    ## @brief Get a split dataset by name or raise a clear error listing available splits.
    # @param raw Any Raw dataset container (DatasetDict-like).
    # @param split_name str Split name.
    # @return Any Split dataset.
    def _get_split(self, raw: Any, split_name: str) -> Any:
        if isinstance(raw, (DatasetDict, IterableDatasetDict)):
            if split_name not in raw:
                available: List[str] = sorted(list(raw.keys()))
                raise ValueError(
                    f"Requested split {split_name!r} not found for dataset {self._cfg.dataset_name!r} "
                    f"(config={self._cfg.dataset_config_name!r}). Available splits: {available}"
                )
            return raw[split_name]

        # If load_dataset returned a single Dataset, allow using it when split_name is "train".
        if isinstance(raw, (Dataset, IterableDataset)):
            if split_name != "train":
                raise ValueError(
                    f"Dataset {self._cfg.dataset_name!r} returned a single split Dataset; "
                    f"cannot select split {split_name!r} (only 'train' is supported)."
                )
            return raw

        raise TypeError(f"Unsupported dataset object type from load_dataset: {type(raw)}")

    ## @brief Optionally get a test split if it exists.
    # @param raw Any Raw dataset container.
    # @return Any Test dataset or None.
    def _maybe_get_test_split(self, raw: Any) -> Any:
        if isinstance(raw, (DatasetDict, IterableDatasetDict)):
            if "test" in raw:
                return raw["test"]
            # Some tasks have test variants (e.g., mnli has test_matched/test_mismatched). We do not guess.
            return None
        return None

    ## @brief Select the preprocessing function according to task type.
    # @param preprocessor TaskPreprocessor Preprocessor instance.
    # @return Any Callable to pass into datasets.Dataset.map.
    def _select_map_fn(self, preprocessor: TaskPreprocessor) -> Any:
        task_type: str = str(self._model_cfg.task_type or "").strip().lower()
        if task_type == "sequence_classification":
            return preprocessor.preprocess_classification
        if task_type == "qa":
            return preprocessor.preprocess_qa
        if task_type == "seq2seq":
            return preprocessor.preprocess_seq2seq
        if task_type == "causal_lm":
            return preprocessor.preprocess_causal_lm
        raise ValueError(f"Unsupported task_type={task_type!r} in DatasetLoader.")

    ## @brief Compute columns to remove during tokenization map for memory efficiency.
    # @details For QA eval/test, keep raw columns needed for post-processing and metrics.
    # @param ds Any Dataset split object.
    # @param is_train bool Whether this is the training dataset.
    # @return list[str] | None Columns to remove, or None to keep all columns.
    def _columns_to_remove(self, ds: Any, is_train: bool) -> Optional[List[str]]:
        if not hasattr(ds, "column_names"):
            return None

        cols: List[str] = list(getattr(ds, "column_names", []) or [])
        if len(cols) == 0:
            return None

        task_type: str = str(self._model_cfg.task_type or "").strip().lower()
        if task_type == "qa" and not is_train:
            # Preserve raw fields for SQuAD v2 dev F1 computation and text reconstruction:
            # keep 'id','context','question','answers' plus any other fields.
            return None

        return cols

    ## @brief Apply datasets.map with stable settings and clear error messages.
    # @param ds Any Dataset split to map over.
    # @param fn Any Mapping function.
    # @param remove_columns list[str] | None Columns to remove after mapping.
    # @param desc str Description for datasets progress bar.
    # @return Any Mapped dataset.
    def _map_dataset(self, ds: Any, fn: Any, remove_columns: Optional[List[str]], desc: str) -> Any:
        if ds is None:
            raise ValueError("Cannot map over a None dataset.")
        try:
            return ds.map(
                fn,
                batched=True,
                remove_columns=remove_columns,
                desc=str(desc),
            )
        except Exception as e:
            raise RuntimeError(
                f"Failed to tokenize dataset={self._cfg.dataset_name!r} "
                f"config={self._cfg.dataset_config_name!r} task_type={self._model_cfg.task_type!r} "
                f"(desc={desc!r}). Error: {repr(e)}"
            ) from e

    ## @brief Extract label names from dataset features if available.
    # @param ds Any Dataset split.
    # @return list[str] Label names, or empty list if unavailable.
    def _extract_label_names(self, ds: Any) -> List[str]:
        task_type: str = str(self._model_cfg.task_type or "").strip().lower()
        if task_type not in ("sequence_classification", "seq2seq"):
            return []

        label_field: str = str(self._cfg.label_field or "label")
        features: Any = getattr(ds, "features", None)
        if features is None or label_field not in features:
            return []

        label_feat: Any = features[label_field]
        names: Any = getattr(label_feat, "names", None)
        if isinstance(names, list):
            return [str(x) for x in names]
        return []
