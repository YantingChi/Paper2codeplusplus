## configs/t5_cnndm_apt.yaml

# T5 (lm-adapt) on CNN/DailyMail summarization with APT (adaptive pruning + adaptive tuning)
# Paper: APT (ICML 2024)
# Key enforced hyperparameters from config.yaml (Table 6): lr=1e-4, batch_size=16, epochs=16, distill_epochs=6.
# APT enforced settings from config.yaml/paper: initial_rank=8, scaling factor s=2 (Eq. 2), mask alpha=0.01.

model:
  backbone_name: "t5-lm-adapt"
  task_type: "seq2seq"
  use_ffn_adapters: true

data:
  dataset_name: "cnndm"
  batch_size: 16
  eval_batch_size: 128

training:
  learning_rate: 1e-4
  num_epochs: 16
  distill_epochs: 6

apt:
  enable_apt: true

  # Eq. (2): H_apt(X) = m_o • (W + s • W_B W_A) X • m_i
  # Here we set s via lora_alpha == 2 (apt_scaling_factor).
  lora_alpha: 2

  # Adaptive tuning (Sec. 7): r_apt = 8 (apt_initial_rank).
  initial_rank: 8

  # Gradual mask update (Appendix B/C): alpha = 0.01 (mask_gradual_update_alpha).
  mask_update_step: 0.01

  # Outlier-aware salience uses kurtosis term (Sec. 4.2).
  use_kurtosis: true

  # Self-distillation enabled for small models (config.yaml).
  use_self_distill: true
  distill_mu_schedule: "linear_0_to_1"  # Eq. (7): mu linearly scales 0->1.
  teacher_share_frozen: true

  # Conceptual module targets for small models from config.yaml.
  # Note: Actual module-name pattern resolution is handled by APTInjector for T5.
  apply_on_modules:
    - "attention_query"
    - "attention_value"
    - "ffn_layers"

evaluation:
  metrics:
    - "rouge1"
    - "rouge2"
    - "rougel"
```
