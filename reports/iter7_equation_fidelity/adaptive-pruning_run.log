## configs/t5_sst2_apt.yaml
#
# T5 (t5-lm-adapt) on GLUE/SST-2 with APT (Adaptive Pruning + Adaptive Tuning + Self-Distillation).
#
# Modeling choice for T5 on SST-2:
# - Use seq2seq (text-to-text) formulation. Accuracy is computed by mapping generated label strings
#   to class ids in evaluation code.
#
# Required literal equations (implemented in code; referenced here for verification):
# eq: apt_forward_eq2
#   H_apt = m_o * ( (W + s * (W_B @ W_A)) @ (X * m_i) )
# eq: target_sparsity_schedule_cubic
#   gamma_t = gamma_T + (1 - gamma_T) * (1 - t / T) ** 3
# eq: mask_update_retain
#   M1_t = min(1, M1_prev + 0.01)
# eq: mask_update_prune
#   M0_t = max(0, M0_prev - 0.01)
# eq: rank_update_rule
#   r_new = floor(r_old * Delta_t_new / Delta_t_old)
# eq: distill_total_loss
#   L = mu * L_distill + (1 - mu) * L_ft
# eq: distill_layer_loss
#   L_layer = sum_i MSE(Tr(H_s[phi(i)]), H_t[i])
#
# Paper/appendix literals enforced in this config:
# - lr = 2e-4, batch_size = 32, epochs = 40, distill_epochs = 20 (Table 6, GLUE-big settings)
# - initial_rank = 8, scaling factor s = 2, mask alpha = 0.01 (Sec. 7 / Appendix C)
# - inference batch size (small models) = 128 (Sec. 5.3)

model:
  backbone_name: "t5-lm-adapt"
  task_type: "seq2seq"
  max_length: 512
  num_labels: 2
  use_ffn_adapters: true
  trust_remote_code: false

data:
  dataset_name: "glue"
  dataset_config_name: "sst2"
  train_split: "train"
  validation_split: "validation"
  text_fields: ["sentence"]
  label_field: "label"
  batch_size: 32
  eval_batch_size: 128

training:
  learning_rate: 2.0e-4
  num_epochs: 40
  distill_epochs: 20

apt:
  enable_apt: true
  target_sparsity: 0.60
  initial_rank: 8
  lora_alpha: 2
  mask_update_step: 0.01
  pruning_stage_ratio: 0.5
  rank_growth_mode: "top_half_salient_adapters"
  use_kurtosis: true
  use_self_distill: true
  distill_mu_schedule: "linear_0_to_1"
  teacher_share_frozen: true
  apply_on_modules:
    - "attention_query"
    - "attention_value"
    - "ffn_layers"

evaluation:
  metrics: ["accuracy"]
  measure_train_peak_memory: true
  measure_inference_peak_memory: true
  measure_throughput: true
  lm_eval_tasks: []
  lm_eval_num_fewshot: {}

runtime:
  compile_model: false
  gradient_checkpointing: false
```
