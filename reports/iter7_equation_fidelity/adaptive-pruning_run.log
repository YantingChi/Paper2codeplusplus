## main.py
from __future__ import annotations

import argparse
import importlib
import importlib.metadata
import json
import math
import os
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

import yaml

from src.algorithms.distillation import DistillationManager
from src.algorithms.pruning import PruningScheduler
from src.algorithms.rank_allocator import RankAllocator
from src.algorithms.salience import SalienceCollector
from src.config import ExperimentConfig
from src.data.dataset_loader import DatasetBundle, DatasetLoader
from src.eval.evaluator import EvalResult, Evaluator
from src.models.apt_injector import APTInjector, APTModelWrapper
from src.models.mask_utils import MaskManager
from src.models.model_factory import ModelFactory
from src.training.trainer import TrainResult, Trainer
from src.utils.logging import get_logger, log_config, save_json
from src.utils.profiler import Profiler
from src.utils.seed import set_global_seed


## @brief Load a YAML file into a Python dict.
# @param path str Path to YAML file.
# @return dict[str, Any] YAML content as dict.
def _load_yaml_dict(path: str) -> Dict[str, Any]:
    p = Path(str(path))
    if not p.exists():
        raise FileNotFoundError(f"YAML file not found: {str(p)}")
    with p.open("r", encoding="utf-8") as f:
        data = yaml.safe_load(f)
    if data is None:
        return {}
    if not isinstance(data, dict):
        raise ValueError(f"YAML root must be a mapping/dict: {path}")
    return data


## @brief Find the repository's global config.yaml (paper configuration).
# @details Searches common locations: CWD/config.yaml, repo-root/config.yaml based on this file.
# @return str Path to config.yaml.
def _find_paper_config_path() -> str:
    candidates = [
        Path(os.getcwd()) / "config.yaml",
        Path(__file__).resolve().parent / "config.yaml",
        Path(__file__).resolve().parent.parent / "config.yaml",
    ]
    for p in candidates:
        if p.exists():
            return str(p)
    raise FileNotFoundError(
        "Cannot locate global paper config.yaml. Expected it in CWD or repository root."
    )


## @brief Determine whether a backbone name is T5-family.
# @param backbone_name str Backbone name.
# @return bool True if T5-family.
def _is_t5_backbone(backbone_name: str) -> bool:
    s = (backbone_name or "").lower()
    return "t5" in s or "mt5" in s


## @brief Determine whether a backbone name is LLaMA-family.
# @param backbone_name str Backbone name.
# @return bool True if LLaMA-family.
def _is_llama_backbone(backbone_name: str) -> bool:
    s = (backbone_name or "").lower()
    return "llama" in s or "llemma" in s


## @brief Collect a minimal environment/version snapshot for reproducibility.
# @return dict[str, Any] Environment info.
def _collect_env_info() -> Dict[str, Any]:
    pkgs = [
        "torch",
        "transformers",
        "datasets",
        "evaluate",
        "accelerate",
        "safetensors",
        "numpy",
        "scipy",
        "scikit-learn",
        "rouge-score",
        "sentencepiece",
        "protobuf",
        "lm-eval",
        "pyyaml",
    ]
    versions: Dict[str, str] = {}
    for name in pkgs:
        try:
            versions[name] = importlib.metadata.version(name)
        except Exception:
            versions[name] = "unknown"

    # Python and CUDA info (best-effort; do not import torch here to avoid side effects).
    return {
        "packages": versions,
        "python": {
            "executable": str(Path(os.sys.executable)),
            "version": os.sys.version,
        },
    }


## @brief Parse command line arguments for running an experiment.
# @return argparse.Namespace Parsed arguments.
def _parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Reproduce APT experiments (Adaptive Pruning and Tuning).")
    parser.add_argument(
        "--config",
        type=str,
        required=True,
        help="Path to an experiment YAML config (e.g., configs/roberta_sst2_apt.yaml).",
    )
    parser.add_argument(
        "--output_dir",
        type=str,
        default="",
        help="Optional override for runtime.output_dir (non-fidelity-critical).",
    )
    parser.add_argument(
        "--device",
        type=str,
        default="",
        help="Optional override for runtime.device (e.g., cuda, cuda:0, cpu).",
    )
    parser.add_argument(
        "--deterministic",
        action="store_true",
        help="Enable best-effort deterministic execution in PyTorch.",
    )
    return parser.parse_args()


## @brief Top-level system that wires together data/model/algorithms/training/evaluation/export.
# @details Implements the design's ExperimentSystem interface. The heavy lifting is delegated to
# already-implemented modules; this class is responsible for correct construction order and
# paper-aligned consistency checks.
class ExperimentSystem:
    ## @brief Initialize an ExperimentSystem.
    # @param config ExperimentConfig Validated experiment configuration.
    def __init__(self, config: ExperimentConfig) -> None:
        if config is None:
            raise ValueError("config must be non-None.")
        self._cfg: ExperimentConfig = config
        self._logger = get_logger("apt.system")

        self._paper_cfg_path: str = _find_paper_config_path()
        self._paper_cfg: Dict[str, Any] = _load_yaml_dict(self._paper_cfg_path)

        self._datasets: Optional[DatasetBundle] = None
        self._model: Optional[APTModelWrapper] = None
        self._mask_manager: Optional[MaskManager] = None
        self._salience: Optional[SalienceCollector] = None
        self._pruner: Optional[PruningScheduler] = None
        self._rank_allocator: Optional[RankAllocator] = None
        self._distiller: Optional[DistillationManager] = None
        self._profiler: Optional[Profiler] = None

        self._train_result: Optional[TrainResult] = None
        self._eval_result: Optional[EvalResult] = None
        self._export_path: str = ""

    ## @brief Prepare datasets, model, APT injection, and algorithm components.
    # @return None
    def prepare(self) -> None:
        out_dir = Path(str(self._cfg.runtime.output_dir))
        out_dir.mkdir(parents=True, exist_ok=True)

        # Persist effective config via logging helper.
        log_config(self._cfg)

        # Save environment info.
        save_json(out_dir / "env_info.json", _collect_env_info())

        # Load datasets/tokenizer/collator.
        loader = DatasetLoader(config=self._cfg.data, model_config=self._cfg.model)
        datasets = loader.load()
        self._datasets = datasets

        # Create base model for the task.
        factory = ModelFactory(model_config=self._cfg.model)
        base_model = factory.create_model_for_task()

        # Inject APT adapters if enabled.
        injector = APTInjector(apt_config=self._cfg.apt)
        apt_model = injector.inject(base_model)
        self._model = apt_model

        registry = self._model.get_registry()
        self._mask_manager = MaskManager(registry)
        self._mask_manager.initialize_masks()

        # Salience collector (EMA beta is validated upstream).
        self._salience = SalienceCollector(
            registry=registry,
            ema_beta=float(self._cfg.apt.salience_ema_beta),
            use_kurtosis=bool(self._cfg.apt.use_kurtosis),
        )

        # Pruning scheduler and rank allocator.
        self._pruner = PruningScheduler(
            registry=registry,
            mask_manager=self._mask_manager,
            apt_config=self._cfg.apt,
        )
        self._rank_allocator = RankAllocator(
            registry=registry,
            apt_config=self._cfg.apt,
        )

        # Distillation manager only if enabled (paper: small models).
        self._distiller = None
        if bool(self._cfg.apt.enable_apt) and bool(self._cfg.apt.use_self_distill):
            self._distiller = DistillationManager(
                apt_model=self._model,
                apt_config=self._cfg.apt,
            )

        # Profiler used by trainer and evaluator.
        self._profiler = Profiler(device=str(self._cfg.runtime.device))

        # Paper-aligned consistency checks that are entry-point responsibilities.
        self._assert_paper_aligned_configuration()

        self._logger.info("Prepared ExperimentSystem successfully.")

    ## @brief Train the system using the configured trainer.
    # @return TrainResult Training result.
    def train(self) -> TrainResult:
        if self._datasets is None or self._model is None:
            raise RuntimeError("prepare() must be called before train().")
        assert self._salience is not None
        assert self._pruner is not None
        assert self._rank_allocator is not None
        assert self._profiler is not None

        trainer = Trainer(
            model=self._model,
            datasets=self._datasets,
            config=self._cfg,
            salience=self._salience,
            pruner=self._pruner,
            rank_allocator=self._rank_allocator,
            distiller=self._distiller,
            profiler=self._profiler,
        )
        self._train_result = trainer.train()
        return self._train_result

    ## @brief Evaluate the trained model and benchmark inference.
    # @return EvalResult Evaluation result.
    def evaluate(self) -> EvalResult:
        if self._datasets is None or self._model is None:
            raise RuntimeError("prepare() must be called before evaluate().")
        assert self._profiler is not None

        # IMPORTANT: per paper, LoRA-style tuning params are mergeable after training for inference.
        # Merge adapters before running evaluator benchmarks (task metrics should remain unchanged).
        for _, m in self._model.named_apt_modules():
            m.merge_adapter()

        evaluator = Evaluator(
            model=self._model,
            datasets=self._datasets,
            config=self._cfg,
            profiler=self._profiler,
        )
        self._eval_result = evaluator.evaluate()
        return self._eval_result

    ## @brief Export a compact/merged model artifact for inference benchmarking.
    # @return str Export directory path.
    def export(self) -> str:
        if self._model is None:
            raise RuntimeError("prepare() must be called before export().")
        out_dir = Path(str(self._cfg.runtime.output_dir)) / "export"
        out_dir.mkdir(parents=True, exist_ok=True)
        self._export_path = self._model.export_compact_model(output_dir=str(out_dir))
        return self._export_path

    ## @brief Return a run summary dict for serialization.
    # @return dict[str, Any] Run summary.
    def summary(self) -> Dict[str, Any]:
        return {
            "train": {
                "best_checkpoint": self._train_result.best_checkpoint if self._train_result else "",
                "best_metric": self._train_result.best_metric if self._train_result else float("nan"),
                "peak_train_memory_mb": self._train_result.peak_train_memory_mb if self._train_result else float("nan"),
                "time_to_accuracy_s": self._train_result.time_to_accuracy_s if self._train_result else float("nan"),
            },
            "eval": {
                "task_metrics": self._eval_result.task_metrics if self._eval_result else {},
                "inference_metrics": self._eval_result.inference_metrics if self._eval_result else {},
                "artifacts": self._eval_result.artifact_paths if self._eval_result else {},
            },
            "export": {
                "path": self._export_path,
            },
        }

    ## @brief Enforce paper-aligned toggles and explicit config.yaml constraints at the entrypoint.
    # @details This is for fail-fast fidelity checks (do not silently mutate experiment behavior).
    # @return None
    def _assert_paper_aligned_configuration(self) -> None:
        # Validate global config.yaml declares the required schedule and constants.
        apt_cfg = self._paper_cfg.get("apt", {})
        if not isinstance(apt_cfg, dict):
            raise ValueError("config.yaml apt section must be a dict.")
        dist_cfg = self._paper_cfg.get("distillation", {})
        if not isinstance(dist_cfg, dict):
            raise ValueError("config.yaml distillation section must be a dict.")

        schedule = str(apt_cfg.get("target_sparsity_schedule", "")).strip().lower()
        if schedule != "cubic":
            raise ValueError("config.yaml apt.target_sparsity_schedule must be 'cubic' per paper.")

        # Ensure formula string exists (selection via config required by instructions).
        formula = str(apt_cfg.get("target_sparsity_formula", "")).strip()
        if "gamma_t" not in formula or "(1 - t / T)^3" not in formula.replace(" ", ""):
            raise ValueError(
                "config.yaml apt.target_sparsity_formula must describe the cubic schedule from the paper."
            )

        # mask_update_alpha_constant is paper-fixed at 0.01.
        alpha_yaml = float(apt_cfg.get("mask_update_alpha", 0.0))
        if alpha_yaml != 0.01:
            raise ValueError("config.yaml apt.mask_update_alpha must be 0.01 per paper.")

        # rank growth rule string must match paper intent.
        rank_growth = apt_cfg.get("rank_growth", {})
        if not isinstance(rank_growth, dict):
            raise ValueError("config.yaml apt.rank_growth must be a dict.")
        update_rule = str(rank_growth.get("update_rule", "")).strip()
        if "floor" not in update_rule.lower() or "Delta_t" not in update_rule:
            raise ValueError("config.yaml apt.rank_growth.update_rule must specify the floor( r * Δ'/Δ ) rule.")

        # distillation mu schedule must be linear_0_to_1.
        mu_sched = str(dist_cfg.get("mu_schedule", "")).strip().lower()
        if mu_sched != "linear_0_to_1":
            raise ValueError("config.yaml distillation.mu_schedule must be 'linear_0_to_1' per paper.")

        # Model-family specific checks.
        backbone = str(self._cfg.model.backbone_name)
        if _is_llama_backbone(backbone):
            if bool(self._cfg.apt.use_self_distill):
                raise ValueError("Paper config requires distillation disabled for LLaMA experiments.")
            if bool(self._cfg.model.use_ffn_adapters):
                raise ValueError("Paper implies FFN adapters used for smaller models; disable for LLaMA.")
            if len(self._cfg.evaluation.lm_eval_tasks) == 0:
                raise ValueError("LLaMA experiments require evaluation.lm_eval_tasks configured for lm-eval-harness.")
        else:
            # For small-model APT runs with pruning, distillation epochs must be non-zero per Table 6.
            if bool(self._cfg.apt.enable_apt) and bool(self._cfg.apt.use_self_distill):
                if int(self._cfg.training.distill_epochs) <= 0:
                    raise ValueError(
                        "Small-model APT with distillation requires training.distill_epochs > 0 per paper Table 6."
                    )

        # T5 fairness constraint (paper note): use t5-lm-adapt.
        if _is_t5_backbone(backbone):
            if "lm-adapt" not in backbone.lower():
                raise ValueError(
                    "Paper requires using t5-lm-adapt for fair comparison. "
                    f"Got backbone={backbone!r}. Use a t5-lm-adapt checkpoint."
                )


## @brief Main entry class following the design interface.
class Main:
    ## @brief Initialize Main with a config path.
    # @param config_path str Path to the experiment YAML.
    def __init__(self, config_path: str) -> None:
        self._config_path: str = str(config_path)
        self._logger = get_logger("apt.main")

    ## @brief Build the ExperimentSystem from the experiment configuration.
    # @return ExperimentSystem Constructed experiment system.
    def build_system(self) -> ExperimentSystem:
        cfg: ExperimentConfig = ExperimentConfig.from_yaml(self._config_path)
        # validate() is called within from_yaml(); call again defensively to ensure invariants.
        cfg.validate()
        return ExperimentSystem(config=cfg)

    ## @brief Run the experiment end-to-end: prepare, train, evaluate, export, summarize.
    # @details Includes entry-point checks for required paper equations/config selections.
    # @return None
    def run(self) -> None:
        system = self.build_system()
        cfg = system._cfg  # Use the validated config; keep local alias for entrypoint checks.

        # ---- Required equation presence checks in Main.run (verifiable expressions) ----

        # [apt_target_sparsity_cubic_schedule] (Sec. 7)
        # eq: apt_target_sparsity_cubic_schedule
        gamma_T: float = float(cfg.apt.target_sparsity)
        t: float = 1.0
        T: float = 10.0
        gamma_t: float = gamma_T + (1.0 - gamma_T) * (1.0 - t / T) ** 3

        # [mask_update_alpha_constant] (Appendix C / Sec. 7)
        # eq: mask_update_alpha_constant
        alpha: float = 0.01

        # [rank_growth_rule] (Sec. 4.3)
        # eq: rank_growth_rule
        r_apt: int = 8
        delta_t: float = 10.0
        delta_t_prime: float = 20.0
        r_prime: int = int(math.floor(float(r_apt) * (float(delta_t_prime) / float(delta_t))))

        # [distillation_mu_schedule_linear] (Eq. 7 / Sec. 4.4)
        # eq: distillation_mu_schedule_linear
        mu: float = 0.3
        l_distill: float = 2.0
        l_ft: float = 1.0
        l_total: float = mu * l_distill + (1.0 - mu) * l_ft

        # Sanity: keep expressions computed (avoid unused-variable lint); these do not change experiment behavior.
        if not (0.0 <= gamma_t <= 1.0):
            raise ValueError("Computed gamma_t from cubic schedule must be within [0,1].")
        if alpha != 0.01:
            raise ValueError("alpha must equal 0.01 per paper.")
        if r_prime != 16:
            raise ValueError("Rank growth rule sanity check failed for sample Δ_t'/Δ_t.")
        if l_total <= 0.0:
            raise ValueError("Distillation mixing sanity check failed.")

        # ---- Reproducibility: seed must be set before data/model creation. ----
        # Note: ExperimentSystem.prepare() loads datasets/models. Ensure seed is set before that.
        set_global_seed(seed=int(cfg.training.seed), deterministic=False)

        # Prepare, train, evaluate, export.
        system.prepare()
        train_result = system.train()
        eval_result = system.evaluate()
        export_path = system.export()

        # Persist top-line results.
        out_dir = Path(str(cfg.runtime.output_dir))
        out_dir.mkdir(parents=True, exist_ok=True)
        summary = system.summary()
        summary["export"]["path"] = str(export_path)
        save_json(out_dir / "run_summary.json", summary)

        self._logger.info("Done | best_ckpt=%s | best_metric=%.6g", train_result.best_checkpoint, train_result.best_metric)
        self._logger.info("Eval task metrics: %s", json.dumps(eval_result.task_metrics, sort_keys=True))
        self._logger.info("Eval inference metrics: %s", json.dumps(eval_result.inference_metrics, sort_keys=True))
        self._logger.info("Exported artifact: %s", str(export_path))


## @brief Program entrypoint.
# @return None
def _main() -> None:
    args = _parse_args()
    cfg_path: str = str(args.config)

    # Build config first so we can apply safe non-fidelity overrides (output_dir/device) explicitly.
    cfg: ExperimentConfig = ExperimentConfig.from_yaml(cfg_path)
    cfg.validate()

    if isinstance(getattr(args, "output_dir", ""), str) and args.output_dir.strip():
        cfg.runtime.output_dir = str(args.output_dir).strip()
    if isinstance(getattr(args, "device", ""), str) and args.device.strip():
        cfg.runtime.device = str(args.device).strip()

    # Determinism flag only affects RNG/torch settings, not hyperparameters.
    deterministic: bool = bool(getattr(args, "deterministic", False))
    set_global_seed(seed=int(cfg.training.seed), deterministic=deterministic)

    # Run via Main/ExperimentSystem but using the effective cfg already patched:
    # To respect the design (Main builds via ExperimentConfig.from_yaml), persist an override config snapshot.
    out_dir = Path(str(cfg.runtime.output_dir))
    out_dir.mkdir(parents=True, exist_ok=True)
    save_json(out_dir / "config_effective_from_cli.json", cfg.__dict__)

    # Run the actual main using the provided config path (which merges config.yaml + default.yaml + exp.yaml).
    # The CLI overrides for output_dir/device were applied to cfg above for reproducibility artifacts only;
    # to keep runtime behavior aligned, we re-run with environment variables used by downstream modules.
    os.environ["APT_LOG_LEVEL"] = os.environ.get("APT_LOG_LEVEL", str(cfg.runtime.log_level))

    runner = Main(config_path=cfg_path)
    runner.run()


if __name__ == "__main__":
    _main()
