## src/models/model_factory.py
from __future__ import annotations

from typing import Any, Dict, Optional

from transformers import (
    AutoModelForCausalLM,
    AutoModelForQuestionAnswering,
    AutoModelForSeq2SeqLM,
    AutoModelForSequenceClassification,
)

from src.config import ModelConfig
from src.utils.logging import get_logger


## @brief Factory for creating Hugging Face models for different task types.
# @details This class instantiates the correct HF AutoModel* class based on ModelConfig.task_type.
# It intentionally does not perform APT injection; per the repository call flow, injection is handled
# by ExperimentSystem using APTInjector with full ExperimentConfig. This avoids violating the
# ModelFactory constructor interface which only receives ModelConfig.
class ModelFactory:
    ## @brief Initialize the model factory.
    # @param model_config ModelConfig Model configuration.
    def __init__(self, model_config: ModelConfig) -> None:
        if model_config is None:
            raise ValueError("model_config must be non-None.")
        self._cfg: ModelConfig = model_config
        self._logger = get_logger("apt.model_factory")

        self._task_type: str = self._normalize_task_type(str(self._cfg.task_type))
        self._validate_model_config()

    ## @brief Create the base Hugging Face model for the configured task.
    # @details Returns the raw HF model instance with the appropriate task head.
    # @return Any Hugging Face model instance (torch.nn.Module).
    def create_base_model(self) -> Any:
        backbone: str = str(self._cfg.backbone_name).strip()
        trust_remote_code: bool = bool(getattr(self._cfg, "trust_remote_code", False))
        model_kwargs: Dict[str, Any] = {"trust_remote_code": trust_remote_code}

        if self._task_type == "sequence_classification":
            # GLUE tasks in the paper use classification heads; num_labels must be explicit for MNLI (3).
            num_labels: int = int(getattr(self._cfg, "num_labels", 0) or 0)
            model_kwargs["num_labels"] = num_labels
            self._logger.info(
                "Loading AutoModelForSequenceClassification | backbone=%s | num_labels=%d | trust_remote_code=%s",
                backbone,
                num_labels,
                trust_remote_code,
            )
            return AutoModelForSequenceClassification.from_pretrained(backbone, **model_kwargs)

        if self._task_type == "qa":
            self._logger.info(
                "Loading AutoModelForQuestionAnswering | backbone=%s | trust_remote_code=%s",
                backbone,
                trust_remote_code,
            )
            return AutoModelForQuestionAnswering.from_pretrained(backbone, **model_kwargs)

        if self._task_type == "seq2seq":
            self._logger.info(
                "Loading AutoModelForSeq2SeqLM | backbone=%s | trust_remote_code=%s",
                backbone,
                trust_remote_code,
            )
            return AutoModelForSeq2SeqLM.from_pretrained(backbone, **model_kwargs)

        if self._task_type == "causal_lm":
            self._logger.info(
                "Loading AutoModelForCausalLM | backbone=%s | trust_remote_code=%s",
                backbone,
                trust_remote_code,
            )
            return AutoModelForCausalLM.from_pretrained(backbone, **model_kwargs)

        raise ValueError(f"Unsupported task_type={self._task_type!r} for model creation.")

    ## @brief Create the model for the configured task.
    # @details Per project call flow, this returns the base HF model only. APT injection is performed
    # outside this factory using APTInjector(apt_config).inject(model).
    # @return Any Hugging Face model instance (torch.nn.Module).
    def create_model_for_task(self) -> Any:
        return self.create_base_model()

    ## @brief Normalize task type strings to canonical identifiers.
    # @param task_type str Raw task type string.
    # @return str Canonical task type in {"sequence_classification","qa","seq2seq","causal_lm"}.
    def _normalize_task_type(self, task_type: str) -> str:
        raw: str = (task_type or "").strip().lower()
        mapping: Dict[str, str] = {
            "sequence_classification": "sequence_classification",
            "classification": "sequence_classification",
            "seq_classification": "sequence_classification",
            "question_answering": "qa",
            "qa": "qa",
            "extractive_qa": "qa",
            "seq2seq": "seq2seq",
            "seq2seq_lm": "seq2seq",
            "text2text": "seq2seq",
            "causal_lm": "causal_lm",
            "causallm": "causal_lm",
            "clm": "causal_lm",
        }
        canonical: str = mapping.get(raw, raw)
        return canonical

    ## @brief Validate ModelConfig fields required for model instantiation.
    # @return None
    def _validate_model_config(self) -> None:
        backbone: str = str(self._cfg.backbone_name).strip()
        if not backbone:
            raise ValueError("ModelConfig.backbone_name must be a non-empty string.")

        if self._task_type not in ("sequence_classification", "qa", "seq2seq", "causal_lm"):
            raise ValueError(
                "ModelConfig.task_type must be one of "
                "{'sequence_classification','qa','seq2seq','causal_lm'}, "
                f"got {self._cfg.task_type!r}."
            )

        if self._task_type == "sequence_classification":
            num_labels: int = int(getattr(self._cfg, "num_labels", 0) or 0)
            if num_labels <= 0:
                raise ValueError(
                    "For sequence_classification tasks (e.g., GLUE SST-2/MNLI), "
                    "ModelConfig.num_labels must be set (>0) to instantiate the correct classification head."
                )
