## src/eval/lm_eval_adapter.py
from __future__ import annotations

import os
import re
import tempfile
from pathlib import Path
from typing import Any, Dict, List, Mapping, Optional, Tuple, Union

import numpy as np
import torch
import yaml

from src.config import ExperimentConfig
from src.utils.logging import get_logger

_LOGGER = get_logger("apt.lm_eval")


## @brief Load the global paper configuration (config.yaml) with caching.
# @details This adapter uses config.yaml only for values that are explicitly defined there, namely
# LLaMA inference batch sizes. Task lists and few-shot settings must come from ExperimentConfig.
# @param config_path str | None Optional path to config.yaml.
# @return dict[str, Any] Parsed YAML dict.
def _load_paper_config(config_path: Optional[str] = None) -> Dict[str, Any]:
    if not hasattr(_load_paper_config, "_cache"):
        setattr(_load_paper_config, "_cache", None)

    cached: Optional[Dict[str, Any]] = getattr(_load_paper_config, "_cache")
    if cached is not None and config_path is None:
        return cached

    candidates: List[Path] = []
    if config_path is not None:
        candidates.append(Path(str(config_path)))
    candidates.extend(
        [
            Path(os.getcwd()) / "config.yaml",
            Path(__file__).resolve().parents[2] / "config.yaml",  # repo_root/config.yaml (src/eval/..)
            Path(__file__).resolve().parents[3] / "config.yaml",
        ]
    )

    for p in candidates:
        if p.exists():
            with p.open("r", encoding="utf-8") as f:
                data = yaml.safe_load(f) or {}
            if not isinstance(data, dict):
                raise ValueError(f"config.yaml root must be a dict, got {type(data)}")
            if config_path is None:
                setattr(_load_paper_config, "_cache", data)
            return data

    raise FileNotFoundError("Cannot find required config.yaml in CWD or repository parents.")


## @brief Safe nested-get for dicts using dotted path.
# @param d dict[str, Any] Root dictionary.
# @param path str Dotted path (e.g., "evaluation.inference_batch_size.llama_7b").
# @param default Any Default if missing.
# @return Any Retrieved value or default.
def _get_nested(d: Dict[str, Any], path: str, default: Any) -> Any:
    cur: Any = d
    for part in str(path).split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return cur


## @brief Coerce a value to int with a default.
# @param v Any Input value.
# @param default int Default if v is None.
# @return int Coerced int.
def _as_int(v: Any, default: int) -> int:
    if v is None:
        return int(default)
    if isinstance(v, bool):
        return int(v)
    if isinstance(v, int):
        return int(v)
    if isinstance(v, float) and float(v).is_integer():
        return int(v)
    if isinstance(v, str):
        return int(v.strip())
    raise ValueError(f"Cannot coerce to int: {v!r}")


## @brief Determine whether a backbone string corresponds to a LLaMA-family model.
# @param backbone_name str Backbone name string.
# @return bool True if LLaMA-like.
def _is_llama_backbone(backbone_name: str) -> bool:
    s: str = (backbone_name or "").lower()
    return ("llama" in s) or ("llemma" in s)


## @brief Infer the paper-defined LLaMA inference batch size from config.yaml.
# @details Paper config.yaml defines:
#   evaluation.inference_batch_size.llama_7b = 32
#   evaluation.inference_batch_size.llama_13b = 4
# @param config ExperimentConfig Experiment config.
# @return int Batch size.
def _infer_llama_eval_batch_size_from_paper_config(config: ExperimentConfig) -> int:
    paper_cfg: Dict[str, Any] = _load_paper_config()
    bs_cfg: Any = _get_nested(paper_cfg, "evaluation.inference_batch_size", {})
    if not isinstance(bs_cfg, dict):
        raise ValueError("config.yaml evaluation.inference_batch_size must be a dict.")

    backbone: str = str(config.model.backbone_name or "").lower()
    if "13b" in backbone:
        return _as_int(bs_cfg.get("llama_13b", None), 4)
    return _as_int(bs_cfg.get("llama_7b", None), 32)


## @brief Infer a device string for lm-eval-harness.
# @param model Any Model object.
# @param config ExperimentConfig Experiment config.
# @return str Device string.
def _infer_device_str(model: Any, config: ExperimentConfig) -> str:
    device_s: str = str(getattr(config.runtime, "device", "cuda") or "cuda")
    # If model already has parameters on a device, prefer that.
    try:
        if hasattr(model, "parameters"):
            for p in model.parameters():
                if torch.is_tensor(p):
                    return str(p.device)
    except Exception:
        pass
    return device_s


## @brief Infer a dtype string compatible with lm-eval-harness HF wrapper.
# @details Uses model parameter dtype if available; otherwise returns "auto".
# @param model Any Model.
# @return str Dtype string ("float16", "bfloat16", "float32", or "auto").
def _infer_dtype_str(model: Any) -> str:
    try:
        if hasattr(model, "parameters"):
            for p in model.parameters():
                if torch.is_tensor(p):
                    dt: torch.dtype = p.dtype
                    if dt == torch.float16:
                        return "float16"
                    if dt == torch.bfloat16:
                        return "bfloat16"
                    if dt == torch.float32:
                        return "float32"
                    break
    except Exception:
        pass
    return "auto"


## @brief Normalize a user-provided lm-eval task name to a harness task id.
# @details This function provides minimal aliasing for the paper's wording:
#  - "arc" -> "arc_challenge"
#  - "truthfulqa" -> "truthfulqa_mc2"
#  - "hellaswag" stays "hellaswag"
#  - "mmlu" stays "mmlu"
# If the user already provides a full harness id, it is returned unchanged.
# @param task str Task name from config.evaluation.lm_eval_tasks.
# @return str Resolved lm-eval-harness task id.
def resolve_task_name(task: str) -> str:
    t: str = str(task or "").strip()
    if not t:
        raise ValueError("lm_eval task name must be a non-empty string.")

    key: str = t.lower()
    aliases: Dict[str, str] = {
        "arc": "arc_challenge",
        "arc_25shot": "arc_challenge",
        "arc25": "arc_challenge",
        "arc_challenge_25shot": "arc_challenge",
        "hellaswag": "hellaswag",
        "mmlu": "mmlu",
        "truthfulqa": "truthfulqa_mc2",
        "truthfulqa_0shot": "truthfulqa_mc2",
        "truthfulqa_mc2": "truthfulqa_mc2",
        "truthfulqa_mc1": "truthfulqa_mc1",
    }
    return aliases.get(key, t)


## @brief Get the few-shot count for a task from EvalConfig, enforcing paper settings.
# @details Paper few-shot settings:
#  - ARC: 25-shot
#  - HellaSwag: 10-shot
#  - MMLU: 5-shot
#  - TruthfulQA: 0-shot
# This function does not guess; it requires an explicit entry in config.evaluation.lm_eval_num_fewshot.
# @param task str Task name (resolved id or user id).
# @param config ExperimentConfig Experiment config (uses config.evaluation.lm_eval_num_fewshot).
# @return int num_fewshot for this task.
def get_task_fewshot(task: str, config: ExperimentConfig) -> int:
    task_key: str = str(task or "").strip()
    if not task_key:
        raise ValueError("task must be non-empty in get_task_fewshot().")

    fewshot_map: Dict[str, int] = dict(getattr(config.evaluation, "lm_eval_num_fewshot", {}) or {})
    if task_key in fewshot_map:
        return int(fewshot_map[task_key])

    # Allow mapping using alias inputs too (e.g., "arc" even if resolved is "arc_challenge").
    raw_tasks: List[str] = list(getattr(config.evaluation, "lm_eval_tasks", []) or [])
    for raw in raw_tasks:
        if resolve_task_name(raw) == task_key and raw in fewshot_map:
            return int(fewshot_map[raw])

    raise KeyError(
        f"Missing few-shot setting for task={task_key!r}. "
        "Provide it in evaluation.lm_eval_num_fewshot in the experiment config."
    )


## @brief Extract the primary scalar score from an lm-eval task metrics dict.
# @details Uses deterministic metric preferences consistent with Open LLM Leaderboard conventions:
#  - arc_challenge: prefer acc_norm then acc
#  - hellaswag: prefer acc_norm then acc
#  - mmlu: prefer acc then acc_norm
#  - truthfulqa_mc2/mc1: prefer acc
# Scores are converted to percentage scale if they are in [0,1].
# @param task str Resolved task id.
# @param task_metrics dict[str, float] Metric dict for that task from lm-eval-harness.
# @return tuple[float, str] (primary_score_percent, metric_key_used).
def extract_primary_score(task: str, task_metrics: Dict[str, Any]) -> Tuple[float, str]:
    if not isinstance(task_metrics, dict):
        raise ValueError(f"task_metrics must be a dict for task={task!r}, got {type(task_metrics)}")

    t: str = str(task or "").strip().lower()
    if not t:
        raise ValueError("task must be non-empty in extract_primary_score().")

    preferences_by_task: List[Tuple[str, List[str]]] = [
        ("arc_challenge", ["acc_norm", "acc"]),
        ("hellaswag", ["acc_norm", "acc"]),
        ("mmlu", ["acc", "acc_norm"]),
        ("truthfulqa_mc2", ["acc"]),
        ("truthfulqa_mc1", ["acc"]),
    ]

    preferred: List[str] = []
    for prefix, prefs in preferences_by_task:
        if t == prefix or t.startswith(prefix):
            preferred = list(prefs)
            break
    if not preferred:
        # Deterministic fallback for unknown tasks: prefer common accuracy-like keys.
        preferred = ["acc_norm", "acc", "exact_match", "f1"]

    chosen_key: Optional[str] = None
    chosen_val: Optional[float] = None
    for k in preferred:
        if k in task_metrics:
            chosen_key = str(k)
            chosen_val = float(task_metrics[k])
            break

    if chosen_key is None or chosen_val is None:
        available: List[str] = sorted([str(k) for k in task_metrics.keys()])
        raise KeyError(
            f"Could not find a primary metric for task={task!r}. "
            f"Tried keys={preferred}. Available keys={available}."
        )

    # Convert to percent scale for accuracy-like metrics.
    score: float = float(chosen_val)
    if chosen_key in ("acc", "acc_norm", "exact_match", "f1") and 0.0 <= score <= 1.0:
        score = 100.0 * score

    return float(score), str(chosen_key)


## @brief Build an lm-eval-harness Hugging Face LM wrapper for an in-memory model or a pretrained path.
# @details Uses lm_eval.models.huggingface.HFLM. Prefers in-memory (pretrained=model) when supported
# by the installed lm-eval version; otherwise requires a pretrained_path.
# @param model Any In-memory HF model (transformers.PreTrainedModel-like) or wrapper containing `.model`.
# @param tokenizer Any HF tokenizer.
# @param device str Device string.
# @param batch_size Union[int, str] Batch size for lm-eval (int or "auto").
# @param trust_remote_code bool Whether to enable trust_remote_code in HF wrapper.
# @param dtype str Dtype string ("auto" or explicit dtype).
# @param pretrained_path str | None Optional path to a saved HF model.
# @return Any lm-eval-harness LM instance.
def _build_harness_lm(
    model: Any,
    tokenizer: Any,
    device: str,
    batch_size: Union[int, str],
    trust_remote_code: bool,
    dtype: str,
    pretrained_path: Optional[str],
) -> Any:
    try:
        from lm_eval.models.huggingface import HFLM  # type: ignore
    except Exception as e:
        raise ImportError(
            "Failed to import lm_eval.models.huggingface.HFLM. "
            "Ensure lm-eval-harness is installed (package 'lm-eval')."
        ) from e

    # If user passes our APTModelWrapper, unwrap the underlying model if present.
    underlying: Any = getattr(model, "model", None)
    model_obj: Any = underlying if underlying is not None else model

    # Try in-memory model first.
    try:
        lm = HFLM(
            pretrained=model_obj,
            tokenizer=tokenizer,
            device=str(device),
            batch_size=batch_size,
            trust_remote_code=bool(trust_remote_code),
            dtype=str(dtype),
        )
        return lm
    except Exception as e_inmem:
        if pretrained_path is None:
            raise RuntimeError(
                "Installed lm-eval-harness does not accept an in-memory model object for HFLM(pretrained=...). "
                "Provide a saved model path to run lm-eval-harness (e.g., export merged model and pass its path). "
                f"Original error: {repr(e_inmem)}"
            ) from e_inmem

    # Fallback: load from a checkpoint directory.
    lm = HFLM(
        pretrained=str(pretrained_path),
        tokenizer=tokenizer,
        device=str(device),
        batch_size=batch_size,
        trust_remote_code=bool(trust_remote_code),
        dtype=str(dtype),
    )
    return lm


## @brief Run lm-eval-harness evaluation for a single task with a specific few-shot setting.
# @details Uses lm_eval.evaluator.simple_evaluate on a single task to enforce task-specific num_fewshot.
# @param lm Any lm-eval-harness LM instance.
# @param task str Resolved task id.
# @param num_fewshot int Few-shot count for this task.
# @param batch_size Union[int, str] Batch size (int or "auto").
# @param seed int Random seed for reproducibility.
# @return dict[str, Any] lm-eval-harness evaluation result dict.
def run_single_task(
    lm: Any,
    task: str,
    num_fewshot: int,
    batch_size: Union[int, str],
    seed: int,
) -> Dict[str, Any]:
    # Reproducibility: set RNG seeds locally (defensive; main program also sets seeds).
    np.random.seed(int(seed))
    torch.manual_seed(int(seed))
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(int(seed))

    try:
        from lm_eval import evaluator as lm_evaluator  # type: ignore
    except Exception as e:
        raise ImportError(
            "Failed to import lm_eval.evaluator. Ensure lm-eval-harness is installed (package 'lm-eval')."
        ) from e

    # lm-eval-harness supports task-level evaluation with per-call num_fewshot.
    # Use defaults for any unspecified settings (limit/bootstrap_iters/etc.) to avoid fabricating values.
    result: Dict[str, Any] = lm_evaluator.simple_evaluate(
        model=lm,
        tasks=[str(task)],
        num_fewshot=int(num_fewshot),
        batch_size=batch_size,
        # Some versions accept `random_seed`; keep compatibility by passing via kwargs if available.
        # We do not rely on it being accepted; seeds are set above.
    )
    if not isinstance(result, dict):
        raise ValueError(f"lm_eval.evaluator.simple_evaluate returned non-dict result: {type(result)}")
    return result


## @brief Merge APT adapters into base weights before evaluation when possible.
# @details Paper notes LoRA-style parameters are mergeable after training for inference efficiency.
# If the passed object provides named_apt_modules(), we call merge_adapter() for each APTLinear.
# @param model Any Model or APTModelWrapper-like object.
# @return None
def _maybe_merge_apt_adapters(model: Any) -> None:
    # Best-effort only; merging is safe to skip if the model is already merged or does not expose adapters.
    if model is None:
        return
    named_apt = getattr(model, "named_apt_modules", None)
    if not callable(named_apt):
        return
    try:
        pairs = named_apt()
        if not isinstance(pairs, list):
            return
        for _, m in pairs:
            merge = getattr(m, "merge_adapter", None)
            if callable(merge):
                merge()
    except Exception as e:
        _LOGGER.warning("APT adapter merge before lm-eval failed (continuing without merge): %s", repr(e))


## @brief Normalize a task name to a safe metric key suffix.
# @param task str Task id.
# @return str Safe key suffix.
def _safe_task_key(task: str) -> str:
    s: str = str(task or "").strip()
    s = re.sub(r"[^0-9a-zA-Z_]+", "_", s)
    s = re.sub(r"_+", "_", s).strip("_")
    return s.lower()


## @brief Run the paper-specified lm-eval-harness evaluation for LLaMA experiments.
# @details Evaluates tasks from config.evaluation.lm_eval_tasks with task-specific few-shot counts
# from config.evaluation.lm_eval_num_fewshot. Returns percent-scale primary scores and an average.
#
# Tasks per paper (Sec. 5.1): ARC (25-shot), HellaSwag (10-shot), MMLU (5-shot), TruthfulQA (0-shot).
# @param model Any Causal LM model object (can be APTModelWrapper or raw HF model).
# @param tokenizer Any HF tokenizer.
# @param config ExperimentConfig Experiment configuration.
# @param pretrained_path str | None Optional saved-model path for lm-eval wrapper if in-memory is unsupported.
# @return dict[str, float] Metrics dict including per-task scores and "lm_eval_avg".
def run_lm_eval(
    model: Any,
    tokenizer: Any,
    config: ExperimentConfig,
    pretrained_path: Optional[str] = None,
) -> Dict[str, float]:
    if config is None:
        raise ValueError("config must be non-None.")
    if not _is_llama_backbone(str(config.model.backbone_name or "")):
        raise ValueError(
            f"run_lm_eval is intended for LLaMA-family experiments, got backbone={config.model.backbone_name!r}."
        )

    tasks_raw: List[str] = list(getattr(config.evaluation, "lm_eval_tasks", []) or [])
    if len(tasks_raw) == 0:
        raise ValueError(
            "evaluation.lm_eval_tasks is empty. Provide the lm-eval-harness tasks to evaluate "
            "(paper uses ARC, HellaSwag, MMLU, TruthfulQA)."
        )

    # Resolve task ids deterministically.
    tasks_resolved: List[str] = [resolve_task_name(t) for t in tasks_raw]
    _LOGGER.info("lm-eval tasks (resolved): %s", tasks_resolved)

    # Enforce batch size from paper config.yaml. Prefer config.data.eval_batch_size (already validated),
    # but fall back to reading config.yaml if needed.
    batch_size: int = int(getattr(config.data, "eval_batch_size", 0) or 0)
    if batch_size <= 0:
        batch_size = int(_infer_llama_eval_batch_size_from_paper_config(config))

    device: str = _infer_device_str(model=model, config=config)
    trust_remote_code: bool = bool(getattr(config.model, "trust_remote_code", False))
    dtype: str = _infer_dtype_str(getattr(model, "model", model))

    # Merge adapters for inference (best-effort, aligns with paper "mergeable after training").
    _maybe_merge_apt_adapters(model)

    # Build harness LM wrapper. If in-memory model is unsupported by the installed lm-eval,
    # this will require pretrained_path.
    lm = _build_harness_lm(
        model=model,
        tokenizer=tokenizer,
        device=device,
        batch_size=int(batch_size),
        trust_remote_code=trust_remote_code,
        dtype=dtype,
        pretrained_path=pretrained_path,
    )

    seed: int = int(getattr(config.training, "seed", 42) or 42)

    out: Dict[str, float] = {}
    primary_scores: List[float] = []

    # Evaluate one task at a time to enforce task-specific num_fewshot exactly.
    for task in tasks_resolved:
        num_fewshot: int = int(get_task_fewshot(task=task, config=config))

        # First attempt: fixed numeric batch size (paper setting).
        try:
            res = run_single_task(
                lm=lm,
                task=task,
                num_fewshot=num_fewshot,
                batch_size=int(batch_size),
                seed=seed,
            )
        except RuntimeError as e:
            msg = str(e).lower()
            # Allowed fallback per design notes: use harness batch_size="auto" if OOM occurs.
            if "out of memory" in msg or "cuda oom" in msg or "cuda out of memory" in msg:
                _LOGGER.warning(
                    "OOM during lm-eval task=%s with batch_size=%d; retrying with batch_size='auto'. Error=%s",
                    task,
                    int(batch_size),
                    repr(e),
                )
                res = run_single_task(
                    lm=lm,
                    task=task,
                    num_fewshot=num_fewshot,
                    batch_size="auto",
                    seed=seed,
                )
            else:
                raise

        results_obj: Any = res.get("results", None)
        if not isinstance(results_obj, dict):
            raise ValueError(f"lm-eval result missing 'results' dict for task={task!r}. Keys={list(res.keys())}")

        task_metrics_any: Any = results_obj.get(task, None)
        if not isinstance(task_metrics_any, dict):
            # Some harness versions normalize task names; try to find a single entry.
            if len(results_obj) == 1:
                only_task = next(iter(results_obj.keys()))
                task_metrics_any = results_obj[only_task]
                _LOGGER.warning(
                    "lm-eval results task key mismatch: requested=%s, got=%s. Using returned key.",
                    task,
                    only_task,
                )
                task = str(only_task)
            else:
                raise ValueError(
                    f"lm-eval results do not contain task={task!r}. Available tasks={sorted(list(results_obj.keys()))}"
                )

        primary_score, metric_key = extract_primary_score(task=task, task_metrics=task_metrics_any)

        safe_key = _safe_task_key(task)
        out[f"lm_eval_{safe_key}"] = float(primary_score)
        out[f"lm_eval_{safe_key}_metric"] = float(primary_score)  # stable alias for consumers that ignore metric key
        out[f"lm_eval_{safe_key}_metric_key"] = float("nan")  # numeric dict contract; key string is logged below

        # Also store raw metrics (as floats) under namespaced keys where possible.
        for mk, mv in sorted(task_metrics_any.items(), key=lambda kv: str(kv[0])):
            if isinstance(mv, (int, float, np.floating)):
                out[f"lm_eval_{safe_key}_{str(mk)}"] = float(mv)

        _LOGGER.info(
            "lm-eval | task=%s | fewshot=%d | primary_metric=%s | score=%.6g",
            task,
            int(num_fewshot),
            metric_key,
            float(primary_score),
        )

        primary_scores.append(float(primary_score))

    # Average across evaluated tasks (paper reports "Avg." across the four tasks).
    if len(primary_scores) == 0:
        raise ValueError("No lm-eval task scores were produced; cannot compute average.")
    out["lm_eval_avg"] = float(sum(primary_scores) / float(len(primary_scores)))
    return out
