## src/models/apt_linear.py
from __future__ import annotations

import math
from typing import Any, Dict, Optional

import torch
import torch.nn as nn
import torch.nn.functional as F


## @brief APT adapter linear module implementing masked LoRA with dynamic rank.
# @details Wraps a frozen pretrained linear layer W and adds an APT adapter:
#   H_apt(X) = m_o • (W + s • W_B W_A) X • m_i
# where:
#   - m_i masks input dimensions
#   - m_o masks output dimensions
#   - W_A, W_B are low-rank tuning weights with dynamic rank expansion
# The scaling factor s is fixed to 2 per config.yaml (apt.scaling_factor).
class APTLinear(nn.Module):
    ## @brief Initialize an APTLinear wrapper.
    # @param base_linear nn.Module Base linear-like module with .weight and optional .bias.
    # @param in_features int Input feature dimension d_i.
    # @param out_features int Output feature dimension d_o.
    # @param rank int Initial adapter rank r_apt (paper/config: 8).
    # @param alpha float Scaling factor s (paper/config: 2). Checked for consistency.
    # @param module_name str Fully-qualified module name used for registry/logging.
    # @param group_name str Structural group name used by pruning/tuning logic.
    def __init__(
        self,
        base_linear: nn.Module,
        in_features: int,
        out_features: int,
        rank: int,
        alpha: float,
        module_name: str,
        group_name: str,
    ) -> None:
        super().__init__()

        if base_linear is None:
            raise ValueError("base_linear must be non-None.")
        if not hasattr(base_linear, "weight"):
            raise ValueError("base_linear must have a .weight attribute.")
        if in_features <= 0 or out_features <= 0:
            raise ValueError("in_features and out_features must be positive.")
        if rank <= 0:
            raise ValueError("rank must be positive (paper uses initial rank 8).")
        if not module_name:
            raise ValueError("module_name must be a non-empty string.")
        if not group_name:
            raise ValueError("group_name must be a non-empty string.")

        # eq: apt_initial_rank_config
        self.base_linear: nn.Module = base_linear
        self.in_features: int = int(in_features)
        self.out_features: int = int(out_features)
        self._rank: int = int(rank)
        self._alpha: float = float(alpha)
        self._module_name: str = str(module_name)
        self._group_name: str = str(group_name)

        # Per config.yaml apt.scaling_factor = 2, and src/config.py enforces this.
        if abs(self._alpha - 2.0) > 0.0:
            raise ValueError(f"APT scaling factor must be 2 per paper/config.yaml, got alpha={self._alpha}.")

        # Freeze pretrained parameters (PEFT setting).
        w: torch.Tensor = getattr(self.base_linear, "weight")
        if not torch.is_tensor(w):
            raise ValueError("base_linear.weight must be a torch.Tensor/Parameter.")
        self.base_linear.weight.requires_grad_(False)
        if getattr(self.base_linear, "bias", None) is not None:
            self.base_linear.bias.requires_grad_(False)

        # Initialize masks as float buffers, updated by MaskManager (not by gradient).
        # Shapes follow paper: m_i ∈ R^{d_i}, m_o ∈ R^{d_o}.
        mask_device: torch.device = w.device
        mask_dtype: torch.dtype = w.dtype
        self.register_buffer("_input_mask", torch.ones(self.in_features, device=mask_device, dtype=mask_dtype))
        self.register_buffer("_output_mask", torch.ones(self.out_features, device=mask_device, dtype=mask_dtype))

        # LoRA-style parameters:
        # W_A ∈ R^{r x d_i} initialized with N(0, σ^2), W_B ∈ R^{d_o x r} initialized with zeros
        # so output is unchanged at initialization.
        self.lora_A: nn.Parameter = nn.Parameter(
            torch.empty(self._rank, self.in_features, device=mask_device, dtype=mask_dtype)
        )
        self.lora_B: nn.Parameter = nn.Parameter(
            torch.empty(self.out_features, self._rank, device=mask_device, dtype=mask_dtype)
        )
        # Use standard LoRA initialization convention (Gaussian for A, zeros for B).
        # σ is not specified in config.yaml; this is the commonly used LoRA std and matches expand_rank default.
        nn.init.normal_(self.lora_A, mean=0.0, std=0.02)
        nn.init.zeros_(self.lora_B)

        self._merged: bool = False

    ## @brief Forward pass implementing APT Eq. (2).
    # @param x torch.Tensor Input tensor with trailing dimension d_i.
    # @return torch.Tensor Output tensor with trailing dimension d_o.
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if not torch.is_tensor(x):
            raise TypeError(f"APTLinear.forward expected torch.Tensor input, got {type(x)}.")
        if x.shape[-1] != self.in_features:
            raise ValueError(f"Input trailing dim must be {self.in_features}, got {int(x.shape[-1])}.")

        # Eq. (2): H_apt(X) = m_o • (W + s • W_B W_A) X • m_i
        # Implement masking as Hadamard on feature dimensions.
        # Apply input mask (X • m_i).
        m_i: torch.Tensor = self._input_mask
        x_masked: torch.Tensor = x * m_i  # broadcast on leading dims

        # Base output W(X • m_i).
        # Use base_linear forward to respect potential custom behavior (but weight/bias are frozen).
        y_base: torch.Tensor = self.base_linear(x_masked)

        if self._merged:
            # After merge, adapter contribution is folded into base weight.
            # Still apply output mask (m_o • ...).
            m_o: torch.Tensor = self._output_mask
            return y_base * m_o

        # Low-rank residual: (W_B W_A)(X • m_i) == W_B( W_A (X • m_i) )
        # Compute (X • m_i) @ W_A^T -> shape [..., r]
        a_out: torch.Tensor = F.linear(x_masked, self.lora_A, bias=None)
        # Compute a_out @ W_B^T -> shape [..., d_o]
        b_out: torch.Tensor = F.linear(a_out, self.lora_B, bias=None)

        # Scale by s=2 (config.yaml apt.scaling_factor) and add.
        # eq: apt_scaling_factor_config
        # eq: apt_forward_eq2
        y: torch.Tensor = y_base + (2.0 * b_out)

        # Apply output mask (m_o • ...).
        m_o = self._output_mask
        y = y * m_o
        return y

    ## @brief Set the input-dimension pruning mask m_i.
    # @param mask torch.Tensor Mask tensor of shape [in_features].
    # @return None
    def set_input_mask(self, mask: torch.Tensor) -> None:
        mask_t: torch.Tensor = torch.as_tensor(mask)
        if mask_t.ndim != 1 or int(mask_t.numel()) != self.in_features:
            raise ValueError(f"Input mask must be 1D with length {self.in_features}, got {tuple(mask_t.shape)}.")
        mask_t = mask_t.to(device=self._input_mask.device, dtype=self._input_mask.dtype)
        with torch.no_grad():
            self._input_mask.copy_(mask_t)

    ## @brief Set the output-dimension pruning mask m_o.
    # @param mask torch.Tensor Mask tensor of shape [out_features].
    # @return None
    def set_output_mask(self, mask: torch.Tensor) -> None:
        mask_t: torch.Tensor = torch.as_tensor(mask)
        if mask_t.ndim != 1 or int(mask_t.numel()) != self.out_features:
            raise ValueError(f"Output mask must be 1D with length {self.out_features}, got {tuple(mask_t.shape)}.")
        mask_t = mask_t.to(device=self._output_mask.device, dtype=self._output_mask.dtype)
        with torch.no_grad():
            self._output_mask.copy_(mask_t)

    ## @brief Expand the adapter rank by reallocating W_A and W_B.
    # @details Implements paper Sec 4.3: when expanding from r to r', concatenate:
    #   - new rows in W_A ~ N(0, σ^2)
    #   - new cols in W_B = 0
    # so that layer output is unchanged immediately after expansion.
    # @param new_rank int Target rank r'_apt (must be >= current rank).
    # @param init_std float Standard deviation σ for N(0, σ^2).
    # @return None
    def expand_rank(self, new_rank: int, init_std: float = 0.02) -> None:
        if self._merged:
            raise RuntimeError("Cannot expand rank after merge_adapter() has been called.")

        if init_std <= 0.0:
            raise ValueError(f"init_std must be > 0, got {init_std}.")

        # Ensure floor operation appears explicitly per paper rule.
        # eq: apt_rank_update_rule
        r_apt: int = int(self._rank)
        delta_t: float = float(r_apt)
        delta_t_prime: float = float(new_rank)
        r_prime: int = int(math.floor(r_apt * (delta_t_prime / delta_t))) if delta_t > 0 else int(new_rank)

        new_r: int = int(r_prime)
        if new_r <= self._rank:
            return

        device: torch.device = self.lora_A.device
        dtype: torch.dtype = self.lora_A.dtype

        # Allocate new parameters.
        new_A: torch.Tensor = torch.empty(new_r, self.in_features, device=device, dtype=dtype)
        new_B: torch.Tensor = torch.empty(self.out_features, new_r, device=device, dtype=dtype)

        with torch.no_grad():
            # Copy old.
            new_A[: self._rank, :].copy_(self.lora_A.data)
            new_B[:, : self._rank].copy_(self.lora_B.data)

            # Initialize added components.
            # eq: apt_rank_expansion_init
            # New rows in W_A: N(0, σ^2)
            if new_r > self._rank:
                added_rows: torch.Tensor = new_A[self._rank :, :]
                added_rows.normal_(mean=0.0, std=float(init_std))

                # New columns in W_B: zeros
                added_cols: torch.Tensor = new_B[:, self._rank :]
                added_cols.zero_()

        # Replace parameters (shape change); trainer must reset optimizer as per paper.
        self.lora_A = nn.Parameter(new_A)
        self.lora_B = nn.Parameter(new_B)
        self._rank = new_r

    ## @brief Merge the adapter weights into the base frozen weight for inference efficiency.
    # @details Adds s * (W_B @ W_A) into base_linear.weight and disables adapter branch.
    # This reflects the paper's note that LoRA-like tuning parameters are mergeable after training.
    # @return None
    def merge_adapter(self) -> None:
        if self._merged:
            return

        if not hasattr(self.base_linear, "weight"):
            raise ValueError("base_linear must have weight to merge adapter into.")

        w: torch.Tensor = getattr(self.base_linear, "weight")
        if not torch.is_tensor(w):
            raise ValueError("base_linear.weight must be a torch.Tensor/Parameter.")

        with torch.no_grad():
            # Compute ΔW = s * (W_B W_A) with s=2.
            delta_w: torch.Tensor = torch.matmul(self.lora_B.data, self.lora_A.data)  # [out, in]
            w.add_(2.0 * delta_w)

        # Disable adapter computations.
        self.lora_A.requires_grad_(False)
        self.lora_B.requires_grad_(False)
        self._merged = True

    ## @brief Return the current adapter rank.
    # @return int Current rank r_apt.
    def current_rank(self) -> int:
        return int(self._rank)

    ## @brief Return the number of tunable (trainable) parameters in the adapter.
    # @details Counts only W_A and W_B parameters (masks are buffers and not trainable).
    # @return int Number of tunable parameters.
    def num_tunable_params(self) -> int:
        return int(self._rank * self.in_features + self.out_features * self._rank)

    ## @brief Return an estimate of active parameters under current (soft) masks.
    # @details This is a diagnostic local estimate used for reporting, not the global block-level
    # approximation in the paper. Uses a fixed 0.5 threshold to binarize masks.
    # @return int Estimated number of active parameters (base + adapter) for this layer.
    def num_active_params(self) -> int:
        with torch.no_grad():
            active_in: int = int(torch.sum(self._input_mask > 0.5).item())
            active_out: int = int(torch.sum(self._output_mask > 0.5).item())

        base_active: int = active_in * active_out
        adapter_active: int = int(self._rank * active_in + active_out * self._rank)
        return int(base_active + adapter_active)

    ## @brief Collect metadata needed by higher-level pruning/tuning logic.
    # @return dict[str, Any] Metadata dictionary (JSON-serializable values).
    def collect_structure_metadata(self) -> Dict[str, Any]:
        has_bias: bool = getattr(self.base_linear, "bias", None) is not None
        return {
            "module_name": self._module_name,
            "group_name": self._group_name,
            "in_features": int(self.in_features),
            "out_features": int(self.out_features),
            "rank": int(self._rank),
            "alpha": float(self._alpha),
            "merged": bool(self._merged),
            "has_bias": bool(has_bias),
            "input_mask_len": int(self._input_mask.numel()),
            "output_mask_len": int(self._output_mask.numel()),
        }
