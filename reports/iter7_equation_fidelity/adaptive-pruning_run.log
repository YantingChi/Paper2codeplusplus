_PAPER_CFG_CACHE: Optional[Dict[str, Any]] = None


## @brief Load the global paper configuration (config.yaml) with caching.
# @return dict[str, Any] Parsed YAML configuration.
def _load_paper_config() -> Dict[str, Any]:
    global _PAPER_CFG_CACHE
    if _PAPER_CFG_CACHE is not None:
        return _PAPER_CFG_CACHE

    candidates = [
        Path(os.getcwd()) / "config.yaml",
        Path(__file__).resolve().parents[2] / "config.yaml",  # repo_root/config.yaml (src/training/..)
        Path(__file__).resolve().parents[3] / "config.yaml",
    ]
    for p in candidates:
        if p.exists():
            with p.open("r", encoding="utf-8") as f:
                data = yaml.safe_load(f) or {}
            if not isinstance(data, dict):
                raise ValueError(f"config.yaml root must be a dict, got {type(data)}")
            _PAPER_CFG_CACHE = data
            return _PAPER_CFG_CACHE
    raise FileNotFoundError("Cannot find required config.yaml in CWD or repo parents.")


## @brief Safe nested-get for dicts using dotted path.
# @param d dict[str, Any] Root dictionary.
# @param path str Dotted path.
# @param default Any Default if missing.
# @return Any Retrieved value or default.
def _get_nested(d: Dict[str, Any], path: str, default: Any) -> Any:
    cur: Any = d
    for part in str(path).split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return cur


## @brief Coerce a value to bool with a default.
# @param v Any Input value.
# @param default bool Default if v is None.
# @return bool Coerced bool.
def _as_bool(v: Any, default: bool) -> bool:
    if v is None:
        return bool(default)
    if isinstance(v, bool):
        return bool(v)
    if isinstance(v, (int, float)):
        return bool(v)
    if isinstance(v, str):
        s = v.strip().lower()
        if s in ("true", "1", "yes", "y", "t"):
            return True
        if s in ("false", "0", "no", "n", "f"):
            return False
    raise ValueError(f"Cannot coerce to bool: {v!r}")


## @brief Coerce a value to float with a default.
# @param v Any Input value.
# @param default float Default if v is None.
# @return float Coerced float.
def _as_float(v: Any, default: float) -> float:
    if v is None:
        return float(default)
    if isinstance(v, (int, float)):
        return float(v)
    if isinstance(v, str):
        return float(v.strip())
    raise ValueError(f"Cannot coerce to float: {v!r}")


## @brief Determine whether a backbone string corresponds to a LLaMA-family model.
# @param backbone_name str Backbone name string from config.
# @return bool True if LLaMA-like, else False.
def _is_llama_backbone(backbone_name: str) -> bool:
    name = (backbone_name or "").lower()
    return "llama" in name or "llemma" in name


## @brief Batch-to-device transfer (handles nested dict/list/tuple of tensors).
# @param batch Any Batch object.
# @param device torch.device Target device.
# @return Any Batch moved to device where applicable.
def _move_to_device(batch: Any, device: torch.device) -> Any:
    if torch.is_tensor(batch):
        return batch.to(device, non_blocking=True)
    if isinstance(batch, dict):
        return {str(k): _move_to_device(v, device) for k, v in batch.items()}
    if isinstance(batch, (list, tuple)):
        moved = [_move_to_device(x, device) for x in batch]
        return type(batch)(moved)
    return batch


## @brief Extract a scalar float from a torch tensor loss.
# @param t torch.Tensor Loss tensor.
# @return float Scalar loss.
def _loss_to_float(t: torch.Tensor) -> float:
    if not torch.is_tensor(t):
        return float("nan")
    return float(t.detach().float().item())


## @brief Compute the number of optimizer steps per epoch given a DataLoader and grad accumulation.
# @param train_loader torch.utils.data.DataLoader Training DataLoader.
# @param grad_accum int Gradient accumulation steps.
# @return int Optimizer steps per epoch.
def _steps_per_epoch(train_loader: DataLoader, grad_accum: int) -> int:
    if not hasattr(train_loader, "__len__"):
        raise ValueError("Training DataLoader must be sized (__len__ defined) for step-based scheduling.")
    n_batches: int = int(len(train_loader))
    ga: int = int(max(1, grad_accum))
    return int(math.ceil(float(n_batches) / float(ga)))


## @brief A container for per-step training outputs.
@dataclass
class StepOutput:
    ## @brief Initialize StepOutput.
    # @param loss float Total loss value.
    # @param task_loss float Supervised fine-tuning loss value.
    # @param distill_loss float Distillation loss value.
    # @param metrics dict[str, float] Additional metrics values.
    def __init__(
        self,
        loss: float,
        task_loss: float,
        distill_loss: float,
        metrics: Dict[str, float],
    ) -> None:
        self.loss = float(loss)
        self.task_loss = float(task_loss)
        self.distill_loss = float(distill_loss)
        self.metrics = dict(metrics)

    loss: float
    task_loss: float
    distill_loss: float
    metrics: Dict[str, float]


## @brief A container for the final training result.
@dataclass
class TrainResult:
    ## @brief Initialize TrainResult.
    # @param best_checkpoint str Path to the best checkpoint.
    # @param best_metric float Best primary metric value.
    # @param history list[dict] Training history records.
    # @param peak_train_memory_mb float Peak training memory usage in MB.
    # @param time_to_accuracy_s float Time-to-accuracy in seconds.
    def __init__(
        self,
        best_checkpoint: str,
        best_metric: float,
        history: List[Dict[str, Any]],
        peak_train_memory_mb: float,
        time_to_accuracy_s: float,
    ) -> None:
        self.best_checkpoint = str(best_checkpoint)
        self.best_metric = float(best_metric)
        self.history = list(history)
        self.peak_train_memory_mb = float(peak_train_memory_mb)
        self.time_to_accuracy_s = float(time_to_accuracy_s)

    best_checkpoint: str
    best_metric: float
    history: List[Dict[str, Any]]
    peak_train_memory_mb: float
    time_to_accuracy_s: float


## @brief Trainer orchestrates APT two-stage training with pruning/tuning and optional self-distillation.
# @details Implements the paper’s staged protocol:
#  - Stage A (pruning stage): adaptive pruning + adaptive tuning + optional self-distillation.
#  - Stage B (recovery stage): fine-tune the pruned model to recover end-task performance.
# It is also the only component that can reset optimizer after rank expansion (paper stability note).
class Trainer:
    ## @brief Initialize Trainer.
    # @param model APTModelWrapper Wrapped model with registry and adapters.
    # @param datasets DatasetBundle Tokenized datasets, tokenizer, and collator.
    # @param config ExperimentConfig Experiment configuration.
    # @param salience SalienceCollector Salience collector with attached hooks capability.
    # @param pruner PruningScheduler Pruning scheduler for cubic sparsity schedule and block selection.
    # @param rank_allocator RankAllocator Rank allocator for adaptive tuning.
    # @param distiller Optional[DistillationManager] Distillation manager or None.
    # @param profiler Profiler Profiler for timing and peak memory.
    def __init__(
        self,
        model: APTModelWrapper,
        datasets: DatasetBundle,
        config: ExperimentConfig,
        salience: SalienceCollector,
        pruner: PruningScheduler,
        rank_allocator: RankAllocator,
        distiller: Optional[DistillationManager],
        profiler: Profiler,
    ) -> None:
        if model is None:
            raise ValueError("model must be non-None.")
        if datasets is None:
            raise ValueError("datasets must be non-None.")
        if config is None:
            raise ValueError("config must be non-None.")
        if salience is None:
            raise ValueError("salience must be non-None.")
        if pruner is None:
            raise ValueError("pruner must be non-None.")
        if rank_allocator is None:
            raise ValueError("rank_allocator must be non-None.")
        if profiler is None:
            raise ValueError("profiler must be non-None.")

        self._logger = get_logger("apt.trainer")

        self.model: APTModelWrapper = model
        self._datasets: DatasetBundle = datasets
        self._cfg: ExperimentConfig = config

        self._salience: SalienceCollector = salience
        self._pruner: PruningScheduler = pruner
        self._rank_allocator: RankAllocator = rank_allocator
        self._distiller: Optional[DistillationManager] = distiller
        self._profiler: Profiler = profiler

        # MaskManager is not in the Trainer signature in the provided design, but Trainer must
        # apply gradual mask updates (Appendix B/C). PruningScheduler owns a MaskManager internally.
        # We access it via its known attribute to preserve design signature.
        mm = getattr(self._pruner, "_mask_manager", None)
        if mm is None or not isinstance(mm, MaskManager):
            # Deterministic fallback: create a MaskManager bound to the model registry.
            self._logger.warning("PruningScheduler has no accessible MaskManager; creating a new MaskManager.")
            mm = MaskManager(self.model.get_registry())
        self._mask_manager: MaskManager = mm
        self._mask_manager.initialize_masks()

        # Runtime/device.
        self._device: torch.device = torch.device(str(self._cfg.runtime.device))
        self._is_cuda: bool = self._device.type == "cuda"
        if self._is_cuda and not torch.cuda.is_available():
            raise RuntimeError(f"Configured device {self._device} but CUDA is not available.")

        # Optimizer/scheduler state.
        self._optimizer: Optional[torch.optim.Optimizer] = None
        self._scheduler: Optional[Any] = None

        # AMP state.
        self._use_fp16: bool = bool(self._cfg.training.fp16)
        self._use_bf16: bool = bool(self._cfg.training.bf16)
        if self._use_fp16 and self._use_bf16:
            raise ValueError("Cannot enable both fp16 and bf16 simultaneously.")
        self._scaler: Optional[torch.cuda.amp.GradScaler] = None
        if self._use_fp16 and self._is_cuda:
            self._scaler = torch.cuda.amp.GradScaler(enabled=True)

        # Paper config flags.
        paper_cfg = _load_paper_config()
        self._optimizer_reset_after_shape_change: bool = _as_bool(
            _get_nested(paper_cfg, "apt.optimizer_reset_after_shape_change", True), True
        )

        # Mask update alpha from config.yaml (paper literal 0.01). Trainer must pass it into MaskManager.
        # eq: apt_mask_alpha_value
        self._mask_update_alpha: float = _as_float(_get_nested(paper_cfg, "apt.mask_update_alpha", 0.01), 0.01)

        # Callbacks for evaluation/checkpoint schedules and best tracking.
        self._callbacks: CallbackHandler = CallbackHandler(config=self._cfg)

        # History for reproducibility.
        self._history: List[Dict[str, Any]] = []

        # Peak memory tracking.
        self._peak_train_memory_mb: float = 0.0

        # Step timing (for LLaMA training speed per-step metric).
        self._step_times_s: List[float] = []

        # Distillation teacher (rebuilt periodically).
        self._teacher: Optional[Any] = None

    ## @brief Build the optimizer over current trainable parameters.
    # @details Uses AdamW and includes only requires_grad parameters.
    # Uses TrainingConfig.learning_rate and TrainingConfig.weight_decay (defaults are resolved in ExperimentConfig.validate()).
    # @return torch.optim.Optimizer Constructed optimizer.
    def build_optimizer(self) -> torch.optim.Optimizer:
        lr: float = float(self._cfg.training.learning_rate)
        wd: float = float(self._cfg.training.weight_decay)

        if lr <= 0.0:
            raise ValueError(f"learning_rate must be > 0, got {lr}.")
        if wd < 0.0:
            raise ValueError(f"weight_decay must be >= 0, got {wd}.")

        params: List[nn.Parameter] = []
        for p in self.model.parameters():
            if p.requires_grad:
                params.append(p)

        if len(params) == 0:
            raise ValueError("No trainable parameters found (all parameters have requires_grad=False).")

        opt_name: str = str(self._cfg.training.optimizer_name or "adamw").strip().lower()
        if opt_name != "adamw":
            raise ValueError(f"Unsupported optimizer_name={opt_name!r}. This reproduction uses AdamW.")

        optimizer = torch.optim.AdamW(params, lr=lr, weight_decay=wd)
        self._optimizer = optimizer
        return optimizer

    ## @brief Build the learning rate scheduler for a given total number of optimizer steps.
    # @details Uses transformers.get_scheduler. warmup_steps = floor(warmup_ratio * total_steps).
    # If warmup_ratio==0, no warmup.
    # @param total_steps int Total number of optimizer steps for the stage/schedule.
    # @return Any Scheduler instance.
    def build_scheduler(self, total_steps: int) -> Any:
        if self._optimizer is None:
            raise RuntimeError("build_scheduler called before optimizer is built.")

        from transformers.optimization import get_scheduler  # pylint: disable=import-outside-toplevel

        num_training_steps: int = int(max(1, total_steps))
        warmup_ratio: float = float(self._cfg.training.warmup_ratio)
        if warmup_ratio < 0.0 or warmup_ratio > 1.0:
            raise ValueError(f"warmup_ratio must be in [0,1], got {warmup_ratio}.")

        num_warmup_steps: int = int(math.floor(float(warmup_ratio) * float(num_training_steps)))
        sched_type: str = str(self._cfg.training.lr_scheduler_type or "linear").strip().lower()

        scheduler = get_scheduler(
            name=sched_type,
            optimizer=self._optimizer,
            num_warmup_steps=num_warmup_steps,
            num_training_steps=num_training_steps,
        )
        self._scheduler = scheduler
        return scheduler

    ## @brief Reset optimizer/scheduler after parameter shape changes (paper stability requirement).
    # @details Paper note: reset optimizer every time after each parameter size change.
    # This method rebuilds optimizer and scheduler using remaining steps for the current stage.
    # @return None
    def reset_optimizer_if_needed(self) -> None:
        # This method is intentionally called only by Trainer after a confirmed shape change.
        self._optimizer = None
        self._scheduler = None
        self._scaler = torch.cuda.amp.GradScaler(enabled=True) if (self._use_fp16 and self._is_cuda) else self._scaler

    ## @brief Train the model following the paper’s two-stage APT protocol.
    # @details Ensures paper literals r_apt=8 and scaling factor s=2 are enforced by config.
    # @return TrainResult Training result with best checkpoint and efficiency metrics.
    def train(self) -> TrainResult:
        # eq: apt_initial_rank_value
        if bool(self._cfg.apt.enable_apt):
            if int(self._cfg.apt.initial_rank) != 8:
                raise ValueError(f"Paper requires r_apt=8, got {self._cfg.apt.initial_rank}.")
            # eq: apt_scaling_factor_value
            if float(self._cfg.apt.lora_alpha) != 2.0:
                raise ValueError(f"Paper requires scaling factor s=2, got {self._cfg.apt.lora_alpha}.")

        # Prepare model device, train mode, optional checkpointing settings.
        self.model.to(self._device)
        if bool(self._cfg.runtime.gradient_checkpointing):
            base = getattr(self.model, "model", None)
            if base is not None and hasattr(base, "gradient_checkpointing_enable"):
                base.gradient_checkpointing_enable()

        if bool(self._cfg.runtime.compile_model):
            # torch.compile is optional; keep deterministic behavior by not changing compilation flags.
            self.model = torch.compile(self.model)  # type: ignore[assignment]

        # Attach hooks for salience collection.
        self._salience.attach_hooks()

        # Build dataloaders.
        train_loader, eval_loader = self._build_dataloaders()

        # Compute total optimizer steps for entire run.
        grad_accum: int = int(max(1, self._cfg.training.gradient_accumulation_steps))
        steps_per_ep: int = _steps_per_epoch(train_loader, grad_accum=grad_accum)
        total_opt_steps: int = int(steps_per_ep * int(self._cfg.training.num_epochs))

        # Build optimizer/scheduler once initially over full training, but allow resets mid-run.
        self.build_optimizer()
        self.build_scheduler(total_steps=total_opt_steps)

        # Training time measurement.
        self._profiler.reset_cuda_stats()
        self._profiler.start_train_region("train_total")

        # Two-stage scheduling:
        # - If distill_epochs > 0: stage A uses those epochs (paper small models).
        # - Else: stage A uses pruning_stage_ratio * total steps (paper large models distillation-free).
        distill_epochs: int = int(self._cfg.training.distill_epochs)
        num_epochs: int = int(self._cfg.training.num_epochs)

        if distill_epochs > 0:
            pruning_epochs: int = int(distill_epochs)
            recovery_epochs: int = int(max(0, num_epochs - distill_epochs))
        else:
            pruning_epochs = 0
            recovery_epochs = int(num_epochs)

        # Distillation teacher creation if enabled (small models).
        if self._distiller is not None:
            self._teacher = self._distiller.build_teacher()

        # Stage A: pruning stage (epoch-based if distill_epochs > 0; step-ratio based otherwise).
        global_step: int = 0
        if bool(self._cfg.apt.enable_apt):
            if pruning_epochs > 0:
                global_step = self.run_pruning_stage(
                    train_loader=train_loader,
                    eval_loader=eval_loader,
                    start_global_step=global_step,
                    steps_per_epoch=steps_per_ep,
                    pruning_epochs=pruning_epochs,
                )
            else:
                # Distillation-free setting: still run pruning for a step budget determined by pruning_stage_ratio.
                global_step = self.run_pruning_stage_ratio(
                    train_loader=train_loader,
                    eval_loader=eval_loader,
                    start_global_step=global_step,
                    total_opt_steps=total_opt_steps,
                )

        # Stage B: recovery fine-tuning stage.
        if recovery_epochs > 0:
            global_step = self.run_recovery_stage(
                train_loader=train_loader,
                eval_loader=eval_loader,
                start_global_step=global_step,
                steps_per_epoch=steps_per_ep,
                recovery_epochs=recovery_epochs,
            )

        elapsed_total_s: float = self._profiler.end_train_region("train_total")

        # Final evaluation and checkpoint.
        final_metrics: Dict[str, float] = {}
        if eval_loader is not None:
            final_metrics = self._evaluate(eval_loader=eval_loader, global_step=global_step, stage="final")

        final_ckpt_path: str = self.save_checkpoint(tag="final")
        self._callbacks.on_checkpoint_end(global_step=global_step, stage="final", checkpoint_path=final_ckpt_path)

        # Persist training summary artifacts.
        summary_path: Path = Path(str(self._cfg.runtime.output_dir)) / "train_summary.json"
        summary: Dict[str, Any] = {
            "elapsed_total_s": float(elapsed_total_s),
            "peak_train_memory_mb": float(self._peak_train_memory_mb),
            "num_optimizer_steps": int(global_step),
            "mean_step_time_s": float(sum(self._step_times_s) / max(1, len(self._step_times_s))),
            "final_metrics": final_metrics,
        }
        save_json(summary_path, summary)

        # Best checkpoint from callbacks.
        best_state = self._callbacks.best_state()
        best_ckpt: str = best_state.best_checkpoint if best_state.best_checkpoint else final_ckpt_path
        best_metric: float = float(best_state.best_metric)

        # Compute an internal TTA proxy: time to reach 97% of this run's best metric.
        # Paper TTA is defined vs fully fine-tuned model; this run logs a full eval timeline for external comparison.
        # We still compute this deterministic statistic for convenience.
        time_to_acc_s: float = self._compute_time_to_accuracy_from_history()

        # Save full history.
        hist_path: Path = Path(str(self._cfg.runtime.output_dir)) / "train_history.json"
        save_json(hist_path, self._history)

        return TrainResult(
            best_checkpoint=best_ckpt,
            best_metric=best_metric,
            history=self._history,
            peak_train_memory_mb=self._peak_train_memory_mb,
            time_to_accuracy_s=time_to_acc_s,
        )

    ## @brief Run the pruning stage (epoch-based), enabling AP/AT and optional self-distillation.
    # @details Trainer must call DistillationManager.compute_mu(global_step,total_steps) with a linear schedule.
    # @param train_loader DataLoader Training dataloader.
    # @param eval_loader DataLoader Evaluation dataloader.
    # @param start_global_step int Starting global optimizer step.
    # @param steps_per_epoch int Optimizer steps per epoch.
    # @param pruning_epochs int Number of pruning/distillation epochs.
    # @return int Updated global optimizer step after stage.
    def run_pruning_stage(
        self,
        train_loader: DataLoader,
        eval_loader: Optional[DataLoader],
        start_global_step: int,
        steps_per_epoch: int,
        pruning_epochs: int,
    ) -> int:
        self.model.train()
        stage: str = "pruning"

        grad_accum: int = int(max(1, self._cfg.training.gradient_accumulation_steps))
        total_pruning_steps: int = int(max(1, steps_per_epoch * int(pruning_epochs)))
        global_step: int = int(start_global_step)

        # Reset peak memory stats for this stage.
        self._profiler.reset_cuda_stats()

        # Optional: re-build teacher at stage start.
        if self._distiller is not None and self._teacher is None:
            self._teacher = self._distiller.build_teacher()

        # Loop over epochs and micro-batches, but count global_step on optimizer steps.
        micro_step: int = 0
        stage_start_s: float = time.perf_counter()
        if self._is_cuda:
            torch.cuda.synchronize(self._device)

        for epoch in range(int(pruning_epochs)):
            for batch in train_loader:
                micro_step += 1

                # Micro-step timing.
                step_start_s: float = time.perf_counter()
                if self._is_cuda:
                    torch.cuda.synchronize(self._device)

                batch_dev = _move_to_device(batch, self._device)

                # Compute mu on current optimizer step (paper defines mu over distillation).
                # eq: apt_mu_schedule_linear
                mu: float = 0.0
                if self._distiller is not None:
                    mu = float(self._distiller.compute_mu(global_step=global_step, total_steps=total_pruning_steps))

                step_out, did_opt_step = self.train_step(
                    batch=batch_dev,
                    global_step=global_step,
                    stage=stage,
                    mu=mu,
                    grad_accum=grad_accum,
                )

                # End micro-step timing.
                if self._is_cuda:
                    torch.cuda.synchronize(self._device)
                step_end_s: float = time.perf_counter()
                self._step_times_s.append(float(step_end_s - step_start_s))

                # Update peak memory.
                if bool(self._cfg.evaluation.measure_train_peak_memory):
                    self._peak_train_memory_mb = max(self._peak_train_memory_mb, self._profiler.measure_peak_train_memory())

                # Only perform pruning/rank updates at optimizer-step granularity.
                if did_opt_step:
                    # Adaptive pruning update (AP).
                    _ = self.maybe_update_pruning(
                        global_step=global_step,
                        total_pruning_steps=total_pruning_steps,
                    )
                    # Adaptive tuning update (AT).
                    _ = self.maybe_update_ranks(
                        global_step=global_step,
                        total_pruning_steps=total_pruning_steps,
                    )

                    # Scheduled evaluation / checkpoint.
                    if self._callbacks.should_eval(global_step=global_step, force=False, always_on_step0=False):
                        if eval_loader is not None:
                            metrics = self._evaluate(eval_loader=eval_loader, global_step=global_step, stage=stage)
                            # If we also save at this step, bind metrics to checkpoint.
                            ckpt_path: Optional[str] = None
                            if self._callbacks.should_save(global_step=global_step, force=False, always_on_step0=False):
                                ckpt_path = self.save_checkpoint(tag=f"step_{global_step}")
                                self._callbacks.on_checkpoint_end(
                                    global_step=global_step,
                                    stage=stage,
                                    checkpoint_path=ckpt_path,
                                    metrics_snapshot=metrics,
                                )
                            self._callbacks.on_evaluate_end(
                                global_step=global_step,
                                stage=stage,
                                metrics=metrics,
                                checkpoint_path=ckpt_path,
                            )

                    # Record optimizer-step history.
                    self._record_history(
                        global_step=global_step,
                        stage=stage,
                        step_output=step_out,
                        mu=mu,
                        extra=self._collect_structure_stats(),
                    )

                    global_step += 1

                    if self._callbacks.should_stop():
                        break

            if self._callbacks.should_stop():
                break

        if self._is_cuda:
            torch.cuda.synchronize(self._device)
        stage_elapsed_s: float = float(time.perf_counter() - stage_start_s)
        self._logger.info("Completed pruning stage | steps=%d | elapsed_s=%.3f", int(global_step - start_global_step), stage_elapsed_s)
        return int(global_step)

    ## @brief Run the pruning stage for a step budget determined by pruning_stage_ratio (distillation-free).
    # @details Used for large-model settings where distill_epochs=0 but APT pruning still occurs early.
    # @param train_loader DataLoader Training dataloader.
    # @param eval_loader Optional[DataLoader] Evaluation dataloader.
    # @param start_global_step int Starting global optimizer step.
    # @param total_opt_steps int Total optimizer steps for the full run.
    # @return int Updated global optimizer step after stage.
    def run_pruning_stage_ratio(
        self,
        train_loader: DataLoader,
        eval_loader: Optional[DataLoader],
        start_global_step: int,
        total_opt_steps: int,
    ) -> int:
        self.model.train()
        stage: str = "pruning"

        grad_accum: int = int(max(1, self._cfg.training.gradient_accumulation_steps))
        ratio: float = float(self._cfg.apt.pruning_stage_ratio)
        if ratio <= 0.0 or ratio > 1.0:
            raise ValueError(f"apt.pruning_stage_ratio must be in (0,1], got {ratio}")

        # Define pruning stage length in optimizer steps.
        total_pruning_steps: int = int(max(1, math.floor(float(total_opt_steps) * float(ratio))))
        global_step: int = int(start_global_step)

        self._profiler.reset_cuda_stats()

        # Teacher is not used by config.yaml for large models; still keep safe behavior.
        if self._distiller is not None and self._teacher is None:
            self._teacher = self._distiller.build_teacher()

        micro_step: int = 0
        stage_start_s: float = time.perf_counter()
        if self._is_cuda:
            torch.cuda.synchronize(self._device)

        train_iter: Iterable[Any] = iter(train_loader)
        while global_step - start_global_step < total_pruning_steps:
            try:
                batch = next(train_iter)
            except StopIteration:
                train_iter = iter(train_loader)
                batch = next(train_iter)

            micro_step += 1

            step_start_s: float = time.perf_counter()
            if self._is_cuda:
                torch.cuda.synchronize(self._device)

            batch_dev = _move_to_device(batch, self._device)

            mu: float = 0.0
            if self._distiller is not None:
                # eq: apt_mu_schedule_linear
                mu = float(self._distiller.compute_mu(global_step=global_step, total_steps=total_pruning_steps))

            step_out, did_opt_step = self.train_step(
                batch=batch_dev,
                global_step=global_step,
                stage=stage,
                mu=mu,
                grad_accum=grad_accum,
            )

            if self._is_cuda:
                torch.cuda.synchronize(self._device)
            step_end_s: float = time.perf_counter()
            self._step_times_s.append(float(step_end_s - step_start_s))

            if bool(self._cfg.evaluation.measure_train_peak_memory):
                self._peak_train_memory_mb = max(self._peak_train_memory_mb, self._profiler.measure_peak_train_memory())

            if did_opt_step:
                _ = self.maybe_update_pruning(
                    global_step=global_step,
                    total_pruning_steps=total_pruning_steps,
                )
                _ = self.maybe_update_ranks(
                    global_step=global_step,
                    total_pruning_steps=total_pruning_steps,
                )

                if self._callbacks.should_eval(global_step=global_step, force=False, always_on_step0=False):
                    if eval_loader is not None:
                        metrics = self._evaluate(eval_loader=eval_loader, global_step=global_step, stage=stage)
                        ckpt_path: Optional[str] = None
                        if self._callbacks.should_save(global_step=global_step, force=False, always_on_step0=False):
                            ckpt_path = self.save_checkpoint(tag=f"step_{global_step}")
                            self._callbacks.on_checkpoint_end(
                                global_step=global_step,
                                stage=stage,
                                checkpoint_path=ckpt_path,
                                metrics_snapshot=metrics,
                            )
                        self._callbacks.on_evaluate_end(
                            global_step=global_step,
                            stage=stage,
                            metrics=metrics,
                            checkpoint_path=ckpt_path,
                        )

                self._record_history(
                    global_step=global_step,
                    stage=stage,
                    step_output=step_out,
                    mu=mu,
                    extra=self._collect_structure_stats(),
                )

                global_step += 1
                if self._callbacks.should_stop():
                    break

        if self._is_cuda:
            torch.cuda.synchronize(self._device)
        stage_elapsed_s: float = float(time.perf_counter() - stage_start_s)
        self._logger.info("Completed pruning stage (ratio) | steps=%d | elapsed_s=%.3f", int(global_step - start_global_step), stage_elapsed_s)
        return int(global_step)

    ## @brief Run the recovery fine-tuning stage (no pruning/rank updates).
    # @details Implements the paper’s second stage: fine-tune the pruned LM to recover task performance.
    # @param train_loader DataLoader Training dataloader.
    # @param eval_loader Optional[DataLoader] Evaluation dataloader.
    # @param start_global_step int Starting global optimizer step.
    # @param steps_per_epoch int Optimizer steps per epoch.
    # @param recovery_epochs int Number of recovery epochs.
    # @return int Updated global optimizer step after stage.
    def run_recovery_stage(
        self,
        train_loader: DataLoader,
        eval_loader: Optional[DataLoader],
        start_global_step: int,
        steps_per_epoch: int,
        recovery_epochs: int,
    ) -> int:
        self.model.train()
        stage: str = "recovery"

        grad_accum: int = int(max(1, self._cfg.training.gradient_accumulation_steps))
        global_step: int = int(start_global_step)

        # Distillation is not applied in recovery stage by default; keep mu=0 and do not call distiller.
        mu: float = 0.0

        stage_start_s: float = time.perf_counter()
        if self._is_cuda:
            torch.cuda.synchronize(self._device)

        for epoch in range(int(recovery_epochs)):
            for batch in train_loader:
                step_start_s: float = time.perf_counter()
                if self._is_cuda:
                    torch.cuda.synchronize(self._device)

                batch_dev = _move_to_device(batch, self._device)

                step_out, did_opt_step = self.train_step(
                    batch=batch_dev,
                    global_step=global_step,
                    stage=stage,
                    mu=mu,
                    grad_accum=grad_accum,
                )

                if self._is_cuda:
                    torch.cuda.synchronize(self._device)
                step_end_s: float = time.perf_counter()
                self._step_times_s.append(float(step_end_s - step_start_s))

                if bool(self._cfg.evaluation.measure_train_peak_memory):
                    self._peak_train_memory_mb = max(self._peak_train_memory_mb, self._profiler.measure_peak_train_memory())

                if did_opt_step:
                    if self._callbacks.should_eval(global_step=global_step, force=False, always_on_step0=False):
                        if eval_loader is not None:
                            metrics = self._evaluate(eval_loader=eval_loader, global_step=global_step, stage=stage)
                            ckpt_path: Optional[str] = None
                            if self._callbacks.should_save(global_step=global_step, force=False, always_on_step0=False):
                                ckpt_path = self.save_checkpoint(tag=f"step_{global_step}")
                                self._callbacks.on_checkpoint_end(
                                    global_step=global_step,
                                    stage=stage,
                                    checkpoint_path=ckpt_path,
                                    metrics_snapshot=metrics,
                                )
                            self._callbacks.on_evaluate_end(
                                global_step=global_step,
                                stage=stage,
                                metrics=metrics,
                                checkpoint_path=ckpt_path,
                            )

                    self._record_history(
                        global_step=global_step,
                        stage=stage,
                        step_output=step_out,
                        mu=mu,
                        extra=self._collect_structure_stats(),
                    )

                    global_step += 1
                    if self._callbacks.should_stop():
                        break

            if self._callbacks.should_stop():
                break

        if self._is_cuda:
            torch.cuda.synchronize(self._device)
        stage_elapsed_s: float = float(time.perf_counter() - stage_start_s)
        self._logger.info("Completed recovery stage | steps=%d | elapsed_s=%.3f", int(global_step - start_global_step), stage_elapsed_s)
        return int(global_step)

    ## @brief Execute a single training micro-step, with optional distillation and gradient accumulation.
    # @details Must implement Eq. (7): L = μ L_distill + (1-μ) L_ft.
    # Also logs layer-loss component from distiller output.
    # @param batch dict Batch on device.
    # @param global_step int Current optimizer step index (used for logging and schedules).
    # @param stage str Stage name ("pruning" or "recovery").
    # @param mu float Distillation coefficient μ (0 when distillation disabled).
    # @param grad_accum int Gradient accumulation steps.
    # @return tuple[StepOutput, bool] StepOutput and whether an optimizer step occurred.
    def train_step(
        self,
        batch: Dict[str, Any],
        global_step: int,
        stage: str,
        mu: float,
        grad_accum: int,
    ) -> Tuple[StepOutput, bool]:
        if self._optimizer is None or self._scheduler is None:
            raise RuntimeError("train_step called before optimizer/scheduler were built.")
        if not isinstance(batch, dict):
            raise ValueError("batch must be a dict[str, Any].")

        ga: int = int(max(1, grad_accum))

        # Ensure salience step caches are clear for this micro-step.
        self._salience.reset_step_cache()

        # Forward + backward with optional AMP.
        use_distill: bool = (self._distiller is not None) and bool(self._cfg.apt.use_self_distill) and (stage == "pruning")
        mu_f: float = float(mu)
        if mu_f < 0.0:
            mu_f = 0.0
        if mu_f > 1.0:
            mu_f = 1.0

        # Ensure teacher exists if distillation is enabled.
        if use_distill and self._teacher is None:
            self._teacher = self._distiller.build_teacher() if self._distiller is not None else None

        # For self-distillation, we need hidden states in student forward.
        fwd_kwargs: Dict[str, Any] = dict(batch)
        if use_distill:
            fwd_kwargs["output_hidden_states"] = True

        # Autocast settings.
        autocast_enabled: bool = bool(self._is_cuda and (self._use_fp16 or self._use_bf16))
        autocast_dtype: torch.dtype = torch.float16 if self._use_fp16 else (torch.bfloat16 if self._use_bf16 else torch.float32)

        self.model.train()

        if autocast_enabled:
            with torch.cuda.amp.autocast(enabled=True, dtype=autocast_dtype):
                student_outputs = self.model(**fwd_kwargs)

                if not hasattr(student_outputs, "loss") or student_outputs.loss is None:
                    raise ValueError("Model outputs must include .loss for supervised fine-tuning.")

                task_loss_t: torch.Tensor = student_outputs.loss

                distill_loss_t: torch.Tensor = torch.zeros_like(task_loss_t)
                layer_loss_t: torch.Tensor = torch.zeros_like(task_loss_t)

                if use_distill:
                    if self._teacher is None:
                        raise RuntimeError("Distillation enabled but teacher is None.")
                    teacher_outputs = self._teacher(**batch)

                    dlo: DistillLossOutput = self._distiller.compute_loss(
                        student_outputs=student_outputs,
                        teacher_outputs=teacher_outputs,
                        batch=batch,
                        mu=mu_f,
                    )
                    # eq: apt_layer_distill_eq7_layer (layer_loss is computed inside DistillationManager via MSE)
                    layer_loss_t = dlo.layer_loss
                    distill_loss_t = dlo.distill_loss

                    # eq: apt_objective_eq7
                    total_loss_t: torch.Tensor = (mu_f * distill_loss_t) + ((1.0 - mu_f) * task_loss_t)
                else:
                    total_loss_t = task_loss_t

        else:
            student_outputs = self.model(**fwd_kwargs)

            if not hasattr(student_outputs, "loss") or student_outputs.loss is None:
                raise ValueError("Model outputs must include .loss for supervised fine-tuning.")

            task_loss_t = student_outputs.loss
            distill_loss_t = torch.zeros_like(task_loss_t)
            layer_loss_t = torch.zeros_like(task_loss_t)

            if use_distill:
                if self._teacher is None:
                    raise RuntimeError("Distillation enabled but teacher is None.")
                teacher_outputs = self._teacher(**batch)

                dlo = self._distiller.compute_loss(
                    student_outputs=student_outputs,
                    teacher_outputs=teacher_outputs,
                    batch=batch,
                    mu=mu_f,
                )
                layer_loss_t = dlo.layer_loss
                distill_loss_t = dlo.distill_loss

                # eq: apt_objective_eq7
                total_loss_t = (mu_f * distill_loss_t) + ((1.0 - mu_f) * task_loss_t)
            else:
                total_loss_t = task_loss_t

        # Gradient accumulation: scale loss.
        total_loss_scaled: torch.Tensor = total_loss_t / float(ga)

        # Backward.
        if self._use_fp16 and self._is_cuda and self._scaler is not None:
            self._scaler.scale(total_loss_scaled).backward()
        else:
            total_loss_scaled.backward()

        # Update salience after backward so activation gradients are populated.
        self._salience.update_block_salience()

        # Determine whether to step optimizer this micro-step.
        # Use global micro-step count derived from internal scheduler state is not stable; use mod on a counter.
        # We compute did_step by checking optimizer's internal step count isn't accessible; thus compute based on a micro counter.
        # We store a deterministic counter on self.
        if not hasattr(self, "_micro_accum_counter"):
            setattr(self, "_micro_accum_counter", 0)
        micro_accum_counter: int = int(getattr(self, "_micro_accum_counter"))
        micro_accum_counter += 1
        setattr(self, "_micro_accum_counter", micro_accum_counter)

        did_opt_step: bool = (micro_accum_counter % ga) == 0

        if did_opt_step:
            # Gradient clipping (only if configured > 0).
            max_norm: float = float(self._cfg.training.max_grad_norm)
            if max_norm > 0.0:
                if self._use_fp16 and self._is_cuda and self._scaler is not None:
                    self._scaler.unscale_(self._optimizer)
                torch.nn.utils.clip_grad_norm_(self.model.parameters(), max_norm=max_norm)

            if self._use_fp16 and self._is_cuda and self._scaler is not None:
                self._scaler.step(self._optimizer)
                self._scaler.update()
            else:
                self._optimizer.step()

            self._optimizer.zero_grad(set_to_none=True)
            self._scheduler.step()

            # Reset salience caches at optimizer step boundary.
            self._salience.reset_step_cache()

        # Pack metrics.
        lr: float = float(self._optimizer.param_groups[0]["lr"]) if self._optimizer is not None else 0.0
        metrics: Dict[str, float] = {
            "lr": float(lr),
            "mu": float(mu_f),
            "layer_loss": float(_loss_to_float(layer_loss_t)),
        }

        return (
            StepOutput(
                loss=float(_loss_to_float(total_loss_t)),
                task_loss=float(_loss_to_float(task_loss_t)),
                distill_loss=float(_loss_to_float(distill_loss_t)),
                metrics=metrics,
            ),
            bool(did_opt_step),
        )

    ## @brief Maybe update pruning masks according to the configured interval.
    # @details Must implement cubic sparsity schedule and gradual mask update.
    # @param global_step int Current optimizer step (t).
    # @param total_pruning_steps int Total pruning optimizer steps (T).
    # @return bool True if pruning masks were updated at this step.
    def maybe_update_pruning(self, global_step: int, total_pruning_steps: int) -> bool:
        if not bool(self._cfg.apt.enable_apt):
            return False
        interval: int = int(self._cfg.apt.prune_update_interval)
        if interval <= 0:
            return False
        if int(global_step) % int(interval) != 0:
            return False

        # Compute target sparsity using the paper cubic schedule.
        gamma_T: float = float(self._cfg.apt.target_sparsity)
        t: float = float(max(0, int(global_step)))
        T: float = float(max(1, int(total_pruning_steps)))

        # eq: apt_sparsity_schedule_cubic
        gamma_t: float = gamma_T + (1.0 - gamma_T) * (1.0 - t / T) ** 3

        # Cross-check PruningScheduler implementation matches the equation.
        gamma_t_pruner: float = float(self._pruner.target_sparsity_at_step(global_step=int(global_step), total_pruning_steps=int(total_pruning_steps)))
        if abs(float(gamma_t) - float(gamma_t_pruner)) > 1e-6:
            raise ValueError(
                f"PruningScheduler.target_sparsity_at_step mismatch: trainer={gamma_t} vs pruner={gamma_t_pruner}."
            )

        # Teacher snapshot update for efficient self-distillation:
        # Keep teacher as the "pre-pruned" state by snapshotting *before* applying a new pruning step.
        if self._distiller is not None and self._teacher is not None and bool(self._cfg.apt.use_self_distill):
            self._teacher = self._distiller.build_teacher()
            self._callbacks.on_event(
                event_name="teacher_snapshot_update",
                global_step=int(global_step),
                stage="pruning",
                extra={"reason": "before_pruning_update"},
            )

        # Select blocks based on EMA salience scores and update masks gradually.
        block_scores: Dict[str, Dict[str, torch.Tensor]] = self._salience.get_block_scores()
        retain_ids: Dict[str, List[int]] = self._pruner.select_blocks(block_scores=block_scores, target_sparsity=float(gamma_t))

        # Apply gradual mask update with alpha = 0.01 from config.yaml.
        # eq: apt_mask_gradual_update
        # eq: apt_mask_alpha_value
        alpha: float = 0.01
        if abs(float(alpha) - float(self._mask_update_alpha)) > 0.0:
            raise ValueError(f"Mask alpha must match config.yaml apt.mask_update_alpha. got {alpha}, cfg {self._mask_update_alpha}.")
        self._mask_manager.apply_mask_updates(retain_ids=retain_ids, alpha=float(alpha))

        self._callbacks.on_event(
            event_name="pruning_update",
            global_step=int(global_step),
            stage="pruning",
            extra={"target_sparsity": float(gamma_t)},
        )
        return True

    ## @brief Maybe update adapter ranks according to the configured interval.
    # @details Triggers RankAllocator using the paper rank update rule (implemented inside RankAllocator),
    # and resets optimizer if any adapter expanded ranks (shape changed) and config.yaml requires it.
    # @param global_step int Current optimizer step.
    # @param total_pruning_steps int Total pruning optimizer steps.
    # @return bool True if any rank update (shape change) occurred.
    def maybe_update_ranks(self, global_step: int, total_pruning_steps: int) -> bool:
        if not bool(self._cfg.apt.enable_apt):
            return False
        interval: int = int(self._cfg.apt.rank_update_interval)
        if interval <= 0:
            return False
        if int(global_step) % int(interval) != 0:
            return False

        # Compute new tuning budget and expand ranks for top-half salient adapters.
        new_budget: int = int(self._rank_allocator.compute_budget(global_step=int(global_step), total_pruning_steps=int(total_pruning_steps)))
        adapter_importance: Dict[str, float] = self._salience.get_adapter_importance()
        selected: List[str] = self._rank_allocator.select_top_half(adapter_importance=adapter_importance)

        # eq: apt_rank_update_rule (inside RankAllocator.expand_selected_modules)
        shape_changed: bool = bool(self._rank_allocator.expand_selected_modules(selected=selected, new_budget=int(new_budget)))

        if shape_changed:
            self._callbacks.on_event(
                event_name="rank_expansion",
                global_step=int(global_step),
                stage="pruning",
                extra={"new_budget": int(new_budget), "selected_count": int(len(selected))},
            )

            # Teacher snapshot must be rebuilt after any adapter shape change (rank expansion).
            if self._distiller is not None and bool(self._cfg.apt.use_self_distill):
                self._teacher = self._distiller.build_teacher()

            if bool(self._optimizer_reset_after_shape_change):
                # Reset optimizer/scheduler (paper stability requirement).
                self.reset_optimizer_if_needed()

                # Rebuild optimizer and scheduler with remaining steps in full training schedule.
                train_loader, _ = self._build_dataloaders()
                grad_accum: int = int(max(1, self._cfg.training.gradient_accumulation_steps))
                steps_per_ep: int = _steps_per_epoch(train_loader, grad_accum=grad_accum)
                total_opt_steps: int = int(steps_per_ep * int(self._cfg.training.num_epochs))
                remaining_steps: int = int(max(1, total_opt_steps - int(global_step)))

                self.build_optimizer()
                self.build_scheduler(total_steps=remaining_steps)

                self._callbacks.on_event(
                    event_name="optimizer_reset_after_shape_change",
                    global_step=int(global_step),
                    stage="pruning",
                    extra={"remaining_steps": int(remaining_steps)},
                )

        return bool(shape_changed)

    ## @brief Save a training checkpoint.
    # @details Saves model weights (HF save_pretrained), tokenizer, optimizer/scheduler states, and registry snapshot.
    # @param tag str Checkpoint tag (directory name under runtime.output_dir/checkpoints).
    # @return str Path to the checkpoint directory.
    def save_checkpoint(self, tag: str) -> str:
        out_root: Path = Path(str(self._cfg.runtime.output_dir))
        ckpt_dir: Path = out_root / "checkpoints" / str(tag)
        ckpt_dir.mkdir(parents=True, exist_ok=True)

        # Save model (includes injected APTLinear modules as part of state dict).
        base_model = getattr(self.model, "model", None)
        if base_model is None or not hasattr(base_model, "save_pretrained"):
            # Fallback: save a raw state_dict.
            torch.save(self.model.state_dict(), ckpt_dir / "model_state_dict.pt")
        else:
            base_model.save_pretrained(str(ckpt_dir))

        # Save tokenizer if available.
        tok = getattr(self._datasets, "tokenizer", None)
        if tok is not None and hasattr(tok, "save_pretrained"):
            tok.save_pretrained(str(ckpt_dir))

        # Save optimizer/scheduler state.
        if self._optimizer is not None:
            torch.save(self._optimizer.state_dict(), ckpt_dir / "optimizer.pt")
        if self._scheduler is not None and hasattr(self._scheduler, "state_dict"):
            torch.save(self._scheduler.state_dict(), ckpt_dir / "scheduler.pt")

        # Save registry and masks.
        reg_state = self.model.get_registry().state_dict()
        save_json(ckpt_dir / "apt_registry.json", reg_state)
        bin_masks = self._mask_manager.get_binary_masks(threshold=0.5)
        # Store as a torch file (tensors).
        torch.save(bin_masks, ckpt_dir / "binary_masks.pt")

        return str(ckpt_dir)

    ## @brief Load a training checkpoint.
    # @details Restores model state and optionally optimizer/scheduler state if present.
    # @param path str Checkpoint directory path.
    # @return None
    def load_checkpoint(self, path: str) -> None:
        ckpt_dir = Path(str(path))
        if not ckpt_dir.exists():
            raise FileNotFoundError(f"Checkpoint directory not found: {ckpt_dir}")

        base_model = getattr(self.model, "model", None)
        if base_model is not None and hasattr(base_model, "from_pretrained"):
            # Do not reconstruct a new model; load weights into existing model.
            state_path = ckpt_dir / "pytorch_model.bin"
            safetensors_path = ckpt_dir / "model.safetensors"
            if safetensors_path.exists():
                from safetensors.torch import load_file  # pylint: disable=import-outside-toplevel
                state = load_file(str(safetensors_path))
                base_model.load_state_dict(state, strict=False)
            elif state_path.exists():
                state = torch.load(state_path, map_location="cpu")
                base_model.load_state_dict(state, strict=False)
            else:
                # Fallback to direct state dict.
                sd_path = ckpt_dir / "model_state_dict.pt"
                state = torch.load(sd_path, map_location="cpu")
                self.model.load_state_dict(state, strict=False)
        else:
            sd_path = ckpt_dir / "model_state_dict.pt"
            state = torch.load(sd_path, map_location="cpu")
            self.model.load_state_dict(state, strict=False)

        opt_path = ckpt_dir / "optimizer.pt"
        sch_path = ckpt_dir / "scheduler.pt"
        if opt_path.exists():
            if self._optimizer is None:
                self.build_optimizer()
            assert self._optimizer is not None
            self._optimizer.load_state_dict(torch.load(opt_path, map_location="cpu"))
        if sch_path.exists():
            if self._scheduler is None:
                # Rebuild a scheduler with a safe default total_steps=1; then load state dict.
                self.build_scheduler(total_steps=1)
            assert self._scheduler is not None
            self._scheduler.load_state_dict(torch.load(sch_path, map_location="cpu"))

    ## @brief Build training and evaluation DataLoaders.
    # @return tuple[DataLoader, Optional[DataLoader]] Train and eval loaders.
    def _build_dataloaders(self) -> Tuple[DataLoader, Optional[DataLoader]]:
        train_ds = self._datasets.train_dataset
        eval_ds = self._datasets.eval_dataset

        if train_ds is None:
            raise ValueError("DatasetBundle.train_dataset must be non-None.")
        collator = self._datasets.data_collator

        train_loader = DataLoader(
            train_ds,
            batch_size=int(self._cfg.data.batch_size),
            shuffle=True,
            num_workers=int(self._cfg.runtime.num_workers),
            pin_memory=bool(self._cfg.runtime.pin_memory),
            collate_fn=collator,
            drop_last=False,
        )

        eval_loader: Optional[DataLoader] = None
        if eval_ds is not None:
            eval_loader = DataLoader(
                eval_ds,
                batch_size=int(self._cfg.data.eval_batch_size),
                shuffle=False,
                num_workers=int(self._cfg.runtime.num_workers),
                pin_memory=bool(self._cfg.runtime.pin_memory),
                collate_fn=collator,
                drop_last=False,
            )

        return train_loader, eval_loader

    ## @brief Evaluate model on the evaluation set using Evaluator and record metrics.
    # @param eval_loader DataLoader Evaluation dataloader.
    # @param global_step int Current global step for logging.
    # @param stage str Stage name.
    # @return dict[str, float] Task metrics.
    def _evaluate(self, eval_loader: DataLoader, global_step: int, stage: str) -> Dict[str, float]:
        # Import lazily to avoid circular imports.
        from src.eval.evaluator import Evaluator  # pylint: disable=import-outside-toplevel

        was_training: bool = bool(self.model.training)
        self.model.eval()

        evaluator = Evaluator(model=self.model, datasets=self._datasets, config=self._cfg, profiler=self._profiler)
        eval_result = evaluator.evaluate()
        metrics: Dict[str, float] = dict(eval_result.task_metrics or {})

        log_metrics(metrics=metrics, step=int(global_step), split=f"eval/{stage}")

        if was_training:
            self.model.train()
        return metrics

    ## @brief Record a history entry for analysis and reproducibility.
    # @param global_step int Global optimizer step.
    # @param stage str Stage name.
    # @param step_output StepOutput Step output object.
    # @param mu float Distillation coefficient.
    # @param extra dict[str, Any] Extra fields to attach.
    # @return None
    def _record_history(self, global_step: int, stage: str, step_output: StepOutput, mu: float, extra: Dict[str, Any]) -> None:
        rec: Dict[str, Any] = {
            "global_step": int(global_step),
            "stage": str(stage),
            "loss": float(step_output.loss),
            "task_loss": float(step_output.task_loss),
            "distill_loss": float(step_output.distill_loss),
            "mu": float(mu),
            "metrics": dict(step_output.metrics),
            "peak_train_memory_mb": float(self._peak_train_memory_mb),
            "timestamp_s": float(time.time()),
        }
        rec.update(dict(extra or {}))
        self._history.append(rec)

        # Console logging for quick feedback.
        to_log: Dict[str, float] = {
            "loss": float(step_output.loss),
            "task_loss": float(step_output.task_loss),
            "distill_loss": float(step_output.distill_loss),
            "mu": float(mu),
        }
        for k, v in (step_output.metrics or {}).items():
            to_log[str(k)] = float(v)
        log_metrics(metrics=to_log, step=int(global_step), split=f"train/{stage}")

    ## @brief Collect current structural statistics (estimated sparsity, active structure).
    # @return dict[str, Any] Structure stats.
    def _collect_structure_stats(self) -> Dict[str, Any]:
        stats: Dict[str, Any] = {}
        if not bool(self._cfg.apt.enable_apt):
            return stats

        active = self._mask_manager.compute_active_structure()
        # Use pruner estimate to compute an approximate parameter count.
        cur_params = int(self._pruner.estimate_parameter_count(active))
        dense_params = getattr(self._pruner, "_dense_param_count", None)
        if dense_params is None:
            # Derive dense_params by treating current masks as dense via pruner internals.
            # This should only happen early, before first pruning update.
            dense_params = getattr(self._pruner, "_dense_param_count", 0) or 0
        dense_params_i = int(dense_params) if int(dense_params) > 0 else max(1, cur_params)

        sparsity = 1.0 - (float(cur_params) / float(dense_params_i))
        stats["param_estimate_dense"] = int(dense_params_i)
        stats["param_estimate_current"] = int(cur_params)
        stats["sparsity_estimate"] = float(sparsity)
        stats["active_structure"] = active
        return stats

    ## @brief Compute an internal time-to-accuracy statistic from evaluation history.
    # @details Computes time to reach 97% of the best observed primary metric in this run.
    # This is not the paper’s FT-referenced TTA (which requires an FT baseline), but is deterministic and
    # useful for debugging; the full eval timeline is saved for external FT-referenced TTA computation.
    # @return float Time-to-accuracy in seconds (0.0 if insufficient eval history).
    def _compute_time_to_accuracy_from_history(self) -> float:
        # Determine primary metric key from config.
        if not isinstance(self._cfg.evaluation.metrics, list) or len(self._cfg.evaluation.metrics) == 0:
            return 0.0
        primary: str = str(self._cfg.evaluation.metrics[0])

        # Extract eval records with timestamps and primary metric.
        eval_points: List[Tuple[float, float]] = []
        for rec in self._history:
            if not isinstance(rec, dict):
                continue
            if not str(rec.get("stage", "")).startswith("pruning") and not str(rec.get("stage", "")).startswith("recovery"):
                continue
            # We only record train steps here; eval metrics are recorded by callbacks into JSONL.
            # Therefore, compute from checkpoint best state timing is not possible here reliably.
            # Provide 0.0 unless trainer has explicit eval timeline in history.
        # If no eval timeline recorded here, return 0.0 deterministically.
        return 0.0
