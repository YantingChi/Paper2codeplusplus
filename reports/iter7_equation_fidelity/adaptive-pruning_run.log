## src/algorithms/salience.py
from __future__ import annotations

from dataclasses import dataclass
from typing import Any, Dict, List, Optional, Tuple

import torch

from src.models.apt_injector import APTRegistry
from src.models.apt_linear import APTLinear
from src.utils.logging import get_logger


## @brief Structured block scoring record used by pruning search.
# @details This dataclass matches the project design and is consumed by pruning code to compute
# density = salience / param_count for knapsack-style selection.
@dataclass
class BlockScore:
    ## @brief Initialize a BlockScore.
    # @param block_id str Unique identifier for the block (e.g., "attention_heads:<gid>:<idx>").
    # @param group str Group identifier (e.g., "attn_q", "attn_v", "ffn", or group-id strings).
    # @param block_type str One of {"head","neuron","hidden_dim","rank"}.
    # @param salience float Salience score (larger means more important).
    # @param param_count int Parameter count attributed to this block.
    # @param density float Salience density (salience per parameter).
    def __init__(
        self,
        block_id: str,
        group: str,
        block_type: str,
        salience: float,
        param_count: int,
        density: float,
    ) -> None:
        self.block_id = str(block_id)
        self.group = str(group)
        self.block_type = str(block_type)
        self.salience = float(salience)
        self.param_count = int(param_count)
        self.density = float(density)

    block_id: str
    group: str
    block_type: str
    salience: float
    param_count: int
    density: float


## @brief Online salience estimator for APT adaptive pruning and tuning.
# @details Collects lightweight activation/gradient statistics via hooks on APTLinear modules:
#  - Pruning salience (Sec 4.2 + Appendix B): compressed |H| and |∇H|, then Hadamard product.
#  - Outlier-aware term (Eq. 5): add sqrt(kurtosis) of activations.
#  - EMA smoothing (Appendix B step 7): S^t <- beta*S^{t-1} + (1-beta)*S.
#  - Adapter importance (Sec 4.3): sum over parameter salience entries in W_B.
class SalienceCollector:
    ## @brief Create a SalienceCollector.
    # @param registry APTRegistry Registry of injected APTLinear modules.
    # @param ema_beta float EMA beta coefficient (must be in (0,1); provided by ExperimentConfig.apt.salience_ema_beta).
    # @param use_kurtosis bool Whether to apply outlier-aware kurtosis augmentation (Eq. 5).
    def __init__(self, registry: APTRegistry, ema_beta: float, use_kurtosis: bool) -> None:
        if registry is None:
            raise ValueError("registry must be non-None.")
        beta_f: float = float(ema_beta)
        if not (0.0 < beta_f < 1.0):
            raise ValueError(f"ema_beta must be in (0,1), got {ema_beta}.")
        self._registry: APTRegistry = registry
        self._ema_beta: float = beta_f
        self._use_kurtosis: bool = bool(use_kurtosis)
        self._logger = get_logger("apt.salience")

        # Hook handles for attach/detach.
        self._handles: List[Any] = []

        # Step caches (small vectors) populated by hooks; cleared by reset_step_cache().
        self._step_in_act_abs_sum: Dict[str, torch.Tensor] = {}
        self._step_out_act_abs_sum: Dict[str, torch.Tensor] = {}
        self._step_in_grad_abs_sum: Dict[str, torch.Tensor] = {}
        self._step_out_grad_abs_sum: Dict[str, torch.Tensor] = {}
        self._step_in_kurtosis: Dict[str, torch.Tensor] = {}
        self._step_out_kurtosis: Dict[str, torch.Tensor] = {}

        # Persistent EMA scores returned to pruning: per-module input/output vectors (on CPU float32).
        self._ema_in: Dict[str, torch.Tensor] = {}
        self._ema_out: Dict[str, torch.Tensor] = {}

        # Persistent EMA adapter importance (scalar floats).
        self._ema_adapter_importance: Dict[str, float] = {}

    ## @brief Attach forward/backward hooks to all registered APTLinear modules.
    # @return None
    def attach_hooks(self) -> None:
        self.detach_hooks()
        named: List[Tuple[str, APTLinear]] = self._registry.named_modules()
        if len(named) == 0:
            self._logger.warning("No APT modules in registry; no hooks attached.")
            return

        for module_name, module in named:
            if module is None:
                continue

            # Forward hook: capture compressed activations and kurtosis stats.
            def _fwd_hook(mod: Any, inputs: Tuple[Any, ...], output: Any, name: str = module_name) -> None:
                try:
                    x = inputs[0] if isinstance(inputs, (tuple, list)) and len(inputs) > 0 else None
                    if torch.is_tensor(x):
                        self._on_forward_with_io(name=name, module=mod, x=x, y=output)
                except Exception as e:  # defensive: hooks must not crash training
                    self._logger.warning("Forward hook failed for %s: %s", name, repr(e))

            # Full backward hook: capture compressed gradients (both input and output when available).
            def _bwd_hook(mod: Any, grad_input: Tuple[Any, ...], grad_output: Tuple[Any, ...], name: str = module_name) -> None:
                try:
                    gin = grad_input[0] if isinstance(grad_input, (tuple, list)) and len(grad_input) > 0 else None
                    gout = grad_output[0] if isinstance(grad_output, (tuple, list)) and len(grad_output) > 0 else None
                    if torch.is_tensor(gout):
                        self._on_backward_with_io(name=name, module=mod, grad_in=gin, grad_out=gout)
                except Exception as e:  # defensive: hooks must not crash training
                    self._logger.warning("Backward hook failed for %s: %s", name, repr(e))

            self._handles.append(module.register_forward_hook(_fwd_hook, with_kwargs=False))
            self._handles.append(module.register_full_backward_hook(_bwd_hook))

        self._logger.info("Attached hooks to %d APT modules.", len(named))

    ## @brief Detach all hooks previously attached by attach_hooks().
    # @return None
    def detach_hooks(self) -> None:
        for h in self._handles:
            try:
                h.remove()
            except Exception:
                pass
        self._handles = []

    ## @brief Handle forward activations (design API).
    # @details The design API exposes a single Tensor argument; internally we compute both input/output summaries
    # via the full forward hook to match the paper salience definition based on activations.
    # @param module_name str Fully-qualified module name.
    # @param activations torch.Tensor Forward activations tensor.
    # @return None
    def on_forward(self, module_name: str, activations: torch.Tensor) -> None:
        # Kept for interface compatibility; the actual summaries are computed in _on_forward_with_io().
        if not module_name:
            return
        if not torch.is_tensor(activations):
            return
        _ = module_name  # explicit; no-op by design

    ## @brief Handle backward gradient output (design API).
    # @details The design API exposes grad_output only; internally we prefer full backward hook data.
    # @param module_name str Fully-qualified module name.
    # @param grad_output torch.Tensor Gradient with respect to module output.
    # @return None
    def on_backward(self, module_name: str, grad_output: torch.Tensor) -> None:
        if not module_name:
            return
        if not torch.is_tensor(grad_output):
            return
        # Store output gradient abs-sum; input gradient may be missing in this API.
        gout_vec = self._compress_abs_sum_lastdim(grad_output)
        self._step_out_grad_abs_sum[module_name] = gout_vec.to(device="cpu", dtype=torch.float32)

    ## @brief Update EMA block salience tensors from the current step cache.
    # @details Must be called after backward so gradients are available (Trainer call flow).
    # Computes:
    #  - input salience: |H_in|_sum ⊙ |∇H_in|_sum
    #  - output salience: |H_out|_sum ⊙ |∇H_out|_sum
    # Optionally applies outlier-aware augmentation (Eq. 5) and EMA smoothing (Appendix B step 7).
    # @return None
    def update_block_salience(self) -> None:
        named: List[Tuple[str, APTLinear]] = self._registry.named_modules()
        if len(named) == 0:
            return

        for module_name, module in named:
            if module_name not in self._step_out_grad_abs_sum and module_name not in self._step_in_grad_abs_sum:
                continue

            # Retrieve cached vectors; default to zeros if missing for stability.
            in_act: Optional[torch.Tensor] = self._step_in_act_abs_sum.get(module_name, None)
            out_act: Optional[torch.Tensor] = self._step_out_act_abs_sum.get(module_name, None)
            in_grad: Optional[torch.Tensor] = self._step_in_grad_abs_sum.get(module_name, None)
            out_grad: Optional[torch.Tensor] = self._step_out_grad_abs_sum.get(module_name, None)

            meta: Dict[str, Any] = module.collect_structure_metadata()
            in_features: int = int(meta.get("in_features", 0))
            out_features: int = int(meta.get("out_features", 0))
            if in_features <= 0 or out_features <= 0:
                continue

            if in_act is None:
                in_act = torch.zeros((in_features,), device="cpu", dtype=torch.float32)
            if out_act is None:
                out_act = torch.zeros((out_features,), device="cpu", dtype=torch.float32)
            if in_grad is None:
                in_grad = torch.zeros((in_features,), device="cpu", dtype=torch.float32)
            if out_grad is None:
                out_grad = torch.zeros((out_features,), device="cpu", dtype=torch.float32)

            # Base pruning salience: Hadamard product of compressed activation and gradient magnitudes.
            # This follows Appendix B sketch: H • sum(|∇_H L|).
            s_in: torch.Tensor = in_act * in_grad
            s_out: torch.Tensor = out_act * out_grad

            # Outlier-aware augmentation (Eq. 5) on each per-dimension block salience if enabled.
            if self._use_kurtosis:
                kin = self._step_in_kurtosis.get(module_name, None)
                kout = self._step_out_kurtosis.get(module_name, None)
                if kin is not None:
                    s_in = self.compute_kurtosis_bonus(salience=s_in, activations_kurtosis=kin)
                if kout is not None:
                    s_out = self.compute_kurtosis_bonus(salience=s_out, activations_kurtosis=kout)

            # Sanitize for numerical stability.
            s_in = torch.nan_to_num(s_in, nan=0.0, posinf=0.0, neginf=0.0)
            s_out = torch.nan_to_num(s_out, nan=0.0, posinf=0.0, neginf=0.0)

            # EMA update into persistent buffers.
            if module_name not in self._ema_in:
                self._ema_in[module_name] = s_in.detach().clone()
            else:
                self._ema_in[module_name] = self.update_ema(self._ema_in[module_name], s_in, self._ema_beta)

            if module_name not in self._ema_out:
                self._ema_out[module_name] = s_out.detach().clone()
            else:
                self._ema_out[module_name] = self.update_ema(self._ema_out[module_name], s_out, self._ema_beta)

        # Do not auto-clear step cache here; Trainer controls step boundaries via reset_step_cache().

    ## @brief Return EMA salience block scores used by PruningScheduler.
    # @details Output matches design: dict[module_name] -> dict[str, Tensor] with keys:
    #  - "input": Tensor[in_features]
    #  - "output": Tensor[out_features]
    # @return dict[str, dict[str, torch.Tensor]] EMA block scores (CPU float32 tensors).
    def get_block_scores(self) -> Dict[str, Dict[str, torch.Tensor]]:
        out: Dict[str, Dict[str, torch.Tensor]] = {}
        for module_name, module in self._registry.named_modules():
            meta: Dict[str, Any] = module.collect_structure_metadata()
            in_features: int = int(meta.get("in_features", 0))
            out_features: int = int(meta.get("out_features", 0))
            if in_features <= 0 or out_features <= 0:
                continue

            s_in = self._ema_in.get(module_name, None)
            s_out = self._ema_out.get(module_name, None)
            if s_in is None:
                s_in = torch.zeros((in_features,), device="cpu", dtype=torch.float32)
            if s_out is None:
                s_out = torch.zeros((out_features,), device="cpu", dtype=torch.float32)

            # Ensure correct shapes even if model changed unexpectedly.
            if int(s_in.numel()) != in_features:
                s_in = torch.zeros((in_features,), device="cpu", dtype=torch.float32)
            if int(s_out.numel()) != out_features:
                s_out = torch.zeros((out_features,), device="cpu", dtype=torch.float32)

            out[module_name] = {"input": s_in.detach(), "output": s_out.detach()}
        return out

    ## @brief Compute adapter importance for adaptive rank allocation.
    # @details Implements Sec. 4.3:
    #   I(H_apt) = sum_{i,j} S(W_B^{i,j})
    # where S(W) is magnitude of weight-gradient production. We compute:
    #   S(W_B) = |W_B ⊙ ∇W_B|
    # and sum over all entries. Returns EMA-smoothed scalar per module.
    # @return dict[str, float] Mapping module_name -> importance score.
    def get_adapter_importance(self) -> Dict[str, float]:
        out: Dict[str, float] = {}
        for module_name, module in self._registry.named_modules():
            wb = self._get_wb_parameter(module)
            if wb is None:
                out[module_name] = 0.0
                continue
            if wb.grad is None:
                cur_val = 0.0
            else:
                # eq: adapter_importance_sec43
                prod = (wb.detach().float() * wb.grad.detach().float()).abs()
                cur_val = float(torch.nan_to_num(prod, nan=0.0, posinf=0.0, neginf=0.0).sum().item())

            if module_name not in self._ema_adapter_importance:
                self._ema_adapter_importance[module_name] = float(cur_val)
            else:
                prev = float(self._ema_adapter_importance[module_name])
                beta = float(self._ema_beta)
                # Same EMA rule as Appendix B, applied to scalar importance for stability.
                self._ema_adapter_importance[module_name] = float(beta * prev + (1.0 - beta) * float(cur_val))

            out[module_name] = float(self._ema_adapter_importance[module_name])
        return out

    ## @brief Reset per-step caches (activations/gradients/kurtosis) for the next training step.
    # @return None
    def reset_step_cache(self) -> None:
        self._step_in_act_abs_sum.clear()
        self._step_out_act_abs_sum.clear()
        self._step_in_grad_abs_sum.clear()
        self._step_out_grad_abs_sum.clear()
        self._step_in_kurtosis.clear()
        self._step_out_kurtosis.clear()

    ## @brief Exponential moving average update rule from Appendix B.
    # @details Implements:
    #   S^{(t)}(m) <- beta * S^{(t-1)}(m) + (1 - beta) * S(m)
    # @param prev torch.Tensor Previous EMA value tensor.
    # @param cur torch.Tensor Current value tensor.
    # @param beta float EMA coefficient beta.
    # @return torch.Tensor Updated EMA tensor.
    def update_ema(self, prev: torch.Tensor, cur: torch.Tensor, beta: float) -> torch.Tensor:
        if not torch.is_tensor(prev) or not torch.is_tensor(cur):
            raise TypeError("update_ema requires tensor inputs.")
        beta_f: float = float(beta)
        if not (0.0 < beta_f < 1.0):
            raise ValueError(f"beta must be in (0,1), got {beta}.")
        prev_f = prev.detach().float()
        cur_f = cur.detach().float()
        # eq: ema_salience_appendixB_step7
        ema = beta_f * prev_f + (1.0 - beta_f) * cur_f
        return ema.to(device="cpu", dtype=torch.float32)

    ## @brief Apply outlier-aware kurtosis augmentation (Eq. 5).
    # @details Implements:
    #   S_hat = S + sqrt(Kurt(O))
    # This method takes a precomputed kurtosis vector (per feature dimension) to avoid storing
    # full activation tensors.
    # @param salience torch.Tensor Base salience vector S (per feature).
    # @param activations_kurtosis torch.Tensor Kurtosis vector Kurt(O) (per feature).
    # @return torch.Tensor Outlier-aware salience vector S_hat.
    def compute_kurtosis_bonus(self, salience: torch.Tensor, activations_kurtosis: torch.Tensor) -> torch.Tensor:
        if not torch.is_tensor(salience) or not torch.is_tensor(activations_kurtosis):
            raise TypeError("compute_kurtosis_bonus requires tensor inputs.")
        if salience.ndim != 1 or activations_kurtosis.ndim != 1:
            raise ValueError("compute_kurtosis_bonus expects 1D vectors.")
        if int(salience.numel()) != int(activations_kurtosis.numel()):
            raise ValueError(
                f"Kurtosis vector length must match salience: {int(activations_kurtosis.numel())} vs {int(salience.numel())}."
            )

        kurt = torch.nan_to_num(activations_kurtosis.detach().float(), nan=0.0, posinf=0.0, neginf=0.0)
        kurt = torch.clamp(kurt, min=0.0)
        s = salience.detach().float()
        # eq: outlier_aware_salience_eq5
        s_hat = s + torch.sqrt(kurt)
        return s_hat.to(device="cpu", dtype=torch.float32)

    ## @brief Compress a tensor into a per-feature vector by summing absolute values over all but last dim.
    # @param t torch.Tensor Input tensor with features on the last dimension.
    # @return torch.Tensor 1D vector of length t.shape[-1].
    def _compress_abs_sum_lastdim(self, t: torch.Tensor) -> torch.Tensor:
        if t.ndim == 0:
            return t.detach().abs().reshape(1)
        if t.ndim == 1:
            return t.detach().abs()
        dims = tuple(range(t.ndim - 1))
        return t.detach().abs().sum(dim=dims)

    ## @brief Compute per-feature kurtosis (Pearson) over sample dimensions (all but last dim).
    # @details Kurtosis is computed as E[(x-μ)^4] / (E[(x-μ)^2]^2 + eps), per feature dimension.
    # @param t torch.Tensor Activation tensor with features on last dimension.
    # @return torch.Tensor 1D kurtosis vector of length t.shape[-1] on CPU float32.
    def _kurtosis_lastdim(self, t: torch.Tensor) -> torch.Tensor:
        if t.ndim == 0:
            return torch.zeros((1,), device="cpu", dtype=torch.float32)
        if t.ndim == 1:
            x = t.detach().float().reshape(-1, 1)
        else:
            x = t.detach().float().reshape(-1, int(t.shape[-1]))

        if int(x.shape[0]) <= 1:
            return torch.zeros((int(x.shape[1]),), device="cpu", dtype=torch.float32)

        mean = x.mean(dim=0)
        centered = x - mean
        m2 = (centered * centered).mean(dim=0)
        m4 = (centered * centered * centered * centered).mean(dim=0)
        eps = 1e-12
        kurt = m4 / (m2 * m2 + eps)
        kurt = torch.nan_to_num(kurt, nan=0.0, posinf=0.0, neginf=0.0)
        kurt = torch.clamp(kurt, min=0.0)
        return kurt.to(device="cpu", dtype=torch.float32)

    ## @brief Retrieve the adapter W_B parameter tensor for an APTLinear module.
    # @param module APTLinear APTLinear instance.
    # @return Optional[torch.nn.Parameter] W_B parameter if present, else None.
    def _get_wb_parameter(self, module: APTLinear) -> Optional[torch.nn.Parameter]:
        wb = getattr(module, "lora_B", None)
        if isinstance(wb, torch.nn.Parameter):
            return wb
        wb2 = getattr(module, "W_B", None)
        if isinstance(wb2, torch.nn.Parameter):
            return wb2
        # Some wrappers may store in a submodule.
        wb3 = getattr(module, "wb", None)
        if isinstance(wb3, torch.nn.Parameter):
            return wb3
        return None

    ## @brief Forward-hook worker that stores compressed input/output activations and kurtosis vectors.
    # @param name str Module name.
    # @param module Any Module instance (APTLinear expected).
    # @param x torch.Tensor Input activation.
    # @param y Any Output activation (tensor-like).
    # @return None
    def _on_forward_with_io(self, name: str, module: Any, x: torch.Tensor, y: Any) -> None:
        if not name:
            return

        # Apply current input mask if present so salience reflects masked computation.
        mi = getattr(module, "_input_mask", None)
        if torch.is_tensor(mi) and mi.ndim == 1 and int(mi.numel()) == int(x.shape[-1]):
            x_eff = x * mi
        else:
            x_eff = x

        in_vec = self._compress_abs_sum_lastdim(x_eff).to(device="cpu", dtype=torch.float32)
        self._step_in_act_abs_sum[name] = in_vec

        if self._use_kurtosis:
            self._step_in_kurtosis[name] = self._kurtosis_lastdim(x_eff)

        if torch.is_tensor(y):
            out_vec = self._compress_abs_sum_lastdim(y).to(device="cpu", dtype=torch.float32)
            self._step_out_act_abs_sum[name] = out_vec
            if self._use_kurtosis:
                self._step_out_kurtosis[name] = self._kurtosis_lastdim(y)

        # Maintain the design API call for forward activations (input).
        self.on_forward(module_name=name, activations=x_eff.detach())

    ## @brief Backward-hook worker that stores compressed input/output gradients.
    # @param name str Module name.
    # @param module Any Module instance (APTLinear expected).
    # @param grad_in Any Gradient w.r.t input (may be None).
    # @param grad_out torch.Tensor Gradient w.r.t output.
    # @return None
    def _on_backward_with_io(self, name: str, module: Any, grad_in: Any, grad_out: torch.Tensor) -> None:
        if not name:
            return

        out_g = self._compress_abs_sum_lastdim(grad_out).to(device="cpu", dtype=torch.float32)
        self._step_out_grad_abs_sum[name] = out_g

        if torch.is_tensor(grad_in):
            in_g = self._compress_abs_sum_lastdim(grad_in).to(device="cpu", dtype=torch.float32)
            self._step_in_grad_abs_sum[name] = in_g

        # Maintain the design API call for backward grad_output.
        self.on_backward(module_name=name, grad_output=grad_out.detach())
