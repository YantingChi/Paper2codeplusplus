## src/data/collators.py
from __future__ import annotations

from typing import Any, Dict, List, Mapping, Optional, Sequence

import torch
from transformers import DataCollatorForSeq2Seq, DataCollatorWithPadding

from src.config import DataConfig, ModelConfig


## @brief Safely cast an object to a dict.
# @param obj Any Input object.
# @return dict[str, Any] A dict view of the object.
def _as_dict(obj: Any) -> Dict[str, Any]:
    if isinstance(obj, dict):
        return obj
    if isinstance(obj, Mapping):
        return {str(k): v for k, v in obj.items()}
    raise TypeError(f"Expected a mapping/dict feature, got: {type(obj)}")


## @brief Check that a tokenizer has a pad token id, raising an actionable error otherwise.
# @param tokenizer Any Hugging Face tokenizer.
# @param task_type str Task type for error message context.
# @return int The tokenizer.pad_token_id.
def _require_pad_token_id(tokenizer: Any, task_type: str) -> int:
    pad_token_id: Optional[int] = getattr(tokenizer, "pad_token_id", None)
    if pad_token_id is None:
        raise ValueError(
            f"Tokenizer has no pad_token_id, which is required for padding in task_type={task_type!r}. "
            "Set tokenizer.pad_token (commonly to tokenizer.eos_token for LLaMA) in DatasetLoader.build_tokenizer()."
        )
    return int(pad_token_id)


## @brief Data collator for causal language model fine-tuning with precomputed labels.
# @details Pads input_ids/attention_mask using tokenizer.pad, and pads labels with -100 to the same
# sequence length so CrossEntropy ignores padding. This matches standard HF LM training semantics.
class CausalLMCollator:
    ## @brief Create a CausalLMCollator.
    # @param tokenizer Any Hugging Face tokenizer.
    def __init__(self, tokenizer: Any) -> None:
        self._tokenizer: Any = tokenizer
        _ = _require_pad_token_id(self._tokenizer, "causal_lm")

    ## @brief Collate tokenized examples for causal LM.
    # @param features list[dict[str, Any]] Tokenized examples.
    # @return dict[str, Any] Padded batch containing input_ids, attention_mask, labels.
    def __call__(self, features: List[Dict[str, Any]]) -> Dict[str, Any]:
        if not isinstance(features, list) or len(features) == 0:
            raise ValueError("CausalLMCollator requires a non-empty list of feature dicts.")

        # Split labels from model inputs before tokenizer.pad to avoid tokenizer attempting to pad labels
        # with pad_token_id (we need -100).
        inputs: List[Dict[str, Any]] = []
        labels_list: List[Sequence[int]] = []

        for feat_any in features:
            feat: Dict[str, Any] = _as_dict(feat_any)
            if "input_ids" not in feat:
                raise KeyError("Causal LM feature missing required key: 'input_ids'.")
            if "labels" not in feat:
                raise KeyError("Causal LM feature missing required key: 'labels'.")

            labels_list.append(list(feat["labels"]))
            # Keep only keys that should be padded by tokenizer.
            keep: Dict[str, Any] = {
                "input_ids": feat["input_ids"],
            }
            if "attention_mask" in feat:
                keep["attention_mask"] = feat["attention_mask"]
            inputs.append(keep)

        batch: Dict[str, Any] = self._tokenizer.pad(
            inputs,
            padding=True,
            return_tensors="pt",
        )

        # Ensure attention_mask exists (tokenizer.pad usually produces it).
        if "attention_mask" not in batch:
            pad_token_id: int = _require_pad_token_id(self._tokenizer, "causal_lm")
            batch["attention_mask"] = (batch["input_ids"] != pad_token_id).to(dtype=torch.long)

        # Pad labels to the same sequence length as input_ids using -100.
        max_len: int = int(batch["input_ids"].shape[1])
        padded_labels: List[List[int]] = []
        for lbl in labels_list:
            lbl_trunc: List[int] = list(lbl)[:max_len]
            if len(lbl_trunc) < max_len:
                lbl_trunc = lbl_trunc + ([-100] * (max_len - len(lbl_trunc)))
            padded_labels.append(lbl_trunc)

        batch["labels"] = torch.tensor(padded_labels, dtype=torch.long)
        return batch


## @brief Data collator for SQuAD-style question answering with optional eval metadata passthrough.
# @details For training, only model-consumable keys are returned to avoid forward() TypeErrors.
# For evaluation, metadata (example_id, offset_mapping) can be returned under a nested 'qa_metadata'
# key so callers can choose to use it while filtering inputs for model forward.
class QACollator:
    ## @brief Create a QACollator.
    # @param tokenizer Any Hugging Face tokenizer.
    # @param include_metadata bool Whether to include QA metadata for evaluation.
    def __init__(self, tokenizer: Any, include_metadata: bool = False) -> None:
        self._tokenizer: Any = tokenizer
        self._base: DataCollatorWithPadding = DataCollatorWithPadding(tokenizer=self._tokenizer, padding=True)
        self._include_metadata: bool = bool(include_metadata)

    ## @brief Collate QA examples.
    # @param features list[dict[str, Any]] Tokenized QA examples.
    # @return dict[str, Any] Padded batch suitable for QA models; may include qa_metadata.
    def __call__(self, features: List[Dict[str, Any]]) -> Dict[str, Any]:
        if not isinstance(features, list) or len(features) == 0:
            raise ValueError("QACollator requires a non-empty list of feature dicts.")

        meta_example_id: List[Any] = []
        meta_offset_mapping: List[Any] = []

        cleaned: List[Dict[str, Any]] = []
        for feat_any in features:
            feat: Dict[str, Any] = _as_dict(feat_any)

            if self._include_metadata:
                if "example_id" in feat:
                    meta_example_id.append(feat["example_id"])
                if "offset_mapping" in feat:
                    meta_offset_mapping.append(feat["offset_mapping"])

            # Remove metadata keys that would break padding / model forward.
            # Keep start/end positions if present (training).
            drop_keys = {"example_id", "offset_mapping"}
            cleaned.append({k: v for k, v in feat.items() if k not in drop_keys})

        batch: Dict[str, Any] = self._base(cleaned)

        if self._include_metadata:
            # Store metadata in a nested dict so model forward can be called on a filtered view easily.
            # Callers should not pass 'qa_metadata' into model(**batch).
            batch["qa_metadata"] = {
                "example_id": meta_example_id,
                "offset_mapping": meta_offset_mapping,
            }
        return batch


## @brief Build a Hugging Face data collator based on the configured task type.
# @details This is the factory used by DatasetLoader to populate DatasetBundle.data_collator.
# @param tokenizer Any Hugging Face tokenizer.
# @param data_config DataConfig Dataset configuration (not used here beyond signature stability).
# @param model_config ModelConfig Model configuration (task_type determines collator selection).
# @param is_train bool Whether this collator is used for training (affects QA metadata passthrough).
# @return Any A callable collator.
def build_data_collator(tokenizer: Any, data_config: DataConfig, model_config: ModelConfig, is_train: bool) -> Any:
    task_type: str = str(getattr(model_config, "task_type", "") or "").strip().lower()
    if not task_type:
        raise ValueError("ModelConfig.task_type must be set to build a data collator.")

    # Keep behavior library-backed where possible, with minimal wrappers for QA metadata and LM label padding.
    if task_type == "sequence_classification":
        return DataCollatorWithPadding(tokenizer=tokenizer, padding=True)

    if task_type == "qa":
        # During training, do not include metadata to avoid model forward signature errors.
        # During evaluation, metadata is nested under 'qa_metadata' and must be filtered by evaluator.
        return QACollator(tokenizer=tokenizer, include_metadata=not bool(is_train))

    if task_type == "seq2seq":
        # DataCollatorForSeq2Seq pads labels with label_pad_token_id (default -100) so loss ignores padding.
        return DataCollatorForSeq2Seq(
            tokenizer=tokenizer,
            model=None,
            padding=True,
            label_pad_token_id=-100,
        )

    if task_type == "causal_lm":
        return CausalLMCollator(tokenizer=tokenizer)

    raise ValueError(f"Unsupported task_type for collator: {task_type!r}")


## @brief Backwards-compatible alias for build_data_collator.
# @param tokenizer Any Hugging Face tokenizer.
# @param data_config DataConfig Dataset configuration.
# @param model_config ModelConfig Model configuration.
# @param is_train bool Whether the collator is for training.
# @return Any Collator callable.
def get_data_collator(tokenizer: Any, data_config: DataConfig, model_config: ModelConfig, is_train: bool) -> Any:
    return build_data_collator(tokenizer=tokenizer, data_config=data_config, model_config=model_config, is_train=is_train)
