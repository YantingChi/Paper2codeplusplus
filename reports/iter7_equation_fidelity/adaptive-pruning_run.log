## src/algorithms/pruning.py
from __future__ import annotations

import math
import os
import re
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple

import torch
import yaml

from src.algorithms.salience import BlockScore
from src.config import APTConfig
from src.models.apt_injector import APTRegistry
from src.models.mask_utils import MaskManager
from src.utils.logging import get_logger


_PAPER_CFG_CACHE: Optional[Dict[str, Any]] = None


## @brief Load the global paper configuration (config.yaml) with caching.
# @return dict[str, Any] Parsed YAML configuration.
def _load_paper_config() -> Dict[str, Any]:
    global _PAPER_CFG_CACHE
    if _PAPER_CFG_CACHE is not None:
        return _PAPER_CFG_CACHE

    candidates = [
        Path(os.getcwd()) / "config.yaml",
        Path(__file__).resolve().parents[2] / "config.yaml",  # repo_root/config.yaml (src/algorithms/..)
        Path(__file__).resolve().parents[3] / "config.yaml",
    ]
    for p in candidates:
        if p.exists():
            with p.open("r", encoding="utf-8") as f:
                data = yaml.safe_load(f) or {}
            if not isinstance(data, dict):
                raise ValueError(f"config.yaml root must be a dict, got {type(data)}")
            _PAPER_CFG_CACHE = data
            return _PAPER_CFG_CACHE
    raise FileNotFoundError("Cannot find required config.yaml in CWD or repo parents.")


## @brief Safe nested-get for dicts using dotted path.
# @param d dict[str, Any] Root dictionary.
# @param path str Dotted path (e.g., "apt.pruning_blocks").
# @param default Any Default if missing.
# @return Any Retrieved value or default.
def _get_nested(d: Dict[str, Any], path: str, default: Any) -> Any:
    cur: Any = d
    for part in str(path).split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return cur


## @brief Coerce a value to float with a default.
# @param v Any Input value.
# @param default float Default if v is None.
# @return float Coerced float.
def _as_float(v: Any, default: float) -> float:
    if v is None:
        return float(default)
    if isinstance(v, (int, float)):
        return float(v)
    if isinstance(v, str):
        return float(v.strip())
    raise ValueError(f"Cannot coerce to float: {v!r}")


## @brief Coerce a value to list[str] with a default.
# @param v Any Input value.
# @param default list[str] Default list if v is None.
# @return list[str] Coerced list of strings.
def _as_str_list(v: Any, default: List[str]) -> List[str]:
    if v is None:
        return list(default)
    if isinstance(v, list):
        return [str(x) for x in v]
    raise ValueError(f"Cannot coerce to list[str]: {v!r}")


## @brief Determine whether an attention group id corresponds to T5-style cross-attention.
# @param attn_gid str Attention group id string.
# @return bool True if cross-attention, else False.
def _is_cross_attention_gid(attn_gid: str) -> bool:
    s = (attn_gid or "").lower()
    return ("encdecattention" in s) or ("crossattention" in s) or ("cross_attn" in s)


## @brief Infer model side (encoder/decoder/model) from a module/group name.
# @param name str Group id or module name.
# @return str Side identifier.
def _infer_side(name: str) -> str:
    s = (name or "").lower()
    if "encoder" in s and "decoder" not in s:
        return "encoder"
    if "decoder" in s:
        return "decoder"
    return "model"


## @brief Extract layer index from a group/module name.
# @param name str Group id or module name.
# @return int Layer index if present, else -1.
def _extract_layer_index(name: str) -> int:
    m = re.search(r"\.(layer|layers|block)\.(\d+)\b", name)
    if m is None:
        return -1
    return int(m.group(2))


## @brief Build a stable (side,layer) key string for per-layer aggregation.
# @param side str Side string (encoder/decoder/model).
# @param layer_index int Layer index.
# @param fallback_rank int Fallback index used if layer_index < 0.
# @return str Layer key string.
def _layer_key(side: str, layer_index: int, fallback_rank: int) -> str:
    idx = layer_index if layer_index >= 0 else fallback_rank
    return f"{side}:{int(idx)}"


## @brief Infer whether FFN is gated from registry module names (T5/LLaMA-style).
# @param registry APTRegistry Registry of injected APT modules.
# @return bool True if gated FFN is detected, else False.
def _infer_gated_ffn_from_registry(registry: APTRegistry) -> bool:
    for name, _ in registry.named_modules():
        s = name.lower()
        if any(tok in s for tok in ("wi_0", "wi_1", "gate_proj")):
            return True
    return False


## @brief Internal structure metadata used for parameter counting and cross-attention handling.
@dataclass
class _StructureMeta:
    ## @brief Initialize structure meta.
    # @param d_model int Dense hidden size d_m.
    # @param layer_keys list[str] Per-layer keys (side:idx).
    # @param attn_self_by_layer dict[str, str] layer_key -> self-attn gid.
    # @param attn_cross_by_layer dict[str, str] layer_key -> cross-attn gid (decoder only).
    # @param ffn_by_layer dict[str, str] layer_key -> ffn gid.
    # @param attn_num_heads_total dict[str, int] gid -> total head count (mask length).
    # @param ffn_num_neurons_total dict[str, int] gid -> total neuron count (mask length).
    # @param ffn_factor int FFN projection factor (2 non-gated, 3 gated).
    def __init__(
        self,
        d_model: int,
        layer_keys: List[str],
        attn_self_by_layer: Dict[str, str],
        attn_cross_by_layer: Dict[str, str],
        ffn_by_layer: Dict[str, str],
        attn_num_heads_total: Dict[str, int],
        ffn_num_neurons_total: Dict[str, int],
        ffn_factor: int,
    ) -> None:
        self.d_model = int(d_model)
        self.layer_keys = list(layer_keys)
        self.attn_self_by_layer = dict(attn_self_by_layer)
        self.attn_cross_by_layer = dict(attn_cross_by_layer)
        self.ffn_by_layer = dict(ffn_by_layer)
        self.attn_num_heads_total = dict(attn_num_heads_total)
        self.ffn_num_neurons_total = dict(ffn_num_neurons_total)
        self.ffn_factor = int(ffn_factor)

    d_model: int
    layer_keys: List[str]
    attn_self_by_layer: Dict[str, str]
    attn_cross_by_layer: Dict[str, str]
    ffn_by_layer: Dict[str, str]
    attn_num_heads_total: Dict[str, int]
    ffn_num_neurons_total: Dict[str, int]
    ffn_factor: int


## @brief Scheduler and selector for APT adaptive structured pruning.
# @details Owns:
#  (a) cubic sparsity schedule γ_t,
#  (b) conversion of SalienceCollector block scores into block candidates with salience density,
#  (c) binary search to retain top salient blocks under a parameter-budget constraint,
#  (d) producing retain_ids mapping consumed by MaskManager.apply_mask_updates(...).
class PruningScheduler:
    ## @brief Create a PruningScheduler.
    # @param registry APTRegistry Registry of injected APT modules.
    # @param mask_manager MaskManager Mask manager providing active structure and applying updates.
    # @param apt_config APTConfig APT configuration providing target sparsity and scheduling options.
    def __init__(self, registry: APTRegistry, mask_manager: MaskManager, apt_config: APTConfig) -> None:
        if registry is None:
            raise ValueError("registry must be non-None.")
        if mask_manager is None:
            raise ValueError("mask_manager must be non-None.")
        if apt_config is None:
            raise ValueError("apt_config must be non-None.")

        self._registry: APTRegistry = registry
        self._mask_manager: MaskManager = mask_manager
        self._apt_config: APTConfig = apt_config
        self._logger = get_logger("apt.pruning")

        paper_cfg = _load_paper_config()
        schedule = str(_get_nested(paper_cfg, "apt.target_sparsity_schedule", "cubic")).strip().lower()
        if schedule != "cubic":
            raise ValueError("Paper config requires apt.target_sparsity_schedule == 'cubic'.")

        blocks = _as_str_list(_get_nested(paper_cfg, "apt.pruning_blocks", []), default=[])
        self._enabled_blocks: List[str] = [str(b).strip().lower() for b in blocks if str(b).strip()]
        self._enabled_blocks_set = set(self._enabled_blocks)

        self._ffn_is_gated: bool = _infer_gated_ffn_from_registry(self._registry)
        self._has_cross_attention: bool = any(_is_cross_attention_gid(gid) for gid in self._iter_attention_gids_from_registry())

        self._dense_param_count: Optional[int] = None
        self._dense_meta: Optional[_StructureMeta] = None

    ## @brief Compute target sparsity γ_t at a given pruning-stage step using cubic schedule.
    # @details Implements paper schedule (Conclusion):
    #   γ_t = γ_T + (1 - γ_T) (1 - t/T)^3
    # This function clamps the result to [0, 1].
    # @param global_step int Pruning-stage step index t (trainer should pass pruning-local step).
    # @param total_pruning_steps int Total pruning-stage steps T.
    # @return float Target sparsity γ_t.
    def target_sparsity_at_step(self, global_step: int, total_pruning_steps: int) -> float:
        gamma_T: float = float(self._apt_config.target_sparsity)
        t: float = float(max(0, int(global_step)))
        T: float = float(max(1, int(total_pruning_steps)))

        # eq: apt_gamma_schedule_cubic
        gamma_t: float = gamma_T + (1.0 - gamma_T) * (1.0 - t / T) ** 3

        # Bound for safety (do not change formula).
        if gamma_t < 0.0:
            gamma_t = 0.0
        if gamma_t > 1.0:
            gamma_t = 1.0
        return float(gamma_t)

    ## @brief Select blocks to retain under a target sparsity constraint.
    # @details Converts per-module (input/output) salience vectors into:
    #  - attention-head block salience per attention group id
    #  - FFN-neuron block salience per FFN group id
    #  - hidden-dimension salience vector
    # Then computes salience density = salience / param_count and sorts blocks by density.
    # Uses binary search to find maximal top-k retained blocks such that estimated remaining parameters
    # do not exceed the remaining-parameter budget implied by target_sparsity.
    # This function returns retain_ids formatted for MaskManager.apply_mask_updates(...):
    #  - "hidden_dimensions" -> indices
    #  - "attention_heads:<gid>" -> head indices
    #  - "ffn_neurons:<gid>" -> neuron indices
    # @param block_scores dict[str, dict[str, torch.Tensor]] EMA block scores from SalienceCollector.get_block_scores().
    # @param target_sparsity float Target sparsity γ (ratio pruned) in [0,1].
    # @return dict[str, list[int]] Mapping from mask group key to retained indices.
    def select_blocks(self, block_scores: Dict[str, Dict[str, torch.Tensor]], target_sparsity: float) -> Dict[str, List[int]]:
        gamma: float = float(target_sparsity)
        if gamma < 0.0 or gamma > 1.0:
            raise ValueError(f"target_sparsity must be in [0,1], got {target_sparsity}.")

        # Ensure masks exist and active structure is available.
        self._mask_manager.initialize_masks()
        active_structure: Dict[str, Any] = self._mask_manager.compute_active_structure()

        # Cache dense meta/param count once.
        if self._dense_meta is None or self._dense_param_count is None:
            self._dense_meta = self._build_dense_meta(active_structure)
            dense_structure = self._make_dense_active_structure(active_structure)
            self._dense_param_count = int(self.estimate_parameter_count(dense_structure))
            self._logger.info(
                "Cached dense param estimate=%d | d_model=%d | layers=%d | ffn_gated=%s | cross_attn=%s",
                int(self._dense_param_count),
                int(self._dense_meta.d_model),
                int(len(self._dense_meta.layer_keys)),
                bool(self._dense_meta.ffn_factor == 3),
                bool(self._has_cross_attention),
            )

        dense_total: int = int(self._dense_param_count)
        # Remaining parameter budget: floor((1 - γ) * C_dense)
        target_budget: int = int(math.floor((1.0 - gamma) * float(dense_total)))
        if target_budget < 0:
            target_budget = 0

        # If salience is not ready (all zeros/empty), retain everything for stability.
        if not self._has_any_salience_signal(block_scores):
            return self._retain_all(active_structure)

        # Aggregate per-block salience.
        head_salience = self._aggregate_head_salience(block_scores, active_structure)
        neuron_salience = self._aggregate_neuron_salience(block_scores, active_structure)
        hidden_salience = self._aggregate_hidden_dim_salience(block_scores, active_structure)

        # Build scored blocks with per-block parameter counts (Appendix C equations).
        scored_blocks: List[BlockScore] = self._build_scored_blocks(
            head_salience=head_salience,
            neuron_salience=neuron_salience,
            hidden_salience=hidden_salience,
            active_structure=active_structure,
        )
        if len(scored_blocks) == 0:
            return self._retain_all(active_structure)

        # Sort by salience density descending.
        scored_blocks.sort(key=lambda b: (float(b.density), float(b.salience)), reverse=True)

        # Binary search over prefix length.
        retain_prefix_indices: List[int] = self.binary_search_retain_set(scored_blocks, target_budget)

        # Convert retained prefix blocks into retain_ids mapping.
        retain_ids: Dict[str, List[int]] = {}
        for idx in retain_prefix_indices:
            b = scored_blocks[int(idx)]
            group_key, block_index = self._parse_block_id_to_group_and_index(b.block_id, b.group, b.block_type)
            if group_key not in retain_ids:
                retain_ids[group_key] = []
            retain_ids[group_key].append(int(block_index))

        # Ensure determinism and uniqueness.
        for k in list(retain_ids.keys()):
            retain_ids[k] = sorted(list(set(int(x) for x in retain_ids[k])))

        # Ensure every enabled mask group is present; missing groups => retain all indices in that group.
        retain_ids = self._fill_missing_groups_with_retain_all(retain_ids, active_structure)
        return retain_ids

    ## @brief Binary search for the largest retained-prefix length satisfying a remaining-parameter budget.
    # @details Paper Appendix C: after sorting by density, parameter count increases monotonically with
    # block quantity; binary search identifies top-i blocks to retain under a constraint.
    # Returns indices [0..k-1] of retained blocks in scored_blocks (prefix).
    # @param scored_blocks list[BlockScore] Blocks sorted by descending density.
    # @param target_budget int Remaining-parameter budget (upper bound on estimated remaining parameters).
    # @return list[int] Retained block indices (prefix indices).
    def binary_search_retain_set(self, scored_blocks: List[BlockScore], target_budget: int) -> List[int]:
        if scored_blocks is None:
            raise ValueError("scored_blocks must be non-None.")
        n: int = int(len(scored_blocks))
        if n == 0:
            return []
        budget: int = int(max(0, target_budget))

        # Quick bounds.
        if self._estimate_param_count_from_prefix(scored_blocks, n) <= budget:
            return list(range(n))
        if self._estimate_param_count_from_prefix(scored_blocks, 0) > budget:
            return []

        lo: int = 0
        hi: int = n
        best: int = 0
        while lo <= hi:
            mid: int = (lo + hi) // 2
            cur: int = self._estimate_param_count_from_prefix(scored_blocks, mid)
            if cur <= budget:
                best = mid
                lo = mid + 1
            else:
                hi = mid - 1
        return list(range(int(best)))

    ## @brief Estimate approximate parameter count C(Θ_t; M_t) from active structure (Eq. 6).
    # @details Implements Sec 4.2 Eq. (6):
    #   C(Θ_t; M_t) ≈ d_m ∑_{i=1}^{n_L} (4 n_h^i · d_h + 2 n_f^i)
    # Then incorporates paper note for gated FFN (T5/LLaMA) by adding an extra +d_m∑ n_f^i term
    # (so total becomes ... + 3 n_f^i), and counts decoder cross-attention by adding an extra attention term
    # for each cross-attention block.
    # @param active_structure dict Active structure from MaskManager.compute_active_structure().
    # @return int Approximate parameter count.
    def estimate_parameter_count(self, active_structure: Dict[str, Any]) -> int:
        if active_structure is None or not isinstance(active_structure, dict):
            raise ValueError("active_structure must be a dict from MaskManager.compute_active_structure().")

        # Infer d_m from hidden_dimensions hard_active; choose the largest group deterministically.
        d_m: int = self._infer_current_hidden_dim(active_structure, use_dense=False)
        if d_m < 0:
            d_m = 0

        # Build per-layer counts.
        meta = self._build_dense_meta(active_structure) if self._dense_meta is None else self._dense_meta
        assert meta is not None

        # Current head/neuron activity (thresholded) from active_structure.
        attn_active: Dict[str, int] = self._current_head_active_counts(active_structure)
        ffn_active: Dict[str, int] = self._current_neuron_active_counts(active_structure)

        # Sum over layer keys: use self-attn and one FFN per layer key.
        sum_terms: float = 0.0
        sum_n_f: float = 0.0

        for lk in meta.layer_keys:
            gid_self = meta.attn_self_by_layer.get(lk, "")
            gid_ffn = meta.ffn_by_layer.get(lk, "")

            n_h: int = int(attn_active.get(gid_self, 0)) if gid_self else 0
            n_f: int = int(ffn_active.get(gid_ffn, 0)) if gid_ffn else 0

            d_h: float = 0.0
            if n_h > 0:
                d_h = float(d_m) / float(n_h)

            # eq: apt_param_count_approx_eq6
            sum_terms += (4.0 * float(n_h) * float(d_h) + 2.0 * float(n_f))
            sum_n_f += float(n_f)

        base_C: float = float(d_m) * float(sum_terms)

        # Gated FFN adjustment: factor 3 instead of 2 => add d_m * Σ n_f.
        extra_ffn: float = 0.0
        if meta.ffn_factor == 3:
            extra_ffn = float(d_m) * float(sum_n_f)

        # Cross-attention adjustment: add d_m * Σ (4 n_h^i d_h) for cross-attn blocks in decoder.
        extra_cross: float = 0.0
        for lk, gid_cross in meta.attn_cross_by_layer.items():
            n_hc: int = int(attn_active.get(gid_cross, 0)) if gid_cross else 0
            d_hc: float = float(d_m) / float(n_hc) if n_hc > 0 else 0.0
            extra_cross += float(d_m) * (4.0 * float(n_hc) * float(d_hc))

        total: float = base_C + extra_ffn + extra_cross
        if not math.isfinite(total) or total < 0.0:
            total = 0.0
        return int(math.floor(total))

    # ------------------------- Internal helpers -------------------------

    ## @brief Iterate attention group ids by parsing registry module names.
    # @return list[str] Attention group ids inferred from module names.
    def _iter_attention_gids_from_registry(self) -> List[str]:
        gids: List[str] = []
        for name, module in self._registry.named_modules():
            meta = module.collect_structure_metadata()
            group = str(meta.get("group_name", "")).strip().lower()
            if group in ("attn_q", "attn_v"):
                gid = name.rsplit(".", 1)[0]
                gids.append(gid)
        return sorted(list(set(gids)))

    ## @brief Determine whether there is any usable salience signal.
    # @param block_scores dict[str, dict[str, torch.Tensor]] SalienceCollector.get_block_scores() output.
    # @return bool True if any tensor has a non-zero finite entry.
    def _has_any_salience_signal(self, block_scores: Dict[str, Dict[str, torch.Tensor]]) -> bool:
        if not isinstance(block_scores, dict) or len(block_scores) == 0:
            return False
        total_abs: float = 0.0
        for _, io in block_scores.items():
            if not isinstance(io, dict):
                continue
            for key in ("input", "output"):
                t = io.get(key, None)
                if torch.is_tensor(t):
                    x = torch.nan_to_num(t.detach().float(), nan=0.0, posinf=0.0, neginf=0.0)
                    total_abs += float(x.abs().sum().item())
        return total_abs > 0.0

    ## @brief Return retain-all mapping for current structure (no pruning update).
    # @param active_structure dict Active structure from MaskManager.
    # @return dict[str, list[int]] Retain indices for all mask groups.
    def _retain_all(self, active_structure: Dict[str, Any]) -> Dict[str, List[int]]:
        out: Dict[str, List[int]] = {}
        # Hidden dims
        hid = active_structure.get("hidden_dimensions", {})
        if isinstance(hid, dict) and "hidden_dimensions" in self._enabled_blocks_set and len(hid) > 0:
            # Retain full index range for the largest group (indices are clamped by MaskManager).
            max_size = 0
            for _, v in hid.items():
                if isinstance(v, dict):
                    max_size = max(max_size, int(v.get("size", 0)))
            out["hidden_dimensions"] = list(range(int(max_size)))

        # Heads
        attn = active_structure.get("attention_heads", {})
        if isinstance(attn, dict) and "attention_heads" in self._enabled_blocks_set:
            for gid, v in attn.items():
                if not isinstance(v, dict):
                    continue
                nh = int(v.get("num_heads", 0))
                out[f"attention_heads:{gid}"] = list(range(int(nh)))

        # Neurons
        ffn = active_structure.get("ffn_neurons", {})
        if isinstance(ffn, dict) and "ffn_neurons" in self._enabled_blocks_set:
            for gid, v in ffn.items():
                if not isinstance(v, dict):
                    continue
                nn_ = int(v.get("num_neurons", v.get("num_neurons", 0)) or v.get("num_neurons", 0))
                if nn_ <= 0:
                    nn_ = int(v.get("num_neurons", 0))
                if nn_ <= 0:
                    nn_ = int(v.get("num_neurons", 0))
                nn_ = int(v.get("num_neurons", v.get("num_neurons", nn_)))
                # MaskManager uses "num_neurons" in compute_active_structure.
                nn_ = int(v.get("num_neurons", nn_))
                out[f"ffn_neurons:{gid}"] = list(range(int(nn_)))
        return out

    ## @brief Fill missing group keys in retain_ids with retain-all to avoid accidental full pruning of a group.
    # @param retain_ids dict[str, list[int]] Current retain mapping.
    # @param active_structure dict Active structure from MaskManager.
    # @return dict[str, list[int]] Completed retain mapping.
    def _fill_missing_groups_with_retain_all(
        self, retain_ids: Dict[str, List[int]], active_structure: Dict[str, Any]
    ) -> Dict[str, List[int]]:
        completed: Dict[str, List[int]] = dict(retain_ids)

        # Hidden dims
        if "hidden_dimensions" in self._enabled_blocks_set:
            if "hidden_dimensions" not in completed:
                hid = active_structure.get("hidden_dimensions", {})
                max_size = 0
                if isinstance(hid, dict):
                    for _, v in hid.items():
                        if isinstance(v, dict):
                            max_size = max(max_size, int(v.get("size", 0)))
                completed["hidden_dimensions"] = list(range(int(max_size)))

        # Heads
        if "attention_heads" in self._enabled_blocks_set:
            attn = active_structure.get("attention_heads", {})
            if isinstance(attn, dict):
                for gid, v in attn.items():
                    if not isinstance(v, dict):
                        continue
                    key = f"attention_heads:{gid}"
                    if key not in completed:
                        nh = int(v.get("num_heads", 0))
                        completed[key] = list(range(int(nh)))

        # Neurons
        if "ffn_neurons" in self._enabled_blocks_set:
            ffn = active_structure.get("ffn_neurons", {})
            if isinstance(ffn, dict):
                for gid, v in ffn.items():
                    if not isinstance(v, dict):
                        continue
                    key = f"ffn_neurons:{gid}"
                    if key not in completed:
                        nn_ = int(v.get("num_neurons", 0))
                        completed[key] = list(range(int(nn_)))

        return completed

    ## @brief Aggregate per-head salience vectors by attention group id.
    # @param block_scores dict[str, dict[str, torch.Tensor]] Salience per module input/output.
    # @param active_structure dict Active structure from MaskManager.
    # @return dict[str, torch.Tensor] gid -> 1D salience vector length num_heads (CPU float32).
    def _aggregate_head_salience(
        self, block_scores: Dict[str, Dict[str, torch.Tensor]], active_structure: Dict[str, Any]
    ) -> Dict[str, torch.Tensor]:
        out: Dict[str, torch.Tensor] = {}

        attn_struct = active_structure.get("attention_heads", {})
        if not isinstance(attn_struct, dict) or "attention_heads" not in self._enabled_blocks_set:
            return out

        # Build module meta once.
        module_meta: Dict[str, Dict[str, Any]] = {}
        for name, module in self._registry.named_modules():
            module_meta[name] = module.collect_structure_metadata()

        for module_name, io in block_scores.items():
            meta = module_meta.get(module_name, {})
            group = str(meta.get("group_name", "")).strip().lower()
            if group not in ("attn_q", "attn_v"):
                continue
            if not isinstance(io, dict):
                continue
            s_out = io.get("output", None)
            if not torch.is_tensor(s_out) or s_out.ndim != 1:
                continue

            gid = module_name.rsplit(".", 1)[0]
            ginfo = attn_struct.get(gid, None)
            if not isinstance(ginfo, dict):
                continue
            num_heads_total = int(ginfo.get("num_heads", 0))
            if num_heads_total <= 0:
                continue

            out_dim = int(s_out.numel())
            if out_dim % num_heads_total != 0:
                continue
            head_dim = out_dim // num_heads_total

            s = torch.nan_to_num(s_out.detach().float().cpu(), nan=0.0, posinf=0.0, neginf=0.0)
            s_heads = s.reshape(num_heads_total, head_dim).sum(dim=1)

            if gid not in out:
                out[gid] = s_heads
            else:
                out[gid] = out[gid] + s_heads

        # Ensure deterministic ordering and types.
        for gid in list(out.keys()):
            out[gid] = out[gid].to(dtype=torch.float32, device="cpu")
        return out

    ## @brief Infer FFN direction ("up"/"down") from module name.
    # @param module_name str Fully-qualified module name.
    # @return str Direction label.
    def _infer_ffn_direction(self, module_name: str) -> str:
        s = (module_name or "").lower()
        if ".intermediate.dense" in s:
            return "up"
        if ".output.dense" in s and ".attention.output.dense" not in s:
            return "down"
        if "densereLudense".lower() in s:
            # T5: wi/wi_0/wi_1 are up, wo is down
            if any(tok in s for tok in (".wi", ".wi_0", ".wi_1")):
                return "up"
            if s.endswith(".wo") or ".wo" in s:
                return "down"
        if any(tok in s for tok in ("up_proj", "gate_proj")):
            return "up"
        if "down_proj" in s:
            return "down"
        return "unknown"

    ## @brief Infer FFN group id for neuron-mask sharing (per layer).
    # @param module_name str Fully-qualified module name.
    # @return str FFN group id.
    def _infer_ffn_group_id(self, module_name: str) -> str:
        # Mirror MaskManager logic: group by layer prefix.
        for token in (".intermediate.", ".output."):
            if token in module_name:
                return module_name.split(token, 1)[0]
        token = ".DenseReluDense."
        if token in module_name:
            return module_name.split(token, 1)[0]
        m = re.search(r"(.+\.(layer|layers|block)\.\d+)", module_name)
        if m is not None:
            return str(m.group(1))
        return module_name.rsplit(".", 1)[0]

    ## @brief Aggregate per-neuron salience vectors by FFN group id.
    # @param block_scores dict[str, dict[str, torch.Tensor]] Salience per module input/output.
    # @param active_structure dict Active structure from MaskManager.
    # @return dict[str, torch.Tensor] ffn_gid -> 1D salience vector length num_neurons (CPU float32).
    def _aggregate_neuron_salience(
        self, block_scores: Dict[str, Dict[str, torch.Tensor]], active_structure: Dict[str, Any]
    ) -> Dict[str, torch.Tensor]:
        out: Dict[str, torch.Tensor] = {}

        ffn_struct = active_structure.get("ffn_neurons", {})
        if not isinstance(ffn_struct, dict) or "ffn_neurons" not in self._enabled_blocks_set:
            return out

        # Build module meta once.
        module_meta: Dict[str, Dict[str, Any]] = {}
        for name, module in self._registry.named_modules():
            module_meta[name] = module.collect_structure_metadata()

        for module_name, io in block_scores.items():
            if not isinstance(io, dict):
                continue
            meta = module_meta.get(module_name, {})
            group = str(meta.get("group_name", "")).strip().lower()
            # FFN adapters are in group_name == "ffn" (from injector).
            if group != "ffn":
                continue

            ffn_gid = self._infer_ffn_group_id(module_name)
            ginfo = ffn_struct.get(ffn_gid, None)
            if not isinstance(ginfo, dict):
                continue
            num_neurons_total = int(ginfo.get("num_neurons", 0))
            if num_neurons_total <= 0:
                continue

            direction = self._infer_ffn_direction(module_name)
            vec: Optional[torch.Tensor] = None
            if direction == "up":
                vec = io.get("output", None)
            elif direction == "down":
                vec = io.get("input", None)
            else:
                # Fallback: use the longer side.
                a = io.get("input", None)
                b = io.get("output", None)
                if torch.is_tensor(a) and torch.is_tensor(b):
                    vec = a if int(a.numel()) >= int(b.numel()) else b
                elif torch.is_tensor(a):
                    vec = a
                elif torch.is_tensor(b):
                    vec = b

            if not torch.is_tensor(vec) or vec.ndim != 1:
                continue

            v = torch.nan_to_num(vec.detach().float().cpu(), nan=0.0, posinf=0.0, neginf=0.0)
            if int(v.numel()) != num_neurons_total:
                # If module salience length doesn't match mask length, skip (inconsistent).
                continue

            if ffn_gid not in out:
                out[ffn_gid] = v
            else:
                out[ffn_gid] = out[ffn_gid] + v

        for gid in list(out.keys()):
            out[gid] = out[gid].to(dtype=torch.float32, device="cpu")
        return out

    ## @brief Aggregate per-hidden-dimension salience vector.
    # @details Hidden-dim salience sums salience over all module input/output vectors whose length equals d_model.
    # @param block_scores dict[str, dict[str, torch.Tensor]] Salience per module input/output.
    # @param active_structure dict Active structure from MaskManager.
    # @return torch.Tensor 1D salience vector of length d_model (CPU float32).
    def _aggregate_hidden_dim_salience(
        self, block_scores: Dict[str, Dict[str, torch.Tensor]], active_structure: Dict[str, Any]
    ) -> torch.Tensor:
        if "hidden_dimensions" not in self._enabled_blocks_set:
            return torch.zeros((0,), dtype=torch.float32)

        d_model_dense: int = self._infer_current_hidden_dim(active_structure, use_dense=True)
        if d_model_dense <= 0:
            return torch.zeros((0,), dtype=torch.float32)

        acc = torch.zeros((d_model_dense,), dtype=torch.float32)
        for _, io in block_scores.items():
            if not isinstance(io, dict):
                continue
            for key in ("input", "output"):
                v = io.get(key, None)
                if not torch.is_tensor(v) or v.ndim != 1:
                    continue
                if int(v.numel()) != int(d_model_dense):
                    continue
                x = torch.nan_to_num(v.detach().float().cpu(), nan=0.0, posinf=0.0, neginf=0.0)
                acc = acc + x
        return acc.to(dtype=torch.float32, device="cpu")

    ## @brief Build the list of BlockScore entries (heads, neurons, hidden dims) with densities.
    # @param head_salience dict[str, torch.Tensor] gid -> per-head salience vector.
    # @param neuron_salience dict[str, torch.Tensor] ffn_gid -> per-neuron salience vector.
    # @param hidden_salience torch.Tensor Per-hidden-dimension salience vector.
    # @param active_structure dict Active structure from MaskManager.
    # @return list[BlockScore] Flat block list for sorting and binary search.
    def _build_scored_blocks(
        self,
        head_salience: Dict[str, torch.Tensor],
        neuron_salience: Dict[str, torch.Tensor],
        hidden_salience: torch.Tensor,
        active_structure: Dict[str, Any],
    ) -> List[BlockScore]:
        meta = self._dense_meta
        if meta is None:
            meta = self._build_dense_meta(active_structure)
            self._dense_meta = meta

        d_m_active: int = self._infer_current_hidden_dim(active_structure, use_dense=False)
        if d_m_active < 0:
            d_m_active = 0

        # For Eq. (12) we need n_L and n_f (use dense totals for block sizes).
        n_L: int = int(len(meta.layer_keys))
        n_f: int = int(self._infer_dense_ffn_width(meta))
        n_cross_layers: int = int(len(meta.attn_cross_by_layer))

        scored: List[BlockScore] = []

        # Hidden dimension blocks.
        if "hidden_dimensions" in self._enabled_blocks_set and torch.is_tensor(hidden_salience) and hidden_salience.numel() > 0:
            # eq: apt_block_param_dimension_eq12
            # C_dimension = n_L × (4 d_m + 2 n_f) = 110592 for RoBERTa-base (n_L=12,d_m=768,n_f=3072)
            C_dimension_base: int = int(n_L * (4 * d_m_active + 2 * n_f))
            # Gated FFN extra: + n_L * n_f (so 3*n_f in parentheses).
            extra_dim_ffn: int = int(n_L * n_f) if meta.ffn_factor == 3 else 0
            # Cross-attn extra: per decoder layer add another (4*d_m) per hidden dim.
            extra_dim_cross: int = int(n_cross_layers * (4 * d_m_active)) if n_cross_layers > 0 else 0
            C_dimension: int = int(C_dimension_base + extra_dim_ffn + extra_dim_cross)
            C_dimension = max(1, C_dimension)

            hs = torch.nan_to_num(hidden_salience.detach().float().cpu(), nan=0.0, posinf=0.0, neginf=0.0)
            for j in range(int(hs.numel())):
                sal = float(hs[j].item())
                dens = float(sal) / float(C_dimension)
                scored.append(
                    BlockScore(
                        block_id=f"hidden_dimensions:{j}",
                        group="hidden_dimensions",
                        block_type="hidden_dim",
                        salience=sal,
                        param_count=int(C_dimension),
                        density=dens,
                    )
                )

        # Attention head blocks.
        if "attention_heads" in self._enabled_blocks_set:
            attn_struct = active_structure.get("attention_heads", {})
            if isinstance(attn_struct, dict):
                for gid, v in attn_struct.items():
                    if not isinstance(v, dict):
                        continue
                    n_h_total = int(v.get("num_heads", 0))
                    if n_h_total <= 0:
                        continue

                    hs = head_salience.get(gid, None)
                    if hs is None:
                        hs = torch.zeros((n_h_total,), dtype=torch.float32)
                    else:
                        if int(hs.numel()) != n_h_total:
                            hs = torch.zeros((n_h_total,), dtype=torch.float32)

                    # eq: apt_block_param_head_eq10
                    # C_head = 4 × d_m × d_m / n_h = 196608 for RoBERTa-base (d_m=768,n_h=12)
                    C_head: int = int(4 * d_m_active * d_m_active / n_h_total)
                    C_head = max(1, C_head)

                    hs = torch.nan_to_num(hs.detach().float().cpu(), nan=0.0, posinf=0.0, neginf=0.0)
                    for j in range(int(n_h_total)):
                        sal = float(hs[j].item())
                        dens = float(sal) / float(C_head)
                        scored.append(
                            BlockScore(
                                block_id=f"attention_heads:{gid}:{j}",
                                group=f"attention_heads:{gid}",
                                block_type="head",
                                salience=sal,
                                param_count=int(C_head),
                                density=dens,
                            )
                        )

        # FFN neuron blocks.
        if "ffn_neurons" in self._enabled_blocks_set:
            ffn_struct = active_structure.get("ffn_neurons", {})
            if isinstance(ffn_struct, dict):
                for gid, v in ffn_struct.items():
                    if not isinstance(v, dict):
                        continue
                    n_neurons_total = int(v.get("num_neurons", 0))
                    if n_neurons_total <= 0:
                        continue

                    ns = neuron_salience.get(gid, None)
                    if ns is None:
                        ns = torch.zeros((n_neurons_total,), dtype=torch.float32)
                    else:
                        if int(ns.numel()) != n_neurons_total:
                            ns = torch.zeros((n_neurons_total,), dtype=torch.float32)

                    # eq: apt_block_param_neuron_eq11
                    # C_neuron = 2 × d_m = 1536 for RoBERTa-base (d_m=768)
                    C_neuron_base: int = int(2 * d_m_active)
                    extra_neuron: int = int(d_m_active) if meta.ffn_factor == 3 else 0
                    C_neuron: int = int(C_neuron_base + extra_neuron)
                    C_neuron = max(1, C_neuron)

                    ns = torch.nan_to_num(ns.detach().float().cpu(), nan=0.0, posinf=0.0, neginf=0.0)
                    for j in range(int(n_neurons_total)):
                        sal = float(ns[j].item())
                        dens = float(sal) / float(C_neuron)
                        scored.append(
                            BlockScore(
                                block_id=f"ffn_neurons:{gid}:{j}",
                                group=f"ffn_neurons:{gid}",
                                block_type="neuron",
                                salience=sal,
                                param_count=int(C_neuron),
                                density=dens,
                            )
                        )

        return scored

    ## @brief Parse a BlockScore into (mask_group_key, index).
    # @param block_id str BlockScore.block_id.
    # @param group str BlockScore.group.
    # @param block_type str BlockScore.block_type.
    # @return tuple[str, int] (mask group key, index).
    def _parse_block_id_to_group_and_index(self, block_id: str, group: str, block_type: str) -> Tuple[str, int]:
        bt = (block_type or "").strip().lower()
        if bt == "hidden_dim":
            # block_id = "hidden_dimensions:<idx>"
            parts = (block_id or "").split(":")
            if len(parts) != 2:
                raise ValueError(f"Invalid hidden_dim block_id: {block_id!r}")
            return "hidden_dimensions", int(parts[1])

        if bt == "head":
            # group already "attention_heads:<gid>", block_id "attention_heads:<gid>:<idx>"
            parts = (block_id or "").split(":")
            if len(parts) < 3:
                raise ValueError(f"Invalid head block_id: {block_id!r}")
            return str(group), int(parts[-1])

        if bt == "neuron":
            parts = (block_id or "").split(":")
            if len(parts) < 3:
                raise ValueError(f"Invalid neuron block_id: {block_id!r}")
            return str(group), int(parts[-1])

        raise ValueError(f"Unsupported block_type for parsing: {block_type!r}")

    ## @brief Estimate remaining parameter count for top-k blocks in scored_blocks.
    # @details Computes counts of retained heads/neurons/dims from the prefix, then plugs them into
    # Eq.(6) + gated/cross adjustments consistently with estimate_parameter_count().
    # @param scored_blocks list[BlockScore] Sorted blocks.
    # @param k int Prefix length.
    # @return int Estimated remaining parameter count.
    def _estimate_param_count_from_prefix(self, scored_blocks: List[BlockScore], k: int) -> int:
        if self._dense_meta is None:
            # Require structure info; derive from current mask manager.
            self._mask_manager.initialize_masks()
            self._dense_meta = self._build_dense_meta(self._mask_manager.compute_active_structure())
        meta = self._dense_meta
        assert meta is not None

        kk: int = int(max(0, min(int(k), int(len(scored_blocks)))))

        # Retained counts by group.
        retained_hidden_dims: int = 0
        retained_heads: Dict[str, int] = {}
        retained_neurons: Dict[str, int] = {}

        for i in range(kk):
            b = scored_blocks[i]
            bt = (b.block_type or "").strip().lower()
            if bt == "hidden_dim":
                retained_hidden_dims += 1
            elif bt == "head":
                # group is "attention_heads:<gid>"
                gid = b.group.split("attention_heads:", 1)[1] if "attention_heads:" in b.group else ""
                if gid:
                    retained_heads[gid] = int(retained_heads.get(gid, 0) + 1)
            elif bt == "neuron":
                gid = b.group.split("ffn_neurons:", 1)[1] if "ffn_neurons:" in b.group else ""
                if gid:
                    retained_neurons[gid] = int(retained_neurons.get(gid, 0) + 1)

        # If hidden dim pruning is disabled, keep dense d_model; else use retained count.
        d_m: int = int(meta.d_model)
        if "hidden_dimensions" in self._enabled_blocks_set:
            d_m = int(retained_hidden_dims)

        # Use dense totals if a block type is disabled.
        if "attention_heads" not in self._enabled_blocks_set:
            retained_heads = dict(meta.attn_num_heads_total)
        if "ffn_neurons" not in self._enabled_blocks_set:
            retained_neurons = dict(meta.ffn_num_neurons_total)

        # Per-layer sum per Eq.(6) over self-attn and one FFN block.
        sum_terms: float = 0.0
        sum_n_f: float = 0.0
        for lk in meta.layer_keys:
            gid_self = meta.attn_self_by_layer.get(lk, "")
            gid_ffn = meta.ffn_by_layer.get(lk, "")

            n_h: int = int(retained_heads.get(gid_self, 0)) if gid_self else 0
            n_f: int = int(retained_neurons.get(gid_ffn, 0)) if gid_ffn else 0

            d_h: float = float(d_m) / float(n_h) if n_h > 0 else 0.0
            # eq: apt_param_count_approx_eq6
            sum_terms += (4.0 * float(n_h) * float(d_h) + 2.0 * float(n_f))
            sum_n_f += float(n_f)

        base_C: float = float(d_m) * float(sum_terms)

        extra_ffn: float = 0.0
        if meta.ffn_factor == 3:
            extra_ffn = float(d_m) * float(sum_n_f)

        extra_cross: float = 0.0
        for lk, gid_cross in meta.attn_cross_by_layer.items():
            n_hc: int = int(retained_heads.get(gid_cross, 0)) if gid_cross else 0
            d_hc: float = float(d_m) / float(n_hc) if n_hc > 0 else 0.0
            extra_cross += float(d_m) * (4.0 * float(n_hc) * float(d_hc))

        total: float = base_C + extra_ffn + extra_cross
        if not math.isfinite(total) or total < 0.0:
            total = 0.0
        return int(math.floor(total))

    ## @brief Infer current hidden dimension count from active_structure.
    # @param active_structure dict Active structure.
    # @param use_dense bool If True, returns dense size; else returns hard_active count.
    # @return int Hidden size count.
    def _infer_current_hidden_dim(self, active_structure: Dict[str, Any], use_dense: bool) -> int:
        hid = active_structure.get("hidden_dimensions", {})
        if not isinstance(hid, dict) or len(hid) == 0:
            return 0
        # Choose the largest hidden group deterministically by dense size.
        best_size = -1
        best_val = 0
        for _, v in hid.items():
            if not isinstance(v, dict):
                continue
            size = int(v.get("size", 0))
            hard = int(v.get("hard_active", 0))
            if size > best_size:
                best_size = size
                best_val = size if use_dense else hard
        return int(best_val)

    ## @brief Build dense meta from active structure (uses mask vector lengths, not hard_active).
    # @param active_structure dict Active structure from MaskManager.
    # @return _StructureMeta Parsed dense meta.
    def _build_dense_meta(self, active_structure: Dict[str, Any]) -> _StructureMeta:
        d_model = self._infer_current_hidden_dim(active_structure, use_dense=True)

        # Attention groups.
        attn_struct = active_structure.get("attention_heads", {})
        attn_num_heads_total: Dict[str, int] = {}
        attn_self_by_layer: Dict[str, str] = {}
        attn_cross_by_layer: Dict[str, str] = {}

        if isinstance(attn_struct, dict):
            # Stable fallback rank for missing layer_index.
            fallback_rank = 0
            for gid in sorted(attn_struct.keys()):
                v = attn_struct[gid]
                if not isinstance(v, dict):
                    continue
                nh_total = int(v.get("num_heads", 0))
                attn_num_heads_total[gid] = int(nh_total)

                side = _infer_side(gid)
                layer_idx = int(v.get("layer_index", _extract_layer_index(gid)))
                lk = _layer_key(side, layer_idx, fallback_rank)
                fallback_rank += 1

                if _is_cross_attention_gid(gid):
                    # Cross-attn only expected for decoder layers.
                    attn_cross_by_layer[lk] = gid
                else:
                    attn_self_by_layer[lk] = gid

        # FFN groups.
        ffn_struct = active_structure.get("ffn_neurons", {})
        ffn_num_neurons_total: Dict[str, int] = {}
        ffn_by_layer: Dict[str, str] = {}

        if isinstance(ffn_struct, dict):
            fallback_rank = 0
            for gid in sorted(ffn_struct.keys()):
                v = ffn_struct[gid]
                if not isinstance(v, dict):
                    continue
                nn_total = int(v.get("num_neurons", 0))
                ffn_num_neurons_total[gid] = int(nn_total)

                side = _infer_side(gid)
                layer_idx = int(v.get("layer_index", _extract_layer_index(gid)))
                lk = _layer_key(side, layer_idx, fallback_rank)
                fallback_rank += 1
                ffn_by_layer[lk] = gid

        # Layer keys: union of attention self-attn layers and FFN layers; keep stable order.
        layer_keys_set = set(list(attn_self_by_layer.keys()) + list(ffn_by_layer.keys()))
        layer_keys = sorted(list(layer_keys_set), key=lambda x: (x.split(":")[0], int(x.split(":")[1])))

        # Determine FFN factor: gated (3) vs non-gated (2).
        ffn_factor = 3 if self._ffn_is_gated else 2

        return _StructureMeta(
            d_model=int(d_model),
            layer_keys=layer_keys,
            attn_self_by_layer=attn_self_by_layer,
            attn_cross_by_layer=attn_cross_by_layer,
            ffn_by_layer=ffn_by_layer,
            attn_num_heads_total=attn_num_heads_total,
            ffn_num_neurons_total=ffn_num_neurons_total,
            ffn_factor=int(ffn_factor),
        )

    ## @brief Create a dense-version active_structure dict with hard_active set to size totals.
    # @param active_structure dict Current active structure.
    # @return dict Dense active structure copy.
    def _make_dense_active_structure(self, active_structure: Dict[str, Any]) -> Dict[str, Any]:
        dense = {k: v for k, v in active_structure.items()}
        # Hidden dims
        hid = dense.get("hidden_dimensions", {})
        if isinstance(hid, dict):
            new_hid: Dict[str, Any] = {}
            for hk, v in hid.items():
                if not isinstance(v, dict):
                    continue
                vv = dict(v)
                vv["hard_active"] = int(vv.get("size", vv.get("hard_active", 0)))
                new_hid[hk] = vv
            dense["hidden_dimensions"] = new_hid
        # Heads
        attn = dense.get("attention_heads", {})
        if isinstance(attn, dict):
            new_attn: Dict[str, Any] = {}
            for gid, v in attn.items():
                if not isinstance(v, dict):
                    continue
                vv = dict(v)
                vv["hard_active"] = int(vv.get("num_heads", vv.get("hard_active", 0)))
                new_attn[gid] = vv
            dense["attention_heads"] = new_attn
        # Neurons
        ffn = dense.get("ffn_neurons", {})
        if isinstance(ffn, dict):
            new_ffn: Dict[str, Any] = {}
            for gid, v in ffn.items():
                if not isinstance(v, dict):
                    continue
                vv = dict(v)
                vv["hard_active"] = int(vv.get("num_neurons", vv.get("hard_active", 0)))
                new_ffn[gid] = vv
            dense["ffn_neurons"] = new_ffn
        return dense

    ## @brief Infer a representative dense FFN width n_f from dense meta (max over groups).
    # @param meta _StructureMeta Dense structure meta.
    # @return int Representative n_f.
    def _infer_dense_ffn_width(self, meta: _StructureMeta) -> int:
        if meta is None:
            return 0
        if len(meta.ffn_num_neurons_total) == 0:
            return 0
        return int(max(int(v) for v in meta.ffn_num_neurons_total.values()))

    ## @brief Get current active head counts per gid from active_structure.
    # @param active_structure dict Active structure.
    # @return dict[str, int] gid -> hard_active head count.
    def _current_head_active_counts(self, active_structure: Dict[str, Any]) -> Dict[str, int]:
        out: Dict[str, int] = {}
        attn = active_structure.get("attention_heads", {})
        if not isinstance(attn, dict):
            return out
        for gid, v in attn.items():
            if isinstance(v, dict):
                out[gid] = int(v.get("hard_active", 0))
        return out

    ## @brief Get current active neuron counts per ffn_gid from active_structure.
    # @param active_structure dict Active structure.
    # @return dict[str, int] ffn_gid -> hard_active neuron count.
    def _current_neuron_active_counts(self, active_structure: Dict[str, Any]) -> Dict[str, int]:
        out: Dict[str, int] = {}
        ffn = active_structure.get("ffn_neurons", {})
        if not isinstance(ffn, dict):
            return out
        for gid, v in ffn.items():
            if isinstance(v, dict):
                out[gid] = int(v.get("hard_active", 0))
        return out
