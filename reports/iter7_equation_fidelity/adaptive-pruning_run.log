## src/training/callbacks.py
from __future__ import annotations

import json
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

from src.config import ExperimentConfig
from src.utils.logging import get_logger, save_json


## @brief Return a UNIX timestamp in seconds.
# @param now_s float Optional precomputed timestamp (time.time()).
# @return float Timestamp in seconds.
def _unix_time_s(now_s: float = 0.0) -> float:
    if now_s and now_s > 0.0:
        return float(now_s)
    return float(time.time())


## @brief Determine if a metric should be maximized (higher is better) or minimized (lower is better).
# @details Paper model-selection uses task performance metrics (accuracy/F1/ROUGE/Avg) where higher is better.
# Efficiency metrics (time/memory) are lower-is-better but should not be used as "best checkpoint" unless
# explicitly provided as the first metric key in evaluation.metrics.
# @param metric_key str Metric key.
# @return bool True if higher-is-better else False.
def _is_higher_better(metric_key: str) -> bool:
    key: str = (metric_key or "").strip().lower()
    if not key:
        return True

    # Common "lower is better" keys.
    if "loss" in key:
        return False
    if "error" in key:
        return False
    if "time" in key:
        return False
    if "mem" in key:
        return False
    if "latency" in key:
        return False

    # Common "higher is better" keys (task metrics).
    if "acc" in key or "accuracy" in key:
        return True
    if key in ("f1", "em", "exact_match"):
        return True
    if key.startswith("rouge") or key in ("rouge1", "rouge2", "rougel"):
        return True
    if "throughput" in key or "speedup" in key:
        return True

    # Default to higher-is-better for task performance.
    return True


## @brief Decide whether a step interval condition is met.
# @param global_step int Current global step.
# @param interval int Interval in steps (<=0 disables).
# @param always_on_step0 bool Whether to trigger on global_step==0 when interval>0.
# @return bool True if condition met.
def _should_trigger_interval(global_step: int, interval: int, always_on_step0: bool) -> bool:
    step: int = int(global_step)
    iv: int = int(interval)
    if iv <= 0:
        return False
    if step == 0:
        return bool(always_on_step0)
    return (step % iv) == 0


## @brief Simple record describing the current "best checkpoint" state.
@dataclass
class BestCheckpointState:
    ## @brief Initialize BestCheckpointState.
    # @param best_checkpoint str Best checkpoint path (empty if none yet).
    # @param best_metric float Best metric value.
    # @param best_step int Global step where best was achieved.
    # @param best_stage str Stage name (e.g., "pruning" or "recovery").
    # @param metric_key str Primary metric key used for selection.
    # @param higher_is_better bool Whether higher values are better for this metric.
    def __init__(
        self,
        best_checkpoint: str = "",
        best_metric: float = float("-inf"),
        best_step: int = -1,
        best_stage: str = "",
        metric_key: str = "",
        higher_is_better: bool = True,
    ) -> None:
        self.best_checkpoint = str(best_checkpoint)
        self.best_metric = float(best_metric)
        self.best_step = int(best_step)
        self.best_stage = str(best_stage)
        self.metric_key = str(metric_key)
        self.higher_is_better = bool(higher_is_better)

    best_checkpoint: str
    best_metric: float
    best_step: int
    best_stage: str
    metric_key: str
    higher_is_better: bool


## @brief Optional early stopping controller (default disabled).
# @details Paper uses fixed epochs; this is only active if patience_evals > 0 is explicitly provided.
class EarlyStoppingController:
    ## @brief Initialize EarlyStoppingController.
    # @param patience_evals int Number of evaluations without improvement before stopping (<=0 disables).
    # @param min_delta float Minimum improvement required to reset patience.
    # @param higher_is_better bool Direction for improvement.
    def __init__(self, patience_evals: int = 0, min_delta: float = 0.0, higher_is_better: bool = True) -> None:
        self._patience_evals: int = int(patience_evals)
        self._min_delta: float = float(min_delta)
        self._higher_is_better: bool = bool(higher_is_better)

        self._num_bad_evals: int = 0
        self._stopped: bool = False

    ## @brief Update early stopping state based on whether the latest eval improved.
    # @param improved bool Whether the evaluation improved the monitored metric.
    # @return None
    def update(self, improved: bool) -> None:
        if self._patience_evals <= 0:
            return
        if improved:
            self._num_bad_evals = 0
            return
        self._num_bad_evals += 1
        if self._num_bad_evals >= self._patience_evals:
            self._stopped = True

    ## @brief Whether early stopping has been triggered.
    # @return bool True if stop requested.
    def should_stop(self) -> bool:
        if self._patience_evals <= 0:
            return False
        return bool(self._stopped)


## @brief Callback handler coordinating evaluation/checkpoint schedules and best-checkpoint tracking.
# @details This module is intentionally "thin": it never computes APT math, and only coordinates
# *when* to evaluate/save and *how* to record best checkpoints and metrics artifacts.
class CallbackHandler:
    ## @brief Initialize CallbackHandler from experiment config.
    # @param config ExperimentConfig Effective experiment configuration (already validated).
    def __init__(self, config: ExperimentConfig) -> None:
        if config is None:
            raise ValueError("config must be non-None.")
        self._cfg: ExperimentConfig = config
        self._logger = get_logger("apt.callbacks")

        self._output_dir: Path = Path(str(self._cfg.runtime.output_dir))
        self._checkpoints_dir: Path = self._output_dir / "checkpoints"
        self._logs_dir: Path = self._output_dir / "logs"
        self._metrics_jsonl_path: Path = self._logs_dir / "metrics.jsonl"
        self._events_jsonl_path: Path = self._logs_dir / "events.jsonl"
        self._best_state_path: Path = self._checkpoints_dir / "best_checkpoint.json"

        self._checkpoints_dir.mkdir(parents=True, exist_ok=True)
        self._logs_dir.mkdir(parents=True, exist_ok=True)

        # Scheduling intervals (0 disables).
        self._eval_every_steps: int = int(self._cfg.training.eval_every_steps or 0)
        self._save_every_steps: int = int(self._cfg.training.save_every_steps or 0)

        # Primary metric selection: first entry in evaluation.metrics (design requirement).
        if not isinstance(self._cfg.evaluation.metrics, list) or len(self._cfg.evaluation.metrics) == 0:
            raise ValueError("evaluation.metrics must be a non-empty list (validated upstream).")
        self._primary_metric_key: str = str(self._cfg.evaluation.metrics[0])

        higher_is_better: bool = _is_higher_better(self._primary_metric_key)
        init_best: float = float("-inf") if higher_is_better else float("inf")
        self._best: BestCheckpointState = BestCheckpointState(
            best_checkpoint="",
            best_metric=init_best,
            best_step=-1,
            best_stage="",
            metric_key=self._primary_metric_key,
            higher_is_better=higher_is_better,
        )

        # Optional early stopping (default disabled because paper uses fixed epochs).
        # Since ExperimentConfig schema does not include early stopping fields, keep it disabled here.
        self._early_stop: EarlyStoppingController = EarlyStoppingController(
            patience_evals=0,
            min_delta=0.0,
            higher_is_better=higher_is_better,
        )

        # Persist initial state for reproducibility.
        self._persist_best_state()

    ## @brief Decide whether to run evaluation at this step.
    # @details Uses training.eval_every_steps (0 disables). Trainer can force evaluation via force=True.
    # @param global_step int Current global step.
    # @param force bool Force evaluation regardless of interval.
    # @param always_on_step0 bool Trigger at step 0 when interval > 0.
    # @return bool True if evaluation should run.
    def should_eval(self, global_step: int, force: bool = False, always_on_step0: bool = False) -> bool:
        if bool(force):
            return True
        return _should_trigger_interval(
            global_step=int(global_step),
            interval=int(self._eval_every_steps),
            always_on_step0=bool(always_on_step0),
        )

    ## @brief Decide whether to save a checkpoint at this step.
    # @details Uses training.save_every_steps (0 disables). Trainer can force saving via force=True.
    # @param global_step int Current global step.
    # @param force bool Force checkpoint save regardless of interval.
    # @param always_on_step0 bool Trigger at step 0 when interval > 0.
    # @return bool True if checkpoint should be saved.
    def should_save(self, global_step: int, force: bool = False, always_on_step0: bool = False) -> bool:
        if bool(force):
            return True
        return _should_trigger_interval(
            global_step=int(global_step),
            interval=int(self._save_every_steps),
            always_on_step0=bool(always_on_step0),
        )

    ## @brief Return the canonical directory for a step checkpoint.
    # @param global_step int Global step.
    # @return str Checkpoint directory path.
    def checkpoint_dir_for_step(self, global_step: int) -> str:
        step: int = int(global_step)
        out: Path = self._checkpoints_dir / f"step_{step}"
        return str(out)

    ## @brief Record an evaluation result, update best checkpoint tracking, and append to logs.
    # @details This method does not run evaluation itself; Trainer should call it after Evaluator.evaluate().
    # The callback may optionally associate metrics with a checkpoint path when one is saved.
    # @param global_step int Global step at which evaluation occurred.
    # @param stage str Stage identifier ("pruning" or "recovery", per paper two-stage procedure).
    # @param metrics dict[str, float] Task metrics from evaluator.
    # @param checkpoint_path str | None Optional checkpoint path corresponding to these metrics.
    # @return bool True if this evaluation improved the best metric.
    def on_evaluate_end(
        self,
        global_step: int,
        stage: str,
        metrics: Dict[str, float],
        checkpoint_path: Optional[str] = None,
    ) -> bool:
        step: int = int(global_step)
        stage_s: str = str(stage or "")
        metrics_d: Dict[str, float] = dict(metrics or {})

        # Append eval metrics to JSONL for reproducibility.
        self._append_jsonl(
            path=self._metrics_jsonl_path,
            record={
                "type": "eval",
                "time_s": _unix_time_s(),
                "global_step": step,
                "stage": stage_s,
                "metrics": metrics_d,
                "primary_metric_key": self._primary_metric_key,
                "checkpoint_path": str(checkpoint_path) if checkpoint_path else "",
            },
        )

        # Update best tracking if primary metric exists.
        improved: bool = False
        if self._primary_metric_key in metrics_d:
            score: float = float(metrics_d[self._primary_metric_key])
            improved = self._update_best_if_improved(
                global_step=step, stage=stage_s, score=score, checkpoint_path=checkpoint_path
            )
        else:
            self._logger.warning(
                "Primary metric key %r missing from eval metrics at step=%d (available keys=%s).",
                self._primary_metric_key,
                step,
                sorted(list(metrics_d.keys())),
            )

        self._early_stop.update(improved=bool(improved))
        return bool(improved)

    ## @brief Record a checkpoint save event and write per-checkpoint metadata.
    # @details Trainer should call this after a successful Trainer.save_checkpoint(tag)->path.
    # @param global_step int Global step.
    # @param stage str Stage identifier ("pruning" or "recovery").
    # @param checkpoint_path str Path to checkpoint directory.
    # @param metrics_snapshot dict[str, float] | None Optional metrics snapshot at save time.
    # @return None
    def on_checkpoint_end(
        self,
        global_step: int,
        stage: str,
        checkpoint_path: str,
        metrics_snapshot: Optional[Dict[str, float]] = None,
    ) -> None:
        step: int = int(global_step)
        stage_s: str = str(stage or "")
        ckpt_path: str = str(checkpoint_path or "")
        snap: Dict[str, float] = dict(metrics_snapshot or {})

        # Write checkpoint metadata (sidecar JSON).
        ckpt_dir = Path(ckpt_path)
        ckpt_dir.mkdir(parents=True, exist_ok=True)
        meta_path = ckpt_dir / "metadata.json"
        save_json(
            meta_path,
            {
                "global_step": step,
                "stage": stage_s,
                "time_s": _unix_time_s(),
                "metrics_snapshot": snap,
                "primary_metric_key": self._primary_metric_key,
            },
        )

        # Append event record.
        self._append_jsonl(
            path=self._events_jsonl_path,
            record={
                "type": "checkpoint",
                "time_s": _unix_time_s(),
                "global_step": step,
                "stage": stage_s,
                "checkpoint_path": ckpt_path,
                "metrics_snapshot": snap,
            },
        )

    ## @brief Record a non-metric event (e.g., optimizer reset after shape change).
    # @param event_name str Event name.
    # @param global_step int Global step.
    # @param stage str Stage identifier.
    # @param extra dict[str, Any] | None Extra JSON-serializable fields.
    # @return None
    def on_event(self, event_name: str, global_step: int, stage: str, extra: Optional[Dict[str, Any]] = None) -> None:
        self._append_jsonl(
            path=self._events_jsonl_path,
            record={
                "type": "event",
                "event_name": str(event_name or ""),
                "time_s": _unix_time_s(),
                "global_step": int(global_step),
                "stage": str(stage or ""),
                "extra": dict(extra or {}),
            },
        )

    ## @brief Return current best-checkpoint state.
    # @return BestCheckpointState Best state snapshot.
    def best_state(self) -> BestCheckpointState:
        return BestCheckpointState(
            best_checkpoint=self._best.best_checkpoint,
            best_metric=self._best.best_metric,
            best_step=self._best.best_step,
            best_stage=self._best.best_stage,
            metric_key=self._best.metric_key,
            higher_is_better=self._best.higher_is_better,
        )

    ## @brief Whether early stopping should stop training (default False per paper).
    # @return bool True if early stop requested.
    def should_stop(self) -> bool:
        return bool(self._early_stop.should_stop())

    ## @brief Internal: update best state if improved.
    # @param global_step int Current global step.
    # @param stage str Stage string.
    # @param score float Primary metric value.
    # @param checkpoint_path str | None Checkpoint path to record as best (if provided).
    # @return bool True if improved.
    def _update_best_if_improved(
        self,
        global_step: int,
        stage: str,
        score: float,
        checkpoint_path: Optional[str],
    ) -> bool:
        improved: bool = False
        if self._best.higher_is_better:
            improved = float(score) > float(self._best.best_metric)
        else:
            improved = float(score) < float(self._best.best_metric)

        if not improved:
            return False

        # Update best. Prefer provided checkpoint_path; if none, keep best_checkpoint empty and only track metric.
        self._best.best_metric = float(score)
        self._best.best_step = int(global_step)
        self._best.best_stage = str(stage or "")
        if checkpoint_path is not None:
            self._best.best_checkpoint = str(checkpoint_path)

        self._persist_best_state()

        self._append_jsonl(
            path=self._events_jsonl_path,
            record={
                "type": "best_update",
                "time_s": _unix_time_s(),
                "global_step": int(global_step),
                "stage": str(stage or ""),
                "metric_key": self._primary_metric_key,
                "metric_value": float(score),
                "checkpoint_path": str(checkpoint_path) if checkpoint_path else "",
                "higher_is_better": bool(self._best.higher_is_better),
            },
        )

        self._logger.info(
            "New best | step=%d | stage=%s | %s=%.6g | ckpt=%s",
            int(global_step),
            str(stage or ""),
            self._primary_metric_key,
            float(score),
            str(checkpoint_path) if checkpoint_path else "",
        )
        return True

    ## @brief Persist best-checkpoint state to disk under checkpoints/best_checkpoint.json.
    # @return None
    def _persist_best_state(self) -> None:
        self._checkpoints_dir.mkdir(parents=True, exist_ok=True)
        save_json(
            self._best_state_path,
            {
                "best_checkpoint": self._best.best_checkpoint,
                "best_metric": self._best.best_metric,
                "best_step": self._best.best_step,
                "best_stage": self._best.best_stage,
                "metric_key": self._best.metric_key,
                "higher_is_better": self._best.higher_is_better,
            },
        )

    ## @brief Append a JSON-serializable record to a JSONL file deterministically.
    # @param path Path Output JSONL file path.
    # @param record dict[str, Any] JSON-serializable record.
    # @return None
    def _append_jsonl(self, path: Path, record: Dict[str, Any]) -> None:
        path.parent.mkdir(parents=True, exist_ok=True)
        payload: str = json.dumps(record, ensure_ascii=False, sort_keys=True)
        with path.open("a", encoding="utf-8") as f:
            f.write(payload + "\n")
