## src/eval/metrics.py
from __future__ import annotations

from dataclasses import dataclass
from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple, Union

import numpy as np
import evaluate
from sklearn.metrics import accuracy_score


## @brief Convert an input into a list of Python floats.
# @param x Any Input object (list/tuple/np/torch).
# @return list[float] List of floats.
def _to_float_list(x: Any) -> List[float]:
    if x is None:
        return []
    if isinstance(x, list):
        return [float(v) for v in x]
    if isinstance(x, tuple):
        return [float(v) for v in list(x)]
    if hasattr(x, "detach") and callable(getattr(x, "detach")):
        # torch.Tensor-like
        x = x.detach().cpu().numpy()
    if isinstance(x, np.ndarray):
        return [float(v) for v in x.reshape(-1).tolist()]
    return [float(v) for v in list(x)]


## @brief Convert an input into a list of Python ints.
# @param x Any Input object (list/tuple/np/torch).
# @return list[int] List of ints.
def _to_int_list(x: Any) -> List[int]:
    if x is None:
        return []
    if isinstance(x, list):
        return [int(v) for v in x]
    if isinstance(x, tuple):
        return [int(v) for v in list(x)]
    if hasattr(x, "detach") and callable(getattr(x, "detach")):
        # torch.Tensor-like
        x = x.detach().cpu().numpy()
    if isinstance(x, np.ndarray):
        return [int(v) for v in x.reshape(-1).tolist()]
    return [int(v) for v in list(x)]


## @brief Convert predictions into label ids for classification.
# @details If predictions are 2D (logits/probs), uses argmax over last axis.
# @param predictions Any Predictions as label ids shape [N] or logits shape [N, C].
# @return list[int] Predicted label ids.
def _classification_pred_ids(predictions: Any) -> List[int]:
    if predictions is None:
        return []
    if hasattr(predictions, "detach") and callable(getattr(predictions, "detach")):
        predictions = predictions.detach().cpu().numpy()
    if isinstance(predictions, np.ndarray):
        if predictions.ndim == 1:
            return [int(v) for v in predictions.tolist()]
        if predictions.ndim == 2:
            return [int(v) for v in np.argmax(predictions, axis=-1).tolist()]
        raise ValueError(f"Unsupported predictions ndarray shape for classification: {predictions.shape}")
    if isinstance(predictions, list) and len(predictions) > 0:
        first = predictions[0]
        if isinstance(first, (list, tuple, np.ndarray)):
            arr = np.asarray(predictions)
            if arr.ndim != 2:
                raise ValueError(f"Unsupported nested predictions shape for classification: {arr.shape}")
            return [int(v) for v in np.argmax(arr, axis=-1).tolist()]
        return [int(v) for v in predictions]
    return _to_int_list(predictions)


## @brief Filter out unlabeled examples (label < 0) for classification metrics.
# @param pred_ids list[int] Predicted ids.
# @param ref_ids list[int] Reference ids.
# @return tuple[list[int], list[int]] Filtered (pred_ids, ref_ids).
def _filter_unlabeled(pred_ids: List[int], ref_ids: List[int]) -> Tuple[List[int], List[int]]:
    if len(pred_ids) != len(ref_ids):
        raise ValueError(f"Predictions and references length mismatch: {len(pred_ids)} vs {len(ref_ids)}")
    out_p: List[int] = []
    out_r: List[int] = []
    for p, r in zip(pred_ids, ref_ids):
        if int(r) < 0:
            continue
        out_p.append(int(p))
        out_r.append(int(r))
    return out_p, out_r


## @brief Minimal text normalization for ROUGE.
# @details Only strips leading/trailing whitespace to avoid altering semantics.
# @param s str Input string.
# @return str Normalized string.
def _normalize_rouge_text(s: str) -> str:
    return (s or "").strip()


## @brief Metrics computation registry for different task types.
# @details Implements the design-specified interface:
#  - compute(), compute_glue(), compute_qa(), compute_rouge()
class MetricsRegistry:
    ## @brief Initialize MetricsRegistry.
    # @param task_type str Task type identifier (sequence_classification|qa|seq2seq|causal_lm).
    def __init__(self, task_type: str) -> None:
        self._task_type: str = str(task_type or "").strip().lower()
        if not self._task_type:
            raise ValueError("task_type must be a non-empty string.")

        self._glue_cache: Dict[str, Any] = {}
        self._squad_v2_metric: Optional[Any] = None
        self._rouge_metric: Optional[Any] = None

    ## @brief Compute metrics for the configured task_type.
    # @details Dispatches to compute_qa/compute_rouge; for sequence_classification, computes accuracy.
    # For GLUE-specific evaluation, prefer compute_glue(task_name, ...) to match dataset conventions.
    # @param predictions Any Predictions in task-appropriate format.
    # @param references Any References in task-appropriate format.
    # @return dict[str, float] Metric dictionary.
    def compute(self, predictions: Any, references: Any) -> Dict[str, float]:
        if self._task_type == "qa":
            return self.compute_qa(predictions=predictions, references=references)
        if self._task_type == "seq2seq":
            return self.compute_rouge(predictions=predictions, references=references)
        if self._task_type == "sequence_classification":
            pred_ids = _classification_pred_ids(predictions)
            ref_ids = _to_int_list(references)
            pred_ids, ref_ids = _filter_unlabeled(pred_ids, ref_ids)
            if len(ref_ids) == 0:
                return {"accuracy": 0.0, "accuracy_raw": 0.0}
            acc_raw = float(accuracy_score(ref_ids, pred_ids))
            # Paper reports dev accuracy; typically in percentage.
            return {"accuracy": float(100.0 * acc_raw), "accuracy_raw": float(acc_raw)}
        if self._task_type == "causal_lm":
            raise ValueError(
                "MetricsRegistry.compute() does not compute lm-eval-harness metrics. "
                "Use src/eval/lm_eval_adapter.py via Evaluator for LLaMA evaluation."
            )
        raise ValueError(f"Unsupported task_type for MetricsRegistry.compute(): {self._task_type!r}")

    ## @brief Compute GLUE dev-set accuracy for a specific GLUE task.
    # @details Uses evaluate.load('glue', task_name). The returned 'accuracy' from evaluate is in [0,1];
    # this method returns both percent-scale 'accuracy' (paper-style) and 'accuracy_raw' (library-scale).
    # @param task_name str GLUE task name (e.g., 'sst2', 'mnli').
    # @param predictions Any Predicted labels or logits/probabilities.
    # @param references Any Reference label ids.
    # @return dict[str, float] Metric dictionary with 'accuracy' and 'accuracy_raw'.
    def compute_glue(self, task_name: str, predictions: Any, references: Any) -> Dict[str, float]:
        task: str = str(task_name or "").strip().lower()
        if not task:
            raise ValueError("task_name must be a non-empty GLUE task string.")

        pred_ids = _classification_pred_ids(predictions)
        ref_ids = _to_int_list(references)
        pred_ids, ref_ids = _filter_unlabeled(pred_ids, ref_ids)
        if len(ref_ids) == 0:
            return {"accuracy": 0.0, "accuracy_raw": 0.0}

        metric = self._get_glue_metric(task)
        computed: Dict[str, Any] = metric.compute(predictions=pred_ids, references=ref_ids)

        # GLUE SST-2/MNLI should provide "accuracy".
        acc_raw = float(computed.get("accuracy", accuracy_score(ref_ids, pred_ids)))
        return {
            "accuracy": float(100.0 * acc_raw),
            "accuracy_raw": float(acc_raw),
        }

    ## @brief Compute SQuAD v2.0 dev-set metrics.
    # @details Uses evaluate.load('squad_v2'). Paper reports dev F1, which evaluate returns as 'f1'.
    # evaluate's squad_v2 metric returns percentage scale (0..100). This method returns at least 'f1'.
    # @param predictions Any List[dict] in SQuAD v2 prediction format: {'id','prediction_text',...}.
    # @param references Any List[dict] in SQuAD v2 reference format: {'id','answers':{'text','answer_start'}}.
    # @return dict[str, float] Metric dict including 'f1' and (if available) 'exact'.
    def compute_qa(self, predictions: Any, references: Any) -> Dict[str, float]:
        if not isinstance(predictions, list) or not isinstance(references, list):
            raise ValueError(
                "SQuAD v2 metric expects predictions and references as lists of dicts in evaluate's squad_v2 format."
            )
        for i, p in enumerate(predictions):
            if not isinstance(p, dict) or "id" not in p or "prediction_text" not in p:
                raise ValueError(f"Invalid SQuAD prediction at index {i}: expected keys 'id' and 'prediction_text'.")
        for i, r in enumerate(references):
            if not isinstance(r, dict) or "id" not in r or "answers" not in r:
                raise ValueError(f"Invalid SQuAD reference at index {i}: expected keys 'id' and 'answers'.")

        metric = self._get_squad_v2_metric()
        computed: Dict[str, Any] = metric.compute(predictions=predictions, references=references)

        # Paper: dev F1.
        out: Dict[str, float] = {}
        if "f1" in computed:
            out["f1"] = float(computed["f1"])
        else:
            raise ValueError(f"squad_v2 metric did not return 'f1'. Returned keys: {sorted(list(computed.keys()))}")

        # Keep exact-match if provided (not primary in paper).
        if "exact" in computed:
            out["exact"] = float(computed["exact"])
        return out

    ## @brief Compute ROUGE-1/2/L for summarization (CNN/DM) or other seq2seq tasks.
    # @details Uses evaluate.load('rouge') and computes rouge1/rouge2/rougeL.
    # The evaluate rouge metric returns values in [0,1]; the paper reports ROUGE scores conventionally in
    # percentage-like scale. This method returns both:
    #  - rouge1/rouge2/rougel as percent-scale (0..100)
    #  - rouge1_raw/rouge2_raw/rougeL_raw as library-scale (0..1)
    # @param predictions list[str] Generated texts.
    # @param references list[str] Reference texts.
    # @return dict[str, float] ROUGE metrics.
    def compute_rouge(self, predictions: List[str], references: List[str]) -> Dict[str, float]:
        if not isinstance(predictions, list) or not isinstance(references, list):
            raise ValueError("ROUGE expects predictions and references as list[str].")
        if len(predictions) != len(references):
            raise ValueError(f"Predictions and references length mismatch: {len(predictions)} vs {len(references)}")
        if len(predictions) == 0:
            return {
                "rouge1": 0.0,
                "rouge2": 0.0,
                "rougel": 0.0,
                "rougeL": 0.0,
                "rouge1_raw": 0.0,
                "rouge2_raw": 0.0,
                "rougeL_raw": 0.0,
            }

        preds = [_normalize_rouge_text(str(s)) for s in predictions]
        refs = [_normalize_rouge_text(str(s)) for s in references]

        metric = self._get_rouge_metric()

        # Many summarization setups use stemming; the paper/config.yaml do not specify.
        # We keep a deterministic choice here by enabling stemming explicitly if supported by the metric.
        computed: Dict[str, Any]
        try:
            computed = metric.compute(
                predictions=preds,
                references=refs,
                rouge_types=["rouge1", "rouge2", "rougeL"],
                use_stemmer=True,
            )
        except TypeError:
            # Fall back if this evaluate version doesn't accept use_stemmer/rouge_types.
            computed = metric.compute(predictions=preds, references=refs)

        r1_raw = float(computed.get("rouge1", 0.0))
        r2_raw = float(computed.get("rouge2", 0.0))
        rL_raw = float(computed.get("rougeL", computed.get("rougeLsum", 0.0)))

        return {
            "rouge1": float(100.0 * r1_raw),
            "rouge2": float(100.0 * r2_raw),
            "rougel": float(100.0 * rL_raw),  # config.yaml uses 'rougel'
            "rougeL": float(100.0 * rL_raw),  # keep canonical rougeL too
            "rouge1_raw": float(r1_raw),
            "rouge2_raw": float(r2_raw),
            "rougeL_raw": float(rL_raw),
        }

    ## @brief Load and cache a GLUE metric object.
    # @param task_name str GLUE task name.
    # @return Any evaluate.Metric instance.
    def _get_glue_metric(self, task_name: str) -> Any:
        task = str(task_name or "").strip().lower()
        if not task:
            raise ValueError("task_name must be non-empty for GLUE metric loading.")
        if task in self._glue_cache:
            return self._glue_cache[task]
        metric = evaluate.load("glue", task)
        self._glue_cache[task] = metric
        return metric

    ## @brief Load and cache the SQuAD v2 metric object.
    # @return Any evaluate.Metric instance.
    def _get_squad_v2_metric(self) -> Any:
        if self._squad_v2_metric is not None:
            return self._squad_v2_metric
        self._squad_v2_metric = evaluate.load("squad_v2")
        return self._squad_v2_metric

    ## @brief Load and cache the ROUGE metric object.
    # @return Any evaluate.Metric instance.
    def _get_rouge_metric(self) -> Any:
        if self._rouge_metric is not None:
            return self._rouge_metric
        self._rouge_metric = evaluate.load("rouge")
        return self._rouge_metric
