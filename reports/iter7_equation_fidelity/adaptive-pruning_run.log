## src/algorithms/rank_allocator.py
from __future__ import annotations

import math
from typing import Dict, List, Optional, Tuple

from src.config import APTConfig
from src.models.apt_injector import APTRegistry
from src.models.apt_linear import APTLinear
from src.utils.logging import get_logger


## @brief Adaptive tuning rank allocator for APT (Sec. 4.3).
# @details Implements salience-driven selection of APT adapters and dynamic rank expansion using the
# paper's rank growth rule. This module does not compute salience; it consumes per-adapter importance
# scores produced elsewhere (SalienceCollector.get_adapter_importance()).
#
# Key paper equations implemented here:
#  - apt_initial_rank: r_apt = 8 (enforced in __init__)
#  - apt_rank_update_rule: r'_apt = floor(r_apt * (Δ'_t / Δ_t)) (implemented in expand_selected_modules)
#
# Budget interpretation:
#  - This code treats the passed `new_budget` as Δ'_t and keeps internal state `self._current_budget`
#    as Δ_t to form the ratio Δ'_t/Δ_t required by the paper. `compute_budget()` produces a
#    monotonically increasing integer budget for the pruning stage using only fields available in
#    APTConfig (notably target_sparsity) and the current step progress.
class RankAllocator:
    ## @brief Initialize a RankAllocator.
    # @details Enforces the paper's literal initial rank: r_apt = 8. The allocator never reduces
    # ranks below this constant and never shrinks ranks.
    # @param registry APTRegistry Registry containing all injected APTLinear modules.
    # @param apt_config APTConfig APT configuration controlling rank growth behavior.
    def __init__(self, registry: APTRegistry, apt_config: APTConfig) -> None:
        if registry is None:
            raise ValueError("registry must be non-None.")
        if apt_config is None:
            raise ValueError("apt_config must be non-None.")

        self._logger = get_logger("apt.rank_allocator")
        self._registry: APTRegistry = registry
        self._apt_config: APTConfig = apt_config

        # eq: apt_initial_rank
        self._initial_rank: int = 8

        if int(getattr(self._apt_config, "initial_rank", 0) or 0) != self._initial_rank:
            raise ValueError(
                f"APT initial_rank must be {self._initial_rank} per paper/config.yaml, "
                f"got {int(getattr(self._apt_config, 'initial_rank', 0) or 0)}."
            )

        # Internal state for Δ_t used by apt_rank_update_rule. Initialize to Δ_0 = r_apt (8).
        self._current_budget: int = int(self._initial_rank)

        # Build a deterministic name -> module mapping using only design-allowed interfaces:
        #   - APTRegistry.list_modules()
        #   - APTLinear.collect_structure_metadata()["module_name"]
        self._name_to_module: Dict[str, APTLinear] = {}
        self._all_module_names: List[str] = []

        for module in self._registry.list_modules():
            if not isinstance(module, APTLinear):
                continue
            meta = module.collect_structure_metadata()
            name = str(meta.get("module_name", "")).strip()
            if not name:
                raise ValueError("APTLinear.collect_structure_metadata() must include a non-empty 'module_name'.")
            if name in self._name_to_module:
                raise ValueError(f"Duplicate APT module_name detected in registry: {name!r}")
            self._name_to_module[name] = module
            self._all_module_names.append(name)

        self._all_module_names = sorted(self._all_module_names)

        if bool(getattr(self._apt_config, "enable_apt", False)) and len(self._all_module_names) == 0:
            raise ValueError("RankAllocator initialized with APT enabled but registry contains no APTLinear modules.")

    ## @brief Compute the current tuning budget Δ_t for adaptive rank growth.
    # @details The paper defines a per-step tuning budget Δ_t but does not specify a numeric schedule
    # in config.yaml. This implementation computes a monotone budget using only ExperimentConfig fields:
    #   - initial_rank (fixed 8)
    #   - target_sparsity (γ_T)
    #   - training progress over pruning steps: p = t/T
    #
    # We compute a final budget using γ_T and linearly interpolate from r_apt to that final budget.
    # This produces a Δ_t that can be used in the rank update rule (ratio Δ'_t/Δ_t).
    # @param global_step int Current pruning-stage step index.
    # @param total_pruning_steps int Total pruning-stage steps.
    # @return int The integer budget Δ_t (>= 1).
    def compute_budget(self, global_step: int, total_pruning_steps: int) -> int:
        if not bool(getattr(self._apt_config, "enable_apt", False)):
            return 0

        t: int = int(max(0, global_step))
        T: int = int(max(1, total_pruning_steps))

        # Progress in [0,1].
        p: float = float(t) / float(T)
        if p < 0.0:
            p = 0.0
        if p > 1.0:
            p = 1.0

        gamma_T: float = float(getattr(self._apt_config, "target_sparsity", 0.0))
        if not (0.0 <= gamma_T <= 1.0):
            raise ValueError(f"apt.target_sparsity must be within [0,1], got {gamma_T}.")

        # Compute an end budget using only (r_apt=8, γ_T) without introducing extra hyperparameters.
        # Note: this is a budget scalar used only in Δ'_t/Δ_t ratio; the rank update rule is enforced
        # exactly in expand_selected_modules().
        remain = max(1e-12, 1.0 - float(gamma_T))
        end_budget: int = int(math.floor(float(self._initial_rank) / float(remain)))
        if end_budget < self._initial_rank:
            end_budget = int(self._initial_rank)

        # Linearly interpolate (integer floor) from initial to end budget.
        budget_f: float = float(self._initial_rank) + (float(end_budget - self._initial_rank) * float(p))
        budget: int = int(math.floor(budget_f))
        if budget < 1:
            budget = 1

        # Keep budget monotone w.r.t. internal state to prevent accidental "budget decrease" behavior.
        if budget < self._current_budget:
            budget = int(self._current_budget)

        return int(budget)

    ## @brief Select the top-half salient adapters for rank expansion.
    # @details Implements Sec. 4.3: "select the top-half APT adapters after sorting them with salience".
    # Deterministic tie-breaking is used: sort by (-importance, module_name).
    # @param adapter_importance dict[str, float] Mapping module_name -> importance score.
    # @return list[str] Selected module names (top-half, deterministic).
    def select_top_half(self, adapter_importance: Dict[str, float]) -> List[str]:
        if adapter_importance is None:
            adapter_importance = {}

        # Consider only adapters that exist in the registry; missing scores default to 0.0.
        scored: List[Tuple[float, str]] = []
        for name in self._all_module_names:
            score = float(adapter_importance.get(name, 0.0))
            scored.append((score, name))

        if len(scored) == 0:
            return []

        scored.sort(key=lambda x: (-float(x[0]), str(x[1])))

        n: int = int(len(scored))
        k: int = int((n + 1) // 2)  # ceil(n/2) to match "top-half" intent for odd n
        if k <= 0:
            k = 1

        selected: List[str] = [name for _, name in scored[:k]]
        return selected

    ## @brief Expand ranks for selected adapters using the paper's rank growth rule.
    # @details Implements Sec. 4.3 rank update:
    #   r'_apt = floor(r_apt * (Δ'_t / Δ_t))
    # where Δ_t is the previously stored budget and Δ'_t is `new_budget`.
    #
    # This method never shrinks ranks: it uses max(current_rank, r'_apt, initial_rank).
    # It returns True iff any module's rank increased (i.e., shape changed), so Trainer can reset
    # the optimizer per config.yaml apt.optimizer_reset_after_shape_change=true.
    # @param selected list[str] List of module names to expand (typically top-half salient).
    # @param new_budget int New tuning budget Δ'_t.
    # @return bool True iff any module expanded rank (shape changed), else False.
    def expand_selected_modules(self, selected: List[str], new_budget: int) -> bool:
        if not bool(getattr(self._apt_config, "enable_apt", False)):
            return False

        if selected is None:
            selected = []

        new_b: int = int(new_budget)
        if new_b <= 0:
            # A non-positive Δ'_t provides no meaningful ratio; do nothing.
            return False

        old_b: int = int(self._current_budget)
        if old_b <= 0:
            old_b = int(new_b)

        # Enforce non-decreasing budgets; the paper describes "adding" parameters.
        if new_b < old_b:
            new_b = int(old_b)

        # Deduplicate while preserving input order deterministically.
        seen: set[str] = set()
        selected_unique: List[str] = []
        for name in selected:
            n = str(name)
            if n in seen:
                continue
            seen.add(n)
            selected_unique.append(n)

        shape_changed: bool = False
        expanded_count: int = 0

        for module_name in selected_unique:
            module: Optional[APTLinear] = self._name_to_module.get(module_name, None)
            if module is None:
                # Ignore keys not in registry.
                continue

            cur_rank: int = int(module.current_rank())
            if cur_rank < self._initial_rank:
                # Should not happen in a valid run; enforce minimum.
                cur_rank = int(self._initial_rank)

            # eq: apt_rank_update_rule
            # r'_apt = floor(r_apt * (Δ'_t / Δ_t))
            proposed_rank: int = int(math.floor(float(cur_rank) * (float(new_b) / float(old_b))))

            # Never shrink; never go below r_apt=8.
            if proposed_rank < cur_rank:
                proposed_rank = int(cur_rank)
            if proposed_rank < self._initial_rank:
                proposed_rank = int(self._initial_rank)

            if proposed_rank > cur_rank:
                module.expand_rank(int(proposed_rank))
                shape_changed = True
                expanded_count += 1

        # Update internal Δ_t state to Δ'_t for next call, regardless of whether any expansion happened,
        # but keep it monotone.
        if new_b > self._current_budget:
            self._current_budget = int(new_b)

        if shape_changed:
            self._logger.info(
                "Rank expansion | expanded_modules=%d/%d | old_budget=%d | new_budget=%d",
                int(expanded_count),
                int(len(selected_unique)),
                int(old_b),
                int(new_b),
            )

        return bool(shape_changed)
