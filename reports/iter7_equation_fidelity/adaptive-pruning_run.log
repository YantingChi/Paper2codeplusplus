## src/config.py
from __future__ import annotations

import copy
import math
import os
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any, Dict, List, Optional

import yaml


## @brief Load a YAML file into a Python dictionary.
# @param path str Path to YAML file.
# @return dict[str, Any] Parsed YAML content (empty dict if file missing).
def load_yaml(path: str) -> Dict[str, Any]:
    p = Path(path)
    if not p.exists():
        return {}
    with p.open("r", encoding="utf-8") as f:
        data = yaml.safe_load(f)
    if data is None:
        return {}
    if not isinstance(data, dict):
        raise ValueError(f"YAML root must be a mapping/dict: {path}")
    return data


## @brief Deep merge two dictionaries with deterministic override behavior.
# @details For any key:
#   - if both values are dicts: merge recursively
#   - otherwise: override replaces base
# Lists are replaced (not concatenated).
# @param base dict[str, Any] Base dictionary.
# @param override dict[str, Any] Override dictionary.
# @return dict[str, Any] Merged dictionary.
def deep_merge_dicts(base: Dict[str, Any], override: Dict[str, Any]) -> Dict[str, Any]:
    merged: Dict[str, Any] = copy.deepcopy(base)
    for k, v in override.items():
        if k in merged and isinstance(merged[k], dict) and isinstance(v, dict):
            merged[k] = deep_merge_dicts(merged[k], v)
        else:
            merged[k] = copy.deepcopy(v)
    return merged


## @brief Safely get a nested value from a dictionary using dotted keys.
# @param d dict[str, Any] Source dictionary.
# @param key str Dotted key path (e.g., "training.learning_rate").
# @param default Any Default value if key does not exist.
# @return Any Retrieved value or default.
def _get_nested(d: Dict[str, Any], key: str, default: Any) -> Any:
    cur: Any = d
    for part in key.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return cur


## @brief Try to coerce a value into a boolean.
# @param v Any Input value.
# @param default bool Default value if v is None.
# @return bool Coerced boolean.
def _as_bool(v: Any, default: bool) -> bool:
    if v is None:
        return default
    if isinstance(v, bool):
        return v
    if isinstance(v, (int, float)):
        return bool(v)
    if isinstance(v, str):
        s = v.strip().lower()
        if s in ("true", "1", "yes", "y", "t"):
            return True
        if s in ("false", "0", "no", "n", "f"):
            return False
    raise ValueError(f"Cannot coerce to bool: {v!r}")


## @brief Try to coerce a value into an integer.
# @param v Any Input value.
# @param default int Default value if v is None.
# @return int Coerced integer.
def _as_int(v: Any, default: int) -> int:
    if v is None:
        return default
    if isinstance(v, bool):
        return int(v)
    if isinstance(v, int):
        return v
    if isinstance(v, float) and v.is_integer():
        return int(v)
    if isinstance(v, str):
        s = v.strip()
        try:
            return int(s)
        except ValueError as e:
            raise ValueError(f"Cannot coerce to int: {v!r}") from e
    raise ValueError(f"Cannot coerce to int: {v!r}")


## @brief Try to coerce a value into a float.
# @param v Any Input value.
# @param default float Default value if v is None.
# @return float Coerced float.
def _as_float(v: Any, default: float) -> float:
    if v is None:
        return default
    if isinstance(v, bool):
        return float(v)
    if isinstance(v, (int, float)):
        return float(v)
    if isinstance(v, str):
        s = v.strip()
        try:
            return float(s)
        except ValueError as e:
            raise ValueError(f"Cannot coerce to float: {v!r}") from e
    raise ValueError(f"Cannot coerce to float: {v!r}")


## @brief Determine whether a backbone string corresponds to a LLaMA-family model.
# @param backbone_name str Backbone name string from config.
# @return bool True if LLaMA-like, else False.
def _is_llama_backbone(backbone_name: str) -> bool:
    name = backbone_name.lower()
    return "llama" in name or "llemma" in name


## @brief Determine inference eval batch size for paper settings.
# @param paper_cfg dict[str, Any] Parsed global config.yaml (paper).
# @param backbone_name str Model backbone name.
# @return int Inference batch size.
def _paper_inference_batch_size(paper_cfg: Dict[str, Any], backbone_name: str) -> int:
    bs_cfg = _get_nested(paper_cfg, "evaluation.inference_batch_size", {})
    if not isinstance(bs_cfg, dict):
        raise ValueError("config.yaml evaluation.inference_batch_size must be a dict")

    name = backbone_name.lower()
    if _is_llama_backbone(backbone_name):
        if "13b" in name:
            return _as_int(bs_cfg.get("llama_13b"), 4)
        return _as_int(bs_cfg.get("llama_7b"), 32)
    return _as_int(bs_cfg.get("small_models"), 128)


## @brief Infer the paper hyperparameter regime key for this experiment.
# @details Regimes are defined in config.yaml under training.*:
#   glue_small, glue_big, squad, cnndm, alpaca.
# @param dataset_name str Dataset name (e.g. "glue", "cnn_dailymail", "alpaca").
# @param dataset_config_name str Dataset config name (e.g. "sst2", "mnli", "3.0.0").
# @param backbone_name str Backbone name (used for Alpaca/LLaMA conventions if needed).
# @return str Regime key.
def _infer_training_regime(dataset_name: str, dataset_config_name: str, backbone_name: str) -> str:
    ds = (dataset_name or "").strip().lower()
    dsc = (dataset_config_name or "").strip().lower()

    if ds == "glue":
        # Paper text treats MNLI/SST2/QNLI/QQP as GLUE-big. Parsed config.yaml includes SST2+MNLI.
        if dsc in ("mnli", "sst2", "qnli", "qqp"):
            return "glue_big"
        return "glue_small"

    if ds in ("squad_v2", "squadv2", "squad"):
        return "squad"

    if ds in ("cnndm", "cnn_dailymail", "cnn-dailymail"):
        return "cnndm"

    if ds in ("alpaca",):
        return "alpaca"

    # For safety: if user uses an Alpaca-like run but forgot to name dataset, use backbone heuristic.
    if _is_llama_backbone(backbone_name):
        return "alpaca"

    raise ValueError(
        f"Cannot infer training regime from dataset_name={dataset_name!r}, "
        f"dataset_config_name={dataset_config_name!r}, backbone_name={backbone_name!r}."
    )


## @brief Configuration for model creation.
@dataclass
class ModelConfig:
    ## @brief Initialize ModelConfig.
    # @param backbone_name str Hugging Face model name or path.
    # @param task_type str Task type identifier (sequence_classification|seq2seq|qa|causal_lm).
    # @param max_length int Max token length for single-sequence tasks (0 means "use tokenizer default").
    # @param num_labels int Number of labels for classification heads (0 means "use model default").
    # @param use_ffn_adapters bool Whether to place APT adapters in FFN layers (paper: small models only).
    # @param trust_remote_code bool Whether to enable trust_remote_code in Transformers.
    def __init__(
        self,
        backbone_name: str = "",
        task_type: str = "",
        max_length: int = 0,
        num_labels: int = 0,
        use_ffn_adapters: bool = False,
        trust_remote_code: bool = False,
    ) -> None:
        self.backbone_name = backbone_name
        self.task_type = task_type
        self.max_length = max_length
        self.num_labels = num_labels
        self.use_ffn_adapters = use_ffn_adapters
        self.trust_remote_code = trust_remote_code

    backbone_name: str = ""
    task_type: str = ""
    max_length: int = 0
    num_labels: int = 0
    use_ffn_adapters: bool = False
    trust_remote_code: bool = False


## @brief Configuration for dataset loading and batching.
@dataclass
class DataConfig:
    ## @brief Initialize DataConfig.
    # @param dataset_name str Dataset name (HF datasets id or internal alias).
    # @param dataset_config_name str Dataset configuration name (e.g., "sst2", "mnli").
    # @param train_split str Train split name.
    # @param validation_split str Validation/dev split name.
    # @param text_fields list[str] Text field names (for classification).
    # @param label_field str Label field name.
    # @param max_source_length int Max source length for seq2seq/qa (0 means "use tokenizer default").
    # @param max_target_length int Max target length for seq2seq (0 means "use tokenizer default").
    # @param batch_size int Training batch size.
    # @param eval_batch_size int Eval/inference batch size.
    def __init__(
        self,
        dataset_name: str = "",
        dataset_config_name: str = "",
        train_split: str = "train",
        validation_split: str = "validation",
        text_fields: Optional[List[str]] = None,
        label_field: str = "label",
        max_source_length: int = 0,
        max_target_length: int = 0,
        batch_size: int = 0,
        eval_batch_size: int = 0,
    ) -> None:
        self.dataset_name = dataset_name
        self.dataset_config_name = dataset_config_name
        self.train_split = train_split
        self.validation_split = validation_split
        self.text_fields = text_fields if text_fields is not None else []
        self.label_field = label_field
        self.max_source_length = max_source_length
        self.max_target_length = max_target_length
        self.batch_size = batch_size
        self.eval_batch_size = eval_batch_size

    dataset_name: str = ""
    dataset_config_name: str = ""
    train_split: str = "train"
    validation_split: str = "validation"
    text_fields: List[str] = field(default_factory=list)
    label_field: str = "label"
    max_source_length: int = 0
    max_target_length: int = 0
    batch_size: int = 0
    eval_batch_size: int = 0


## @brief Configuration for optimization and training loop.
@dataclass
class TrainingConfig:
    ## @brief Initialize TrainingConfig.
    # @param learning_rate float Learning rate (resolved from paper regime).
    # @param weight_decay float Weight decay (must be specified in defaults or task config if used).
    # @param num_epochs int Number of epochs (resolved from paper regime).
    # @param distill_epochs int Distillation epochs (resolved from paper regime; 0 means disabled).
    # @param gradient_accumulation_steps int Gradient accumulation steps.
    # @param warmup_ratio float LR warmup ratio.
    # @param max_grad_norm float Gradient clipping norm.
    # @param optimizer_name str Optimizer name (e.g., "adamw").
    # @param lr_scheduler_type str Scheduler type (e.g., "linear", "cosine").
    # @param fp16 bool Whether to use FP16.
    # @param bf16 bool Whether to use BF16.
    # @param eval_every_steps int Evaluation interval in steps.
    # @param save_every_steps int Checkpoint interval in steps.
    # @param seed int Random seed.
    def __init__(
        self,
        learning_rate: float = 0.0,
        weight_decay: float = 0.0,
        num_epochs: int = 0,
        distill_epochs: int = 0,
        gradient_accumulation_steps: int = 1,
        warmup_ratio: float = 0.0,
        max_grad_norm: float = 0.0,
        optimizer_name: str = "adamw",
        lr_scheduler_type: str = "linear",
        fp16: bool = False,
        bf16: bool = False,
        eval_every_steps: int = 0,
        save_every_steps: int = 0,
        seed: int = 42,
    ) -> None:
        self.learning_rate = learning_rate
        self.weight_decay = weight_decay
        self.num_epochs = num_epochs
        self.distill_epochs = distill_epochs
        self.gradient_accumulation_steps = gradient_accumulation_steps
        self.warmup_ratio = warmup_ratio
        self.max_grad_norm = max_grad_norm
        self.optimizer_name = optimizer_name
        self.lr_scheduler_type = lr_scheduler_type
        self.fp16 = fp16
        self.bf16 = bf16
        self.eval_every_steps = eval_every_steps
        self.save_every_steps = save_every_steps
        self.seed = seed

    learning_rate: float = 0.0
    weight_decay: float = 0.0
    num_epochs: int = 0
    distill_epochs: int = 0
    gradient_accumulation_steps: int = 1
    warmup_ratio: float = 0.0
    max_grad_norm: float = 0.0
    optimizer_name: str = "adamw"
    lr_scheduler_type: str = "linear"
    fp16: bool = False
    bf16: bool = False
    eval_every_steps: int = 0
    save_every_steps: int = 0
    seed: int = 42


## @brief Configuration for APT pruning/tuning/distillation behaviors.
@dataclass
class APTConfig:
    ## @brief Initialize APTConfig.
    # @param enable_apt bool Whether to enable APT.
    # @param target_sparsity float Target sparsity gamma_T (ratio of pruned params).
    # @param initial_rank int Initial adapter rank r_apt (paper: 8).
    # @param lora_alpha float Scaling factor s (paper: 2; stored in lora_alpha field).
    # @param mask_update_step float Gradual mask update alpha (paper: 0.01).
    # @param salience_ema_beta float EMA beta for salience (must be specified explicitly; paper parse omits numeric).
    # @param pruning_stage_ratio float Fraction of training steps used for pruning stage (must be specified explicitly).
    # @param rank_update_interval int Steps between rank allocation updates.
    # @param prune_update_interval int Steps between pruning mask updates.
    # @param rank_growth_mode str Rank growth mode identifier (paper rule enforced in validate).
    # @param use_kurtosis bool Whether to use kurtosis bonus in pruning salience.
    # @param use_self_distill bool Whether to enable efficient self-distillation.
    # @param distill_mu_schedule str Distillation mu schedule (paper: linear_0_to_1).
    # @param teacher_share_frozen bool Whether teacher shares frozen parameters (paper: true).
    # @param apply_on_modules list[str] Which module categories to apply APT to.
    def __init__(
        self,
        enable_apt: bool = False,
        target_sparsity: float = 0.0,
        initial_rank: int = 0,
        lora_alpha: float = 0.0,
        mask_update_step: float = 0.0,
        salience_ema_beta: float = 0.0,
        pruning_stage_ratio: float = 0.0,
        rank_update_interval: int = 0,
        prune_update_interval: int = 0,
        rank_growth_mode: str = "",
        use_kurtosis: bool = True,
        use_self_distill: bool = False,
        distill_mu_schedule: str = "linear_0_to_1",
        teacher_share_frozen: bool = True,
        apply_on_modules: Optional[List[str]] = None,
    ) -> None:
        self.enable_apt = enable_apt
        self.target_sparsity = target_sparsity
        self.initial_rank = initial_rank
        self.lora_alpha = lora_alpha
        self.mask_update_step = mask_update_step
        self.salience_ema_beta = salience_ema_beta
        self.pruning_stage_ratio = pruning_stage_ratio
        self.rank_update_interval = rank_update_interval
        self.prune_update_interval = prune_update_interval
        self.rank_growth_mode = rank_growth_mode
        self.use_kurtosis = use_kurtosis
        self.use_self_distill = use_self_distill
        self.distill_mu_schedule = distill_mu_schedule
        self.teacher_share_frozen = teacher_share_frozen
        self.apply_on_modules = apply_on_modules if apply_on_modules is not None else []

    enable_apt: bool = False
    target_sparsity: float = 0.0
    initial_rank: int = 0
    lora_alpha: float = 0.0
    mask_update_step: float = 0.0
    salience_ema_beta: float = 0.0
    pruning_stage_ratio: float = 0.0
    rank_update_interval: int = 0
    prune_update_interval: int = 0
    rank_growth_mode: str = ""
    use_kurtosis: bool = True
    use_self_distill: bool = False
    distill_mu_schedule: str = "linear_0_to_1"
    teacher_share_frozen: bool = True
    apply_on_modules: List[str] = field(default_factory=list)


## @brief Configuration for evaluation and efficiency profiling.
@dataclass
class EvalConfig:
    ## @brief Initialize EvalConfig.
    # @param metrics list[str] Task metrics (e.g., ["accuracy"], ["rouge1","rouge2","rougel"]).
    # @param measure_train_peak_memory bool Whether to measure peak training memory.
    # @param measure_inference_peak_memory bool Whether to measure peak inference memory.
    # @param measure_throughput bool Whether to measure throughput speedup.
    # @param lm_eval_tasks list[str] lm-eval-harness tasks for LLaMA evaluation.
    # @param lm_eval_num_fewshot dict[str, int] Few-shot counts per task.
    def __init__(
        self,
        metrics: Optional[List[str]] = None,
        measure_train_peak_memory: bool = True,
        measure_inference_peak_memory: bool = True,
        measure_throughput: bool = True,
        lm_eval_tasks: Optional[List[str]] = None,
        lm_eval_num_fewshot: Optional[Dict[str, int]] = None,
    ) -> None:
        self.metrics = metrics if metrics is not None else []
        self.measure_train_peak_memory = measure_train_peak_memory
        self.measure_inference_peak_memory = measure_inference_peak_memory
        self.measure_throughput = measure_throughput
        self.lm_eval_tasks = lm_eval_tasks if lm_eval_tasks is not None else []
        self.lm_eval_num_fewshot = lm_eval_num_fewshot if lm_eval_num_fewshot is not None else {}

    metrics: List[str] = field(default_factory=list)
    measure_train_peak_memory: bool = True
    measure_inference_peak_memory: bool = True
    measure_throughput: bool = True
    lm_eval_tasks: List[str] = field(default_factory=list)
    lm_eval_num_fewshot: Dict[str, int] = field(default_factory=dict)


## @brief Configuration for runtime/environment options.
@dataclass
class RuntimeConfig:
    ## @brief Initialize RuntimeConfig.
    # @param output_dir str Output directory for artifacts.
    # @param device str Device string ("cuda", "cpu", "cuda:0", etc.).
    # @param num_workers int DataLoader num_workers.
    # @param pin_memory bool DataLoader pin_memory.
    # @param compile_model bool Whether to torch.compile the model.
    # @param gradient_checkpointing bool Whether to enable gradient checkpointing.
    # @param log_level str Logging level name (e.g. "INFO").
    def __init__(
        self,
        output_dir: str = "outputs",
        device: str = "cuda",
        num_workers: int = 4,
        pin_memory: bool = True,
        compile_model: bool = False,
        gradient_checkpointing: bool = False,
        log_level: str = "INFO",
    ) -> None:
        self.output_dir = output_dir
        self.device = device
        self.num_workers = num_workers
        self.pin_memory = pin_memory
        self.compile_model = compile_model
        self.gradient_checkpointing = gradient_checkpointing
        self.log_level = log_level

    output_dir: str = "outputs"
    device: str = "cuda"
    num_workers: int = 4
    pin_memory: bool = True
    compile_model: bool = False
    gradient_checkpointing: bool = False
    log_level: str = "INFO"


## @brief ExperimentConfig is the single source of truth for an experiment run.
@dataclass
class ExperimentConfig:
    model: ModelConfig = field(default_factory=ModelConfig)
    data: DataConfig = field(default_factory=DataConfig)
    training: TrainingConfig = field(default_factory=TrainingConfig)
    apt: APTConfig = field(default_factory=APTConfig)
    evaluation: EvalConfig = field(default_factory=EvalConfig)
    runtime: RuntimeConfig = field(default_factory=RuntimeConfig)

    ## @brief Load and build an ExperimentConfig from YAML files.
    # @details Merge precedence:
    #   1) configs/default.yaml (if exists)
    #   2) config.yaml (paper rules)
    #   3) the provided experiment YAML path
    # @param path str Path to the experiment YAML file.
    # @return ExperimentConfig Built and validated configuration.
    @staticmethod
    def from_yaml(path: str) -> "ExperimentConfig":
        return build_config(path)

    ## @brief Validate config, resolve paper-regime hyperparameters, and enforce paper constraints.
    # @details This method also materializes values from config.yaml into the design dataclasses.
    # @return None
    def validate(self) -> None:
        paper_cfg = _load_paper_config()

        # ---- Required top-level fields ----
        if not self.model.backbone_name:
            raise ValueError("model.backbone_name must be specified.")
        if not self.model.task_type:
            raise ValueError("model.task_type must be specified.")
        if not self.data.dataset_name:
            raise ValueError("data.dataset_name must be specified.")
        if not self.data.train_split:
            raise ValueError("data.train_split must be specified.")
        if not self.data.validation_split:
            raise ValueError("data.validation_split must be specified.")
        if not isinstance(self.evaluation.metrics, list) or len(self.evaluation.metrics) == 0:
            raise ValueError("evaluation.metrics must be a non-empty list.")

        # ---- Enforce APT paper-fixed constants (from paper + config.yaml) ----
        # These are literal constraints required by the reproduction instructions.
        if self.apt.enable_apt:
            # eq: apt_initial_rank
            if self.apt.initial_rank == 0:
                self.apt.initial_rank = 8
            if self.apt.initial_rank != 8:
                raise ValueError(f"APT initial_rank must be 8 per paper, got {self.apt.initial_rank}.")

            # eq: apt_scaling_factor
            if self.apt.lora_alpha == 0.0:
                self.apt.lora_alpha = 2.0
            if self.apt.lora_alpha != 2.0:
                raise ValueError(f"APT scaling factor s must be 2 per paper, got {self.apt.lora_alpha}.")

            # eq: apt_mask_update_alpha
            if self.apt.mask_update_step == 0.0:
                self.apt.mask_update_step = 0.01
            if self.apt.mask_update_step != 0.01:
                raise ValueError(
                    f"APT gradual mask update alpha must be 0.01 per paper, got {self.apt.mask_update_step}."
                )

            # Ensure config.yaml agrees with the paper-fixed constants.
            paper_rank = _as_int(_get_nested(paper_cfg, "apt.initial_rank", None), 8)
            if paper_rank != 8:
                raise ValueError(f"config.yaml apt.initial_rank must be 8, got {paper_rank}.")
            paper_scale = _as_float(_get_nested(paper_cfg, "apt.scaling_factor", None), 2.0)
            if paper_scale != 2.0:
                raise ValueError(f"config.yaml apt.scaling_factor must be 2, got {paper_scale}.")
            paper_alpha = _as_float(_get_nested(paper_cfg, "apt.mask_update_alpha", None), 0.01)
            if paper_alpha != 0.01:
                raise ValueError(f"config.yaml apt.mask_update_alpha must be 0.01, got {paper_alpha}.")

            # Enforce paper's cubic schedule declaration exists in config.yaml (schedule computed downstream).
            schedule = _get_nested(paper_cfg, "apt.target_sparsity_schedule", "")
            if str(schedule).strip().lower() != "cubic":
                raise ValueError("Paper config requires apt.target_sparsity_schedule == 'cubic' in config.yaml.")

            # Ensure target_sparsity is provided and in [0,1].
            if self.apt.target_sparsity <= 0.0 and self.apt.target_sparsity != 0.0:
                raise ValueError("apt.target_sparsity must be within [0, 1].")
            if not (0.0 <= self.apt.target_sparsity <= 1.0):
                raise ValueError(f"apt.target_sparsity must be within [0,1], got {self.apt.target_sparsity}.")

            # Pruning stage ratio is needed to define T (total pruning steps) consistently downstream.
            if self.apt.pruning_stage_ratio <= 0.0 or self.apt.pruning_stage_ratio > 1.0:
                raise ValueError(
                    "apt.pruning_stage_ratio must be specified explicitly in (0,1]. "
                    "It defines T for the cubic sparsity schedule."
                )

            # Salience EMA beta is required by algorithm but not numerically specified in the parsed paper/config.yaml.
            if self.apt.salience_ema_beta <= 0.0 or self.apt.salience_ema_beta >= 1.0:
                raise ValueError(
                    "apt.salience_ema_beta must be explicitly set in defaults or task config and be in (0,1). "
                    "config.yaml declares EMA usage but does not provide a numeric beta."
                )

            # Rank growth mode must be the paper rule:
            # eq: apt_rank_growth_rule
            r_apt = 8
            delta_t = 10.0
            delta_t_prime = 20.0
            r_prime = math.floor(r_apt * (delta_t_prime / delta_t))  # floor(r_apt * Δ'_t / Δ_t)
            if r_prime != 16:
                raise RuntimeError("Internal check failed for paper rank growth rule implementation.")

            if not self.apt.rank_growth_mode:
                # Store a canonical identifier for the paper rule.
                self.apt.rank_growth_mode = "paper_floor_ratio"
            if self.apt.rank_growth_mode != "paper_floor_ratio":
                raise ValueError(
                    f"apt.rank_growth_mode must be 'paper_floor_ratio' to match paper rule, "
                    f"got {self.apt.rank_growth_mode}."
                )

            # eq: apt_sparsity_schedule_cubic (expression must appear in validate)
            gamma_T = self.apt.target_sparsity
            t = 1.0
            T = 10.0
            gamma_t = gamma_T + (1.0 - gamma_T) * (1.0 - t / T) ** 3  # cubic schedule
            if not (0.0 <= gamma_t <= 1.0):
                raise ValueError("Computed gamma_t from cubic schedule must be within [0,1].")

        # ---- Distillation constraints from config.yaml (paper default) ----
        small_models_distill_default = _as_bool(
            _get_nested(paper_cfg, "distillation.enabled_for_small_models", True), True
        )
        large_models_distill_default = _as_bool(
            _get_nested(paper_cfg, "distillation.enabled_for_large_models", False), False
        )
        is_llama = _is_llama_backbone(self.model.backbone_name)

        if is_llama:
            # Paper uses distillation-free for large models (default false); enforce.
            if self.apt.use_self_distill:
                raise ValueError("For LLaMA experiments, apt.use_self_distill must be False per paper/config.yaml.")
            if self.model.use_ffn_adapters:
                raise ValueError("Paper implies FFN adapters are for smaller models; disable model.use_ffn_adapters.")
        else:
            # Default to enabled if APT is enabled and distill_epochs > 0.
            if self.apt.enable_apt and self.training.distill_epochs > 0:
                self.apt.use_self_distill = small_models_distill_default

        if is_llama and large_models_distill_default is not False:
            raise ValueError("config.yaml indicates distillation is disabled for large models; expected False.")

        # Distillation mu schedule and teacher sharing are paper-fixed (from config.yaml text).
        mu_schedule = str(_get_nested(paper_cfg, "distillation.mu_schedule", "linear_0_to_1")).strip()
        if not self.apt.distill_mu_schedule:
            self.apt.distill_mu_schedule = mu_schedule
        if self.apt.distill_mu_schedule != "linear_0_to_1":
            raise ValueError("distillation.mu_schedule must be 'linear_0_to_1' per paper/config.yaml.")
        teacher_share = _as_bool(_get_nested(paper_cfg, "distillation.teacher_setup.frozen_parameters_shared", True), True)
        self.apt.teacher_share_frozen = teacher_share

        # ---- Apply-on-modules selection (paper config.yaml apt_adapter_targets) ----
        targets_small = _get_nested(paper_cfg, "apt.apt_adapter_targets.small_models", [])
        targets_large = _get_nested(paper_cfg, "apt.apt_adapter_targets.large_models", [])
        if not isinstance(targets_small, list) or not isinstance(targets_large, list):
            raise ValueError("config.yaml apt.apt_adapter_targets.* must be lists.")
        if self.apt.enable_apt:
            if is_llama:
                self.apt.apply_on_modules = [str(x) for x in targets_large]
            else:
                # Honor model.use_ffn_adapters switch: include ffn_layers only if True.
                chosen = [str(x) for x in targets_small]
                if not self.model.use_ffn_adapters:
                    chosen = [m for m in chosen if m != "ffn_layers"]
                self.apt.apply_on_modules = chosen

        # ---- Resolve training regime and paper hyperparameters (Table 6) ----
        regime = _infer_training_regime(
            dataset_name=self.data.dataset_name,
            dataset_config_name=self.data.dataset_config_name,
            backbone_name=self.model.backbone_name,
        )

        # Enforce exact Table 6 values with literals.
        if regime in ("glue_small", "glue_big", "squad"):
            # eq: hp_lr_glue_small / hp_lr_glue_big / hp_lr_squad
            self.training.learning_rate = 2e-4
            # eq: hp_bs_glue
            self.data.batch_size = 32
            # eq: hp_epochs_glue
            self.training.num_epochs = 40
            # eq: hp_distill_epochs_glue
            self.training.distill_epochs = 20
        elif regime == "cnndm":
            # eq: hp_lr_cnndm
            self.training.learning_rate = 1e-4
            # eq: hp_bs_cnndm
            self.data.batch_size = 16
            # eq: hp_epochs_cnndm
            self.training.num_epochs = 16
            # eq: hp_distill_epochs_cnndm
            self.training.distill_epochs = 6
        elif regime == "alpaca":
            # eq: hp_lr_alpaca
            self.training.learning_rate = 1e-4
            self.data.batch_size = 32
            # eq: hp_epochs_alpaca
            self.training.num_epochs = 15
            # Distill epochs is null in config.yaml; represent as 0 in this codebase (no distillation).
            self.training.distill_epochs = 0
        else:
            raise ValueError(f"Unknown regime: {regime!r}")

        # Cross-check config.yaml matches the literals (verifiable hyperparameters).
        lr_map = _get_nested(paper_cfg, "training.learning_rate", {})
        bs_map = _get_nested(paper_cfg, "training.batch_size", {})
        ep_map = _get_nested(paper_cfg, "training.epochs", {})
        de_map = _get_nested(paper_cfg, "training.distill_epochs", {})

        if not isinstance(lr_map, dict) or not isinstance(bs_map, dict) or not isinstance(ep_map, dict):
            raise ValueError("config.yaml training.(learning_rate|batch_size|epochs) must be dicts by regime.")
        if not isinstance(de_map, dict):
            raise ValueError("config.yaml training.distill_epochs must be a dict by regime.")

        paper_lr = _as_float(lr_map.get(regime), -1.0)
        paper_bs = _as_int(bs_map.get(regime), -1)
        paper_ep = _as_int(ep_map.get(regime), -1)
        paper_de_raw = de_map.get(regime)
        paper_de = 0 if paper_de_raw is None else _as_int(paper_de_raw, -1)

        if abs(paper_lr - self.training.learning_rate) > 0.0:
            raise ValueError(f"config.yaml lr[{regime}]={paper_lr} does not match enforced paper literal.")
        if paper_bs != self.data.batch_size:
            raise ValueError(f"config.yaml batch_size[{regime}]={paper_bs} does not match enforced paper literal.")
        if paper_ep != self.training.num_epochs:
            raise ValueError(f"config.yaml epochs[{regime}]={paper_ep} does not match enforced paper literal.")
        if paper_de != self.training.distill_epochs:
            raise ValueError(f"config.yaml distill_epochs[{regime}]={paper_de} does not match enforced paper literal.")

        # ---- Eval batch size paper defaults (inference benchmarking) ----
        if self.data.eval_batch_size <= 0:
            self.data.eval_batch_size = _paper_inference_batch_size(paper_cfg, self.model.backbone_name)

        # Enforce paper batch sizes unless explicitly set (we still enforce to remain faithful).
        expected_eval_bs = _paper_inference_batch_size(paper_cfg, self.model.backbone_name)
        if self.data.eval_batch_size != expected_eval_bs:
            raise ValueError(
                f"data.eval_batch_size must match paper setting {expected_eval_bs} for backbone "
                f"{self.model.backbone_name!r}, got {self.data.eval_batch_size}."
            )

        # ---- Additional sanity constraints ----
        if self.training.learning_rate <= 0.0:
            raise ValueError("training.learning_rate must be > 0 after regime resolution.")
        if self.data.batch_size <= 0:
            raise ValueError("data.batch_size must be > 0 after regime resolution.")
        if self.training.num_epochs <= 0:
            raise ValueError("training.num_epochs must be > 0 after regime resolution.")
        if self.training.distill_epochs < 0:
            raise ValueError("training.distill_epochs must be >= 0.")
        if self.training.gradient_accumulation_steps <= 0:
            raise ValueError("training.gradient_accumulation_steps must be >= 1.")
        if self.training.warmup_ratio < 0.0 or self.training.warmup_ratio > 1.0:
            raise ValueError("training.warmup_ratio must be in [0,1].")

        # For APT runs, rank/prune update intervals are required for correct placement in pipeline.
        if self.apt.enable_apt:
            if self.apt.rank_update_interval <= 0:
                raise ValueError("apt.rank_update_interval must be specified explicitly and be > 0.")
            if self.apt.prune_update_interval <= 0:
                raise ValueError("apt.prune_update_interval must be specified explicitly and be > 0.")


_PAPER_CFG_CACHE: Optional[Dict[str, Any]] = None


## @brief Load the global paper configuration (config.yaml) with caching.
# @return dict[str, Any] Parsed config.yaml.
def _load_paper_config() -> Dict[str, Any]:
    global _PAPER_CFG_CACHE
    if _PAPER_CFG_CACHE is not None:
        return _PAPER_CFG_CACHE

    # Prefer CWD config.yaml; fallback to repo root relative to this file.
    candidates = [
        Path(os.getcwd()) / "config.yaml",
        Path(__file__).resolve().parents[1] / "config.yaml",  # repo_root/config.yaml (src/..)
        Path(__file__).resolve().parents[2] / "config.yaml",
    ]
    for p in candidates:
        if p.exists():
            _PAPER_CFG_CACHE = load_yaml(str(p))
            return _PAPER_CFG_CACHE
    raise FileNotFoundError(
        "Cannot find required global paper config.yaml in current working directory or parents of src/."
    )


## @brief Build an ExperimentConfig from YAML with correct precedence and validation.
# @param path str Path to task-specific config YAML.
# @return ExperimentConfig Fully built and validated config.
def build_config(path: str) -> ExperimentConfig:
    paper_cfg = _load_paper_config()

    # Resolve configs/default.yaml similarly (optional).
    candidates_default = [
        Path(os.getcwd()) / "configs" / "default.yaml",
        Path(__file__).resolve().parents[1] / "configs" / "default.yaml",
        Path(__file__).resolve().parents[2] / "configs" / "default.yaml",
    ]
    default_cfg: Dict[str, Any] = {}
    for p in candidates_default:
        if p.exists():
            default_cfg = load_yaml(str(p))
            break

    exp_cfg = load_yaml(path)

    merged = deep_merge_dicts(default_cfg, paper_cfg)
    merged = deep_merge_dicts(merged, exp_cfg)

    # Map merged dict -> dataclasses.
    model = _build_model_config(merged)
    data = _build_data_config(merged)
    training = _build_training_config(merged)
    apt = _build_apt_config(merged, paper_cfg, model)
    evaluation = _build_eval_config(merged)
    runtime = _build_runtime_config(merged)

    cfg = ExperimentConfig(
        model=model,
        data=data,
        training=training,
        apt=apt,
        evaluation=evaluation,
        runtime=runtime,
    )
    cfg.validate()
    return cfg


## @brief Build ModelConfig from merged dict.
# @param merged dict[str, Any] Merged configuration dictionary.
# @return ModelConfig Parsed ModelConfig.
def _build_model_config(merged: Dict[str, Any]) -> ModelConfig:
    m = _get_nested(merged, "model", {})
    if not isinstance(m, dict):
        m = {}
    return ModelConfig(
        backbone_name=str(m.get("backbone_name", "")),
        task_type=str(m.get("task_type", "")),
        max_length=_as_int(m.get("max_length", 0), 0),
        num_labels=_as_int(m.get("num_labels", 0), 0),
        use_ffn_adapters=_as_bool(m.get("use_ffn_adapters", False), False),
        trust_remote_code=_as_bool(m.get("trust_remote_code", False), False),
    )


## @brief Build DataConfig from merged dict.
# @param merged dict[str, Any] Merged configuration dictionary.
# @return DataConfig Parsed DataConfig.
def _build_data_config(merged: Dict[str, Any]) -> DataConfig:
    d = _get_nested(merged, "data", {})
    if not isinstance(d, dict):
        d = {}
    text_fields_raw = d.get("text_fields", [])
    if text_fields_raw is None:
        text_fields: List[str] = []
    elif isinstance(text_fields_raw, list):
        text_fields = [str(x) for x in text_fields_raw]
    else:
        raise ValueError("data.text_fields must be a list[str].")

    return DataConfig(
        dataset_name=str(d.get("dataset_name", "")),
        dataset_config_name=str(d.get("dataset_config_name", "")),
        train_split=str(d.get("train_split", "train")),
        validation_split=str(d.get("validation_split", "validation")),
        text_fields=text_fields,
        label_field=str(d.get("label_field", "label")),
        max_source_length=_as_int(d.get("max_source_length", 0), 0),
        max_target_length=_as_int(d.get("max_target_length", 0), 0),
        batch_size=_as_int(d.get("batch_size", 0), 0),
        eval_batch_size=_as_int(d.get("eval_batch_size", 0), 0),
    )


## @brief Build TrainingConfig from merged dict.
# @details Values like learning_rate/epochs/batch_size are regime-resolved in ExperimentConfig.validate().
# @param merged dict[str, Any] Merged configuration dictionary.
# @return TrainingConfig Parsed TrainingConfig.
def _build_training_config(merged: Dict[str, Any]) -> TrainingConfig:
    t = _get_nested(merged, "training", {})
    if not isinstance(t, dict):
        t = {}

    # If the merged YAML still contains regime dicts (from config.yaml), ignore here and resolve later.
    lr_val = t.get("learning_rate", 0.0)
    lr = _as_float(lr_val, 0.0) if isinstance(lr_val, (int, float, str)) else 0.0

    epochs_val = t.get("epochs", t.get("num_epochs", 0))
    epochs = _as_int(epochs_val, 0) if isinstance(epochs_val, (int, float, str)) else 0

    distill_epochs_val = t.get("distill_epochs", 0)
    distill_epochs = _as_int(distill_epochs_val, 0) if isinstance(distill_epochs_val, (int, float, str)) else 0

    return TrainingConfig(
        learning_rate=lr,
        weight_decay=_as_float(t.get("weight_decay", 0.0), 0.0),
        num_epochs=epochs,
        distill_epochs=distill_epochs,
        gradient_accumulation_steps=_as_int(t.get("gradient_accumulation_steps", 1), 1),
        warmup_ratio=_as_float(t.get("warmup_ratio", 0.0), 0.0),
        max_grad_norm=_as_float(t.get("max_grad_norm", 0.0), 0.0),
        optimizer_name=str(t.get("optimizer_name", "adamw")),
        lr_scheduler_type=str(t.get("lr_scheduler_type", "linear")),
        fp16=_as_bool(t.get("fp16", False), False),
        bf16=_as_bool(t.get("bf16", False), False),
        eval_every_steps=_as_int(t.get("eval_every_steps", 0), 0),
        save_every_steps=_as_int(t.get("save_every_steps", 0), 0),
        seed=_as_int(t.get("seed", 42), 42),
    )


## @brief Build APTConfig from merged dict and paper_cfg.
# @param merged dict[str, Any] Merged configuration dictionary.
# @param paper_cfg dict[str, Any] Parsed global paper config.yaml.
# @param model ModelConfig Model configuration for model-family decisions.
# @return APTConfig Parsed APTConfig.
def _build_apt_config(merged: Dict[str, Any], paper_cfg: Dict[str, Any], model: ModelConfig) -> APTConfig:
    a = _get_nested(merged, "apt", {})
    if not isinstance(a, dict):
        a = {}

    # Map config.yaml apt.scaling_factor -> APTConfig.lora_alpha (design field name).
    scaling_factor = a.get("scaling_factor", _get_nested(paper_cfg, "apt.scaling_factor", 0.0))
    lora_alpha = _as_float(scaling_factor, 0.0) if isinstance(scaling_factor, (int, float, str)) else 0.0

    # target_sparsity is experiment-specific; must be supplied by task config for APT runs.
    target_sparsity_val = a.get("target_sparsity", a.get("gamma_T", 0.0))
    target_sparsity = _as_float(target_sparsity_val, 0.0)

    apply_on_modules_raw = a.get("apply_on_modules", None)
    if apply_on_modules_raw is None:
        apply_on_modules: List[str] = []
    elif isinstance(apply_on_modules_raw, list):
        apply_on_modules = [str(x) for x in apply_on_modules_raw]
    else:
        raise ValueError("apt.apply_on_modules must be a list[str].")

    return APTConfig(
        enable_apt=_as_bool(a.get("enable_apt", False), False),
        target_sparsity=target_sparsity,
        initial_rank=_as_int(a.get("initial_rank", _get_nested(paper_cfg, "apt.initial_rank", 0)), 0),
        lora_alpha=lora_alpha,
        mask_update_step=_as_float(a.get("mask_update_alpha", a.get("mask_update_step", 0.0)), 0.0),
        salience_ema_beta=_as_float(a.get("salience_ema_beta", 0.0), 0.0),
        pruning_stage_ratio=_as_float(a.get("pruning_stage_ratio", 0.0), 0.0),
        rank_update_interval=_as_int(a.get("rank_update_interval", 0), 0),
        prune_update_interval=_as_int(a.get("prune_update_interval", 0), 0),
        rank_growth_mode=str(a.get("rank_growth_mode", "")),
        use_kurtosis=_as_bool(a.get("use_kurtosis", True), True),
        use_self_distill=_as_bool(a.get("use_self_distill", False), False),
        distill_mu_schedule=str(a.get("distill_mu_schedule", "linear_0_to_1")),
        teacher_share_frozen=_as_bool(a.get("teacher_share_frozen", True), True),
        apply_on_modules=apply_on_modules,
    )


## @brief Build EvalConfig from merged dict.
# @param merged dict[str, Any] Merged configuration dictionary.
# @return EvalConfig Parsed EvalConfig.
def _build_eval_config(merged: Dict[str, Any]) -> EvalConfig:
    e = _get_nested(merged, "evaluation", {})
    if not isinstance(e, dict):
        e = {}

    metrics_raw = e.get("metrics", [])
    if metrics_raw is None:
        metrics: List[str] = []
    elif isinstance(metrics_raw, list):
        metrics = [str(x) for x in metrics_raw]
    else:
        raise ValueError("evaluation.metrics must be a list[str].")

    lm_tasks_raw = e.get("lm_eval_tasks", [])
    if lm_tasks_raw is None:
        lm_tasks: List[str] = []
    elif isinstance(lm_tasks_raw, list):
        lm_tasks = [str(x) for x in lm_tasks_raw]
    else:
        raise ValueError("evaluation.lm_eval_tasks must be a list[str].")

    fewshot_raw = e.get("lm_eval_num_fewshot", {})
    if fewshot_raw is None:
        fewshot: Dict[str, int] = {}
    elif isinstance(fewshot_raw, dict):
        fewshot = {str(k): _as_int(v, 0) for k, v in fewshot_raw.items()}
    else:
        raise ValueError("evaluation.lm_eval_num_fewshot must be a dict[str,int].")

    return EvalConfig(
        metrics=metrics,
        measure_train_peak_memory=_as_bool(e.get("measure_train_peak_memory", True), True),
        measure_inference_peak_memory=_as_bool(e.get("measure_inference_peak_memory", True), True),
        measure_throughput=_as_bool(e.get("measure_throughput", True), True),
        lm_eval_tasks=lm_tasks,
        lm_eval_num_fewshot=fewshot,
    )


## @brief Build RuntimeConfig from merged dict.
