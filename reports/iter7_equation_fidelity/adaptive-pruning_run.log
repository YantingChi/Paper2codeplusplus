## src/utils/logging.py
from __future__ import annotations

import dataclasses
import datetime as _dt
import json
import logging
import os
from pathlib import Path
from typing import Any, Dict, Mapping, MutableMapping, Optional, Union


## @brief Parse a log level name into a logging level integer.
# @param level_name str Log level name (e.g., "INFO", "DEBUG").
# @param default int Default logging level if parsing fails.
# @return int Parsed logging level.
def _parse_level(level_name: str, default: int) -> int:
    name = (level_name or "").strip().upper()
    if not name:
        return default
    level = logging.getLevelName(name)
    if isinstance(level, int):
        return level
    return default


## @brief Read environment variables for log level configuration.
# @details Supports APT_LOG_LEVEL; defaults to INFO.
# @return int Logging level.
def _level_from_env() -> int:
    env_val = os.environ.get("APT_LOG_LEVEL", "").strip()
    return _parse_level(env_val, logging.INFO)


## @brief Return a UTC ISO timestamp string.
# @return str UTC timestamp in ISO format with 'Z'.
def _utc_timestamp() -> str:
    return _dt.datetime.utcnow().replace(tzinfo=_dt.timezone.utc).isoformat().replace("+00:00", "Z")


## @brief Convert objects into JSON-serializable forms.
# @details Handles Path, dataclasses, sets, bytes, numpy-like scalars/arrays (via .item/.tolist),
# and falls back to str() for unknown objects.
# @param obj Any Input object.
# @return Any JSON-serializable object.
def _to_jsonable(obj: Any) -> Any:
    if obj is None:
        return None
    if isinstance(obj, (str, int, float, bool)):
        return obj
    if isinstance(obj, Path):
        return str(obj)
    if dataclasses.is_dataclass(obj):
        return dataclasses.asdict(obj)
    if isinstance(obj, (list, tuple)):
        return [_to_jsonable(x) for x in obj]
    if isinstance(obj, set):
        return sorted([_to_jsonable(x) for x in obj], key=lambda x: str(x))
    if isinstance(obj, Mapping):
        return {str(k): _to_jsonable(v) for k, v in obj.items()}
    if isinstance(obj, bytes):
        # Preserve determinism and avoid binary in logs.
        return obj.decode("utf-8", errors="replace")

    # Numpy-like scalar: np.int64, np.float32, etc.
    item = getattr(obj, "item", None)
    if callable(item):
        try:
            return _to_jsonable(item())
        except Exception:
            pass

    # Numpy-like / Tensor-like arrays: prefer tolist() if small-ish.
    tolist = getattr(obj, "tolist", None)
    if callable(tolist):
        try:
            return _to_jsonable(tolist())
        except Exception:
            pass

    # Fallback (keeps logging robust; do not raise from logging).
    return str(obj)


## @brief Flatten nested dicts into a single-level dict with slash-separated keys.
# @details Used only for compact console summaries; does not mutate input.
# @param d dict[str, Any] Input dictionary.
# @param prefix str Key prefix.
# @return dict[str, Any] Flattened dictionary.
def _flatten_dict(d: Dict[str, Any], prefix: str = "") -> Dict[str, Any]:
    out: Dict[str, Any] = {}
    for k, v in d.items():
        key = f"{prefix}/{k}" if prefix else str(k)
        if isinstance(v, dict):
            out.update(_flatten_dict(v, prefix=key))
        else:
            out[key] = v
    return out


## @brief Configure a logger with a consistent formatter and without duplicate handlers.
# @param logger logging.Logger Target logger.
# @return logging.Logger Configured logger.
def _configure_logger(logger: logging.Logger) -> logging.Logger:
    if getattr(logger, "_apt_configured", False):
        return logger

    logger.setLevel(_level_from_env())
    logger.propagate = False

    # Avoid adding duplicate stream handlers when get_logger() is called repeatedly.
    if not any(isinstance(h, logging.StreamHandler) for h in logger.handlers):
        handler = logging.StreamHandler()
        handler.setLevel(_level_from_env())
        formatter = logging.Formatter(
            fmt="%(asctime)sZ | %(levelname)s | %(name)s | %(message)s",
            datefmt="%Y-%m-%dT%H:%M:%S",
        )
        # logging.Formatter uses local time by default; we stamp 'Z' in format for consistency.
        handler.setFormatter(formatter)
        logger.addHandler(handler)

    setattr(logger, "_apt_configured", True)
    return logger


## @brief Get a configured logger.
# @details Returns a named logger with consistent formatting and handler de-duplication.
# @param name str Logger name.
# @return logging.Logger Configured logger instance.
def get_logger(name: str) -> logging.Logger:
    return _configure_logger(logging.getLogger(name))


## @brief Serialize an experiment config to a stable dictionary.
# @details Accepts dataclass-based configs (preferred), dict-like configs, or plain objects.
# @param config Any ExperimentConfig-like object.
# @return dict[str, Any] JSON-serializable dictionary representation.
def _config_to_dict(config: Any) -> Dict[str, Any]:
    if config is None:
        return {}
    if dataclasses.is_dataclass(config):
        return _to_jsonable(config)
    if isinstance(config, dict):
        return _to_jsonable(config)
    d = getattr(config, "__dict__", None)
    if isinstance(d, dict):
        return _to_jsonable(d)
    return {"config": _to_jsonable(config)}


## @brief Save an object to a JSON file with reproducible formatting.
# @details Creates parent directories, writes UTF-8 JSON, sorts keys, and uses indent=2.
# @param path str | Path Output path.
# @param obj Any Object to save (will be converted to JSON-serializable types).
# @return None
def save_json(path: Union[str, Path], obj: Any) -> None:
    out_path = Path(path)
    out_path.parent.mkdir(parents=True, exist_ok=True)
    payload = _to_jsonable(obj)
    with out_path.open("w", encoding="utf-8") as f:
        json.dump(payload, f, ensure_ascii=False, indent=2, sort_keys=True)


## @brief Log the effective experiment configuration for reproducibility.
# @details Logs a console headline and saves a full JSON config artifact under runtime.output_dir.
# @param config Any ExperimentConfig instance.
# @return None
def log_config(config: Any) -> None:
    logger = get_logger("apt.config")
    cfg_dict = _config_to_dict(config)

    # Extract common headline fields defensively (no imports from src/config.py to avoid cycles).
    model = cfg_dict.get("model", {}) if isinstance(cfg_dict.get("model", {}), dict) else {}
    data = cfg_dict.get("data", {}) if isinstance(cfg_dict.get("data", {}), dict) else {}
    training = cfg_dict.get("training", {}) if isinstance(cfg_dict.get("training", {}), dict) else {}
    apt = cfg_dict.get("apt", {}) if isinstance(cfg_dict.get("apt", {}), dict) else {}
    runtime = cfg_dict.get("runtime", {}) if isinstance(cfg_dict.get("runtime", {}), dict) else {}

    backbone = str(model.get("backbone_name", ""))
    task_type = str(model.get("task_type", ""))
    dataset_name = str(data.get("dataset_name", ""))
    dataset_cfg = str(data.get("dataset_config_name", ""))
    output_dir = str(runtime.get("output_dir", "outputs"))

    enable_apt = bool(apt.get("enable_apt", False))
    target_sparsity = apt.get("target_sparsity", None)
    initial_rank = apt.get("initial_rank", None)
    scaling_factor = apt.get("lora_alpha", None)
    mask_alpha = apt.get("mask_update_step", None)
    use_self_distill = bool(apt.get("use_self_distill", False))
    eval_bs = data.get("eval_batch_size", None)
    train_bs = data.get("batch_size", None)
    lr = training.get("learning_rate", None)
    epochs = training.get("num_epochs", None)
    distill_epochs = training.get("distill_epochs", None)

    logger.info(
        "Run config | backbone=%s | task=%s | dataset=%s/%s | out=%s",
        backbone,
        task_type,
        dataset_name,
        dataset_cfg,
        output_dir,
    )
    logger.info(
        "Training | lr=%s | train_bs=%s | epochs=%s | distill_epochs=%s | eval_bs=%s",
        lr,
        train_bs,
        epochs,
        distill_epochs,
        eval_bs,
    )
    logger.info(
        "APT | enabled=%s | target_sparsity=%s | init_rank=%s | scaling_factor=%s | mask_alpha=%s | self_distill=%s",
        enable_apt,
        target_sparsity,
        initial_rank,
        scaling_factor,
        mask_alpha,
        use_self_distill,
    )

    # Persist full effective config.
    artifact_path = Path(output_dir) / "config_effective.json"
    save_json(artifact_path, cfg_dict)
    logger.info("Saved effective config JSON: %s", str(artifact_path))


## @brief Log metrics in a standardized schema to the console.
# @details The caller (trainer/evaluator) is responsible for persisting metrics via save_json
# if needed; this function remains side-effect-light and does not assume output directories.
# @param metrics dict[str, float] Metric dictionary.
# @param step int Global step or epoch index.
# @param split str Split name (train|eval|test|inference_bench|...).
# @return None
def log_metrics(metrics: Dict[str, float], step: int, split: str) -> None:
    logger = get_logger("apt.metrics")
    safe_metrics: Dict[str, Any] = _to_jsonable(metrics) if isinstance(metrics, dict) else {"metrics": _to_jsonable(metrics)}
    flat = _flatten_dict(safe_metrics if isinstance(safe_metrics, dict) else {"metrics": safe_metrics})

    # Compact, deterministic console string.
    keys = sorted(flat.keys())
    parts = []
    for k in keys:
        v = flat[k]
        if isinstance(v, float):
            parts.append(f"{k}={v:.6g}")
        else:
            parts.append(f"{k}={v}")
    msg = " | ".join(parts)
    logger.info("step=%d | split=%s | %s", int(step), str(split), msg)


