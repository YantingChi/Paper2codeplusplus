## @brief Teacher view that shares frozen weights and swaps in snapshot adapter parameters/masks.
# @details This implements the paper's efficient self-knowledge distillation setup:
# frozen parameters are shared by reference, while tunable APT adapters are duplicated as a snapshot.
class _AdapterSnapshotTeacher:
    ## @brief Create a teacher view from an APTModelWrapper.
    # @param apt_model APTModelWrapper Student model wrapper whose frozen weights are shared.
    # @param snapshot dict[str, dict[str, torch.Tensor]] Snapshot of adapter params and masks per module name.
    def __init__(self, apt_model: APTModelWrapper, snapshot: Dict[str, Dict[str, torch.Tensor]]) -> None:
        if apt_model is None:
            raise ValueError("apt_model must be non-None.")
        if snapshot is None or not isinstance(snapshot, dict):
            raise ValueError("snapshot must be a dict.")
        self._apt_model: APTModelWrapper = apt_model
        self._snapshot: Dict[str, Dict[str, torch.Tensor]] = snapshot

        # Cache name->module mapping for fast swap.
        self._named_modules: List[Tuple[str, APTLinear]] = self._apt_model.named_apt_modules()
        self._name_to_module: Dict[str, APTLinear] = {n: m for n, m in self._named_modules}

    ## @brief Run a teacher forward pass with snapshot adapters/masks.
    # @details Runs under torch.no_grad() and enforces output_hidden_states=True for layer loss.
    # @param kwargs dict[str, Any] Model keyword arguments.
    # @return Any Hugging Face model outputs.
    def __call__(self, **kwargs: Any) -> Any:
        return self.forward(**kwargs)

    ## @brief Forward method for teacher view.
    # @param kwargs dict[str, Any] Model keyword arguments.
    # @return Any Model outputs.
    def forward(self, **kwargs: Any) -> Any:
        # Ensure hidden states exist for layer loss.
        kwargs2: Dict[str, Any] = dict(kwargs)
        kwargs2["output_hidden_states"] = True

        # Swapping plan: swap .data pointers for adapter params and mask buffers (no copies per step).
        swap_records: List[Tuple[torch.Tensor, torch.Tensor]] = []

        try:
            for name, module in self._named_modules:
                if name not in self._snapshot:
                    continue
                snap = self._snapshot[name]

                # Adapter params in APTLinear implementation.
                lora_A: Optional[torch.Tensor] = getattr(module, "lora_A", None)
                lora_B: Optional[torch.Tensor] = getattr(module, "lora_B", None)
                if lora_A is None or lora_B is None:
                    continue

                snap_A = snap.get("lora_A", None)
                snap_B = snap.get("lora_B", None)
                if snap_A is None or snap_B is None:
                    continue

                if tuple(lora_A.data.shape) != tuple(snap_A.shape) or tuple(lora_B.data.shape) != tuple(snap_B.shape):
                    raise ValueError(
                        "Teacher snapshot shape mismatch for adapter params. "
                        f"module={name!r}, student_A={tuple(lora_A.data.shape)}, teacher_A={tuple(snap_A.shape)}, "
                        f"student_B={tuple(lora_B.data.shape)}, teacher_B={tuple(snap_B.shape)}. "
                        "Rebuild teacher after any adapter rank/shape change."
                    )

                # Swap lora_A and lora_B.
                swap_records.append((lora_A.data, snap_A))
                lora_A.data = snap_A
                swap_records.append((lora_B.data, snap_B))
                lora_B.data = snap_B

                # Masks are buffers in APTLinear: _input_mask and _output_mask.
                mi: Optional[torch.Tensor] = getattr(module, "_input_mask", None)
                mo: Optional[torch.Tensor] = getattr(module, "_output_mask", None)
                snap_mi = snap.get("_input_mask", None)
                snap_mo = snap.get("_output_mask", None)

                if mi is not None and mo is not None and snap_mi is not None and snap_mo is not None:
                    if tuple(mi.data.shape) != tuple(snap_mi.shape) or tuple(mo.data.shape) != tuple(snap_mo.shape):
                        raise ValueError(
                            "Teacher snapshot shape mismatch for masks. "
                            f"module={name!r}, student_mi={tuple(mi.data.shape)}, teacher_mi={tuple(snap_mi.shape)}, "
                            f"student_mo={tuple(mo.data.shape)}, teacher_mo={tuple(snap_mo.shape)}. "
                            "Rebuild teacher after any mask-shape change."
                        )
                    swap_records.append((mi.data, snap_mi))
                    mi.data = snap_mi
                    swap_records.append((mo.data, snap_mo))
                    mo.data = snap_mo

            with torch.no_grad():
                return self._apt_model(**kwargs2)
        finally:
            # Restore swapped tensors in reverse order.
            # Each record is (original_tensor, swapped_in_tensor). We need to swap back by assigning .data.
            # Because we set param.data = snap_tensor, we restore by param.data = original_tensor, but we no
            # longer have param objects here. Therefore we restore by re-running swap in reverse with stored
            # references: the current .data pointer equals swapped_in_tensor, so we can swap back by assignment
            # to the original pointer on the same Tensor reference.
            #
            # The simplest safe restoration is: for each swap, swap back by exchanging .data pointers on the
            # Tensor objects themselves. Here, 'original_tensor' is the prior pointer value and 'swapped_in_tensor'
            # is the snapshot pointer; we restore by swapping their contents via pointer reassignment back where
            # possible by direct assignment on the Parameters/buffers already handled above. We already lost those
            # handles, so we instead rely on the fact that the Parameters/buffers now reference snapshot pointers;
            # we restore by re-iterating modules and assigning from stored original tensors.
            #
            # To keep restoration explicit and reliable, we redo the module iteration and assign from snapshot dict.
            for name, module in self._named_modules:
                if name not in self._snapshot:
                    continue
                snap = self._snapshot[name]

                lora_A: Optional[torch.Tensor] = getattr(module, "lora_A", None)
                lora_B: Optional[torch.Tensor] = getattr(module, "lora_B", None)
                snap_A = snap.get("lora_A", None)
                snap_B = snap.get("lora_B", None)

                # If the teacher forward succeeded, module.lora_*.data currently points at snap_*.
                # Restore by copying from snap-backup-of-student that was stored in snap dict.
                # We store student originals under keys "student_lora_A" and "student_lora_B" for restoration.
                # If missing (e.g., if teacher was never called), skip.
                if lora_A is not None and snap_A is not None:
                    student_A = snap.get("student_lora_A", None)
                    if student_A is not None:
                        lora_A.data = student_A
                if lora_B is not None and snap_B is not None:
                    student_B = snap.get("student_lora_B", None)
                    if student_B is not None:
                        lora_B.data = student_B

                mi: Optional[torch.Tensor] = getattr(module, "_input_mask", None)
                mo: Optional[torch.Tensor] = getattr(module, "_output_mask", None)
                if mi is not None:
                    student_mi = snap.get("student__input_mask", None)
                    if student_mi is not None:
                        mi.data = student_mi
                if mo is not None:
                    student_mo = snap.get("student__output_mask", None)
                    if student_mo is not None:
                        mo.data = student_mo


## @brief Efficient self-knowledge distillation manager for APT (Sec. 4.4).
# @details Implements:
#  - build_teacher() for shared-frozen, duplicated-tuning teacher setup
#  - compute_mu() linear schedule 0->1
#  - compute_loss() using Eq. (7) total loss and layer-wise MSE loss
class DistillationManager:
    ## @brief Initialize a DistillationManager.
    # @param apt_model APTModelWrapper Student model wrapper.
    # @param apt_config APTConfig APT configuration controlling distillation behavior.
    def __init__(self, apt_model: APTModelWrapper, apt_config: APTConfig) -> None:
        if apt_model is None:
            raise ValueError("apt_model must be non-None.")
        if apt_config is None:
            raise ValueError("apt_config must be non-None.")

        self._logger = get_logger("apt.distill")
        self._apt_model: APTModelWrapper = apt_model
        self._apt_config: APTConfig = apt_config

        if not bool(getattr(self._apt_config, "use_self_distill", False)):
            raise ValueError("DistillationManager instantiated but apt_config.use_self_distill is False.")

        paper_cfg = _load_paper_config()
        mu_schedule = str(_get_nested(paper_cfg, "distillation.mu_schedule", "linear_0_to_1")).strip()
        if mu_schedule != "linear_0_to_1":
            raise ValueError("config.yaml distillation.mu_schedule must be 'linear_0_to_1'.")

        shared = _as_bool(_get_nested(paper_cfg, "distillation.teacher_setup.frozen_parameters_shared", True), True)
        if bool(getattr(self._apt_config, "teacher_share_frozen", True)) != bool(shared):
            raise ValueError(
                "Mismatch between apt_config.teacher_share_frozen and config.yaml "
                "distillation.teacher_setup.frozen_parameters_shared."
            )

        # Cache for layer mapping (updated per-stack during compute_loss).
        self._cached_teacher_layers: int = 0
        self._cached_student_layers: int = 0

        # Current teacher callable.
        self._teacher: Optional[Any] = None

    ## @brief Build and return a teacher model/view for self-distillation.
    # @details If teacher_share_frozen is true (paper/config.yaml), returns a teacher view that shares
    # frozen weights and swaps in a snapshot of adapter parameters and masks.
    # @return Any A callable teacher object compatible with teacher(**batch)->outputs.
    def build_teacher(self) -> Any:
        if bool(getattr(self._apt_config, "teacher_share_frozen", True)):
            snapshot: Dict[str, Dict[str, torch.Tensor]] = {}
            for name, module in self._apt_model.named_apt_modules():
                if module is None:
                    continue

                # Store snapshot of teacher adapter params/masks (detached clone, same device/dtype).
                lora_A: Optional[torch.Tensor] = getattr(module, "lora_A", None)
                lora_B: Optional[torch.Tensor] = getattr(module, "lora_B", None)
                if lora_A is None or lora_B is None:
                    continue
                mi: Optional[torch.Tensor] = getattr(module, "_input_mask", None)
                mo: Optional[torch.Tensor] = getattr(module, "_output_mask", None)

                # Also store current student tensors for restoration by pointer swap.
                entry: Dict[str, torch.Tensor] = {
                    "lora_A": lora_A.detach().clone(),
                    "lora_B": lora_B.detach().clone(),
                    "student_lora_A": lora_A.data,
                    "student_lora_B": lora_B.data,
                }
                if mi is not None and mo is not None:
                    entry["_input_mask"] = mi.detach().clone()
                    entry["_output_mask"] = mo.detach().clone()
                    entry["student__input_mask"] = mi.data
                    entry["student__output_mask"] = mo.data

                snapshot[name] = entry

            teacher = _AdapterSnapshotTeacher(apt_model=self._apt_model, snapshot=snapshot)
            self._teacher = teacher
            self._logger.info("Built snapshot teacher with %d APT modules.", int(len(snapshot)))
            return teacher

        # Non-sharing teacher: deep copy the underlying model (memory-heavy; not used by paper defaults).
        teacher_model = copy.deepcopy(self._apt_model.model)
        for p in teacher_model.parameters():
            p.requires_grad_(False)
        teacher_model.eval()
        self._teacher = teacher_model
        self._logger.info("Built deep-copied teacher model (teacher_share_frozen=false).")
        return teacher_model

    ## @brief Compute the distillation coefficient μ using a linear schedule from 0 to 1.
    # @details Per config.yaml/paper: "mu_schedule: linear_0_to_1".
    # @param global_step int Current distillation step.
    # @param total_steps int Total distillation steps.
    # @return float μ in [0,1].
    def compute_mu(self, global_step: int, total_steps: int) -> float:
        t: float = float(max(0, int(global_step)))
        T: float = float(max(1, int(total_steps)))
        mu: float = t / T
        if mu < 0.0:
            mu = 0.0
        if mu > 1.0:
            mu = 1.0
        return float(mu)

    ## @brief Compute the combined supervised + distillation losses (Eq. (7)).
    # @details Implements:
    #  - Eq. (7): L = μ L_distill + (1-μ) L_ft
    #  - Eq. (7): L_layer = Σ_i MSE(Tr(H_s^{φ(i)}), H_t^i)
    # Here Tr is implemented as identity (initialized as I per config.yaml); training Tr is not
    # represented in this codebase's optimizer wiring.
    # @param student_outputs Any Hugging Face outputs for student.
    # @param teacher_outputs Any Hugging Face outputs for teacher.
    # @param batch dict Batch used to compute student loss (must include labels so outputs.loss exists).
    # @param mu float Distillation coefficient μ.
    # @return DistillLossOutput Loss components.
    def compute_loss(
        self,
        student_outputs: Any,
        teacher_outputs: Any,
        batch: Dict[str, Any],
        mu: float,
    ) -> DistillLossOutput:
        if student_outputs is None or teacher_outputs is None:
            raise ValueError("student_outputs and teacher_outputs must be non-None.")
        if batch is None or not isinstance(batch, dict):
            raise ValueError("batch must be a dict.")
        mu_f: float = float(mu)
        if mu_f < 0.0:
            mu_f = 0.0
        if mu_f > 1.0:
            mu_f = 1.0

        # Supervised fine-tuning loss L_ft: require model-provided loss.
        task_loss: Optional[torch.Tensor] = getattr(student_outputs, "loss", None)
        if task_loss is None or not torch.is_tensor(task_loss):
            raise ValueError(
                "student_outputs.loss is required for L_ft but is missing. "
                "Ensure batches include labels and the model returns loss."
            )

        # Layer loss L_layer (Eq. (7)): sum of per-layer MSE over mapped teacher->student layers.
        layer_loss: torch.Tensor = self._compute_layer_loss(student_outputs=student_outputs, teacher_outputs=teacher_outputs)

        # Distillation loss L_distill: in this implementation, it is the layer loss defined explicitly by Eq. (7).
        distill_loss: torch.Tensor = layer_loss

        # Eq. (7) total loss:
        # eq: apt_distill_total_eq7
        total_loss: torch.Tensor = (mu_f * distill_loss) + ((1.0 - mu_f) * task_loss)

        # Expose components for logging/ablation.
        return DistillLossOutput(
            total_loss=total_loss,
            task_loss=task_loss,
            distill_loss=distill_loss,
            layer_loss=layer_loss,
        )

    ## @brief Map teacher layers to student layers by closest index (ϕ).
    # @details Paper: ϕ matches teacher layer to its closest, non-pruned student layer.
    # Since this codebase prunes heads/neurons/dimensions (not whole layers), "non-pruned layer"
    # defaults to all layers existing; thus "closest" reduces to nearest index mapping.
    #
    # The mapping is computed using cached layer counts set by _compute_layer_loss_stack():
    #  - teacher length = self._cached_teacher_layers
    #  - student length = self._cached_student_layers
    # @return dict[int, int] Mapping ϕ(i): teacher_index -> student_index.
    def map_teacher_to_student_layers(self) -> Dict[int, int]:
        n_t: int = int(self._cached_teacher_layers)
        n_s: int = int(self._cached_student_layers)
        if n_t <= 0 or n_s <= 0:
            return {}

        mapping: Dict[int, int] = {}
        if n_t == 1:
            mapping[0] = 0
            return mapping

        # Nearest-index mapping on [0..n_t-1] scaled to [0..n_s-1].
        for i in range(n_t):
            if n_t == 1:
                j = 0
            else:
                # "closest" mapping from teacher index i to student index j.
                j = int(round(float(i) * float(max(0, n_s - 1)) / float(max(1, n_t - 1))))
            if j < 0:
                j = 0
            if j > n_s - 1:
                j = n_s - 1
            mapping[int(i)] = int(j)
        return mapping

    ## @brief Extract hidden-state stacks from HF outputs for layer loss computation.
    # @param outputs Any Hugging Face model outputs.
    # @return list[tuple[str, tuple[torch.Tensor, ...]]] Named hidden state stacks.
    def _extract_hidden_state_stacks(self, outputs: Any) -> List[Tuple[str, Tuple[torch.Tensor, ...]]]:
        stacks: List[Tuple[str, Tuple[torch.Tensor, ...]]] = []

        hs = getattr(outputs, "hidden_states", None)
        if isinstance(hs, (tuple, list)) and len(hs) > 0 and torch.is_tensor(hs[0]):
            stacks.append(("hidden_states", tuple(hs)))

        # Seq2seq outputs may separately expose encoder/decoder hidden states.
        enc_hs = getattr(outputs, "encoder_hidden_states", None)
        dec_hs = getattr(outputs, "decoder_hidden_states", None)
        if isinstance(enc_hs, (tuple, list)) and len(enc_hs) > 0 and torch.is_tensor(enc_hs[0]):
            stacks.append(("encoder_hidden_states", tuple(enc_hs)))
        if isinstance(dec_hs, (tuple, list)) and len(dec_hs) > 0 and torch.is_tensor(dec_hs[0]):
            stacks.append(("decoder_hidden_states", tuple(dec_hs)))

        # Deduplicate by name while preserving deterministic order.
        seen: set[str] = set()
        out: List[Tuple[str, Tuple[torch.Tensor, ...]]] = []
        for name, st in stacks:
            if name in seen:
                continue
            seen.add(name)
            out.append((name, st))
        return out

    ## @brief Compute total layer loss across all available hidden-state stacks.
    # @param student_outputs Any Student outputs.
    # @param teacher_outputs Any Teacher outputs.
    # @return torch.Tensor Layer loss tensor.
    def _compute_layer_loss(self, student_outputs: Any, teacher_outputs: Any) -> torch.Tensor:
        student_stacks = self._extract_hidden_state_stacks(student_outputs)
        teacher_stacks = self._extract_hidden_state_stacks(teacher_outputs)

        if len(student_stacks) == 0 or len(teacher_stacks) == 0:
            raise ValueError(
                "Hidden states are required for APT self-distillation layer loss. "
                "Ensure forward passes use output_hidden_states=True."
            )

        # Match stacks by name if possible; otherwise fall back to positional pairing.
        teacher_by_name: Dict[str, Tuple[torch.Tensor, ...]] = {n: st for n, st in teacher_stacks}

        losses: List[torch.Tensor] = []
        for s_name, s_stack in student_stacks:
            t_stack = teacher_by_name.get(s_name, None)
            if t_stack is None:
                # If teacher lacks the same stack name, skip to avoid mismatched semantics.
                continue
            losses.append(self._compute_layer_loss_stack(student_stack=s_stack, teacher_stack=t_stack))

        if len(losses) == 0:
            # Positional fallback: use first stack pair.
            losses.append(self._compute_layer_loss_stack(student_stack=student_stacks[0][1], teacher_stack=teacher_stacks[0][1]))

        # Sum losses across stacks.
        total = losses[0]
        for x in losses[1:]:
            total = total + x
        return total

    ## @brief Compute the Eq. (7) layer loss for one hidden-state stack.
    # @details Uses transformer-layer outputs (skipping index 0 embedding state when present).
    # @param student_stack tuple[torch.Tensor, ...] Student hidden states.
    # @param teacher_stack tuple[torch.Tensor, ...] Teacher hidden states.
    # @return torch.Tensor Stack layer loss.
    def _compute_layer_loss_stack(
        self,
        student_stack: Tuple[torch.Tensor, ...],
        teacher_stack: Tuple[torch.Tensor, ...],
    ) -> torch.Tensor:
        if len(student_stack) == 0 or len(teacher_stack) == 0:
            raise ValueError("Hidden state stacks must be non-empty.")

        # Determine the layer range: HF hidden_states includes embeddings at index 0.
        # The paper's Σ_{i=1}^T indicates transformer layers, so we skip index 0 when possible.
        start_i: int = 1 if len(teacher_stack) > 1 and len(student_stack) > 1 else 0

        # Cache layer counts for mapping function.
        self._cached_teacher_layers = int(len(teacher_stack))
        self._cached_student_layers = int(len(student_stack))
        phi = self.map_teacher_to_student_layers()

        device = teacher_stack[start_i].device
        dtype = teacher_stack[start_i].dtype

        stack_loss: torch.Tensor = torch.zeros((), device=device, dtype=dtype)

        # eq: apt_layer_loss_eq7
        # L_layer = sum_i MSE(Tr(H_s^{phi(i)}), H_t^i)
        # Tr is identity here (initialized as I per config.yaml).
        for i in range(start_i, len(teacher_stack)):
            if i not in phi:
                continue
            j: int = int(phi[i])
            if j < 0 or j >= len(student_stack):
                continue

            hs_s: torch.Tensor = student_stack[j]
            hs_t: torch.Tensor = teacher_stack[i]

            if tuple(hs_s.shape) != tuple(hs_t.shape):
                raise ValueError(
                    "Hidden state shape mismatch for layer distillation. "
                    f"teacher_layer={i}, student_layer={j}, "
                    f"teacher_shape={tuple(hs_t.shape)}, student_shape={tuple(hs_s.shape)}. "
                    "This codebase uses masked pruning (shapes unchanged); if you physically change shapes, "
                    "a learned Tr(.) must be introduced and optimized jointly."
                )

            tr_hs_s: torch.Tensor = hs_s  # identity transform Tr initialized as I
            stack_loss = stack_loss + F.mse_loss(tr_hs_s, hs_t, reduction="mean")

        return stack_loss
