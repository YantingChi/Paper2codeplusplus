## src/eval/evaluator.py
from __future__ import annotations

import os
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, Iterable, List, Mapping, Optional, Sequence, Tuple

import torch
from torch.utils.data import DataLoader
import yaml

from src.config import ExperimentConfig
from src.data.dataset_loader import DatasetBundle
from src.eval.lm_eval_adapter import run_lm_eval
from src.eval.metrics import MetricsRegistry
from src.models.apt_injector import APTModelWrapper
from src.utils.logging import get_logger, save_json
from src.utils.profiler import Profiler


## @brief Load config.yaml (paper config) from standard locations.
# @param config_path Optional[str] Optional explicit path to config.yaml.
# @return dict[str, Any] Parsed YAML dict.
def _load_paper_config(config_path: Optional[str] = None) -> Dict[str, Any]:
    candidates: List[Path] = []
    if config_path is not None:
        candidates.append(Path(str(config_path)))
    candidates.extend(
        [
            Path(os.getcwd()) / "config.yaml",
            Path(__file__).resolve().parents[2] / "config.yaml",
            Path(__file__).resolve().parents[3] / "config.yaml",
        ]
    )

    for p in candidates:
        if p.exists():
            with p.open("r", encoding="utf-8") as f:
                data = yaml.safe_load(f) or {}
            if not isinstance(data, dict):
                raise ValueError(f"config.yaml root must be a dict, got {type(data)}")
            return data
    raise FileNotFoundError("Cannot find required config.yaml in CWD or repository parents.")


## @brief Safely get nested values from a dict using dotted paths.
# @param d dict[str, Any] Root dict.
# @param path str Dotted path.
# @param default Any Default if missing.
# @return Any Retrieved value or default.
def _get_nested(d: Dict[str, Any], path: str, default: Any) -> Any:
    cur: Any = d
    for part in str(path).split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return cur


## @brief Determine whether backbone name corresponds to LLaMA-family.
# @param backbone_name str Backbone name.
# @return bool True if LLaMA-like.
def _is_llama_backbone(backbone_name: str) -> bool:
    s: str = (backbone_name or "").lower()
    return ("llama" in s) or ("llemma" in s)


## @brief Move a nested batch structure to a device.
# @param batch Any Batch object (tensor/dict/list/tuple).
# @param device torch.device Target device.
# @return Any Batch moved to device.
def _move_to_device(batch: Any, device: torch.device) -> Any:
    if torch.is_tensor(batch):
        return batch.to(device, non_blocking=True)
    if isinstance(batch, dict):
        return {str(k): _move_to_device(v, device) for k, v in batch.items()}
    if isinstance(batch, (list, tuple)):
        moved = [_move_to_device(x, device) for x in batch]
        return type(batch)(moved)
    return batch


## @brief Convert a tensor (or array-like) to a CPU int list.
# @param x Any Input.
# @return list[int] List of ints.
def _to_int_list(x: Any) -> List[int]:
    if x is None:
        return []
    if torch.is_tensor(x):
        return [int(v) for v in x.detach().cpu().reshape(-1).tolist()]
    if isinstance(x, list):
        return [int(v) for v in x]
    return [int(v) for v in list(x)]


## @brief EvalResult container returned by Evaluator.evaluate().
@dataclass
class EvalResult:
    ## @brief Initialize EvalResult.
    # @param task_metrics dict[str, float] Task performance metrics.
    # @param inference_metrics dict[str, float] Inference efficiency metrics.
    # @param artifact_paths dict[str, str] Paths to saved artifacts.
    def __init__(
        self,
        task_metrics: Dict[str, float],
        inference_metrics: Dict[str, float],
        artifact_paths: Dict[str, str],
    ) -> None:
        self.task_metrics = dict(task_metrics or {})
        self.inference_metrics = dict(inference_metrics or {})
        self.artifact_paths = dict(artifact_paths or {})

    task_metrics: Dict[str, float]
    inference_metrics: Dict[str, float]
    artifact_paths: Dict[str, str]


## @brief Evaluator for task metrics and inference efficiency in APT experiments.
# @details Implements paper Sec. 5.1–5.3:
#  - GLUE: dev accuracy
#  - SQuAD v2: dev F1
#  - CNN/DM: ROUGE-1/2/L
#  - LLaMA: lm-eval-harness tasks (ARC/HellaSwag/MMLU/TruthfulQA)
#  - Inference efficiency: peak memory + throughput benchmarking with fixed batch sizes
class Evaluator:
    ## @brief Initialize Evaluator.
    # @param model APTModelWrapper Wrapped model.
    # @param datasets DatasetBundle Tokenized datasets/tokenizer/collator.
    # @param config ExperimentConfig Experiment configuration.
    # @param profiler Profiler Profiler for throughput and peak memory.
    def __init__(self, model: APTModelWrapper, datasets: DatasetBundle, config: ExperimentConfig, profiler: Profiler) -> None:
        if model is None:
            raise ValueError("model must be non-None.")
        if datasets is None:
            raise ValueError("datasets must be non-None.")
        if config is None:
            raise ValueError("config must be non-None.")
        if profiler is None:
            raise ValueError("profiler must be non-None.")

        self._model: APTModelWrapper = model
        self._datasets: DatasetBundle = datasets
        self._cfg: ExperimentConfig = config
        self._profiler: Profiler = profiler
        self._logger = get_logger("apt.evaluator")

        self._device: torch.device = torch.device(str(self._cfg.runtime.device))
        self._is_cuda: bool = self._device.type == "cuda"

        self._metrics = MetricsRegistry(task_type=str(self._cfg.model.task_type))

        self._paper_cfg: Dict[str, Any] = _load_paper_config()

    ## @brief Evaluate the model on the configured task and benchmark inference.
    # @return EvalResult Evaluation results and artifact paths.
    def evaluate(self) -> EvalResult:
        task_type: str = str(self._cfg.model.task_type or "").strip().lower()
        if not task_type:
            raise ValueError("config.model.task_type must be non-empty.")

        # Task metrics.
        if task_type == "sequence_classification":
            task_metrics = self.evaluate_glue()
        elif task_type == "qa":
            task_metrics = self.evaluate_qa()
        elif task_type == "seq2seq":
            task_metrics = self.evaluate_seq2seq()
        elif task_type == "causal_lm":
            task_metrics = self.evaluate_lm_harness()
        else:
            raise ValueError(f"Unsupported task_type={task_type!r} for evaluation.")

        # Inference metrics (optional by config toggles).
        inference_metrics: Dict[str, float] = {}
        if bool(self._cfg.evaluation.measure_inference_peak_memory) or bool(self._cfg.evaluation.measure_throughput):
            inference_metrics = self.benchmark_inference()

        # Persist eval artifact.
        out_dir: Path = Path(str(self._cfg.runtime.output_dir)) / "eval"
        out_dir.mkdir(parents=True, exist_ok=True)
        summary_path: Path = out_dir / "eval_result.json"
        payload: Dict[str, Any] = {
            "task_metrics": dict(task_metrics),
            "inference_metrics": dict(inference_metrics),
            "model": {
                "backbone_name": str(self._cfg.model.backbone_name),
                "task_type": str(self._cfg.model.task_type),
            },
            "data": {
                "dataset_name": str(self._cfg.data.dataset_name),
                "dataset_config_name": str(self._cfg.data.dataset_config_name),
                "validation_split": str(self._cfg.data.validation_split),
            },
            "timestamp_s": float(time.time()),
        }
        save_json(summary_path, payload)

        artifacts: Dict[str, str] = {"eval_result_json": str(summary_path)}
        return EvalResult(task_metrics=task_metrics, inference_metrics=inference_metrics, artifact_paths=artifacts)

    ## @brief Evaluate GLUE dev-set accuracy for SST-2/MNLI as in paper Sec. 5.1.
    # @return dict[str, float] Metric dict including 'accuracy' (percent scale).
    def evaluate_glue(self) -> Dict[str, float]:
        if self._datasets.eval_dataset is None:
            raise ValueError("datasets.eval_dataset must be non-None for evaluation.")
        ds_name: str = str(self._cfg.data.dataset_name or "").strip().lower()
        if ds_name != "glue":
            self._logger.warning("evaluate_glue called but data.dataset_name=%r (expected 'glue').", ds_name)

        eval_loader = self._build_eval_dataloader(task_type="sequence_classification")
        self._model.eval()
        self._model.to(self._device)

        preds: List[int] = []
        refs: List[int] = []

        with torch.inference_mode():
            for batch in eval_loader:
                batch_dev = _move_to_device(batch, self._device)
                outputs = self._model(**batch_dev)
                logits = getattr(outputs, "logits", None)
                if logits is None or not torch.is_tensor(logits):
                    raise ValueError("Sequence classification outputs must include tensor 'logits'.")
                batch_preds = torch.argmax(logits, dim=-1)
                preds.extend(_to_int_list(batch_preds))
                if "labels" in batch_dev and torch.is_tensor(batch_dev["labels"]):
                    refs.extend(_to_int_list(batch_dev["labels"]))
                else:
                    raise ValueError("Classification batch must include 'labels' tensor.")

        glue_task: str = str(self._cfg.data.dataset_config_name or "").strip().lower()
        # Paper metric: dev accuracy.
        metrics = self._metrics.compute_glue(task_name=glue_task, predictions=preds, references=refs)

        # Enforce config.yaml dataset metric naming expectation.
        expected = str(_get_nested(self._paper_cfg, "datasets.glue.metric", "dev_accuracy")).strip().lower()
        if expected != "dev_accuracy":
            raise ValueError("config.yaml datasets.glue.metric must be 'dev_accuracy' for this reproduction.")
        if "accuracy" not in metrics:
            raise ValueError("GLUE evaluation must return 'accuracy' key (percent scale).")

        self._save_predictions_artifact(prefix="glue", predictions=preds, references=refs, metrics=metrics)
        return metrics

    ## @brief Evaluate SQuAD v2.0 dev-set F1 as in paper Sec. 5.1.
    # @details Builds predictions in evaluate's squad_v2 format and delegates scoring to MetricsRegistry.compute_qa().
    # @return dict[str, float] Metric dict including 'f1' (percent scale).
    def evaluate_qa(self) -> Dict[str, float]:
        if self._datasets.eval_dataset is None:
            raise ValueError("datasets.eval_dataset must be non-None for evaluation.")
        ds_name: str = str(self._cfg.data.dataset_name or "").strip().lower()
        if ds_name not in ("squad_v2", "squad", "squadv2"):
            self._logger.warning("evaluate_qa called but data.dataset_name=%r (expected 'squad_v2').", ds_name)

        eval_loader = self._build_qa_eval_dataloader()
        self._model.eval()
        self._model.to(self._device)

        predictions: List[Dict[str, Any]] = []
        references: List[Dict[str, Any]] = []

        with torch.inference_mode():
            for batch in eval_loader:
                # Batch includes qa_metadata and raw fields; do not pass metadata/raw fields to model.
                qa_meta: Dict[str, Any] = dict(batch.get("qa_metadata", {}) or {})
                model_inputs: Dict[str, Any] = {k: v for k, v in batch.items() if k not in ("qa_metadata", "context", "answers", "id")}
                model_inputs_dev = _move_to_device(model_inputs, self._device)

                outputs = self._model(**model_inputs_dev)
                start_logits = getattr(outputs, "start_logits", None)
                end_logits = getattr(outputs, "end_logits", None)
                if start_logits is None or end_logits is None:
                    raise ValueError("QA outputs must include 'start_logits' and 'end_logits'.")
                if not torch.is_tensor(start_logits) or not torch.is_tensor(end_logits):
                    raise ValueError("'start_logits' and 'end_logits' must be tensors.")

                # Metadata for decoding spans.
                example_ids: List[str] = [str(x) for x in (qa_meta.get("example_id", []) or [])]
                offsets: List[List[Optional[Tuple[int, int]]]] = qa_meta.get("offset_mapping", []) or []
                contexts: List[str] = [str(x) for x in (qa_meta.get("context", []) or [])]
                answers: List[Dict[str, Any]] = qa_meta.get("answers", []) or []

                if not (len(example_ids) == len(offsets) == len(contexts) == len(answers)):
                    raise ValueError(
                        "QA metadata lengths mismatch: "
                        f"example_id={len(example_ids)}, offsets={len(offsets)}, contexts={len(contexts)}, answers={len(answers)}"
                    )

                # Decode per example without inventing extra hyperparameters (no n_best, no max_answer_length).
                # Use an exact O(L) best-span computation with constraint start<=end:
                #  best_end = argmax_j (max_{i<=j} start_i + end_j), best_start = argmax_{i<=best_end} start_i.
                for i in range(len(example_ids)):
                    sid: str = example_ids[i]
                    ctx: str = contexts[i]
                    off: List[Optional[Tuple[int, int]]] = list(offsets[i])

                    s = start_logits[i].detach()
                    e = end_logits[i].detach()

                    # Valid positions: context tokens have offset != None; also allow CLS at index 0.
                    valid = torch.zeros_like(s, dtype=torch.bool)
                    for t_idx, o in enumerate(off):
                        if o is not None:
                            valid[t_idx] = True
                    cls_idx: int = 0
                    if cls_idx >= 0 and cls_idx < int(valid.numel()):
                        valid[cls_idx] = True

                    neg_inf = torch.tensor(-1e9, device=s.device, dtype=s.dtype)
                    s_valid = torch.where(valid, s, neg_inf)
                    e_valid = torch.where(valid, e, neg_inf)

                    # Best span under start<=end:
                    prefix_max, prefix_argmax = torch.cummax(s_valid, dim=0)
                    span_scores = prefix_max + e_valid
                    best_end = int(torch.argmax(span_scores).item())
                    best_start = int(prefix_argmax[best_end].item())

                    best_span_score = float(span_scores[best_end].item())
                    null_score = float((s_valid[cls_idx] + e_valid[cls_idx]).item())

                    # Predict no-answer if null has higher score.
                    predict_no_answer: bool = null_score > best_span_score
                    # Provide a calibrated-ish no_answer_probability without extra hyperparameters.
                    no_answer_probability: float = float(torch.sigmoid(torch.tensor(null_score - best_span_score)).item())

                    pred_text: str = ""
                    if not predict_no_answer:
                        if best_start < 0 or best_end < 0 or best_start >= len(off) or best_end >= len(off):
                            pred_text = ""
                        else:
                            start_off = off[best_start]
                            end_off = off[best_end]
                            if start_off is None or end_off is None:
                                pred_text = ""
                            else:
                                start_char = int(start_off[0])
                                end_char = int(end_off[1])
                                if 0 <= start_char <= end_char <= len(ctx):
                                    pred_text = ctx[start_char:end_char]
                                else:
                                    pred_text = ""

                    predictions.append(
                        {
                            "id": sid,
                            "prediction_text": pred_text,
                            "no_answer_probability": float(no_answer_probability),
                        }
                    )
                    references.append(
                        {
                            "id": sid,
                            "answers": answers[i],
                        }
                    )

        # Paper metric: dev F1.
        metrics = self._metrics.compute_qa(predictions=predictions, references=references)
        expected = str(_get_nested(self._paper_cfg, "datasets.squad_v2.metric", "dev_f1")).strip().lower()
        if expected != "dev_f1":
            raise ValueError("config.yaml datasets.squad_v2.metric must be 'dev_f1' for this reproduction.")
        if "f1" not in metrics:
            raise ValueError("SQuAD v2 evaluation must return 'f1' key (percent scale).")

        self._save_predictions_artifact(prefix="squad_v2", predictions=predictions, references=references, metrics=metrics)
        return metrics

    ## @brief Evaluate seq2seq generation tasks (CNN/DM) and compute ROUGE-1/2/L (paper Sec. 5.1).
    # @return dict[str, float] Metric dict including rouge1/rouge2/rougel (percent scale).
    def evaluate_seq2seq(self) -> Dict[str, float]:
        if self._datasets.eval_dataset is None:
            raise ValueError("datasets.eval_dataset must be non-None for evaluation.")

        eval_loader = self._build_eval_dataloader(task_type="seq2seq")
        self._model.eval()
        self._model.to(self._device)

        tokenizer = self._datasets.tokenizer
        if tokenizer is None:
            raise ValueError("datasets.tokenizer must be available for seq2seq evaluation.")
        pad_token_id: Optional[int] = getattr(tokenizer, "pad_token_id", None)
        if pad_token_id is None:
            raise ValueError("Tokenizer must have pad_token_id for seq2seq evaluation.")
        pad_id: int = int(pad_token_id)

        # Generation length: prefer explicit DataConfig.max_target_length; otherwise default to 128
        # (matches TaskPreprocessor default for seq2seq target length).
        max_new_tokens: int = int(getattr(self._cfg.data, "max_target_length", 0) or 0)
        if max_new_tokens <= 0:
            max_new_tokens = 128

        base_model: Any = getattr(self._model, "model", None)
        if base_model is None or not hasattr(base_model, "generate"):
            raise ValueError("Underlying seq2seq model must expose .generate().")

        gen_texts: List[str] = []
        ref_texts: List[str] = []

        with torch.inference_mode():
            for batch in eval_loader:
                batch_dev = _move_to_device(batch, self._device)

                input_ids = batch_dev.get("input_ids", None)
                attention_mask = batch_dev.get("attention_mask", None)
                labels = batch_dev.get("labels", None)

                if input_ids is None or not torch.is_tensor(input_ids):
                    raise ValueError("Seq2seq batch must include tensor 'input_ids'.")
                if attention_mask is None or not torch.is_tensor(attention_mask):
                    # Some models can generate without attention_mask; but we keep it strict.
                    raise ValueError("Seq2seq batch must include tensor 'attention_mask'.")
                if labels is None or not torch.is_tensor(labels):
                    raise ValueError("Seq2seq batch must include tensor 'labels' for ROUGE references.")

                # Generate with config-derived max_new_tokens only (no fabricated beam settings).
                generated = base_model.generate(
                    input_ids=input_ids,
                    attention_mask=attention_mask,
                    max_new_tokens=int(max_new_tokens),
                )
                # Decode generated sequences.
                gen = tokenizer.batch_decode(generated, skip_special_tokens=True)
                gen_texts.extend([str(x).strip() for x in gen])

                # Decode references from labels (replace -100 with pad token).
                labels_cpu = labels.detach().clone()
                labels_cpu = torch.where(labels_cpu == -100, torch.tensor(pad_id, device=labels_cpu.device), labels_cpu)
                refs = tokenizer.batch_decode(labels_cpu, skip_special_tokens=True)
                ref_texts.extend([str(x).strip() for x in refs])

        metrics = self._metrics.compute_rouge(predictions=gen_texts, references=ref_texts)

        expected_metrics = _get_nested(self._paper_cfg, "datasets.cnndm.metrics", ["rouge1", "rouge2", "rougel"])
        if not isinstance(expected_metrics, list) or [str(x) for x in expected_metrics] != ["rouge1", "rouge2", "rougel"]:
            raise ValueError("config.yaml datasets.cnndm.metrics must be ['rouge1','rouge2','rougel'] for this reproduction.")

        # Ensure required keys exist in percent scale.
        for k in ("rouge1", "rouge2", "rougel"):
            if k not in metrics:
                raise ValueError(f"Seq2seq evaluation must return key {k!r} (percent scale).")

        self._save_predictions_artifact(prefix="seq2seq", predictions=gen_texts, references=ref_texts, metrics=metrics)
        return metrics

    ## @brief Evaluate LLaMA models on lm-eval-harness tasks as in paper Sec. 5.1.
    # @return dict[str, float] lm-eval metrics including lm_eval_avg.
    def evaluate_lm_harness(self) -> Dict[str, float]:
        if not _is_llama_backbone(str(self._cfg.model.backbone_name or "")):
            raise ValueError("evaluate_lm_harness is only valid for LLaMA-family backbones.")

        tokenizer = self._datasets.tokenizer
        if tokenizer is None:
            raise ValueError("datasets.tokenizer must be available for lm-eval-harness evaluation.")

        # Attempt in-memory evaluation first; if the installed lm-eval requires a path, export temporarily.
        try:
            metrics = run_lm_eval(model=self._model, tokenizer=tokenizer, config=self._cfg, pretrained_path=None)
        except RuntimeError as e:
            msg = str(e).lower()
            if "provide a saved model path" not in msg and "does not accept an in-memory model" not in msg:
                raise
            self._logger.warning("lm-eval-harness requires a saved model path; exporting a temporary merged model.")
            tmp_dir = Path(str(self._cfg.runtime.output_dir)) / "eval" / "lm_eval_tmp_model"
            tmp_dir.mkdir(parents=True, exist_ok=True)
            base_model: Any = getattr(self._model, "model", None)
            if base_model is None or not hasattr(base_model, "save_pretrained"):
                raise RuntimeError(
                    "Cannot export model for lm-eval-harness fallback because underlying model lacks save_pretrained()."
                ) from e
            base_model.save_pretrained(str(tmp_dir))
            if hasattr(tokenizer, "save_pretrained"):
                tokenizer.save_pretrained(str(tmp_dir))
            metrics = run_lm_eval(model=self._model, tokenizer=tokenizer, config=self._cfg, pretrained_path=str(tmp_dir))

        if "lm_eval_avg" not in metrics:
            raise ValueError("lm-eval-harness evaluation must return 'lm_eval_avg'.")

        self._save_predictions_artifact(prefix="lm_eval", predictions={}, references={}, metrics=metrics)
        return metrics

    ## @brief Benchmark inference throughput and peak memory with paper-mandated batch sizes (paper Sec. 5.3).
    # @details Uses fixed batch sizes:
    #  - small models: 128
    #  - LLaMA 7B: 32
    #  - LLaMA 13B: 4
    # The numbers must appear as numeric literals.
    # @return dict[str, float] Inference benchmark metrics (peak_memory_mb, throughput_samples_per_s, etc.).
    def benchmark_inference(self) -> Dict[str, float]:
        if self._datasets.eval_dataset is None:
            raise ValueError("datasets.eval_dataset must be non-None for inference benchmarking.")

        backbone: str = str(self._cfg.model.backbone_name or "")
        name_l = backbone.lower()

        # eq: inference_batch_size_small_models
        # eq: inference_batch_size_llama_7b
        # eq: inference_batch_size_llama_13b
        if _is_llama_backbone(backbone):
            if "13b" in name_l:
                bench_bs: int = 4  # eq: inference_batch_size_llama_13b
            else:
                bench_bs = 32  # eq: inference_batch_size_llama_7b
        else:
            bench_bs = 128  # eq: inference_batch_size_small_models

        # Cross-check with config.yaml (must match paper config).
        cfg_bs = _get_nested(self._paper_cfg, "evaluation.inference_batch_size", {})
        if not isinstance(cfg_bs, dict):
            raise ValueError("config.yaml evaluation.inference_batch_size must be a dict.")
        if _is_llama_backbone(backbone):
            expected_bs = int(cfg_bs.get("llama_13b" if "13b" in name_l else "llama_7b"))
        else:
            expected_bs = int(cfg_bs.get("small_models"))
        if int(bench_bs) != int(expected_bs):
            raise ValueError(f"Paper batch size mismatch: code={bench_bs} vs config.yaml={expected_bs}.")

        collator = self._build_safe_forward_collator(task_type=str(self._cfg.model.task_type))
        infer_loader = DataLoader(
            self._datasets.eval_dataset,
            batch_size=int(bench_bs),
            shuffle=False,
            num_workers=int(self._cfg.runtime.num_workers),
            pin_memory=bool(self._cfg.runtime.pin_memory),
            collate_fn=collator,
            drop_last=False,
        )

        self._model.eval()
        self._model.to(self._device)

        # Run profiler benchmark; Profiler internally uses warmup=10, measure=50 by default.
        metrics_raw = self._profiler.benchmark_inference(model=self._model, dataloader=infer_loader)

        out: Dict[str, float] = {}
        if "peak_memory_mb" in metrics_raw:
            out["inference_peak_memory_mb"] = float(metrics_raw["peak_memory_mb"])
        if "throughput_samples_per_s" in metrics_raw:
            out["throughput_samples_per_s"] = float(metrics_raw["throughput_samples_per_s"])
        if "latency_ms_per_batch" in metrics_raw:
            out["latency_ms_per_batch"] = float(metrics_raw["latency_ms_per_batch"])
        if "throughput_tokens_per_s" in metrics_raw:
            out["throughput_tokens_per_s"] = float(metrics_raw["throughput_tokens_per_s"])

        # Do not fabricate throughput_speedup without an explicit baseline provided to this evaluator.
        # The paper reports relative speedups across methods; compute those externally from saved raw throughput.
        return out

    ## @brief Task-specific evaluation entry for GLUE (design API compatibility).
    # @return dict[str, float] GLUE metrics.
    def evaluate_glue_task(self) -> Dict[str, float]:
        return self.evaluate_glue()

    ## @brief Build an evaluation DataLoader using the bundle collator (non-QA).
    # @param task_type str Task type.
    # @return DataLoader Evaluation loader.
    def _build_eval_dataloader(self, task_type: str) -> DataLoader:
        if self._datasets.eval_dataset is None:
            raise ValueError("datasets.eval_dataset must be non-None.")
        collator = self._datasets.data_collator
        if collator is None:
            raise ValueError("datasets.data_collator must be non-None.")

        # Use config.data.eval_batch_size for task evaluation, as validated upstream.
        return DataLoader(
            self._datasets.eval_dataset,
            batch_size=int(self._cfg.data.eval_batch_size),
            shuffle=False,
            num_workers=int(self._cfg.runtime.num_workers),
            pin_memory=bool(self._cfg.runtime.pin_memory),
            collate_fn=collator,
            drop_last=False,
        )

    ## @brief Build a QA evaluation DataLoader that preserves required metadata without breaking padding.
    # @details The eval dataset may retain raw fields (context/answers), which must not be passed into tokenizer.pad.
    # This collator:
    #  - pads only model input fields
    #  - collects qa_metadata with example_id, offset_mapping, context, answers
    # @return DataLoader QA eval loader.
    def _build_qa_eval_dataloader(self) -> DataLoader:
        if self._datasets.eval_dataset is None:
            raise ValueError("datasets.eval_dataset must be non-None.")
        tokenizer = self._datasets.tokenizer
        if tokenizer is None:
            raise ValueError("datasets.tokenizer must be non-None for QA evaluation.")

        def _qa_collate(features: List[Dict[str, Any]]) -> Dict[str, Any]:
            if not isinstance(features, list) or len(features) == 0:
                raise ValueError("QA collate requires a non-empty feature list.")

            # Metadata for post-processing.
            example_ids: List[str] = []
            offset_mappings: List[List[Optional[Tuple[int, int]]]] = []
            contexts: List[str] = []
            answers: List[Dict[str, Any]] = []

            # Model inputs to pad.
            pad_inputs: List[Dict[str, Any]] = []
            for feat in features:
                if not isinstance(feat, dict):
                    raise TypeError(f"QA feature must be dict, got {type(feat)}")

                # Extract metadata.
                example_ids.append(str(feat.get("example_id", feat.get("id", ""))))
                offset_mappings.append(list(feat.get("offset_mapping", []) or []))
                contexts.append(str(feat.get("context", "")))
                ans = feat.get("answers", {"text": [], "answer_start": []})
                if not isinstance(ans, dict):
                    ans = {"text": [], "answer_start": []}
                answers.append(ans)

                # Keep only pad-able tensor-like fields for tokenizer.pad.
                kept: Dict[str, Any] = {}
                for k in ("input_ids", "attention_mask", "token_type_ids"):
                    if k in feat:
                        kept[k] = feat[k]
                # Include labels if present; QA models accept start_positions/end_positions for loss,
                # but evaluation does not require them. Keep them if already in dataset.
                for k in ("start_positions", "end_positions"):
                    if k in feat:
                        kept[k] = feat[k]
                pad_inputs.append(kept)

            batch = tokenizer.pad(pad_inputs, padding=True, return_tensors="pt")
            # Reattach start/end if present as lists but tokenizer.pad did not include them (rare).
            # If they exist in pad_inputs but are not padded by tokenizer, they are likely already scalar ints.
            for k in ("start_positions", "end_positions"):
                if k in pad_inputs[0] and k not in batch:
                    batch[k] = torch.tensor([int(x.get(k, 0)) for x in pad_inputs], dtype=torch.long)

            batch["qa_metadata"] = {
                "example_id": example_ids,
                "offset_mapping": offset_mappings,
                "context": contexts,
                "answers": answers,
            }
            return batch

        return DataLoader(
            self._datasets.eval_dataset,
            batch_size=int(self._cfg.data.eval_batch_size),
            shuffle=False,
            num_workers=int(self._cfg.runtime.num_workers),
            pin_memory=bool(self._cfg.runtime.pin_memory),
            collate_fn=_qa_collate,
            drop_last=False,
        )

    ## @brief Build a safe collator for forward-only inference benchmarking across task types.
    # @details Drops non-tensor/non-pad-able fields (e.g., QA offset_mapping/context/answers) to prevent padding errors.
    # @param task_type str Task type.
    # @return Any Callable collator.
    def _build_safe_forward_collator(self, task_type: str) -> Any:
        tokenizer = self._datasets.tokenizer
        if tokenizer is None:
            raise ValueError("datasets.tokenizer must be non-None to build a safe forward collator.")

        def _collate(features: List[Dict[str, Any]]) -> Dict[str, Any]:
            if not isinstance(features, list) or len(features) == 0:
                raise ValueError("Collate requires non-empty feature list.")
            pad_inputs: List[Dict[str, Any]] = []
            for feat in features:
                if not isinstance(feat, dict):
                    raise TypeError(f"Feature must be dict, got {type(feat)}")
                kept: Dict[str, Any] = {}
                # Common model input keys across task types.
                for k in (
                    "input_ids",
                    "attention_mask",
                    "token_type_ids",
                    "labels",
                    "decoder_input_ids",
                    "decoder_attention_mask",
                    "start_positions",
                    "end_positions",
                ):
                    if k in feat:
                        kept[k] = feat[k]
                pad_inputs.append(kept)

            batch = tokenizer.pad(pad_inputs, padding=True, return_tensors="pt")

            # Ensure labels are padded correctly for seq2seq/causal_lm cases if tokenizer.pad did not include them.
            if "labels" in pad_inputs[0] and "labels" not in batch:
                # Determine max label length.
                max_len = max(len(x["labels"]) for x in pad_inputs if "labels" in x and isinstance(x["labels"], list))
                padded: List[List[int]] = []
                for x in pad_inputs:
                    lbl = x.get("labels", [])
                    if isinstance(lbl, list):
                        y = list(lbl)[:max_len]
                        if len(y) < max_len:
                            y = y + ([-100] * (max_len - len(y)))
                        padded.append(y)
                    else:
                        padded.append([int(lbl)] + ([-100] * (max_len - 1)))
                batch["labels"] = torch.tensor(padded, dtype=torch.long)

            return batch

        return _collate

    ## @brief Save a predictions artifact for reproducibility.
    # @param prefix str Artifact prefix.
    # @param predictions Any Predictions object (JSON-serializable).
    # @param references Any References object (JSON-serializable).
    # @param metrics dict[str, float] Metrics dict.
    # @return None
    def _save_predictions_artifact(
        self,
        prefix: str,
        predictions: Any,
        references: Any,
        metrics: Dict[str, float],
    ) -> None:
        out_dir: Path = Path(str(self._cfg.runtime.output_dir)) / "eval"
        out_dir.mkdir(parents=True, exist_ok=True)
        path = out_dir / f"{str(prefix)}_details.json"
        payload: Dict[str, Any] = {
            "metrics": dict(metrics or {}),
            "predictions": predictions,
            "references": references,
            "dataset": {
                "dataset_name": str(self._cfg.data.dataset_name),
                "dataset_config_name": str(self._cfg.data.dataset_config_name),
                "validation_split": str(self._cfg.data.validation_split),
            },
            "model": {
                "backbone_name": str(self._cfg.model.backbone_name),
                "task_type": str(self._cfg.model.task_type),
            },
            "timestamp_s": float(time.time()),
        }
        save_json(path, payload)
