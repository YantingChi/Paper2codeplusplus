_PAPER_CFG_CACHE: Optional[Dict[str, Any]] = None


## @brief Load the global paper configuration (config.yaml) with caching.
# @return dict[str, Any] Parsed YAML configuration.
def _load_paper_config() -> Dict[str, Any]:
    global _PAPER_CFG_CACHE
    if _PAPER_CFG_CACHE is not None:
        return _PAPER_CFG_CACHE

    candidates = [
        Path(os.getcwd()) / "config.yaml",
        Path(__file__).resolve().parents[2] / "config.yaml",  # repo_root/config.yaml (src/algorithms/..)
        Path(__file__).resolve().parents[3] / "config.yaml",
    ]
    for p in candidates:
        if p.exists():
            with p.open("r", encoding="utf-8") as f:
                data = yaml.safe_load(f) or {}
            if not isinstance(data, dict):
                raise ValueError(f"config.yaml root must be a dict, got {type(data)}")
            _PAPER_CFG_CACHE = data
            return _PAPER_CFG_CACHE
    raise FileNotFoundError("Cannot find required config.yaml in CWD or repo parents.")


## @brief Safe nested-get for dicts using dotted path.
# @param d dict[str, Any] Root dictionary.
# @param path str Dotted path (e.g., "distillation.mu_schedule").
# @param default Any Default if missing.
# @return Any Retrieved value or default.
def _get_nested(d: Dict[str, Any], path: str, default: Any) -> Any:
    cur: Any = d
    for part in str(path).split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return cur


## @brief Coerce a value to bool with a default.
# @param v Any Input value.
# @param default bool Default if v is None.
# @return bool Coerced bool.
def _as_bool(v: Any, default: bool) -> bool:
    if v is None:
        return bool(default)
    if isinstance(v, bool):
        return bool(v)
    if isinstance(v, (int, float)):
        return bool(v)
    if isinstance(v, str):
        s = v.strip().lower()
        if s in ("true", "1", "yes", "y", "t"):
            return True
        if s in ("false", "0", "no", "n", "f"):
            return False
    raise ValueError(f"Cannot coerce to bool: {v!r}")


## @brief Coerce a value to float with a default.
# @param v Any Input value.
# @param default float Default if v is None.
# @return float Coerced float.
def _as_float(v: Any, default: float) -> float:
    if v is None:
        return float(default)
    if isinstance(v, (int, float)):
        return float(v)
    if isinstance(v, str):
        return float(v.strip())
    raise ValueError(f"Cannot coerce to float: {v!r}")


