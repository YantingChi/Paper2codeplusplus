```yaml
# configs/default.yaml
#
# Base configuration (schema) for reproducing:
# "APT: Adaptive Pruning and Tuning Pretrained Language Models for Efficient Training and Inference"
#
# This file is loaded first, then deep-merged with task-specific configs.
# Values that are NOT specified in the provided config.yaml are intentionally set to null and MUST
# be overridden by task configs (to avoid fabricating hyperparameters).
#
# eq: apt_forward_eq2
# H_apt(X) = m_o ⊙ (W + s ⊙ W_B W_A) X ⊙ m_i   where s=2
#
# eq: apt_target_sparsity_cubic
# gamma_t = gamma_T + (1 - gamma_T) * (1 - t / T) ** 3
#
# eq: mask_gradual_update_retain
# M1(t) = min(1, M1(t-1) + 0.01)
#
# eq: mask_gradual_update_prune
# M0(t) = max(0, M0(t-1) - 0.01)
#
# eq: rank_growth_rule
# r_new = floor(r * Delta_new / Delta)
#
# eq: distill_total_loss
# L = mu * L_distill + (1 - mu) * L_ft     with mu linearly increasing 0->1
#
# eq: distill_layer_loss
# L_layer = sum_i MSE( Tr(H_s^{phi(i)}), H_t^i )   with Tr initialized as identity

model:
  backbone_name: null
  task_type: null  # sequence_classification | question_answering | seq2seq | causal_lm
  max_length: null
  num_labels: null
  use_ffn_adapters: false
  trust_remote_code: false

data:
  dataset_name: null
  dataset_config_name: null
  train_split: null
  validation_split: null
  text_fields: []
  label_field: null

  max_source_length: null
  max_target_length: null

  batch_size: null
  eval_batch_size: null

training:
  learning_rate: null
  weight_decay: null
  num_epochs: null
  distill_epochs: null

  gradient_accumulation_steps: null
  warmup_ratio: null
  max_grad_norm: null
  optimizer_name: null
  lr_scheduler_type: null

  fp16: null
  bf16: null

  eval_every_steps: null
  save_every_steps: null
  seed: null

apt:
  enable_apt: true

  # gamma_T in paper: ratio of pruned parameters to original total parameters.
  target_sparsity: null

  # From provided config.yaml (fixed in paper hyperparameters).
  initial_rank: 8          # eq: fixed_init_rank
  lora_alpha: 2            # eq: fixed_scaling_factor (scaling factor s=2)

  # Target sparsity scheduling (paper uses cubic schedule).
  target_sparsity_schedule: "cubic"  # eq: apt_target_sparsity_cubic
  target_sparsity_formula: "gamma_t = gamma_T + (1 - gamma_T) * (1 - t / T) ** 3"  # eq: apt_target_sparsity_cubic

  # Mask update (Appendix C): gradual with alpha=0.01.
  mask_update_mode: "gradual"
  mask_update_step: 0.01   # eq: fixed_mask_alpha

  # Salience EMA (type is exponential per provided config.yaml; beta value is unspecified there).
  salience_ema_beta: null
  use_kurtosis: true

  pruning_stage_ratio: null
  rank_update_interval: null
  prune_update_interval: null

  # Adaptive tuning (Sec 4.3): update only top-half salient adapters.
  rank_growth_mode: "top_half_salient_adapters"
  rank_growth_formula: "r_new = floor(r * Delta_new / Delta)"  # eq: rank_growth_rule

  # Distillation configuration (enabled for small models, disabled for large models in config.yaml).
  use_self_distill: true
  distill_mu_schedule: "linear_0_to_1"
  teacher_share_frozen: true

  # Target modules for injection; set by task configs.
  apply_on_modules: []

evaluation:
  metrics: []
  measure_train_peak_memory: true
  measure_inference_peak_memory: true
  measure_throughput: true

  # lm-eval-harness settings for LLaMA; set by llama task configs.
  lm_eval_tasks: []
  lm_eval_num_fewshot: {}

runtime:
  output_dir: null
  device: "cuda"
  num_workers: 0
  pin_memory: true
  compile_model: false
  gradient_checkpointing: false
  log_level: "INFO"
```
