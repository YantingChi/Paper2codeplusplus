## src/models/compact_export.py
from __future__ import annotations

import json
import os
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

import torch
import yaml

from src.models.apt_injector import APTModelWrapper
from src.models.apt_linear import APTLinear
from src.models.mask_utils import MaskManager
from src.utils.logging import get_logger, save_json


## @brief Load the global paper configuration (config.yaml) with caching.
# @details This module uses config.yaml only for values explicitly defined there (e.g., apt.scaling_factor=2).
# @return dict[str, Any] Parsed YAML configuration.
def _load_paper_config() -> Dict[str, Any]:
    if not hasattr(_load_paper_config, "_cache"):
        setattr(_load_paper_config, "_cache", None)

    cached: Optional[Dict[str, Any]] = getattr(_load_paper_config, "_cache")
    if cached is not None:
        return cached

    candidates = [
        Path(os.getcwd()) / "config.yaml",
        Path(__file__).resolve().parents[2] / "config.yaml",  # repo_root/config.yaml
        Path(__file__).resolve().parents[3] / "config.yaml",
    ]
    for p in candidates:
        if p.exists():
            with p.open("r", encoding="utf-8") as f:
                data = yaml.safe_load(f) or {}
            if not isinstance(data, dict):
                raise ValueError(f"config.yaml root must be a dict, got {type(data)}")
            setattr(_load_paper_config, "_cache", data)
            return data
    raise FileNotFoundError("Cannot find required config.yaml in CWD or repository parents.")


## @brief Safely fetch a nested key from a dict using dotted paths.
# @param d dict[str, Any] Root dictionary.
# @param path str Dotted path (e.g., "apt.scaling_factor").
# @param default Any Default value if missing.
# @return Any Retrieved value or default.
def _get_nested(d: Dict[str, Any], path: str, default: Any) -> Any:
    cur: Any = d
    for part in str(path).split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return cur


## @brief Coerce input to float.
# @param v Any Input value.
# @param default float Default value if v is None.
# @return float Coerced float.
def _as_float(v: Any, default: float) -> float:
    if v is None:
        return float(default)
    if isinstance(v, (int, float)):
        return float(v)
    if isinstance(v, str):
        return float(v.strip())
    raise ValueError(f"Cannot coerce to float: {v!r}")


## @brief Resolve a state_dict key prefix for a module name under the given state_dict.
# @details APTRegistry stores module names relative to the underlying HF model. When wrapped by
# APTModelWrapper, the underlying model is typically registered as submodule "model", so state_dict
# keys are often prefixed with "model.".
# @param state_dict dict[str, torch.Tensor] Model state dict.
# @param module_name str Registry module name (relative to HF model root).
# @return str Resolved prefix that exists in state_dict (either "model.<module_name>" or "<module_name>").
def _resolve_sd_prefix(state_dict: Dict[str, torch.Tensor], module_name: str) -> str:
    cand1: str = f"model.{module_name}"
    cand2: str = module_name
    # Probe for the most typical APTLinear base weight key.
    if f"{cand1}.base_linear.weight" in state_dict:
        return cand1
    if f"{cand2}.base_linear.weight" in state_dict:
        return cand2
    # Fallback: accept a prefix if any key starts with it.
    for k in state_dict.keys():
        if k.startswith(cand1 + "."):
            return cand1
    for k in state_dict.keys():
        if k.startswith(cand2 + "."):
            return cand2
    # If nothing matches, return the most likely one; callers will handle missing keys.
    return cand1


## @brief Convert a tensor mask buffer into a binary {0,1} float mask by thresholding at 0.5.
# @details The paper describes "binary pruning masks" but uses gradual updates; export binarizes.
# @param mask torch.Tensor Input mask tensor.
# @param dtype torch.dtype Output dtype (typically same as weight dtype).
# @param threshold float Threshold for binarization.
# @return torch.Tensor Binary float mask tensor of same shape as input.
def _binarize_mask(mask: torch.Tensor, dtype: torch.dtype, threshold: float) -> torch.Tensor:
    if mask.ndim != 1:
        raise ValueError(f"Mask must be 1D, got shape={tuple(mask.shape)}")
    # Threshold fixed at 0.5 for export; no config field exists for this threshold in config.yaml.
    keep = (mask >= float(threshold))
    return keep.to(dtype=dtype)


## @brief Extract effective per-module input/output masks from APTLinear modules (authoritative).
# @details This avoids re-initializing MaskManager at export time (which could overwrite learned masks),
# and reflects the exact masks used in Eq. (2) forward during training/inference.
# @param module APTLinear APT linear module.
# @param threshold float Threshold for binarization.
# @return tuple[torch.Tensor, torch.Tensor] (m_i, m_o) binary float masks.
def _module_binary_masks(module: APTLinear, threshold: float) -> Tuple[torch.Tensor, torch.Tensor]:
    mi = getattr(module, "_input_mask", None)
    mo = getattr(module, "_output_mask", None)
    if not torch.is_tensor(mi) or not torch.is_tensor(mo):
        raise ValueError("APTLinear is expected to hold _input_mask and _output_mask buffers.")
    dtype = mi.dtype
    # Ensure both masks match the weight dtype at application time.
    return _binarize_mask(mi, dtype=dtype, threshold=float(threshold)), _binarize_mask(mo, dtype=dtype, threshold=float(threshold))


## @brief Compute kept indices from a binary mask.
# @param mask torch.Tensor 1D binary mask (bool or {0,1} float).
# @return list[int] Sorted kept indices.
def _kept_indices(mask: torch.Tensor) -> List[int]:
    if mask.ndim != 1:
        raise ValueError(f"mask must be 1D, got {tuple(mask.shape)}")
    if mask.dtype != torch.bool:
        keep = mask > 0
    else:
        keep = mask
    idx = torch.nonzero(keep, as_tuple=False).reshape(-1)
    return [int(x) for x in idx.detach().cpu().tolist()]


## @brief Compact exporter that materializes merged-and-masked APT weights for inference.
# @details This exporter implements Eq. (2) semantics for export by folding both adapter and masks
# into the base weight:
#   W_eff = (m_o[:,None] • (W + s • W_B W_A)) • m_i[None,:]
# and then setting module masks to ones and adapter parameters to zeros in the exported state dict.
class CompactExporter:
    ## @brief Create a CompactExporter.
    # @param apt_model APTModelWrapper Wrapped model containing injected APTLinear modules.
    # @param mask_manager MaskManager Mask manager (kept for API compliance and for exporting mask artifacts).
    def __init__(self, apt_model: APTModelWrapper, mask_manager: MaskManager) -> None:
        if apt_model is None:
            raise ValueError("apt_model must be non-None.")
        if mask_manager is None:
            raise ValueError("mask_manager must be non-None.")
        self._apt_model: APTModelWrapper = apt_model
        self._mask_manager: MaskManager = mask_manager
        self._logger = get_logger("apt.compact_export")

        paper_cfg = _load_paper_config()
        scaling_factor = _as_float(_get_nested(paper_cfg, "apt.scaling_factor", 2.0), 2.0)
        # Paper/config.yaml fixed constant: s = 2
        if float(scaling_factor) != 2.0:
            raise ValueError(f"config.yaml apt.scaling_factor must be 2, got {scaling_factor}.")

        # Export binarization threshold (no config exists; design default is 0.5).
        self._mask_threshold: float = 0.5

        # Export scaling factor literal.
        self._scaling_factor: float = 2.0

    ## @brief Build a compact state-dict patch implementing Eq. (2) for each APTLinear module.
    # @details For each injected APTLinear module, compute and export:
    #   W_eff = (m_o[:,None] • (W + 2 • W_B W_A)) • m_i[None,:]
    # and bias b_eff = m_o • b.
    # Then set:
    #   _input_mask := 1, _output_mask := 1 (so the exported forward does not double-apply masks),
    #   lora_A := 0, lora_B := 0 (so adapter branch contributes 0 even if not marked "merged" after reload).
    #
    # This method returns a CPU tensor dict intended to be merged into a full model state_dict before saving.
    # @return dict[str, torch.Tensor] State-dict patch mapping parameter/buffer keys to CPU tensors.
    def build_compact_state_dict(self) -> Dict[str, torch.Tensor]:
        patch: Dict[str, torch.Tensor] = {}

        # Retrieve full state dict keys to resolve prefixes deterministically.
        full_sd: Dict[str, torch.Tensor] = self._apt_model.state_dict()  # nn.Module API

        for module_name, module in self._apt_model.named_apt_modules():
            meta = module.collect_structure_metadata()
            in_features = int(meta.get("in_features", 0))
            out_features = int(meta.get("out_features", 0))
            if in_features <= 0 or out_features <= 0:
                raise ValueError(f"Invalid in/out features in metadata for module {module_name!r}: {meta}")

            # Resolve state_dict prefix for this module under the wrapper.
            prefix = _resolve_sd_prefix(full_sd, module_name)

            # Locate tensors from module directly (authoritative at export time).
            base_linear = getattr(module, "base_linear", None)
            if base_linear is None or not hasattr(base_linear, "weight"):
                raise ValueError(f"APTLinear {module_name!r} missing base_linear.weight.")
            w = base_linear.weight.detach()
            if w.ndim != 2:
                raise ValueError(f"Expected 2D weight for {module_name!r}, got shape={tuple(w.shape)}")
            if int(w.shape[0]) != out_features or int(w.shape[1]) != in_features:
                raise ValueError(
                    f"Weight shape mismatch for {module_name!r}: expected ({out_features},{in_features}), got {tuple(w.shape)}"
                )

            # Extract adapter weights W_A and W_B (LoRA-style).
            w_a = getattr(module, "lora_A", None)
            w_b = getattr(module, "lora_B", None)
            if w_a is None or w_b is None:
                raise ValueError(f"APTLinear {module_name!r} missing lora_A/lora_B parameters.")
            w_a_t = w_a.detach()
            w_b_t = w_b.detach()
            if w_a_t.ndim != 2 or w_b_t.ndim != 2:
                raise ValueError("lora_A and lora_B must be 2D tensors.")
            if int(w_a_t.shape[1]) != in_features or int(w_b_t.shape[0]) != out_features:
                raise ValueError(
                    f"Adapter shape mismatch for {module_name!r}: "
                    f"lora_A={tuple(w_a_t.shape)} lora_B={tuple(w_b_t.shape)} "
                    f"expected lora_A=(r,{in_features}) and lora_B=({out_features},r)."
                )
            if int(w_b_t.shape[1]) != int(w_a_t.shape[0]):
                raise ValueError(
                    f"Adapter rank mismatch for {module_name!r}: "
                    f"lora_B second dim {int(w_b_t.shape[1])} != lora_A first dim {int(w_a_t.shape[0])}."
                )

            # Effective binary masks from the module (composite, already includes head/neuron/hidden masks).
            m_i_bin, m_o_bin = _module_binary_masks(module=module, threshold=self._mask_threshold)
            # Ensure dtype matches the weight dtype for Hadamard products.
            m_i = m_i_bin.to(dtype=w.dtype, device=w.device)
            m_o = m_o_bin.to(dtype=w.dtype, device=w.device)

            # Determine whether adapter has already been merged. Different APTLinear variants may store flags
            # under different attribute names. If merged, we avoid double-adding.
            merged_flag = False
            for attr in ("_merged", "merged", "is_merged"):
                if hasattr(module, attr):
                    try:
                        merged_flag = bool(getattr(module, attr))
                        break
                    except Exception:
                        pass

            # Eq. (2) merging and masking for export.
            # eq: apt_forward_eq2
            if merged_flag:
                w_merged = w
            else:
                w_merged = w + (2.0 * (w_b_t @ w_a_t))
            # Fold both masks into the weight so exported forward can set masks to ones.
            w_eff = (m_o[:, None] * w_merged) * m_i[None, :]

            # Bias masking: output mask multiplies output channels.
            b_eff: Optional[torch.Tensor] = None
            if getattr(base_linear, "bias", None) is not None:
                b = base_linear.bias.detach()
                if b.ndim != 1 or int(b.numel()) != out_features:
                    raise ValueError(f"Bias shape mismatch for {module_name!r}: got {tuple(b.shape)} expected ({out_features},).")
                b_eff = (m_o * b)

            # Write patch tensors to CPU for serialization.
            weight_key = f"{prefix}.base_linear.weight"
            if weight_key not in full_sd:
                # Some implementations may inline base weight (unlikely); fall back deterministically.
                alt_weight_key = f"{prefix}.weight"
                if alt_weight_key not in full_sd:
                    raise KeyError(
                        f"Cannot find base weight key for module {module_name!r} in state_dict. "
                        f"Tried {weight_key!r} and {alt_weight_key!r}."
                    )
                weight_key = alt_weight_key

            patch[weight_key] = w_eff.detach().cpu()

            if b_eff is not None:
                bias_key = f"{prefix}.base_linear.bias"
                if bias_key not in full_sd:
                    alt_bias_key = f"{prefix}.bias"
                    if alt_bias_key not in full_sd:
                        raise KeyError(
                            f"Cannot find base bias key for module {module_name!r} in state_dict. "
                            f"Tried {bias_key!r} and {alt_bias_key!r}."
                        )
                    bias_key = alt_bias_key
                patch[bias_key] = b_eff.detach().cpu()

            # Set masks to ones to avoid double-application (since we folded masks into W_eff).
            in_mask_key = f"{prefix}._input_mask"
            out_mask_key = f"{prefix}._output_mask"
            if in_mask_key in full_sd:
                patch[in_mask_key] = torch.ones((in_features,), dtype=full_sd[in_mask_key].dtype).cpu()
            if out_mask_key in full_sd:
                patch[out_mask_key] = torch.ones((out_features,), dtype=full_sd[out_mask_key].dtype).cpu()

            # Zero out adapter params so exported model has no adapter contribution even if _merged flag isn't persisted.
            lora_a_key = f"{prefix}.lora_A"
            lora_b_key = f"{prefix}.lora_B"
            if lora_a_key in full_sd:
                patch[lora_a_key] = torch.zeros_like(full_sd[lora_a_key].detach().cpu())
            if lora_b_key in full_sd:
                patch[lora_b_key] = torch.zeros_like(full_sd[lora_b_key].detach().cpu())

        return patch

    ## @brief Compute slicing-related metadata and indices from learned masks.
    # @details This method does not physically slice the full model graph (which is model-family-dependent),
    # but it returns the exact kept indices for each injected module's input/output masks after binarization.
    # This enables downstream tooling to perform true structured compaction if desired.
    # @return dict[str, Any] Dictionary containing kept indices and per-module mask statistics.
    def slice_weights(self) -> Dict[str, Any]:
        threshold: float = float(self._mask_threshold)

        per_module: Dict[str, Any] = {}
        total_in = 0
        total_out = 0
        kept_in = 0
        kept_out = 0

        for module_name, module in self._apt_model.named_apt_modules():
            meta = module.collect_structure_metadata()
            in_features = int(meta.get("in_features", 0))
            out_features = int(meta.get("out_features", 0))

            mi = getattr(module, "_input_mask", None)
            mo = getattr(module, "_output_mask", None)
            if not torch.is_tensor(mi) or not torch.is_tensor(mo):
                raise ValueError(f"APTLinear {module_name!r} missing _input_mask/_output_mask buffers.")

            mi_bin_bool = (mi.detach().cpu() >= threshold)
            mo_bin_bool = (mo.detach().cpu() >= threshold)

            in_idx = _kept_indices(mi_bin_bool)
            out_idx = _kept_indices(mo_bin_bool)

            per_module[module_name] = {
                "in_features": int(in_features),
                "out_features": int(out_features),
                "kept_input_indices": in_idx,
                "kept_output_indices": out_idx,
                "kept_input_count": int(len(in_idx)),
                "kept_output_count": int(len(out_idx)),
                "input_keep_ratio": float(len(in_idx) / max(1, in_features)),
                "output_keep_ratio": float(len(out_idx) / max(1, out_features)),
            }

            total_in += int(in_features)
            total_out += int(out_features)
            kept_in += int(len(in_idx))
            kept_out += int(len(out_idx))

        return {
            "compaction_level": "masked_only",
            "threshold": float(threshold),
            "per_module": per_module,
            "aggregate": {
                "total_in_features": int(total_in),
                "total_out_features": int(total_out),
                "kept_in_features": int(kept_in),
                "kept_out_features": int(kept_out),
                "kept_in_ratio": float(kept_in / max(1, total_in)),
                "kept_out_ratio": float(kept_out / max(1, total_out)),
            },
        }

    ## @brief Save a compact-export artifact directory.
    # @details Writes:
    #  - model_compact.safetensors: full state_dict with the compact patch applied (CPU tensors)
    #  - apt_compact_patch.safetensors: patch-only state dict (CPU tensors)
    #  - export_metadata.json: export configuration + mask stats
    #  - binary_masks.pt: best-effort binary masks from MaskManager (if safe) and per-module masks from modules
    # @param output_dir str Output directory.
    # @return str Output directory path.
    def save(self, output_dir: str) -> str:
        out_dir = Path(str(output_dir))
        out_dir.mkdir(parents=True, exist_ok=True)

        # Build patch implementing Eq. (2) export semantics.
        patch = self.build_compact_state_dict()
        slice_meta = self.slice_weights()

        # Build a full compact state dict by applying patch to model.state_dict().
        full_sd = self._apt_model.state_dict()
        full_compact: Dict[str, torch.Tensor] = {}
        for k, v in full_sd.items():
            if not torch.is_tensor(v):
                continue
            if k in patch:
                full_compact[k] = patch[k].detach().cpu()
            else:
                full_compact[k] = v.detach().cpu()

        # Save with safetensors if available; fall back to torch.save.
        patch_path_st = out_dir / "apt_compact_patch.safetensors"
        full_path_st = out_dir / "model_compact.safetensors"
        patch_path_pt = out_dir / "apt_compact_patch.pt"
        full_path_pt = out_dir / "model_compact.pt"

        saved_format: str = "unknown"
        try:
            from safetensors.torch import save_file  # type: ignore

            # safetensors requires tensor values.
            save_file(patch, str(patch_path_st))
            save_file(full_compact, str(full_path_st))
            saved_format = "safetensors"
        except Exception as e:
            self._logger.warning("Failed to save safetensors; falling back to torch.save. Error=%s", repr(e))
            torch.save(patch, full_path_pt.with_name(patch_path_pt.name))
            torch.save(full_compact, full_path_pt.with_name(full_path_pt.name))
            saved_format = "torch"

        # Export binary masks.
        # IMPORTANT: MaskManager constructed at export time may re-initialize and overwrite learned masks;
        # therefore we always export authoritative per-module masks from modules here.
        threshold: float = float(self._mask_threshold)
        module_masks: Dict[str, Dict[str, torch.Tensor]] = {}
        for module_name, module in self._apt_model.named_apt_modules():
            mi = getattr(module, "_input_mask", None)
            mo = getattr(module, "_output_mask", None)
            if not torch.is_tensor(mi) or not torch.is_tensor(mo):
                continue
            module_masks[module_name] = {
                "input_mask_binary": (mi.detach().cpu() >= threshold),
                "output_mask_binary": (mo.detach().cpu() >= threshold),
            }

        # Best-effort MaskManager binary masks export only if it appears already initialized; do not trigger initialization.
        mm_masks: Dict[str, Any] = {}
        try:
            initialized_flag = getattr(self._mask_manager, "_initialized", None)
            if isinstance(initialized_flag, bool) and initialized_flag:
                # This will not reinitialize, by MaskManager implementation.
                mm_masks = self._mask_manager.get_binary_masks(threshold=threshold)
        except Exception as e:
            self._logger.warning("MaskManager.get_binary_masks failed; exporting only per-module masks. Error=%s", repr(e))

        torch.save(
            {
                "threshold": float(threshold),
                "mask_manager_binary_masks": mm_masks,
                "module_binary_masks": module_masks,
            },
            out_dir / "binary_masks.pt",
        )

        # Export metadata (includes paper-fixed scaling factor).
        paper_cfg = _load_paper_config()
        scaling_factor = _as_float(_get_nested(paper_cfg, "apt.scaling_factor", 2.0), 2.0)
        if float(scaling_factor) != 2.0:
            raise ValueError(f"config.yaml apt.scaling_factor must be 2, got {scaling_factor}.")

        metadata: Dict[str, Any] = {
            "format": str(saved_format),
            "mask_threshold": float(threshold),
            "paper_scaling_factor_s": 2.0,
            "eq_applied": ["apt_forward_eq2"],
            "compaction_level": str(slice_meta.get("compaction_level", "masked_only")),
            "slice_metadata": slice_meta,
            "state_dict_keys": {
                "patch_file": str(patch_path_st if saved_format == "safetensors" else patch_path_pt),
                "full_file": str(full_path_st if saved_format == "safetensors" else full_path_pt),
            },
        }
        save_json(out_dir / "export_metadata.json", metadata)

        return str(out_dir)
