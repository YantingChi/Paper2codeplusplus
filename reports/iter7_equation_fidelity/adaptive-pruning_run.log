## src/utils/seed.py
from __future__ import annotations

import os
import random
from typing import Final

import numpy as np
import torch


## @brief Set global random seeds for reproducible experiments.
# @details This function seeds Python's `random`, NumPy, and PyTorch (CPU and CUDA).
# If `deterministic=True`, it also enables deterministic algorithm settings in PyTorch
# and disables CuDNN benchmarking to reduce nondeterminism.
# @param seed int The seed value to use.
# @param deterministic bool If True, enable deterministic execution where possible.
# @return None
def set_global_seed(seed: int, deterministic: bool = False) -> None:
    # Python hashing randomness can affect iteration order in some cases.
    os.environ["PYTHONHASHSEED"] = str(int(seed))

    # Core RNG seeds.
    random.seed(int(seed))
    np.random.seed(int(seed))
    torch.manual_seed(int(seed))

    # CUDA RNG seeds (even in single-GPU settings, this is required for GPU ops/dropout).
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(int(seed))

    if deterministic:
        # Enforce deterministic algorithms as much as possible.
        # This environment variable is required by CUDA/cuBLAS for deterministic GEMM in some cases.
        # It must be set before CUDA context initialization for full effect, but we still set it here
        # to align with deterministic intent when called early (as designed).
        cublas_cfg: Final[str] = ":4096:8"
        if "CUBLAS_WORKSPACE_CONFIG" not in os.environ:
            os.environ["CUBLAS_WORKSPACE_CONFIG"] = cublas_cfg

        torch.backends.cudnn.deterministic = True
        torch.backends.cudnn.benchmark = False
        torch.use_deterministic_algorithms(True)
    else:
        # Keep seeding but allow faster nondeterministic kernels.
        torch.backends.cudnn.deterministic = False
        torch.backends.cudnn.benchmark = True
        torch.use_deterministic_algorithms(False)
