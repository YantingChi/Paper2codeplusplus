## src/utils/profiler.py
from __future__ import annotations

import time
from dataclasses import dataclass
from typing import Any, Dict, Iterable, Iterator, Mapping, MutableMapping, Optional, Tuple, Union

import torch


## @brief Convert bytes to megabytes (MiB).
# @param num_bytes int Number of bytes.
# @return float Size in MB.
def _bytes_to_mb(num_bytes: int) -> float:
    return float(num_bytes) / (1024.0 * 1024.0)


## @brief Simple timer record for named regions.
@dataclass
class _TimerRecord:
    ## @brief Initialize a timer record.
    # @param start_s float Start timestamp in seconds.
    def __init__(self, start_s: float) -> None:
        self.start_s = float(start_s)

    start_s: float


## @brief Utility class to measure peak CUDA memory and throughput-based speed.
# @details This class is instrumentation-only. It measures:
#  - peak CUDA memory allocated (MB) via torch.cuda.max_memory_allocated
#  - wall-clock time with required CUDA synchronization
#  - inference throughput based on samples/sec (and tokens/sec when available)
class Profiler:
    ## @brief Create a profiler for the given device.
    # @param device str Device string ("cuda", "cuda:0", "cpu", ...).
    def __init__(self, device: str) -> None:
        self._device_str: str = str(device) if device is not None else "cuda"
        self._device: torch.device = torch.device(self._device_str)
        self._is_cuda: bool = self._device.type == "cuda"
        if self._is_cuda and not torch.cuda.is_available():
            raise RuntimeError(
                f"Profiler requested CUDA device '{self._device_str}', but torch.cuda.is_available() is False."
            )

        self._timers: Dict[str, _TimerRecord] = {}

    ## @brief Synchronize CUDA if applicable.
    # @return None
    def _cuda_sync(self) -> None:
        if self._is_cuda:
            torch.cuda.synchronize(self._device)

    ## @brief Reset CUDA memory peak statistics for the configured device.
    # @details This must be called at the start of a measured region to avoid polluted peaks.
    # @return None
    def reset_cuda_stats(self) -> None:
        if not self._is_cuda:
            return
        self._cuda_sync()
        torch.cuda.reset_peak_memory_stats(self._device)
        # Do NOT call empty_cache() here; it changes allocator behavior and can skew measurements.

    ## @brief Start timing a named training region.
    # @details Uses CUDA synchronization to avoid async timing skew.
    # @param name str Region name.
    # @return None
    def start_train_region(self, name: str) -> None:
        region: str = str(name)
        self._cuda_sync()
        self._timers[region] = _TimerRecord(start_s=time.perf_counter())

    ## @brief End timing a named training region and return elapsed seconds.
    # @details Uses CUDA synchronization to avoid async timing skew.
    # @param name str Region name.
    # @return float Elapsed time in seconds.
    def end_train_region(self, name: str) -> float:
        region: str = str(name)
        if region not in self._timers:
            raise KeyError(f"Timer region not started: {region!r}")
        self._cuda_sync()
        end_s: float = time.perf_counter()
        start_s: float = self._timers.pop(region).start_s
        return float(end_s - start_s)

    ## @brief Return the peak training memory allocated so far (MB).
    # @details Caller should ensure reset_cuda_stats() is called at the beginning of the
    # measured training phase/region.
    # @return float Peak allocated memory in MB (0.0 if not CUDA).
    def measure_peak_train_memory(self) -> float:
        if not self._is_cuda:
            return 0.0
        peak_bytes: int = int(torch.cuda.max_memory_allocated(self._device))
        return _bytes_to_mb(peak_bytes)

    ## @brief Move a batch structure to the configured device (best-effort).
    # @param batch Any Batch object (Tensor, dict, list/tuple nesting).
    # @return Any Batch moved to device where possible.
    def _to_device(self, batch: Any) -> Any:
        if torch.is_tensor(batch):
            return batch.to(self._device, non_blocking=True)
        if isinstance(batch, Mapping):
            out: Dict[str, Any] = {}
            for k, v in batch.items():
                out[str(k)] = self._to_device(v)
            return out
        if isinstance(batch, (list, tuple)):
            moved = [self._to_device(x) for x in batch]
            return type(batch)(moved)
        return batch

    ## @brief Infer batch size (#samples) from a batch object (best-effort).
    # @param batch Any Batch object.
    # @return int Estimated batch size (0 if unknown).
    def _infer_num_samples(self, batch: Any) -> int:
        if isinstance(batch, Mapping):
            if "input_ids" in batch and torch.is_tensor(batch["input_ids"]):
                t = batch["input_ids"]
                if t.dim() >= 1:
                    return int(t.shape[0])
            # Fall back to first tensor-like entry.
            for v in batch.values():
                n = self._infer_num_samples(v)
                if n > 0:
                    return n
            return 0
        if torch.is_tensor(batch):
            if batch.dim() >= 1:
                return int(batch.shape[0])
            return 0
        if isinstance(batch, (list, tuple)):
            for v in batch:
                n = self._infer_num_samples(v)
                if n > 0:
                    return n
            return 0
        return 0

    ## @brief Infer token count from a batch object (best-effort).
    # @details Uses input_ids.numel() when present. For seq2seq, also counts decoder_input_ids
    # or labels when present (best-effort), but does not assume they exist.
    # @param batch Any Batch object.
    # @return int Estimated token count (0 if unknown).
    def _infer_num_tokens(self, batch: Any) -> int:
        if not isinstance(batch, Mapping):
            return 0

        total: int = 0
        for key in ("input_ids", "decoder_input_ids", "labels"):
            if key in batch and torch.is_tensor(batch[key]):
                total += int(batch[key].numel())
        return total

    ## @brief Run a forward pass in a robust way for common batch formats.
    # @param model Any Model callable (typically torch.nn.Module).
    # @param batch Any Batch object after device transfer.
    # @return Any Model outputs.
    def _forward(self, model: Any, batch: Any) -> Any:
        if isinstance(batch, Mapping):
            return model(**batch)
        if isinstance(batch, (list, tuple)):
            return model(*batch)
        return model(batch)

    ## @brief Iterate over a dataloader for at most a given number of steps.
    # @param dataloader Iterable[Any] DataLoader/iterable yielding batches.
    # @param max_steps int Maximum number of batches to take.
    # @return Iterator[Any] Iterator over batches.
    def _iter_n(self, dataloader: Iterable[Any], max_steps: int) -> Iterator[Any]:
        if max_steps <= 0:
            return iter(())
        it: Iterator[Any] = iter(dataloader)
        taken: int = 0
        while taken < max_steps:
            try:
                batch = next(it)
            except StopIteration:
                break
            yield batch
            taken += 1

    ## @brief Benchmark inference throughput and peak memory on the provided dataloader.
    # @details Measurement protocol:
    #  - model.eval()
    #  - warmup (no timing, no peak memory)
    #  - reset_peak_memory_stats
    #  - timed measurement with CUDA synchronize before/after
    # Throughput is reported as samples/sec and (when possible) tokens/sec.
    # @param model Any Model (torch.nn.Module-like) to benchmark.
    # @param dataloader Any DataLoader yielding batches compatible with model forward.
    # @param warmup_steps int Number of warmup steps (default 10).
    # @param measure_steps int Number of measured steps (default 50).
    # @return dict[str, float] Benchmark metrics (elapsed_s, throughput, peak_memory_mb, etc.).
    def benchmark_inference(
        self,
        model: Any,
        dataloader: Any,
        warmup_steps: int = 10,
        measure_steps: int = 50,
    ) -> Dict[str, float]:
        if model is None:
            raise ValueError("benchmark_inference requires a non-None model.")
        if dataloader is None:
            raise ValueError("benchmark_inference requires a non-None dataloader.")

        was_training: bool = bool(getattr(model, "training", False))
        if hasattr(model, "eval") and callable(getattr(model, "eval")):
            model.eval()

        # Warmup (not timed, not counted in peak).
        with torch.inference_mode():
            for batch in self._iter_n(dataloader, int(warmup_steps)):
                batch_dev = self._to_device(batch)
                _ = self._forward(model, batch_dev)

        # Reset peak after warmup so we report steady-state peaks.
        self.reset_cuda_stats()

        num_batches: int = 0
        num_samples: int = 0
        num_tokens: int = 0

        with torch.inference_mode():
            self._cuda_sync()
            start_s: float = time.perf_counter()

            for batch in self._iter_n(dataloader, int(measure_steps)):
                batch_dev = self._to_device(batch)
                _ = self._forward(model, batch_dev)

                num_batches += 1
                num_samples += self._infer_num_samples(batch_dev)
                num_tokens += self._infer_num_tokens(batch_dev)

            self._cuda_sync()
            end_s: float = time.perf_counter()

        elapsed_s: float = float(end_s - start_s)
        if elapsed_s <= 0.0:
            elapsed_s = 1e-12

        peak_mb: float = 0.0
        if self._is_cuda:
            peak_mb = _bytes_to_mb(int(torch.cuda.max_memory_allocated(self._device)))

        throughput_samples_per_s: float = float(num_samples) / elapsed_s if num_samples > 0 else 0.0
        throughput_tokens_per_s: float = float(num_tokens) / elapsed_s if num_tokens > 0 else 0.0
        latency_ms_per_batch: float = (elapsed_s / float(num_batches)) * 1000.0 if num_batches > 0 else 0.0

        # Restore training mode if needed.
        if hasattr(model, "train") and callable(getattr(model, "train")):
            model.train(was_training)

        out: Dict[str, float] = {
            "elapsed_s": float(elapsed_s),
            "num_batches": float(num_batches),
            "num_samples": float(num_samples),
            "throughput_samples_per_s": float(throughput_samples_per_s),
            "peak_memory_mb": float(peak_mb),
            "latency_ms_per_batch": float(latency_ms_per_batch),
        }
        if num_tokens > 0:
            out["num_tokens"] = float(num_tokens)
            out["throughput_tokens_per_s"] = float(throughput_tokens_per_s)

        return out
