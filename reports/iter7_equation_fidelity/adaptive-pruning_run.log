## src/models/apt_injector.py
from __future__ import annotations

import re
from collections import defaultdict
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, Iterable, List, Mapping, Optional, Tuple

import torch
import torch.nn as nn

from src.config import APTConfig
from src.models.apt_linear import APTLinear
from src.utils.logging import get_logger


## @brief Infer Hugging Face model family from model.config or class name.
# @param model nn.Module Hugging Face model instance.
# @return str Lowercased family identifier (e.g., "bert", "roberta", "t5", "llama", "unknown").
def _infer_model_family(model: nn.Module) -> str:
    cfg: Any = getattr(model, "config", None)
    model_type: str = str(getattr(cfg, "model_type", "") or "").strip().lower()
    if model_type:
        # Common: "roberta", "bert", "t5", "llama"
        return model_type

    name: str = model.__class__.__name__.lower()
    if "roberta" in name:
        return "roberta"
    if "bert" in name:
        return "bert"
    if "t5" in name:
        return "t5"
    if "llama" in name:
        return "llama"
    return "unknown"


## @brief Check whether a module path segment denotes an index into ModuleList/Sequential.
# @param part str Path segment.
# @return bool True if numeric.
def _is_index_part(part: str) -> bool:
    return bool(part) and part.isdigit()


## @brief Get a child module from a parent using attribute/index/dict semantics.
# @param parent nn.Module Parent module.
# @param part str Path segment (attribute name, numeric index, or key).
# @return nn.Module Child module.
def _get_child_module(parent: nn.Module, part: str) -> nn.Module:
    if hasattr(parent, part):
        child: Any = getattr(parent, part)
        if not isinstance(child, nn.Module):
            raise TypeError(f"Resolved attribute '{part}' is not an nn.Module (got {type(child)}).")
        return child

    if _is_index_part(part) and isinstance(parent, (nn.ModuleList, nn.Sequential)):
        return parent[int(part)]

    if isinstance(parent, nn.ModuleDict):
        return parent[part]

    raise AttributeError(f"Cannot resolve child module part='{part}' on parent type={type(parent)}.")


## @brief Set a child module on a parent using attribute/index/dict semantics.
# @param parent nn.Module Parent module.
# @param part str Final path segment to set.
# @param module nn.Module New module instance.
# @return None
def _set_child_module(parent: nn.Module, part: str, module: nn.Module) -> None:
    if hasattr(parent, part):
        setattr(parent, part, module)
        return

    if _is_index_part(part) and isinstance(parent, (nn.ModuleList, nn.Sequential)):
        parent[int(part)] = module
        return

    if isinstance(parent, nn.ModuleDict):
        parent[part] = module
        return

    raise AttributeError(f"Cannot set child module part='{part}' on parent type={type(parent)}.")


## @brief Resolve the parent module and leaf name for a fully-qualified module name.
# @param model nn.Module Root model.
# @param module_name str Fully-qualified module name (as from model.named_modules()).
# @return tuple[nn.Module, str] (parent_module, leaf_name).
def _resolve_parent(model: nn.Module, module_name: str) -> Tuple[nn.Module, str]:
    if not module_name:
        raise ValueError("module_name must be non-empty.")
    parts: List[str] = module_name.split(".")
    if len(parts) == 1:
        return model, parts[0]
    parent: nn.Module = model
    for part in parts[:-1]:
        parent = _get_child_module(parent, part)
    return parent, parts[-1]


## @brief Determine whether a module is a standard Linear suitable for APT wrapping.
# @param module nn.Module Candidate module.
# @return bool True if module is torch.nn.Linear.
def _is_supported_linear(module: nn.Module) -> bool:
    return isinstance(module, nn.Linear)


## @brief Extract a stable integer layer index from a module name, if present.
# @details Used for metadata/debugging and downstream grouping heuristics.
# @param module_name str Fully-qualified module name.
# @return int Layer index if detected, else -1.
def _extract_layer_index(module_name: str) -> int:
    # Common HF patterns:
    # - encoder.layer.3....
    # - decoder.block.10....
    # - model.layers.5....
    m: Optional[re.Match[str]] = re.search(r"\.(layer|layers|block)\.(\d+)\.", module_name)
    if m is None:
        return -1
    return int(m.group(2))


## @brief Build canonical substring patterns for conceptual targets based on model family.
# @param family str Model family identifier from _infer_model_family.
# @param conceptual_targets list[str] Conceptual targets from config.yaml (e.g., attention_query).
# @return dict[str, list[str]] Mapping from conceptual target -> list of substring patterns.
def _conceptual_to_patterns(family: str, conceptual_targets: List[str]) -> Dict[str, List[str]]:
    targets: List[str] = [str(t).strip().lower() for t in conceptual_targets]
    out: Dict[str, List[str]] = {}

    # Attention query/value patterns per HF implementations.
    if family in ("bert", "roberta"):
        if "attention_query" in targets:
            out["attention_query"] = ["attention.self.query"]
        if "attention_value" in targets:
            out["attention_value"] = ["attention.self.value"]
        if "ffn_layers" in targets:
            # FFN in BERT/RoBERTa encoder layers: intermediate.dense (up) and output.dense (down).
            # Exclude attention.output.dense (different module path contains "attention.output.dense").
            out["ffn_layers"] = ["intermediate.dense", "output.dense"]

    elif family in ("t5", "mt5"):
        if "attention_query" in targets:
            out["attention_query"] = ["SelfAttention.q", "EncDecAttention.q"]
        if "attention_value" in targets:
            out["attention_value"] = ["SelfAttention.v", "EncDecAttention.v"]
        if "ffn_layers" in targets:
            # T5 FFN:
            # - DenseReluDense: wi, wo
            # - Gated variants: wi_0, wi_1, wo
            out["ffn_layers"] = ["DenseReluDense.wi", "DenseReluDense.wi_0", "DenseReluDense.wi_1", "DenseReluDense.wo"]

    elif family in ("llama",):
        if "attention_query" in targets:
            out["attention_query"] = ["self_attn.q_proj"]
        if "attention_value" in targets:
            out["attention_value"] = ["self_attn.v_proj"]
        # Paper config disables FFN adapters for large models; do not add patterns here.

    else:
        # Unknown family: attempt conservative patterns that exist in many Transformer impls.
        if "attention_query" in targets:
            out["attention_query"] = ["q_proj", ".q"]
        if "attention_value" in targets:
            out["attention_value"] = ["v_proj", ".v"]
        if "ffn_layers" in targets:
            out["ffn_layers"] = ["intermediate", "DenseReluDense", "mlp"]

    return out


## @brief Decide which APT group name to use for a given module name.
# @param module_name str Fully-qualified module name.
# @param family str Model family identifier.
# @return str Group name ("attn_q", "attn_v", "ffn").
def _infer_group_name(module_name: str, family: str) -> str:
    name: str = module_name

    # LLaMA
    if family == "llama":
        if "self_attn.q_proj" in name:
            return "attn_q"
        if "self_attn.v_proj" in name:
            return "attn_v"
        # Fallback:
        if "q_proj" in name:
            return "attn_q"
        if "v_proj" in name:
            return "attn_v"

    # BERT/RoBERTa
    if family in ("bert", "roberta"):
        if "attention.self.query" in name:
            return "attn_q"
        if "attention.self.value" in name:
            return "attn_v"
        # FFN:
        if ".intermediate.dense" in name:
            return "ffn"
        if ".output.dense" in name and ".attention.output.dense" not in name:
            return "ffn"

    # T5
    if family in ("t5", "mt5"):
        if "SelfAttention.q" in name or "EncDecAttention.q" in name:
            return "attn_q"
        if "SelfAttention.v" in name or "EncDecAttention.v" in name:
            return "attn_v"
        if "DenseReluDense." in name:
            return "ffn"

    # Default heuristic
    if "query" in name or ".q" in name or "q_proj" in name:
        return "attn_q"
    if "value" in name or ".v" in name or "v_proj" in name:
        return "attn_v"
    return "ffn"


## @brief Registry entry describing an injected APT module.
@dataclass
class _RegistryEntry:
    ## @brief Initialize registry entry.
    # @param module_name str Fully-qualified module name.
    # @param module APTLinear Injected APTLinear instance.
    # @param group str Group name (attn_q|attn_v|ffn).
    # @param layer_index int Layer index parsed from module_name or -1.
    # @param metadata dict[str, Any] Structural metadata snapshot from APTLinear.
    def __init__(
        self,
        module_name: str,
        module: APTLinear,
        group: str,
        layer_index: int,
        metadata: Dict[str, Any],
    ) -> None:
        self.module_name = str(module_name)
        self.module = module
        self.group = str(group)
        self.layer_index = int(layer_index)
        self.metadata = dict(metadata)

    module_name: str
    module: APTLinear
    group: str
    layer_index: int
    metadata: Dict[str, Any]


## @brief Registry for all APTLinear modules injected into a model.
# @details Downstream components rely on this registry to avoid re-discovering model structure.
class APTRegistry:
    ## @brief Create an empty registry.
    def __init__(self) -> None:
        self._entries: Dict[str, _RegistryEntry] = {}
        self._groups: Dict[str, List[str]] = defaultdict(list)

    ## @brief Register an injected APTLinear.
    # @param module_name str Fully-qualified module name.
    # @param module APTLinear Injected module.
    # @param group str Group name (attn_q|attn_v|ffn).
    # @return None
    def register(self, module_name: str, module: APTLinear, group: str) -> None:
        if not module_name:
            raise ValueError("module_name must be non-empty.")
        if module is None:
            raise ValueError("module must be non-None.")
        if not isinstance(module, APTLinear):
            raise TypeError(f"module must be an APTLinear, got {type(module)}.")
        if not group:
            raise ValueError("group must be non-empty.")

        name: str = str(module_name)
        if name in self._entries:
            raise KeyError(f"APTRegistry already contains module_name={name!r}.")

        layer_index: int = _extract_layer_index(name)
        meta: Dict[str, Any] = module.collect_structure_metadata()
        entry = _RegistryEntry(
            module_name=name,
            module=module,
            group=str(group),
            layer_index=layer_index,
            metadata=meta,
        )
        self._entries[name] = entry
        self._groups[str(group)].append(name)
        self._groups[str(group)] = sorted(self._groups[str(group)])

    ## @brief List all registered APT modules.
    # @return list[APTLinear] List of APTLinear modules in deterministic name order.
    def list_modules(self) -> List[APTLinear]:
        names: List[str] = sorted(self._entries.keys())
        return [self._entries[n].module for n in names]

    ## @brief Get prunable groups mapping for downstream pruning logic.
    # @details Group keys are stable strings; values are lists of APTLinear modules.
    # @return dict[str, list[APTLinear]] Group -> APTLinear list.
    def get_prunable_groups(self) -> Dict[str, List[APTLinear]]:
        out: Dict[str, List[APTLinear]] = {}
        for group, names in sorted(self._groups.items(), key=lambda kv: kv[0]):
            out[group] = [self._entries[n].module for n in names]
        return out

    ## @brief Return a registry state dictionary for artifact logging.
    # @return dict[str, Any] JSON-serializable registry snapshot.
    def state_dict(self) -> Dict[str, Any]:
        entries_out: Dict[str, Any] = {}
        for name in sorted(self._entries.keys()):
            e: _RegistryEntry = self._entries[name]
            entries_out[name] = {
                "group": e.group,
                "layer_index": e.layer_index,
                "metadata": dict(e.metadata),
            }
        return {
            "entries": entries_out,
            "groups": {g: list(v) for g, v in sorted(self._groups.items(), key=lambda kv: kv[0])},
        }

    ## @brief Get a registered module by name.
    # @param module_name str Fully-qualified module name.
    # @return APTLinear Registered module.
    def get(self, module_name: str) -> APTLinear:
        if module_name not in self._entries:
            raise KeyError(f"Unknown module_name in registry: {module_name!r}")
        return self._entries[module_name].module

    ## @brief Return deterministic list of (name, module) pairs.
    # @return list[tuple[str, APTLinear]] Name-module pairs.
    def named_modules(self) -> List[Tuple[str, APTLinear]]:
        names: List[str] = sorted(self._entries.keys())
        return [(n, self._entries[n].module) for n in names]


## @brief Thin wrapper around a Hugging Face model with APT registry and export utilities.
class APTModelWrapper(nn.Module):
    ## @brief Create an APTModelWrapper.
    # @param model nn.Module Underlying Hugging Face model.
    # @param apt_modules list[APTLinear List of injected APT modules (deterministic order preferred).
    # @param registry APTRegistry Registry of injected APT modules.
    def __init__(self, model: nn.Module, apt_modules: List[APTLinear], registry: APTRegistry) -> None:
        super().__init__()
        if model is None:
            raise ValueError("model must be non-None.")
        if registry is None:
            raise ValueError("registry must be non-None.")
        self.model: nn.Module = model
        self._apt_modules: List[APTLinear] = list(apt_modules)
        self._registry: APTRegistry = registry

    ## @brief Forward pass delegated to the underlying model.
    # @param kwargs dict[str, Any] Model keyword arguments.
    # @return Any Model outputs.
    def forward(self, **kwargs: Any) -> Any:
        return self.model(**kwargs)

    ## @brief Return the registered APT modules with stable names.
    # @return list[tuple[str, APTLinear]] Name-module pairs.
    def named_apt_modules(self) -> List[Tuple[str, APTLinear]]:
        return self._registry.named_modules()

    ## @brief Return the APT registry.
    # @return APTRegistry Registry instance.
    def get_registry(self) -> APTRegistry:
        return self._registry

    ## @brief Export a compact pruned model artifact for inference benchmarking.
    # @details Per paper, LoRA-style tuning weights are mergeable after training; we merge all adapters
    # before invoking the project’s CompactExporter. This method returns the output directory path.
    # @param output_dir str Output directory path.
    # @return str Path to exported artifact directory.
    def export_compact_model(self, output_dir: str) -> str:
        out_dir: Path = Path(str(output_dir))
        out_dir.mkdir(parents=True, exist_ok=True)

        # Merge all adapters into frozen weights (paper: mergeable for inference).
        for _, m in self.named_apt_modules():
            m.merge_adapter()

        # Delegate to CompactExporter for materializing structured pruning.
        # Import lazily to avoid circular imports across model/algorithm modules.
        from src.models.compact_export import CompactExporter  # pylint: disable=import-outside-toplevel
        from src.models.mask_utils import MaskManager  # pylint: disable=import-outside-toplevel

        mask_manager: MaskManager = MaskManager(self._registry)
        exporter: CompactExporter = CompactExporter(apt_model=self, mask_manager=mask_manager)
        exported_path: str = exporter.save(str(out_dir))
        return str(exported_path)


## @brief Injector that replaces target Linear submodules with APTLinear and registers them.
class APTInjector:
    ## @brief Create an APTInjector.
    # @param apt_config APTConfig Configuration controlling target modules and adapter hyperparameters.
    def __init__(self, apt_config: APTConfig) -> None:
        if apt_config is None:
            raise ValueError("apt_config must be non-None.")
        self._apt_config: APTConfig = apt_config
        self._logger = get_logger("apt.injector")

    ## @brief Find module names to inject APT adapters into.
    # @details Targets are driven primarily by APTConfig.apply_on_modules. This list may contain:
    #  - conceptual tokens from config.yaml: "attention_query", "attention_value", "ffn_layers"
    #  - or explicit substring patterns (advanced use)
    # The function returns fully-qualified module names for supported linear modules.
    # @param model nn.Module Hugging Face model instance.
    # @return list[str] Fully-qualified module names to replace with APTLinear.
    def find_target_modules(self, model: nn.Module) -> List[str]:
        if model is None:
            raise ValueError("model must be non-None.")

        family: str = _infer_model_family(model)
        targets: List[str] = [str(x).strip() for x in (self._apt_config.apply_on_modules or []) if str(x).strip()]
        if len(targets) == 0:
            return []

        # Split targets into conceptual vs explicit patterns.
        conceptual_set = {"attention_query", "attention_value", "ffn_layers"}
        conceptual_targets: List[str] = [t for t in targets if t.strip().lower() in conceptual_set]
        explicit_patterns: List[str] = [t for t in targets if t.strip().lower() not in conceptual_set]

        patterns_by_concept: Dict[str, List[str]] = _conceptual_to_patterns(family, conceptual_targets)
        conceptual_patterns: List[str] = []
        for _, pats in patterns_by_concept.items():
            conceptual_patterns.extend(pats)

        # Explicit patterns are treated as substrings, as are conceptual patterns.
        all_patterns: List[str] = [p for p in (conceptual_patterns + explicit_patterns) if p]
        if len(all_patterns) == 0:
            return []

        # Collect all candidate linear module names.
        candidates: List[Tuple[str, nn.Module]] = []
        for name, module in model.named_modules():
            if not name:
                continue
            if _is_supported_linear(module):
                candidates.append((name, module))

        matched: List[str] = []
        for name, module in candidates:
            # Avoid re-injecting if already APTLinear.
            if isinstance(module, APTLinear):
                continue

            # Apply pattern matching.
            if not any(pat in name for pat in all_patterns):
                continue

            # Additional FFN exclusion for BERT/RoBERTa: do not include attention.output.dense.
            if family in ("bert", "roberta"):
                if ".attention.output.dense" in name and any(p in name for p in ("output.dense",)):
                    # If config asked for output.dense generically, avoid accidentally capturing attention output.
                    if any(pat in name for pat in ("intermediate.dense", "output.dense")):
                        continue

            matched.append(name)

        # Deduplicate and sort deterministically.
        matched = sorted(list(dict.fromkeys(matched).keys()))
        return matched

    ## @brief Inject APTLinear modules into a model and return an APTModelWrapper.
    # @details This method replaces each target nn.Linear with APTLinear configured so that
    # Eq. (2) can be realized inside APTLinear:
    #   H_apt(X) = m_o • (W + s • W_B W_A) X • m_i
    # It also enforces paper hyperparameters for injection:
    #   r_apt = 8 and s = 2.
    # @param model nn.Module Hugging Face model instance.
    # @return APTModelWrapper Wrapped model with registry.
    def inject(self, model: nn.Module) -> APTModelWrapper:
        if model is None:
            raise ValueError("model must be non-None.")

        registry: APTRegistry = APTRegistry()
        apt_modules: List[APTLinear] = []

        if not bool(self._apt_config.enable_apt):
            self._logger.info("APT injection disabled (apt.enable_apt=false). Returning wrapper without adapters.")
            return APTModelWrapper(model=model, apt_modules=[], registry=registry)

        # Paper/config constants must be enforced literally here for verifiability.
        # eq: apt_init_rank
        init_rank: int = 8
        if int(self._apt_config.initial_rank) != init_rank:
            raise ValueError(
                f"APTConfig.initial_rank must be {init_rank} per paper/config.yaml, got {self._apt_config.initial_rank}."
            )

        # eq: apt_scaling_factor
        scaling_factor: float = 2.0
        if float(self._apt_config.lora_alpha) != scaling_factor:
            raise ValueError(
                f"APTConfig.lora_alpha must be {scaling_factor} per paper/config.yaml, got {self._apt_config.lora_alpha}."
            )

        family: str = _infer_model_family(model)
        target_names: List[str] = self.find_target_modules(model)
        if len(target_names) == 0:
            raise RuntimeError(
                "APT is enabled but no target modules matched. "
                f"model_family={family!r}, apply_on_modules={self._apt_config.apply_on_modules!r}. "
                "Fix the config or update the matching rules."
            )

        self._logger.info("Injecting APT into %d Linear modules (family=%s).", len(target_names), family)

        for full_name in target_names:
            parent, leaf = _resolve_parent(model, full_name)
            old: nn.Module = _get_child_module(parent, leaf) if hasattr(parent, leaf) else (
                parent[int(leaf)] if _is_index_part(leaf) and isinstance(parent, (nn.ModuleList, nn.Sequential)) else parent[leaf]  # type: ignore[index]
            )

            if isinstance(old, APTLinear):
                # Already injected (should not happen due to filtering), skip safely.
                continue
            if not _is_supported_linear(old):
                # Only wrap supported linear modules.
                continue

            old_linear: nn.Linear = old  # type: ignore[assignment]
            in_features: int = int(getattr(old_linear, "in_features"))
            out_features: int = int(getattr(old_linear, "out_features"))

            group_name: str = _infer_group_name(full_name, family)

            # eq: apt_forward_eq2
            # Create APTLinear so Eq. (2) is realized inside its forward:
            # H_apt(X) = m_o • (W + s • W_B W_A) X • m_i
            new_mod: APTLinear = APTLinear(
                base_linear=old_linear,
                in_features=in_features,
                out_features=out_features,
                rank=init_rank,          # eq: apt_init_rank
                alpha=scaling_factor,    # eq: apt_scaling_factor
                module_name=full_name,
                group_name=group_name,
            )

            _set_child_module(parent, leaf, new_mod)
            registry.register(module_name=full_name, module=new_mod, group=group_name)
            apt_modules.append(new_mod)

        # Deterministic order for downstream modules.
        apt_modules = [m for _, m in registry.named_modules()]

        return APTModelWrapper(model=model, apt_modules=apt_modules, registry=registry)
