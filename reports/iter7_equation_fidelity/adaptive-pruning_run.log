## src/data/preprocessors.py
from __future__ import annotations

from dataclasses import dataclass
from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple, Union

from src.config import DataConfig, ModelConfig


## @brief Return a safe string version of a possibly-null field.
# @param v Any Value to convert.
# @return str String value (empty for None).
def _as_str(v: Any) -> str:
    if v is None:
        return ""
    return str(v)


## @brief Resolve max length for single-sequence tasks.
# @details Uses model_config.max_length when set; otherwise uses tokenizer.model_max_length.
# @param tokenizer Any Hugging Face tokenizer.
# @param model_config ModelConfig Model configuration.
# @return int Max length.
def _resolve_model_max_length(tokenizer: Any, model_config: ModelConfig) -> int:
    if int(getattr(model_config, "max_length", 0)) > 0:
        return int(model_config.max_length)
    tok_max: int = int(getattr(tokenizer, "model_max_length", 0) or 0)
    if tok_max <= 0 or tok_max > 1_000_000:
        # Some tokenizers use very large sentinel values; choose a safe conservative default.
        return 512
    return tok_max


## @brief Resolve max source length for seq2seq tasks.
# @details Uses data.max_source_length when set; otherwise falls back to model max length.
# @param tokenizer Any Hugging Face tokenizer.
# @param data_cfg DataConfig Data configuration.
# @param model_cfg ModelConfig Model configuration.
# @return int Max source length.
def _resolve_source_max_length(tokenizer: Any, data_cfg: DataConfig, model_cfg: ModelConfig) -> int:
    if int(getattr(data_cfg, "max_source_length", 0)) > 0:
        return int(data_cfg.max_source_length)
    return _resolve_model_max_length(tokenizer, model_cfg)


## @brief Resolve max target length for seq2seq tasks.
# @details Uses data.max_target_length when set; otherwise defaults to 128 (common for summarization/classification).
# @param data_cfg DataConfig Data configuration.
# @return int Max target length.
def _resolve_target_max_length(data_cfg: DataConfig) -> int:
    if int(getattr(data_cfg, "max_target_length", 0)) > 0:
        return int(data_cfg.max_target_length)
    return 128


## @brief Infer whether the tokenizer is a fast tokenizer supporting sequence_ids().
# @param tokenizer Any Hugging Face tokenizer.
# @return bool True if fast-like.
def _is_fast_tokenizer(tokenizer: Any) -> bool:
    return bool(getattr(tokenizer, "is_fast", False))


## @brief Build an Alpaca-style instruction prompt from fields.
# @details Uses the commonly used Alpaca prompt schema:
#   - With input:
#     "### Instruction:\n{instruction}\n\n### Input:\n{input}\n\n### Response:\n"
#   - Without input:
#     "### Instruction:\n{instruction}\n\n### Response:\n"
# This is aligned with the Alpaca dataset structure referenced by the paper.
# @param instruction str Instruction field.
# @param input_text str Input field (may be empty).
# @return str Prompt string (without the response text).
def _build_alpaca_prompt(instruction: str, input_text: str) -> str:
    ins: str = instruction.strip()
    inp: str = input_text.strip()
    if inp:
        return f"### Instruction:\n{ins}\n\n### Input:\n{inp}\n\n### Response:\n"
    return f"### Instruction:\n{ins}\n\n### Response:\n"


## @brief Map GLUE numeric labels to text labels for text-to-text (seq2seq) modeling.
# @details The mapping follows GLUE canonical semantics:
#   - SST-2: 0->negative, 1->positive
#   - MNLI: 0->entailment, 1->neutral, 2->contradiction
# @param glue_task str GLUE task name (e.g., "sst2", "mnli").
# @param label int Numeric label.
# @return str Verbalized label.
def _glue_label_to_text(glue_task: str, label: int) -> str:
    task: str = glue_task.strip().lower()
    if task == "sst2":
        if int(label) == 0:
            return "negative"
        if int(label) == 1:
            return "positive"
        raise ValueError(f"Unexpected SST-2 label: {label}")
    if task == "mnli":
        if int(label) == 0:
            return "entailment"
        if int(label) == 1:
            return "neutral"
        if int(label) == 2:
            return "contradiction"
        raise ValueError(f"Unexpected MNLI label: {label}")
    raise ValueError(f"Unsupported GLUE task for seq2seq verbalization: {glue_task!r}")


## @brief Preprocess raw datasets into tokenized features for different task types.
# @details This class is used by DatasetLoader to apply dataset.map() for:
#   - GLUE (SST-2, MNLI): classification (and optionally seq2seq label generation)
#   - SQuAD v2.0: QA span prediction (start/end positions + offset mapping)
#   - CNN/DailyMail: summarization (seq2seq)
#   - Alpaca: instruction tuning (causal LM with prompt masking)
class TaskPreprocessor:
    ## @brief Create a TaskPreprocessor.
    # @param tokenizer Any Hugging Face tokenizer instance.
    # @param config DataConfig Data configuration.
    # @param model_config ModelConfig Model configuration.
    def __init__(self, tokenizer: Any, config: DataConfig, model_config: ModelConfig) -> None:
        self._tokenizer: Any = tokenizer
        self._data_cfg: DataConfig = config
        self._model_cfg: ModelConfig = model_config

        self._dataset_name: str = str(getattr(config, "dataset_name", "") or "").strip().lower()
        self._dataset_config_name: str = str(getattr(config, "dataset_config_name", "") or "").strip().lower()

        self._text_fields: List[str] = list(getattr(config, "text_fields", []) or [])
        self._label_field: str = str(getattr(config, "label_field", "label") or "label")

        # Validate minimal expectations early to fail fast.
        if not self._dataset_name:
            raise ValueError("DataConfig.dataset_name must be a non-empty string.")
        if not self._model_cfg.task_type:
            raise ValueError("ModelConfig.task_type must be a non-empty string.")

        if self._model_cfg.task_type == "sequence_classification":
            if len(self._text_fields) not in (1, 2):
                raise ValueError(
                    "For sequence_classification, data.text_fields must have length 1 (single sentence) "
                    "or 2 (sentence pair)."
                )

        if self._model_cfg.task_type == "qa":
            # Expect ["question","context"] by convention.
            if len(self._text_fields) != 2:
                raise ValueError("For qa, data.text_fields must be ['question','context'] (two fields).")

        if self._model_cfg.task_type == "seq2seq":
            if len(self._text_fields) < 1:
                raise ValueError("For seq2seq, data.text_fields must contain at least the source field name.")
            if not self._label_field:
                raise ValueError("For seq2seq, data.label_field must be set to the target field name.")

        if self._model_cfg.task_type == "causal_lm":
            # Alpaca commonly uses instruction/input/output.
            if len(self._text_fields) < 1:
                raise ValueError(
                    "For causal_lm, data.text_fields must list fields required to build the prompt/response."
                )
            if not self._label_field:
                # label_field is not used for Alpaca by default but keep schema consistent.
                self._label_field = "output"

    ## @brief Preprocess a batch for sequence classification tasks (GLUE SST-2/MNLI).
    # @param batch dict Raw batch from HF datasets (mapping field->list).
    # @return dict Tokenized features with labels.
    def preprocess_classification(self, batch: Dict[str, Any]) -> Dict[str, Any]:
        max_len: int = _resolve_model_max_length(self._tokenizer, self._model_cfg)

        if len(self._text_fields) == 1:
            text_a: Sequence[str] = batch[self._text_fields[0]]
            encoded: Dict[str, Any] = self._tokenizer(
                list(text_a),
                truncation=True,
                max_length=max_len,
                padding=False,
            )
        else:
            text_a = batch[self._text_fields[0]]
            text_b = batch[self._text_fields[1]]
            encoded = self._tokenizer(
                list(text_a),
                list(text_b),
                truncation=True,
                max_length=max_len,
                padding=False,
            )

        if self._label_field in batch:
            encoded["labels"] = batch[self._label_field]
        else:
            # Some evaluation splits may omit labels (rare). Keep output consistent.
            encoded["labels"] = [-1 for _ in range(len(encoded.get("input_ids", [])))]

        return encoded

    ## @brief Preprocess a batch for extractive question answering (SQuAD v2.0).
    # @details Produces tokenized features with:
    #   - offset_mapping with non-context tokens set to None
    #   - example_id copied from dataset "id"
    #   - start_positions/end_positions for training (CLS for no-answer or span not found)
    # This implementation does not use overflow/stride because such hyperparameters are not provided
    # by the current config schema.
    # @param batch dict Raw batch from HF datasets (mapping field->list).
    # @return dict Tokenized QA features.
    def preprocess_qa(self, batch: Dict[str, Any]) -> Dict[str, Any]:
        if not _is_fast_tokenizer(self._tokenizer):
            raise ValueError("QA preprocessing requires a fast tokenizer (is_fast=True) for offset mappings.")

        question_field: str = self._text_fields[0]
        context_field: str = self._text_fields[1]

        questions: List[str] = [_as_str(q).lstrip() for q in batch[question_field]]
        contexts: List[str] = [_as_str(c) for c in batch[context_field]]

        max_len: int = _resolve_model_max_length(self._tokenizer, self._model_cfg)

        tokenized: Any = self._tokenizer(
            questions,
            contexts,
            truncation="only_second",
            max_length=max_len,
            padding=False,
            return_offsets_mapping=True,
        )

        # Copy example ids for evaluation-time reconstruction.
        example_ids: List[str] = []
        if "id" in batch:
            example_ids = [str(x) for x in batch["id"]]
        else:
            # Deterministic fallback if ids not present.
            example_ids = [str(i) for i in range(len(questions))]
        tokenized["example_id"] = example_ids

        # Prepare offset mapping: mask out question & special tokens so evaluator can easily extract from context.
        # Also compute start/end positions for training.
        input_ids_batch: List[List[int]] = tokenized["input_ids"]
        offsets_batch: List[List[Tuple[int, int]]] = tokenized["offset_mapping"]

        answers_batch: Optional[List[Dict[str, Any]]] = None
        if "answers" in batch:
            answers_batch = batch["answers"]

        start_positions: List[int] = []
        end_positions: List[int] = []
        new_offsets_batch: List[List[Optional[Tuple[int, int]]]] = []

        cls_token_id: Optional[int] = getattr(self._tokenizer, "cls_token_id", None)

        for i in range(len(input_ids_batch)):
            input_ids: List[int] = input_ids_batch[i]
            offsets: List[Tuple[int, int]] = offsets_batch[i]

            # Determine which tokens correspond to context (sequence_id == 1 for second sequence).
            sequence_ids: List[Optional[int]] = list(tokenized.sequence_ids(i))
            masked_offsets: List[Optional[Tuple[int, int]]] = []
            for (sid, off) in zip(sequence_ids, offsets):
                if sid != 1:
                    masked_offsets.append(None)
                else:
                    masked_offsets.append((int(off[0]), int(off[1])))
            new_offsets_batch.append(masked_offsets)

            # CLS index for no-answer; fall back to 0 if not found.
            cls_index: int = 0
            if cls_token_id is not None and cls_token_id in input_ids:
                cls_index = int(input_ids.index(int(cls_token_id)))

            # If no answers provided (e.g., pure eval split), use CLS placeholders.
            if answers_batch is None:
                start_positions.append(cls_index)
                end_positions.append(cls_index)
                continue

            ans: Dict[str, Any] = answers_batch[i] if answers_batch is not None else {}
            ans_starts: List[int] = list(ans.get("answer_start", []) or [])
            ans_texts: List[str] = list(ans.get("text", []) or [])

            # No-answer example in SQuAD v2.
            if len(ans_starts) == 0 or len(ans_texts) == 0 or not _as_str(ans_texts[0]).strip():
                start_positions.append(cls_index)
                end_positions.append(cls_index)
                continue

            start_char: int = int(ans_starts[0])
            answer_text: str = _as_str(ans_texts[0])
            end_char: int = int(start_char + len(answer_text))

            # Find token span in context.
            # Context token indices: first and last positions where sequence_id == 1.
            token_start_index: int = 0
            while token_start_index < len(sequence_ids) and sequence_ids[token_start_index] != 1:
                token_start_index += 1

            token_end_index: int = len(sequence_ids) - 1
            while token_end_index >= 0 and sequence_ids[token_end_index] != 1:
                token_end_index -= 1

            if token_start_index >= len(sequence_ids) or token_end_index < 0 or token_start_index > token_end_index:
                # No context tokens found; treat as no-answer.
                start_positions.append(cls_index)
                end_positions.append(cls_index)
                continue

            # If answer is out of the truncated context span, set to CLS.
            start_off: Optional[Tuple[int, int]] = masked_offsets[token_start_index]
            end_off: Optional[Tuple[int, int]] = masked_offsets[token_end_index]
            if start_off is None or end_off is None:
                start_positions.append(cls_index)
                end_positions.append(cls_index)
                continue

            context_char_start: int = int(start_off[0])
            context_char_end: int = int(end_off[1])
            if start_char < context_char_start or end_char > context_char_end:
                start_positions.append(cls_index)
                end_positions.append(cls_index)
                continue

            # Move token_start_index forward until its start offset exceeds start_char.
            while token_start_index <= token_end_index:
                off = masked_offsets[token_start_index]
                if off is not None and int(off[0]) <= start_char < int(off[1]):
                    break
                token_start_index += 1

            # Move token_end_index backward until its end offset is below end_char.
            while token_end_index >= token_start_index:
                off = masked_offsets[token_end_index]
                if off is not None and int(off[0]) < end_char <= int(off[1]):
                    break
                token_end_index -= 1

            if token_start_index > token_end_index:
                start_positions.append(cls_index)
                end_positions.append(cls_index)
            else:
                start_positions.append(int(token_start_index))
                end_positions.append(int(token_end_index))

        tokenized["offset_mapping"] = new_offsets_batch
        tokenized["start_positions"] = start_positions
        tokenized["end_positions"] = end_positions
        return dict(tokenized)

    ## @brief Preprocess a batch for seq2seq tasks (CNN/DM summarization; optionally T5 text-to-text GLUE).
    # @details For generic seq2seq:
    #   - sources from data.text_fields[0] (string)
    #   - targets from data.label_field (string)
    # For GLUE with seq2seq modeling (if configured that way), targets are verbalized from numeric labels.
    # @param batch dict Raw batch from HF datasets (mapping field->list).
    # @return dict Tokenized seq2seq features with labels.
    def preprocess_seq2seq(self, batch: Dict[str, Any]) -> Dict[str, Any]:
        source_field: str = self._text_fields[0]
        sources: List[str] = [_as_str(x) for x in batch[source_field]]

        src_max_len: int = _resolve_source_max_length(self._tokenizer, self._data_cfg, self._model_cfg)
        tgt_max_len: int = _resolve_target_max_length(self._data_cfg)

        # Determine targets.
        targets: List[str]
        if self._dataset_name == "glue":
            # GLUE text-to-text setup (if configured) uses label verbalization.
            raw_labels: List[Any] = list(batch.get(self._label_field, []))
            if len(raw_labels) != len(sources):
                raise ValueError("GLUE seq2seq preprocessing expects label_field aligned with sources.")
            targets = [_glue_label_to_text(self._dataset_config_name, int(l)) for l in raw_labels]
        else:
            target_field: str = self._label_field
            if target_field not in batch:
                raise ValueError(f"Target field {target_field!r} missing from batch for seq2seq preprocessing.")
            targets = [_as_str(x) for x in batch[target_field]]

        model_inputs: Dict[str, Any] = self._tokenizer(
            sources,
            truncation=True,
            max_length=src_max_len,
            padding=False,
        )

        # Transformers>=4.38: use text_target=... for target-side tokenization.
        labels_out: Dict[str, Any] = self._tokenizer(
            text_target=targets,
            truncation=True,
            max_length=tgt_max_len,
            padding=False,
        )

        model_inputs["labels"] = labels_out["input_ids"]
        return model_inputs

    ## @brief Preprocess a batch for causal language model instruction tuning (Alpaca).
    # @details Builds a prompt+response sequence and masks loss on prompt tokens by setting labels to -100.
    # Expected Alpaca-style fields (by convention): instruction, input, output.
    # The mapping is derived from DataConfig.text_fields:
    #   - If present: use keys 'instruction' and 'input' if they exist; otherwise use first two.
    #   - Response uses key 'output' if present; otherwise uses the last key in text_fields.
    # @param batch dict Raw batch from HF datasets (mapping field->list).
    # @return dict Tokenized causal LM features with labels (prompt-masked).
    def preprocess_causal_lm(self, batch: Dict[str, Any]) -> Dict[str, Any]:
        max_len: int = _resolve_model_max_length(self._tokenizer, self._model_cfg)

        # Identify fields robustly.
        keys: List[str] = self._text_fields[:]
        instruction_key: str = "instruction" if "instruction" in batch else (keys[0] if len(keys) >= 1 else "instruction")
        input_key: str = "input" if "input" in batch else (keys[1] if len(keys) >= 2 else "input")
        output_key: str
        if "output" in batch:
            output_key = "output"
        elif len(keys) >= 3 and keys[2] in batch:
            output_key = keys[2]
        elif len(keys) >= 1 and keys[-1] in batch:
            output_key = keys[-1]
        else:
            output_key = self._label_field if self._label_field in batch else "output"

        instructions: List[str] = [_as_str(x) for x in batch.get(instruction_key, [""] * len(batch.get(output_key, [])))]
        inputs: List[str] = [_as_str(x) for x in batch.get(input_key, [""] * len(instructions))]
        outputs: List[str] = [_as_str(x) for x in batch.get(output_key, [""] * len(instructions))]

        if not (len(instructions) == len(inputs) == len(outputs)):
            raise ValueError("Alpaca causal LM fields must be aligned in length within a batch.")

        prompts: List[str] = [_build_alpaca_prompt(ins, inp) for ins, inp in zip(instructions, inputs)]
        full_texts: List[str] = [p + out for p, out in zip(prompts, outputs)]

        # Tokenize full sequences.
        full_enc: Dict[str, Any] = self._tokenizer(
            full_texts,
            truncation=True,
            max_length=max_len,
            padding=False,
            add_special_tokens=True,
        )

        # Tokenize prompts to compute prompt lengths for label masking.
        prompt_enc: Dict[str, Any] = self._tokenizer(
            prompts,
            truncation=True,
            max_length=max_len,
            padding=False,
            add_special_tokens=True,
        )

        input_ids_batch: List[List[int]] = list(full_enc["input_ids"])
        attn_batch: List[List[int]] = list(full_enc.get("attention_mask", [[1] * len(ids) for ids in input_ids_batch]))
        prompt_ids_batch: List[List[int]] = list(prompt_enc["input_ids"])

        labels_batch: List[List[int]] = []
        for ids, p_ids in zip(input_ids_batch, prompt_ids_batch):
            labels: List[int] = list(ids)
            prompt_len: int = min(len(p_ids), len(labels))
            for j in range(prompt_len):
                labels[j] = -100
            labels_batch.append(labels)

        return {
            "input_ids": input_ids_batch,
            "attention_mask": attn_batch,
            "labels": labels_batch,
        }
