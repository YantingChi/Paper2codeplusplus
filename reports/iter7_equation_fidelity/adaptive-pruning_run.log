## src/models/mask_utils.py
from __future__ import annotations

import os
import re
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, List, Optional, Set, Tuple

import torch
import yaml

from src.models.apt_injector import APTRegistry
from src.models.apt_linear import APTLinear
from src.utils.logging import get_logger


_PAPER_CFG_CACHE: Optional[Dict[str, Any]] = None


## @brief Load the global paper configuration (config.yaml) with caching.
# @details This module must honor mask/pruning settings defined in config.yaml.
# @return dict[str, Any] Parsed YAML configuration.
def _load_paper_config() -> Dict[str, Any]:
    global _PAPER_CFG_CACHE
    if _PAPER_CFG_CACHE is not None:
        return _PAPER_CFG_CACHE

    candidates = [
        Path(os.getcwd()) / "config.yaml",
        Path(__file__).resolve().parents[2] / "config.yaml",  # repo_root/config.yaml (src/models/..)
        Path(__file__).resolve().parents[3] / "config.yaml",
    ]
    for p in candidates:
        if p.exists():
            with p.open("r", encoding="utf-8") as f:
                data = yaml.safe_load(f) or {}
            if not isinstance(data, dict):
                raise ValueError(f"config.yaml root must be a dict, got {type(data)}")
            _PAPER_CFG_CACHE = data
            return _PAPER_CFG_CACHE
    raise FileNotFoundError("Cannot find required config.yaml in CWD or repo parents.")


## @brief Safe nested-get for dicts using dotted path.
# @param d dict[str, Any] Root dictionary.
# @param path str Dotted path (e.g., "apt.mask_update_alpha").
# @param default Any Default if missing.
# @return Any Retrieved value or default.
def _get_nested(d: Dict[str, Any], path: str, default: Any) -> Any:
    cur: Any = d
    for part in str(path).split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return cur


## @brief Coerce a value to float with a default.
# @param v Any Input value.
# @param default float Default if v is None.
# @return float Coerced float.
def _as_float(v: Any, default: float) -> float:
    if v is None:
        return float(default)
    if isinstance(v, (int, float)):
        return float(v)
    if isinstance(v, str):
        return float(v.strip())
    raise ValueError(f"Cannot coerce to float: {v!r}")


## @brief Coerce a value to list[str] with a default.
# @param v Any Input value.
# @param default list[str] Default list if v is None.
# @return list[str] Coerced list of strings.
def _as_str_list(v: Any, default: List[str]) -> List[str]:
    if v is None:
        return list(default)
    if isinstance(v, list):
        return [str(x) for x in v]
    raise ValueError(f"Cannot coerce to list[str]: {v!r}")


## @brief Extract a stable integer layer index from a module name, if present.
# @param module_name str Fully-qualified module name.
# @return int Parsed layer index, or -1 if not found.
def _extract_layer_index(module_name: str) -> int:
    m = re.search(r"\.(layer|layers|block)\.(\d+)\.", module_name)
    if m is None:
        return -1
    return int(m.group(2))


## @brief Infer a model-family hint from a module name string.
# @param module_name str Fully-qualified module name.
# @return str Family hint in {"llama","t5","bertlike","unknown"}.
def _infer_family_from_module_name(module_name: str) -> str:
    name = module_name.lower()
    if "self_attn" in name and ("q_proj" in name or "v_proj" in name):
        return "llama"
    if "selfattention" in name or "encdecattention" in name:
        return "t5"
    if "attention.self" in name and ("query" in name or "value" in name):
        return "bertlike"
    return "unknown"


## @brief Infer the attention group id (shared between q/v projections) from module name.
# @param module_name str Fully-qualified module name.
# @return str Attention group id.
def _infer_attention_group_id(module_name: str) -> str:
    # For BERT/RoBERTa: "...attention.self.query" / "...attention.self.value" -> "...attention.self"
    # For T5: "...SelfAttention.q" / "...SelfAttention.v" -> "...SelfAttention"
    # For LLaMA: "...self_attn.q_proj" / "...self_attn.v_proj" -> "...self_attn"
    if "." not in module_name:
        return module_name
    return module_name.rsplit(".", 1)[0]


## @brief Infer FFN group id for neuron-mask sharing (up/gate/down within a layer).
# @param module_name str Fully-qualified module name.
# @return str FFN group id.
def _infer_ffn_group_id(module_name: str) -> str:
    # BERT/RoBERTa: "...encoder.layer.N.intermediate.dense" or "...encoder.layer.N.output.dense"
    for token in (".intermediate.", ".output."):
        if token in module_name:
            return module_name.split(token, 1)[0]

    # T5: "...block.N.layer.K.DenseReluDense.wi_*" / ".wo"
    token = ".DenseReluDense."
    if token in module_name:
        return module_name.split(token, 1)[0]

    # Generic: group by layer index segment if possible.
    # Example: "model.layers.5.mlp.up_proj" -> "model.layers.5"
    m = re.search(r"(.+\.(layer|layers|block)\.\d+)", module_name)
    if m is not None:
        return str(m.group(1))

    # Fallback: parent module name
    return module_name.rsplit(".", 1)[0]


## @brief Determine whether a module is an attention Q/V projection by its name/group.
# @param module_name str Fully-qualified module name.
# @param group str APTInjector group label (attn_q|attn_v|ffn).
# @return bool True if attention projection.
def _is_attention_projection(module_name: str, group: str) -> bool:
    g = (group or "").strip().lower()
    if g in ("attn_q", "attn_v"):
        return True
    name = module_name.lower()
    if any(x in name for x in ("attention.self.query", "attention.self.value", "self_attn.q_proj", "self_attn.v_proj")):
        return True
    if any(x in name for x in ("selfattention.q", "selfattention.v", "encdecattention.q", "encdecattention.v")):
        return True
    return False


## @brief Determine whether a module is an FFN projection by its name/group.
# @param module_name str Fully-qualified module name.
# @param group str APTInjector group label.
# @return bool True if FFN projection.
def _is_ffn_projection(module_name: str, group: str) -> bool:
    g = (group or "").strip().lower()
    if g == "ffn":
        return True
    name = module_name.lower()
    if any(x in name for x in (".intermediate.dense", ".output.dense", ".densereLudense.".lower(), ".mlp.")):
        return True
    if any(x in name for x in (".wi", ".wi_0", ".wi_1", ".wo", "up_proj", "gate_proj", "down_proj")):
        return True
    return False


## @brief Determine whether an FFN projection is "up/gate" (hidden->ffn) vs "down" (ffn->hidden).
# @param module_name str Fully-qualified module name.
# @return str One of {"up","down","unknown"}.
def _infer_ffn_direction(module_name: str) -> str:
    name = module_name.lower()
    # BERT/RoBERTa
    if ".intermediate.dense" in name:
        return "up"
    if ".output.dense" in name and ".attention.output.dense" not in name:
        return "down"

    # T5
    if any(x in name for x in (".densereLudense.wi".lower(), ".wi_0", ".wi_1")):
        return "up"
    if ".densereLudense.wo".lower() in name or name.endswith(".wo"):
        return "down"

    # LLaMA-style MLP
    if any(x in name for x in ("up_proj", "gate_proj")):
        return "up"
    if "down_proj" in name:
        return "down"

    return "unknown"


## @brief Infer attention head structure (num_heads, head_dim) from hidden size and module name.
# @details This is required to expand a head mask of shape [num_heads] into output-channel mask
# of shape [hidden_size] by repeating each head entry head_dim times.
# @param module_name str Fully-qualified module name.
# @param hidden_size int Hidden size (typically out_features for attention Q/V).
# @return tuple[int, int] (num_heads, head_dim).
def _infer_num_heads_and_head_dim(module_name: str, hidden_size: int) -> Tuple[int, int]:
    if hidden_size <= 0:
        raise ValueError(f"hidden_size must be > 0, got {hidden_size}")

    family = _infer_family_from_module_name(module_name)
    # Candidate head counts in a family-preferential order.
    if family == "llama":
        # LLaMA2-7B: 32 heads, 4096/32=128; LLaMA2-13B: 40 heads, 5120/40=128.
        candidates = [40, 32, 64, 48, 24, 16, 12, 8, 6, 4, 2, 1]
    elif family == "t5":
        # T5-base: 12 heads, 768/12=64.
        candidates = [12, 16, 8, 24, 6, 4, 2, 1]
    elif family == "bertlike":
        # RoBERTa/BERT base: 12 (768/12=64); large: 16 (1024/16=64).
        candidates = [12, 16, 8, 24, 32, 4, 2, 1]
    else:
        candidates = [16, 12, 32, 8, 24, 40, 48, 64, 4, 2, 1]

    for nh in candidates:
        if nh > 0 and hidden_size % nh == 0:
            hd = hidden_size // nh
            # Prefer head_dim that is a multiple of 8 for fp16/bf16 efficiency (paper discussion).
            if hd % 8 == 0:
                return int(nh), int(hd)

    # Fallback: choose a divisor giving the largest head_dim multiple-of-8 if possible.
    best_nh = 1
    best_hd = hidden_size
    for nh in range(1, hidden_size + 1):
        if hidden_size % nh != 0:
            continue
        hd = hidden_size // nh
        if hd % 8 == 0 and hd > best_hd:
            best_nh, best_hd = nh, hd
    return int(best_nh), int(best_hd)


## @brief Expand a per-head mask to a per-channel output mask.
# @param head_mask torch.Tensor Shape [num_heads].
# @param head_dim int Head dimension.
# @param out_features int Expected output feature size (= num_heads * head_dim).
# @return torch.Tensor Expanded mask of shape [out_features].
def _expand_head_mask(head_mask: torch.Tensor, head_dim: int, out_features: int) -> torch.Tensor:
    if head_mask.ndim != 1:
        raise ValueError(f"head_mask must be 1D, got shape={tuple(head_mask.shape)}")
    if head_dim <= 0:
        raise ValueError(f"head_dim must be > 0, got {head_dim}")
    expanded = head_mask.repeat_interleave(int(head_dim))
    if int(expanded.numel()) != int(out_features):
        raise ValueError(
            f"Expanded head mask length mismatch: got {int(expanded.numel())}, expected {int(out_features)}"
        )
    return expanded


## @brief Internal binding describing how to build and apply masks for a given APTLinear module.
@dataclass
class _ModuleBinding:
    ## @brief Initialize a module binding.
    # @param module_name str Fully-qualified module name.
    # @param module APTLinear The injected module instance.
    # @param group str Registry group (attn_q|attn_v|ffn).
    # @param layer_index int Parsed layer index or -1.
    # @param in_features int Module input feature size.
    # @param out_features int Module output feature size.
    # @param hidden_in_key Optional[int] Hidden-size key for input-side hidden mask.
    # @param hidden_out_key Optional[int] Hidden-size key for output-side hidden mask.
    # @param attn_gid Optional[str] Attention group id for head masking.
    # @param num_heads Optional[int] Number of heads in this attention group.
    # @param head_dim Optional[int] Head dimension in this attention group.
    # @param ffn_gid Optional[str] FFN group id for neuron masking.
    # @param neuron_dim Optional[int] FFN neuron dimension for this FFN group.
    # @param ffn_direction str {"up","down","unknown"}.
    def __init__(
        self,
        module_name: str,
        module: APTLinear,
        group: str,
        layer_index: int,
        in_features: int,
        out_features: int,
        hidden_in_key: Optional[int],
        hidden_out_key: Optional[int],
        attn_gid: Optional[str],
        num_heads: Optional[int],
        head_dim: Optional[int],
        ffn_gid: Optional[str],
        neuron_dim: Optional[int],
        ffn_direction: str,
    ) -> None:
        self.module_name = str(module_name)
        self.module = module
        self.group = str(group)
        self.layer_index = int(layer_index)
        self.in_features = int(in_features)
        self.out_features = int(out_features)
        self.hidden_in_key = hidden_in_key
        self.hidden_out_key = hidden_out_key
        self.attn_gid = attn_gid
        self.num_heads = num_heads
        self.head_dim = head_dim
        self.ffn_gid = ffn_gid
        self.neuron_dim = neuron_dim
        self.ffn_direction = str(ffn_direction)

    module_name: str
    module: APTLinear
    group: str
    layer_index: int
    in_features: int
    out_features: int
    hidden_in_key: Optional[int]
    hidden_out_key: Optional[int]
    attn_gid: Optional[str]
    num_heads: Optional[int]
    head_dim: Optional[int]
    ffn_gid: Optional[str]
    neuron_dim: Optional[int]
    ffn_direction: str


## @brief MaskManager owns and updates structured pruning masks for APT.
# @details This is the single authority for:
#  - mask tensor creation/ownership (soft masks in [0,1])
#  - gradual mask updates per paper (Appendix B/C)
#  - producing binary masks for export
#  - reporting current active structure for parameter counting/logging
class MaskManager:
    ## @brief Create a MaskManager.
    # @param registry APTRegistry Registry containing all injected APTLinear modules.
    def __init__(self, registry: APTRegistry) -> None:
        if registry is None:
            raise ValueError("registry must be non-None.")
        self._registry: APTRegistry = registry
        self._logger = get_logger("apt.masks")

        paper_cfg = _load_paper_config()
        blocks = _as_str_list(_get_nested(paper_cfg, "apt.pruning_blocks", []), default=[])
        self._enabled_blocks: Set[str] = {str(b).strip().lower() for b in blocks}

        # From config.yaml: apt.mask_update_alpha == 0.01 (paper literal).
        self._mask_update_alpha: float = _as_float(_get_nested(paper_cfg, "apt.mask_update_alpha", 0.01), 0.01)

        # Mask banks (soft masks).
        self._hidden_masks: Dict[int, torch.Tensor] = {}          # key: hidden_size -> [hidden_size]
        self._head_masks: Dict[str, torch.Tensor] = {}            # key: attn_gid -> [num_heads]
        self._neuron_masks: Dict[str, torch.Tensor] = {}          # key: ffn_gid -> [neuron_dim]

        # Metadata needed for compute_active_structure.
        self._attn_group_meta: Dict[str, Dict[str, Any]] = {}     # attn_gid -> {num_heads, head_dim, hidden_size, layer_index}
        self._ffn_group_meta: Dict[str, Dict[str, Any]] = {}      # ffn_gid -> {neuron_dim, hidden_size, layer_index}

        # Per-module binding for mask propagation.
        self._bindings: List[_ModuleBinding] = []

        # Device/dtype policy: inferred during initialize_masks.
        self._device: Optional[torch.device] = None
        self._dtype: Optional[torch.dtype] = None

        # Track whether initialize_masks() has been called.
        self._initialized: bool = False

    ## @brief Initialize all enabled masks to ones and propagate into APTLinear modules.
    # @details Starts from dense model (all-ones masks), consistent with APT pruning from the
    # beginning of fine-tuning. This method builds internal group mappings from registry module names.
    # @return None
    def initialize_masks(self) -> None:
        if self._initialized:
            # Idempotent; still re-propagate to guarantee modules reflect current banks.
            self._propagate_all()
            return

        named: List[Tuple[str, APTLinear]] = self._registry.named_modules()
        if len(named) == 0:
            self._logger.warning("MaskManager initialized with an empty registry; no masks created.")
            self._initialized = True
            return

        # Infer a device/dtype from the first injected module's parameters.
        first_mod = named[0][1]
        # APTLinear holds base_linear weight; ensure it exists and is a tensor.
        base_linear = getattr(first_mod, "base_linear", None)
        weight = getattr(base_linear, "weight", None) if base_linear is not None else None
        if weight is None or not torch.is_tensor(weight):
            # Fallback: use lora_A parameter if present.
            weight = getattr(first_mod, "lora_A", None)
        if weight is None or not torch.is_tensor(weight):
            raise ValueError("Cannot infer device/dtype for masks from registry modules.")

        self._device = torch.device(weight.device)
        self._dtype = weight.dtype

        # Create bindings and group masks.
        self._bindings = []
        for module_name, module in named:
            meta = module.collect_structure_metadata()
            group = str(meta.get("group_name", ""))
            in_features = int(meta.get("in_features", getattr(module, "in_features", 0)))
            out_features = int(meta.get("out_features", getattr(module, "out_features", 0)))
            if in_features <= 0 or out_features <= 0:
                raise ValueError(f"Invalid in/out features for {module_name}: in={in_features}, out={out_features}")

            layer_index = _extract_layer_index(module_name)

            is_attn = _is_attention_projection(module_name, group)
            is_ffn = _is_ffn_projection(module_name, group)

            # Hidden size key: for FFN/attn, hidden size is usually min(in,out).
            hidden_key: Optional[int] = None
            if "hidden_dimensions" in self._enabled_blocks:
                hidden_key = int(min(in_features, out_features))
                # Create hidden mask bank if not already present.
                if hidden_key not in self._hidden_masks:
                    self._hidden_masks[hidden_key] = torch.ones(
                        (hidden_key,), device=self._device, dtype=self._dtype
                    )

            hidden_in_key: Optional[int] = None
            hidden_out_key: Optional[int] = None
            if hidden_key is not None:
                if in_features == hidden_key:
                    hidden_in_key = hidden_key
                if out_features == hidden_key:
                    hidden_out_key = hidden_key

            attn_gid: Optional[str] = None
            num_heads: Optional[int] = None
            head_dim: Optional[int] = None
            if "attention_heads" in self._enabled_blocks and is_attn:
                attn_gid = _infer_attention_group_id(module_name)
                hidden_size = out_features  # for Q/V in HF, out_features == hidden_size
                nh, hd = _infer_num_heads_and_head_dim(module_name, hidden_size)
                num_heads, head_dim = nh, hd

                if attn_gid not in self._head_masks:
                    self._head_masks[attn_gid] = torch.ones(
                        (num_heads,), device=self._device, dtype=self._dtype
                    )
                    self._attn_group_meta[attn_gid] = {
                        "num_heads": int(num_heads),
                        "head_dim": int(head_dim),
                        "hidden_size": int(hidden_size),
                        "layer_index": int(layer_index),
                    }
                else:
                    # Validate consistency.
                    existing = self._head_masks[attn_gid]
                    if int(existing.numel()) != int(num_heads):
                        raise ValueError(
                            f"Attention group {attn_gid!r} has inconsistent num_heads: "
                            f"{int(existing.numel())} vs {int(num_heads)}"
                        )

            ffn_gid: Optional[str] = None
            neuron_dim: Optional[int] = None
            ffn_direction: str = "unknown"
            if "ffn_neurons" in self._enabled_blocks and is_ffn:
                ffn_gid = _infer_ffn_group_id(module_name)
                ffn_direction = _infer_ffn_direction(module_name)
                # Neuron dim is the "wider" FFN dimension in typical transformer FFN.
                neuron_dim = int(max(in_features, out_features))

                if ffn_gid not in self._neuron_masks:
                    self._neuron_masks[ffn_gid] = torch.ones(
                        (neuron_dim,), device=self._device, dtype=self._dtype
                    )
                    self._ffn_group_meta[ffn_gid] = {
                        "neuron_dim": int(neuron_dim),
                        "hidden_size": int(min(in_features, out_features)),
                        "layer_index": int(layer_index),
                    }
                else:
                    existing = self._neuron_masks[ffn_gid]
                    if int(existing.numel()) != int(neuron_dim):
                        raise ValueError(
                            f"FFN group {ffn_gid!r} has inconsistent neuron_dim: "
                            f"{int(existing.numel())} vs {int(neuron_dim)}"
                        )

            binding = _ModuleBinding(
                module_name=module_name,
                module=module,
                group=group,
                layer_index=layer_index,
                in_features=in_features,
                out_features=out_features,
                hidden_in_key=hidden_in_key,
                hidden_out_key=hidden_out_key,
                attn_gid=attn_gid,
                num_heads=num_heads,
                head_dim=head_dim,
                ffn_gid=ffn_gid,
                neuron_dim=neuron_dim,
                ffn_direction=ffn_direction,
            )
            self._bindings.append(binding)

        self._initialized = True
        self._propagate_all()

        self._logger.info(
            "Initialized masks | hidden_groups=%d | attn_groups=%d | ffn_groups=%d | enabled_blocks=%s",
            len(self._hidden_masks),
            len(self._head_masks),
            len(self._neuron_masks),
            sorted(self._enabled_blocks),
        )

    ## @brief Apply paper's gradual mask updates based on a retain-set mapping.
    # @details Implements Appendix B/C update rules:
    #   M^{(t)}_1 <- min(1, M^{(t-1)}_1 + alpha)
    #   M^{(t)}_0 <- max(0, M^{(t-1)}_0 - alpha)
    # Group keys in retain_ids are expected to be:
    #   - "hidden_dimensions"
    #   - "attention_heads:<attn_gid>"
    #   - "ffn_neurons:<ffn_gid>"
    # Missing groups are treated as "retain all" (no change) for stability.
    # @param retain_ids dict[str, list[int]] Mapping from mask group key to indices to retain.
    # @param alpha float Step size (paper/config.yaml: 0.01).
    # @return None
    def apply_mask_updates(self, retain_ids: Dict[str, List[int]], alpha: float = 0.01) -> None:
        if not self._initialized:
            self.initialize_masks()

        # Enforce configuration consistency (config.yaml is the source of truth for alpha).
        alpha_f: float = float(alpha)
        cfg_alpha: float = float(self._mask_update_alpha)
        if abs(alpha_f - cfg_alpha) > 0.0:
            raise ValueError(
                f"Mask update alpha mismatch: got alpha={alpha_f}, but config.yaml apt.mask_update_alpha={cfg_alpha}."
            )

        if retain_ids is None:
            raise ValueError("retain_ids must be a dict[str, list[int]].")
        if not isinstance(retain_ids, dict):
            raise TypeError(f"retain_ids must be dict[str, list[int]], got {type(retain_ids)}")

        # Update hidden dimension masks.
        hidden_updated: Set[int] = set()
        if "hidden_dimensions" in self._enabled_blocks and len(self._hidden_masks) > 0:
            # If the scheduler supplies a single global index list, we apply it to every hidden_size group
            # by clamping indices into each group length.
            hid_key = "hidden_dimensions"
            if hid_key in retain_ids:
                idxs_raw = retain_ids.get(hid_key, [])
                for hidden_size, mask in self._hidden_masks.items():
                    idxs = [int(i) for i in idxs_raw if 0 <= int(i) < int(hidden_size)]
                    self._update_mask_inplace(mask=mask, retain_indices=idxs, alpha=alpha_f, group_key=hid_key)
                    hidden_updated.add(int(hidden_size))

        # Update attention head masks.
        attn_updated: Set[str] = set()
        if "attention_heads" in self._enabled_blocks and len(self._head_masks) > 0:
            for key, idxs_raw in retain_ids.items():
                if not str(key).startswith("attention_heads:"):
                    continue
                gid = str(key).split("attention_heads:", 1)[1]
                if gid not in self._head_masks:
                    # Group absent (e.g., model doesn't include that attention type); ignore safely.
                    continue
                mask = self._head_masks[gid]
                idxs = [int(i) for i in idxs_raw if 0 <= int(i) < int(mask.numel())]
                self._update_mask_inplace(mask=mask, retain_indices=idxs, alpha=alpha_f, group_key=key)
                attn_updated.add(gid)

        # Update FFN neuron masks.
        ffn_updated: Set[str] = set()
        if "ffn_neurons" in self._enabled_blocks and len(self._neuron_masks) > 0:
            for key, idxs_raw in retain_ids.items():
                if not str(key).startswith("ffn_neurons:"):
                    continue
                gid = str(key).split("ffn_neurons:", 1)[1]
                if gid not in self._neuron_masks:
                    continue
                mask = self._neuron_masks[gid]
                idxs = [int(i) for i in idxs_raw if 0 <= int(i) < int(mask.numel())]
                self._update_mask_inplace(mask=mask, retain_indices=idxs, alpha=alpha_f, group_key=key)
                ffn_updated.add(gid)

        # Propagate updates into modules.
        if len(hidden_updated) > 0:
            # Hidden dims potentially affect many modules; re-propagate all for correctness.
            self._propagate_all()
        else:
            # Only propagate specific updated groups.
            if len(attn_updated) > 0:
                for gid in sorted(attn_updated):
                    self._propagate_attention_group(gid)
            if len(ffn_updated) > 0:
                for gid in sorted(ffn_updated):
                    self._propagate_ffn_group(gid)

        # Safety: ensure all masks remain within [0,1] after updates.
        self._validate_mask_ranges()

    ## @brief Produce binary (thresholded) masks for export/compaction.
    # @details Soft masks are binarized deterministically via (mask >= threshold).
    # @param threshold float Threshold in [0,1].
    # @return dict[str, torch.Tensor] Mapping of mask keys to boolean tensors on CPU.
    def get_binary_masks(self, threshold: float = 0.5) -> Dict[str, torch.Tensor]:
        if not self._initialized:
            self.initialize_masks()

        thr: float = float(threshold)
        if thr < 0.0 or thr > 1.0:
            raise ValueError(f"threshold must be in [0,1], got {thr}")

        out: Dict[str, torch.Tensor] = {}

        if "hidden_dimensions" in self._enabled_blocks:
            # If multiple hidden groups exist, export them separately.
            for hidden_size in sorted(self._hidden_masks.keys()):
                key = f"hidden_dimensions:{hidden_size}"
                mask = self._hidden_masks[hidden_size]
                out[key] = (mask >= thr).detach().to(device="cpu")

        if "attention_heads" in self._enabled_blocks:
            for gid in sorted(self._head_masks.keys()):
                key = f"attention_heads:{gid}"
                mask = self._head_masks[gid]
                out[key] = (mask >= thr).detach().to(device="cpu")

        if "ffn_neurons" in self._enabled_blocks:
            for gid in sorted(self._neuron_masks.keys()):
                key = f"ffn_neurons:{gid}"
                mask = self._neuron_masks[gid]
                out[key] = (mask >= thr).detach().to(device="cpu")

        return out

    ## @brief Compute the currently active structure under soft masks.
    # @details Returns both soft-active sums and hard-active counts under threshold=0.5 to support:
    #  - logging
    #  - pruning parameter-count estimation in PruningScheduler.
    # @return dict[str, Any] Active structure dictionary.
    def compute_active_structure(self) -> Dict[str, Any]:
        if not self._initialized:
            self.initialize_masks()

        thr: float = 0.5
        result: Dict[str, Any] = {}

        # Hidden dims
        hidden_out: Dict[str, Any] = {}
        if "hidden_dimensions" in self._enabled_blocks:
            for hidden_size in sorted(self._hidden_masks.keys()):
                m = self._hidden_masks[hidden_size]
                hidden_out[str(hidden_size)] = {
                    "size": int(m.numel()),
                    "soft_active": float(m.detach().float().sum().item()),
                    "hard_active": int((m >= thr).detach().sum().item()),
                }
        result["hidden_dimensions"] = hidden_out

        # Attention heads
        attn_out: Dict[str, Any] = {}
        if "attention_heads" in self._enabled_blocks:
            for gid in sorted(self._head_masks.keys()):
                m = self._head_masks[gid]
                meta = self._attn_group_meta.get(gid, {})
                attn_out[gid] = {
                    "num_heads": int(m.numel()),
                    "head_dim": int(meta.get("head_dim", -1)),
                    "hidden_size": int(meta.get("hidden_size", -1)),
                    "layer_index": int(meta.get("layer_index", -1)),
                    "soft_active": float(m.detach().float().sum().item()),
                    "hard_active": int((m >= thr).detach().sum().item()),
                }
        result["attention_heads"] = attn_out

        # FFN neurons
        ffn_out: Dict[str, Any] = {}
        if "ffn_neurons" in self._enabled_blocks:
            for gid in sorted(self._neuron_masks.keys()):
                m = self._neuron_masks[gid]
                meta = self._ffn_group_meta.get(gid, {})
                ffn_out[gid] = {
                    "num_neurons": int(m.numel()),
                    "hidden_size": int(meta.get("hidden_size", -1)),
                    "layer_index": int(meta.get("layer_index", -1)),
                    "soft_active": float(m.detach().float().sum().item()),
                    "hard_active": int((m >= thr).detach().sum().item()),
                }
        result["ffn_neurons"] = ffn_out

        return result

    ## @brief Update a single 1D soft mask in-place using the paper's gradual update rule.
    # @param mask torch.Tensor 1D soft mask in [0,1].
    # @param retain_indices list[int] Indices to retain (push toward 1).
    # @param alpha float Step size (must match config.yaml).
    # @param group_key str Group key for error messages.
    # @return None
    def _update_mask_inplace(self, mask: torch.Tensor, retain_indices: List[int], alpha: float, group_key: str) -> None:
        if mask.ndim != 1:
            raise ValueError(f"Mask for {group_key!r} must be 1D, got shape={tuple(mask.shape)}")

        n: int = int(mask.numel())
        retain = torch.zeros((n,), device=mask.device, dtype=torch.bool)
        for idx in retain_indices:
            if idx < 0 or idx >= n:
                raise IndexError(f"retain index out of range for {group_key!r}: {idx} not in [0,{n})")
            retain[idx] = True

        # Paper Appendix B/C (mask update):
        # eq: mask_update_retain
        #   M^{(t)}_1 <- min(1, M^{(t-1)}_1 + alpha)
        # eq: mask_update_prune
        #   M^{(t)}_0 <- max(0, M^{(t-1)}_0 - alpha)
        # eq: mask_update_alpha_value
        #   alpha = 0.01 (from config.yaml; validated in apply_mask_updates)
        one = torch.ones_like(mask)
        zero = torch.zeros_like(mask)

        with torch.no_grad():
            if torch.any(retain):
                updated_retain = torch.minimum(mask[retain] + alpha, one[retain])
                mask[retain] = updated_retain
            if torch.any(~retain):
                updated_prune = torch.maximum(mask[~retain] - alpha, zero[~retain])
                mask[~retain] = updated_prune

    ## @brief Validate all masks stay within [0,1].
    # @return None
    def _validate_mask_ranges(self) -> None:
        with torch.no_grad():
            for hidden_size, m in self._hidden_masks.items():
                if torch.any(m < 0) or torch.any(m > 1):
                    raise ValueError(f"Hidden mask out of range [0,1] for hidden_size={hidden_size}")
            for gid, m in self._head_masks.items():
                if torch.any(m < 0) or torch.any(m > 1):
                    raise ValueError(f"Head mask out of range [0,1] for attn_gid={gid!r}")
            for gid, m in self._neuron_masks.items():
                if torch.any(m < 0) or torch.any(m > 1):
                    raise ValueError(f"Neuron mask out of range [0,1] for ffn_gid={gid!r}")

    ## @brief Recompute and apply composite input/output masks for all modules.
    # @return None
    def _propagate_all(self) -> None:
        for b in self._bindings:
            self._apply_masks_to_module(b)

    ## @brief Recompute and apply masks for modules belonging to a specific attention group.
    # @param attn_gid str Attention group id.
    # @return None
    def _propagate_attention_group(self, attn_gid: str) -> None:
        for b in self._bindings:
            if b.attn_gid == attn_gid:
                self._apply_masks_to_module(b)

    ## @brief Recompute and apply masks for modules belonging to a specific FFN group.
    # @param ffn_gid str FFN group id.
    # @return None
    def _propagate_ffn_group(self, ffn_gid: str) -> None:
        for b in self._bindings:
            if b.ffn_gid == ffn_gid:
                self._apply_masks_to_module(b)

    ## @brief Apply the correct composite input/output masks to one APTLinear module.
    # @details Composition rules (multiplicative):
    #  - hidden-dim pruning applies to any side whose feature size equals the hidden mask key
    #  - attention head pruning applies to attention output side by expanding head mask
    #  - FFN neuron pruning applies to FFN "up" output side and FFN "down" input side
    # @param binding _ModuleBinding Binding describing the module and its groups.
    # @return None
    def _apply_masks_to_module(self, binding: _ModuleBinding) -> None:
        mod: APTLinear = binding.module

        # Start with all-ones masks.
        in_mask = torch.ones((binding.in_features,), device=self._device, dtype=self._dtype)
        out_mask = torch.ones((binding.out_features,), device=self._device, dtype=self._dtype)

        # Hidden-dimension mask.
        if "hidden_dimensions" in self._enabled_blocks:
            if binding.hidden_in_key is not None and binding.hidden_in_key in self._hidden_masks:
                in_mask = in_mask * self._hidden_masks[binding.hidden_in_key]
            if binding.hidden_out_key is not None and binding.hidden_out_key in self._hidden_masks:
                out_mask = out_mask * self._hidden_masks[binding.hidden_out_key]

        # Attention head mask (output side).
        if "attention_heads" in self._enabled_blocks and binding.attn_gid is not None:
            head_mask = self._head_masks.get(binding.attn_gid, None)
            if head_mask is not None:
                meta = self._attn_group_meta.get(binding.attn_gid, {})
                hd = int(meta.get("head_dim", binding.head_dim if binding.head_dim is not None else -1))
                if hd <= 0:
                    # As a last resort, infer again (deterministic).
                    nh, hd2 = _infer_num_heads_and_head_dim(binding.module_name, binding.out_features)
                    hd = int(hd2)
                    # Ensure bank is consistent; if not, raise.
                    if int(head_mask.numel()) != int(nh):
                        raise ValueError(
                            f"Head mask size mismatch for {binding.attn_gid!r}: "
                            f"bank={int(head_mask.numel())} vs inferred={int(nh)}"
                        )
                    self._attn_group_meta[binding.attn_gid]["head_dim"] = int(hd)
                expanded = _expand_head_mask(head_mask=head_mask, head_dim=hd, out_features=binding.out_features)
                out_mask = out_mask * expanded

        # FFN neuron mask (directional).
        if "ffn_neurons" in self._enabled_blocks and binding.ffn_gid is not None:
            neuron_mask = self._neuron_masks.get(binding.ffn_gid, None)
            if neuron_mask is not None:
                # For "up" projections, output corresponds to neurons.
                if binding.ffn_direction == "up":
                    if int(neuron_mask.numel()) != int(binding.out_features):
                        raise ValueError(
                            f"FFN up-proj expects neuron mask length == out_features, got "
                            f"{int(neuron_mask.numel())} vs out={int(binding.out_features)} "
                            f"for module={binding.module_name}"
                        )
                    out_mask = out_mask * neuron_mask
                # For "down" projections, input corresponds to neurons.
                elif binding.ffn_direction == "down":
                    if int(neuron_mask.numel()) != int(binding.in_features):
                        raise ValueError(
                            f"FFN down-proj expects neuron mask length == in_features, got "
                            f"{int(neuron_mask.numel())} vs in={int(binding.in_features)} "
                            f"for module={binding.module_name}"
                        )
                    in_mask = in_mask * neuron_mask
                else:
                    # Unknown direction: apply to the side matching neuron_dim if unambiguous.
                    if binding.neuron_dim is not None:
                        if int(binding.neuron_dim) == int(binding.in_features) and int(neuron_mask.numel()) == int(
                            binding.in_features
                        ):
                            in_mask = in_mask * neuron_mask
                        if int(binding.neuron_dim) == int(binding.out_features) and int(neuron_mask.numel()) == int(
                            binding.out_features
                        ):
                            out_mask = out_mask * neuron_mask

        # Apply to module.
        mod.set_input_mask(in_mask)
        mod.set_output_mask(out_mask)
