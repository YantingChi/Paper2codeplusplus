## src/algorithms/distillation.py
from __future__ import annotations

import copy
from dataclasses import dataclass
from typing import Any, Dict, List, Optional

import torch
import torch.nn as nn
import torch.nn.functional as F

from src.config import APTConfig
from src.models.apt_injector import APTModelWrapper


## @brief Distillation loss container.
# @details Holds loss components used by Trainer logging and backprop.
# @param total_loss torch.Tensor Total combined loss L.
# @param task_loss torch.Tensor Supervised fine-tuning loss L_ft.
# @param distill_loss torch.Tensor Distillation loss L_distill.
# @param layer_loss torch.Tensor Hidden-state layer alignment loss L_layer.
@dataclass(frozen=True)
class DistillLossOutput:
    total_loss: torch.Tensor
    task_loss: torch.Tensor
    distill_loss: torch.Tensor
    layer_loss: torch.Tensor


## @brief Efficient self-knowledge distillation manager for APT.
# @details
# Implements the paper's Section 4.4 objective:
#   L = μ L_distill + (1-μ) L_ft
# where μ linearly increases from 0 to 1 during distillation.
#
# Distillation uses:
# - Prediction distillation (paper wording: KL between output distributions):
#     L_pred = D_KL(p_s || p_t)
# - Hidden-state distillation (paper Eq. 7):
#     L_layer = Σ_{i=1}^4 MSE(Tr(H_s^{φ(i)}), H_t^i)
#   where Tr is a learnable (LoRA-like in the paper) transformation initialized as identity.
#   In this codebase, we implement Tr as a learnable linear map W_layer ∈ R^{d×d} per model,
#   initialized exactly to the identity matrix.
#
# Layer sampling (paper): at each training step, randomly sample 4 teacher layers from each quarter
# slice of the teacher depth (e.g., 12 layers -> quarters [0-2],[3-5],[6-8],[9-11]). The sampled
# teacher layers are then mapped to closest (non-pruned) student layers dynamically.
#
# Layer mapping φ (paper, via CoFi): for each sampled teacher layer i, choose the closest student layer j
# among non-pruned student layers by minimizing MSE(W_layer H_s^j, H_t^i). The mapping is re-computed
# every training step.
#
# Teacher construction:
# - The paper describes frozen parameters shared and tuning layers duplicated.
# - In this project architecture, APT adapters live inside the wrapped model; exact partial-sharing
#   is not exposed via a public API. We therefore implement:
#   * Preferred: teacher shares the same underlying model instance but is executed under no_grad
#     and uses detached outputs (reference sharing).
#   * Fallback: deep-copied teacher model with requires_grad_(False).
# The behavior is controlled by apt_config.teacher_share_frozen.
class DistillationManager:
    ## @brief Initialize DistillationManager.
    # @param apt_model APTModelWrapper Wrapped APT model (student).
    # @param apt_config APTConfig APT configuration containing distillation toggles/schedule.
    def __init__(self, apt_model: APTModelWrapper, apt_config: APTConfig) -> None:
        if not isinstance(apt_model, APTModelWrapper):
            raise TypeError(f"apt_model must be APTModelWrapper, got {type(apt_model)}")
        if not isinstance(apt_config, APTConfig):
            raise TypeError(f"apt_config must be APTConfig, got {type(apt_config)}")

        self._student: APTModelWrapper = apt_model
        self._cfg: APTConfig = apt_config

        self._teacher: Optional[Any] = None
        self._teacher_built: bool = False

        # NOTE: The paper requires mapping φ(·) re-computed every training step, so we do not cache it.
        # Kept only for backward compatibility with any external code calling map_teacher_to_student_layers().
        self._layer_map_cache: Optional[Dict[int, int]] = None

        # Transformation Tr: learnable linear map W_layer ∈ R^{d×d}, initialized as identity.
        # Created lazily once we see hidden size d.
        self._tr_layer: Optional[nn.Linear] = None

    ## @brief Build a teacher model/view for self-distillation.
    # @details
    # If teacher_share_frozen is True, we return a lightweight teacher "view" that reuses the same
    # underlying model instance but is expected to be called under torch.no_grad() to avoid gradient cost.
    # Otherwise, we deep-copy the wrapped student model and freeze it.
    # @return Any Teacher model (callable).
    def build_teacher(self) -> Any:
        if self._teacher_built and self._teacher is not None:
            return self._teacher

        # The wrapped APTModelWrapper stores the actual transformers model at .model.
        base_model = getattr(self._student, "model", None)
        if base_model is None:
            raise AttributeError("APTModelWrapper must expose the underlying model as attribute 'model'.")

        if bool(self._cfg.teacher_share_frozen):
            # Share parameters by reference (frozen sharing). Teacher is the same base model executed under no_grad.
            teacher = base_model
            # Make sure teacher is in eval mode for stable distillation targets.
            if hasattr(teacher, "eval") and callable(getattr(teacher, "eval")):
                teacher.eval()
            # Do not modify requires_grad on shared model; student training needs grads for adapter params.
            self._teacher = teacher
            self._teacher_built = True
            return self._teacher

        # Fallback: deep-copied teacher with all params frozen.
        teacher = copy.deepcopy(base_model)
        if hasattr(teacher, "eval") and callable(getattr(teacher, "eval")):
            teacher.eval()
        for p in teacher.parameters():
            p.requires_grad_(False)

        self._teacher = teacher
        self._teacher_built = True
        return self._teacher

    ## @brief Compute μ for the distillation objective.
    # @details Implements config.yaml "mu_schedule: linear_0_to_1" exactly:
    # μ = clamp(global_step / total_steps, 0, 1)
    # @param global_step int Current step.
    # @param total_steps int Total distillation steps.
    # @return float μ in [0,1].
    def compute_mu(self, global_step: int, total_steps: int) -> float:
        schedule = str(self._cfg.distill_mu_schedule or "linear_0_to_1").strip()
        if schedule != "linear_0_to_1":
            raise ValueError(
                f"Unsupported distill_mu_schedule='{schedule}'. Expected 'linear_0_to_1' per config.yaml."
            )

        t = int(global_step)
        T = int(total_steps)
        if T <= 0:
            # Degenerate schedule; keep μ=0 to avoid distillation dominating unexpectedly.
            return 0.0
        mu = float(t) / float(T)
        if mu < 0.0:
            mu = 0.0
        if mu > 1.0:
            mu = 1.0
        return float(mu)

    ## @brief Compute distillation + task losses and return decomposed outputs.
    # @details
    # Implements paper objective:
    #   L = μ L_distill + (1-μ) L_ft
    #
    # L_ft:
    # - taken from student_outputs.loss (Hugging Face convention when labels are provided).
    #
    # L_distill:
    # - prediction term: L_pred = D_KL(p_s || p_t)
    # - layer term:      L_layer = Σ_{i=1}^4 MSE(Tr(H_s^{φ(i)}), H_t^i) with step-wise random teacher layer sampling
    #   and CoFi-style closest-layer mapping.
    #
    # Task-dependent combination (paper):
    # - GLUE:          L_distill = L_pred + 0.9 L_layer
    # - SQuAD/CNN-DM:  L_distill = 0.1 L_pred + 0.9 L_layer
    #
    # @param student_outputs Any Model outputs from student forward pass.
    # @param teacher_outputs Any Model outputs from teacher forward pass.
    # @param batch dict Training batch (used to infer dataset/task for weighting when possible).
    # @param mu float Distillation mixing coefficient in [0,1].
    # @return DistillLossOutput Loss components.
    def compute_loss(
        self,
        student_outputs: Any,
        teacher_outputs: Any,
        batch: Dict[str, Any],
        mu: float,
    ) -> DistillLossOutput:
        mu_f = float(mu)
        if mu_f < 0.0 or mu_f > 1.0:
            raise ValueError(f"mu must be in [0,1], got {mu_f}")

        task_loss = self._extract_task_loss(student_outputs=student_outputs)
        pred_loss = self._compute_pred_distill_loss(
            student_outputs=student_outputs, teacher_outputs=teacher_outputs
        )
        layer_loss = self._compute_layer_distill_loss(
            student_outputs=student_outputs, teacher_outputs=teacher_outputs
        )

        pred_w, layer_w = self._distill_weights_for_task(batch=batch)
        distill_loss = (pred_w * pred_loss) + (layer_w * layer_loss)

        # Exact paper formula:
        #   L = μ L_distill + (1-μ) L_ft
        total_loss = (mu_f * distill_loss) + ((1.0 - mu_f) * task_loss)

        return DistillLossOutput(
            total_loss=total_loss,
            task_loss=task_loss,
            distill_loss=distill_loss,
            layer_loss=layer_loss,
        )

    ## @brief Build teacher-student layer mapping φ.
    # @details
    # Paper requires φ recomputed every step based on closest non-pruned student layers; therefore this
    # method is only a backward-compatible placeholder returning an empty mapping (actual mapping is
    # computed inside _compute_layer_distill_loss using hidden states).
    #
    # @return dict[int, int] Layer mapping φ.
    def map_teacher_to_student_layers(self) -> Dict[int, int]:
        # Do NOT cache; mapping is step-dependent. We keep this method for interface stability.
        return {}

    ## @brief Extract supervised task loss from student outputs.
    # @param student_outputs Any Model outputs.
    # @return torch.Tensor Supervised loss tensor.
    def _extract_task_loss(self, student_outputs: Any) -> torch.Tensor:
        loss = getattr(student_outputs, "loss", None)
        if loss is None:
            raise ValueError(
                "student_outputs.loss is required for distillation but is missing. "
                "Ensure labels are passed to the model forward during training."
            )
        if not torch.is_tensor(loss):
            raise TypeError(f"student_outputs.loss must be torch.Tensor, got {type(loss)}")
        return loss

    ## @brief Compute prediction-layer distillation loss L_pred = D_KL(p_s || p_t).
    # @details
    # Implements paper requirement: cross-entropy/KL between output probability distributions p_s and p_t.
    # We compute:
    #   L_pred = Σ p_s * (log p_s - log p_t)
    # using logits -> log_softmax/softmax.
    #
    # @param student_outputs Any Student outputs.
    # @param teacher_outputs Any Teacher outputs.
    # @return torch.Tensor Prediction distillation loss (scalar tensor).
    def _compute_pred_distill_loss(self, student_outputs: Any, teacher_outputs: Any) -> torch.Tensor:
        s_logits = getattr(student_outputs, "logits", None)
        t_logits = getattr(teacher_outputs, "logits", None)

        if s_logits is None or t_logits is None:
            return self._zero_like_loss_reference(student_outputs=student_outputs)

        if (not torch.is_tensor(s_logits)) or (not torch.is_tensor(t_logits)):
            return self._zero_like_loss_reference(student_outputs=student_outputs)

        if s_logits.shape != t_logits.shape:
            # Shapes may differ in QA heads or different vocab projections; skip pred distill safely.
            return self._zero_like_loss_reference(student_outputs=student_outputs)

        # Teacher is target distribution; ensure no gradients flow into teacher path.
        t_logits = t_logits.detach()

        # p_s, p_t over the last dimension (class/vocab)
        log_p_s = F.log_softmax(s_logits, dim=-1)
        p_s = log_p_s.exp()
        log_p_t = F.log_softmax(t_logits, dim=-1)

        # D_KL(p_s || p_t) = sum p_s * (log p_s - log p_t)
        # Use batchmean reduction to get a scalar consistent across shapes.
        return F.kl_div(log_p_t, p_s, reduction="batchmean", log_target=True)

    ## @brief Compute hidden-state layer distillation loss L_layer.
    # @details Implements:
    #   L_layer = Σ_{i=1}^4 MSE(Tr(H_s^{φ(i)}), H_t^i)
    #
    # Random teacher layer sampling (paper): sample 4 teacher layers per quarter slice each training step.
    # For each sampled teacher layer i, determine φ(i) by choosing the closest non-pruned student layer j:
    #   φ(i) = argmin_{j: z_FFN^(j) > 0} MSE(Tr(H_s^j), H_t^i)
    # where Tr is a learnable linear map initialized as identity.
    #
    # Notes/assumptions in this codebase:
    # - We do not have public access to z_FFN^(j); we treat all student layers as eligible (non-pruned)
    #   since APT pruning here does not remove whole layers in the public interface.
    # - Mapping is recomputed every call (i.e., every step), as required.
    #
    # Hidden state selection:
    # - Prefer decoder_hidden_states if present (seq2seq).
    # - Else use hidden_states.
    #
    # @param student_outputs Any Student outputs.
    # @param teacher_outputs Any Teacher outputs.
    # @return torch.Tensor Layer loss (scalar tensor).
    def _compute_layer_distill_loss(self, student_outputs: Any, teacher_outputs: Any) -> torch.Tensor:
        s_states = self._select_hidden_state_stack(outputs=student_outputs)
        t_states = self._select_hidden_state_stack(outputs=teacher_outputs)

        if s_states is None or t_states is None:
            return self._zero_like_loss_reference(student_outputs=student_outputs)

        if not isinstance(s_states, (tuple, list)) or not isinstance(t_states, (tuple, list)):
            return self._zero_like_loss_reference(student_outputs=student_outputs)

        # Hidden states often include embeddings at index 0; the paper references layers, so we use layer indices.
        # We assume states[1:] correspond to transformer blocks.
        s_layers = list(s_states)[1:] if len(s_states) > 1 else []
        t_layers = list(t_states)[1:] if len(t_states) > 1 else []

        if len(s_layers) == 0 or len(t_layers) == 0:
            return self._zero_like_loss_reference(student_outputs=student_outputs)

        # Sample teacher layers: 4 layers in each quarter slice (with replacement if slice too small).
        sampled_teacher_idxs = self._sample_teacher_layers_quarter_slices(num_teacher_layers=len(t_layers))

        # Ensure Tr exists and matches hidden size.
        d = self._infer_hidden_size_from_states(s_layers=s_layers, t_layers=t_layers)
        if d is None:
            return self._zero_like_loss_reference(student_outputs=student_outputs)
        self._ensure_tr_layer(hidden_size=d, device=self._infer_device_from_states(s_layers, t_layers), dtype=self._infer_dtype_from_states(s_layers, t_layers))

        assert self._tr_layer is not None

        # Compute mapping dynamically by minimizing MSE(Tr(H_s^j), H_t^i) over eligible student layers.
        # We detach teacher targets; student and Tr have grads.
        losses: List[torch.Tensor] = []
        for t_idx in sampled_teacher_idxs:
            if t_idx < 0 or t_idx >= len(t_layers):
                continue
            hs_t = t_layers[t_idx]
            if not torch.is_tensor(hs_t):
                continue
            hs_t = hs_t.detach()

            best_loss: Optional[torch.Tensor] = None
            # Eligible student layers: all (we do not have z_FFN gating exposed).
            for s_idx in range(len(s_layers)):
                hs_s = s_layers[s_idx]
                if not torch.is_tensor(hs_s):
                    continue
                if hs_s.shape != hs_t.shape:
                    continue
                # Apply Tr (W_layer) to the last dimension.
                # hs_*: [batch, seq, d] (typical). Linear applies on last dim.
                hs_s_tr = self._tr_layer(hs_s)
                cur = F.mse_loss(hs_s_tr, hs_t)
                if best_loss is None or cur < best_loss:
                    best_loss = cur

            if best_loss is not None:
                losses.append(best_loss)

        if len(losses) == 0:
            return self._zero_like_loss_reference(student_outputs=student_outputs)

        # Sum over the 4 sampled teacher layers (paper formula Σ_{i=1}^4 ...).
        layer_loss = losses[0]
        for l in losses[1:]:
            layer_loss = layer_loss + l
        return layer_loss

    ## @brief Select an appropriate hidden-state stack from model outputs.
    # @details For seq2seq models, prefers decoder_hidden_states; otherwise uses hidden_states.
    # @param outputs Any Model outputs.
    # @return Optional[tuple|list] Hidden states stack or None.
    def _select_hidden_state_stack(self, outputs: Any) -> Optional[Any]:
        if outputs is None:
            return None
        dec_states = getattr(outputs, "decoder_hidden_states", None)
        if dec_states is not None:
            return dec_states
        return getattr(outputs, "hidden_states", None)

    ## @brief Create a scalar zero tensor with correct dtype/device for loss accumulation.
    # @param student_outputs Any Student outputs used as reference (loss/logits tensors).
    # @return torch.Tensor Zero scalar tensor on the same device/dtype as student loss when available.
    def _zero_like_loss_reference(self, student_outputs: Any) -> torch.Tensor:
        ref = getattr(student_outputs, "loss", None)
        if torch.is_tensor(ref):
            return ref.detach() * 0.0
        logits = getattr(student_outputs, "logits", None)
        if torch.is_tensor(logits):
            return logits.sum() * 0.0
        # Final fallback: CPU float tensor.
        return torch.tensor(0.0, dtype=torch.float32)

    def _distill_weights_for_task(self, batch: Dict[str, Any]) -> torch.Tuple[torch.Tensor, torch.Tensor]:  # type: ignore[name-defined]
        """
        Task-dependent weighting (paper):
          GLUE:          L_distill = L_pred + 0.9 L_layer
          SQuAD/CNN-DM:  L_distill = 0.1 L_pred + 0.9 L_layer

        We infer the task/dataset from config (preferred) or batch metadata when available; default to GLUE weights.
        """
        # Defaults to GLUE
        pred_w = 1.0
        layer_w = 0.9

        # Heuristics: look for dataset/task name in config or batch
        name_candidates: List[str] = []
        for attr in ("task_name", "dataset_name", "dataset", "data_name"):
            if hasattr(self._cfg, attr):
                v = getattr(self._cfg, attr)
                if isinstance(v, str) and v:
                    name_candidates.append(v)
        for k in ("task_name", "dataset_name", "dataset", "data_name"):
            v = batch.get(k, None)
            if isinstance(v, str) and v:
                name_candidates.append(v)

        joined = " ".join(name_candidates).lower()

        # SQuAD / CNN-DM rule
        if ("squad" in joined) or ("cnn" in joined) or ("cnndm" in joined) or ("cnn/dm" in joined) or ("cnn_dm" in joined):
            pred_w = 0.1
            layer_w = 0.9

        # return as python floats? keep as tensors? compute_loss expects scalar multipliers; use floats.
        return torch.tensor(pred_w, device=self._infer_device_from_outputs(student_outputs=None, teacher_outputs=None), dtype=torch.float32), torch.tensor(  # type: ignore[arg-type]
            layer_w, device=self._infer_device_from_outputs(student_outputs=None, teacher_outputs=None), dtype=torch.float32
        )

    def _infer_device_from_outputs(self, student_outputs: Any, teacher_outputs: Any) -> torch.device:
        # Best-effort device inference for small scalar weights; fall back to student's loss device when available.
        if student_outputs is not None:
            ref = getattr(student_outputs, "loss", None)
            if torch.is_tensor(ref):
                return ref.device
            logits = getattr(student_outputs, "logits", None)
            if torch.is_tensor(logits):
                return logits.device
        if teacher_outputs is not None:
            logits = getattr(teacher_outputs, "logits", None)
            if torch.is_tensor(logits):
                return logits.device
        return torch.device("cpu")

    def _sample_teacher_layers_quarter_slices(self, num_teacher_layers: int) -> List[int]:
        """
        Sample 4 teacher layers in each quarter slice of the *layer indices* [0, num_teacher_layers-1].
        Sampling is random at every call (every training step).
        """
        n = int(num_teacher_layers)
        if n <= 0:
            return []

        # Compute quarter boundaries over layer indices.
        # We follow the example in the paper (12 layers -> [0-2],[3-5],[6-8],[9-11]) which is equal-sized.
        # For general n, we partition into 4 contiguous slices as evenly as possible.
        # Use torch for RNG so caller can control reproducibility via torch.manual_seed.
        boundaries = [0]
        for q in range(1, 4):
            boundaries.append(int(round(q * n / 4)))
        boundaries.append(n)

        sampled: List[int] = []
        for q in range(4):
            start = boundaries[q]
            end = boundaries[q + 1]
            if end <= start:
                continue
            slice_indices = torch.arange(start, end, device="cpu")
            # Sample 4 per slice; if slice smaller than 4, sample with replacement.
            if slice_indices.numel() >= 4:
                perm = slice_indices[torch.randperm(slice_indices.numel())]
                chosen = perm[:4].tolist()
            else:
                # with replacement
                rand_idx = torch.randint(low=0, high=slice_indices.numel(), size=(4,), device="cpu")
                chosen = slice_indices[rand_idx].tolist()
            sampled.extend([int(x) for x in chosen])

        # If for some degenerate n we got fewer than 4*4 samples, pad by sampling globally.
        target = 16
        if len(sampled) < target:
            extra = target - len(sampled)
            rand_idx = torch.randint(low=0, high=n, size=(extra,), device="cpu").tolist()
            sampled.extend([int(x) for x in rand_idx])

        # The paper states "T is block-wise randomly sampled teacher layers"; we keep duplicates if sampled.
        return sampled[:target]

    def _infer_hidden_size_from_states(self, s_layers: List[Any], t_layers: List[Any]) -> Optional[int]:
        # Find first tensor in either list and infer last-dim size.
        for st in s_layers:
            if torch.is_tensor(st) and st.ndim >= 2:
                return int(st.shape[-1])
        for st in t_layers:
            if torch.is_tensor(st) and st.ndim >= 2:
                return int(st.shape[-1])
        return None

    def _infer_device_from_states(self, s_layers: List[Any], t_layers: List[Any]) -> torch.device:
        for st in s_layers:
            if torch.is_tensor(st):
                return st.device
        for st in t_layers:
            if torch.is_tensor(st):
                return st.device
        return torch.device("cpu")

    def _infer_dtype_from_states(self, s_layers: List[Any], t_layers: List[Any]) -> torch.dtype:
        for st in s_layers:
            if torch.is_tensor(st):
                return st.dtype
        for st in t_layers:
            if torch.is_tensor(st):
                return st.dtype
        return torch.float32

    def _ensure_tr_layer(self, hidden_size: int, device: torch.device, dtype: torch.dtype) -> None:
        d = int(hidden_size)
        if d <= 0:
            return

        if self._tr_layer is not None:
            # Recreate only if hidden size mismatches.
            if self._tr_layer.in_features == d and self._tr_layer.out_features == d:
                # Ensure on correct device/dtype.
                self._tr_layer.to(device=device, dtype=dtype)
                return

        # Create W_layer initialized to identity matrix I (exactly).
        layer = nn.Linear(d, d, bias=False)
        with torch.no_grad():
            layer.weight.zero_()
            layer.weight += torch.eye(d, dtype=layer.weight.dtype)
        layer.to(device=device, dtype=dtype)

        # Register into student module so optimizer can see it if it collects parameters from wrapper/model.
        # If wrapper exposes a module container, prefer attaching there; else keep as member parameter.
        # We keep interface unchanged; this parameter will still receive gradients as it is referenced in loss.
        self._tr_layer = layer

    # Backward-compatibility helper: previous code had nearest-layer mapping.
    # Kept private and unused now.
    def _compute_nearest_layer_mapping(self, teacher_len: int, student_len: int) -> Dict[int, int]:
        T = int(teacher_len)
        S = int(student_len)
        if T <= 0 or S <= 0:
            return {}
        if T == S:
            return {i: i for i in range(T)}
        if T == 1:
            return {0: 0}
        mapping: Dict[int, int] = {}
        for t_idx in range(T):
            s_idx_float = float(t_idx) * float(S - 1) / float(T - 1)
            s_idx = int(round(s_idx_float))
            s_idx = max(0, min(s_idx, S - 1))
            mapping[int(t_idx)] = int(s_idx)
        return mapping
