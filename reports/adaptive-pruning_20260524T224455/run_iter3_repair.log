from __future__ import annotations

from typing import Any, Dict, Optional

import torch
import torch.nn as nn
import torch.nn.functional as F


## @brief APT adapter linear layer with input/output masks and dynamic LoRA rank.
# @details
# Implements Equation (2) from the paper:
#   H_apt(X) = m_o • (W + s • W_B W_A) X • m_i
#
# Practical PyTorch implementation:
#   x' = x ⊙ m_i
#   y = Linear_W(x') + s * Linear_B(Linear_A(x'))
#   y' = y ⊙ m_o
#
# Notes:
# - Base linear parameters are frozen (PEFT setting).
# - Masks are registered buffers (float, typically in [0,1] due to gradual updates).
# - Dynamic rank expansion appends Gaussian rows to W_A and zeros columns to W_B so the
#   immediate output is unchanged after expansion (as described in Section 4.3).
#
# IMPORTANT (Paper fidelity):
# - When this module wraps MHA query/value projections, m_o prunes *attention heads* (structured),
#   not arbitrary output dimensions. In that case, a head-level mask of shape [num_heads] must be
#   expanded to an output-dimension mask by repeating each head mask over its contiguous head_dim.
#   This module supports both:
#     (a) dimension-level output masks: shape [out_features] (FFN neuron pruning etc.)
#     (b) head-level output masks: shape [num_heads] with provided metadata num_heads/head_dim.
class APTLinear(nn.Module):
    ## @brief Initialize an APTLinear wrapper.
    # @param base_linear nn.Linear Pretrained linear layer to wrap; will be frozen.
    # @param in_features int Input feature dimension d_i.
    # @param out_features int Output feature dimension d_o.
    # @param rank int Initial adapter rank r_apt.
    # @param alpha float Scaling factor s (paper config.yaml apt.scaling_factor=2).
    # @param module_name str Fully qualified module name in the parent model.
    # @param group_name str Structural group name for pruning/tuning bookkeeping.
    def __init__(
        self,
        base_linear: nn.Linear,
        in_features: int,
        out_features: int,
        rank: int,
        alpha: float,
        module_name: str,
        group_name: str,
    ) -> None:
        super().__init__()

        if not isinstance(base_linear, nn.Linear):
            raise TypeError(f"base_linear must be nn.Linear, got {type(base_linear)}")
        if int(in_features) <= 0 or int(out_features) <= 0:
            raise ValueError("in_features and out_features must be positive.")
        if int(rank) < 0:
            raise ValueError("rank must be >= 0.")
        if float(alpha) <= 0.0:
            raise ValueError("alpha (scaling factor) must be > 0.")

        self.base_linear: nn.Linear = base_linear
        self.in_features: int = int(in_features)
        self.out_features: int = int(out_features)

        # Sanity-check consistency with the wrapped layer.
        if int(self.base_linear.in_features) != self.in_features:
            raise ValueError(
                f"in_features mismatch: passed={self.in_features} base_linear.in_features={self.base_linear.in_features}"
            )
        if int(self.base_linear.out_features) != self.out_features:
            raise ValueError(
                f"out_features mismatch: passed={self.out_features} base_linear.out_features={self.base_linear.out_features}"
            )

        self.alpha: float = float(alpha)
        self.module_name: str = str(module_name)
        self.group_name: str = str(group_name)

        # Freeze pretrained parameters (PEFT setting).
        self.base_linear.weight.requires_grad_(False)
        if self.base_linear.bias is not None:
            self.base_linear.bias.requires_grad_(False)

        # Masks (m_i, m_o) as buffers so they move with device and are saved in state_dict.
        self.register_buffer(
            "input_mask",
            torch.ones(self.in_features, dtype=self.base_linear.weight.dtype),
            persistent=True,
        )
        # Default output mask is per-output-dimension. For attention head pruning, callers may set
        # a head-level mask via set_output_mask([num_heads]) and provide metadata num_heads/head_dim.
        self.register_buffer(
            "output_mask",
            torch.ones(self.out_features, dtype=self.base_linear.weight.dtype),
            persistent=True,
        )

        # LoRA parameters W_A (rank x in) and W_B (out x rank).
        self.lora_A: Optional[nn.Parameter]
        self.lora_B: Optional[nn.Parameter]
        if int(rank) == 0:
            self.lora_A = None
            self.lora_B = None
        else:
            # LoRA-style init: A ~ N(0, std^2), B = 0 so initial adapter is no-op.
            # The paper specifies that new parameters are appended with Gaussian in W_A and zeros in W_B.
            init_std = 0.02
            a = torch.empty((int(rank), self.in_features), dtype=self.base_linear.weight.dtype)
            nn.init.normal_(a, mean=0.0, std=float(init_std))
            b = torch.zeros((self.out_features, int(rank)), dtype=self.base_linear.weight.dtype)
            self.lora_A = nn.Parameter(a, requires_grad=True)
            self.lora_B = nn.Parameter(b, requires_grad=True)

        # Track merged state to avoid double-merge.
        self._merged: bool = False

        # Extra metadata can be attached by injector/registry if desired.
        # Expected keys (when used for MHA head pruning):
        #   - "output_block_type": "head"
        #   - "num_heads": int
        #   - "head_dim": int
        self._metadata: Dict[str, Any] = {}

    def _expanded_output_mask(self, x: torch.Tensor) -> torch.Tensor:
        """
        Return an output mask broadcastable to y[..., out_features], supporting:
        - dimension-level masks: output_mask shape [out_features]
        - head-level masks: output_mask shape [num_heads] expanded by repeating each head over head_dim
          (requires metadata num_heads/head_dim and contiguous head layout).
        """
        out_mask = self.output_mask
        if out_mask.device != x.device:
            out_mask = out_mask.to(device=x.device)
        if out_mask.dtype != x.dtype:
            out_mask = out_mask.to(dtype=x.dtype)

        # If metadata indicates head-structured pruning, allow head-level masks.
        meta = self._metadata
        output_block_type = meta.get("output_block_type", None)
        if output_block_type == "head":
            num_heads = meta.get("num_heads", None)
            head_dim = meta.get("head_dim", None)
            if num_heads is None or head_dim is None:
                raise RuntimeError(
                    f"{self.module_name}: output_block_type='head' but metadata missing num_heads/head_dim."
                )
            num_heads = int(num_heads)
            head_dim = int(head_dim)
            if num_heads <= 0 or head_dim <= 0:
                raise RuntimeError(
                    f"{self.module_name}: invalid num_heads/head_dim in metadata: num_heads={num_heads}, head_dim={head_dim}"
                )
            if num_heads * head_dim != self.out_features:
                raise RuntimeError(
                    f"{self.module_name}: out_features={self.out_features} must equal num_heads*head_dim={num_heads*head_dim} "
                    f"for head-structured masking."
                )
            if out_mask.dim() != 1:
                raise ValueError(
                    f"{self.module_name}: output mask must be 1D; got shape {tuple(out_mask.shape)}"
                )

            if int(out_mask.shape[0]) == num_heads:
                # Expand head mask -> per-dimension mask [out_features]
                out_mask = out_mask.repeat_interleave(head_dim, dim=0)
            elif int(out_mask.shape[0]) == self.out_features:
                # Already expanded, accept.
                pass
            else:
                raise ValueError(
                    f"{self.module_name}: head-structured output mask must have shape [{num_heads}] or [{self.out_features}], "
                    f"got {tuple(out_mask.shape)}"
                )

        return out_mask

    ## @brief Forward pass applying APT equation with masks and low-rank adapter.
    # @param x torch.Tensor Input tensor of shape [..., in_features].
    # @return torch.Tensor Output tensor of shape [..., out_features].
    def forward(self, x: torch.Tensor) -> torch.Tensor:
        if not torch.is_tensor(x):
            raise TypeError(f"APTLinear.forward expected torch.Tensor, got {type(x)}")
        if x.numel() == 0:
            # Preserve shape semantics for empty tensors.
            return self.base_linear(x)

        # Ensure input mask matches input device/dtype for safe broadcast.
        in_mask = self.input_mask
        if in_mask.device != x.device:
            in_mask = in_mask.to(device=x.device)
        if in_mask.dtype != x.dtype:
            in_mask = in_mask.to(dtype=x.dtype)

        # Broadcast masks to the last dimension.
        # x[..., in_features] * [in_features]
        x_masked = x * in_mask

        # Base frozen projection.
        y = self.base_linear(x_masked)

        # Low-rank update if not merged and rank > 0.
        if (not self._merged) and (self.lora_A is not None) and (self.lora_B is not None):
            # Compute s * (x W_A^T) W_B^T using two linear ops to avoid materializing W_B W_A.
            # z: [..., rank]
            z = F.linear(x_masked, self.lora_A, bias=None)
            # delta: [..., out_features]
            delta = F.linear(z, self.lora_B, bias=None)
            y = y + (self.alpha * delta)

        # Apply output mask.
        out_mask = self._expanded_output_mask(y)
        y = y * out_mask
        return y

    ## @brief Set the input mask m_i.
    # @param mask torch.Tensor New input mask of shape [in_features].
    # @return None
    def set_input_mask(self, mask: torch.Tensor) -> None:
        if not torch.is_tensor(mask):
            raise TypeError(f"mask must be torch.Tensor, got {type(mask)}")
        if mask.dim() != 1 or int(mask.shape[0]) != self.in_features:
            raise ValueError(
                f"Input mask must have shape [{self.in_features}], got {tuple(mask.shape)}"
            )
        # Store as float buffer in module dtype, on module device.
        tgt_dtype = self.base_linear.weight.dtype
        tgt_device = self.base_linear.weight.device
        with torch.no_grad():
            self.input_mask.copy_(mask.to(device=tgt_device, dtype=tgt_dtype))

    ## @brief Set the output mask m_o.
    # @details
    # Supports two forms:
    # - Dimension-level mask: shape [out_features]
    # - Head-level mask: shape [num_heads] ONLY when metadata['output_block_type']=="head"
    #   (will be expanded during forward to prune attention heads as a structured block).
    # @param mask torch.Tensor New output mask.
    # @return None
    def set_output_mask(self, mask: torch.Tensor) -> None:
        if not torch.is_tensor(mask):
            raise TypeError(f"mask must be torch.Tensor, got {type(mask)}")
        if mask.dim() != 1:
            raise ValueError(f"Output mask must be 1D, got {tuple(mask.shape)}")

        tgt_dtype = self.base_linear.weight.dtype
        tgt_device = self.base_linear.weight.device

        meta = self._metadata
        output_block_type = meta.get("output_block_type", None)

        # If head-structured, accept either [num_heads] or [out_features] and store an expanded mask.
        if output_block_type == "head":
            num_heads = meta.get("num_heads", None)
            head_dim = meta.get("head_dim", None)
            if num_heads is None or head_dim is None:
                raise RuntimeError(
                    f"{self.module_name}: output_block_type='head' but metadata missing num_heads/head_dim."
                )
            num_heads = int(num_heads)
            head_dim = int(head_dim)
            if num_heads * head_dim != self.out_features:
                raise RuntimeError(
                    f"{self.module_name}: out_features={self.out_features} must equal num_heads*head_dim={num_heads*head_dim} "
                    f"for head-structured masking."
                )

            if int(mask.shape[0]) == num_heads:
                expanded = mask.repeat_interleave(head_dim, dim=0)
            elif int(mask.shape[0]) == self.out_features:
                expanded = mask
            else:
                raise ValueError(
                    f"Head-structured output mask must have shape [{num_heads}] or [{self.out_features}], got {tuple(mask.shape)}"
                )

            with torch.no_grad():
                self.output_mask.copy_(expanded.to(device=tgt_device, dtype=tgt_dtype))
            return

        # Default: dimension-level mask.
        if int(mask.shape[0]) != self.out_features:
            raise ValueError(
                f"Output mask must have shape [{self.out_features}], got {tuple(mask.shape)}"
            )
        with torch.no_grad():
            self.output_mask.copy_(mask.to(device=tgt_device, dtype=tgt_dtype))

    ## @brief Expand the adapter rank by appending new rows/columns.
    # @details
    # Implements paper Section 4.3 expansion rule:
    # - W_A appended with Gaussian N(0, sigma^2)
    # - W_B appended with zeros
    # This ensures the layer output is unchanged immediately after expansion.
    # @param new_rank int New rank r'_apt (must be >= current rank).
    # @param init_std float Standard deviation sigma for Gaussian initialization of new W_A rows.
    # @return None
    def expand_rank(self, new_rank: int, init_std: float = 0.02) -> None:
        if self._merged:
            raise RuntimeError("Cannot expand rank after merge_adapter(); merge is intended for export/inference.")
        nr = int(new_rank)
        if nr < 0:
            raise ValueError("new_rank must be >= 0.")
        if float(init_std) <= 0.0:
            raise ValueError("init_std must be > 0.")

        cur = self.current_rank()
        if nr <= cur:
            return

        device = self.base_linear.weight.device
        dtype = self.base_linear.weight.dtype

        # Handle previously rank-0 adapters.
        if cur == 0:
            a = torch.empty((nr, self.in_features), device=device, dtype=dtype)
            nn.init.normal_(a, mean=0.0, std=float(init_std))
            b = torch.zeros((self.out_features, nr), device=device, dtype=dtype)
            self.lora_A = nn.Parameter(a, requires_grad=True)
            self.lora_B = nn.Parameter(b, requires_grad=True)
            return

        if self.lora_A is None or self.lora_B is None:
            raise RuntimeError("Invariant violated: current_rank > 0 but LoRA params are None.")

        # Create new tensors.
        a_new = torch.empty((nr, self.in_features), device=device, dtype=dtype)
        b_new = torch.zeros((self.out_features, nr), device=device, dtype=dtype)

        with torch.no_grad():
            # Copy old parameters.
            a_new[:cur, :].copy_(self.lora_A.data)
            b_new[:, :cur].copy_(self.lora_B.data)

            # Initialize appended part.
            nn.init.normal_(a_new[cur:, :], mean=0.0, std=float(init_std))
            # b_new[:, cur:] already zeros => output-preserving.

        # Replace parameters (optimizer must be reset by trainer after this).
        self.lora_A = nn.Parameter(a_new, requires_grad=True)
        self.lora_B = nn.Parameter(b_new, requires_grad=True)

    ## @brief Merge the adapter weights into the frozen base weight.
    # @details
    # After merging:
    #   W <- W + s * (W_B W_A)
    # and the low-rank branch is disabled for future forward passes.
    # This matches the paper's note that LoRA-style adapters can be merged to avoid inference overhead.
    # @return None
    def merge_adapter(self) -> None:
        if self._merged:
            return
        if self.lora_A is None or self.lora_B is None:
            # Rank-0 adapter: nothing to merge.
            self._merged = True
            return

        with torch.no_grad():
            # delta_W: [out_features, in_features] = W_B @ W_A
            delta_w = torch.matmul(self.lora_B.data, self.lora_A.data)
            self.base_linear.weight.data = self.base_linear.weight.data + (self.alpha * delta_w)

        self._merged = True

    ## @brief Get current adapter rank.
    # @param None
    # @return int Current rank (0 if adapter disabled).
    def current_rank(self) -> int:
        if self.lora_A is None:
            return 0
        return int(self.lora_A.shape[0])

    ## @brief Count the number of tunable (trainable) parameters in this adapter.
    # @details Counts only W_A and W_B. Masks and frozen base weights are excluded.
    # @param None
    # @return int Number of tunable parameters.
    def num_tunable_params(self) -> int:
        r = self.current_rank()
        if r == 0:
            return 0
        return int(r * self.in_features + self.out_features * r)

    ## @brief Estimate the number of active parameters under current masks.
    # @details
    # Provides a local, mask-aware estimate of active parameters for this layer:
    # - active_in = count(input_mask > 0)
    # - active_out = count(output_mask > 0) (dimension-level after any expansion)
    # Active base params approximated as active_out * active_in (bias ignored).
    # Active adapter params approximated as r * active_in + active_out * r.
    #
    # This is a layer-local estimate; global parameter accounting is handled elsewhere.
    # @param None
    # @return int Estimated number of active parameters.
    def num_active_params(self) -> int:
        with torch.no_grad():
            active_in = int(torch.count_nonzero(self.input_mask > 0.0).item())
            active_out = int(torch.count_nonzero(self.output_mask > 0.0).item())
        r = self.current_rank()

        base_params = int(active_out * active_in)
        adapter_params = int(r * active_in + active_out * r) if r > 0 else 0
        return int(base_params + adapter_params)

    ## @brief Collect structure metadata for this module for registry/export/debugging.
    # @param None
    # @return dict[str, Any] Serializable metadata.
    def collect_structure_metadata(self) -> Dict[str, Any]:
        meta: Dict[str, Any] = {
            "module_name": self.module_name,
            "group_name": self.group_name,
            "in_features": int(self.in_features),
            "out_features": int(self.out_features),
            "rank": int(self.current_rank()),
            "alpha": float(self.alpha),
            "has_bias": bool(self.base_linear.bias is not None),
            "merged": bool(self._merged),
            "input_mask_shape": [int(self.input_mask.shape[0])],
            "output_mask_shape": [int(self.output_mask.shape[0])],
        }
        # Merge in any externally attached metadata (injector/registry may set this).
        for k, v in self._metadata.items():
            if k not in meta:
                meta[str(k)] = v
        return meta
