## src/algorithms/salience.py
from __future__ import annotations

from dataclasses import dataclass
from typing import Any, Dict, List, Mapping, Optional, Tuple

import torch

from src.models.apt_injector import APTRegistry
from src.models.apt_linear import APTLinear


## @brief Structured block score record.
# @details Used by pruning logic for density ranking and budgeted selection.
# @param block_id str Unique identifier for the block (e.g., "{module_name}:head:{idx}").
# @param group str Group name (e.g., registry group name).
# @param block_type str One of {'head','neuron','hidden_dim'}.
# @param salience float Salience value for this block.
# @param param_count int Number of parameters associated with the block.
# @param density float Salience density (salience / param_count).
@dataclass(frozen=True)
class BlockScore:
    block_id: str
    group: str
    block_type: str
    salience: float
    param_count: int
    density: float


## @brief Salience collector for APT adaptive pruning and tuning.
# @details
# Implements paper-described low-cost salience in PEFT settings:
# - For non-APT parameters: salience is |W ⊙ grad(W)| (Eq. 3 in appendix / requirement).
# - For APT adapter pruning salience: combined salience for a block equals frozen-weight salience + tuning-weight salience
#   (paper Appendix B, Eq. 9 reference in rubric). Since frozen weights have no gradients in PEFT, we use the paper's
#   approximation via activations and gradients of activations, and sum it with tuning weight-gradient product salience.
# - Outlier-aware term: + sqrt(max(kurtosis,0)).
# - EMA of outlier-aware block salience must be: 0.85 * prev + 0.15 * current (paper).
#
# Hooking strategy:
# - Forward hook caches outputs (activations).
# - Full backward hook caches grad_output.
#
# Output:
# - get_block_scores(): dict[module_or_global_key][block_type] -> Tensor[blocks]
# - get_adapter_importance(): dict[module_name] -> float
class SalienceCollector:
    _PAPER_EMA_BETA: float = 0.85  # fixed by paper: Sbar^(t) = 0.85 Sbar^(t-1) + 0.15 Shat

    ## @brief Initialize SalienceCollector.
    # @param registry APTRegistry APT module registry.
    # @param ema_beta float EMA coefficient beta in [0, 1). (Kept for interface; paper fixes to 0.85.)
    # @param use_kurtosis bool Whether to add kurtosis outlier bonus for pruning salience.
    def __init__(self, registry: APTRegistry, ema_beta: float, use_kurtosis: bool) -> None:
        if not isinstance(registry, APTRegistry):
            raise TypeError(f"registry must be APTRegistry, got {type(registry)}")
        # Keep validation for interface stability, but enforce paper's EMA in updates.
        beta = float(ema_beta)
        if not (0.0 <= beta < 1.0):
            raise ValueError("ema_beta must be in [0, 1).")

        self._registry: APTRegistry = registry
        self._ema_beta: float = beta
        self._use_kurtosis: bool = bool(use_kurtosis)

        self._hook_handles: List[Any] = []
        self._hooks_attached: bool = False

        # Step-local caches (detached summaries).
        self._act_sum: Dict[str, torch.Tensor] = {}
        self._grad_sum: Dict[str, torch.Tensor] = {}
        self._kurtosis_bonus_feat: Dict[str, torch.Tensor] = {}

        # Step-local cache for non-APT parameter salience (|W ⊙ grad(W)|); stored for completeness/debug.
        self._non_apt_param_salience_step: Dict[str, float] = {}

        # EMA state for pruning salience.
        self._ema_head: Dict[str, torch.Tensor] = {}
        self._ema_neuron: Dict[str, torch.Tensor] = {}
        self._ema_hidden_dim_global: Optional[torch.Tensor] = None
        self._hidden_dim_size: Optional[int] = None

        # EMA state for tuning salience (adapter importance).
        self._ema_adapter_importance: Dict[str, float] = {}

        # Latest step (non-EMA) values (optional introspection).
        self._last_block_scores: Dict[str, Dict[str, torch.Tensor]] = {}
        self._last_adapter_importance: Dict[str, float] = {}

    ## @brief Attach forward/backward hooks to all registered APT modules.
    # @details Hooks call on_forward/on_backward with module_name for deterministic storage.
    # @return None
    def attach_hooks(self) -> None:
        if self._hooks_attached:
            return

        self._hook_handles = []
        for module_name, module in self._registry.named_modules():
            if not isinstance(module, APTLinear):
                continue

            ## @brief Forward hook closure capturing module name.
            # @param mod torch.nn.Module Module invoked.
            # @param inputs tuple Forward inputs.
            # @param output Any Forward output.
            # @return None
            def _fwd_hook(mod: Any, inputs: Tuple[Any, ...], output: Any, _name: str = module_name) -> None:
                _ = mod
                _ = inputs
                if torch.is_tensor(output):
                    self.on_forward(module_name=_name, activations=output)
                elif isinstance(output, (tuple, list)) and output and torch.is_tensor(output[0]):
                    # Some HF modules return tuples; APTLinear returns a tensor, but be robust.
                    self.on_forward(module_name=_name, activations=output[0])

            ## @brief Backward hook closure capturing module name.
            # @param mod torch.nn.Module Module invoked.
            # @param grad_input tuple Gradients w.r.t. inputs.
            # @param grad_output tuple Gradients w.r.t. outputs.
            # @return None
            def _bwd_hook(mod: Any, grad_input: Tuple[Any, ...], grad_output: Tuple[Any, ...], _name: str = module_name) -> None:
                _ = mod
                _ = grad_input
                if isinstance(grad_output, (tuple, list)) and grad_output and torch.is_tensor(grad_output[0]):
                    self.on_backward(module_name=_name, grad_output=grad_output[0])

            # Register hooks.
            self._hook_handles.append(module.register_forward_hook(_fwd_hook))
            # Use full backward hook to reliably get grad_output for module outputs.
            bwd_handle = getattr(module, "register_full_backward_hook", None)
            if callable(bwd_handle):
                self._hook_handles.append(module.register_full_backward_hook(_bwd_hook))
            else:
                # Fallback for older torch: register_backward_hook (deprecated but available).
                self._hook_handles.append(module.register_backward_hook(_bwd_hook))  # type: ignore[attr-defined]

        self._hooks_attached = True

    ## @brief Detach all previously attached hooks.
    # @return None
    def detach_hooks(self) -> None:
        for h in self._hook_handles:
            try:
                h.remove()
            except Exception:
                pass
        self._hook_handles = []
        self._hooks_attached = False

    ## @brief Forward-hook entrypoint.
    # @details
    # Stores:
    # - compressed activation sum over batch/sequence axes
    # - optional per-feature kurtosis bonus (computed from per-sample activations)
    # @param module_name str Registry module name.
    # @param activations torch.Tensor Module output activations.
    # @return None
    def on_forward(self, module_name: str, activations: torch.Tensor) -> None:
        name = str(module_name)
        if not torch.is_tensor(activations):
            raise TypeError(f"activations must be torch.Tensor, got {type(activations)}")

        # Summation-based compression per paper ("summing along batches before production"),
        # generalized to sum across all non-feature dims to support [B,S,D] models efficiently.
        act_sum = self._compress_sum_over_non_feature_dims(x=activations)
        self._act_sum[name] = act_sum.detach()

        if self._use_kurtosis:
            # Compute per-feature kurtosis over samples (flatten non-feature dims), to preserve outlier behavior.
            # Outlier-aware term: (Kurt(O_{j,:}))^{1/2}.
            bonus = self._compute_kurtosis_bonus_from_activations(activations=activations)
            self._kurtosis_bonus_feat[name] = bonus.detach()

    ## @brief Backward-hook entrypoint.
    # @details Stores compressed grad_output sum over batch/sequence axes.
    # @param module_name str Registry module name.
    # @param grad_output torch.Tensor Gradient w.r.t. module output.
    # @return None
    def on_backward(self, module_name: str, grad_output: torch.Tensor) -> None:
        name = str(module_name)
        if not torch.is_tensor(grad_output):
            raise TypeError(f"grad_output must be torch.Tensor, got {type(grad_output)}")

        grad_sum = self._compress_sum_over_non_feature_dims(x=grad_output)
        self._grad_sum[name] = grad_sum.detach()

    ## @brief Update block salience EMA state from the current step caches.
    # @details
    # Computes:
    # - per-module head/neuron salience where applicable (from output axis role)
    # - global hidden-dimension salience aggregated across modules (from output-feature axis)
    # - adapter importance from |W_B ⊙ grad(W_B)| summed over W_B
    # - non-APT parameter salience |W ⊙ grad(W)| for completeness (paper requirement)
    # @return None
    def update_block_salience(self) -> None:
        self._last_block_scores = {}
        self._last_adapter_importance = {}
        self._non_apt_param_salience_step = {}

        # 1) Compute non-APT parameter salience as |W ⊙ grad(W)| for all trainable params outside APT adapters.
        # This satisfies the paper definition for standard parameters. This repository mainly operates PEFT,
        # but we implement the definition exactly for fidelity and potential FT baselines.
        self._collect_non_apt_parameter_salience()

        # Accumulate global hidden-dim current-step scores (size inferred from first module).
        hidden_dim_step: Optional[torch.Tensor] = None
        hidden_dim_size: Optional[int] = None
        hidden_dim_device: Optional[torch.device] = None
        hidden_dim_dtype: Optional[torch.dtype] = None

        for module_name, module in self._registry.named_modules():
            name = str(module_name)
            if name not in self._act_sum or name not in self._grad_sum:
                # If a module isn't exercised in a step, skip.
                continue

            act_sum = self._act_sum[name]
            grad_sum = self._grad_sum[name]
            if act_sum.shape != grad_sum.shape:
                raise ValueError(
                    f"Activation/gradient summary shape mismatch for '{name}': "
                    f"act_sum={tuple(act_sum.shape)} grad_sum={tuple(grad_sum.shape)}"
                )

            # 2) APT adapter block-wise salience: frozen salience (activation-grad proxy) + tuning salience.
            # Paper Appendix B: real block-wise salience for LoRA/APT layer is the sum of frozen block salience
            # and the corresponding tuning weights' block salience.
            frozen_feat_sal = self._compute_activation_grad_salience(act_sum=act_sum, grad_sum=grad_sum)
            tuning_feat_sal = self._compute_tuning_feature_salience(module=module)

            feat_sal = frozen_feat_sal + tuning_feat_sal

            if self._use_kurtosis and name in self._kurtosis_bonus_feat:
                feat_sal = feat_sal + self._kurtosis_bonus_feat[name]

            feat_sal = self._sanitize_nonnegative(feat_sal)

            meta = self._registry.get_metadata(name)
            group = str(meta.get("group", getattr(module, "group_name", "")) or "")

            # Reduce per-feature salience into structured blocks based on output_block_type.
            out_block_type = str(meta.get("output_block_type", "hidden_dim"))
            scores_for_module: Dict[str, torch.Tensor] = {}

            if out_block_type == "head":
                head_scores = self._reduce_feature_to_heads(feat=feat_sal, meta=meta, module_name=name)
                self._ema_head[name] = self._update_ema_tensor(prev=self._ema_head.get(name), new=head_scores)
                scores_for_module["head"] = self._ema_head[name].detach().clone()

            elif out_block_type == "neuron":
                neuron_scores = feat_sal.detach()
                self._ema_neuron[name] = self._update_ema_tensor(prev=self._ema_neuron.get(name), new=neuron_scores)
                scores_for_module["neuron"] = self._ema_neuron[name].detach().clone()

            elif out_block_type == "hidden_dim":
                # This module's output features correspond to hidden dim; we do not produce per-module hidden dim
                # blocks by default, but we do include it in the global hidden-dim aggregation below.
                pass
            else:
                raise ValueError(f"Unexpected output_block_type '{out_block_type}' for module '{name}'")

            if scores_for_module:
                self._last_block_scores[name] = scores_for_module

            # Global hidden-dimension aggregation.
            if hidden_dim_step is None:
                hidden_dim_step = feat_sal.detach().clone()
                hidden_dim_size = int(hidden_dim_step.numel())
                hidden_dim_device = hidden_dim_step.device
                hidden_dim_dtype = hidden_dim_step.dtype
            else:
                if hidden_dim_size != int(feat_sal.numel()):
                    raise ValueError(
                        "Hidden-dimension salience aggregation requires consistent feature sizes across modules. "
                        f"Got previous={hidden_dim_size}, current={int(feat_sal.numel())} for module '{name}'."
                    )
                hidden_dim_step = hidden_dim_step + feat_sal.to(device=hidden_dim_device, dtype=hidden_dim_dtype)  # type: ignore[operator]

            # Adapter importance from W_B parameter salience (paper Section 4.3).
            imp = self._compute_adapter_importance_from_WB(module=module)
            if imp is not None:
                prev_imp = self._ema_adapter_importance.get(name, None)
                new_imp = self._update_ema_scalar(prev=prev_imp, new=float(imp))
                self._ema_adapter_importance[name] = float(new_imp)
                self._last_adapter_importance[name] = float(new_imp)

        # Update global hidden-dim EMA if any modules contributed.
        if hidden_dim_step is not None:
            self._hidden_dim_size = int(hidden_dim_step.numel())
            self._ema_hidden_dim_global = self._update_ema_tensor(prev=self._ema_hidden_dim_global, new=hidden_dim_step)
            self._last_block_scores["__global_hidden_dim__"] = {
                "hidden_dim": self._ema_hidden_dim_global.detach().clone()
            }

    ## @brief Get EMA block scores for pruning.
    # @details
    # Returns dict[str, dict[str, Tensor]] with keys:
    # - module_name -> {"head": Tensor} and/or {"neuron": Tensor}
    # - "__global_hidden_dim__" -> {"hidden_dim": Tensor}
    # @return dict[str, dict[str, torch.Tensor]] Nested mapping of salience scores.
    def get_block_scores(self) -> Dict[str, Dict[str, torch.Tensor]]:
        # Ensure caller gets detached tensors; this is already ensured on update, but keep safe.
        out: Dict[str, Dict[str, torch.Tensor]] = {}
        for k, inner in self._last_block_scores.items():
            out[k] = {}
            for bt, t in inner.items():
                out[k][bt] = t.detach().clone()
        return out

    ## @brief Get EMA adapter importance scores for rank allocation.
    # @details Returns a mapping from module_name to EMA importance scalar.
    # @return dict[str, float] Importance scores.
    def get_adapter_importance(self) -> Dict[str, float]:
        # Include all modules in registry (default missing -> 0.0) to make sorting stable.
        out: Dict[str, float] = {}
        for module_name, _ in self._registry.named_modules():
            name = str(module_name)
            out[name] = float(self._ema_adapter_importance.get(name, 0.0))
        return out

    ## @brief Reset step-local caches.
    # @details Should be called once per optimizer step after update_block_salience().
    # @return None
    def reset_step_cache(self) -> None:
        self._act_sum.clear()
        self._grad_sum.clear()
        self._kurtosis_bonus_feat.clear()
        self._non_apt_param_salience_step.clear()

    ## @brief Compress tensor by summing over all non-feature dimensions.
    # @details For x shaped [..., D], returns Tensor[D] equal to sum over dims 0..(n-2).
    # @param x torch.Tensor Input tensor.
    # @return torch.Tensor Compressed tensor of shape [D].
    def _compress_sum_over_non_feature_dims(self, x: torch.Tensor) -> torch.Tensor:
        if x.dim() == 0:
            return x.reshape(1)
        if x.dim() == 1:
            return x
        # Sum across all dims except last.
        dims = tuple(range(0, x.dim() - 1))
        return x.sum(dim=dims)

    ## @brief Compute compressed activation-gradient product salience.
    # @details Implements the paper-described PEFT salience proxy using activations and their gradients.
    # @param act_sum torch.Tensor Compressed activation sum vector [D].
    # @param grad_sum torch.Tensor Compressed gradient sum vector [D].
    # @return torch.Tensor Nonnegative salience vector [D].
    def _compute_activation_grad_salience(self, act_sum: torch.Tensor, grad_sum: torch.Tensor) -> torch.Tensor:
        # Salience proxy: |sum(H) ⊙ sum(∇H)| (compressed along batch as described).
        s = torch.abs(act_sum) * torch.abs(grad_sum)
        return self._sanitize_nonnegative(s)

    ## @brief Compute tuning-feature salience for an APT layer.
    # @details
    # Paper requirement: for an APT adapter layer, block salience sums frozen block salience and tuning block salience.
    # We approximate tuning contribution on output-feature dimension by aggregating |W_B ⊙ grad(W_B)| over rank dim:
    #   tuning_feat_sal[i] = sum_k |W_B[i,k] * dL/dW_B[i,k]|
    # This aligns with block-wise output-feature salience used for head/neuron pruning (m_o affects output blocks).
    # @param module APTLinear APT module.
    # @return torch.Tensor Per-output-feature salience vector [d_o] (zeros if grad unavailable).
    def _compute_tuning_feature_salience(self, module: APTLinear) -> torch.Tensor:
        # Determine output feature size robustly.
        d_out: Optional[int] = None
        base = getattr(module, "base_linear", None)
        if base is not None and hasattr(base, "out_features"):
            d_out = int(getattr(base, "out_features"))
        if d_out is None:
            # Fallback: infer from lora_B if present, else from cached activations later by caller.
            if module.lora_B is not None:
                d_out = int(module.lora_B.shape[0])

        if d_out is None or d_out <= 0:
            # Should not happen, but keep safe.
            return torch.zeros((0,), device=next(module.parameters()).device)

        wb = module.lora_B
        if wb is None or wb.grad is None:
            # No tuning gradient -> no tuning salience.
            return torch.zeros((d_out,), device=next(module.parameters()).device, dtype=next(module.parameters()).dtype)

        with torch.no_grad():
            sal = torch.abs(wb.data) * torch.abs(wb.grad)
            sal = torch.nan_to_num(sal, nan=0.0, posinf=0.0, neginf=0.0)
            # Sum over rank dimension -> output feature contribution.
            feat = sal.sum(dim=1)
            feat = self._sanitize_nonnegative(feat)
        return feat

    ## @brief Compute outlier-aware kurtosis bonus per feature from activations.
    # @details
    # Computes kurtosis across samples (flatten all non-feature dims), then applies sqrt:
    #   bonus = sqrt(max(kurtosis, 0))
    # This matches the paper's outlier-aware augmentation described around Eq (5).
    # @param activations torch.Tensor Activation tensor of shape [B,...,D].
    # @return torch.Tensor Bonus vector [D].
    def _compute_kurtosis_bonus_from_activations(self, activations: torch.Tensor) -> torch.Tensor:
        if activations.dim() < 2:
            # No meaningful sample dimension.
            return torch.zeros_like(activations.reshape(-1))

        # Flatten all non-feature dims into a sample dimension.
        d = int(activations.shape[-1])
        samples = activations.reshape(-1, d)

        if int(samples.shape[0]) < 2:
            return torch.zeros((d,), device=activations.device, dtype=activations.dtype)

        # Compute kurtosis per feature:
        # kurtosis = E[(x-μ)^4] / (E[(x-μ)^2]^2) - 3 (excess kurtosis)
        # Then bonus = sqrt(max(kurtosis, 0)).
        mu = samples.mean(dim=0)
        xc = samples - mu
        m2 = (xc * xc).mean(dim=0)
        m4 = (xc * xc * xc * xc).mean(dim=0)

        eps = torch.tensor(1e-12, device=samples.device, dtype=samples.dtype)
        denom = torch.maximum(m2 * m2, eps)
        kurt_excess = (m4 / denom) - 3.0

        kurt_excess = torch.nan_to_num(kurt_excess, nan=0.0, posinf=0.0, neginf=0.0)
        kurt_excess = torch.clamp(kurt_excess, min=0.0)
        bonus = torch.sqrt(kurt_excess)
        bonus = torch.nan_to_num(bonus, nan=0.0, posinf=0.0, neginf=0.0)
        return bonus

    ## @brief Reduce per-feature scores to attention-head scores.
    # @details Uses num_heads and head_dim from registry metadata.
    # @param feat torch.Tensor Per-feature salience vector [D].
    # @param meta dict[str, Any] Registry metadata for the module.
    # @param module_name str Module name for error reporting.
    # @return torch.Tensor Head salience vector [num_heads].
    def _reduce_feature_to_heads(self, feat: torch.Tensor, meta: Mapping[str, Any], module_name: str) -> torch.Tensor:
        num_heads = int(meta.get("num_heads", -1))
        head_dim = int(meta.get("head_dim", -1))

        if num_heads <= 0 or head_dim <= 0:
            raise ValueError(
                f"Missing/invalid num_heads/head_dim for attention module '{module_name}': "
                f"num_heads={num_heads}, head_dim={head_dim}"
            )

        d = int(feat.numel())
        if d != num_heads * head_dim:
            raise ValueError(
                f"Feature size mismatch for head reduction in '{module_name}': "
                f"D={d}, num_heads*head_dim={num_heads * head_dim}"
            )

        head_scores = feat.reshape(num_heads, head_dim).sum(dim=1)
        head_scores = self._sanitize_nonnegative(head_scores)
        return head_scores

    ## @brief Compute adapter importance from W_B parameter salience.
    # @details
    # Per paper Section 4.3:
    #   I(H_apt) = sum_{i,j} S(W_B[i,j])
    # where S(W) = |W * dL/dW| for tuning parameters.
    # We implement: sum(|W_B ⊙ grad(W_B)|).
    # @param module APTLinear APT module.
    # @return Optional[float] Importance scalar if grad is available, else None.
    def _compute_adapter_importance_from_WB(self, module: APTLinear) -> Optional[float]:
        if module.lora_B is None:
            return 0.0
        wb = module.lora_B
        if wb.grad is None:
            return None
        with torch.no_grad():
            sal = torch.abs(wb.data) * torch.abs(wb.grad)
            sal = torch.nan_to_num(sal, nan=0.0, posinf=0.0, neginf=0.0)
            total = float(sal.sum().item())
        return total

    ## @brief Collect non-APT parameter salience using |W ⊙ grad(W)|.
    # @details
    # Requirement: For a parameter W_{i,j} not in an APT adapter layer, salience is |W_{i,j} * dL/dW_{i,j}|.
    # We compute a step-level scalar per parameter name for potential debugging/analysis.
    # This does not affect the APT block pruning density logic (which is adapter-based), preserving existing behavior.
    def _collect_non_apt_parameter_salience(self) -> None:
        try:
            model = getattr(self._registry, "model", None)
            if model is None:
                model = getattr(self._registry, "_model", None)
        except Exception:
            model = None

        if model is None or not hasattr(model, "named_parameters"):
            return

        # Build a set of parameter object ids that belong to APT adapters (to exclude).
        apt_param_ids: set[int] = set()
        for _, m in self._registry.named_modules():
            if not isinstance(m, APTLinear):
                continue
            for p in m.parameters(recurse=True):
                apt_param_ids.add(id(p))

        with torch.no_grad():
            for pname, p in model.named_parameters():  # type: ignore[union-attr]
                if not isinstance(p, torch.Tensor):
                    continue
                if id(p) in apt_param_ids:
                    continue
                if p.grad is None:
                    continue
                # Salience: |W ⊙ grad(W)|
                s = torch.abs(p.data) * torch.abs(p.grad)
                s = torch.nan_to_num(s, nan=0.0, posinf=0.0, neginf=0.0)
                self._non_apt_param_salience_step[str(pname)] = float(s.sum().item())

    ## @brief EMA update for tensor values.
    # @details Uses paper-fixed EMA: Sbar^(t) = 0.85*Sbar^(t-1) + 0.15*Shat.
    # @param prev Optional[torch.Tensor] Previous EMA tensor.
    # @param new torch.Tensor Current tensor.
    # @return torch.Tensor Updated EMA tensor.
    def _update_ema_tensor(self, prev: Optional[torch.Tensor], new: torch.Tensor) -> torch.Tensor:
        if prev is None:
            return new.detach().clone()
        if prev.shape != new.shape:
            raise ValueError(f"EMA tensor shape mismatch: prev={tuple(prev.shape)} new={tuple(new.shape)}")
        beta = self._PAPER_EMA_BETA
        return (beta * prev) + ((1.0 - beta) * new)

    ## @brief EMA update for scalar values.
    # @details Uses paper-fixed EMA: Sbar^(t) = 0.85*Sbar^(t-1) + 0.15*Shat.
    # @param prev Optional[float] Previous EMA scalar.
    # @param new float Current scalar.
    # @return float Updated EMA scalar.
    def _update_ema_scalar(self, prev: Optional[float], new: float) -> float:
        if prev is None:
            return float(new)
        beta = self._PAPER_EMA_BETA
        return float(beta * float(prev) + (1.0 - beta) * float(new))

    ## @brief Sanitize tensor by removing NaN/Inf and clamping to nonnegative.
    # @param x torch.Tensor Input tensor.
    # @return torch.Tensor Sanitized tensor (nonnegative, finite).
    def _sanitize_nonnegative(self, x: torch.Tensor) -> torch.Tensor:
        y = torch.nan_to_num(x, nan=0.0, posinf=0.0, neginf=0.0)
        return torch.clamp(y, min=0.0)
