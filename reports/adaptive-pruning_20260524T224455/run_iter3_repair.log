## src/metrics.py
"""Paper-facing metrics utilities for APT reproduction.

This module exists to make metric formulas and correctness tests explicit and
easy to audit for Paper2Code.

It covers:
- Task metrics referenced in the paper's "Tasks" section:
  - GLUE SST-2 / MNLI: accuracy
  - SQuAD v2.0: Exact Match + token-level F1 (we report F1 as the paper does)
  - CNN/DailyMail: ROUGE-1/2/L
- Efficiency helpers referenced in the paper's "Evaluation Metrics" section:
  - normalization to a full fine-tuning (FT) baseline
  - time-to-accuracy extraction from a metric/time series

Design note:
The training/eval pipeline uses `src/eval/metrics.py` at runtime. This module
is a minimal, dependency-light reference implementation used by unit tests and
offline metric verification.

Paper-fidelity notes (ICML'24 APT):
- Time-to-accuracy (TTA): For each method trained on a dataset, the "97% TTA"
  is defined as the first training time at which the method reaches
  97% of the *fine-tuning (FT) baseline* dev/test performance.
- Relative accuracy/performance: reported as the method's metric divided by
  the FT baseline metric (often expressed as a percentage elsewhere).
"""

from __future__ import annotations

import collections
import math
import re
import string
from typing import Any, Dict, List, Mapping, Optional, Sequence

from rouge_score import rouge_scorer
from rouge_score import scoring


def accuracy(predictions: Sequence[int], references: Sequence[int]) -> float:
    """Compute classification accuracy."""
    if len(predictions) != len(references):
        raise ValueError("predictions and references must have the same length.")
    if len(predictions) == 0:
        return 0.0
    correct = sum(int(p == r) for p, r in zip(predictions, references))
    return float(correct) / float(len(predictions))


def rouge_1_2_l(predictions: Sequence[str], references: Sequence[str]) -> Dict[str, float]:
    """Compute ROUGE-1/2/L F1 scores (paper reports ROUGE 1/2/L)."""
    if len(predictions) != len(references):
        raise ValueError("predictions and references must have the same length.")
    if len(predictions) == 0:
        return {"rouge1": 0.0, "rouge2": 0.0, "rougeL": 0.0}

    scorer = rouge_scorer.RougeScorer(["rouge1", "rouge2", "rougeL"], use_stemmer=True)
    aggregator = scoring.BootstrapAggregator()
    for pred, ref in zip(predictions, references):
        aggregator.add_scores(scorer.score(str(ref), str(pred)))

    result = aggregator.aggregate()
    return {
        "rouge1": float(result["rouge1"].mid.fmeasure),
        "rouge2": float(result["rouge2"].mid.fmeasure),
        "rougeL": float(result["rougeL"].mid.fmeasure),
    }


_ARTICLES_RE = re.compile(r"\b(a|an|the)\b", flags=re.UNICODE)
_WHITESPACE_RE = re.compile(r"\s+", flags=re.UNICODE)


def _normalize_answer(text: str) -> str:
    """Official-style SQuAD normalization (lower, remove punctuation/articles/extra space)."""
    text = str(text).lower()
    text = "".join(ch for ch in text if ch not in set(string.punctuation))
    text = _ARTICLES_RE.sub(" ", text)
    text = _WHITESPACE_RE.sub(" ", text).strip()
    return text


def _tokenize(text: str) -> List[str]:
    normalized = _normalize_answer(text)
    if not normalized:
        return []
    return normalized.split()


def _compute_f1(prediction: str, ground_truth: str) -> float:
    pred_toks = _tokenize(prediction)
    gt_toks = _tokenize(ground_truth)
    if len(pred_toks) == 0 and len(gt_toks) == 0:
        return 1.0
    if len(pred_toks) == 0 or len(gt_toks) == 0:
        return 0.0

    common = collections.Counter(pred_toks) & collections.Counter(gt_toks)
    num_same = sum(common.values())
    if num_same == 0:
        return 0.0
    precision = float(num_same) / float(len(pred_toks))
    recall = float(num_same) / float(len(gt_toks))
    return (2.0 * precision * recall) / (precision + recall)


def _compute_exact_match(prediction: str, ground_truth: str) -> float:
    return 1.0 if _normalize_answer(prediction) == _normalize_answer(ground_truth) else 0.0


def squad_v2_em_f1(
    predictions: Sequence[Mapping[str, Any]],
    references: Sequence[Mapping[str, Any]],
) -> Dict[str, float]:
    """Compute SQuAD v2 Exact Match and F1.

    Expected formats (Hugging Face-style):
    - predictions: [{"id": ..., "prediction_text": "..."}]
    - references: [{"id": ..., "answers": {"text": [...], "answer_start": [...]}}]
    """
    pred_by_id: Dict[str, str] = {}
    for item in predictions:
        if "id" not in item:
            raise ValueError("Each prediction must contain an 'id' field.")
        pred_by_id[str(item["id"])] = str(item.get("prediction_text", ""))

    em_scores: List[float] = []
    f1_scores: List[float] = []
    for ref in references:
        if "id" not in ref:
            raise ValueError("Each reference must contain an 'id' field.")
        example_id = str(ref["id"])
        answers = ref.get("answers", {}) or {}
        gt_texts = list(answers.get("text", []) or [])

        pred_text = pred_by_id.get(example_id, "")

        if len(gt_texts) == 0:
            # Unanswerable: exact match only if prediction empty after normalization.
            em_scores.append(_compute_exact_match(pred_text, ""))
            f1_scores.append(_compute_f1(pred_text, ""))
            continue

        em_scores.append(max(_compute_exact_match(pred_text, gt) for gt in gt_texts))
        f1_scores.append(max(_compute_f1(pred_text, gt) for gt in gt_texts))

    if len(em_scores) == 0:
        return {"exact_match": 0.0, "f1": 0.0}

    return {
        "exact_match": float(sum(em_scores) / float(len(em_scores))) * 100.0,
        "f1": float(sum(f1_scores) / float(len(f1_scores))) * 100.0,
    }


def normalize_to_baseline(value: float, baseline_value: float) -> float:
    """Normalize an absolute quantity to a baseline (baseline=1.0)."""
    if not math.isfinite(float(value)) or not math.isfinite(float(baseline_value)):
        raise ValueError("value and baseline_value must be finite.")
    if float(baseline_value) == 0.0:
        raise ValueError("baseline_value must be non-zero.")
    return float(value) / float(baseline_value)


def relative_accuracy(value: float, ft_baseline_value: float) -> float:
    """Relative accuracy/performance vs FT baseline, as used in the paper.

    Paper definition (Sec. 5.5): relative accuracy/performance is the metric
    achieved by a method normalized by the fine-tuning (FT) baseline metric.

    Returns:
        value / ft_baseline_value
    """
    return normalize_to_baseline(value, ft_baseline_value)


def throughput_speedup(throughput: float, baseline_throughput: float) -> float:
    """Compute relative throughput speedup (higher is better)."""
    return normalize_to_baseline(throughput, baseline_throughput)


def time_to_accuracy(
    times_s: Sequence[float],
    metric_values: Sequence[float],
    threshold: float,
) -> Optional[float]:
    """Return first time where metric >= threshold, or None if never reached."""
    if len(times_s) != len(metric_values):
        raise ValueError("times_s and metric_values must have same length.")
    thr = float(threshold)
    for t, m in zip(times_s, metric_values):
        if not math.isfinite(float(t)) or float(t) < 0:
            continue
        if not math.isfinite(float(m)):
            continue
        if float(m) >= thr:
            return float(t)
    return None


def tta_97pct_of_ft(
    times_s: Sequence[float],
    metric_values: Sequence[float],
    ft_baseline_metric: float,
) -> Optional[float]:
    """Compute paper-defined 97% time-to-accuracy (TTA).

    The paper measures training speed by "97% TTA": the time spent reaching 97%
    of the *fine-tuning (FT) baseline* dev/test performance.

    Args:
        times_s: Monotonic (typically) elapsed training times in seconds.
        metric_values: Corresponding dev/test metric values for the method.
        ft_baseline_metric: The FT baseline metric value on the same split/task.

    Returns:
        First time t where metric_values(t) >= 0.97 * ft_baseline_metric, else None.
    """
    if not math.isfinite(float(ft_baseline_metric)):
        raise ValueError("ft_baseline_metric must be finite.")
    # Using 0.97 exactly as specified.
    threshold = 0.97 * float(ft_baseline_metric)
    return time_to_accuracy(times_s=times_s, metric_values=metric_values, threshold=threshold)
