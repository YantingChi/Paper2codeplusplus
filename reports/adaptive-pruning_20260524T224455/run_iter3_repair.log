## src/eval/evaluator.py
from __future__ import annotations

import math
import os
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

import numpy as np
import torch
from torch.utils.data import DataLoader

from src.config import ExperimentConfig
from src.data.dataset_loader import DatasetBundle
from src.eval.lm_eval_adapter import run_lm_eval_harness
from src.eval.metrics import MetricsRegistry
from src.models.apt_injector import APTModelWrapper
from src.utils.logging import get_logger, log_metrics, save_json
from src.utils.profiler import Profiler


## @brief Evaluation result container.
# @details Holds downstream task metrics, inference efficiency metrics, and artifact paths.
@dataclass(frozen=True)
class EvalResult:
    ## @param task_metrics dict[str, float] Task performance metrics (e.g., accuracy/F1/ROUGE).
    ## @param inference_metrics dict[str, float] Inference efficiency metrics (throughput, peak memory).
    ## @param artifact_paths dict[str, str] Paths to serialized artifacts (JSON, raw outputs).
    task_metrics: Dict[str, float]
    inference_metrics: Dict[str, float]
    artifact_paths: Dict[str, str]


## @brief Unified evaluator for APT experiments.
# @details
# Implements paper-aligned evaluation for:
# - GLUE classification (SST-2, MNLI): dev accuracy
# - SQuAD v2.0 extractive QA: dev F1 (and EM where available)
# - CNN/DailyMail summarization (T5): ROUGE-1/2/L on test set (paper requirement)
# - LLaMA: lm-eval-harness on ARC/HellaSwag/MMLU/TruthfulQA
#
# Also benchmarks inference efficiency via Profiler using batch sizes derived from config.yaml
# (already normalized into config.data.eval_batch_size by src/config.py).
class Evaluator:
    ## @brief Initialize evaluator.
    # @param model APTModelWrapper Model wrapper (may wrap any HF model; must be callable and typically supports generate()).
    # @param datasets DatasetBundle Tokenized datasets and tokenizer/collator.
    # @param config ExperimentConfig Experiment configuration.
    # @param profiler Profiler Efficiency profiler.
    def __init__(
        self,
        model: APTModelWrapper,
        datasets: DatasetBundle,
        config: ExperimentConfig,
        profiler: Profiler,
    ) -> None:
        self._logger = get_logger(self.__class__.__name__, level=str(config.runtime.log_level))

        if not isinstance(model, APTModelWrapper):
            raise TypeError(f"model must be APTModelWrapper, got {type(model)}")
        if not isinstance(datasets, DatasetBundle):
            raise TypeError(f"datasets must be DatasetBundle, got {type(datasets)}")
        if not isinstance(config, ExperimentConfig):
            raise TypeError(f"config must be ExperimentConfig, got {type(config)}")
        if not isinstance(profiler, Profiler):
            raise TypeError(f"profiler must be Profiler, got {type(profiler)}")

        self.model: APTModelWrapper = model
        self.datasets: DatasetBundle = datasets
        self.config: ExperimentConfig = config
        self.profiler: Profiler = profiler

        self._device: torch.device = torch.device(str(self.config.runtime.device))
        self.model.to(self._device)

        self._metrics = MetricsRegistry(task_type=str(self.config.model.task_type))

        # Output directory for artifacts.
        self._out_dir: Path = Path(str(self.config.runtime.output_dir)).expanduser().resolve()
        self._out_dir.mkdir(parents=True, exist_ok=True)

    ## @brief Evaluate the configured task and optionally benchmark inference.
    # @details
    # Routing strictly follows config.model.task_type:
    # - sequence_classification -> evaluate_glue()
    # - question_answering -> evaluate_qa()
    # - seq2seq -> evaluate_seq2seq()
    # - causal_lm -> evaluate_lm_harness()
    # Metrics are saved under runtime.output_dir.
    # @return EvalResult Evaluation result.
    def evaluate(self) -> EvalResult:
        self.model.eval()

        task_type = str(self.config.model.task_type).strip()
        if task_type == "sequence_classification":
            task_metrics = self.evaluate_glue()
        elif task_type == "question_answering":
            task_metrics = self.evaluate_qa()
        elif task_type == "seq2seq":
            task_metrics = self.evaluate_seq2seq()
        elif task_type == "causal_lm":
            task_metrics = self.evaluate_lm_harness()
        else:
            raise ValueError(f"Unsupported model.task_type='{task_type}'")

        inference_metrics: Dict[str, float] = {}
        if bool(self.config.evaluation.measure_throughput) or bool(
            self.config.evaluation.measure_inference_peak_memory
        ):
            inference_metrics = self.benchmark_inference()

        artifact_paths: Dict[str, str] = {}
        task_path = save_json(self._out_dir / "eval_task_metrics.json", task_metrics)
        inf_path = save_json(self._out_dir / "eval_inference_metrics.json", inference_metrics)
        combined_path = save_json(
            self._out_dir / "eval_result.json",
            {"task_metrics": task_metrics, "inference_metrics": inference_metrics},
        )
        artifact_paths["task_metrics"] = task_path
        artifact_paths["inference_metrics"] = inf_path
        artifact_paths["eval_result"] = combined_path

        log_metrics(task_metrics, step=0, split="eval/task", logger=self._logger)
        if inference_metrics:
            log_metrics(inference_metrics, step=0, split="eval/inference", logger=self._logger)

        return EvalResult(
            task_metrics={str(k): float(v) for k, v in task_metrics.items()},
            inference_metrics={str(k): float(v) for k, v in inference_metrics.items()},
            artifact_paths={str(k): str(v) for k, v in artifact_paths.items()},
        )

    ## @brief Evaluate GLUE-style sequence classification tasks (SST-2/MNLI).
    # @details Computes dev accuracy as specified by the paper for GLUE tasks.
    # Uses the processed eval_dataset from DatasetBundle.
    # @return dict[str, float] Metrics dict (includes "accuracy").
    def evaluate_glue(self) -> Dict[str, float]:
        if self.datasets.eval_dataset is None:
            raise ValueError("datasets.eval_dataset is required for GLUE evaluation but is None.")

        dl = self._build_eval_dataloader()

        all_preds: List[int] = []
        all_labels: List[int] = []

        with torch.no_grad():
            for batch in dl:
                batch_on_device = self._move_batch_to_device(batch)
                outputs = self.model(**batch_on_device)

                logits = getattr(outputs, "logits", None)
                labels = batch_on_device.get("labels", None)
                if logits is None or (not torch.is_tensor(logits)):
                    raise ValueError("Classification evaluation requires model outputs.logits to be a torch.Tensor.")
                if labels is None or (not torch.is_tensor(labels)):
                    raise ValueError("Classification evaluation requires batch['labels'] to be a torch.Tensor.")

                preds = torch.argmax(logits, dim=-1)
                all_preds.extend(preds.detach().cpu().tolist())
                all_labels.extend(labels.detach().cpu().tolist())

        # Use MetricsRegistry GLUE backend when dataset is GLUE; otherwise generic accuracy.
        dataset_name = str(self.config.data.dataset_name).lower().strip()
        dataset_config = str(self.config.data.dataset_config_name).lower().strip()

        if dataset_name == "glue" and dataset_config:
            metrics = self._metrics.compute_glue(
                task_name=dataset_config,
                predictions=np.asarray(all_preds, dtype=np.int64),
                references=np.asarray(all_labels, dtype=np.int64),
            )
        else:
            metrics = self._metrics.compute(
                predictions=np.asarray(all_preds, dtype=np.int64),
                references=np.asarray(all_labels, dtype=np.int64),
            )

        # Enforce paper-required metric presence for GLUE SST-2/MNLI.
        if "accuracy" not in metrics:
            # Compute accuracy deterministically.
            correct = sum(int(p == y) for p, y in zip(all_preds, all_labels))
            metrics["accuracy"] = float(correct) / float(max(1, len(all_labels)))

        # Filter to configured metrics if provided, but always keep accuracy for GLUE.
        filtered = self._filter_metrics(metrics=metrics, required_keys=["accuracy"])
        return filtered

    ## @brief Evaluate extractive QA on SQuAD v2.0.
    # @details
    # Computes dev F1 (and exact match) using the official `evaluate` squad_v2 metric via MetricsRegistry.
    # Implements standard post-processing from start/end logits with offset mappings.
    #
    # Required eval_dataset fields (produced by TaskPreprocessor.preprocess_qa):
    # - input_ids, attention_mask
    # - example_id: str
    # - offset_mapping: list[Optional[Tuple[int,int]]] with None for non-context tokens
    #
    # Also requires access to the original raw eval set to get contexts and references. This reproduction
    # rebuilds references by loading the raw dataset split specified in config, keyed by example id.
    # @return dict[str, float] Metrics dict including "f1" (and "exact_match").
    def evaluate_qa(self) -> Dict[str, float]:
        if self.datasets.eval_dataset is None:
            raise ValueError("datasets.eval_dataset is required for QA evaluation but is None.")

        tokenizer = self.datasets.tokenizer
        if tokenizer is None:
            raise ValueError("datasets.tokenizer is required for QA evaluation but is None.")

        # Ensure required columns exist in the processed eval dataset.
        required_cols = {"example_id", "offset_mapping"}
        for c in required_cols:
            if c not in self.datasets.eval_dataset.column_names:
                raise ValueError(
                    f"QA eval_dataset missing required column '{c}'. "
                    "Ensure preprocessing preserved example_id and offset_mapping."
                )

        # Load raw validation data to get contexts and gold answers.
        raw_id_to_ctx, raw_id_to_answers = self._load_squad_v2_raw_validation_index()

        dl = self._build_eval_dataloader()

        # Collect per-feature predictions.
        feature_records: List[Dict[str, Any]] = []
        with torch.no_grad():
            for batch in dl:
                batch_on_device = self._move_batch_to_device(batch)
                outputs = self.model(**batch_on_device)

                start_logits = getattr(outputs, "start_logits", None)
                end_logits = getattr(outputs, "end_logits", None)
                if start_logits is None or end_logits is None:
                    raise ValueError("QA evaluation requires outputs.start_logits and outputs.end_logits.")
                if not torch.is_tensor(start_logits) or not torch.is_tensor(end_logits):
                    raise TypeError("QA logits must be torch.Tensors.")

                # Move logits to CPU for post-processing.
                start_logits_cpu = start_logits.detach().cpu()
                end_logits_cpu = end_logits.detach().cpu()

                # Need example ids and offset mappings from the *unmoved* batch (collator keeps them as python objects).
                example_ids = batch.get("example_id", None)
                offsets = batch.get("offset_mapping", None)
                input_ids = batch.get("input_ids", None)

                if example_ids is None or offsets is None or input_ids is None:
                    raise ValueError("QA batch must include example_id, offset_mapping, and input_ids.")
                if not isinstance(example_ids, list):
                    raise TypeError(f"QA batch['example_id'] must be a list, got {type(example_ids)}")
                if not isinstance(offsets, list):
                    raise TypeError(f"QA batch['offset_mapping'] must be a list, got {type(offsets)}")
                if not torch.is_tensor(input_ids):
                    raise TypeError("QA batch['input_ids'] must be torch.Tensor.")

                # Record per-feature.
                bs = int(start_logits_cpu.shape[0])
                for i in range(bs):
                    ex_id = str(example_ids[i])
                    off_i = offsets[i]
                    if not isinstance(off_i, list):
                        raise TypeError("Each offset_mapping entry must be a list.")

                    feature_records.append(
                        {
                            "id": ex_id,
                            "start_logits": start_logits_cpu[i].to(dtype=torch.float32).numpy(),
                            "end_logits": end_logits_cpu[i].to(dtype=torch.float32).numpy(),
                            "offset_mapping": off_i,
                            "input_ids": input_ids[i].detach().cpu().tolist(),
                        }
                    )

        predictions = self._postprocess_qa_predictions(
            feature_records=feature_records,
            id_to_context=raw_id_to_ctx,
        )
        references = self._build_qa_references(id_to_answers=raw_id_to_answers)

        metrics = self._metrics.compute_qa(predictions=predictions, references=references)

        # Paper reports dev F1; ensure it exists.
        if "f1" not in metrics:
            raise RuntimeError("SQuAD v2 metric computation did not return 'f1' as required by the paper.")

        filtered = self._filter_metrics(metrics=metrics, required_keys=["f1"])
        return filtered

    ## @brief Evaluate seq2seq generation tasks (CNN/DM ROUGE, and optionally GLUE-as-generation for T5).
    # @details
    # - For CNN/DailyMail: computes ROUGE-1/2/L on the test set (paper requirement).
    # - For GLUE-as-generation: computes accuracy by comparing decoded generated label strings to decoded targets.
    # Generation uses model.model.generate(...) on the underlying HF model.
    # @return dict[str, float] Metrics dict (ROUGE or accuracy).
    def evaluate_seq2seq(self) -> Dict[str, float]:
        if self.datasets.eval_dataset is None:
            raise ValueError("datasets.eval_dataset is required for seq2seq evaluation but is None.")
        if self.datasets.tokenizer is None:
            raise ValueError("datasets.tokenizer is required for seq2seq evaluation but is None.")

        dataset_name = str(self.config.data.dataset_name).lower().strip()
        dataset_config = str(self.config.data.dataset_config_name).lower().strip()

        # Paper requirement: for CNN/DM, report ROUGE-1/2/L on the test set.
        # The training pipeline typically wires eval_dataset to validation_split; so for CNN/DM we must
        # explicitly load the processed test split (and run evaluation on it) when available.
        dl = self._build_eval_dataloader()
        if dataset_name in {"cnn_dailymail", "cnndm"}:
            dl = self._build_cnn_dm_test_dataloader_fallbacking_to_eval()

        base_model = getattr(self.model, "model", None)
        if base_model is None or not hasattr(base_model, "generate"):
            raise ValueError("Seq2seq evaluation requires the underlying model to support .generate().")

        tokenizer = self.datasets.tokenizer

        preds_text: List[str] = []
        refs_text: List[str] = []

        # Deterministic generation settings: paper does not specify decoding params.
        # We use greedy decoding (num_beams=1, do_sample=False) for determinism.
        gen_kwargs: Dict[str, Any] = {
            "max_new_tokens": int(self.config.data.max_target_length),
            "num_beams": 1,
            "do_sample": False,
        }

        with torch.no_grad():
            for batch in dl:
                batch_on_device = self._move_batch_to_device(batch)
                input_ids = batch_on_device.get("input_ids", None)
                attention_mask = batch_on_device.get("attention_mask", None)
                labels = batch.get("labels", None)  # keep labels on CPU for decoding (may include -100)
                if input_ids is None or not torch.is_tensor(input_ids):
                    raise ValueError("Seq2seq batch must include input_ids tensor.")
                if attention_mask is not None and not torch.is_tensor(attention_mask):
                    attention_mask = None

                generated = base_model.generate(
                    input_ids=input_ids,
                    attention_mask=attention_mask,
                    **gen_kwargs,
                )

                # Decode predictions.
                pred_strs = tokenizer.batch_decode(generated, skip_special_tokens=True)
                preds_text.extend([s.strip() for s in pred_strs])

                # Decode references from labels when available; for HF seq2seq collator labels are padded with -100.
                if labels is None:
                    raise ValueError(
                        "Seq2seq evaluation requires labels to compute ROUGE/accuracy, but batch has no 'labels'."
                    )
                if torch.is_tensor(labels):
                    labels_cpu = labels.detach().cpu().numpy()
                elif isinstance(labels, list):
                    labels_cpu = np.asarray(labels, dtype=np.int64)
                else:
                    raise TypeError(f"Unsupported labels type in seq2seq batch: {type(labels)}")

                labels_cpu = np.asarray(labels_cpu, dtype=np.int64)
                # Replace -100 with pad_token_id for decoding.
                pad_id = getattr(tokenizer, "pad_token_id", None)
                if pad_id is None:
                    # Most seq2seq tokenizers have pad_token_id; if not, fall back to eos_token_id.
                    pad_id = getattr(tokenizer, "eos_token_id", None)
                if pad_id is None:
                    raise ValueError("Tokenizer must define pad_token_id or eos_token_id for decoding labels.")

                labels_cpu = np.where(labels_cpu == -100, int(pad_id), labels_cpu)
                ref_strs = tokenizer.batch_decode(labels_cpu, skip_special_tokens=True)
                refs_text.extend([s.strip() for s in ref_strs])

        if len(preds_text) != len(refs_text):
            raise ValueError(
                f"Seq2seq predictions/references length mismatch: {len(preds_text)} vs {len(refs_text)}"
            )

        # CNN/DM summarization: ROUGE on test set.
        if dataset_name in {"cnn_dailymail", "cnndm"}:
            metrics = self._metrics.compute_rouge(predictions=preds_text, references=refs_text)
            # Ensure paper-required keys exist (rouge1/rouge2/rougeL).
            for k in ("rouge1", "rouge2", "rougeL"):
                if k not in metrics:
                    metrics[k] = 0.0
            filtered = self._filter_metrics(metrics=metrics, required_keys=["rouge1", "rouge2", "rougeL"])
            return filtered

        # GLUE-as-generation for T5: accuracy over strings. The targets were verbalized in preprocessing.
        if dataset_name == "glue" and dataset_config in {"sst2", "mnli"}:
            metrics = {"accuracy": float(self._compute_text_accuracy(preds_text=preds_text, refs_text=refs_text))}
            filtered = self._filter_metrics(metrics=metrics, required_keys=["accuracy"])
            return filtered

        # Generic seq2seq default: if config asks for ROUGE keys, compute ROUGE; else return exact-match accuracy.
        requested = set(str(m) for m in self.config.evaluation.metrics)
        if any(k in requested for k in {"rouge1", "rouge2", "rougeL"}):
            metrics = self._metrics.compute_rouge(predictions=preds_text, references=refs_text)
            filtered = self._filter_metrics(metrics=metrics, required_keys=list(requested))
            return filtered

        metrics = {"accuracy": float(self._compute_text_accuracy(preds_text=preds_text, refs_text=refs_text))}
        return self._filter_metrics(metrics=metrics, required_keys=["accuracy"])

    ## @brief Evaluate LLaMA models using lm-eval-harness.
    # @details Delegates to src/eval/lm_eval_adapter.py with config-provided tasks and few-shot numbers.
    # Returns task scores and "avg" score over the configured tasks (paper: average over 4 tasks).
    # @return dict[str, float] lm-eval metrics.
    def evaluate_lm_harness(self) -> Dict[str, float]:
        if str(self.config.model.task_type) != "causal_lm":
            raise ValueError("evaluate_lm_harness called for non-causal_lm task_type.")

        base_model = getattr(self.model, "model", None)
        if base_model is None:
            raise ValueError("APTModelWrapper must expose underlying model as .model for lm-eval.")
        tokenizer = self.datasets.tokenizer
        if tokenizer is None:
            raise ValueError("Tokenizer is required for lm-eval-harness evaluation but datasets.tokenizer is None.")

        raw_dir = self._out_dir / "lm_eval"
        raw_dir.mkdir(parents=True, exist_ok=True)

        metrics = run_lm_eval_harness(
            model=base_model,
            tokenizer=tokenizer,
            config=self.config,
            model_path=None,
            tokenizer_path=None,
            limit=None,
            output_dir=str(raw_dir),
        )

        # Ensure avg exists as paper reports average score.
        if "avg" not in metrics:
            # Compute average over the configured tasks (normalized keys returned by adapter).
            keys = [k for k in ("arc", "hellaswag", "mmlu", "truthfulqa") if k in metrics]
            if not keys:
                raise RuntimeError("lm-eval adapter did not return any known task keys to compute avg.")
            metrics["avg"] = float(sum(float(metrics[k]) for k in keys) / float(len(keys)))

        filtered = self._filter_metrics(metrics=metrics, required_keys=["avg"])
        return filtered

    ## @brief Benchmark inference throughput and peak memory.
    # @details Uses Profiler.benchmark_inference with eval dataloader and config-normalized eval batch size.
    # The paper uses throughput-based inference speed and peak memory. We report:
    # - throughput (samples/sec)
    # - latency_per_batch
    # - elapsed_time_s
    # - peak_memory_mb
    # Additional counters are included from Profiler output.
    # @return dict[str, float] Inference benchmark metrics.
    def benchmark_inference(self) -> Dict[str, float]:
        # Prefer eval dataset if available; otherwise fall back to train dataset (for causal LM scenarios).
        if self.datasets.eval_dataset is None and self.datasets.train_dataset is None:
            raise ValueError("No dataset available for inference benchmarking (both eval_dataset and train_dataset are None).")

        ds = self.datasets.eval_dataset if self.datasets.eval_dataset is not None else self.datasets.train_dataset
        assert ds is not None

        # Build a dataloader specifically for benchmarking with the paper batch size already normalized in config.
        dl = DataLoader(
            ds,
            batch_size=int(self.config.data.eval_batch_size),
            shuffle=False,
            num_workers=int(self.config.runtime.num_workers),
            pin_memory=bool(self.config.runtime.pin_memory),
            collate_fn=self.datasets.data_collator,
            drop_last=False,
        )

        # Ensure eval mode and no gradients.
        self.model.eval()
        base_model = getattr(self.model, "model", None)
        model_for_bench = base_model if base_model is not None else self.model

        # Profiler uses warmup_steps=10 and measure_steps=50 by default, matching design.
        bench = self.profiler.benchmark_inference(
            model=model_for_bench,
            dataloader=dl,
            warmup_steps=10,
            measure_steps=50,
        )

        # Normalize keys to paper language without changing profiler meanings.
        # Paper reports "Inf. Mem." (peak) and "Inf. Speed" (throughput-based). We return absolute values.
        out: Dict[str, float] = {
            "throughput": float(bench.get("throughput", 0.0)),
            "latency_per_batch": float(bench.get("latency_per_batch", 0.0)),
            "elapsed_time_s": float(bench.get("elapsed_time_s", 0.0)),
            "peak_memory_mb": float(bench.get("peak_memory_mb", 0.0)),
            "num_measured_batches": float(bench.get("num_measured_batches", 0.0)),
            "num_samples": float(bench.get("num_samples", 0.0)),
        }

        # Persist benchmark results.
        save_json(self._out_dir / "inference_benchmark_raw.json", bench)
        return out

    ## @brief Build evaluation dataloader with config-normalized eval batch size.
    # @param None
    # @return DataLoader Evaluation dataloader.
    def _build_eval_dataloader(self) -> DataLoader:
        if self.datasets.eval_dataset is None:
            raise ValueError("datasets.eval_dataset is None.")

        return DataLoader(
            self.datasets.eval_dataset,
            batch_size=int(self.config.data.eval_batch_size),
            shuffle=False,
            num_workers=int(self.config.runtime.num_workers),
            pin_memory=bool(self.config.runtime.pin_memory),
            collate_fn=self.datasets.data_collator,
            drop_last=False,
        )

    ## @brief Build CNN/DM test dataloader (paper requires reporting ROUGE on test).
    # @details
    # The repository pipeline often populates datasets.eval_dataset from config.data.validation_split.
    # For CNN/DM, we explicitly load the raw dataset test split, apply the *same preprocessing*
    # function used to create datasets.eval_dataset (if available), and build a dataloader from it.
    #
    # If loading or preprocessing fails, we fall back to the already-provided eval_dataset to keep
    # the rest of the pipeline functional, but we log a warning.
    def _build_cnn_dm_test_dataloader_fallbacking_to_eval(self) -> DataLoader:
        if self.datasets.eval_dataset is None:
            raise ValueError("datasets.eval_dataset is required for CNN/DM evaluation but is None.")
        if self.datasets.data_collator is None:
            raise ValueError("datasets.data_collator is required for CNN/DM evaluation but is None.")

        # Attempt to load processed test split by reusing the eval preprocessing when possible.
        try:
            from datasets import load_dataset  # type: ignore
        except Exception as e:
            self._logger.warning(
                "Could not import datasets.load_dataset to load CNN/DM test split; "
                "falling back to provided eval_dataset. Error: %s",
                repr(e),
            )
            return self._build_eval_dataloader()

        dataset_name = str(self.config.data.dataset_name).strip()
        dataset_config = str(self.config.data.dataset_config_name).strip()

        # CNN/DM HF dataset commonly has multiple versions; allow config override via dataset_config_name.
        try:
            raw = load_dataset(dataset_name, dataset_config) if dataset_config else load_dataset(dataset_name)
        except Exception as e:
            self._logger.warning(
                "Failed to load raw dataset for CNN/DM test evaluation; falling back to eval_dataset. Error: %s",
                repr(e),
            )
            return self._build_eval_dataloader()

        # Determine test split name. Prefer literal "test". If absent, try common alternatives.
        split_candidates = ["test", "validation", "val"]
        test_split: Optional[str] = None
        for s in split_candidates:
            if s in raw:
                if s == "test":
                    test_split = s
                    break
                if test_split is None:
                    test_split = s
        if test_split is None:
            self._logger.warning(
                "Raw dataset has no test/validation splits; falling back to eval_dataset. Available splits: %s",
                list(raw.keys()),
            )
            return self._build_eval_dataloader()

        raw_test = raw[test_split]

        # Try to reuse the preprocessing pipeline used for eval_dataset by pulling its transform/map function.
        # If eval_dataset is an HF Dataset, it may have a ._format_type/.format, but map fn isn't stored.
        # So we instead attempt a robust strategy:
        # - If raw_test already contains model-ready columns (input_ids/labels), use it directly.
        # - Else, fall back to eval_dataset.
        needed_cols = {"input_ids", "labels"}
        if hasattr(raw_test, "column_names") and needed_cols.issubset(set(raw_test.column_names)):
            processed_test = raw_test
        else:
            # We cannot reliably re-run the project's TaskPreprocessor here without importing internal
            # loader utilities (which would change interfaces). Fall back with a clear warning.
            self._logger.warning(
                "CNN/DM test split loaded but is not tokenized (missing %s). "
                "Falling back to provided eval_dataset. To evaluate on test set as in the paper, "
                "ensure DatasetLoader provides tokenized test set or that the raw test split is tokenized.",
                sorted(list(needed_cols)),
            )
            return self._build_eval_dataloader()

        # Build dataloader from processed test set.
        return DataLoader(
            processed_test,
            batch_size=int(self.config.data.eval_batch_size),
            shuffle=False,
            num_workers=int(self.config.runtime.num_workers),
            pin_memory=bool(self.config.runtime.pin_memory),
            collate_fn=self.datasets.data_collator,
            drop_last=False,
        )

    ## @brief Move tensor fields of a batch to the evaluator device.
    # @param batch dict Batch mapping from collator.
    # @return dict Batch with tensors moved to device.
    def _move_batch_to_device(self, batch: Dict[str, Any]) -> Dict[str, Any]:
        out: Dict[str, Any] = {}
        for k, v in batch.items():
            if torch.is_tensor(v):
                out[str(k)] = v.to(self._device, non_blocking=True)
            else:
                out[str(k)] = v
        return out

    ## @brief Filter metrics based on config.evaluation.metrics while preserving required keys.
    # @details
    # Keeps:
    # - all keys in required_keys (if present)
    # - all keys explicitly requested by config.evaluation.metrics (if present)
    # If config.evaluation.metrics is empty, returns metrics unchanged.
    # @param metrics dict[str, float] Computed metrics.
    # @param required_keys list[str] Keys that must be preserved (if present).
    # @return dict[str, float] Filtered metrics.
    def _filter_metrics(self, metrics: Dict[str, float], required_keys: List[str]) -> Dict[str, float]:
        requested = [str(m) for m in (self.config.evaluation.metrics or [])]
        if not requested:
            # Still ensure floats and deterministic keys.
            return {str(k): float(v) for k, v in sorted(metrics.items(), key=lambda kv: kv[0])}

        keep = set(requested) | set(str(k) for k in required_keys)
        out: Dict[str, float] = {}
        for k, v in metrics.items():
            if str(k) in keep:
                out[str(k)] = float(v)
        # Ensure required keys exist if they were present in original metrics.
        for k in required_keys:
            if k in metrics and k not in out:
                out[str(k)] = float(metrics[k])
        return {str(k): float(v) for k, v in sorted(out.items(), key=lambda kv: kv[0])}

    ## @brief Compute text exact-match accuracy for seq2seq classification-style tasks.
    # @details Normalizes whitespace and lowercases for robustness while preserving deterministic behavior.
    # @param preds_text list[str] Predicted decoded strings.
    # @param refs_text list[str] Reference decoded strings.
    # @return float Accuracy in [0,1].
    def _compute_text_accuracy(self, preds_text: List[str], refs_text: List[str]) -> float:
        if len(preds_text) != len(refs_text):
            raise ValueError("Preds and refs length mismatch for text accuracy.")

        def _norm(s: str) -> str:
            return " ".join(str(s).strip().lower().split())

        correct = 0
        n = len(preds_text)
        for p, r in zip(preds_text, refs_text):
            if _norm(p) == _norm(r):
                correct += 1
        return float(correct) / float(max(1, n))

    ## @brief Load raw SQuAD v2 validation split and build indices by example id.
    # @details
    # Returns two dicts:
    # - id_to_context[id] -> context str
    # - id_to_answers[id] -> answers dict in SQuAD format {'text':[...],'answer_start':[...]}
    #
    # Uses the dataset specified by config.data.dataset_name/config and config.data.validation_split.
    # @return tuple[dict[str, str], dict[str, dict[str, list]]] context and answers indices.
    def _load_squad_v2_raw_validation_index(self) -> Tuple[Dict[str, str], Dict[str, Dict[str, Any]]]:
        dataset_name = str(self.config.data.dataset_name).strip()
        dataset_config = str(self.config.data.dataset_config_name).strip()
        validation_split = str(self.config.data.validation_split).strip()

        # Import datasets lazily to keep module import graph light.
        try:
            from datasets import load_dataset  # type: ignore
        except Exception as e:
            raise ImportError("Failed to import datasets.load_dataset required for SQuAD v2 evaluation.") from e

        if not dataset_name:
            raise ValueError("data.dataset_name is empty; cannot load raw SQuAD v2 dataset.")
        # Common naming: "squad_v2" dataset has no config name; allow both dataset_name="squad_v2" and dataset_name="squad".
        if dataset_config:
            raw = load_dataset(dataset_name, dataset_config)
        else:
            raw = load_dataset(dataset_name)

        if validation_split not in raw:
            raise ValueError(
                f"Raw dataset does not contain split '{validation_split}'. Available splits: {list(raw.keys())}"
            )

        ds = raw[validation_split]
        id_to_context: Dict[str, str] = {}
        id_to_answers: Dict[str, Dict[str, Any]] = {}

        for ex in ds:
            ex_id = str(ex.get("id", ""))
            if not ex_id:
                continue
            ctx = str(ex.get("context", ""))
            ans = ex.get("answers", {"text": [], "answer_start": []})
            if not isinstance(ans, dict):
                ans = {"text": [], "answer_start": []}
            # Ensure lists exist.
            ans_text = ans.get("text", [])
            ans_start = ans.get("answer_start", [])
            if not isinstance(ans_text, list):
                ans_text = []
            if not isinstance(ans_start, list):
                ans_start = []
            id_to_context[ex_id] = ctx
            id_to_answers[ex_id] = {"text": list(ans_text), "answer_start": list(ans_start)}

        if not id_to_context or not id_to_answers:
            raise RuntimeError("Failed to build raw SQuAD v2 indices; dataset may be empty or malformed.")

        return id_to_context, id_to_answers

    ## @brief Build SQuAD v2 references list for metric computation.
    # @param id_to_answers dict[str, dict[str, Any]] Mapping example id -> answers dict.
    # @return list[dict[str, Any]] References list in SQuAD v2 format.
    def _build_qa_references(self, id_to_answers: Dict[str, Dict[str, Any]]) -> List[Dict[str, Any]]:
        refs: List[Dict[str, Any]] = []
        for ex_id, ans in id_to_answers.items():
            refs.append({"id": str(ex_id), "answers": ans})
        return refs

    ## @brief Post-process QA feature logits into per-example text predictions.
    # @details
    # Implements standard SQuAD extraction:
    # - For each feature, consider top candidate spans from start/end logits
    # - Map token spans to character spans using offset_mapping
    # - Choose the best scoring candidate per example across features
    #
    # For SQuAD v2 no-answer:
    # - This project uses "no_answer_probability" default 0.0 in predictions, and always predicts a span.
    # The paper reports dev F1 on SQuAD v2; evaluate's squad_v2 metric uses no_answer_probability to
    # resolve thresholds, but accepts 0.0 as a valid field.
    #
    # @param feature_records list[dict] Per-feature records: id, start_logits, end_logits, offset_mapping, input_ids.
    # @param id_to_context dict[str, str] Example id -> context string.
    # @param n_best_size int Number of best start/end indices to consider (default 20; deterministic standard).
    # @param max_answer_length int Max answer length in tokens (default 30; deterministic standard).
    # @return list[dict[str, Any]] Predictions list in SQuAD v2 format.
    def _postprocess_qa_predictions(
        self,
        feature_records: List[Dict[str, Any]],
        id_to_context: Dict[str, str],
        n_best_size: int = 20,
        max_answer_length: int = 30,
    ) -> List[Dict[str, Any]]:
        n_best = int(n_best_size)
        max_len = int(max_answer_length)
        if n_best <= 0:
            raise ValueError("n_best_size must be > 0.")
        if max_len <= 0:
            raise ValueError("max_answer_length must be > 0.")

        # Aggregate best span per example across features.
        best_by_id: Dict[str, Tuple[float, str]] = {}

        for rec in feature_records:
            ex_id = str(rec["id"])
            if ex_id not in id_to_context:
                # If raw context missing, skip; but this indicates dataset mismatch.
                continue
            context = id_to_context[ex_id]

            start_logits = np.asarray(rec["start_logits"], dtype=np.float32)
            end_logits = np.asarray(rec["end_logits"], dtype=np.float32)
            offsets = rec["offset_mapping"]
            if not isinstance(offsets, list):
                raise TypeError("offset_mapping must be a list.")

            # Get top indices.
            start_idx_sorted = np.argsort(-start_logits)[:n_best].tolist()
            end_idx_sorted = np.argsort(-end_logits)[:n_best].tolist()

            best_score = -1e30
            best_text = ""

            for si in start_idx_sorted:
                for ei in end_idx_sorted:
                    if ei < si:
                        continue
                    length = ei - si + 1
                    if length > max_len:
                        continue

                    # offsets are None for non-context tokens; ensure both ends valid.
                    off_s = offsets[si] if 0 <= si < len(offsets) else None
                    off_e = offsets[ei] if 0 <= ei < len(offsets) else None
                    if off_s is None or off_e is None:
                        continue
                    if not (isinstance(off_s, tuple) and isinstance(off_e, tuple)):
                        continue
                    s_char = int(off_s[0])
                    e_char = int(off_e[1])
                    if e_char < s_char or s_char < 0 or e_char < 0:
                        continue
                    if s_char > len(context) or e_char > len(context):
                        continue

                    score = float(start_logits[si] + end_logits[ei])
                    if score > best_score:
                        best_score = score
                        best_text = context[s_char:e_char]

            # Update global best for this example id.
            prev = best_by_id.get(ex_id, None)
            if prev is None or float(best_score) > float(prev[0]):
                best_by_id[ex_id] = (float(best_score), str(best_text))

        # Build predictions list with deterministic ordering by example id.
        preds: List[Dict[str, Any]] = []
        for ex_id in sorted(id_to_context.keys()):
            text = best_by_id.get(ex_id, (-1e30, ""))[1]
            preds.append({"id": str(ex_id), "prediction_text": str(text), "no_answer_probability": 0.0})
        return preds
