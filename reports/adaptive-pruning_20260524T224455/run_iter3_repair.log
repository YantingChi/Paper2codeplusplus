## src/data/dataset_loader.py
from __future__ import annotations

from dataclasses import dataclass
from typing import Any, List, Optional

from datasets import Dataset, DatasetDict, load_dataset
from transformers import AutoTokenizer

from src.config import DataConfig, ModelConfig
from src.data.collators import build_data_collator
from src.data.preprocessors import TaskPreprocessor


## @brief Bundle of tokenized datasets and associated utilities.
# @details
# This container follows the design contract and is returned by DatasetLoader.load().
# - train_dataset: tokenized training Dataset or None
# - eval_dataset: tokenized validation/dev Dataset or None
# - test_dataset: tokenized test Dataset or None
# - tokenizer: Hugging Face tokenizer
# - data_collator: task-appropriate collator
# - label_names: classification label names if available, else empty
@dataclass(frozen=True)
class DatasetBundle:
    ## @param train_dataset Any Training dataset (tokenized).
    ## @param eval_dataset Any Evaluation dataset (tokenized).
    ## @param test_dataset Any Test dataset (tokenized).
    ## @param tokenizer Any Tokenizer.
    ## @param data_collator Any Data collator.
    ## @param label_names list[str] Label names for classification tasks.
    train_dataset: Any
    eval_dataset: Any
    test_dataset: Any
    tokenizer: Any
    data_collator: Any
    label_names: List[str]


## @brief Dataset loader that prepares tokenized datasets and collators for experiments.
# @details
# Loads datasets with `datasets.load_dataset`, applies task-appropriate preprocessing via
# TaskPreprocessor, and returns a DatasetBundle.
class DatasetLoader:
    ## @brief Initialize DatasetLoader.
    # @param config DataConfig Dataset configuration.
    # @param model_config ModelConfig Model configuration.
    def __init__(self, config: DataConfig, model_config: ModelConfig) -> None:
        self._cfg: DataConfig = config
        self._model_cfg: ModelConfig = model_config

    ## @brief Build the tokenizer for the configured backbone.
    # @details
    # Uses AutoTokenizer.from_pretrained with trust_remote_code as configured.
    # For decoder-only causal LM backbones (e.g., LLaMA), if pad_token is missing,
    # sets pad_token to eos_token (standard practice required for batching).
    # @return Any Hugging Face tokenizer instance.
    def build_tokenizer(self) -> Any:
        tokenizer = AutoTokenizer.from_pretrained(
            self._model_cfg.backbone_name,
            use_fast=True,
            trust_remote_code=bool(self._model_cfg.trust_remote_code),
        )

        # Ensure pad_token exists for causal LM batching (paper uses batched inference/training).
        if str(self._model_cfg.task_type) == "causal_lm":
            if getattr(tokenizer, "pad_token", None) is None:
                eos_token = getattr(tokenizer, "eos_token", None)
                if eos_token is None:
                    raise ValueError(
                        "Tokenizer has no pad_token and no eos_token; cannot set pad token for causal LM."
                    )
                tokenizer.pad_token = eos_token

        return tokenizer

    ## @brief Load and preprocess datasets.
    # @details
    # 1) Loads raw dataset (DatasetDict) via datasets.load_dataset using DataConfig.dataset_name/config_name.
    # 2) Selects train/validation splits by DataConfig.train_split/validation_split.
    # 3) Applies TaskPreprocessor method based on ModelConfig.task_type.
    # 4) Builds a task-appropriate collator and returns DatasetBundle.
    #
    # For QA (SQuAD v2), preprocessing returns overflow features and includes example_id and offset_mapping
    # required for dev F1 computation; these output fields are preserved.
    # @return DatasetBundle Prepared datasets and utilities.
    def load(self) -> DatasetBundle:
        tokenizer = self.build_tokenizer()
        raw = self._load_raw_dataset()

        train_raw = self._get_split_optional(raw, self._cfg.train_split)
        eval_raw = self._get_split_optional(raw, self._cfg.validation_split)

        # IMPORTANT: Some configs (e.g., cnn_dailymail in this repo) may leave test_split empty.
        # The paper evaluates CNN/DM with ROUGE, and CNN/DM provides a proper "test" split.
        # We therefore:
        #   - use cfg.test_split if provided
        #   - otherwise fall back to "test" if present (so train+test access works for CNN/DM)
        test_split_name = getattr(self._cfg, "test_split", None)
        test_raw = self._get_split_optional(raw, test_split_name) if test_split_name else None
        if test_raw is None:
            test_raw = self._get_split_optional(raw, "test")

        preprocessor = TaskPreprocessor(
            tokenizer=tokenizer,
            config=self._cfg,
            model_config=self._model_cfg,
        )

        label_names = self._extract_label_names(train_raw)

        train_ds = (
            self._preprocess_split(train_raw, preprocessor, split_name=self._cfg.train_split)
            if train_raw is not None
            else None
        )
        eval_ds = (
            self._preprocess_split(eval_raw, preprocessor, split_name=self._cfg.validation_split)
            if eval_raw is not None
            else None
        )
        test_ds = (
            self._preprocess_split(test_raw, preprocessor, split_name=(test_split_name or "test"))
            if test_raw is not None
            else None
        )

        # Collator is selected by task_type; model not required at this stage per current project wiring.
        data_collator = build_data_collator(
            tokenizer=tokenizer,
            model_config=self._model_cfg,
            data_config=self._cfg,
            model=None,
        )

        return DatasetBundle(
            train_dataset=train_ds,
            eval_dataset=eval_ds,
            test_dataset=test_ds,
            tokenizer=tokenizer,
            data_collator=data_collator,
            label_names=label_names,
        )

    ## @brief Load the raw dataset using Hugging Face Datasets.
    # @param None
    # @return DatasetDict Loaded dataset dictionary.
    def _load_raw_dataset(self) -> DatasetDict:
        dataset_name = str(self._cfg.dataset_name).strip()
        if not dataset_name:
            raise ValueError("data.dataset_name must be set.")

        dataset_config = str(self._cfg.dataset_config_name).strip()
        if dataset_config:
            ds = load_dataset(dataset_name, dataset_config)
        else:
            ds = load_dataset(dataset_name)

        if not isinstance(ds, DatasetDict):
            # load_dataset can return Dataset for some local/script datasets; normalize to DatasetDict.
            # However, our design expects splits; if none exist, wrap as 'train'.
            if isinstance(ds, Dataset):
                return DatasetDict({"train": ds})
            raise TypeError(f"Unexpected dataset type returned by load_dataset: {type(ds)}")

        return ds

    ## @brief Get a dataset split if present.
    # @param raw DatasetDict The raw dataset dict.
    # @param split_name str Split name to fetch.
    # @return Optional[Dataset] The split dataset, or None if missing.
    def _get_split_optional(self, raw: DatasetDict, split_name: Any) -> Optional[Dataset]:
        # split_name is typed as Any here to safely accept missing/None from configs.
        if split_name is None:
            return None
        name = str(split_name).strip()
        if not name:
            return None
        if name in raw:
            return raw[name]
        return None

    ## @brief Preprocess a single split with the correct task preprocessor.
    # @details Uses batched mapping; removes original columns (inputs) to keep batches collator-friendly.
    # For QA, output columns (example_id, offset_mapping) returned by preprocess_qa are preserved.
    # @param dataset Dataset The raw split dataset.
    # @param preprocessor TaskPreprocessor Task preprocessor.
    # @param split_name str Human-readable split name for map() description.
    # @return Dataset Tokenized/preprocessed dataset.
    def _preprocess_split(
        self,
        dataset: Dataset,
        preprocessor: TaskPreprocessor,
        split_name: str,
    ) -> Dataset:
        task_type = str(self._model_cfg.task_type)
        remove_cols = list(dataset.column_names)

        if task_type == "sequence_classification":
            map_fn = preprocessor.preprocess_classification
        elif task_type == "question_answering":
            map_fn = preprocessor.preprocess_qa
        elif task_type == "seq2seq":
            map_fn = preprocessor.preprocess_seq2seq
        elif task_type == "causal_lm":
            map_fn = preprocessor.preprocess_causal_lm
        else:
            raise ValueError(f"Unsupported model.task_type: {task_type}")

        processed = dataset.map(
            map_fn,
            batched=True,
            remove_columns=remove_cols,
            desc=f"preprocess[{task_type}]({split_name})",
        )

        return processed

    ## @brief Extract label names for classification tasks if available.
    # @details
    # For GLUE-like datasets, label feature is often ClassLabel with .names.
    # For non-classification tasks, returns empty list.
    # @param train_dataset Optional[Dataset] Training dataset (raw, before preprocessing).
    # @return list[str] Label names if available, else empty list.
    def _extract_label_names(self, train_dataset: Optional[Dataset]) -> List[str]:
        if str(self._model_cfg.task_type) != "sequence_classification":
            return []
        if train_dataset is None:
            return []

        label_field = str(self._cfg.label_field).strip()
        if not label_field:
            return []

        features = getattr(train_dataset, "features", None)
        if features is None or label_field not in features:
            return []

        label_feature = features[label_field]
        names = getattr(label_feature, "names", None)
        if isinstance(names, list) and all(isinstance(x, str) for x in names):
            return list(names)

        return []
