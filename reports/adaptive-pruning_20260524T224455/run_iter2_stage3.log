## @brief Main training orchestrator for APT experiments.
# @details
# Implements the two-stage training described in the paper:
# 1) pruning (+ optional self-distillation) stage with adaptive pruning/tuning,
# 2) recovery supervised fine-tuning stage with fixed structure.
class Trainer:
    ## @brief Initialize Trainer.
    # @param model APTModelWrapper Wrapped model with injected APTLinear modules.
    # @param datasets DatasetBundle Tokenized datasets bundle.
    # @param config ExperimentConfig Full experiment configuration.
    # @param salience SalienceCollector Salience collector (hooks must be attached upstream or by Trainer).
    # @param pruner PruningScheduler Pruning scheduler implementing cubic sparsity schedule and block selection.
    # @param rank_allocator RankAllocator Rank allocator implementing top-half selection and rank expansion.
    # @param distiller Optional[DistillationManager] Distillation manager for pruning stage (None disables distillation).
    # @param profiler Profiler Profiler for time and memory measurements.
    def __init__(
        self,
        model: APTModelWrapper,
        datasets: DatasetBundle,
        config: ExperimentConfig,
        salience: SalienceCollector,
        pruner: PruningScheduler,
        rank_allocator: RankAllocator,
        distiller: Optional[DistillationManager],
        profiler: Profiler,
    ) -> None:
        self._logger = get_logger(self.__class__.__name__, level=config.runtime.log_level)

        if not isinstance(model, APTModelWrapper):
            raise TypeError(f"model must be APTModelWrapper, got {type(model)}")
        if not isinstance(datasets, DatasetBundle):
            raise TypeError(f"datasets must be DatasetBundle, got {type(datasets)}")
        if not isinstance(config, ExperimentConfig):
            raise TypeError(f"config must be ExperimentConfig, got {type(config)}")
        if not isinstance(salience, SalienceCollector):
            raise TypeError(f"salience must be SalienceCollector, got {type(salience)}")
        if not isinstance(pruner, PruningScheduler):
            raise TypeError(f"pruner must be PruningScheduler, got {type(pruner)}")
        if not isinstance(rank_allocator, RankAllocator):
            raise TypeError(f"rank_allocator must be RankAllocator, got {type(rank_allocator)}")
        if distiller is not None and not isinstance(distiller, DistillationManager):
            raise TypeError(f"distiller must be DistillationManager|None, got {type(distiller)}")
        if not isinstance(profiler, Profiler):
            raise TypeError(f"profiler must be Profiler, got {type(profiler)}")

        self.model: APTModelWrapper = model
        self.datasets: DatasetBundle = datasets
        self.config: ExperimentConfig = config
        self.salience: SalienceCollector = salience
        self.pruner: PruningScheduler = pruner
        self.rank_allocator: RankAllocator = rank_allocator
        self.distiller: Optional[DistillationManager] = distiller
        self.profiler: Profiler = profiler

        self._device: torch.device = torch.device(str(self.config.runtime.device))
        self.model.to(self._device)

        # Dataloaders
        self._train_dataloader: DataLoader = self._build_dataloader(train=True)
        self._eval_dataloader: Optional[DataLoader] = (
            self._build_dataloader(train=False) if self.datasets.eval_dataset is not None else None
        )

        # Optimization state
        self._optimizer: Optional[Optimizer] = None
        self._scheduler: Optional[Any] = None

        # Training state
        self._global_step: int = 0  # optimizer update steps (not micro-batches)
        self._history: List[Dict[str, Any]] = []
        self._best_checkpoint_path: str = ""
        self._best_metric_value: float = float("-inf")
        self._peak_train_memory_mb: float = 0.0
        self._train_start_walltime: float = 0.0

        # Callbacks bundle
        primary_metric = self._primary_metric_name()
        self._callbacks: CallbackBundle = CallbackBundle(
            eval_scheduler=EvalSchedulerCallback(eval_every_steps=int(self.config.training.eval_every_steps)),
            checkpoint=CheckpointCallback(
                save_every_steps=int(self.config.training.save_every_steps),
                output_dir=str(self.config.runtime.output_dir),
            ),
            best_metric=BestMetricCallback(
                metric_name=str(primary_metric),
                mode="max",
                output_dir=str(self.config.runtime.output_dir),
            ),
            # TTA threshold is not known inside Trainer without FT baseline; enable only if explicitly set in env.
            # This remains faithful: we do not fabricate a target metric threshold.
            tta=TTATrackerCallback(
                metric_name=str(primary_metric),
                target_metric_value=self._read_tta_target_from_env(primary_metric=primary_metric),
                enabled=(self._read_tta_target_from_env(primary_metric=primary_metric) is not None)
                and (self.config.model.task_type != "causal_lm"),
                output_dir=str(self.config.runtime.output_dir),
            ),
            early_stopping=None,
        )

        # Ensure output directory exists
        Path(self.config.runtime.output_dir).mkdir(parents=True, exist_ok=True)
        save_json(Path(self.config.runtime.output_dir) / "registry.json", self.model.get_registry().state_dict())
        save_json(Path(self.config.runtime.output_dir) / "experiment_config.json", self.config)

    ## @brief Build the optimizer over trainable parameters.
    # @details Uses only parameters with requires_grad=True (PEFT adapters + any unfrozen head).
    # @return torch.optim.Optimizer Optimizer instance.
    def build_optimizer(self) -> Optimizer:
        lr = float(self.config.training.learning_rate)
        wd = float(self.config.training.weight_decay)
        opt_name = str(self.config.training.optimizer_name).lower().strip()

        params: List[nn.Parameter] = [p for p in self.model.parameters() if p.requires_grad]
        if not params:
            raise ValueError("No trainable parameters found (requires_grad=True).")

        if opt_name == "adamw":
            optimizer = torch.optim.AdamW(params, lr=lr, weight_decay=wd)
        elif opt_name == "adam":
            optimizer = torch.optim.Adam(params, lr=lr, weight_decay=wd)
        elif opt_name == "sgd":
            optimizer = torch.optim.SGD(params, lr=lr, weight_decay=wd, momentum=0.9)
        else:
            raise ValueError(f"Unsupported optimizer_name='{opt_name}' (expected: adamw/adam/sgd).")
        return optimizer

    ## @brief Build LR scheduler for the current optimizer.
    # @details Uses transformers.get_scheduler with warmup ratio from config.
    # @param total_steps int Total optimizer steps for the full training run.
    # @return Any Scheduler instance.
    def build_scheduler(self, total_steps: int) -> Any:
        scheduler_type = str(self.config.training.lr_scheduler_type).lower().strip()
        warmup_ratio = float(self.config.training.warmup_ratio)
        if total_steps <= 0:
            total_steps = 1
        warmup_steps = int(math.floor(warmup_ratio * float(total_steps)))
        warmup_steps = max(0, min(warmup_steps, total_steps))

        scheduler = get_scheduler(
            name=scheduler_type,
            optimizer=self._optimizer,
            num_warmup_steps=warmup_steps,
            num_training_steps=int(total_steps),
        )
        return scheduler

    ## @brief Reset optimizer and scheduler if needed after parameter shape changes.
    # @details The paper/appendix states to reset optimizer after each parameter size change for stability.
    # @return None
    def reset_optimizer_if_needed(self) -> None:
        if not bool(self.config.apt.enable_apt):
            return
        # config.yaml states optimizer_reset_after_shape_change = true; config.py stores this policy as a boolean
        # in apt config through validation/normalization; we follow the config-level flag implied by the project:
        # optimizer reset is mandatory after rank expansion shape changes.
        # (No extra knobs are fabricated here.)
        self._optimizer = self.build_optimizer()
        total_steps = self._compute_total_optimizer_steps()
        self._scheduler = self.build_scheduler(total_steps=total_steps)
        self._optimizer.zero_grad(set_to_none=True)

    ## @brief Main training routine: pruning stage then recovery stage.
    # @return TrainResult Training result with best checkpoint, history, and efficiency metrics.
    def train(self) -> TrainResult:
        self._train_start_walltime = time.perf_counter()
        self.profiler.reset_cuda_stats()

        # Ensure salience hooks are attached for pruning stage.
        self.salience.attach_hooks()

        total_steps = self._compute_total_optimizer_steps()
        self._optimizer = self.build_optimizer()
        self._scheduler = self.build_scheduler(total_steps=total_steps)
        self._optimizer.zero_grad(set_to_none=True)

        pruning_epochs, recovery_epochs = self._compute_stage_epochs()
        self._logger.info(
            "Training plan: total_epochs=%d pruning_epochs=%d recovery_epochs=%d total_steps=%d",
            int(self.config.training.num_epochs),
            int(pruning_epochs),
            int(recovery_epochs),
            int(total_steps),
        )

        # Run stage A: pruning (+ optional distillation) stage.
        if pruning_epochs > 0:
            self.run_pruning_stage(pruning_epochs=pruning_epochs)

        # Transition: stop adaptive pruning/tuning; stop distillation; optionally detach salience hooks.
        # Paper: then fine-tune the pruned LM to recover performance.
        try:
            self.salience.detach_hooks()
        except Exception:
            # Safe: hooks may be needed elsewhere; do not crash.
            pass

        # Run stage B: recovery supervised fine-tuning stage.
        if recovery_epochs > 0:
            self.run_recovery_stage(recovery_epochs=recovery_epochs)

        # Final save (as "final") and metadata.
        final_ckpt = self.save_checkpoint(tag="final")
        self._callbacks.checkpoint.record_checkpoint(
            path=final_ckpt,
            step=self._global_step,
            epoch=int(self.config.training.num_epochs) - 1,
            tag="final",
            stage="final",
        )

        # Persist callback metadata.
        self._callbacks.checkpoint.save_metadata()
        self._callbacks.best_metric.save_metadata()
        self._callbacks.tta.save_metadata()
        self._callbacks.save_all(output_dir=str(self.config.runtime.output_dir))

        # Peak memory
        self._peak_train_memory_mb = max(self._peak_train_memory_mb, float(self.profiler.measure_peak_train_memory()))

        # Choose best checkpoint path.
        best_path = self._callbacks.best_metric.best_checkpoint_path() or self._best_checkpoint_path

        # If best metric was never updated, keep -inf as sentinel; normalize to 0.0 for cleaner reporting.
        best_metric = self._callbacks.best_metric.best_metric()
        best_metric_val = float(best_metric) if best_metric is not None else 0.0

        # Time-to-accuracy: only meaningful for small models when an explicit threshold is provided.
        tta_val = self._callbacks.tta.time_to_accuracy_s()
        time_to_acc = float(tta_val) if tta_val is not None else 0.0

        # Write training history for reproducibility.
        save_json(Path(self.config.runtime.output_dir) / "train_history.json", self._history)

        return TrainResult(
            best_checkpoint=str(best_path) if best_path is not None else "",
            best_metric=float(best_metric_val),
            history=list(self._history),
            peak_train_memory_mb=float(self._peak_train_memory_mb),
            time_to_accuracy_s=float(time_to_acc),
        )

    ## @brief Run the pruning stage.
    # @details Executes adaptive pruning (AP), adaptive tuning (AT), and optional self-distillation.
    # @param pruning_epochs int Number of epochs in the pruning stage.
    # @return None
    def run_pruning_stage(self, pruning_epochs: int) -> None:
        if pruning_epochs <= 0:
            return

        self.model.train()
        total_pruning_steps = self._compute_pruning_optimizer_steps(pruning_epochs=pruning_epochs)

        # Prepare teacher for distillation if used (small models).
        teacher_model: Optional[Any] = None
        if self.distiller is not None and bool(self.config.apt.use_self_distill):
            teacher_model = self.distiller.build_teacher()

        grad_accum = int(self.config.training.gradient_accumulation_steps)
        grad_accum = max(1, grad_accum)

        self._logger.info("Pruning stage: epochs=%d total_pruning_steps=%d", int(pruning_epochs), int(total_pruning_steps))

        for epoch in range(int(pruning_epochs)):
            epoch_start = time.perf_counter()
            micro_step_in_epoch = 0
            step_time_accum_s = 0.0
            step_count = 0

            for batch in self._train_dataloader:
                micro_step_in_epoch += 1
                step_wall_start = time.perf_counter()

                # Train step (micro-batch): forward/backward and salience update.
                step_out = self.train_step(
                    batch=batch,
                    global_step=self._global_step,
                    stage="pruning",
                    total_pruning_steps=total_pruning_steps,
                    teacher_model=teacher_model,
                    use_distillation=(self.distiller is not None and bool(self.config.apt.use_self_distill)),
                )

                # Accumulation boundary -> optimizer update step.
                do_step = (micro_step_in_epoch % grad_accum == 0)
                if do_step:
                    self._clip_gradients_if_needed()
                    self._optimizer.step()
                    if self._scheduler is not None:
                        self._scheduler.step()
                    self._optimizer.zero_grad(set_to_none=True)

                    # Update profiler peak memory.
                    if bool(self.config.evaluation.measure_train_peak_memory):
                        self._peak_train_memory_mb = max(
                            self._peak_train_memory_mb, float(self.profiler.measure_peak_train_memory())
                        )

                    # Adaptive pruning update (AP) and rank update (AT) occur on optimizer steps (paper uses "training step t").
                    pruning_updated = self.maybe_update_pruning(
                        global_step=self._global_step,
                        total_pruning_steps=total_pruning_steps,
                    )
                    rank_updated = self.maybe_update_ranks(
                        global_step=self._global_step,
                        total_pruning_steps=total_pruning_steps,
                    )

                    # Reset optimizer if rank update changed tensor shapes (paper: reset after parameter size changes).
                    if rank_updated:
                        self.reset_optimizer_if_needed()

                    # Log step info (optimizer step).
                    elapsed_s = float(time.perf_counter() - self._train_start_walltime)
                    lr_val = float(self._get_current_lr())
                    record = self._build_history_record(
                        stage="pruning",
                        epoch=epoch,
                        global_step=self._global_step,
                        elapsed_time_s=elapsed_s,
                        lr=lr_val,
                        step_output=step_out,
                        pruning_updated=pruning_updated,
                        rank_updated=rank_updated,
                        step_time_s=float(time.perf_counter() - step_wall_start),
                    )
                    self._history.append(record)

                    # Periodic evaluation/checkpointing on optimizer steps.
                    if self._eval_dataloader is not None and self._callbacks.eval_scheduler.should_evaluate(
                        global_step=self._global_step,
                        epoch=epoch,
                        force=False,
                    ):
                        val_metrics = self._evaluate(stage="pruning", epoch=epoch, global_step=self._global_step)
                        primary = self._primary_metric_name()
                        metric_val = float(val_metrics.get(primary, 0.0))
                        improved = self._callbacks.best_metric.update(
                            metric_value=metric_val,
                            metrics={k: float(v) for k, v in val_metrics.items()},
                            step=self._global_step,
                            epoch=epoch,
                            checkpoint_path=None,
                            stage="pruning",
                        )
                        # Save best checkpoint immediately when improved.
                        if improved:
                            best_ckpt = self.save_checkpoint(tag="best")
                            self._callbacks.best_metric.set_best_checkpoint_path(best_ckpt)
                            self._best_checkpoint_path = best_ckpt
                            self._best_metric_value = metric_val

                        # Update TTA if enabled and threshold known.
                        _ = self._callbacks.tta.update(
                            metric_value=metric_val,
                            elapsed_time_s=elapsed_s,
                            step=self._global_step,
                            epoch=epoch,
                            stage="pruning",
                        )

                    # Periodic checkpoint (step checkpoints).
                    if self._callbacks.checkpoint.should_save(
                        global_step=self._global_step,
                        epoch=epoch,
                        force=False,
                    ):
                        ckpt_path = self.save_checkpoint(tag=f"step_{self._global_step}")
                        self._callbacks.checkpoint.record_checkpoint(
                            path=ckpt_path,
                            step=self._global_step,
                            epoch=epoch,
                            tag="step",
                            stage="pruning",
                        )

                    # Advance global optimizer-step.
                    self._global_step += 1

                    # Track LLaMA-like speed metric per step (paper: time per step).
                    step_time_accum_s += float(time.perf_counter() - step_wall_start)
                    step_count += 1

                # Always clear step-local salience caches after processing the micro-batch.
                # This matches SalienceCollector design and avoids stale activations.
                self.salience.reset_step_cache()

            epoch_elapsed = float(time.perf_counter() - epoch_start)
            avg_step_time = float(step_time_accum_s / max(1, step_count))

            # Log epoch-level summary.
            log_metrics(
                metrics={
                    "epoch_time_s": epoch_elapsed,
                    "avg_step_time_s": avg_step_time,
                },
                step=self._global_step,
                split="train/pruning_epoch",
                logger=self._logger,
            )

    ## @brief Run the recovery stage (supervised fine-tuning only).
    # @details Structural updates are disabled; only task loss is used.
    # @param recovery_epochs int Number of epochs in the recovery stage.
    # @return None
    def run_recovery_stage(self, recovery_epochs: int) -> None:
        if recovery_epochs <= 0:
            return
        self.model.train()

        grad_accum = int(self.config.training.gradient_accumulation_steps)
        grad_accum = max(1, grad_accum)

        start_epoch = int(self.config.training.distill_epochs)
        self._logger.info("Recovery stage: epochs=%d", int(recovery_epochs))

        for i in range(int(recovery_epochs)):
            epoch = start_epoch + i
            epoch_start = time.perf_counter()
            micro_step_in_epoch = 0

            for batch in self._train_dataloader:
                micro_step_in_epoch += 1
                step_wall_start = time.perf_counter()

                step_out = self.train_step(
                    batch=batch,
                    global_step=self._global_step,
                    stage="recovery",
                    total_pruning_steps=0,
                    teacher_model=None,
                    use_distillation=False,
                )

                do_step = (micro_step_in_epoch % grad_accum == 0)
                if do_step:
                    self._clip_gradients_if_needed()
                    self._optimizer.step()
                    if self._scheduler is not None:
                        self._scheduler.step()
                    self._optimizer.zero_grad(set_to_none=True)

                    if bool(self.config.evaluation.measure_train_peak_memory):
                        self._peak_train_memory_mb = max(
                            self._peak_train_memory_mb, float(self.profiler.measure_peak_train_memory())
                        )

                    elapsed_s = float(time.perf_counter() - self._train_start_walltime)
                    lr_val = float(self._get_current_lr())
                    record = self._build_history_record(
                        stage="recovery",
                        epoch=epoch,
                        global_step=self._global_step,
                        elapsed_time_s=elapsed_s,
                        lr=lr_val,
                        step_output=step_out,
                        pruning_updated=False,
                        rank_updated=False,
                        step_time_s=float(time.perf_counter() - step_wall_start),
                    )
                    self._history.append(record)

                    # Periodic evaluation/checkpointing on optimizer steps.
                    if self._eval_dataloader is not None and self._callbacks.eval_scheduler.should_evaluate(
                        global_step=self._global_step,
                        epoch=epoch,
                        force=False,
                    ):
                        val_metrics = self._evaluate(stage="recovery", epoch=epoch, global_step=self._global_step)
                        primary = self._primary_metric_name()
                        metric_val = float(val_metrics.get(primary, 0.0))
                        improved = self._callbacks.best_metric.update(
                            metric_value=metric_val,
                            metrics={k: float(v) for k, v in val_metrics.items()},
                            step=self._global_step,
                            epoch=epoch,
                            checkpoint_path=None,
                            stage="recovery",
                        )
                        if improved:
                            best_ckpt = self.save_checkpoint(tag="best")
                            self._callbacks.best_metric.set_best_checkpoint_path(best_ckpt)
                            self._best_checkpoint_path = best_ckpt
                            self._best_metric_value = metric_val

                        _ = self._callbacks.tta.update(
                            metric_value=metric_val,
                            elapsed_time_s=elapsed_s,
                            step=self._global_step,
                            epoch=epoch,
                            stage="recovery",
                        )

                    if self._callbacks.checkpoint.should_save(
                        global_step=self._global_step,
                        epoch=epoch,
                        force=False,
                    ):
                        ckpt_path = self.save_checkpoint(tag=f"step_{self._global_step}")
                        self._callbacks.checkpoint.record_checkpoint(
                            path=ckpt_path,
                            step=self._global_step,
                            epoch=epoch,
                            tag="step",
                            stage="recovery",
                        )

                    self._global_step += 1

            epoch_elapsed = float(time.perf_counter() - epoch_start)
            log_metrics(
                metrics={"epoch_time_s": epoch_elapsed},
                step=self._global_step,
                split="train/recovery_epoch",
                logger=self._logger,
            )

    ## @brief Perform a single training micro-step (forward + loss + backward).
    # @details If distillation is enabled (pruning stage), uses the exact paper formula:
    #   L = μ L_distill + (1-μ) L_ft
    # with μ linearly increasing from 0 to 1 over pruning steps (config.yaml).
    # @param batch dict Input batch.
    # @param global_step int Current optimizer-step counter (used for schedules).
    # @param stage str Training stage name ("pruning" or "recovery").
    # @param total_pruning_steps int Total pruning optimizer steps (for μ schedule).
    # @param teacher_model Optional[Any] Teacher model (required if use_distillation True).
    # @param use_distillation bool Whether to apply self-distillation.
    # @return StepOutput Step output with scalar losses and metrics.
    def train_step(
        self,
        batch: Dict[str, Any],
        global_step: int,
        stage: str,
        total_pruning_steps: int,
        teacher_model: Optional[Any],
        use_distillation: bool,
    ) -> StepOutput:
        if self._optimizer is None:
            raise RuntimeError("Optimizer is not initialized. Call train() first.")
        stg = str(stage)

        batch_on_device = self._move_batch_to_device(batch=batch)

        # Autocast configuration
        use_fp16 = bool(self.config.training.fp16)
        use_bf16 = bool(self.config.training.bf16)
        autocast_dtype: Optional[torch.dtype] = None
        if use_fp16:
            autocast_dtype = torch.float16
        elif use_bf16:
            autocast_dtype = torch.bfloat16

        with torch.autocast(device_type=self._device.type, dtype=autocast_dtype, enabled=(autocast_dtype is not None)):
            outputs = self.model(**batch_on_device)

            if not use_distillation:
                task_loss = getattr(outputs, "loss", None)
                if task_loss is None or not torch.is_tensor(task_loss):
                    raise ValueError(
                        "Model outputs must include a tensor 'loss' when labels are provided. "
                        "Ensure the dataset preprocessing/collator provides labels."
                    )
                total_loss = task_loss
                distill_loss = task_loss.detach() * 0.0
                layer_loss = task_loss.detach() * 0.0
            else:
                if self.distiller is None:
                    raise RuntimeError("use_distillation=True but distiller is None.")
                if teacher_model is None:
                    raise RuntimeError("use_distillation=True but teacher_model is None.")
                if stg != "pruning":
                    # Paper describes distillation primarily to recover pruned LM performance while pruning.
                    raise RuntimeError("Distillation is only supported during pruning stage in this reproduction.")

                mu = float(self.distiller.compute_mu(global_step=int(global_step), total_steps=int(total_pruning_steps)))

                # Teacher forward under no_grad (efficient distillation target).
                with torch.no_grad():
                    teacher_outputs = teacher_model(**batch_on_device)

                loss_out: DistillLossOutput = self.distiller.compute_loss(
                    student_outputs=outputs,
                    teacher_outputs=teacher_outputs,
                    batch=batch_on_device,
                    mu=float(mu),
                )
                total_loss = loss_out.total_loss
                task_loss = loss_out.task_loss
                distill_loss = loss_out.distill_loss
                layer_loss = loss_out.layer_loss

        # Backward
        grad_accum = int(self.config.training.gradient_accumulation_steps)
        grad_accum = max(1, grad_accum)
        scaled_loss = total_loss / float(grad_accum)
        scaled_loss.backward()

        # Update salience after backward signals exist (pruning stage only).
        if stg == "pruning" and bool(self.config.apt.enable_apt):
            self.salience.update_block_salience()

        # Metrics for logging
        metrics: Dict[str, float] = {
            "lr": float(self._get_current_lr()),
            "stage_is_pruning": 1.0 if stg == "pruning" else 0.0,
            "layer_loss": float(layer_loss.detach().item()) if torch.is_tensor(layer_loss) else 0.0,
        }

        # Add structured introspection for APT modules
        metrics.update(self._apt_introspection_metrics())

        return StepOutput(
            loss=float(total_loss.detach().item()),
            task_loss=float(task_loss.detach().item()),
            distill_loss=float(distill_loss.detach().item()) if torch.is_tensor(distill_loss) else 0.0,
            metrics=metrics,
        )

    ## @brief Possibly update pruning masks (adaptive pruning, AP).
    # @details Triggered every apt.prune_update_interval optimizer steps during pruning stage.
    # Implements cubic sparsity schedule exactly via PruningScheduler.target_sparsity_at_step().
    # @param global_step int Current optimizer step t.
    # @param total_pruning_steps int Total optimizer steps T in pruning stage.
    # @return bool True if pruning update was applied, else False.
    def maybe_update_pruning(self, global_step: int, total_pruning_steps: int) -> bool:
        if not bool(self.config.apt.enable_apt):
            return False
        interval = int(self.config.apt.prune_update_interval)
        if interval <= 0:
            return False
        if int(global_step) % interval != 0:
            return False

        # Exact cubic schedule provided by config.yaml is implemented in pruner.
        gamma_t = float(self.pruner.target_sparsity_at_step(int(global_step), int(total_pruning_steps)))
        block_scores = self.salience.get_block_scores()

        retain_ids = self.pruner.select_blocks(block_scores=block_scores, target_sparsity=float(gamma_t))

        # Apply gradual mask update alpha from config.yaml (0.01) exactly.
        # NOTE: Trainer must not directly own MaskManager by design; we route updates through pruner internals.
        # In this codebase, PruningScheduler encapsulates a MaskManager reference and performs selection only;
        # actual mask updates are applied by accessing its internal MaskManager instance (private attribute).
        # This preserves external public interfaces while implementing the paper's algorithm.
        alpha = float(self.config.apt.mask_update_step)

        mm = getattr(self.pruner, "_mask_manager", None)
        if mm is None:
            raise AttributeError(
                "PruningScheduler does not expose a mask manager reference needed to apply mask updates. "
                "This reproduction requires PruningScheduler to hold MaskManager as designed."
            )
        mm.apply_mask_updates(retain_ids=retain_ids, alpha=float(alpha))
        return True

    ## @brief Possibly update adapter ranks (adaptive tuning, AT).
    # @details Triggered every apt.rank_update_interval optimizer steps during pruning stage.
    # Selects top-half adapters by salience and expands their ranks using the budget scaling rule.
    # @param global_step int Current optimizer step t.
    # @param total_pruning_steps int Total optimizer steps T in pruning stage.
    # @return bool True if any rank expanded (shape changed), else False.
    def maybe_update_ranks(self, global_step: int, total_pruning_steps: int) -> bool:
        if not bool(self.config.apt.enable_apt):
            return False
        interval = int(self.config.apt.rank_update_interval)
        if interval <= 0:
            return False
        if int(global_step) % interval != 0:
            return False

        adapter_importance = self.salience.get_adapter_importance()
        selected = self.rank_allocator.select_top_half(adapter_importance=adapter_importance)

        new_budget = int(self.rank_allocator.compute_budget(int(global_step), int(total_pruning_steps)))
        shape_changed = bool(self.rank_allocator.expand_selected_modules(selected=selected, new_budget=int(new_budget)))
        return bool(shape_changed)

    ## @brief Save a checkpoint.
    # @details Saves model, optimizer, scheduler, and training state into a directory under runtime.output_dir.
    # @param tag str Checkpoint tag (e.g., "best", "final", "step_1000").
    # @return str Path to checkpoint directory.
    def save_checkpoint(self, tag: str) -> str:
        ckpt_dir = Path(self.config.runtime.output_dir) / "checkpoints" / str(tag)
        ckpt_dir.mkdir(parents=True, exist_ok=True)

        # Save model weights (state dict). We keep the training model with adapters unmerged, to allow resume.
        model_path = ckpt_dir / "model.pt"
        torch.save(self.model.state_dict(), str(model_path))

        # Save optimizer and scheduler
        if self._optimizer is not None:
            torch.save(self._optimizer.state_dict(), str(ckpt_dir / "optimizer.pt"))
        if self._scheduler is not None:
            try:
                torch.save(self._scheduler.state_dict(), str(ckpt_dir / "scheduler.pt"))
            except Exception:
                # Some schedulers may not be serializable; still store minimal LR state.
                save_json(ckpt_dir / "scheduler_fallback.json", {"lr": float(self._get_current_lr())})

        # Save trainer state
        trainer_state = {
            "global_step": int(self._global_step),
            "best_metric": float(self._best_metric_value),
            "best_checkpoint": str(self._best_checkpoint_path),
            "peak_train_memory_mb": float(self._peak_train_memory_mb),
        }
        save_json(ckpt_dir / "trainer_state.json", trainer_state)

        # Save registry state for reproducibility/debugging
        save_json(ckpt_dir / "registry.json", self.model.get_registry().state_dict())

        # Save masks (soft + binary) if available through MaskManager.
        mm = getattr(self.pruner, "_mask_manager", None)
        if mm is not None:
            try:
                # Save binary masks for export/analysis
                bin_masks = mm.get_binary_masks(threshold=0.5)
                # Convert tensors to lists for JSON; keep also pt file.
                torch.save(bin_masks, str(ckpt_dir / "binary_masks.pt"))
                save_json(
                    ckpt_dir / "binary_masks.json",
                    {k: v.detach().cpu().tolist() for k, v in bin_masks.items()},
                )
            except Exception as e:
                self._logger.warning("Failed to save masks: %s", str(e))

        return str(ckpt_dir)

    ## @brief Load a checkpoint into the trainer state.
    # @details Restores model/optimizer/scheduler and trainer counters.
    # @param path str Checkpoint directory path.
    # @return None
    def load_checkpoint(self, path: str) -> None:
        ckpt_dir = Path(str(path))
        if not ckpt_dir.exists():
            raise FileNotFoundError(f"Checkpoint directory not found: {path}")

        model_path = ckpt_dir / "model.pt"
        if not model_path.exists():
            raise FileNotFoundError(f"Checkpoint missing model.pt: {model_path}")
        state = torch.load(str(model_path), map_location="cpu")
        self.model.load_state_dict(state, strict=True)
        self.model.to(self._device)

        # Optimizer/scheduler (must rebuild first if absent)
        if self._optimizer is None:
            self._optimizer = self.build_optimizer()
        opt_path = ckpt_dir / "optimizer.pt"
        if opt_path.exists():
            self._optimizer.load_state_dict(torch.load(str(opt_path), map_location="cpu"))

        if self._scheduler is None:
            total_steps = self._compute_total_optimizer_steps()
            self._scheduler = self.build_scheduler(total_steps=total_steps)
        sch_path = ckpt_dir / "scheduler.pt"
        if sch_path.exists():
            try:
                self._scheduler.load_state_dict(torch.load(str(sch_path), map_location="cpu"))
            except Exception:
                pass

        st_path = ckpt_dir / "trainer_state.json"
        if st_path.exists():
            with st_path.open("r", encoding="utf-8") as f:
                st = json.load(f)
            self._global_step = int(st.get("global_step", self._global_step))
            self._best_metric_value = float(st.get("best_metric", self._best_metric_value))
            self._best_checkpoint_path = str(st.get("best_checkpoint", self._best_checkpoint_path))
            self._peak_train_memory_mb = float(st.get("peak_train_memory_mb", self._peak_train_memory_mb))

    ## @brief Build a training or evaluation dataloader.
    # @param train bool Whether to build the training loader.
    # @return DataLoader Torch DataLoader.
    def _build_dataloader(self, train: bool) -> DataLoader:
        dataset = self.datasets.train_dataset if bool(train) else self.datasets.eval_dataset
        if dataset is None:
            raise ValueError("Requested dataloader split is None.")

        batch_size = int(self.config.data.batch_size) if bool(train) else int(self.config.data.eval_batch_size)
        shuffle = bool(train)

        dl = DataLoader(
            dataset,
            batch_size=batch_size,
            shuffle=shuffle,
            num_workers=int(self.config.runtime.num_workers),
            pin_memory=bool(self.config.runtime.pin_memory),
            collate_fn=self.datasets.data_collator,
            drop_last=False,
        )
        return dl

    ## @brief Compute total optimizer steps for the full training (all epochs).
    # @return int Total optimizer update steps.
    def _compute_total_optimizer_steps(self) -> int:
        steps_per_epoch = self._steps_per_epoch()
        total_epochs = int(self.config.training.num_epochs)
        return int(max(1, total_epochs * steps_per_epoch))

    ## @brief Compute optimizer steps for pruning stage.
    # @param pruning_epochs int Pruning stage epochs.
    # @return int Total pruning stage optimizer steps.
    def _compute_pruning_optimizer_steps(self, pruning_epochs: int) -> int:
        steps_per_epoch = self._steps_per_epoch()
        return int(max(1, int(pruning_epochs) * steps_per_epoch))

    ## @brief Compute optimizer steps per epoch based on dataloader length and gradient accumulation.
    # @return int Steps per epoch.
    def _steps_per_epoch(self) -> int:
        n_batches = int(len(self._train_dataloader))
        grad_accum = int(self.config.training.gradient_accumulation_steps)
        grad_accum = max(1, grad_accum)
        return int(math.ceil(float(n_batches) / float(grad_accum)))

    ## @brief Compute pruning/recovery epoch split.
    # @details Uses config.training.distill_epochs when >0; otherwise uses config.apt.pruning_stage_ratio.
    # @return tuple[int, int] (pruning_epochs, recovery_epochs)
    def _compute_stage_epochs(self) -> Tuple[int, int]:
        total_epochs = int(self.config.training.num_epochs)
        distill_epochs = int(self.config.training.distill_epochs)
        if distill_epochs > 0:
            pruning_epochs = int(distill_epochs)
        else:
            # For runs without explicit distillation epochs (e.g., Alpaca/LLaMA), use configured pruning_stage_ratio.
            ratio = float(self.config.apt.pruning_stage_ratio)
            ratio = max(0.0, min(1.0, ratio))
            pruning_epochs = int(round(float(total_epochs) * ratio))

        pruning_epochs = max(0, min(pruning_epochs, total_epochs))
        recovery_epochs = int(total_epochs - pruning_epochs)
        return int(pruning_epochs), int(recovery_epochs)

    ## @brief Move a batch to the configured device.
    # @param batch dict Batch mapping.
    # @return dict Batch mapping on device.
    def _move_batch_to_device(self, batch: Dict[str, Any]) -> Dict[str, Any]:
        out: Dict[str, Any] = {}
        for k, v in batch.items():
            if torch.is_tensor(v):
                out[str(k)] = v.to(self._device, non_blocking=True)
            else:
                out[str(k)] = v
        return out

    ## @brief Clip gradients if configured.
    # @return None
    def _clip_gradients_if_needed(self) -> None:
        max_norm = float(self.config.training.max_grad_norm)
        if max_norm <= 0.0:
            return
        torch.nn.utils.clip_grad_norm_(self.model.parameters(), max_norm=max_norm)

    ## @brief Get current learning rate (first param group).
    # @return float Learning rate.
    def _get_current_lr(self) -> float:
        if self._optimizer is None:
            return float(self.config.training.learning_rate)
        if not self._optimizer.param_groups:
            return float(self.config.training.learning_rate)
        return float(self._optimizer.param_groups[0].get("lr", float(self.config.training.learning_rate)))

    ## @brief Evaluate on validation data and return metrics.
    # @details
    # Trainer must report task metrics as specified by the paper; metric computation is owned by Evaluator.
    # Here we compute a lightweight validation metric based on task_type and config.evaluation.metrics:
    # - sequence_classification: accuracy
    # - question_answering: F1/EM are typically computed with post-processing; this is handled in evaluator.py,
    #   but Trainer needs periodic selection. We therefore compute loss-only for QA inside Trainer to avoid
    #   incorrect metric substitution.
    # - seq2seq: compute validation loss only (ROUGE requires generation; handled in evaluator.py).
    #
    # For faithful paper metric reporting, final evaluation must be performed by evaluator.py.
    # This periodic evaluation is used only for best-checkpoint selection and TTA, and is constrained:
    # - For GLUE classification, accuracy is computed exactly.
    # - For other tasks, we use negative loss as a monotonic proxy for selection, to avoid fabricating ROUGE/F1.
    # @param stage str Training stage label.
    # @param epoch int Epoch index.
    # @param global_step int Global step.
    # @return dict[str, float] Validation metrics dict containing at least the primary metric key.
    def _evaluate(self, stage: str, epoch: int, global_step: int) -> Dict[str, float]:
        if self._eval_dataloader is None:
            return {}

        self.model.eval()
        task_type = str(self.config.model.task_type)
        primary = self._primary_metric_name()

        total_loss = 0.0
        num_batches = 0

        correct = 0
        total = 0

        with torch.no_grad():
            for batch in self._eval_dataloader:
                batch_on_device = self._move_batch_to_device(batch=batch)
                outputs = self.model(**batch_on_device)

                loss_t = getattr(outputs, "loss", None)
                if torch.is_tensor(loss_t):
                    total_loss += float(loss_t.detach().item())
                    num_batches += 1

                if task_type == "sequence_classification":
                    logits = getattr(outputs, "logits", None)
                    labels = batch_on_device.get("labels", None)
                    if torch.is_tensor(logits) and torch.is_tensor(labels):
                        preds = torch.argmax(logits, dim=-1)
                        correct += int((preds == labels).sum().item())
                        total += int(labels.numel())

        metrics: Dict[str, float] = {}
        if num_batches > 0:
            metrics["eval_loss"] = float(total_loss / float(num_batches))
        else:
            metrics["eval_loss"] = 0.0

        if task_type == "sequence_classification":
            acc = float(correct) / float(max(1, total))
            metrics["accuracy"] = float(acc)
            metrics[primary] = float(acc)
        else:
            # Use negative loss as primary selection metric to avoid inventing task metrics.
            # Final paper metrics are computed in src/eval/evaluator.py.
            metrics[primary] = float(-metrics["eval_loss"])

        log_metrics(metrics=metrics, step=int(global_step), split=f"eval/{stage}", logger=self._logger)
        self.model.train()
        return metrics

    ## @brief Determine primary metric name for best-checkpoint tracking.
    # @details For non-causal tasks, uses the first configured metric; for causal_lm uses 'avg' by convention.
    # @return str Primary metric name.
    def _primary_metric_name(self) -> str:
        if str(self.config.model.task_type) == "causal_lm":
            return "avg"
        if self.config.evaluation.metrics:
            return str(self.config.evaluation.metrics[0])
        return "accuracy"

    ## @brief Read an absolute TTA target threshold from environment, if provided.
    # @details Trainer cannot fabricate FT targets; this optional hook enables exact TTA measurement when supplied.
    # @param primary_metric str Primary metric name.
    # @return Optional[float] Target threshold or None.
    def _read_tta_target_from_env(self, primary_metric: str) -> Optional[float]:
        key = f"TTA_TARGET_{str(primary_metric).upper()}"
        val = os.environ.get(key, "").strip()
        if not val:
            return None
        try:
            thr = float(val)
        except Exception:
            return None
        if math.isnan(thr) or math.isinf(thr):
            return None
        return float(thr)

    ## @brief Build a history record for TrainResult.history.
    # @param stage str Stage label ("pruning" / "recovery").
    # @param epoch int Epoch index.
    # @param global_step int Global optimizer step.
    # @param elapsed_time_s float Elapsed wall time since training start.
    # @param lr float Current learning rate.
    # @param step_output StepOutput Step output.
    # @param pruning_updated bool Whether pruning update was applied at this step.
    # @param rank_updated bool Whether rank update (shape change) was applied at this step.
    # @param step_time_s float Wall time for this step.
    # @return dict[str, Any] History record.
    def _build_history_record(
        self,
        stage: str,
        epoch: int,
        global_step: int,
        elapsed_time_s: float,
        lr: float,
        step_output: StepOutput,
        pruning_updated: bool,
        rank_updated: bool,
        step_time_s: float,
    ) -> Dict[str, Any]:
        rec: Dict[str, Any] = {
            "stage": str(stage),
            "epoch": int(epoch),
            "global_step": int(global_step),
            "elapsed_time_s": float(elapsed_time_s),
            "step_time_s": float(step_time_s),
            "lr": float(lr),
            "loss": float(step_output.loss),
            "task_loss": float(step_output.task_loss),
            "distill_loss": float(step_output.distill_loss),
            "pruning_updated": 1 if bool(pruning_updated) else 0,
            "rank_updated": 1 if bool(rank_updated) else 0,
            "peak_train_memory_mb": float(self._peak_train_memory_mb),
        }
        for k, v in step_output.metrics.items():
            rec[f"m/{str(k)}"] = float(v)

        # Include current target sparsity value for pruning stage.
        if str(stage) == "pruning" and bool(self.config.apt.enable_apt):
            # total pruning steps cannot be reconstructed here without passing it; use schedule at step with
            # a conservative denominator (total steps). This is for logging only; pruning uses the correct value.
            total_steps = self._compute_total_optimizer_steps()
            rec["target_sparsity_gamma_t"] = float(
                self.pruner.target_sparsity_at_step(int(global_step), int(total_steps))
            )
        return rec

    ## @brief Produce introspection metrics about current APT state.
    # @details Computes average adapter rank and tunable parameter counts.
    # @return dict[str, float] APT metrics.
    def _apt_introspection_metrics(self) -> Dict[str, float]:
        reg = self.model.get_registry()
        named = reg.named_modules()
        if not named:
            return {"apt_num_modules": 0.0, "apt_avg_rank": 0.0, "apt_tunable_params": 0.0}

        ranks: List[int] = []
        tunable = 0
        for _, m in named:
            try:
                ranks.append(int(m.current_rank()))
                tunable += int(m.num_tunable_params())
            except Exception:
                continue

        avg_rank = float(sum(ranks) / max(1, len(ranks)))
        return {
            "apt_num_modules": float(len(named)),
            "apt_avg_rank": float(avg_rank),
            "apt_tunable_params": float(tunable),
        }
