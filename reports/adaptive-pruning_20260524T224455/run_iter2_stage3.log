## src/utils/logging.py
from __future__ import annotations

import dataclasses
import json
import logging
import os
import sys
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, Mapping, Optional, Union


_JSONLike = Union[Dict[str, Any], list, str, int, float, bool, None]


## @brief Create or retrieve a configured logger.
# @details Ensures consistent formatting and avoids duplicate handlers across repeated calls.
# @param name str Logger name (typically __name__).
# @param level str Logging level name (e.g., "INFO"). If empty, uses env LOG_LEVEL or "INFO".
# @return logging.Logger Configured logger instance.
def get_logger(name: str, level: str = "") -> logging.Logger:
    logger = logging.getLogger(name)

    # Resolve level with explicit precedence: argument -> env -> default.
    resolved_level_name = (level or os.environ.get("LOG_LEVEL", "INFO")).upper().strip()
    resolved_level = getattr(logging, resolved_level_name, logging.INFO)
    logger.setLevel(resolved_level)
    logger.propagate = False

    # Avoid adding duplicate handlers.
    if any(isinstance(h, logging.StreamHandler) for h in logger.handlers):
        for h in logger.handlers:
            h.setLevel(resolved_level)
        return logger

    stream_handler = logging.StreamHandler(stream=sys.stdout)
    stream_handler.setLevel(resolved_level)
    formatter = logging.Formatter(
        fmt="%(asctime)s | %(levelname)s | %(name)s | %(message)s",
        datefmt="%Y-%m-%d %H:%M:%S",
    )
    stream_handler.setFormatter(formatter)
    logger.addHandler(stream_handler)
    return logger


## @brief Log the experiment configuration in a structured way.
# @details Serializes dataclasses/dicts into JSON and logs it. Call once at startup.
# @param config Any ExperimentConfig-like object (dataclass tree or mapping).
# @param logger Optional[logging.Logger] Logger to use; if None, uses get_logger("config").
# @return None
def log_config(config: Any, logger: Optional[logging.Logger] = None) -> None:
    lg = logger if logger is not None else get_logger("config")
    payload = _to_jsonable(config)

    # Provide stable ordering for readability/diffability.
    config_str = json.dumps(payload, indent=2, sort_keys=True, ensure_ascii=False)
    lg.info("Experiment configuration:\n%s", config_str)


## @brief Log a set of metrics at a given step and split.
# @details Converts tensors/numpy scalars/Paths to JSON-serializable values and prints a stable, compact line.
# @param metrics Mapping[str, Any] Metric dictionary.
# @param step int Global step or epoch indicator.
# @param split str Split name (e.g., "train", "validation", "test", "inference", "lm_eval").
# @param logger Optional[logging.Logger] Logger to use; if None, uses get_logger("metrics").
# @return None
def log_metrics(
    metrics: Mapping[str, Any],
    step: int,
    split: str,
    logger: Optional[logging.Logger] = None,
) -> None:
    lg = logger if logger is not None else get_logger("metrics")

    safe_metrics: Dict[str, Any] = {}
    for k in sorted(metrics.keys()):
        safe_metrics[str(k)] = _to_jsonable(metrics[k])

    # Build a compact key=value list for humans, and keep JSON string for machine parsing.
    compact_parts = []
    for k, v in safe_metrics.items():
        compact_parts.append(f"{k}={_format_metric_value(v)}")
    compact = " ".join(compact_parts)

    lg.info("[%s] step=%s %s", str(split), str(step), compact)


## @brief Save an object as JSON to disk.
# @details Creates parent directories as needed and writes stable, pretty JSON for reproducibility.
# @param path Union[str, Path] Output path for JSON file.
# @param obj Any Object to serialize (dataclass, mapping, list, primitives).
# @param sort_keys bool Whether to sort keys for stable diffs.
# @param indent int JSON indentation level.
# @return str Resolved path of the written JSON file.
def save_json(
    path: Union[str, Path],
    obj: Any,
    sort_keys: bool = True,
    indent: int = 2,
) -> str:
    out_path = Path(path).expanduser().resolve()
    out_path.parent.mkdir(parents=True, exist_ok=True)

    payload = _to_jsonable(obj)
    with out_path.open("w", encoding="utf-8") as f:
        json.dump(payload, f, indent=indent, sort_keys=sort_keys, ensure_ascii=False)
        f.write("\n")
    return str(out_path)


## @brief Convert an arbitrary object into a JSON-serializable structure.
# @details Handles dataclasses, mappings, lists/tuples/sets, Path, datetime, numpy/tensor scalars.
# @param obj Any Input object.
# @param _depth int Recursion depth guard.
# @return _JSONLike JSON-serializable object.
def _to_jsonable(obj: Any, _depth: int = 0) -> _JSONLike:
    if _depth > 50:
        # Prevent pathological recursion; represent as string.
        return str(obj)

    if obj is None:
        return None
    if isinstance(obj, (str, int, float, bool)):
        return obj
    if isinstance(obj, Path):
        return str(obj)
    if isinstance(obj, datetime):
        return obj.isoformat()

    # Dataclasses (e.g., ExperimentConfig and nested config dataclasses).
    if dataclasses.is_dataclass(obj):
        as_dict = dataclasses.asdict(obj)
        return _to_jsonable(as_dict, _depth=_depth + 1)

    # Mappings.
    if isinstance(obj, Mapping):
        out: Dict[str, Any] = {}
        for k, v in obj.items():
            out[str(k)] = _to_jsonable(v, _depth=_depth + 1)
        return out

    # Sequences.
    if isinstance(obj, (list, tuple, set)):
        return [_to_jsonable(v, _depth=_depth + 1) for v in list(obj)]

    # Torch / numpy scalar handling without importing heavy deps at module load time.
    # Try common "item()" protocol for scalar arrays/tensors.
    item = getattr(obj, "item", None)
    if callable(item):
        try:
            val = item()
            if isinstance(val, (str, int, float, bool)) or val is None:
                return val
        except Exception:
            pass

    # Try to convert numpy arrays / tensors with tolist().
    tolist = getattr(obj, "tolist", None)
    if callable(tolist):
        try:
            val = tolist()
            return _to_jsonable(val, _depth=_depth + 1)
        except Exception:
            pass

    # Fallback: string representation.
    return str(obj)


## @brief Format a metric value for compact inline logging.
# @param value Any JSON-like value.
# @return str Formatted value.
def _format_metric_value(value: Any) -> str:
    if value is None:
        return "null"
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, float):
        # Stable short float formatting.
        if abs(value) >= 1e4 or (abs(value) > 0 and abs(value) < 1e-4):
            return f"{value:.6e}"
        return f"{value:.6f}".rstrip("0").rstrip(".")
    if isinstance(value, str):
        return value
    # For dict/list, keep a compact JSON snippet.
    try:
        return json.dumps(value, sort_keys=True, ensure_ascii=False)
    except Exception:
        return str(value)
