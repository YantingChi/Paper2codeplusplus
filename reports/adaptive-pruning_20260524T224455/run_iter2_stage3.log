## src/models/compact_export.py
from __future__ import annotations

import json
import os
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

import torch

from src.models.apt_injector import APTModelWrapper, APTRegistry
from src.models.apt_linear import APTLinear
from src.models.mask_utils import MaskManager


## @brief Internal record describing one axis mask for a group.
# @details Used to build slicing manifests and validate expected shapes.
# @param key str Canonical mask key "{group}:{axis}:{block_type}".
# @param group str Group name.
# @param axis str Axis ("input" or "output").
# @param block_type str Block type ("hidden_dim", "head", "neuron").
# @param size int Mask vector length.
# @param active_indices list[int] Indices where mask==1.
@dataclass(frozen=True)
class _MaskAxisInfo:
    key: str
    group: str
    axis: str
    block_type: str
    size: int
    active_indices: List[int]


## @brief Exporter that materializes an APT model into a merged-and-pruned artifact.
# @details
# This exporter performs the paper-required inference preparation steps:
# 1) Merge APT (LoRA-style) low-rank weights into the frozen base weights per APTLinear.merge_adapter().
# 2) Materialize pruning masks into binary masks using MaskManager.get_binary_masks(threshold=0.5).
# 3) Optionally compute a slicing manifest for structured pruning (heads, neurons, hidden dims) that can
#    be used to rebuild a physically compact model.
#
# The returned payload from build_compact_state_dict() includes:
# - merged model_state_dict (weights after adapter merge, with original shapes preserved)
# - binary_masks (canonical keys -> float32 tensor of 0/1)
# - active_structure (MaskManager.compute_active_structure())
# - registry_state (APTRegistry.state_dict())
# - module_metadata (per APTLinear.collect_structure_metadata())
# - slice_manifest (indices and derived slicing details)
#
# This module does not alter training schedules or compute salience; it is strictly export-time materialization.
class CompactExporter:
    ## @brief Initialize the compact exporter.
    # @param apt_model APTModelWrapper Wrapped model with injected APTLinear modules.
    # @param mask_manager MaskManager Mask manager owning the authoritative pruning masks.
    def __init__(self, apt_model: APTModelWrapper, mask_manager: MaskManager) -> None:
        if not isinstance(apt_model, APTModelWrapper):
            raise TypeError(f"apt_model must be APTModelWrapper, got {type(apt_model)}")
        if not isinstance(mask_manager, MaskManager):
            raise TypeError(f"mask_manager must be MaskManager, got {type(mask_manager)}")

        self._apt_model: APTModelWrapper = apt_model
        self._mask_manager: MaskManager = mask_manager
        self._registry: APTRegistry = apt_model.get_registry()

    ## @brief Build a compact export payload including merged weights and binary masks.
    # @details
    # Merges all APT adapters into base weights (paper: LoRA-style adapters are mergeable after training),
    # then returns a dictionary containing model weights plus pruning metadata. This function preserves
    # original tensor shapes; it does not rebuild a physically compact architecture.
    # @return dict Export payload with tensors and JSON-serializable metadata fields.
    def build_compact_state_dict(self) -> Dict[str, Any]:
        # 1) Get final binary masks and active structure.
        binary_masks = self._mask_manager.get_binary_masks(threshold=0.5)
        active_structure = self._mask_manager.compute_active_structure()

        # 2) Merge all adapters into base weights. This implements:
        #    W <- W + s * (W_B W_A)
        # as in the paper (Equation (2) with LoRA merge after training).
        module_metadata: Dict[str, Dict[str, Any]] = {}
        merged_modules: List[str] = []
        for name, mod in self._apt_model.named_apt_modules():
            module_metadata[str(name)] = mod.collect_structure_metadata()
            # Merge in-place; APTLinear.merge_adapter() ensures idempotence via internal _merged flag.
            mod.merge_adapter()
            merged_modules.append(str(name))

        # 3) Collect merged state dict for the underlying HF model.
        base_model = getattr(self._apt_model, "model", None)
        if base_model is None:
            raise AttributeError("APTModelWrapper must expose the underlying model as attribute 'model'.")
        model_state_dict = base_model.state_dict()

        # 4) Build slicing manifest (indices and derived info).
        slice_manifest = self.slice_weights()

        export_summary = {
            "export_time_utc": datetime.utcnow().isoformat(timespec="seconds") + "Z",
            "adapter_merged": True,
            "physical_slicing_applied": False,
            "compact_model_ready": False,
            "export_type": "merged_masked",
            "num_apt_modules": int(len(merged_modules)),
        }

        payload: Dict[str, Any] = {
            "model_state_dict": model_state_dict,
            "binary_masks": binary_masks,
            "active_structure": active_structure,
            "registry_state": self._registry.state_dict(),
            "module_metadata": module_metadata,
            "slice_manifest": slice_manifest,
            "export_summary": export_summary,
        }
        return payload

    ## @brief Compute a structured slicing manifest for heads/neurons/hidden dims from binary masks.
    # @details
    # This function computes and returns:
    # - canonical mask key -> active indices
    # - group-level aggregated indices by block type
    # - per-APT module mapping to group keys and axis roles (based on registry metadata)
    #
    # It does not physically rewrite the transformer architecture, because doing so requires
    # model-family-specific coordinated slicing across connected modules. Instead, it provides
    # a verifiable manifest needed to rebuild a compact model.
    # @return dict Slicing manifest containing retained indices and per-module/group metadata.
    def slice_weights(self) -> Dict[str, Any]:
        binary_masks = self._mask_manager.get_binary_masks(threshold=0.5)
        active_structure = self._mask_manager.compute_active_structure()
        mask_keys_info = active_structure.get("mask_keys", {})
        if not isinstance(mask_keys_info, dict):
            raise TypeError("active_structure['mask_keys'] must be a dict.")

        axis_infos: List[_MaskAxisInfo] = []
        for key, info in mask_keys_info.items():
            if not isinstance(info, dict):
                continue
            group = str(info.get("group", ""))
            axis = str(info.get("axis", ""))
            block_type = str(info.get("block_type", ""))
            size = int(info.get("size", 0))
            if not group or axis not in {"input", "output"} or size <= 0:
                continue
            if str(key) not in binary_masks:
                raise KeyError(f"Binary masks missing canonical key '{key}' required for slicing manifest.")
            m = binary_masks[str(key)]
            if not torch.is_tensor(m) or m.dim() != 1 or int(m.numel()) != size:
                raise ValueError(
                    f"Binary mask tensor shape mismatch for key '{key}': "
                    f"expected [{size}], got {tuple(m.shape) if torch.is_tensor(m) else type(m)}"
                )
            active_idx = torch.nonzero(m > 0.0, as_tuple=False).reshape(-1).tolist()
            axis_infos.append(
                _MaskAxisInfo(
                    key=str(key),
                    group=group,
                    axis=axis,
                    block_type=block_type,
                    size=size,
                    active_indices=[int(i) for i in active_idx],
                )
            )

        # Aggregate by group and block type.
        by_group: Dict[str, Dict[str, Dict[str, Any]]] = {}
        for ai in axis_infos:
            by_group.setdefault(ai.group, {})
            by_group[ai.group].setdefault(ai.block_type, {})
            by_group[ai.group][ai.block_type][ai.axis] = {
                "mask_key": ai.key,
                "size": int(ai.size),
                "active_indices": list(ai.active_indices),
                "active_count": int(len(ai.active_indices)),
            }

        # Extract global hidden-dim indices if present (hidden_dim is shared; take max-cardinality across groups).
        global_hidden_dim: Dict[str, Any] = {"active_indices": [], "active_count": 0, "mask_keys": []}
        hidden_dim_candidates: List[Tuple[int, str, List[int]]] = []
        for ai in axis_infos:
            if ai.block_type == "hidden_dim":
                hidden_dim_candidates.append((len(ai.active_indices), ai.key, ai.active_indices))
        if hidden_dim_candidates:
            hidden_dim_candidates.sort(key=lambda x: (-int(x[0]), str(x[1])))
            best = hidden_dim_candidates[0]
            global_hidden_dim["active_indices"] = list(best[2])
            global_hidden_dim["active_count"] = int(best[0])
            global_hidden_dim["mask_keys"] = [str(k) for _, k, _ in hidden_dim_candidates]

        # Per-module mapping information to support downstream compaction.
        per_module: Dict[str, Dict[str, Any]] = {}
        for module_name, module in self._apt_model.named_apt_modules():
            name = str(module_name)
            meta = self._registry.get_metadata(name)
            group = str(meta.get("group", getattr(module, "group_name", "")) or "")
            input_block_type = str(meta.get("input_block_type", "hidden_dim"))
            output_block_type = str(meta.get("output_block_type", "hidden_dim"))

            # Canonical keys as used by MaskManager.
            in_key = f"{group}:input:{input_block_type}"
            out_key = f"{group}:output:{output_block_type}"

            in_active = None
            out_active = None
            if in_key in binary_masks:
                in_active = torch.nonzero(binary_masks[in_key] > 0.0, as_tuple=False).reshape(-1).tolist()
            if out_key in binary_masks:
                out_active = torch.nonzero(binary_masks[out_key] > 0.0, as_tuple=False).reshape(-1).tolist()

            per_module[name] = {
                "group": group,
                "input_mask_key": in_key,
                "output_mask_key": out_key,
                "input_block_type": input_block_type,
                "output_block_type": output_block_type,
                "input_active_indices": None if in_active is None else [int(i) for i in in_active],
                "output_active_indices": None if out_active is None else [int(i) for i in out_active],
                "module_structure": module.collect_structure_metadata(),
            }

        manifest: Dict[str, Any] = {
            "binary_mask_threshold": 0.5,
            "global_hidden_dim": global_hidden_dim,
            "by_group": by_group,
            "per_module": per_module,
            "applied_slicing": {"heads": False, "neurons": False, "hidden_dims": False},
            "notes": [
                "This manifest is computed from final binary masks (threshold=0.5) and is sufficient to "
                "rebuild a physically compact model with coordinated structural slicing. "
                "This exporter does not rebuild the transformer graph; it exports merged weights and a "
                "verifiable pruning manifest consistent with APT structured pruning semantics."
            ],
        }
        return manifest

    ## @brief Save the merged model state dict, masks, and export metadata to disk.
    # @details
    # Produces a deterministic artifact directory:
    # - compact_export.pt: torch-saved payload (tensors + metadata)
    # - model_state_dict.pt: torch-saved merged model weights only
    # - binary_masks.pt: torch-saved binary mask tensors
    # - export_metadata.json: JSON metadata (non-tensor)
    #
    # @param output_dir str Output directory to write artifacts.
    # @return str Path to the main export artifact file (compact_export.pt).
    def save(self, output_dir: str) -> str:
        out_dir = Path(str(output_dir)).expanduser().resolve()
        out_dir.mkdir(parents=True, exist_ok=True)

        payload = self.build_compact_state_dict()

        # Split tensor vs JSON metadata for readability and tool compatibility.
        model_state = payload["model_state_dict"]
        binary_masks = payload["binary_masks"]

        # Save core tensor artifacts.
        main_path = out_dir / "compact_export.pt"
        torch.save(payload, str(main_path))
        torch.save(model_state, str(out_dir / "model_state_dict.pt"))
        torch.save(binary_masks, str(out_dir / "binary_masks.pt"))

        # Save JSON metadata (convert tensors to lists where needed).
        json_meta = {
            "export_summary": payload.get("export_summary", {}),
            "active_structure": payload.get("active_structure", {}),
            "registry_state": payload.get("registry_state", {}),
            "module_metadata": payload.get("module_metadata", {}),
            "slice_manifest": payload.get("slice_manifest", {}),
            "binary_masks": {k: v.detach().cpu().tolist() for k, v in binary_masks.items()},
        }
        meta_path = out_dir / "export_metadata.json"
        with meta_path.open("w", encoding="utf-8") as f:
            json.dump(json_meta, f, indent=2, sort_keys=True, ensure_ascii=False)
            f.write("\n")

        return str(main_path)
