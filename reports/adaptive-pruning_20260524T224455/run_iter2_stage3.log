## configs/t5_cnndm_apt.yaml
# @brief Task-specific override config for APT on T5 for CNN/DailyMail summarization.
# @details
#   Paper-faithful settings for the CNN/DM experiment:
#   - Backbone: t5-lm-adapt (recommended in the paper for fair comparison).
#   - Task: seq2seq summarization (article -> highlights).
#   - Metrics: ROUGE-1/2/L.
#   - Training hyperparameters copied from config.yaml:
#       lr=1e-4, batch_size=16, epochs=16, distill_epochs=6.
#   - APT settings copied from config.yaml:
#       initial_rank=8, scaling_factor=2 (mapped to lora_alpha),
#       cubic sparsity schedule, gradual mask update alpha=0.01,
#       adaptive pruning blocks (heads, neurons, hidden dims),
#       adaptive tuning for top-half salient adapters,
#       self-distillation enabled for small models.
#
#   NOTE on unspecified items: EMA beta for salience, optimizer/scheduler, warmup, weight decay,
#   max lengths, and decoding parameters are not specified in config.yaml; they should be inherited
#   from configs/default.yaml to keep assumptions centralized.

model:
  backbone_name: "t5-lm-adapt"
  task_type: "seq2seq"
  max_length: 512
  num_labels: 0
  use_ffn_adapters: true
  trust_remote_code: false

data:
  dataset_name: "cnn_dailymail"
  dataset_config_name: "3.0.0"
  train_split: "train"
  validation_split: "validation"
  text_fields: ["article"]
  label_field: "highlights"
  max_source_length: 512
  max_target_length: 128
  batch_size: 16
  # Paper specifies inference batch size 128 for small models; we align eval batch size here.
  eval_batch_size: 128

training:
  learning_rate: 1.0e-4
  weight_decay: 0.0
  num_epochs: 16
  distill_epochs: 6
  gradient_accumulation_steps: 1
  warmup_ratio: 0.0
  max_grad_norm: 1.0
  optimizer_name: "adamw"
  lr_scheduler_type: "linear"
  fp16: true
  bf16: false
  eval_every_steps: 500
  save_every_steps: 500
  seed: 42

apt:
  enable_apt: true
  # Paper reports T5 pruning comparisons under 60% sparsity.
  target_sparsity: 0.60
  initial_rank: 8
  # config.yaml: scaling_factor = 2; in our schema this maps to LoRA alpha.
  lora_alpha: 2.0
  # config.yaml: gradual mask update alpha=0.01.
  mask_update_step: 0.01
  # EMA beta value is not specified in config.yaml; inherit from default.yaml.
  salience_ema_beta: 0.95
  # Pruning is performed in early training; leave ratio to default behavior unless overridden.
  pruning_stage_ratio: 0.375
  # Update intervals are implementation-level and should be inherited; provide safe defaults.
  rank_update_interval: 50
  prune_update_interval: 50
  rank_growth_mode: "top_half_salient_adapters"
  use_kurtosis: true
  use_self_distill: true
  distill_mu_schedule: "linear_0_to_1"
  teacher_share_frozen: true
  # For small models, APT targets query/value and FFN layers (including encoder, decoder self-attn,
  # and decoder cross-attn for T5).
  apply_on_modules:
    - "attention_query"
    - "attention_value"
    - "ffn_layers"

evaluation:
  metrics: ["rouge1", "rouge2", "rougel"]
  measure_train_peak_memory: true
  measure_inference_peak_memory: true
  measure_throughput: true
  lm_eval_tasks: []
  lm_eval_num_fewshot: {}

runtime:
  output_dir: "outputs/t5_cnndm_apt"
  device: "cuda"
  num_workers: 4
  pin_memory: true
  compile_model: false
  gradient_checkpointing: true
  log_level: "INFO"
