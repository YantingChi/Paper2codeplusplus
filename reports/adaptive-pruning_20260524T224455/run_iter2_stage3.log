## src/data/collators.py
from __future__ import annotations

from typing import Any, Callable, Dict, List, Mapping, Optional, Sequence, Union

import torch
from transformers import DataCollatorForSeq2Seq, DataCollatorWithPadding, PreTrainedTokenizerBase

from src.config import DataConfig, ModelConfig


## @brief Build a data collator appropriate for the experiment task type.
# @details
# This is a thin, library-backed factory consistent with the paper's experimental setups:
# - sequence_classification (GLUE): dynamic padding via DataCollatorWithPadding
# - question_answering (SQuAD v2): dynamic padding via DataCollatorWithPadding
# - seq2seq (T5 for CNN/DM and GLUE-as-generation): DataCollatorForSeq2Seq
# - causal_lm (LLaMA Alpaca SFT): custom collator that pads and creates/preserves labels
#
# For causal LM:
# - If examples already provide `labels`, we pad them with ignore_index=-100.
# - Else we create labels by copying input_ids and masking pad_token_id positions to -100.
#
# Tokenizer pad_token_id must be configured upstream for causal LM; this function will raise otherwise.
# @param tokenizer Any Hugging Face tokenizer.
# @param model_config ModelConfig Model configuration.
# @param data_config DataConfig Data configuration.
# @param model Optional[Any] Optional model; used by DataCollatorForSeq2Seq for decoder input preparation.
# @return Any A collator callable compatible with torch DataLoader.
def build_data_collator(
    tokenizer: Any,
    model_config: ModelConfig,
    data_config: DataConfig,
    model: Optional[Any] = None,
) -> Any:
    _ = data_config  # collators are independent of batch_size (used by DataLoader), keep signature per design.
    task_type = str(model_config.task_type)

    if task_type == "sequence_classification":
        return build_classification_collator(tokenizer=tokenizer)

    if task_type == "question_answering":
        return build_qa_collator(tokenizer=tokenizer)

    if task_type == "seq2seq":
        return build_seq2seq_collator(tokenizer=tokenizer, model=model)

    if task_type == "causal_lm":
        return build_causal_lm_collator(tokenizer=tokenizer)

    raise ValueError(
        "Unsupported model.task_type for collator. "
        "Expected one of {'sequence_classification','question_answering','seq2seq','causal_lm'}, "
        f"got '{task_type}'."
    )


## @brief Build a classification collator with dynamic padding.
# @param tokenizer Any Hugging Face tokenizer.
# @return Any transformers.DataCollatorWithPadding instance.
def build_classification_collator(tokenizer: Any) -> Any:
    return DataCollatorWithPadding(tokenizer=tokenizer)


## @brief Build a QA collator with dynamic padding.
# @details
# This collator does not modify QA labels/metadata; it only pads tensorizable fields.
# @param tokenizer Any Hugging Face tokenizer.
# @return Any transformers.DataCollatorWithPadding instance.
def build_qa_collator(tokenizer: Any) -> Any:
    return DataCollatorWithPadding(tokenizer=tokenizer)


## @brief Build a seq2seq collator for encoder-decoder models.
# @details
# Uses DataCollatorForSeq2Seq to ensure labels are padded with ignore_index=-100 and to optionally
# prepare decoder_input_ids using the model.
# @param tokenizer Any Hugging Face tokenizer.
# @param model Optional[Any] Optional seq2seq model for decoder input preparation.
# @return Any transformers.DataCollatorForSeq2Seq instance.
def build_seq2seq_collator(tokenizer: Any, model: Optional[Any] = None) -> Any:
    return DataCollatorForSeq2Seq(tokenizer=tokenizer, model=model)


## @brief Build a causal LM collator for instruction tuning / SFT.
# @details
# Pads a batch using tokenizer.pad and ensures "labels" is present:
# - If provided in features, it is padded using -100 for padding.
# - If absent, labels are created as a copy of input_ids and padding positions are masked to -100.
#
# This behavior matches standard causal LM SFT expectations and is consistent with the paper, which
# does not specify custom collation behavior beyond standard Hugging Face pipelines.
# @param tokenizer Any Hugging Face tokenizer (must have pad_token_id for causal_lm).
# @param ignore_index int Label ignore index used by transformers loss (default: -100).
# @return Callable A collator function mapping list[features] -> batch dict of tensors.
def build_causal_lm_collator(
    tokenizer: Any,
    ignore_index: int = -100,
) -> Callable[[List[Dict[str, Any]]], Dict[str, torch.Tensor]]:
    if not hasattr(tokenizer, "pad"):
        raise TypeError("tokenizer must have a .pad(...) method for causal LM collation.")

    pad_token_id = getattr(tokenizer, "pad_token_id", None)
    if pad_token_id is None:
        raise ValueError(
            "Tokenizer pad_token_id is None. For causal LM training (e.g., LLaMA), "
            "configure a pad token upstream (commonly set pad_token=eos_token)."
        )

    ## @brief Collate a batch for causal LM.
    # @param features list[dict[str, Any]] Individual feature dicts produced by preprocessing.
    # @return dict[str, torch.Tensor] Padded batch tensors with labels.
    def _collate(features: List[Dict[str, Any]]) -> Dict[str, torch.Tensor]:
        if not isinstance(features, list) or len(features) == 0:
            raise ValueError("Causal LM collator received an empty features list.")

        has_labels = all(isinstance(f, Mapping) and ("labels" in f) for f in features)

        # Separate labels if present to allow tokenizer.pad to work on model input keys.
        labels_list: Optional[List[List[int]]] = None
        input_features: List[Dict[str, Any]] = []
        if has_labels:
            labels_list = []
            for f in features:
                lbl = f["labels"]
                if isinstance(lbl, torch.Tensor):
                    lbl = lbl.tolist()
                if not isinstance(lbl, list):
                    raise TypeError(f"Feature 'labels' must be list[int] or tensor, got {type(lbl)}")
                labels_list.append([int(x) for x in lbl])

                f_no_labels = dict(f)
                f_no_labels.pop("labels", None)
                input_features.append(f_no_labels)
        else:
            input_features = [dict(f) for f in features]

        # Use tokenizer.pad for standard keys (input_ids, attention_mask, etc.).
        # return_tensors="pt" ensures a tensor batch for training.
        padded: Dict[str, torch.Tensor] = tokenizer.pad(
            input_features,
            padding=True,
            return_tensors="pt",
        )

        if "input_ids" not in padded:
            raise KeyError("Causal LM collator expects 'input_ids' after tokenizer.pad().")

        input_ids: torch.Tensor = padded["input_ids"]
        if input_ids.dim() != 2:
            raise ValueError(f"Expected input_ids to be 2D [batch, seq], got shape {tuple(input_ids.shape)}")

        if has_labels:
            labels_tensor = _pad_labels_to_match_input_ids(
                labels=labels_list if labels_list is not None else [],
                target_seq_len=int(input_ids.shape[1]),
                ignore_index=int(ignore_index),
                device=input_ids.device,
            )
        else:
            labels_tensor = input_ids.clone()
            labels_tensor = labels_tensor.masked_fill(labels_tensor == int(pad_token_id), int(ignore_index))

        padded["labels"] = labels_tensor
        return padded

    return _collate


## @brief Pad per-example label sequences to match target sequence length.
# @details Pads with ignore_index to the right.
# @param labels list[list[int]] Unpadded label sequences.
# @param target_seq_len int Target sequence length after input padding.
# @param ignore_index int Ignore index for padded positions.
# @param device torch.device Device for the returned tensor.
# @return torch.Tensor Padded label tensor of shape [batch, target_seq_len].
def _pad_labels_to_match_input_ids(
    labels: List[List[int]],
    target_seq_len: int,
    ignore_index: int,
    device: torch.device,
) -> torch.Tensor:
    if target_seq_len <= 0:
        raise ValueError("target_seq_len must be > 0.")
    if len(labels) == 0:
        raise ValueError("labels must be non-empty when padding provided labels.")

    batch_size = int(len(labels))
    out = torch.full(
        (batch_size, int(target_seq_len)),
        fill_value=int(ignore_index),
        dtype=torch.long,
        device=device,
    )

    for i, seq in enumerate(labels):
        # Truncate if a label sequence is longer than target length (can happen due to upstream truncation mismatch).
        n = min(int(len(seq)), int(target_seq_len))
        if n > 0:
            out[i, :n] = torch.tensor(seq[:n], dtype=torch.long, device=device)

    return out
