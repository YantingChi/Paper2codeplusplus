## src/models/mask_utils.py
from __future__ import annotations

from dataclasses import dataclass
from typing import Any, Dict, List, Mapping, Optional, Set, Tuple

import torch

from src.models.apt_injector import APTRegistry
from src.models.apt_linear import APTLinear


@dataclass(frozen=True)
class _GroupAxisSpec:
    ## @brief One-line description.
    # @param group_name str Group name from APTRegistry.
    # @param axis str Axis name: 'input' or 'output'.
    # @param block_type str Block type: 'hidden_dim', 'head', or 'neuron'.
    # @param size int Length of the axis mask vector.
    group_name: str
    axis: str
    block_type: str
    size: int


## @brief Mask manager for APT structured pruning.
# @details
# Owns and updates the pruning masks used by APTLinear modules according to the paper's gradual
# mask update rule (Appendix C):
#   retained: m <- min(1, m + alpha)
#   pruned:   m <- max(0, m - alpha)
#
# This class treats masks as soft float tensors in [0, 1] during training. Binary masks are produced
# only for exporting/compaction and for active-structure introspection.
#
# Key convention for apply_mask_updates(retain_ids, alpha):
# - retain_ids maps GROUP KEY -> list[int] of retained indices for that group/axis.
# - Supported group keys:
#   1) "{group_name}:{axis}:{block_type}" (canonical, recommended)
#   2) "{group_name}:{axis}" (block_type inferred; only if unambiguous)
#   3) "{group_name}" (applied to all axes in the group; only if group has exactly one axis spec)
#
# Group-wise propagation:
# - Updates are applied to a canonical per-group mask and then propagated to all member modules
#   that share that group and axis role. This enforces structured consistency across modules.
class MaskManager:
    ## @brief Initialize MaskManager.
    # @param registry APTRegistry Registry containing all injected APT modules and their metadata.
    def __init__(self, registry: APTRegistry) -> None:
        if not isinstance(registry, APTRegistry):
            raise TypeError(f"registry must be APTRegistry, got {type(registry)}")
        self._registry: APTRegistry = registry

        # Canonical mask storage: key = "{group}:{axis}:{block_type}" -> tensor[size]
        self._group_masks: Dict[str, torch.Tensor] = {}

        # Group axis specs in deterministic order for propagation.
        self._axis_specs: List[_GroupAxisSpec] = []

        # Reverse mapping: group_name -> list[axis_spec_key]
        self._group_to_keys: Dict[str, List[str]] = {}

        # Module mapping: group_name -> list[(module_name, module)]
        self._group_to_modules: Dict[str, List[Tuple[str, APTLinear]]] = {}

        self._initialized: bool = False

    ## @brief Initialize all masks to dense (ones) and apply to APT modules.
    # @details
    # APT starts pruning from the dense pretrained model, so masks are initialized to all ones
    # for every prunable axis implied by registry metadata.
    # @return None
    def initialize_masks(self) -> None:
        self._build_group_mappings()
        self._build_axis_specs_and_allocate()

        # Push the initialized masks into every module.
        self._propagate_all_masks_to_modules()
        self._initialized = True

    ## @brief Apply a gradual mask update from a retain-set decision.
    # @details
    # Implements the paper's gradual update rule:
    #  - retained: min(1, m + alpha)
    #  - pruned:   max(0, m - alpha)
    #
    # retain_ids keys should follow the group-key conventions documented in the class docstring.
    # Any group/axis not present in retain_ids is left unchanged (safer and consistent with periodic updates).
    # @param retain_ids dict[str, list[int]] Mapping from group key to retained indices.
    # @param alpha float Step size for mask updates (paper/config.yaml: 0.01).
    # @return None
    def apply_mask_updates(self, retain_ids: Dict[str, List[int]], alpha: float) -> None:
        if not self._initialized:
            raise RuntimeError("MaskManager must be initialized by calling initialize_masks() before updates.")
        if not isinstance(retain_ids, dict):
            raise TypeError(f"retain_ids must be dict[str, list[int]], got {type(retain_ids)}")
        step = float(alpha)
        if step <= 0.0:
            raise ValueError("alpha must be > 0.")
        # Paper uses gradual updates towards 0/1, so masks must remain within [0, 1].
        if step > 1.0:
            raise ValueError("alpha is unexpectedly > 1; masks are defined in [0,1].")

        # Resolve retain_ids into canonical keys -> retained set.
        resolved: Dict[str, Set[int]] = self._resolve_retain_ids(retain_ids=retain_ids)

        # Apply updates only for keys present in resolved; leave others unchanged.
        updated_any = False
        for key, retained in resolved.items():
            if key not in self._group_masks:
                raise KeyError(
                    f"retain_ids refers to unknown mask key '{key}'. "
                    "Expected one of: " + ", ".join(sorted(self._group_masks.keys()))
                )

            mask = self._group_masks[key]
            size = int(mask.numel())
            self._validate_indices(indices=retained, size=size, key=key)

            # Build boolean selector for retained indices.
            sel = torch.zeros((size,), device=mask.device, dtype=torch.bool)
            if len(retained) > 0:
                idx = torch.tensor(sorted(retained), device=mask.device, dtype=torch.long)
                sel[idx] = True

            # Update rule:
            # retained: min(1, m + alpha)
            # pruned:   max(0, m - alpha)
            with torch.no_grad():
                inc = torch.full_like(mask, fill_value=step)
                dec = torch.full_like(mask, fill_value=step)

                mask = torch.where(sel, torch.minimum(mask + inc, torch.ones_like(mask)), mask)
                mask = torch.where(~sel, torch.maximum(mask - dec, torch.zeros_like(mask)), mask)

                # Hard clamp for numerical safety.
                mask.clamp_(0.0, 1.0)

                self._group_masks[key] = mask
                updated_any = True

        if updated_any:
            self._propagate_updated_masks_to_modules(updated_keys=set(resolved.keys()))

    ## @brief Return binary masks for export/compaction.
    # @details
    # Converts the current soft masks to 0/1 by thresholding. Returned dict uses flat namespacing:
    #  - "{group}:{axis}:{block_type}" -> binary tensor
    # This fits the declared return type dict[str, Tensor] and provides stable keys for exporters.
    # @param threshold float Threshold in [0,1] (default: 0.5).
    # @return dict[str, torch.Tensor] Mapping from mask key to binary tensor.
    def get_binary_masks(self, threshold: float = 0.5) -> Dict[str, torch.Tensor]:
        if not self._initialized:
            raise RuntimeError("MaskManager must be initialized by calling initialize_masks() before reading masks.")
        thr = float(threshold)
        if not (0.0 <= thr <= 1.0):
            raise ValueError("threshold must be in [0,1].")

        out: Dict[str, torch.Tensor] = {}
        for k, m in self._group_masks.items():
            out[k] = (m >= thr).to(dtype=torch.float32)
        return out

    ## @brief Compute active structure summary under current masks.
    # @details
    # Uses binary masks with threshold=0.5 to compute integer active counts by block type and group.
    # Returns a dictionary suitable for parameter counting in pruning.py:
    # {
    #   "by_group": {
    #       group_name: {"hidden_dim": int|None, "head": int|None, "neuron": int|None}
    #   },
    #   "totals": {"hidden_dim": int|None, "head": int, "neuron": int},
    #   "mask_keys": {mask_key: {"active": int, "size": int, "axis": str, "block_type": str, "group": str}}
    # }
    # Notes:
    # - hidden_dim is reported as a max across groups (it is globally shared in typical transformers),
    #   but we also report per-group hidden_dim counts when available.
    # @return dict Summary dictionary.
    def compute_active_structure(self) -> Dict[str, Any]:
        if not self._initialized:
            raise RuntimeError("MaskManager must be initialized by calling initialize_masks() before introspection.")

        bin_masks = self.get_binary_masks(threshold=0.5)

        by_group: Dict[str, Dict[str, Optional[int]]] = {}
        mask_keys_info: Dict[str, Dict[str, Any]] = {}

        hidden_dim_global: Optional[int] = None
        head_total: int = 0
        neuron_total: int = 0

        for spec in self._axis_specs:
            key = self._axis_key(group_name=spec.group_name, axis=spec.axis, block_type=spec.block_type)
            m = bin_masks[key]
            active = int(torch.count_nonzero(m > 0.0).item())
            size = int(m.numel())

            by_group.setdefault(spec.group_name, {"hidden_dim": None, "head": None, "neuron": None})
            prev_val = by_group[spec.group_name].get(spec.block_type, None)

            # If multiple keys of the same block_type exist in a group, keep the max (should not happen normally).
            if prev_val is None:
                by_group[spec.group_name][spec.block_type] = active
            else:
                by_group[spec.group_name][spec.block_type] = max(int(prev_val), active)

            if spec.block_type == "hidden_dim":
                hidden_dim_global = active if hidden_dim_global is None else max(hidden_dim_global, active)
            elif spec.block_type == "head":
                head_total += active
            elif spec.block_type == "neuron":
                neuron_total += active

            mask_keys_info[key] = {
                "group": spec.group_name,
                "axis": spec.axis,
                "block_type": spec.block_type,
                "active": active,
                "size": size,
            }

        totals: Dict[str, Any] = {
            "hidden_dim": hidden_dim_global,
            "head": int(head_total),
            "neuron": int(neuron_total),
        }

        return {"by_group": by_group, "totals": totals, "mask_keys": mask_keys_info}

    ## @brief Build mappings from registry (group -> modules).
    # @details Private helper invoked at initialization to support group-wise propagation.
    # @return None
    def _build_group_mappings(self) -> None:
        self._group_to_modules.clear()
        for module_name, module in self._registry.named_modules():
            meta = self._registry.get_metadata(module_name)
            group = str(meta.get("group", ""))
            if not group:
                # Fall back to module.group_name if registry metadata lacks it.
                group = str(getattr(module, "group_name", "")) or "unknown"
            self._group_to_modules.setdefault(group, []).append((module_name, module))

        # Ensure deterministic ordering for repeatable behavior.
        for grp in list(self._group_to_modules.keys()):
            self._group_to_modules[grp] = sorted(self._group_to_modules[grp], key=lambda x: x[0])

    ## @brief Build axis specs per group and allocate canonical masks.
    # @details Private helper invoked at initialization.
    # @return None
    def _build_axis_specs_and_allocate(self) -> None:
        self._axis_specs.clear()
        self._group_masks.clear()
        self._group_to_keys.clear()

        # We derive required axes from each module's metadata:
        # - input_block_type is always present (defaulted by injector to 'hidden_dim')
        # - output_block_type is role-dependent ('head', 'neuron', or 'hidden_dim')
        for group_name, modules in sorted(self._group_to_modules.items(), key=lambda kv: kv[0]):
            # Aggregate axis definitions across modules in the group.
            input_sizes: Set[int] = set()
            output_sizes: Set[int] = set()
            input_block_types: Set[str] = set()
            output_block_types: Set[str] = set()

            for module_name, module in modules:
                meta = self._registry.get_metadata(module_name)
                ibt = str(meta.get("input_block_type", "hidden_dim"))
                obt = str(meta.get("output_block_type", "hidden_dim"))
                input_block_types.add(ibt)
                output_block_types.add(obt)

                input_sizes.add(int(getattr(module, "in_features", int(meta.get("in_features", 0)))))
                output_sizes.add(int(getattr(module, "out_features", int(meta.get("out_features", 0)))))

            # For consistent propagation, each group/axis should have a single size and block_type.
            # If multiple exist (rare), we refuse to proceed to avoid inconsistent masks.
            if len(input_sizes) != 1:
                raise ValueError(f"Inconsistent input sizes in group '{group_name}': {sorted(input_sizes)}")
            if len(output_sizes) != 1:
                raise ValueError(f"Inconsistent output sizes in group '{group_name}': {sorted(output_sizes)}")
            if len(input_block_types) != 1:
                raise ValueError(
                    f"Inconsistent input_block_type in group '{group_name}': {sorted(input_block_types)}"
                )
            if len(output_block_types) != 1:
                raise ValueError(
                    f"Inconsistent output_block_type in group '{group_name}': {sorted(output_block_types)}"
                )

            in_size = int(next(iter(input_sizes)))
            out_size = int(next(iter(output_sizes)))
            in_bt = str(next(iter(input_block_types)))
            out_bt = str(next(iter(output_block_types)))

            if in_size <= 0 or out_size <= 0:
                raise ValueError(f"Invalid axis sizes in group '{group_name}': in={in_size}, out={out_size}")

            # Allocate canonical masks as float tensors in [0,1], initialized to ones.
            # Use module dtype/device for stability; take the first module.
            _, first_mod = modules[0]
            dtype = first_mod.base_linear.weight.dtype
            device = first_mod.base_linear.weight.device

            # Input axis
            in_key = self._axis_key(group_name=group_name, axis="input", block_type=in_bt)
            self._group_masks[in_key] = torch.ones((in_size,), device=device, dtype=dtype)
            self._axis_specs.append(_GroupAxisSpec(group_name=group_name, axis="input", block_type=in_bt, size=in_size))
            self._group_to_keys.setdefault(group_name, []).append(in_key)

            # Output axis
            out_key = self._axis_key(group_name=group_name, axis="output", block_type=out_bt)
            self._group_masks[out_key] = torch.ones((out_size,), device=device, dtype=dtype)
            self._axis_specs.append(
                _GroupAxisSpec(group_name=group_name, axis="output", block_type=out_bt, size=out_size)
            )
            self._group_to_keys.setdefault(group_name, []).append(out_key)

        # Deterministic axis spec ordering.
        self._axis_specs = sorted(self._axis_specs, key=lambda s: (s.group_name, s.axis, s.block_type))

    ## @brief Propagate all canonical masks to all modules.
    # @return None
    def _propagate_all_masks_to_modules(self) -> None:
        all_keys = set(self._group_masks.keys())
        self._propagate_updated_masks_to_modules(updated_keys=all_keys)

    ## @brief Propagate updated canonical masks to corresponding APT modules.
    # @details Applies group-wise masks to each module using set_input_mask / set_output_mask.
    # @param updated_keys set[str] Set of canonical mask keys that were updated.
    # @return None
    def _propagate_updated_masks_to_modules(self, updated_keys: Set[str]) -> None:
        # For each updated key, apply to all modules in that group/axis.
        # We always copy to avoid module-side in-place surprises; APTLinear stores internal buffers.
        by_group_axis: Dict[Tuple[str, str, str], torch.Tensor] = {}
        for k in updated_keys:
            group, axis, block_type = self._parse_axis_key(k)
            by_group_axis[(group, axis, block_type)] = self._group_masks[k]

        for (group, axis, block_type), mask in by_group_axis.items():
            if group not in self._group_to_modules:
                continue

            for _, module in self._group_to_modules[group]:
                meta = module.collect_structure_metadata()
                if axis == "input":
                    expected_bt = str(meta.get("input_block_type", "hidden_dim"))
                    if expected_bt != block_type:
                        # Do not apply mismatched semantics.
                        continue
                    module.set_input_mask(mask.detach().clone())
                elif axis == "output":
                    expected_bt = str(meta.get("output_block_type", "hidden_dim"))
                    if expected_bt != block_type:
                        continue
                    module.set_output_mask(mask.detach().clone())
                else:
                    raise ValueError(f"Unexpected axis '{axis}' in mask key '{group}:{axis}:{block_type}'")

    ## @brief Resolve retain_ids mapping into canonical mask keys.
    # @details Supports flexible input key formats, but always returns canonical keys.
    # @param retain_ids dict[str, list[int]] User-provided mapping.
    # @return dict[str, set[int]] Canonical key -> retained index set.
    def _resolve_retain_ids(self, retain_ids: Dict[str, List[int]]) -> Dict[str, Set[int]]:
        resolved: Dict[str, Set[int]] = {}

        # Build helper maps for inference/validation.
        canonical_keys = set(self._group_masks.keys())
        group_names = set(self._group_to_modules.keys())

        for raw_key, raw_indices in retain_ids.items():
            key = str(raw_key)
            if not isinstance(raw_indices, list):
                raise TypeError(f"retain_ids['{key}'] must be a list[int], got {type(raw_indices)}")

            indices_set: Set[int] = set(int(i) for i in raw_indices)

            # Case 1: already canonical.
            if key in canonical_keys:
                resolved[key] = indices_set
                continue

            parts = key.split(":")
            if len(parts) == 3:
                # Not canonical but looks like it; canonical form uses same pattern.
                cand = key
                if cand not in canonical_keys:
                    raise KeyError(f"Unknown canonical-like key '{key}'.")
                resolved[cand] = indices_set
                continue

            if len(parts) == 2:
                # "{group}:{axis}" -> infer unique canonical key by group+axis if unambiguous.
                group = parts[0]
                axis = parts[1]
                if group not in group_names:
                    raise KeyError(f"Unknown group '{group}' in retain_ids key '{key}'.")
                if axis not in {"input", "output"}:
                    raise ValueError(f"Invalid axis '{axis}' in retain_ids key '{key}'.")
                cands = [k for k in self._group_to_keys.get(group, []) if self._parse_axis_key(k)[1] == axis]
                if len(cands) != 1:
                    raise ValueError(
                        f"Ambiguous mapping for key '{key}'. Candidate keys: {cands}. "
                        "Use canonical '{group}:{axis}:{block_type}'."
                    )
                resolved[cands[0]] = indices_set
                continue

            if len(parts) == 1:
                # "{group}" -> apply only if group has exactly one axis spec key (rare in this codebase,
                # but included for completeness); otherwise ambiguous.
                group = parts[0]
                if group not in group_names:
                    raise KeyError(f"Unknown group '{group}' in retain_ids key '{key}'.")
                cands = list(self._group_to_keys.get(group, []))
                if len(cands) != 1:
                    raise ValueError(
                        f"Ambiguous group-only key '{key}' with {len(cands)} axes. "
                        "Use canonical '{group}:{axis}:{block_type}'."
                    )
                resolved[cands[0]] = indices_set
                continue

            raise ValueError(
                f"Invalid retain_ids key format '{key}'. Expected one of: "
                "'{group}:{axis}:{block_type}', '{group}:{axis}', '{group}'."
            )

        return resolved

    ## @brief Validate indices are within mask bounds.
    # @param indices set[int] Indices to validate.
    # @param size int Mask size.
    # @param key str Canonical mask key for error reporting.
    # @return None
    def _validate_indices(self, indices: Set[int], size: int, key: str) -> None:
        if size <= 0:
            raise ValueError(f"Mask size must be positive for key '{key}', got {size}")
        if not indices:
            return
        min_i = min(indices)
        max_i = max(indices)
        if min_i < 0 or max_i >= size:
            raise IndexError(
                f"retain_ids for key '{key}' contains out-of-bounds indices "
                f"(min={min_i}, max={max_i}, size={size})."
            )

    ## @brief Build canonical axis key.
    # @param group_name str Group name.
    # @param axis str Axis name ('input' or 'output').
    # @param block_type str Block type ('hidden_dim', 'head', 'neuron').
    # @return str Canonical key.
    def _axis_key(self, group_name: str, axis: str, block_type: str) -> str:
        g = str(group_name)
        a = str(axis)
        b = str(block_type)
        return f"{g}:{a}:{b}"

    ## @brief Parse canonical axis key into components.
    # @param key str Canonical key in the form "{group}:{axis}:{block_type}".
    # @return tuple[str, str, str] (group, axis, block_type).
    def _parse_axis_key(self, key: str) -> Tuple[str, str, str]:
        parts = str(key).split(":")
        if len(parts) != 3:
            raise ValueError(f"Expected canonical key with 3 parts, got '{key}'")
        return parts[0], parts[1], parts[2]
