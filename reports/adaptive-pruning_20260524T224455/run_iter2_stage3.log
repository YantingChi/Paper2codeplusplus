## @brief Runtime configuration dataclass.
# @details Encodes device and system runtime knobs.
@dataclass(frozen=True)
class RuntimeConfig:
    ## @param output_dir str Output directory for checkpoints and artifacts.
    ## @param device str Device identifier (e.g., 'cuda', 'cpu').
    ## @param num_workers int DataLoader workers.
    ## @param pin_memory bool DataLoader pin_memory.
    ## @param compile_model bool Whether to torch.compile the model.
