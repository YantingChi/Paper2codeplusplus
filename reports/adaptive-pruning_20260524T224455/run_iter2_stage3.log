## src/models/apt_injector.py
from __future__ import annotations

import re
from dataclasses import dataclass
from typing import Any, Dict, Iterable, List, Optional, Tuple

import torch
import torch.nn as nn

from src.config import APTConfig
from src.models.apt_linear import APTLinear


## @brief Registry entry for a single injected APT module.
# @details Stores the module, its group, and rich metadata required by later APT components.
@dataclass(frozen=True)
class _APTRegistryEntry:
    ## @param module_name str Fully qualified module name in the wrapped model.
    ## @param group str Structural group name.
    ## @param module APTLinear Injected APTLinear module.
    ## @param metadata dict[str, Any] Metadata for pruning/tuning bookkeeping.
    module_name: str
    group: str
    module: APTLinear
    metadata: Dict[str, Any]


## @brief Authoritative registry of all injected APT modules.
# @details
# Downstream components (salience, pruning, rank allocation, export) must consume this registry
# rather than re-discovering structure.
class APTRegistry:
    ## @brief Initialize an empty APTRegistry.
    def __init__(self) -> None:
        self._entries: Dict[str, _APTRegistryEntry] = {}
        self._order: List[str] = []

    ## @brief Register an injected APTLinear module.
    # @param module_name str Fully qualified module name in model namespace.
    # @param module APTLinear The injected module instance.
    # @param group str Structural group name used for aggregation.
    # @return None
    def register(self, module_name: str, module: APTLinear, group: str) -> None:
        name = str(module_name)
        if not name:
            raise ValueError("module_name must be non-empty.")
        if not isinstance(module, APTLinear):
            raise TypeError(f"module must be APTLinear, got {type(module)}")
        grp = str(group) if group is not None else ""

        if name in self._entries:
            raise ValueError(f"Duplicate registry entry for module_name='{name}'")

        meta = module.collect_structure_metadata()
        meta["group"] = grp
        self._entries[name] = _APTRegistryEntry(
            module_name=name,
            group=grp,
            module=module,
            metadata=meta,
        )
        self._order.append(name)

    ## @brief List all injected APTLinear modules in deterministic order.
    # @param None
    # @return list[APTLinear] List of modules.
    def list_modules(self) -> List[APTLinear]:
        return [self._entries[n].module for n in self._order]

    ## @brief Return prunable groups mapping group_name -> list of modules.
    # @param None
    # @return dict[str, list[APTLinear]] Mapping of group to modules.
    def get_prunable_groups(self) -> Dict[str, List[APTLinear]]:
        groups: Dict[str, List[APTLinear]] = {}
        for name in self._order:
            entry = self._entries[name]
            groups.setdefault(entry.group, []).append(entry.module)
        return groups

    ## @brief Export registry state as a JSON-serializable dictionary.
    # @param None
    # @return dict State dictionary containing registry entries and module metadata.
    def state_dict(self) -> Dict[str, Any]:
        entries: List[Dict[str, Any]] = []
        for name in self._order:
            e = self._entries[name]
            entries.append(
                {
                    "module_name": e.module_name,
                    "group": e.group,
                    "metadata": dict(e.metadata),
                }
            )
        return {"entries": entries, "num_entries": len(entries)}

    ## @brief Return deterministic list of (name, module) pairs.
    # @param None
    # @return list[tuple[str, APTLinear]] Pairs of module name and module.
    def named_modules(self) -> List[Tuple[str, APTLinear]]:
        return [(n, self._entries[n].module) for n in self._order]

    ## @brief Get metadata for a registered module.
    # @param module_name str Module name key.
    # @return dict[str, Any] Metadata.
    def get_metadata(self, module_name: str) -> Dict[str, Any]:
        name = str(module_name)
        if name not in self._entries:
            raise KeyError(f"Unknown module_name in registry: {name}")
        return dict(self._entries[name].metadata)


## @brief Wrapper around an APT-injected Hugging Face model.
# @details
# Exposes the underlying model forward pass unchanged while providing access to APT modules and registry.
class APTModelWrapper(nn.Module):
    ## @brief Initialize APTModelWrapper.
    # @param model Any Wrapped model (typically a transformers PreTrainedModel).
    # @param apt_modules list[APTLinear] List of injected APT modules.
    # @param registry APTRegistry Registry containing all injected modules and metadata.
    def __init__(self, model: Any, apt_modules: List[APTLinear], registry: APTRegistry) -> None:
        super().__init__()
        self.model: Any = model
        self._apt_modules: List[APTLinear] = list(apt_modules)
        self._registry: APTRegistry = registry

    ## @brief Forward pass delegation to the wrapped model.
    # @param kwargs Any Keyword arguments accepted by the wrapped model.
    # @return Any Model outputs.
    def forward(self, **kwargs: Any) -> Any:
        return self.model(**kwargs)

    ## @brief Return deterministic list of named APT modules.
    # @param None
    # @return list[tuple[str, APTLinear]] (name, module) pairs.
    def named_apt_modules(self) -> List[Tuple[str, APTLinear]]:
        return self._registry.named_modules()

    ## @brief Get the shared APT registry.
    # @param None
    # @return APTRegistry Registry instance.
    def get_registry(self) -> APTRegistry:
        return self._registry

    ## @brief Export a compact model artifact path.
    # @details This method is part of the public interface; compaction is implemented in src/models/compact_export.py.
    # @param output_dir str Output directory.
    # @return str Path to exported artifact (delegation string).
    def export_compact_model(self, output_dir: str) -> str:
        # Keep a stable method for system wiring; the actual compaction is implemented elsewhere.
        # We still provide a minimal, correct export for inference: merge adapters into base weights
        # to eliminate LoRA branch overhead as the paper notes adapters can be merged after training.
        out_dir = str(output_dir)
        for _, m in self.named_apt_modules():
            m.merge_adapter()
        # Save merged model via torch.save state_dict for portability without requiring transformers save_pretrained.
        state_path = f"{out_dir.rstrip('/')}/merged_state_dict.pt"
        # Ensure directory exists.
        import os

        os.makedirs(out_dir, exist_ok=True)
        torch.save(self.model.state_dict(), state_path)
        return state_path


## @brief Model surgery utility to inject APTLinear modules into a model.
# @details
# Finds target linear layers (query/value and optionally FFN) per config.yaml-driven APTConfig.apply_on_modules
# and replaces them with APTLinear with rank=initial_rank and scaling factor=lora_alpha.
class APTInjector:
    ## @brief Initialize APTInjector with an APTConfig.
    # @param apt_config APTConfig APT configuration.
    def __init__(self, apt_config: APTConfig) -> None:
        if not isinstance(apt_config, APTConfig):
            raise TypeError(f"apt_config must be APTConfig, got {type(apt_config)}")
        self._cfg: APTConfig = apt_config

    ## @brief Find target module names to inject APT adapters into.
    # @details Returns fully qualified module names of nn.Linear layers matching configured targets.
    # @param model Any Hugging Face model.
    # @return list[str] List of module names to replace.
    def find_target_modules(self, model: Any) -> List[str]:
        family = _infer_model_family_from_instance(model=model)
        apply = set(str(x) for x in (self._cfg.apply_on_modules or []))
        if not apply:
            return []

        # Enumerate all leaf modules with their names and filter candidates to nn.Linear.
        linear_names: List[str] = []
        for name, module in model.named_modules():
            if not name:
                continue
            if isinstance(module, APTLinear):
                continue
            if isinstance(module, nn.Linear):
                linear_names.append(name)

        targets: List[str] = []
        if family in {"bert", "roberta"}:
            targets = _match_bert_roberta_targets(
                linear_names=linear_names,
                apply=apply,
            )
        elif family == "t5":
            targets = _match_t5_targets(
                linear_names=linear_names,
                apply=apply,
            )
        elif family == "llama":
            targets = _match_llama_targets(
                linear_names=linear_names,
                apply=apply,
            )
        else:
            raise ValueError(f"Unsupported model family for APT injection: {family}")

        # Deterministic order
        return sorted(set(targets))

    ## @brief Inject APTLinear modules into the provided model.
    # @details Replaces target nn.Linear layers in-place and returns an APTModelWrapper with a populated registry.
    # @param model Any Hugging Face model instance to modify.
    # @return APTModelWrapper Wrapped model with injected APT modules.
    def inject(self, model: Any) -> APTModelWrapper:
        if not self._cfg.enable_apt:
            raise ValueError("APTInjector.inject called but apt.enable_apt is false.")

        target_names = self.find_target_modules(model=model)
        if len(target_names) == 0:
            raise ValueError(
                "No target modules found for APT injection. "
                "Check apt.apply_on_modules and model naming conventions."
            )

        registry = APTRegistry()
        injected_modules: List[APTLinear] = []

        family = _infer_model_family_from_instance(model=model)
        model_cfg = getattr(model, "config", None)

        for full_name in target_names:
            parent, child_name, child = _resolve_parent_child(model=model, module_name=full_name)
            if not isinstance(child, nn.Linear):
                raise TypeError(
                    f"Target module '{full_name}' is not nn.Linear at injection time: {type(child)}"
                )

            group_name, role_meta = _build_group_and_role_metadata(
                model_family=family,
                model_config=model_cfg,
                module_full_name=full_name,
                linear_module=child,
            )

            apt_layer = APTLinear(
                base_linear=child,
                in_features=int(child.in_features),
                out_features=int(child.out_features),
                rank=int(self._cfg.initial_rank),
                alpha=float(self._cfg.lora_alpha),
                module_name=str(full_name),
                group_name=str(group_name),
            )

            # Attach rich metadata for later pruning/tuning logic.
            # This does not modify the public interface; it is stored in collect_structure_metadata().
            # We store it on the module's private metadata dict.
            try:
                apt_layer._metadata.update(role_meta)  # pylint: disable=protected-access
            except Exception as e:
                raise RuntimeError(f"Failed to attach metadata to APTLinear for '{full_name}': {e}") from e

            # Replace module in parent.
            setattr(parent, child_name, apt_layer)

            registry.register(module_name=full_name, module=apt_layer, group=group_name)
            injected_modules.append(apt_layer)

        return APTModelWrapper(model=model, apt_modules=injected_modules, registry=registry)


## @brief Infer model family from a model instance.
# @param model Any Model instance.
# @return str One of {'bert','roberta','t5','llama'}.
def _infer_model_family_from_instance(model: Any) -> str:
    cfg = getattr(model, "config", None)
    model_type = getattr(cfg, "model_type", "") if cfg is not None else ""
    model_type = str(model_type).lower().strip()

    # Prefer model.config.model_type, as required by design.
    if model_type in {"bert"}:
        return "bert"
    if model_type in {"roberta"}:
        return "roberta"
    if model_type in {"t5"}:
        return "t5"
    if model_type in {"llama"}:
        return "llama"

    # Fallback: class name heuristics (secondary, but robust).
    cls_name = model.__class__.__name__.lower()
    if "roberta" in cls_name:
        return "roberta"
    if "bert" in cls_name:
        return "bert"
    if "t5" in cls_name:
        return "t5"
    if "llama" in cls_name:
        return "llama"

    raise ValueError(f"Unable to infer model family from model.config.model_type='{model_type}' and class='{cls_name}'")


## @brief Resolve a module name into (parent_module, attribute_name, child_module).
# @param model Any Root model.
# @param module_name str Fully qualified module name (dot-separated).
# @return tuple[Any, str, Any] Parent module, child attribute name, child module instance.
def _resolve_parent_child(model: Any, module_name: str) -> Tuple[Any, str, Any]:
    name = str(module_name).strip()
    if not name:
        raise ValueError("module_name must be non-empty.")

    parts = name.split(".")
    if len(parts) == 1:
        parent = model
        child_name = parts[0]
    else:
        parent = model
        for p in parts[:-1]:
            if not hasattr(parent, p):
                raise AttributeError(f"Cannot resolve '{module_name}': missing attribute '{p}'")
            parent = getattr(parent, p)
        child_name = parts[-1]

    if not hasattr(parent, child_name):
        raise AttributeError(f"Cannot resolve '{module_name}': missing final attribute '{child_name}'")
    child = getattr(parent, child_name)
    return parent, child_name, child


## @brief Match BERT/RoBERTa module names to APT targets.
# @param linear_names list[str] All nn.Linear module names.
# @param apply set[str] Target categories (e.g., {'attention_query','attention_value','ffn_layers'}).
# @return list[str] Matching module names.
def _match_bert_roberta_targets(linear_names: List[str], apply: set) -> List[str]:
    out: List[str] = []
    # Attention q/v naming in HF BERT/RoBERTa:
    # - ...attention.self.query
    # - ...attention.self.value
    if "attention_query" in apply:
        out.extend([n for n in linear_names if n.endswith("attention.self.query")])
    if "attention_value" in apply:
        out.extend([n for n in linear_names if n.endswith("attention.self.value")])

    # FFN naming:
    # - ...intermediate.dense
    # - ...output.dense
    if "ffn_layers" in apply:
        out.extend([n for n in linear_names if n.endswith("intermediate.dense")])
        out.extend([n for n in linear_names if n.endswith("output.dense")])

    # Avoid injecting into task heads (classifier) even if names accidentally match.
    filtered: List[str] = []
    for n in out:
        if ".classifier." in n or n.endswith("classifier") or n.endswith("lm_head"):
            continue
        filtered.append(n)
    return filtered


## @brief Match T5 module names to APT targets.
# @details
# HF T5 uses:
# - Encoder/decoder self-attention: ...SelfAttention.q / ...SelfAttention.v
# - Decoder cross-attention: ...EncDecAttention.q / ...EncDecAttention.v
# - Gated FFN: ...DenseReluDense.wi_0 / wi_1 / wo (or DenseGatedGeluDense)
# @param linear_names list[str] All nn.Linear module names.
# @param apply set[str] Target categories.
# @return list[str] Matching module names.
def _match_t5_targets(linear_names: List[str], apply: set) -> List[str]:
    out: List[str] = []

    if "attention_query" in apply:
        out.extend([n for n in linear_names if n.endswith("SelfAttention.q")])
        out.extend([n for n in linear_names if n.endswith("EncDecAttention.q")])
    if "attention_value" in apply:
        out.extend([n for n in linear_names if n.endswith("SelfAttention.v")])
        out.extend([n for n in linear_names if n.endswith("EncDecAttention.v")])

    # FFN gating variants:
    # - DenseReluDense.wi, DenseReluDense.wo (non-gated older checkpoints)
    # - DenseReluDense.wi_0, DenseReluDense.wi_1, DenseReluDense.wo (gated)
    # - DenseGatedGeluDense.wi_0, wi_1, wo
    if "ffn_layers" in apply:
        for suffix in ("DenseReluDense.wi", "DenseReluDense.wo", "DenseReluDense.wi_0", "DenseReluDense.wi_1"):
            out.extend([n for n in linear_names if n.endswith(suffix)])
        for suffix in ("DenseGatedGeluDense.wi_0", "DenseGatedGeluDense.wi_1", "DenseGatedGeluDense.wo"):
            out.extend([n for n in linear_names if n.endswith(suffix)])

    # Avoid injecting into lm_head or shared embeddings.
    filtered: List[str] = []
    for n in out:
        if n.endswith("lm_head") or ".lm_head" in n:
            continue
        if n.endswith("shared") or n.endswith("embed_tokens"):
            continue
        filtered.append(n)
    return filtered


## @brief Match LLaMA module names to APT targets.
# @details HF LLaMA uses:
# - ...self_attn.q_proj
# - ...self_attn.v_proj
# @param linear_names list[str] All nn.Linear module names.
# @param apply set[str] Target categories.
# @return list[str] Matching module names.
def _match_llama_targets(linear_names: List[str], apply: set) -> List[str]:
    out: List[str] = []
    if "attention_query" in apply:
        out.extend([n for n in linear_names if n.endswith("self_attn.q_proj")])
    if "attention_value" in apply:
        out.extend([n for n in linear_names if n.endswith("self_attn.v_proj")])

    # Prevent accidental injection into output head.
    filtered: List[str] = []
    for n in out:
        if n.endswith("lm_head") or ".lm_head" in n:
            continue
        filtered.append(n)
    return filtered


## @brief Build a group name and rich role metadata for a given target module.
# @details
# This metadata enables later modules to correctly interpret masks as:
# - input mask => hidden dimension (m_i)
# - output mask => attention heads or FFN neurons (m_o) depending on role
#
# The paper requires structured pruning across attention heads, FFN neurons, and hidden dimensions.
# This function attaches enough information so later mask/salience/pruning components can implement it.
# @param model_family str One of {'bert','roberta','t5','llama'}.
# @param model_config Any Model config (transformers config object).
# @param module_full_name str Fully qualified module name.
# @param linear_module nn.Linear The linear module being wrapped.
# @return tuple[str, dict[str, Any]] Group name and metadata dictionary.
def _build_group_and_role_metadata(
    model_family: str,
    model_config: Any,
    module_full_name: str,
    linear_module: nn.Linear,
) -> Tuple[str, Dict[str, Any]]:
    name = str(module_full_name)
    family = str(model_family)

    layer_index = _extract_layer_index(module_full_name=name, family=family)
    role = _infer_role_from_name(module_full_name=name, family=family)

    # Group names for aggregation: "encoder.layer.{i}.attention", "...ffn", etc.
    group = _infer_group_name(module_full_name=name, family=family, role=role)

    hidden_size = _infer_hidden_size(model_config=model_config, linear_module=linear_module, family=family, role=role)
    num_heads, head_dim = _infer_attention_heads(model_config=model_config, linear_module=linear_module, hidden_size=hidden_size)

    intermediate_size = _infer_intermediate_size(model_config=model_config, family=family)

    # Axis roles determine how pruning masks map to heads/neuron/hidden_dim.
    # input mask always exists and can represent hidden-dimension pruning when aligned.
    # output mask can represent heads (attention q/v) or neurons (FFN up/gate) depending on role.
    meta: Dict[str, Any] = {
        "family": family,
        "layer_index": int(layer_index) if layer_index is not None else -1,
        "submodule_kind": role,
        "hidden_size": int(hidden_size) if hidden_size is not None else -1,
        "intermediate_size": int(intermediate_size) if intermediate_size is not None else -1,
        "num_heads": int(num_heads) if num_heads is not None else -1,
        "head_dim": int(head_dim) if head_dim is not None else -1,
        "input_block_type": "hidden_dim",
        "output_block_type": _output_block_type_for_role(role=role),
        "input_axis_role": _input_axis_role_for_role(role=role),
        "output_axis_role": _output_axis_role_for_role(role=role),
        "is_cross_attention": bool(role.startswith("attn_cross_")),
        "is_decoder": bool(role.startswith("decoder_")),
    }

    return group, meta


## @brief Extract transformer layer index from module name by family-specific patterns.
# @param module_full_name str Module name.
# @param family str Model family.
# @return Optional[int] Layer index if found, else None.
def _extract_layer_index(module_full_name: str, family: str) -> Optional[int]:
    name = str(module_full_name)

    # BERT/RoBERTa: ...encoder.layer.{i}....
    if family in {"bert", "roberta"}:
        m = re.search(r"\bencoder\.layer\.(\d+)\b", name)
        if m:
            return int(m.group(1))

    # T5: encoder.block.{i}..., decoder.block.{i}...
    if family == "t5":
        m = re.search(r"\bencoder\.block\.(\d+)\b", name)
        if m:
            return int(m.group(1))
        m = re.search(r"\bdecoder\.block\.(\d+)\b", name)
        if m:
            return int(m.group(1))

    # LLaMA: model.layers.{i}...
    if family == "llama":
        m = re.search(r"\bmodel\.layers\.(\d+)\b", name)
        if m:
            return int(m.group(1))
        m = re.search(r"\blayers\.(\d+)\b", name)
        if m:
            return int(m.group(1))

    return None


## @brief Infer role string from module name.
# @param module_full_name str Module name.
# @param family str Model family.
# @return str Role identifier (submodule_kind).
def _infer_role_from_name(module_full_name: str, family: str) -> str:
    name = str(module_full_name)

    if family in {"bert", "roberta"}:
        if name.endswith("attention.self.query"):
            return "attn_query"
        if name.endswith("attention.self.value"):
            return "attn_value"
        if name.endswith("intermediate.dense"):
            return "ffn_intermediate"
        if name.endswith("output.dense"):
            return "ffn_output"
        return "other"

    if family == "t5":
        # Attention
        if name.endswith("SelfAttention.q"):
            # Could be encoder or decoder; detect prefix.
            if ".decoder." in name:
                return "decoder_attn_self_query"
            return "encoder_attn_self_query"
        if name.endswith("SelfAttention.v"):
            if ".decoder." in name:
                return "decoder_attn_self_value"
            return "encoder_attn_self_value"
        if name.endswith("EncDecAttention.q"):
            return "attn_cross_query"
        if name.endswith("EncDecAttention.v"):
            return "attn_cross_value"

        # FFN (gated or not)
        if name.endswith("DenseReluDense.wi"):
            return "ffn_wi"
        if name.endswith("DenseReluDense.wo"):
            return "ffn_wo"
        if name.endswith("DenseReluDense.wi_0"):
            return "ffn_wi_0"
        if name.endswith("DenseReluDense.wi_1"):
            return "ffn_wi_1"
        if name.endswith("DenseGatedGeluDense.wi_0"):
            return "ffn_wi_0"
        if name.endswith("DenseGatedGeluDense.wi_1"):
            return "ffn_wi_1"
        if name.endswith("DenseGatedGeluDense.wo"):
            return "ffn_wo"
        return "other"

    if family == "llama":
        if name.endswith("self_attn.q_proj"):
            return "attn_query"
        if name.endswith("self_attn.v_proj"):
            return "attn_value"
        return "other"

    return "other"


## @brief Infer group name for aggregation based on module role.
# @param module_full_name str Module name.
# @param family str Model family.
# @param role str Role identifier.
# @return str Group name.
def _infer_group_name(module_full_name: str, family: str, role: str) -> str:
    name = str(module_full_name)

    if family in {"bert", "roberta"}:
        # Group by encoder.layer.{i}.attention or .ffn
        m = re.search(r"^(.*\bencoder\.layer\.\d+)\.", name)
        prefix = m.group(1) if m else "encoder.layer.unknown"
        if role in {"attn_query", "attn_value"}:
            return f"{prefix}.attention"
        if role in {"ffn_intermediate", "ffn_output"}:
            return f"{prefix}.ffn"
        return f"{prefix}.other"

    if family == "t5":
        # Group by encoder.block.{i} or decoder.block.{i}, then by attention kind or ffn
        m = re.search(r"^(.*\bencoder\.block\.\d+)\.", name)
        if m:
            prefix = m.group(1)
        else:
            m = re.search(r"^(.*\bdecoder\.block\.\d+)\.", name)
            prefix = m.group(1) if m else "block.unknown"

        if "attn" in role:
            if "cross" in role:
                return f"{prefix}.cross_attention"
            return f"{prefix}.self_attention"
        if role.startswith("ffn_"):
            return f"{prefix}.ffn"
        return f"{prefix}.other"

    if family == "llama":
        m = re.search(r"^(.*\blayers\.\d+)\.", name)
        prefix = m.group(1) if m else "layers.unknown"
        if role in {"attn_query", "attn_value"}:
            return f"{prefix}.self_attn"
        return f"{prefix}.other"

    return "unknown"


## @brief Infer hidden size for metadata.
# @param model_config Any Transformers config.
# @param linear_module nn.Linear Linear module.
# @param family str Model family.
# @param role str Role identifier.
# @return Optional[int] Hidden size if known.
def _infer_hidden_size(
    model_config: Any,
    linear_module: nn.Linear,
    family: str,
    role: str,
) -> Optional[int]:
    cfg = model_config
    # Prefer config attributes.
    for attr in ("hidden_size", "d_model"):
        if cfg is not None and hasattr(cfg, attr):
            try:
                v = int(getattr(cfg, attr))
                if v > 0:
                    return v
            except Exception:
                pass

    # Shape-based fallback for common roles.
    if role in {"attn_query", "attn_value", "ffn_output", "ffn_wo"} or "attn_" in role:
        # These typically output hidden size.
        try:
            return int(linear_module.out_features)
        except Exception:
            return None
    if role in {"ffn_intermediate", "ffn_wi", "ffn_wi_0", "ffn_wi_1"}:
        try:
            return int(linear_module.in_features)
        except Exception:
            return None

    # Final fallback: use in_features.
    try:
        return int(linear_module.in_features)
    except Exception:
        return None


## @brief Infer intermediate size for metadata (FFN width).
# @param model_config Any Transformers config.
# @param family str Model family.
# @return Optional[int] Intermediate size if known.
def _infer_intermediate_size(model_config: Any, family: str) -> Optional[int]:
    cfg = model_config
    if cfg is None:
        return None
    # BERT/RoBERTa uses intermediate_size; T5 uses d_ff; LLaMA uses intermediate_size in many configs.
    for attr in ("intermediate_size", "d_ff"):
        if hasattr(cfg, attr):
            try:
                v = int(getattr(cfg, attr))
                if v > 0:
                    return v
            except Exception:
                pass
    return None


## @brief Infer attention heads and head dimension from config if available.
# @param model_config Any Transformers config.
# @param linear_module nn.Linear Linear module.
# @param hidden_size Optional[int] Hidden size.
# @return tuple[Optional[int], Optional[int]] (num_heads, head_dim).
def _infer_attention_heads(
    model_config: Any,
    linear_module: nn.Linear,
    hidden_size: Optional[int],
) -> Tuple[Optional[int], Optional[int]]:
    cfg = model_config
    num_heads: Optional[int] = None
    head_dim: Optional[int] = None

    if cfg is not None:
        for attr in ("num_attention_heads", "n_head", "num_heads"):
            if hasattr(cfg, attr):
                try:
                    v = int(getattr(cfg, attr))
                    if v > 0:
                        num_heads = v
                        break
                except Exception:
                    pass

    # Compute head_dim if possible; validate divisibility when known.
    if hidden_size is not None and num_heads is not None and num_heads > 0:
        if hidden_size % num_heads == 0:
            head_dim = int(hidden_size // num_heads)
        else:
            # Some models may have non-standard projections; fall back to out_features/num_heads if divisible.
            outf = int(getattr(linear_module, "out_features", 0))
            if outf > 0 and outf % num_heads == 0:
                head_dim = int(outf // num_heads)

    return num_heads, head_dim


## @brief Output block type for a role.
# @param role str Role identifier.
# @return str One of {'head','neuron','hidden_dim'}.
def _output_block_type_for_role(role: str) -> str:
    r = str(role)
    # Attention q/v prunes heads on output axis (per paper Section 4.1).
    if "attn" in r and ("query" in r or "value" in r):
        return "head"
    # FFN "up/gate" projections output neurons.
    if r in {"ffn_intermediate", "ffn_wi", "ffn_wi_0", "ffn_wi_1"}:
        return "neuron"
    # FFN down/wo/output projections output hidden dims (neurons live on input axis there).
    if r in {"ffn_output", "ffn_wo"}:
        return "hidden_dim"
    return "hidden_dim"


## @brief Input axis role for a given submodule role.
# @param role str Role identifier.
# @return str One of {'hidden_dim','neuron'}.
def _input_axis_role_for_role(role: str) -> str:
    r = str(role)
    # Attention and FFN intermediate take hidden_dim as input.
    if "attn" in r and ("query" in r or "value" in r):
        return "hidden_dim"
    if r in {"ffn_intermediate", "ffn_wi", "ffn_wi_0", "ffn_wi_1"}:
        return "hidden_dim"
    # FFN output/wo takes neurons as input.
    if r in {"ffn_output", "ffn_wo"}:
        return "neuron"
    return "hidden_dim"


## @brief Output axis role for a given submodule role.
# @param role str Role identifier.
# @return str One of {'head','neuron','hidden_dim'}.
def _output_axis_role_for_role(role: str) -> str:
    r = str(role)
    if "attn" in r and ("query" in r or "value" in r):
        return "head"
    if r in {"ffn_intermediate", "ffn_wi", "ffn_wi_0", "ffn_wi_1"}:
        return "neuron"
    if r in {"ffn_output", "ffn_wo"}:
        return "hidden_dim"
    return "hidden_dim"
