## src/eval/metrics.py
from __future__ import annotations

from dataclasses import dataclass
from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple, Union

import numpy as np
import torch
from sklearn.metrics import accuracy_score, f1_score
from rouge_score import rouge_scorer

import evaluate


## @brief Metric computation registry for different task types.
# @details
# Implements metric computation aligned with the paper:
# - GLUE (SST-2, MNLI): dev accuracy
# - SQuAD v2.0: dev F1 (and exact match for completeness)
# - CNN/DailyMail: ROUGE-1/2/L
#
# Backends:
# - Primary: Hugging Face `evaluate` (glue/squad_v2/rouge).
# - Fallbacks:
#   - GLUE: sklearn accuracy (and basic F1 for tasks where applicable).
#   - ROUGE: `rouge_score` package.
#
# Important:
# - This module computes metrics only; decoding, span post-processing, and generation happen in Evaluator.
# - For SQuAD v2, `compute_qa` expects *post-processed* predictions/references in SQuAD format.
class MetricsRegistry:
    ## @brief Initialize MetricsRegistry.
    # @param task_type str One of {'sequence_classification','question_answering','seq2seq','causal_lm'}.
    def __init__(self, task_type: str) -> None:
        self._task_type: str = str(task_type).strip()
        self._metric_cache: Dict[Tuple[str, str], Any] = {}

    ## @brief Compute task metrics by dispatching on task_type.
    # @details
    # Because task_name is not provided here, this method is a safe dispatcher:
    # - sequence_classification: computes generic accuracy if possible
    # - question_answering: delegates to compute_qa
    # - seq2seq: delegates to compute_rouge
    # - causal_lm: returns empty dict (handled by lm-eval-harness adapter)
    # @param predictions Any Predictions (format depends on task type).
    # @param references Any References/labels (format depends on task type).
    # @return dict[str, float] Metrics mapping.
    def compute(self, predictions: Any, references: Any) -> Dict[str, float]:
        if self._task_type == "question_answering":
            return self.compute_qa(predictions=predictions, references=references)
        if self._task_type == "seq2seq":
            return self.compute_rouge(predictions=predictions, references=references)
        if self._task_type == "sequence_classification":
            # Generic classification: accuracy over integer class ids or logits.
            y_pred = _prepare_classification_predictions(predictions)
            y_true = _to_1d_int_array(references, name="references")
            if y_pred.shape[0] != y_true.shape[0]:
                raise ValueError(
                    f"Predictions/references length mismatch: pred={y_pred.shape[0]} ref={y_true.shape[0]}"
                )
            return {"accuracy": float(accuracy_score(y_true, y_pred))}
        if self._task_type == "causal_lm":
            # Causal LM evaluation is done via lm-eval-harness; keep metrics module policy-free here.
            return {}
        raise ValueError(f"Unsupported task_type='{self._task_type}'")

    ## @brief Compute GLUE task metrics.
    # @details
    # Paper-required:
    # - SST-2: accuracy
    # - MNLI: accuracy
    #
    # This uses `evaluate.load('glue', task_name)` as primary. If unavailable, falls back to sklearn.
    # For MNLI, accepts task_name like 'mnli_matched' or 'mnli_mismatched' and normalizes to 'mnli'.
    # @param task_name str GLUE task name (e.g., 'sst2', 'mnli').
    # @param predictions Any Model predictions (logits [N,C] or label ids [N]).
    # @param references Any Reference labels [N].
    # @return dict[str, float] GLUE metrics (at least 'accuracy' for SST-2/MNLI).
    def compute_glue(self, task_name: str, predictions: Any, references: Any) -> Dict[str, float]:
        task = _normalize_glue_task_name(task_name)
        y_pred = _prepare_classification_predictions(predictions)
        y_true = _to_1d_int_array(references, name="references")

        if y_pred.shape[0] != y_true.shape[0]:
            raise ValueError(
                f"Predictions/references length mismatch: pred={y_pred.shape[0]} ref={y_true.shape[0]}"
            )

        # Primary backend: evaluate GLUE metric.
        metric = self._get_evaluate_metric(metric_name="glue", config_name=task)
        if metric is not None:
            try:
                out = metric.compute(predictions=y_pred.tolist(), references=y_true.tolist())
                # GLUE metrics vary by task; for SST-2/MNLI, accuracy must be present.
                out = _coerce_metric_dict_to_float(out)
                # Ensure paper-required key exists for SST-2/MNLI.
                if task in {"sst2", "mnli"} and "accuracy" not in out:
                    out["accuracy"] = float(accuracy_score(y_true, y_pred))
                return out
            except Exception:
                # Fall back below.
                pass

        # Fallback: sklearn, task-aware where possible.
        metrics: Dict[str, float] = {"accuracy": float(accuracy_score(y_true, y_pred))}
        # Optional generality: for tasks often reported with F1 (not required by main paper tables).
        if task in {"mrpc", "qqp"}:
            metrics["f1"] = float(f1_score(y_true, y_pred))
        return metrics

    ## @brief Compute extractive QA metrics (SQuAD v2.0).
    # @details
    # Paper-required metric: dev F1 on SQuAD v2.0. We also return exact match for completeness.
    #
    # Input format must follow `evaluate.load('squad_v2')`:
    # - predictions: list[dict] each with keys:
    #     {'id': str, 'prediction_text': str, 'no_answer_probability': float (optional)}
    # - references: list[dict] each with keys:
    #     {'id': str, 'answers': {'text': list[str], 'answer_start': list[int]}}
    # @param predictions Any Post-processed predictions in SQuAD v2 format.
    # @param references Any References in SQuAD v2 format.
    # @return dict[str, float] {'f1': ..., 'exact_match': ...}
    def compute_qa(self, predictions: Any, references: Any) -> Dict[str, float]:
        if not isinstance(predictions, list) or not all(isinstance(x, dict) for x in predictions):
            raise TypeError(
                "QA predictions must be a list of dicts in SQuAD v2 format: "
                "{'id':..., 'prediction_text':...[, 'no_answer_probability':...]}"
            )
        if not isinstance(references, list) or not all(isinstance(x, dict) for x in references):
            raise TypeError(
                "QA references must be a list of dicts in SQuAD v2 format: {'id':..., 'answers':...}"
            )

        metric = self._get_evaluate_metric(metric_name="squad_v2", config_name="")
        if metric is None:
            raise RuntimeError(
                "Unable to load 'squad_v2' metric via evaluate. "
                "This reproduction requires the standard SQuAD v2 evaluator to report dev F1."
            )

        out_raw = metric.compute(predictions=predictions, references=references)
        out = _coerce_metric_dict_to_float(out_raw)

        # `evaluate` uses keys {'exact', 'f1'} for squad_v2.
        f1_val = float(out.get("f1", 0.0))
        exact_val = float(out.get("exact", out.get("exact_match", 0.0)))

        return {"f1": f1_val, "exact_match": exact_val}

    ## @brief Compute ROUGE metrics for summarization (CNN/DailyMail).
    # @details
    # Paper-required metrics: ROUGE-1/2/L.
    # Primary backend: `evaluate.load('rouge')`.
    # Fallback: `rouge_score.rouge_scorer.RougeScorer`.
    # @param predictions list[str] Generated summaries.
    # @param references list[str] Reference summaries.
    # @return dict[str, float] {'rouge1': ..., 'rouge2': ..., 'rougeL': ...}
    def compute_rouge(self, predictions: Any, references: Any) -> Dict[str, float]:
        if not isinstance(predictions, list) or not all(isinstance(x, str) for x in predictions):
            raise TypeError("ROUGE predictions must be a list[str] of decoded summaries.")
        if not isinstance(references, list) or not all(isinstance(x, str) for x in references):
            raise TypeError("ROUGE references must be a list[str] of reference summaries.")
        if len(predictions) != len(references):
            raise ValueError(f"ROUGE predictions/references length mismatch: {len(predictions)} vs {len(references)}")

        preds = [p.strip() for p in predictions]
        refs = [r.strip() for r in references]

        metric = self._get_evaluate_metric(metric_name="rouge", config_name="")
        if metric is not None:
            try:
                # `evaluate` rouge supports several options; we keep them deterministic and conservative.
                out_raw = metric.compute(predictions=preds, references=refs, use_stemmer=True)
                out = _coerce_metric_dict_to_float(out_raw)
                # Keep only required keys with canonical capitalization.
                return {
                    "rouge1": float(out.get("rouge1", 0.0)),
                    "rouge2": float(out.get("rouge2", 0.0)),
                    "rougeL": float(out.get("rougeL", out.get("rougeLsum", 0.0))),
                }
            except Exception:
                pass

        # Fallback: rouge_score
        scorer = rouge_scorer.RougeScorer(["rouge1", "rouge2", "rougeL"], use_stemmer=True)
        r1_total = 0.0
        r2_total = 0.0
        rL_total = 0.0

        for p, r in zip(preds, refs):
            scores = scorer.score(target=r, prediction=p)
            r1_total += float(scores["rouge1"].fmeasure)
            r2_total += float(scores["rouge2"].fmeasure)
            rL_total += float(scores["rougeL"].fmeasure)

        n = max(1, len(preds))
        return {"rouge1": r1_total / n, "rouge2": r2_total / n, "rougeL": rL_total / n}

    ## @brief Lazily load and cache an `evaluate` metric.
    # @param metric_name str Metric name for `evaluate.load`.
    # @param config_name str Optional config name/subtask (e.g., 'glue' task like 'sst2').
    # @return Optional[Any] Loaded metric object or None if loading fails.
    def _get_evaluate_metric(self, metric_name: str, config_name: str) -> Optional[Any]:
        key = (str(metric_name).strip(), str(config_name).strip())
        if key in self._metric_cache:
            return self._metric_cache[key]

        try:
            if key[1]:
                metric = evaluate.load(key[0], key[1])
            else:
                metric = evaluate.load(key[0])
            self._metric_cache[key] = metric
            return metric
        except Exception:
            self._metric_cache[key] = None
            return None


## @brief Normalize GLUE task name for evaluate backend.
# @param task_name str Raw task name.
# @return str Normalized task name.
def _normalize_glue_task_name(task_name: str) -> str:
    name = str(task_name).lower().strip()
    # Common split-specific names; metric config is still 'mnli'.
    if name in {"mnli_matched", "mnli_mismatched"}:
        return "mnli"
    return name


## @brief Convert predictions to integer class ids (1D).
# @details Accepts:
# - logits: torch.Tensor/np.ndarray shape [N,C] -> argmax
# - label ids: torch.Tensor/np.ndarray/list shape [N] -> as-is
# @param predictions Any Predictions.
# @return np.ndarray 1D int64 array of length N.
def _prepare_classification_predictions(predictions: Any) -> np.ndarray:
    arr = _to_numpy(predictions)
    if arr.ndim == 2:
        return np.asarray(arr.argmax(axis=-1), dtype=np.int64)
    if arr.ndim == 1:
        return np.asarray(arr, dtype=np.int64)
    raise ValueError(f"Unsupported predictions shape for classification: {arr.shape}")


## @brief Convert an object to a NumPy array on CPU.
# @param x Any Input object (torch.Tensor, np.ndarray, list, tuple).
# @return np.ndarray NumPy array.
def _to_numpy(x: Any) -> np.ndarray:
    if torch.is_tensor(x):
        return x.detach().cpu().numpy()
    if isinstance(x, np.ndarray):
        return x
    if isinstance(x, (list, tuple)):
        return np.asarray(x)
    # Support objects with tolist() (e.g., some HF outputs).
    tolist = getattr(x, "tolist", None)
    if callable(tolist):
        return np.asarray(tolist())
    raise TypeError(f"Cannot convert type '{type(x)}' to numpy array.")


## @brief Convert references to a 1D int array.
# @param x Any Reference labels.
# @param name str Name for error messages.
# @return np.ndarray 1D int64 array.
def _to_1d_int_array(x: Any, name: str) -> np.ndarray:
    arr = _to_numpy(x)
    if arr.ndim != 1:
        raise ValueError(f"{name} must be 1D, got shape {arr.shape}")
    return np.asarray(arr, dtype=np.int64)


## @brief Coerce a metric output dict to float values.
# @details Converts numpy/tensor scalars to Python floats; ignores non-scalar values.
# @param metrics Mapping[str, Any] Metric mapping.
# @return dict[str, float] Float mapping.
def _coerce_metric_dict_to_float(metrics: Mapping[str, Any]) -> Dict[str, float]:
    out: Dict[str, float] = {}
    for k, v in metrics.items():
        key = str(k)
        # Accept scalar-like values; ignore sequences.
        if isinstance(v, (int, float)):
            out[key] = float(v)
            continue
        if torch.is_tensor(v) and v.numel() == 1:
            out[key] = float(v.detach().cpu().item())
            continue
        if isinstance(v, np.generic):
            out[key] = float(v.item())
            continue
        # Some evaluate metrics return dicts or lists; do not include them here.
    return out
