    ## @param lm_eval_tasks list[str] lm-eval-harness task identifiers (for causal_lm).
    ## @param lm_eval_num_fewshot dict[str,int] fewshot number per lm-eval task.
    metrics: List[str] = dataclasses.field(default_factory=list)
    measure_train_peak_memory: bool = True
    measure_inference_peak_memory: bool = True
    measure_throughput: bool = True
