## src/algorithms/rank_allocator.py
from __future__ import annotations

import math
from typing import Dict, List, Optional, Tuple

from src.config import APTConfig
from src.models.apt_injector import APTRegistry
from src.models.apt_linear import APTLinear


## @brief Adaptive tuning rank allocator for APT.
# @details
# Implements APT's Adaptive Tuning (AT) procedure (paper Section 4.3):
# 1) Rank allocation is guided by adapter importance (salience) provided externally
#    (paper: I(H_apt) = sum_{i,j} S(W_B[i,j])).
# 2) Select the top-half salient APT adapters.
# 3) Increase ranks according to the paper's budget rule:
#      r'_apt = floor(r_apt * Delta_t' / Delta_t)
#    where Delta_t is the current global tuning-parameter budget and Delta_t' is the new budget.
#
# Budget scheduling Delta_t is not explicitly specified by the parsed paper; therefore, this class
# exposes a deterministic compute_budget() hook driven by apt.rank_growth_mode. For the default
# "linear_budget" mode, we use a monotonic linear schedule over pruning steps:
#   Delta_t' = ceil(Delta_0 * (1 + progress)), progress = clamp(t/T, 0, 1)
# This is a documented implementation choice required due to missing schedule details, while the
# rank update rule itself is implemented exactly as specified in the paper.
class RankAllocator:
    ## @brief Initialize RankAllocator.
    # @param registry APTRegistry Registry of injected APTLinear modules.
    # @param apt_config APTConfig APT configuration controlling rank allocation.
    def __init__(self, registry: APTRegistry, apt_config: APTConfig) -> None:
        if not isinstance(registry, APTRegistry):
            raise TypeError(f"registry must be APTRegistry, got {type(registry)}")
        if not isinstance(apt_config, APTConfig):
            raise TypeError(f"apt_config must be APTConfig, got {type(apt_config)}")

        self._registry: APTRegistry = registry
        self._cfg: APTConfig = apt_config

        # Build private name->module map using the module_name stored in APTLinear.
        self._modules_by_name: Dict[str, APTLinear] = {}
        for m in self._registry.list_modules():
            if not isinstance(m, APTLinear):
                continue
            name = str(getattr(m, "module_name", "")).strip()
            if not name:
                raise ValueError("APTLinear in registry is missing a non-empty module_name.")
            if name in self._modules_by_name:
                raise ValueError(f"Duplicate APTLinear module_name in registry: {name}")
            self._modules_by_name[name] = m

        # Cache initial global tuning budget Delta_0 derived from current module ranks.
        self._initial_budget: int = int(self._compute_current_budget())
        self._last_budget: int = int(self._initial_budget)

    ## @brief Compute target tuning-parameter budget Delta_t for the current pruning step.
    # @details
    # Returns a global total tuning-parameter budget (sum of tunable parameters across all APT adapters).
    #
    # The paper does not provide the exact schedule for Delta_t; this method implements the scheduling
    # policy indicated by apt.rank_growth_mode.
    #
    # Supported modes:
    # - "linear_budget": Delta_t = ceil(Delta_0 * (1 + progress)), progress = clamp(t/T, 0, 1)
    #
    # This schedule is monotonic and increases capacity during pruning, while the exact rank update rule
    # (floor scaling by budget ratio) follows the paper exactly.
    #
    # @param global_step int Current pruning-stage step t (0-based).
    # @param total_pruning_steps int Total pruning-stage steps T.
    # @return int Target global tuning budget Delta_t' as a non-negative integer.
    def compute_budget(self, global_step: int, total_pruning_steps: int) -> int:
        # If no modules exist, budget is 0.
        if not self._modules_by_name:
            self._last_budget = 0
            return 0

        # Use the current budget if pruning-step context is invalid.
        T = int(total_pruning_steps)
        if T <= 0:
            cur = int(self._compute_current_budget())
            self._last_budget = cur
            return cur

        t = int(global_step)
        t = max(0, min(t, T))
        progress = float(t) / float(T)

        mode = str(self._cfg.rank_growth_mode or "linear_budget").strip()
        if mode == "linear_budget":
            # Monotonic linear budget growth from Delta_0 to 2*Delta_0 over pruning stage.
            target = int(math.ceil(float(self._initial_budget) * (1.0 + float(progress))))
        else:
            raise ValueError(
                f"Unsupported apt.rank_growth_mode='{mode}'. "
                "Supported: {'linear_budget'}."
            )

        # Never decrease budget in AT.
        target = max(int(self._initial_budget), int(target))
        self._last_budget = int(target)
        return int(target)

    ## @brief Select the top-half salient APT adapters.
    # @details
    # Implements paper rule: "select the top-half APT adapters after sorting them with salience".
    #
    # Deterministic tie-breaking: sort by importance desc, then module_name asc.
    # If importance is missing for a module, it is treated as 0.0.
    #
    # Top-half size is ceil(n/2) to match "top-half" semantics for odd n.
    #
    # @param adapter_importance dict[str, float] Mapping module_name -> importance scalar.
    # @return list[str] List of selected module names.
    def select_top_half(self, adapter_importance: Dict[str, float]) -> List[str]:
        if not isinstance(adapter_importance, dict):
            raise TypeError(
                f"adapter_importance must be dict[str, float], got {type(adapter_importance)}"
            )

        names = sorted(self._modules_by_name.keys())
        n = len(names)
        if n == 0:
            return []

        scored: List[Tuple[str, float]] = []
        for name in names:
            imp = adapter_importance.get(name, 0.0)
            try:
                imp_f = float(imp)
            except Exception:
                imp_f = 0.0
            if math.isnan(imp_f) or math.isinf(imp_f):
                imp_f = 0.0
            scored.append((name, imp_f))

        scored_sorted = sorted(scored, key=lambda x: (-float(x[1]), str(x[0])))
        k = int(math.ceil(float(n) / 2.0))
        k = max(1, k) if n > 0 else 0
        return [name for name, _ in scored_sorted[:k]]

    ## @brief Expand ranks of selected modules to meet a new global budget.
    # @details
    # Uses paper's exact rank update rule for selected modules:
    #   r'_apt = floor(r_apt * Delta_t' / Delta_t)
    # where Delta_t is the current total tuning budget and Delta_t' is new_budget.
    #
    # Only expands ranks (never shrinks). Non-selected modules are not modified.
    # Returns True if any module rank changed, so the trainer can reset the optimizer
    # (paper/appendix suggests resetting optimizer after parameter size changes).
    #
    # @param selected list[str] Selected module names (typically from select_top_half()).
    # @param new_budget int Target global tuning budget Delta_t'.
    # @return bool True if any module expanded (shape changed), else False.
    def expand_selected_modules(self, selected: List[str], new_budget: int) -> bool:
        if not isinstance(selected, list):
            raise TypeError(f"selected must be list[str], got {type(selected)}")
        target_budget = int(new_budget)
        if target_budget < 0:
            raise ValueError("new_budget must be >= 0.")

        if not selected or not self._modules_by_name:
            return False

        current_budget = int(self._compute_current_budget())
        if current_budget <= 0:
            # Cannot scale from a zero budget; this should not occur for APT with initial rank>0,
            # but we guard for robustness.
            return False

        if target_budget <= current_budget:
            # AT only adds parameters; do not shrink.
            return False

        ratio = float(target_budget) / float(current_budget)
        if ratio <= 1.0:
            return False

        shape_changed = False
        for name in selected:
            mod_name = str(name)
            module = self._modules_by_name.get(mod_name, None)
            if module is None:
                # Skip unknown module name; do not crash.
                continue

            old_rank = int(module.current_rank())
            if old_rank <= 0:
                # If rank is 0 (should not happen given initial_rank=8), the formula yields 0.
                # AT is defined on existing adapters; skip to preserve equation exactness.
                continue

            # Paper Eq (rank update): r' = floor(r * Delta'/Delta)
            new_rank_for_module = int(math.floor(float(old_rank) * float(ratio)))

            # Never shrink; floor could theoretically return <= old_rank.
            if new_rank_for_module <= old_rank:
                continue

            module.expand_rank(new_rank=new_rank_for_module)
            shape_changed = True

        return bool(shape_changed)

    ## @brief Compute current global tuning budget Delta_t from current module parameters.
    # @details Delta_t is interpreted as the sum of tunable parameters in all APT adapters.
    # @return int Current global tuning budget.
    def _compute_current_budget(self) -> int:
        total = 0
        for m in self._registry.list_modules():
            if not isinstance(m, APTLinear):
                continue
            total += int(m.num_tunable_params())
        return int(max(0, total))
