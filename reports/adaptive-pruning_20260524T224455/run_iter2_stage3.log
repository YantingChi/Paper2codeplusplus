## @brief Full experiment configuration dataclass.
# @details Aggregates all sub-configs and provides YAML loading/validation.
@dataclass(frozen=True)
class ExperimentConfig:
    ## @param model ModelConfig Model-related configuration.
    ## @param data DataConfig Dataset and batching configuration.
    ## @param training TrainingConfig Training hyperparameters and optimizer config.
    ## @param apt APTConfig APT pruning/tuning/distillation configuration.
    ## @param evaluation EvalConfig Evaluation and benchmarking configuration.
    ## @param runtime RuntimeConfig Runtime environment configuration.
    model: ModelConfig = dataclasses.field(default_factory=ModelConfig)
    data: DataConfig = dataclasses.field(default_factory=DataConfig)
    training: TrainingConfig = dataclasses.field(default_factory=TrainingConfig)
    apt: APTConfig = dataclasses.field(default_factory=APTConfig)
    evaluation: EvalConfig = dataclasses.field(default_factory=EvalConfig)
    runtime: RuntimeConfig = dataclasses.field(default_factory=RuntimeConfig)

    ## @brief Build config from a YAML file.
    # @details Loads configs/default.yaml and merges with the provided YAML, then applies paper config.yaml rules.
    # @param path str Path to task YAML (e.g., configs/roberta_sst2_apt.yaml).
    # @return ExperimentConfig Fully built and validated experiment config.
    @staticmethod
    def from_yaml(path: str) -> "ExperimentConfig":
        return build_config(path)

    ## @brief Validate configuration consistency.
    # @details Raises ValueError on invalid or inconsistent settings.
    # @return None
    def validate(self) -> None:
        _validate_experiment_config(self)


## @brief Load a YAML file into a Python dict.
# @param path str YAML file path.
# @return dict[str, Any] Parsed YAML content (empty dict if YAML is empty).
def load_yaml(path: str) -> Dict[str, Any]:
    p = Path(path)
    if not p.exists():
        raise FileNotFoundError(f"YAML config not found: {path}")
    with p.open("r", encoding="utf-8") as f:
        data = yaml.safe_load(f)
    if data is None:
        return {}
    if not isinstance(data, dict):
        raise ValueError(f"YAML root must be a mapping: {path}")
    return data


## @brief Recursively merge two dictionaries.
# @details Values from override take precedence. Dicts are merged recursively; lists/scalars replaced.
# @param base dict[str, Any] Base dictionary.
# @param override dict[str, Any] Override dictionary.
# @return dict[str, Any] Merged dictionary.
def deep_merge_dicts(base: Dict[str, Any], override: Dict[str, Any]) -> Dict[str, Any]:
    merged: Dict[str, Any] = copy.deepcopy(base)
    for k, v in override.items():
        if k in merged and isinstance(merged[k], dict) and isinstance(v, dict):
            merged[k] = deep_merge_dicts(merged[k], v)
        else:
            merged[k] = copy.deepcopy(v)
    return merged


## @brief Build an ExperimentConfig from task YAML merged with default and paper configs.
# @details Uses configs/default.yaml as base, merges the task config, then applies config.yaml paper rules.
# @param path str Task config YAML path.
# @return ExperimentConfig Fully specified configuration.
def build_config(path: str) -> ExperimentConfig:
    repo_root = _find_repo_root(Path(path).resolve())
    default_path = repo_root / "configs" / "default.yaml"
    paper_cfg_path = repo_root / "config.yaml"

    base = load_yaml(str(default_path)) if default_path.exists() else {}
    override = load_yaml(path)
    merged = deep_merge_dicts(base, override)

    paper_cfg = load_yaml(str(paper_cfg_path))
    merged = _apply_paper_config_yaml(merged, paper_cfg)

    cfg = _dict_to_experiment_config(merged)
    cfg = _normalize_config(cfg, paper_cfg)
    cfg.validate()
    return cfg


## @brief Find repository root by locating config.yaml.
# @param start_path Path Starting path.
# @return Path Repository root path.
def _find_repo_root(start_path: Path) -> Path:
    cur = start_path if start_path.is_dir() else start_path.parent
    for _ in range(20):
        if (cur / "config.yaml").exists():
            return cur
        if cur.parent == cur:
            break
        cur = cur.parent
    raise FileNotFoundError(
        f"Could not locate repository root containing config.yaml from: {start_path}"
    )


## @brief Convert merged dict to ExperimentConfig dataclass tree.
# @param cfg dict[str, Any] Merged config dictionary.
# @return ExperimentConfig Parsed config dataclass instance.
def _dict_to_experiment_config(cfg: Dict[str, Any]) -> ExperimentConfig:
    model_d = _ensure_dict(cfg.get("model", {}), "model")
    data_d = _ensure_dict(cfg.get("data", {}), "data")
    training_d = _ensure_dict(cfg.get("training", {}), "training")
    apt_d = _ensure_dict(cfg.get("apt", {}), "apt")
    eval_d = _ensure_dict(cfg.get("evaluation", {}), "evaluation")
    runtime_d = _ensure_dict(cfg.get("runtime", {}), "runtime")

    model = ModelConfig(
        backbone_name=str(model_d.get("backbone_name", ModelConfig.backbone_name)),
        task_type=str(model_d.get("task_type", ModelConfig.task_type)),
        max_length=int(model_d.get("max_length", ModelConfig.max_length)),
        num_labels=int(model_d.get("num_labels", ModelConfig.num_labels)),
        use_ffn_adapters=bool(model_d.get("use_ffn_adapters", ModelConfig.use_ffn_adapters)),
        trust_remote_code=bool(model_d.get("trust_remote_code", ModelConfig.trust_remote_code)),
    )

    data = DataConfig(
        dataset_name=str(data_d.get("dataset_name", DataConfig.dataset_name)),
        dataset_config_name=str(data_d.get("dataset_config_name", DataConfig.dataset_config_name)),
        train_split=str(data_d.get("train_split", DataConfig.train_split)),
        validation_split=str(data_d.get("validation_split", DataConfig.validation_split)),
        text_fields=list(data_d.get("text_fields", copy.deepcopy(DataConfig.text_fields))),
        label_field=str(data_d.get("label_field", DataConfig.label_field)),
        max_source_length=int(data_d.get("max_source_length", DataConfig.max_source_length)),
        max_target_length=int(data_d.get("max_target_length", DataConfig.max_target_length)),
        batch_size=int(data_d.get("batch_size", DataConfig.batch_size)),
        eval_batch_size=int(data_d.get("eval_batch_size", DataConfig.eval_batch_size)),
    )

    distill_epochs_val = training_d.get("distill_epochs", TrainingConfig.distill_epochs)
    distill_epochs = 0 if distill_epochs_val is None else int(distill_epochs_val)

    training = TrainingConfig(
        learning_rate=float(training_d.get("learning_rate", TrainingConfig.learning_rate)),
        weight_decay=float(training_d.get("weight_decay", TrainingConfig.weight_decay)),
        num_epochs=int(training_d.get("num_epochs", TrainingConfig.num_epochs)),
        distill_epochs=distill_epochs,
        gradient_accumulation_steps=int(
            training_d.get("gradient_accumulation_steps", TrainingConfig.gradient_accumulation_steps)
        ),
        warmup_ratio=float(training_d.get("warmup_ratio", TrainingConfig.warmup_ratio)),
        max_grad_norm=float(training_d.get("max_grad_norm", TrainingConfig.max_grad_norm)),
        optimizer_name=str(training_d.get("optimizer_name", TrainingConfig.optimizer_name)),
        lr_scheduler_type=str(training_d.get("lr_scheduler_type", TrainingConfig.lr_scheduler_type)),
        fp16=bool(training_d.get("fp16", TrainingConfig.fp16)),
        bf16=bool(training_d.get("bf16", TrainingConfig.bf16)),
        eval_every_steps=int(training_d.get("eval_every_steps", TrainingConfig.eval_every_steps)),
        save_every_steps=int(training_d.get("save_every_steps", TrainingConfig.save_every_steps)),
        seed=int(training_d.get("seed", TrainingConfig.seed)),
    )

    apt = APTConfig(
        enable_apt=bool(apt_d.get("enable_apt", APTConfig.enable_apt)),
        target_sparsity=float(apt_d.get("target_sparsity", APTConfig.target_sparsity)),
        initial_rank=int(apt_d.get("initial_rank", APTConfig.initial_rank)),
        lora_alpha=float(apt_d.get("lora_alpha", APTConfig.lora_alpha)),
        mask_update_step=float(apt_d.get("mask_update_step", APTConfig.mask_update_step)),
        salience_ema_beta=float(apt_d.get("salience_ema_beta", APTConfig.salience_ema_beta)),
        pruning_stage_ratio=float(apt_d.get("pruning_stage_ratio", APTConfig.pruning_stage_ratio)),
        rank_update_interval=int(apt_d.get("rank_update_interval", APTConfig.rank_update_interval)),
        prune_update_interval=int(apt_d.get("prune_update_interval", APTConfig.prune_update_interval)),
        rank_growth_mode=str(apt_d.get("rank_growth_mode", APTConfig.rank_growth_mode)),
        use_kurtosis=bool(apt_d.get("use_kurtosis", APTConfig.use_kurtosis)),
        use_self_distill=bool(apt_d.get("use_self_distill", APTConfig.use_self_distill)),
        distill_mu_schedule=str(apt_d.get("distill_mu_schedule", APTConfig.distill_mu_schedule)),
        teacher_share_frozen=bool(apt_d.get("teacher_share_frozen", APTConfig.teacher_share_frozen)),
        apply_on_modules=list(apt_d.get("apply_on_modules", copy.deepcopy(APTConfig.apply_on_modules))),
    )

    evaluation = EvalConfig(
        metrics=list(eval_d.get("metrics", copy.deepcopy(EvalConfig.metrics))),
        measure_train_peak_memory=bool(
            eval_d.get("measure_train_peak_memory", EvalConfig.measure_train_peak_memory)
        ),
        measure_inference_peak_memory=bool(
            eval_d.get("measure_inference_peak_memory", EvalConfig.measure_inference_peak_memory)
        ),
        measure_throughput=bool(eval_d.get("measure_throughput", EvalConfig.measure_throughput)),
        lm_eval_tasks=list(eval_d.get("lm_eval_tasks", copy.deepcopy(EvalConfig.lm_eval_tasks))),
        lm_eval_num_fewshot=dict(
            eval_d.get("lm_eval_num_fewshot", copy.deepcopy(EvalConfig.lm_eval_num_fewshot))
        ),
    )

    runtime = RuntimeConfig(
        output_dir=str(runtime_d.get("output_dir", RuntimeConfig.output_dir)),
        device=str(runtime_d.get("device", RuntimeConfig.device)),
        num_workers=int(runtime_d.get("num_workers", RuntimeConfig.num_workers)),
        pin_memory=bool(runtime_d.get("pin_memory", RuntimeConfig.pin_memory)),
        compile_model=bool(runtime_d.get("compile_model", RuntimeConfig.compile_model)),
        gradient_checkpointing=bool(
            runtime_d.get("gradient_checkpointing", RuntimeConfig.gradient_checkpointing)
        ),
        log_level=str(runtime_d.get("log_level", RuntimeConfig.log_level)),
    )

    return ExperimentConfig(
        model=model,
        data=data,
        training=training,
        apt=apt,
        evaluation=evaluation,
        runtime=runtime,
    )


## @brief Ensure object is a dict.
# @param obj Any Object to check.
# @param name str Section name for error messages.
# @return dict[str, Any] The same object cast as dict if valid.
def _ensure_dict(obj: Any, name: str) -> Dict[str, Any]:
    if obj is None:
        return {}
    if not isinstance(obj, dict):
        raise ValueError(f"Config section '{name}' must be a mapping/dict.")
    return obj


## @brief Apply paper config.yaml values into the merged config dict.
# @details This function maps values from the provided paper config.yaml into the runtime schema.
# @param merged dict[str, Any] Merged (default + task) config dict.
# @param paper_cfg dict[str, Any] Parsed config.yaml dict.
# @return dict[str, Any] Updated config dict.
def _apply_paper_config_yaml(merged: Dict[str, Any], paper_cfg: Dict[str, Any]) -> Dict[str, Any]:
    out = copy.deepcopy(merged)

    apt_paper = _ensure_dict(paper_cfg.get("apt", {}), "config.yaml:apt")
    distill_paper = _ensure_dict(paper_cfg.get("distillation", {}), "config.yaml:distillation")
    eval_paper = _ensure_dict(paper_cfg.get("evaluation", {}), "config.yaml:evaluation")

    out.setdefault("apt", {})
    out.setdefault("training", {})
    out.setdefault("evaluation", {})
    out.setdefault("runtime", {})
    out.setdefault("model", {})
    out.setdefault("data", {})

    # APT hard facts from paper config.yaml (do not fabricate).
    out["apt"].setdefault("initial_rank", apt_paper.get("initial_rank", 8))
    out["apt"].setdefault("lora_alpha", apt_paper.get("scaling_factor", 2))
    out["apt"].setdefault("mask_update_step", apt_paper.get("mask_update_alpha", 0.01))

    # Distillation policy defaults from paper config.yaml.
    out["apt"].setdefault(
        "distill_mu_schedule", distill_paper.get("mu_schedule", "linear_0_to_1")
    )
    teacher_setup = _ensure_dict(distill_paper.get("teacher_setup", {}), "config.yaml:distillation.teacher_setup")
    out["apt"].setdefault(
        "teacher_share_frozen", bool(teacher_setup.get("frozen_parameters_shared", True))
    )

    # Outlier-aware salience (kurtosis) is part of paper method; default enable.
    out["apt"].setdefault("use_kurtosis", True)

    # Evaluation measurement flags: keep defaults if not specified by configs/default.yaml.
    # config.yaml lists metric types but not boolean toggles; we keep schema defaults elsewhere.

    # Default lm-eval fewshot mapping per paper.
    # Do not overwrite if task config already sets.
    lm_tasks_default = ["arc_challenge", "hellaswag", "mmlu", "truthfulqa_mc"]
    fewshot_default = {
        "arc_challenge": 25,
        "hellaswag": 10,
        "mmlu": 5,
        "truthfulqa_mc": 0,
    }
    out["evaluation"].setdefault("lm_eval_tasks", lm_tasks_default)
    out["evaluation"].setdefault("lm_eval_num_fewshot", fewshot_default)

    # Note: batch sizes/epochs/lr are task-family dependent and are applied in normalization.
    # Inference batch size defaults per model are also applied in normalization.
    _ = eval_paper  # present for completeness; actual mapping in normalization.

    return out


## @brief Normalize merged ExperimentConfig with paper rules to fill derived fields.
# @details Applies task-family training hyperparameters, model-scale policies, and metric normalization.
# @param cfg ExperimentConfig Parsed config dataclass.
# @param paper_cfg dict[str, Any] Parsed config.yaml dict.
# @return ExperimentConfig Normalized configuration.
def _normalize_config(cfg: ExperimentConfig, paper_cfg: Dict[str, Any]) -> ExperimentConfig:
    model_family = _infer_model_family(cfg.model.backbone_name)
    task_family = _infer_task_family(cfg.data.dataset_name, cfg.data.dataset_config_name)
    is_small_model = model_family in ("bert", "roberta", "t5")
    is_llama = model_family == "llama"

    paper_training = _ensure_dict(paper_cfg.get("training", {}), "config.yaml:training")
    paper_apt = _ensure_dict(paper_cfg.get("apt", {}), "config.yaml:apt")
    paper_distill = _ensure_dict(paper_cfg.get("distillation", {}), "config.yaml:distillation")
    paper_eval = _ensure_dict(paper_cfg.get("evaluation", {}), "config.yaml:evaluation")

    # Resolve training hyperparameters exactly as given in config.yaml by task family.
    lr_map = _ensure_dict(paper_training.get("learning_rate", {}), "config.yaml:training.learning_rate")
    bs_map = _ensure_dict(paper_training.get("batch_size", {}), "config.yaml:training.batch_size")
    ep_map = _ensure_dict(paper_training.get("epochs", {}), "config.yaml:training.epochs")
    de_map = _ensure_dict(paper_training.get("distill_epochs", {}), "config.yaml:training.distill_epochs")

    learning_rate = float(_must_get_map_value(lr_map, task_family, f"training.learning_rate[{task_family}]"))
    train_batch_size = int(_must_get_map_value(bs_map, task_family, f"training.batch_size[{task_family}]"))
    num_epochs = int(_must_get_map_value(ep_map, task_family, f"training.epochs[{task_family}]"))
    distill_epochs_val = de_map.get(task_family, None)
    distill_epochs = 0 if distill_epochs_val is None else int(distill_epochs_val)

    # Update TrainingConfig (preserve other fields from defaults/task config).
    training = dataclasses.replace(
        cfg.training,
        learning_rate=learning_rate,
        num_epochs=num_epochs,
        distill_epochs=distill_epochs,
    )

    # Update DataConfig batch_size if not explicitly overridden away from paper.
    # We enforce paper batch size as provided by config.yaml.
    data = dataclasses.replace(cfg.data, batch_size=train_batch_size)

    # Evaluation batch size based on paper config.yaml.
    inf_bs = _ensure_dict(paper_eval.get("inference_batch_size", {}), "config.yaml:evaluation.inference_batch_size")
    if is_llama:
        if "13b" in cfg.model.backbone_name.lower():
            eval_bs = int(_must_get_map_value(inf_bs, "llama_13b", "evaluation.inference_batch_size.llama_13b"))
        else:
            eval_bs = int(_must_get_map_value(inf_bs, "llama_7b", "evaluation.inference_batch_size.llama_7b"))
    else:
        eval_bs = int(_must_get_map_value(inf_bs, "small_models", "evaluation.inference_batch_size.small_models"))
    data = dataclasses.replace(data, eval_batch_size=eval_bs)

    # APT adapter targets by model scale (paper config.yaml apt.apt_adapter_targets).
    targets = _ensure_dict(paper_apt.get("apt_adapter_targets", {}), "config.yaml:apt.apt_adapter_targets")
    small_targets = list(_must_get_map_value(targets, "small_models", "apt.apt_adapter_targets.small_models"))
    large_targets = list(_must_get_map_value(targets, "large_models", "apt.apt_adapter_targets.large_models"))
    apply_on_modules = small_targets if is_small_model else large_targets

    # APT + distillation enablement by model scale (paper config.yaml).
    enabled_small = bool(_must_get_map_value(
        paper_distill, "enabled_for_small_models", "distillation.enabled_for_small_models"
    ))
    enabled_large = bool(_must_get_map_value(
        paper_distill, "enabled_for_large_models", "distillation.enabled_for_large_models"
    ))

    use_self_distill = enabled_small if is_small_model else enabled_large

    # Derive use_ffn_adapters default for model families per plan/paper (small models use FFN adapters).
    # Task config may override model.use_ffn_adapters but we keep it consistent with apply_on_modules.
    use_ffn_adapters = cfg.model.use_ffn_adapters
    if is_llama:
        use_ffn_adapters = False

    # Normalize APTConfig naming mapped from paper config.yaml already applied:
    # - initial_rank
    # - lora_alpha (scaling_factor)
    # - mask_update_step (mask_update_alpha)
    apt = dataclasses.replace(
        cfg.apt,
        apply_on_modules=cfg.apt.apply_on_modules or apply_on_modules,
        use_self_distill=cfg.apt.use_self_distill if "use_self_distill" in dataclasses.asdict(cfg.apt) else use_self_distill,
    )

    # If task config didn't set use_self_distill explicitly, enforce paper default by model size.
    if "use_self_distill" not in _raw_section_keys(cfg, "apt"):
        apt = dataclasses.replace(apt, use_self_distill=use_self_distill)

    # If task config didn't set enable_apt explicitly, keep existing default.
    # Enforce paper initial_rank / scaling_factor / mask alpha from config.yaml already set via apply_paper_config_yaml.

    # Enforce module FFN adapter compatibility.
    model = dataclasses.replace(cfg.model, use_ffn_adapters=use_ffn_adapters)

    # Metric normalization.
    evaluation = dataclasses.replace(cfg.evaluation, metrics=_normalize_metric_names(cfg.evaluation.metrics))

    # Normalize output directory to an absolute-ish path under repo root by default.
    output_dir = cfg.runtime.output_dir
    if not os.path.isabs(output_dir):
        repo_root = _find_repo_root(Path.cwd())
        output_dir = str((repo_root / output_dir).resolve())
    runtime = dataclasses.replace(cfg.runtime, output_dir=output_dir)

    return ExperimentConfig(
        model=model,
        data=data,
        training=training,
        apt=apt,
        evaluation=evaluation,
        runtime=runtime,
    )


## @brief Infer model family from backbone name.
# @param backbone_name str Model name.
# @return str One of {'bert','roberta','t5','llama'}.
def _infer_model_family(backbone_name: str) -> str:
    name = backbone_name.lower()
    if "roberta" in name:
        return "roberta"
    if "t5" in name:
        return "t5"
    if "llama" in name:
        return "llama"
    if "bert" in name:
        return "bert"
    raise ValueError(f"Cannot infer model family from backbone_name='{backbone_name}'")


## @brief Infer task family used for selecting paper training hyperparameters.
# @details Uses paper grouping: GLUE-big = {mnli,sst2,qnli,qqp}, GLUE-small={mrpc,cola,rte,stsb}.
# @param dataset_name str Dataset name.
# @param dataset_config_name str Dataset config name.
# @return str Task family key in config.yaml training maps.
def _infer_task_family(dataset_name: str, dataset_config_name: str) -> str:
    dn = dataset_name.lower().strip()
    dcn = dataset_config_name.lower().strip()
    if dn == "glue":
        glue_big = {"mnli", "sst2", "qnli", "qqp"}
        glue_small = {"mrpc", "cola", "rte", "stsb"}
        if dcn in glue_big:
            return "glue_big"
        if dcn in glue_small:
            return "glue_small"
        # Default to big if unknown GLUE task (paper defines split; we choose conservative).
        return "glue_big"
    if dn in {"squad_v2", "squad"} or dcn in {"squad_v2"}:
        return "squad"
    if dn in {"cnn_dailymail", "cnndm"} or dcn in {"cnn_dailymail", "3.0.0"}:
        return "cnndm"
    if dn in {"alpaca"}:
        return "alpaca"
    raise ValueError(f"Cannot infer task family from dataset_name='{dataset_name}', dataset_config_name='{dataset_config_name}'")


## @brief Normalize metric names to consistent internal identifiers.
# @param metrics list[str] Input metric names.
# @return list[str] Normalized metric names.
def _normalize_metric_names(metrics: List[str]) -> List[str]:
    norm: List[str] = []
    for m in metrics:
        key = str(m).strip()
        low = key.lower()
        if low in {"dev_accuracy", "accuracy"}:
            norm.append("accuracy")
        elif low in {"dev_f1", "f1"}:
            norm.append("f1")
        elif low in {"rouge1"}:
            norm.append("rouge1")
        elif low in {"rouge2"}:
            norm.append("rouge2")
        elif low in {"rougel", "rouge_l", "rouge-l"}:
            norm.append("rougeL")
        else:
            norm.append(key)
    # preserve order, drop duplicates
    seen = set()
    out: List[str] = []
    for m in norm:
        if m not in seen:
            out.append(m)
            seen.add(m)
    return out


## @brief Get map value or raise.
# @param mp Mapping[str, Any] Mapping.
# @param key str Key.
# @param name str Human-readable name.
# @return Any Retrieved value.
def _must_get_map_value(mp: Mapping[str, Any], key: str, name: str) -> Any:
    if key not in mp:
        raise ValueError(f"Missing required config.yaml entry: {name}")
    return mp[key]


## @brief Validate the full ExperimentConfig.
# @param cfg ExperimentConfig Experiment config to validate.
# @return None
def _validate_experiment_config(cfg: ExperimentConfig) -> None:
    # Model validation.
    if not cfg.model.backbone_name:
        raise ValueError("model.backbone_name must be set.")
    if cfg.model.task_type not in {
        "sequence_classification",
        "question_answering",
        "seq2seq",
        "causal_lm",
    }:
        raise ValueError(f"model.task_type invalid: {cfg.model.task_type}")
    if cfg.model.max_length <= 0:
        raise ValueError("model.max_length must be > 0.")
    if cfg.model.task_type == "sequence_classification" and cfg.model.num_labels < 2:
        raise ValueError("model.num_labels must be >= 2 for sequence classification.")
    if cfg.model.task_type in {"seq2seq", "causal_lm"} and cfg.model.num_labels < 1:
        # num_labels isn't used, but keep it well-formed.
        raise ValueError("model.num_labels must be >= 1.")

    family = _infer_model_family(cfg.model.backbone_name)
    if family == "llama" and cfg.model.task_type != "causal_lm":
        raise ValueError("LLaMA backbones must use task_type='causal_lm'.")

    # Data validation.
    if not cfg.data.dataset_name:
        raise ValueError("data.dataset_name must be set.")
    if cfg.data.batch_size <= 0:
        raise ValueError("data.batch_size must be > 0.")
    if cfg.data.eval_batch_size <= 0:
        raise ValueError("data.eval_batch_size must be > 0.")
    if cfg.model.task_type == "seq2seq":
        if cfg.data.max_source_length <= 0 or cfg.data.max_target_length <= 0:
            raise ValueError("max_source_length and max_target_length must be > 0 for seq2seq.")
    if cfg.model.task_type == "causal_lm":
        if cfg.data.max_source_length <= 0:
            raise ValueError("max_source_length must be > 0 for causal_lm.")

    # Training validation.
    if cfg.training.learning_rate <= 0:
        raise ValueError("training.learning_rate must be > 0.")
    if cfg.training.num_epochs <= 0:
        raise ValueError("training.num_epochs must be > 0.")
    if cfg.training.distill_epochs < 0:
        raise ValueError("training.distill_epochs must be >= 0.")
    if cfg.training.distill_epochs > cfg.training.num_epochs:
        raise ValueError("training.distill_epochs must be <= training.num_epochs.")
    if cfg.training.gradient_accumulation_steps < 1:
        raise ValueError("training.gradient_accumulation_steps must be >= 1.")
    if not (0.0 <= cfg.training.warmup_ratio < 1.0):
        raise ValueError("training.warmup_ratio must be in [0, 1).")
    if cfg.training.max_grad_norm <= 0:
        raise ValueError("training.max_grad_norm must be > 0.")
    if cfg.training.fp16 and cfg.training.bf16:
        raise ValueError("Only one of training.fp16 or training.bf16 can be true.")
    if cfg.training.eval_every_steps <= 0:
        raise ValueError("training.eval_every_steps must be > 0.")
    if cfg.training.save_every_steps <= 0:
        raise ValueError("training.save_every_steps must be > 0.")

    # APT validation.
    if cfg.apt.enable_apt:
        if not (0.0 <= cfg.apt.target_sparsity < 1.0):
            raise ValueError("apt.target_sparsity must be in [0,1).")
        if cfg.apt.target_sparsity <= 0.0:
            raise ValueError(
                "apt.target_sparsity must be explicitly set to a positive sparsity for APT experiments."
            )
        if cfg.apt.initial_rank <= 0:
            raise ValueError("apt.initial_rank must be > 0.")
        if cfg.apt.lora_alpha <= 0:
            raise ValueError("apt.lora_alpha must be > 0.")
        if cfg.apt.mask_update_step <= 0:
            raise ValueError("apt.mask_update_step must be > 0.")
        if not (0.0 <= cfg.apt.salience_ema_beta < 1.0):
            raise ValueError("apt.salience_ema_beta must be in [0,1).")
        if cfg.apt.rank_update_interval <= 0:
            raise ValueError("apt.rank_update_interval must be > 0.")
        if cfg.apt.prune_update_interval <= 0:
            raise ValueError("apt.prune_update_interval must be > 0.")
        if not cfg.apt.apply_on_modules:
            raise ValueError("apt.apply_on_modules must be non-empty when apt.enable_apt is true.")

        if cfg.model.use_ffn_adapters and "ffn_layers" not in cfg.apt.apply_on_modules:
            raise ValueError(
                "model.use_ffn_adapters is true but 'ffn_layers' not present in apt.apply_on_modules."
            )
        if (not cfg.model.use_ffn_adapters) and ("ffn_layers" in cfg.apt.apply_on_modules):
            raise ValueError(
                "model.use_ffn_adapters is false but 'ffn_layers' present in apt.apply_on_modules."
            )

    # Evaluation validation.
    if cfg.model.task_type == "causal_lm":
        if not cfg.evaluation.lm_eval_tasks:
            raise ValueError("evaluation.lm_eval_tasks must be set for causal_lm experiments.")
        if not cfg.evaluation.lm_eval_num_fewshot:
            raise ValueError("evaluation.lm_eval_num_fewshot must be set for causal_lm experiments.")
        for t in cfg.evaluation.lm_eval_tasks:
            if t not in cfg.evaluation.lm_eval_num_fewshot:
                raise ValueError(f"Missing fewshot setting for lm-eval task: {t}")
    else:
        if not cfg.evaluation.metrics:
            raise ValueError("evaluation.metrics must be non-empty for non-causal_lm experiments.")

    # Runtime validation.
    if not cfg.runtime.output_dir:
        raise ValueError("runtime.output_dir must be set.")
    if not cfg.runtime.device:
        raise ValueError("runtime.device must be set.")
    if cfg.runtime.num_workers < 0:
        raise ValueError("runtime.num_workers must be >= 0.")


## @brief Return raw config section keys if available.
# @details This checks whether the dataclass field was set explicitly is not directly knowable after merge;
#          we approximate by inspecting the merged YAML via env var if provided. If not provided, return empty set.
# @param cfg ExperimentConfig Parsed config object.
# @param section str Section name.
# @return set[str] Keys explicitly provided by YAML for the section if available.
def _raw_section_keys(cfg: ExperimentConfig, section: str) -> set:
    # This project keeps config building deterministic from YAML merge; we do not persist provenance.
    # Returning empty set means normalization will apply paper defaults when needed.
    _ = cfg
    _ = section
    return set()
