## src/models/model_factory.py
from __future__ import annotations

from typing import Any, Optional

from transformers import (
    AutoConfig,
    AutoModelForCausalLM,
    AutoModelForQuestionAnswering,
    AutoModelForSeq2SeqLM,
    AutoModelForSequenceClassification,
)

from src.config import APTConfig, ModelConfig
from src.models.apt_injector import APTInjector, APTModelWrapper


## @brief Factory for creating Hugging Face models and optionally injecting APT adapters.
# @details
# Centralizes backbone/task branching and APT injection as required by the project design.
#
# Task-type mapping (paper-aligned):
# - sequence_classification: RoBERTa/BERT on GLUE (SST-2/MNLI): AutoModelForSequenceClassification
# - question_answering: RoBERTa on SQuAD v2.0: AutoModelForQuestionAnswering
# - seq2seq: T5 (incl. t5-lm-adapt) on CNN/DM and optionally GLUE-as-generation: AutoModelForSeq2SeqLM
# - causal_lm: LLaMA(-2) on Alpaca + lm-eval-harness: AutoModelForCausalLM
#
# APT injection:
# - If apt.enable_apt is True, wraps the created model with APTModelWrapper after APTInjector.inject().
# - Target module selection is delegated to APTInjector, which is config-driven.
class ModelFactory:
    ## @brief Initialize the model factory.
    # @param model_config ModelConfig Model configuration controlling backbone and task head selection.
    def __init__(self, model_config: ModelConfig) -> None:
        if not isinstance(model_config, ModelConfig):
            raise TypeError(f"model_config must be ModelConfig, got {type(model_config)}")
        self._model_cfg: ModelConfig = model_config

    ## @brief Create the base Hugging Face model for the configured task.
    # @details
    # Uses the exact pretrained identifier from ModelConfig.backbone_name and the correct task head
    # per ModelConfig.task_type. Does not inject APT; use create_model_for_task() for that.
    # @return Any A transformers model instance appropriate for the task.
    def create_base_model(self) -> Any:
        backbone_name = str(self._model_cfg.backbone_name).strip()
        if not backbone_name:
            raise ValueError("model.backbone_name must be non-empty.")

        task_type = str(self._model_cfg.task_type).strip()
        trust_remote_code = bool(self._model_cfg.trust_remote_code)

        model_family = _infer_model_family(backbone_name=backbone_name)
        _validate_backbone_task_compatibility(model_family=model_family, task_type=task_type)

        # Load config first to allow overriding num_labels where applicable.
        hf_config = AutoConfig.from_pretrained(
            backbone_name,
            trust_remote_code=trust_remote_code,
        )

        # Configure task head specifics as needed.
        if task_type == "sequence_classification":
            num_labels = int(self._model_cfg.num_labels)
            if num_labels < 2:
                raise ValueError("model.num_labels must be >= 2 for sequence_classification.")
            hf_config.num_labels = num_labels
            model = AutoModelForSequenceClassification.from_pretrained(
                backbone_name,
                config=hf_config,
                trust_remote_code=trust_remote_code,
            )
            return model

        if task_type == "question_answering":
            model = AutoModelForQuestionAnswering.from_pretrained(
                backbone_name,
                config=hf_config,
                trust_remote_code=trust_remote_code,
            )
            return model

        if task_type == "seq2seq":
            model = AutoModelForSeq2SeqLM.from_pretrained(
                backbone_name,
                config=hf_config,
                trust_remote_code=trust_remote_code,
            )
            return model

        if task_type == "causal_lm":
            model = AutoModelForCausalLM.from_pretrained(
                backbone_name,
                config=hf_config,
                trust_remote_code=trust_remote_code,
            )
            return model

        raise ValueError(
            "Unsupported model.task_type. Expected one of "
            "{'sequence_classification','question_answering','seq2seq','causal_lm'}, "
            f"got '{task_type}'."
        )

    ## @brief Create the model for the configured task, optionally injecting APT.
    # @details
    # This is the project-standard creation entrypoint. If apt_config.enable_apt is True, this:
    #  1) creates the base task model
    #  2) injects APTLinear modules via APTInjector (config-driven targets)
    #  3) returns an APTModelWrapper
    #
    # If apt_config is None or apt_config.enable_apt is False, returns the base model.
    # @param apt_config Optional[APTConfig] APT configuration controlling injection.
    # @return Any Model instance; returns APTModelWrapper when APT is enabled.
    def create_model_for_task(self, apt_config: Optional[APTConfig] = None) -> Any:
        base_model = self.create_base_model()

        if apt_config is None:
            return base_model
        if not isinstance(apt_config, APTConfig):
            raise TypeError(f"apt_config must be APTConfig or None, got {type(apt_config)}")

        if not bool(apt_config.enable_apt):
            return base_model

        injector = APTInjector(apt_config=apt_config)
        wrapped: APTModelWrapper = injector.inject(model=base_model)
        return wrapped


## @brief Infer model family from the backbone name string.
# @param backbone_name str Hugging Face model id or local path.
# @return str One of {'bert','roberta','t5','llama'}.
def _infer_model_family(backbone_name: str) -> str:
    name = str(backbone_name).lower()
    if "roberta" in name:
        return "roberta"
    if "bert" in name:
        return "bert"
    if "t5" in name:
        return "t5"
    if "llama" in name:
        return "llama"
    raise ValueError(f"Cannot infer model family from backbone_name='{backbone_name}'")


## @brief Validate backbone/task compatibility to prevent unintended experiment setups.
# @details
# Fails early on obvious mismatches, improving reproducibility.
# @param model_family str Model family inferred from backbone name.
# @param task_type str Task type from ModelConfig.task_type.
# @return None
def _validate_backbone_task_compatibility(model_family: str, task_type: str) -> None:
    fam = str(model_family)
    t = str(task_type)

    if fam == "llama" and t != "causal_lm":
        raise ValueError("LLaMA backbones must use task_type='causal_lm' (paper setup).")

    if fam in {"bert", "roberta"} and t not in {"sequence_classification", "question_answering"}:
        raise ValueError(
            f"{fam} backbones are encoder-only; expected task_type in "
            "{'sequence_classification','question_answering'} for paper tasks, got '{t}'."
        )

    if fam == "t5" and t != "seq2seq":
        raise ValueError(
            "T5 backbones must use task_type='seq2seq' in this project. "
            "This aligns with the reproduction choice to run T5 tasks in text-to-text form."
        )

    if t not in {"sequence_classification", "question_answering", "seq2seq", "causal_lm"}:
        raise ValueError(f"Unsupported task_type '{t}'.")
