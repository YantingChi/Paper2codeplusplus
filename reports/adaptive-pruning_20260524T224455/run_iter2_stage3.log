## configs/t5_sst2_apt.yaml
#
# Task-specific experiment configuration for reproducing APT on T5 over SST-2.
# This YAML follows the project schema defined in src/config.py and the
# "Data structures and interfaces" section of the design.
#
# Key paper-aligned choices:
# - Use T5 in text-to-text (seq2seq) mode for SST-2 ("positive"/"negative").
# - Use t5-lm-adapt checkpoint for fair comparison (paper note).
# - Enable APT adapters for attention query/value and FFN layers for small models (paper Sec 4.1).
# - Use cubic target sparsity schedule (paper) with final target sparsity set here.
# - Gradual mask updates with alpha=0.01 (paper Appendix C).
# - Initial LoRA/APT rank=8, scaling factor=2 (paper + config.yaml).
# - Self-distillation enabled for small models (config.yaml), mu schedule linear 0->1 (paper Sec 4.4).
#
# IMPORTANT: Some hyperparameters (e.g., warmup ratio, weight decay, EMA beta, update intervals)
# are not explicitly specified in the parsed paper/config.yaml; project defaults are set in
# configs/default.yaml. This file only overrides task-specific and paper-explicit values and
# leaves the rest to defaults.

model:
  backbone_name: "google/t5-base-lm-adapt"
  task_type: "seq2seq"
  max_length: 128
  num_labels: 2
  use_ffn_adapters: true
  trust_remote_code: false

data:
  dataset_name: "glue"
  dataset_config_name: "sst2"
  train_split: "train"
  validation_split: "validation"
  text_fields: ["sentence"]
  label_field: "label"
  max_source_length: 128
  max_target_length: 8
  batch_size: 32
  eval_batch_size: 128

training:
  learning_rate: 2.0e-4
  batch_size: 32
  num_epochs: 40
  distill_epochs: 20

apt:
  enable_apt: true
  initial_rank: 8
  lora_alpha: 2.0
  target_sparsity: 0.60
  mask_update_step: 0.01
  # For T5 (encoder-decoder), include encoder self-attn, decoder self-attn, decoder cross-attn,
  # and FFN projections. Naming is pattern-matched by the injector; these strings are treated
  # as module-name substrings/patterns.
  apply_on_modules:
    - "encoder.block.*.layer.0.SelfAttention.q"
    - "encoder.block.*.layer.0.SelfAttention.v"
    - "decoder.block.*.layer.0.SelfAttention.q"
    - "decoder.block.*.layer.0.SelfAttention.v"
    - "decoder.block.*.layer.1.EncDecAttention.q"
    - "decoder.block.*.layer.1.EncDecAttention.v"
    - "encoder.block.*.layer.1.DenseReluDense"   # gated FFN module container (up/gate/down live under this)
    - "decoder.block.*.layer.2.DenseReluDense"

evaluation:
  metrics: ["accuracy"]

runtime:
  output_dir: "outputs/t5_sst2_apt"
