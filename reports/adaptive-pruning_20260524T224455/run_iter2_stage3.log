## src/utils/seed.py
from __future__ import annotations

import os
import random
from typing import Optional

import numpy as np
import torch


## @brief Set all relevant RNG seeds for reproducible experiments.
# @details
# Seeds Python's `random`, NumPy, and PyTorch (CPU and CUDA). Also sets PYTHONHASHSEED.
# If `deterministic=True`, attempts to enable deterministic algorithms in PyTorch and
# configures cuDNN to deterministic mode.
#
# Notes:
# - PYTHONHASHSEED ideally must be set before Python starts to fully take effect, but
#   setting it here still improves stability for some workflows.
# - Deterministic mode can reduce training/inference speed and may raise errors if some
#   operations do not have deterministic implementations.
# @param seed int Random seed value.
# @param deterministic bool Whether to enable deterministic behavior in PyTorch/cuDNN.
# @return None
def set_global_seed(seed: int, deterministic: bool = False) -> None:
    if not isinstance(seed, int):
        raise TypeError(f"seed must be int, got {type(seed)}")

    os.environ["PYTHONHASHSEED"] = str(seed)

    random.seed(seed)
    np.random.seed(seed)

    torch.manual_seed(seed)

    if torch.cuda.is_available():
        torch.cuda.manual_seed(seed)
        torch.cuda.manual_seed_all(seed)

    _configure_torch_determinism(deterministic=deterministic)


## @brief Configure deterministic behavior for torch/cuDNN.
# @details
# When deterministic is enabled, tries to enforce deterministic algorithms and disables
# cuDNN benchmark autotuning. When disabled, allows cuDNN benchmark for performance.
# @param deterministic bool Whether to enforce deterministic behavior.
# @return None
def _configure_torch_determinism(deterministic: bool) -> None:
    # cuDNN knobs matter only when cuDNN is used, but setting them is harmless.
    torch.backends.cudnn.deterministic = bool(deterministic)
    torch.backends.cudnn.benchmark = not bool(deterministic)

    # torch.use_deterministic_algorithms exists in modern torch (>=1.8).
    # We use a guarded call to keep the utility robust.
    use_det = getattr(torch, "use_deterministic_algorithms", None)
    if callable(use_det):
        # warn_only is available in newer torch; use if present to avoid hard failures
        # in environments where strict determinism isn't possible.
        try:
            use_det(bool(deterministic), warn_only=not bool(deterministic))
        except TypeError:
            # Older signature without warn_only.
            use_det(bool(deterministic))
