## src/config.py
from __future__ import annotations

import copy
import dataclasses
import math
import os
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, List, Mapping, Optional, Tuple

import yaml


## @brief Model configuration dataclass.
# @details Holds model backbone and task head settings.
@dataclass(frozen=True)
class ModelConfig:
    ## @param backbone_name str Hugging Face model identifier or local path.
    ## @param task_type str One of {'sequence_classification','question_answering','seq2seq','causal_lm'}.
    ## @param max_length int Max token length for single-input tokenization.
    ## @param num_labels int Number of labels for classification tasks.
    ## @param use_ffn_adapters bool Whether to inject APT adapters into FFN projections.
    ## @param trust_remote_code bool Whether to allow transformers to execute remote code.
    backbone_name: str = ""
    task_type: str = "sequence_classification"
    max_length: int = 512
    num_labels: int = 2
    use_ffn_adapters: bool = True
    trust_remote_code: bool = False


## @brief Data configuration dataclass.
# @details Holds dataset identifiers, split names, and tokenization fields.
@dataclass(frozen=True)
class DataConfig:
    ## @param dataset_name str Hugging Face dataset name (e.g., 'glue', 'squad_v2').
    ## @param dataset_config_name str Dataset config/subset (e.g., 'sst2', 'mnli'), may be empty.
    ## @param train_split str Split name for training.
    ## @param validation_split str Split name for validation.
    ## @param text_fields list[str] Input text fields used for tokenization.
    ## @param label_field str Label field name in dataset.
    ## @param max_source_length int Max length for seq2seq source (encoder input) or prompt.
    ## @param max_target_length int Max length for seq2seq target (decoder output) or completion.
    ## @param batch_size int Training batch size per device.
    ## @param eval_batch_size int Evaluation batch size per device.
    dataset_name: str = ""
    dataset_config_name: str = ""
    train_split: str = "train"
    validation_split: str = "validation"
    text_fields: List[str] = dataclasses.field(default_factory=list)
    label_field: str = "label"
    max_source_length: int = 512
    max_target_length: int = 128
    batch_size: int = 32
    eval_batch_size: int = 128


## @brief Training configuration dataclass.
# @details Holds optimizer, scheduler, and general training loop hyperparameters.
@dataclass(frozen=True)
class TrainingConfig:
    ## @param learning_rate float Learning rate.
    ## @param weight_decay float Weight decay.
    ## @param num_epochs int Total training epochs.
    ## @param distill_epochs int Number of distillation/pruning-stage epochs (paper: 'Distill epochs'), 0 if none.
    ## @param gradient_accumulation_steps int Gradient accumulation steps.
    ## @param warmup_ratio float Scheduler warmup ratio in [0,1).
    ## @param max_grad_norm float Gradient clipping norm.
    ## @param optimizer_name str Optimizer name (e.g., 'adamw').
    ## @param lr_scheduler_type str LR scheduler type (e.g., 'linear', 'cosine').
    ## @param fp16 bool Use fp16 mixed precision.
    ## @param bf16 bool Use bf16 mixed precision.
    ## @param eval_every_steps int Evaluation interval in steps.
    ## @param save_every_steps int Checkpoint interval in steps.
    ## @param seed int Random seed.
    learning_rate: float = 2e-4
    weight_decay: float = 0.0
    num_epochs: int = 1
    distill_epochs: int = 0
    gradient_accumulation_steps: int = 1
    warmup_ratio: float = 0.0
    max_grad_norm: float = 1.0
    optimizer_name: str = "adamw"
    lr_scheduler_type: str = "linear"
    fp16: bool = False
    bf16: bool = False
    eval_every_steps: int = 200
    save_every_steps: int = 200
    seed: int = 42


## @brief APT algorithm configuration dataclass.
# @details Encodes adaptive pruning, tuning, and (optional) self-distillation toggles.
@dataclass(frozen=True)
class APTConfig:
    ## @param enable_apt bool Whether to enable APT injection and adaptive steps.
    ## @param target_sparsity float Target sparsity gamma_T (ratio of pruned parameters) in [0,1).
    ## @param initial_rank int Initial adapter rank (paper: 8).
    ## @param lora_alpha float Scaling factor s (paper: 2).
    ## @param mask_update_step float Gradual mask update alpha (paper: 0.01).
    ## @param salience_ema_beta float EMA beta for salience moving average.
    ## @param pruning_stage_ratio float Fraction of total steps/epochs used for pruning stage if distill_epochs not set.
    ## @param rank_update_interval int Steps between rank reallocation/expansion.
    ## @param prune_update_interval int Steps between pruning-mask updates.
    ## @param rank_growth_mode str Rank growth scheduling mode identifier (config-driven).
    ## @param use_kurtosis bool Whether to add kurtosis-based outlier bonus in pruning salience (paper: yes).
    ## @param use_self_distill bool Whether to enable efficient self-knowledge distillation (paper: small models yes).
    ## @param distill_mu_schedule str Distillation mu schedule (paper: linear_0_to_1).
    ## @param teacher_share_frozen bool Whether teacher and student share frozen parameters (paper: true).
    ## @param apply_on_modules list[str] Target module groups to inject APT adapters into.
    enable_apt: bool = True
    target_sparsity: float = 0.0
    initial_rank: int = 8
    lora_alpha: float = 2.0
    mask_update_step: float = 0.01
    salience_ema_beta: float = 0.9
    pruning_stage_ratio: float = 0.5
    rank_update_interval: int = 50
    prune_update_interval: int = 50
    rank_growth_mode: str = "linear_budget"
    use_kurtosis: bool = True
    use_self_distill: bool = True
    distill_mu_schedule: str = "linear_0_to_1"
    teacher_share_frozen: bool = True
    apply_on_modules: List[str] = dataclasses.field(default_factory=list)


