## configs/llama2_7b_alpaca_apt.yaml
# Logic Analysis: configs/llama2_7b_alpaca_apt.yaml
#
# Purpose:
# Task-specific override config for reproducing the paper's APT setup on
# LLaMA-2 7B with Alpaca instruction tuning and lm-eval-harness evaluation.
#
# This file is written to match the provided design and config schema.
# It should be loaded on top of configs/default.yaml by ExperimentConfig.from_yaml(...)
# in src/config.py.
#
# Paper-aligned decisions reflected here:
# 1) Backbone: LLaMA-2 7B
# 2) Task type: causal LM
# 3) Dataset: GPT-4 generated Alpaca dataset
# 4) APT adapters on large models: attention query + attention value only
# 5) Distillation disabled for large models
# 6) Initial rank = 8
# 7) Scaling factor = 2  -> represented as lora_alpha=2.0 per design schema
# 8) Alpaca training epochs = 15
# 9) LLaMA evaluation via lm-eval-harness:
#    - ARC: 25-shot
#    - HellaSwag: 10-shot
#    - MMLU: 5-shot
#    - TruthfulQA: 0-shot
# 10) LLaMA training efficiency uses training time per step, not TTA
#
# Important implementation assumptions that must remain explicit:
# - The paper/config.yaml provides the rank update rule but not an explicit Delta_t schedule.
#   Therefore rank_growth_mode is set to a linear budget growth assumption and must be
#   logged/validated by src/config.py and surfaced by trainer logs.
# - The parsed paper does not expose the exact EMA beta for salience; we set
#   salience_ema_beta=0.9 as an explicit and logged assumption.
# - The paper indicates "distillation-free" large-model pruning for memory reasons and
#   config.yaml sets distillation.enabled_for_large_models=false, so distillation is disabled.
# - For LLaMA, only q_proj/v_proj modules are targeted, matching config.yaml
#   apt.apt_adapter_targets.large_models.
# - The paper reports LLaMA results at 30% sparsity pruning (70% remaining), so target_sparsity=0.30.
#
# Notes for downstream modules:
# - src/models/model_factory.py should create an AutoModelForCausalLM-compatible model.
# - src/models/apt_injector.py should target only attention query/value projections
#   according to apply_on_modules below.
# - src/training/trainer.py should run a pruning stage during early training and then
#   continue recovery training, but without self-distillation for this config.
# - src/eval/lm_eval_adapter.py should use the lm-eval tasks and few-shot counts below.
# - src/utils/profiler.py and src/eval/evaluator.py should benchmark inference with
#   batch size 32 for llama_7b, as required by config.yaml.

model:
  backbone_name: "llama-2-7b"
  task_type: "causal_lm"
  max_length: 512
  num_labels: 0
  use_ffn_adapters: false
  trust_remote_code: true

data:
  dataset_name: "alpaca"
  dataset_config_name: null
  train_split: "train"
  validation_split: null
  text_fields:
    - "instruction"
    - "input"
    - "output"
  label_field: "output"
  max_source_length: 384
  max_target_length: 128
  batch_size: 32
  eval_batch_size: 32

training:
  learning_rate: 1.0e-4
  weight_decay: 0.0
  num_epochs: 15
  distill_epochs: 0
  gradient_accumulation_steps: 1
  warmup_ratio: 0.0
  max_grad_norm: 1.0
  optimizer_name: "adamw"
  lr_scheduler_type: "linear"
  fp16: true
  bf16: false
  eval_every_steps: 0
  save_every_steps: 0
  seed: 42

apt:
  enable_apt: true
  target_sparsity: 0.30
  initial_rank: 8
  lora_alpha: 2.0
  mask_update_step: 0.01
  salience_ema_beta: 0.9
  pruning_stage_ratio: 0.5
  rank_update_interval: 50
  prune_update_interval: 10
  rank_growth_mode: "linear_budget_growth"
  use_kurtosis: true
  use_self_distill: false
  distill_mu_schedule: "linear_0_to_1"
  teacher_share_frozen: false
  apply_on_modules:
    - "q_proj"
    - "v_proj"

evaluation:
  metrics:
    - "arc"
    - "hellaswag"
    - "mmlu"
    - "truthfulqa"
    - "average"
  measure_train_peak_memory: true
  measure_inference_peak_memory: true
  measure_throughput: true
  lm_eval_tasks:
    - "arc_challenge"
    - "hellaswag"
    - "mmlu"
    - "truthfulqa"
  lm_eval_num_fewshot:
    arc_challenge: 25
    hellaswag: 10
    mmlu: 5
    truthfulqa: 0

runtime:
  output_dir: "outputs/llama2_7b_alpaca_apt"
  device: "cuda"
  num_workers: 4
  pin_memory: true
  compile_model: false
  gradient_checkpointing: true
  log_level: "INFO"
