## configs/roberta_sst2_apt.yaml
# Logic analysis for: configs/roberta_sst2_apt.yaml
# Purpose:
#   Task-specific override config for reproducing APT on RoBERTa-base over SST-2.
#   This file is an INPUT config and must follow the schema implied by:
#   - configs/default.yaml
#   - src/config.py dataclasses/interfaces
#   - paper methodology
#   - provided config.yaml
#
# Reproduction scope for this config:
#   - Backbone: RoBERTa-base
#   - Task: GLUE SST-2
#   - Model type: sequence classification
#   - APT enabled
#   - Small-model regime:
#       * APT adapters on attention query, attention value, and FFN layers
#       * self-distillation enabled
#       * target sparsity set to 60% (paper small-model main setting)
#   - Evaluation:
#       * dev accuracy
#       * training efficiency via relative peak memory + TTA
#       * inference efficiency via peak memory + throughput speedup
#
# Important fidelity notes from paper/config:
#   1. Training hyperparameters for GLUE-small come from config.yaml:
#        lr = 2e-4
#        batch_size = 32
#        epochs = 40
#        distill_epochs = 20
#   2. APT initial rank = 8, scaling factor = 2
#   3. Pruning uses cubic sparsity scheduling:
#        gamma_t = gamma_T + (1 - gamma_T) * (1 - t / T)^3
#   4. Mask update is gradual with alpha = 0.01
#   5. Salience:
#        pruning = compressed activation-gradient product + kurtosis
#        tuning   = salience summed over W_B
#   6. For small models, adapters must target:
#        attention_query, attention_value, ffn_layers
#   7. Distillation is enabled for small models, disabled only for large models
#   8. SST-2 metric is dev accuracy
#
# Implementation assumptions required because the paper/config.yaml omit some values:
#   - Exact salience EMA beta is unspecified -> inherit from configs/default.yaml (do not invent).
#   - Prune/rank update intervals are unspecified -> inherit from configs/default.yaml (do not invent).
#   - Optimizer/scheduler/warmup/weight_decay not given in config.yaml -> inherit from default.yaml.

model:
  backbone_name: roberta-base
  task_type: sequence_classification
  num_labels: 2
  use_ffn_adapters: true
  trust_remote_code: false

data:
  dataset_name: glue
  dataset_config_name: sst2
  train_split: train
  validation_split: validation
  text_fields:
    - sentence
  label_field: label
  batch_size: 32        # config.yaml: training.batch_size.glue_small
  eval_batch_size: 128  # config.yaml: evaluation.inference_batch_size.small_models

training:
  learning_rate: 2.0e-4  # config.yaml: training.learning_rate.glue_small
  num_epochs: 40         # config.yaml: training.epochs.glue_small
  distill_epochs: 20     # config.yaml: training.distill_epochs.glue_small

apt:
  enable_apt: true
  target_sparsity: 0.60    # paper: prune 60% parameters for RoBERTa small-model main results
  initial_rank: 8          # config.yaml: apt.initial_rank
  lora_alpha: 2            # config.yaml: apt.scaling_factor
  mask_update_step: 0.01   # config.yaml: apt.mask_update_alpha

  # Distillation/pruning stage is exactly 20 epochs out of 40 epochs => 0.5.
  pruning_stage_ratio: 0.5

  # Unspecified by config.yaml; must come from configs/default.yaml.
  salience_ema_beta: null
  prune_update_interval: null
  rank_update_interval: null

  rank_growth_mode: top_half_salient_adapters  # config.yaml: apt.rank_growth.selection
  use_kurtosis: true                           # config.yaml: apt.salience_score.pruning includes kurtosis
  use_self_distill: true                       # config.yaml: distillation.enabled_for_small_models
  distill_mu_schedule: linear_0_to_1           # config.yaml: distillation.mu_schedule
  teacher_share_frozen: true                   # config.yaml: teacher_setup.frozen_parameters_shared

  apply_on_modules:
    - attention_query
    - attention_value
    - ffn_layers

evaluation:
  metrics:
    - accuracy
  measure_train_peak_memory: true
  measure_inference_peak_memory: true
  measure_throughput: true

runtime:
  output_dir: outputs/roberta_sst2_apt
