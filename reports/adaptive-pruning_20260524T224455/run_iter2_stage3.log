## configs/default.yaml
# Base configuration template for all APT experiments.
# This file should be loaded first and then overridden by task-specific configs.
# All values and comments below are aligned to the provided paper summary, design,
# task requirements, and config.yaml. Where the paper/config do not specify an
# exact numeric value, we keep the field nullable and require task-specific configs
# or src/config.py validation to resolve it explicitly rather than inventing values.

experiment:
  name: null
  description: "Base config template for reproducing APT."
  paper_id: "paper"
  method: "APT"

model:
  backbone_name: null
  # Supported by paper/config:
  # - roberta-base
  # - bert-base
  # - t5-base
  # - t5-lm-adapt
  # - llama-2-7b
  # - llama-2-13b
  task_type: null
  # Expected values by design:
  # - sequence_classification
  # - question_answering
  # - seq2seq
  # - causal_lm
  num_labels: null
  max_length: null
  use_ffn_adapters: null
  # Logic:
  # - small models use attention_query + attention_value + ffn_layers
  # - large models use attention_query + attention_value
  # Must be set consistently with apt.apply_on_modules and model family.
  trust_remote_code: false

data:
  dataset_name: null
  dataset_config_name: null
  train_split: null
  validation_split: null
  test_split: null
  text_fields: []
  label_field: null
  max_source_length: null
  max_target_length: null
  batch_size: null
  eval_batch_size: null
  # Logic from config.yaml:
  # training batch sizes by task family:
  # - glue_small: 32
  # - glue_big: 32
  # - squad: 32
  # - cnndm: 16
  # - alpaca: 32
  #
  # Inference batch sizes by model family:
  # - small_models: 128
  # - llama_7b: 32
  # - llama_13b: 4
  #
  # These should be materialized in task-specific configs, not assumed here.

training:
  learning_rate: null
  # Must be set from config.yaml by task family:
  # - glue_small: 2e-4
  # - glue_big: 2e-4
  # - squad: 2e-4
  # - cnndm: 1e-4
  # - alpaca: 1e-4
  weight_decay: null
  # Not specified in config.yaml or parsed paper. Keep null and require explicit choice.
  num_epochs: null
  # Must be set from config.yaml:
  # - glue_small: 40
  # - glue_big: 40
  # - squad: 40
  # - cnndm: 16
  # - alpaca: 15
  distill_epochs: null
  # Must be set from config.yaml:
  # - glue_small: 20
  # - glue_big: 20
  # - squad: 20
  # - cnndm: 6
  # - alpaca: null
  gradient_accumulation_steps: null
  # Not specified in config.yaml. Keep null.
  warmup_ratio: null
  # Not specified in config.yaml. Keep null.
  max_grad_norm: null
  # Not specified in config.yaml. Keep null.
  optimizer_name: null
  # Not specified in config.yaml. Keep null.
  lr_scheduler_type: null
  # The sparsity schedule is specified, but optimizer LR scheduler is not.
  fp16: false
  bf16: false
  eval_every_steps: null
  save_every_steps: null
  seed: null
  # Not specified in config.yaml. Keep null.

apt:
  enable_apt: true

  target_sparsity: null
  # Final gamma_T must be set in task-specific configs.
  # Paper/config provide methodology, not one universal value.
  # Examples from paper:
  # - small models often evaluated at 60% sparsity
  # - LLaMA main setup often evaluated with 70% parameters remaining (30% sparsity)

  initial_rank: 8
  # From config.yaml apt.initial_rank

  lora_alpha: 2
  # From config.yaml apt.scaling_factor

  prune_update_interval: null
  rank_update_interval: null
  # Required placeholders by task instruction.
  # Exact numeric update intervals are not specified in config.yaml or parsed paper.
  # Keep null and require explicit setting in task-specific configs or config validation.

  mask_update_step: 0.01
  # From config.yaml apt.mask_update_alpha

  salience_ema_beta: null
  # Required placeholder by task instruction.
  # Paper/config state exponential moving average is used, but do not specify beta.
  # Keep null to avoid inventing a value.

  pruning_stage_ratio: null
  # The paper clearly uses a pruning/distillation stage followed by recovery fine-tuning,
  # but config.yaml gives distill_epochs rather than a ratio. Keep null at base level.

  rank_growth_mode: "top_half_salient_adapters"
  # From config.yaml apt.rank_growth.selection

  use_kurtosis: true
  # From config.yaml: pruning salience includes outlier-aware kurtosis

  use_self_distill: null
  # Must be task/model-specific:
  # - true for small models per config.yaml distillation.enabled_for_small_models
  # - false for large models per config.yaml distillation.enabled_for_large_models

  distill_mu_schedule: "linear_0_to_1"
  # From config.yaml distillation.mu_schedule

  teacher_share_frozen: true
  # From config.yaml distillation.teacher_setup.frozen_parameters_shared

  apply_on_modules: []
  # Must be set per model family from config.yaml:
  # small_models:
  #   - attention_query
  #   - attention_value
  #   - ffn_layers
  # large_models:
  #   - attention_query
  #   - attention_value

  target_sparsity_schedule: "cubic"
  target_sparsity_formula: "gamma_t = gamma_T + (1 - gamma_T) * (1 - t / T)^3"
  mask_update_mode: "gradual"
  salience_moving_average: "exponential"
  salience_score_pruning: "compressed activation-gradient product with outlier-aware kurtosis"
  salience_score_tuning: "parameter salience summed over W_B"
  pruning_blocks:
    - attention_heads
    - ffn_neurons
    - hidden_dimensions
  rank_growth_update_rule: "r'_apt = floor(r_apt * Delta_t' / Delta_t)"
  rank_growth_init_W_A_new: "Gaussian N(0, sigma^2)"
  rank_growth_init_W_B_new: "zeros"
  optimizer_reset_after_shape_change: true

distillation:
  enabled_for_small_models: true
  enabled_for_large_models: false
  loss: "L = mu * L_distill + (1 - mu) * L_ft"
  mu_schedule: "linear_0_to_1"
  layer_loss: "L_layer = sum_i MSE(Tr(H_s^{phi(i)}), H_t^i)"
  teacher_setup:
    frozen_parameters_shared: true
    tuning_layers_duplicated: true
    transformation_layer_init: "identity"

evaluation:
  metrics: []
  # Required placeholder by task instruction.
  # Must be set by task-specific config according to dataset:
  # - GLUE SST-2 / MNLI: accuracy
  # - SQuAD v2: f1
  # - CNN/DM: rouge1, rouge2, rougel
  # - Alpaca/LLaMA eval: task-specific harness metrics / averaged task scores
  measure_train_peak_memory: true
  measure_inference_peak_memory: true
  measure_throughput: true
  lm_eval_tasks: []
  lm_eval_num_fewshot: {}
  hardware: "single A100 GPU"
  inference_batch_size:
    small_models: 128
    llama_7b: 32
    llama_13b: 4
  training_efficiency_metrics:
    - relative_training_peak_memory
    - time_to_accuracy
  inference_efficiency_metrics:
    - inference_peak_memory
    - throughput_speedup
  llama_training_speed_metric: "training time per step"
  tta_note: "For small models, training speed is measured by TTA; for LLaMA, TTA is not used."

runtime:
  output_dir: null
  # Required placeholder by task instruction.
  device: "cuda"
  num_workers: null
  pin_memory: true
  compile_model: false
  gradient_checkpointing: false
  log_level: "INFO"

notes:
  config_source_of_truth: "Values in config.yaml and task-specific override YAMLs."
  implementation_constraints:
    - "Do not invent unspecified paper hyperparameters in this base file."
    - "salience_ema_beta must remain explicit because the paper/config do not provide its numeric value."
    - "prune_update_interval and rank_update_interval must remain explicit because the paper/config do not provide exact numeric intervals."
    - "Task-specific configs must choose model.task_type and data formatting consistent with the target experiment."
    - "For T5, using t5-lm-adapt is preferred for fair comparison as stated in config.yaml."
    - "For small models, self-distillation should generally be enabled; for large models, disabled."
    - "APT target modules must follow model family: small models include FFN adapters; large models use only attention query/value."
