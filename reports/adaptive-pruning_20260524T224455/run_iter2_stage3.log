from __future__ import annotations

import argparse
import dataclasses
import os
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, Optional

import torch

from src.algorithms.distillation import DistillationManager
from src.algorithms.pruning import PruningScheduler
from src.algorithms.rank_allocator import RankAllocator
from src.algorithms.salience import SalienceCollector
from src.config import ExperimentConfig
from src.data.dataset_loader import DatasetBundle, DatasetLoader
from src.eval.evaluator import EvalResult, Evaluator
from src.models.apt_injector import APTModelWrapper
from src.models.compact_export import CompactExporter
from src.models.mask_utils import MaskManager
from src.models.model_factory import ModelFactory
from src.training.trainer import TrainResult, Trainer
from src.utils.logging import get_logger, log_config, log_metrics, save_json
from src.utils.profiler import Profiler
from src.utils.seed import set_global_seed


## @brief High-level experiment system that wires together data, model, training, evaluation, and export.
# @details
# This class follows the design contract:
# - prepare(): build datasets, model, inject APT, initialize masks, create algorithm components.
# - train(): run APT two-stage training via Trainer.
# - evaluate(): compute task metrics and inference metrics via Evaluator.
# - export(): merge adapters and export a compact payload via CompactExporter.
class ExperimentSystem:
    ## @brief Initialize ExperimentSystem.
    # @param config ExperimentConfig Fully built experiment configuration.
    def __init__(self, config: ExperimentConfig) -> None:
        if not isinstance(config, ExperimentConfig):
            raise TypeError(f"config must be ExperimentConfig, got {type(config)}")

        self._logger = get_logger(self.__class__.__name__, level=str(config.runtime.log_level))
        self._cfg: ExperimentConfig = config

        self._datasets: Optional[DatasetBundle] = None
        self._model: Optional[APTModelWrapper] = None
        self._mask_manager: Optional[MaskManager] = None

        self._salience: Optional[SalienceCollector] = None
        self._pruner: Optional[PruningScheduler] = None
        self._rank_allocator: Optional[RankAllocator] = None
        self._distiller: Optional[DistillationManager] = None
        self._profiler: Optional[Profiler] = None

        self._trainer: Optional[Trainer] = None
        self._evaluator: Optional[Evaluator] = None
        self._exporter: Optional[CompactExporter] = None

        self._train_result: Optional[TrainResult] = None
        self._eval_result: Optional[EvalResult] = None
        self._export_path: Optional[str] = None

    ## @brief Prepare all components for the experiment.
    # @details
    # Order is critical:
    # 1) Load datasets/tokenizer.
    # 2) Create base model and inject APT adapters.
    # 3) Initialize masks to dense ones (APT starts pruning from beginning).
    # 4) Create salience collector (hooks attached during training).
    # 5) Create pruning scheduler and rank allocator.
    # 6) Optionally create distillation manager depending on config (small models enabled, large disabled).
    # 7) Create profiler and trainer/evaluator/exporter.
    # @return None
    def prepare(self) -> None:
        out_dir = Path(str(self._cfg.runtime.output_dir)).expanduser().resolve()
        out_dir.mkdir(parents=True, exist_ok=True)

        # Data
        loader = DatasetLoader(config=self._cfg.data, model_config=self._cfg.model)
        datasets = loader.load()
        self._datasets = datasets

        # Model
        factory = ModelFactory(model_config=self._cfg.model)
        created = factory.create_model_for_task(apt_config=self._cfg.apt)
        if not isinstance(created, APTModelWrapper):
            raise TypeError(
                "This reproduction requires APT-enabled models to be wrapped as APTModelWrapper. "
                f"Got type: {type(created)}"
            )
        self._model = created

        # Mask manager (structured pruning masks)
        registry = self._model.get_registry()
        mask_manager = MaskManager(registry=registry)
        mask_manager.initialize_masks()
        self._mask_manager = mask_manager

        # Salience collector (EMA + optional kurtosis bonus per config)
        self._salience = SalienceCollector(
            registry=registry,
            ema_beta=float(self._cfg.apt.salience_ema_beta),
            use_kurtosis=bool(self._cfg.apt.use_kurtosis),
        )

        # Pruner and rank allocator
        self._pruner = PruningScheduler(
            registry=registry,
            mask_manager=mask_manager,
            apt_config=self._cfg.apt,
        )
        self._rank_allocator = RankAllocator(
            registry=registry,
            apt_config=self._cfg.apt,
        )

        # Distillation manager (paper: enabled for small models; disabled for large models).
        # Trust cfg.apt.use_self_distill as normalized by src/config.py per config.yaml.
        self._distiller = None
        if bool(self._cfg.apt.use_self_distill):
            self._distiller = DistillationManager(apt_model=self._model, apt_config=self._cfg.apt)

        # Profiler
        self._profiler = Profiler(device=str(self._cfg.runtime.device))

        # Trainer
        self._trainer = Trainer(
            model=self._model,
            datasets=self._datasets,
            config=self._cfg,
            salience=self._salience,
            pruner=self._pruner,
            rank_allocator=self._rank_allocator,
            distiller=self._distiller,
            profiler=self._profiler,
        )

        # Evaluator
        self._evaluator = Evaluator(
            model=self._model,
            datasets=self._datasets,
            config=self._cfg,
            profiler=self._profiler,
        )

        # Exporter (uses final masks + merges adapters)
        self._exporter = CompactExporter(apt_model=self._model, mask_manager=self._mask_manager)

        # Persist resolved config for reproducibility.
        save_json(out_dir / "resolved_config.json", self._cfg)

    ## @brief Train the experiment.
    # @details Delegates to Trainer.train(), which runs pruning stage then recovery stage as per paper.
    # @return TrainResult Training result.
    def train(self) -> TrainResult:
        if self._trainer is None:
            raise RuntimeError("ExperimentSystem.prepare() must be called before train().")
        self._train_result = self._trainer.train()
        return self._train_result

    ## @brief Evaluate the trained model.
    # @details Delegates to Evaluator.evaluate() to compute paper metrics and inference efficiency metrics.
    # @return EvalResult Evaluation result.
    def evaluate(self) -> EvalResult:
        if self._evaluator is None:
            raise RuntimeError("ExperimentSystem.prepare() must be called before evaluate().")
        self._eval_result = self._evaluator.evaluate()
        return self._eval_result

    ## @brief Export compact artifacts after training.
    # @details
    # Uses CompactExporter.save() which:
    # - merges adapters into base weights (paper: mergeable after training),
    # - exports binary masks and slicing manifest for structured pruning,
    # - saves a torch payload and JSON metadata to disk.
    # @return str Path to the main export artifact file.
    def export(self) -> str:
        if self._exporter is None:
            raise RuntimeError("ExperimentSystem.prepare() must be called before export().")

        out_dir = Path(str(self._cfg.runtime.output_dir)).expanduser().resolve()
        export_dir = out_dir / "compact_export"
        export_dir.mkdir(parents=True, exist_ok=True)

        self._export_path = self._exporter.save(output_dir=str(export_dir))
        save_json(out_dir / "export_path.json", {"export_path": str(self._export_path)})
        return str(self._export_path)


## @brief Top-level runner class per design.
# @details
# Loads config, sets seed, builds and runs ExperimentSystem, and saves a final summary.
class Main:
    ## @brief Initialize Main.
    # @param config_path str Path to a task config YAML under configs/.
    def __init__(self, config_path: str) -> None:
        self._config_path: str = str(config_path)
        self._logger = get_logger(self.__class__.__name__)

    ## @brief Build the experiment system from YAML config.
    # @details Uses ExperimentConfig.from_yaml() which merges configs/default.yaml + task YAML + config.yaml.
    # @return ExperimentSystem Prepared experiment system object (not yet prepared).
    def build_system(self) -> ExperimentSystem:
        cfg = ExperimentConfig.from_yaml(self._config_path)
        cfg.validate()
        return ExperimentSystem(config=cfg)

    ## @brief Run the full experiment lifecycle.
    # @details Executes prepare -> train -> evaluate -> export, and writes a final summary JSON.
    # @return None
    def run(self) -> None:
        system = self.build_system()
        cfg = system._cfg  # Access for logging; ExperimentSystem owns the config.

        # Seed must be set before any stochastic operations in training components.
        set_global_seed(seed=int(cfg.training.seed), deterministic=False)

        # Log config for reproducibility.
        log_config(cfg, logger=self._logger)

        # Prepare full system.
        system.prepare()

        # Train.
        train_result = system.train()
        self._logger.info("Training complete: best_checkpoint=%s best_metric=%s", train_result.best_checkpoint, train_result.best_metric)

        # Evaluate.
        eval_result = system.evaluate()
        self._logger.info("Evaluation complete.")

        # Export compact artifacts.
        export_path = system.export()
        self._logger.info("Export complete: %s", export_path)

        # Save final summary.
        out_dir = Path(str(cfg.runtime.output_dir)).expanduser().resolve()
        summary: Dict[str, Any] = {
            "config_path": str(Path(self._config_path).expanduser().resolve()),
            "output_dir": str(out_dir),
            "train_result": dataclasses.asdict(train_result),
            "eval_result": dataclasses.asdict(eval_result),
            "export_path": str(export_path),
        }
        save_json(out_dir / "run_summary.json", summary)

        # Also log key metrics as a compact line.
        log_metrics(
            metrics={
                "best_metric": float(train_result.best_metric),
                "peak_train_memory_mb": float(train_result.peak_train_memory_mb),
                "time_to_accuracy_s": float(train_result.time_to_accuracy_s),
            },
            step=0,
            split="summary/train",
            logger=self._logger,
        )
        if eval_result.task_metrics:
            log_metrics(eval_result.task_metrics, step=0, split="summary/task", logger=self._logger)
        if eval_result.inference_metrics:
            log_metrics(eval_result.inference_metrics, step=0, split="summary/inference", logger=self._logger)


## @brief Parse command line arguments for the entrypoint.
# @details Requires a config path; optionally supports --output_dir override via environment variable only.
# @param argv Optional[list[str]] Argument list (defaults to sys.argv parsing by argparse).
# @return argparse.Namespace Parsed args.
def _parse_args(argv: Optional[list[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="Reproduce APT experiments (Adaptive Pruning and Tuning).")
    parser.add_argument(
        "--config",
        type=str,
        required=True,
        help="Path to a task config YAML (e.g., configs/roberta_sst2_apt.yaml).",
    )
    return parser.parse_args(argv)


## @brief Program entrypoint.
# @details Parses args and runs Main.
# @return None
def _main() -> None:
    args = _parse_args()
    runner = Main(config_path=str(args.config))
    runner.run()


if __name__ == "__main__":
    _main()
