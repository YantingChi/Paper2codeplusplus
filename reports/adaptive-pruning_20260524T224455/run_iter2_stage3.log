## src/utils/profiler.py
from __future__ import annotations

import time
from dataclasses import dataclass
from typing import Any, Dict, Iterable, Mapping, MutableMapping, Optional, Tuple, Union

import torch


## @brief Return type container for inference benchmark internal bookkeeping.
# @details Used internally to keep typed counters before casting to dict[str, float].
@dataclass
class _BenchmarkCounters:
    ## @param elapsed_time_s float Elapsed wall-clock time in seconds for measured region.
    ## @param num_samples int Number of samples processed in measured region.
    ## @param num_batches int Number of batches processed in measured region.
    ## @param peak_memory_mb float Peak CUDA allocated memory (MB) during benchmark region.
    elapsed_time_s: float
    num_samples: int
    num_batches: int
    peak_memory_mb: float


## @brief Efficiency profiler for training and inference.
# @details
# Provides CUDA-synchronized wall-clock timing and peak CUDA allocated memory measurement.
# This module is intentionally policy-free: it measures primitives used by trainer/evaluator
# to compute paper metrics (e.g., TTA, throughput speedup, relative peak memory).
class Profiler:
    ## @brief Initialize the profiler.
    # @param device str Device string (e.g., "cuda", "cuda:0", "cpu").
    def __init__(self, device: str) -> None:
        self._device_str: str = str(device)
        self._cuda_enabled: bool = ("cuda" in self._device_str.lower()) and torch.cuda.is_available()
        self._cuda_device: Optional[torch.device] = (
            torch.device(self._device_str) if self._cuda_enabled else None
        )
        self._region_starts: Dict[str, float] = {}

    ## @brief Start timing a named training region.
    # @details Synchronizes CUDA (if enabled) before starting the timer.
    # @param name str Region name (e.g., "train_total", "step", "epoch").
    # @return None
    def start_train_region(self, name: str) -> None:
        region_name = str(name)
        self._cuda_synchronize()
        self._region_starts[region_name] = time.perf_counter()

    ## @brief End timing a named training region and return elapsed time.
    # @details Synchronizes CUDA (if enabled) before stopping the timer.
    # @param name str Region name that was previously started.
    # @return float Elapsed time in seconds.
    def end_train_region(self, name: str) -> float:
        region_name = str(name)
        if region_name not in self._region_starts:
            raise KeyError(f"Unknown region '{region_name}'. Did you call start_train_region()?")

        self._cuda_synchronize()
        end_t = time.perf_counter()
        start_t = self._region_starts.pop(region_name)
        return float(end_t - start_t)

    ## @brief Measure peak training memory since last reset.
    # @details Uses torch.cuda.max_memory_allocated (allocated peak) and returns MB.
    # @return float Peak allocated CUDA memory in MB; 0.0 if CUDA is unavailable.
    def measure_peak_train_memory(self) -> float:
        if not self._cuda_enabled or self._cuda_device is None:
            return 0.0
        self._cuda_synchronize()
        peak_bytes = int(torch.cuda.max_memory_allocated(self._cuda_device))
        return float(peak_bytes) / (1024.0 * 1024.0)

    ## @brief Reset CUDA peak memory stats.
    # @details No-op on CPU. Synchronizes around the reset for accurate region boundaries.
    # @return None
    def reset_cuda_stats(self) -> None:
        if not self._cuda_enabled or self._cuda_device is None:
            return
        self._cuda_synchronize()
        torch.cuda.reset_peak_memory_stats(self._cuda_device)
        # reset_accumulated_memory_stats may not exist on older torch versions; guard.
        reset_accum = getattr(torch.cuda, "reset_accumulated_memory_stats", None)
        if callable(reset_accum):
            try:
                reset_accum(self._cuda_device)
            except Exception:
                # Best-effort; peak stats are the primary requirement for paper metrics.
                pass
        self._cuda_synchronize()

    ## @brief Benchmark inference throughput and peak memory.
    # @details
    # Measures throughput (samples/sec) over `measure_steps` batches after `warmup_steps` batches.
    # Timing is CUDA-synchronized to avoid asynchronous kernel launch underestimation.
    #
    # Throughput definition matches the paper: "data processed per second".
    # We count samples by inspecting the batch (preferring input_ids.shape[0]) and otherwise
    # using the leading dimension of the first tensor found in the batch.
    #
    # Peak memory uses allocated peak (torch.cuda.max_memory_allocated) since last reset.
    # @param model Any PyTorch model with a callable forward.
    # @param dataloader Any Iterable of batches.
    # @param warmup_steps int Number of warmup batches excluded from timing.
    # @param measure_steps int Number of measured batches included in timing.
    # @return dict[str, float] Benchmark results: throughput, latency_per_batch, elapsed_time_s,
    #         peak_memory_mb, num_measured_batches, num_samples.
    def benchmark_inference(
        self,
        model: Any,
        dataloader: Any,
        warmup_steps: int = 10,
        measure_steps: int = 50,
    ) -> Dict[str, float]:
        warmup_n = int(warmup_steps)
        measure_n = int(measure_steps)
        if warmup_n < 0:
            raise ValueError("warmup_steps must be >= 0")
        if measure_n < 0:
            raise ValueError("measure_steps must be >= 0")

        model_was_training = bool(getattr(model, "training", False))
        if hasattr(model, "eval") and callable(getattr(model, "eval")):
            model.eval()

        # Ensure peak-memory accounting begins at the benchmark region boundary.
        self.reset_cuda_stats()

        # Warmup region (excluded from timing).
        self._run_inference_loop(
            model=model,
            dataloader=dataloader,
            max_steps=warmup_n,
            measure=False,
        )

        # Measured region.
        counters = self._run_inference_loop(
            model=model,
            dataloader=dataloader,
            max_steps=measure_n,
            measure=True,
        )

        # Restore original train/eval state.
        if model_was_training and hasattr(model, "train") and callable(getattr(model, "train")):
            model.train()

        throughput = 0.0
        latency_per_batch = 0.0
        if counters.elapsed_time_s > 0.0 and counters.num_samples > 0:
            throughput = float(counters.num_samples) / float(counters.elapsed_time_s)
        if counters.num_batches > 0 and counters.elapsed_time_s > 0.0:
            latency_per_batch = float(counters.elapsed_time_s) / float(counters.num_batches)

        return {
            "throughput": float(throughput),
            "latency_per_batch": float(latency_per_batch),
            "elapsed_time_s": float(counters.elapsed_time_s),
            "peak_memory_mb": float(counters.peak_memory_mb),
            "num_measured_batches": float(counters.num_batches),
            "num_samples": float(counters.num_samples),
        }

    ## @brief Synchronize CUDA if enabled.
    # @return None
    def _cuda_synchronize(self) -> None:
        if not self._cuda_enabled or self._cuda_device is None:
            return
        torch.cuda.synchronize(self._cuda_device)

    ## @brief Move an arbitrary batch structure to the configured device.
    # @details Supports dict batches, tuple/list batches, and tensors.
    # @param batch Any Batch object from a DataLoader.
    # @return Any Batch moved to device where possible.
    def _move_batch_to_device(self, batch: Any) -> Any:
        if not self._cuda_enabled:
            return batch
        if self._cuda_device is None:
            return batch

        if torch.is_tensor(batch):
            return batch.to(self._cuda_device, non_blocking=True)

        if isinstance(batch, Mapping):
            out: Dict[str, Any] = {}
            for k, v in batch.items():
                out[str(k)] = self._move_batch_to_device(v)
            return out

        if isinstance(batch, (list, tuple)):
            moved = [self._move_batch_to_device(v) for v in batch]
            return type(batch)(moved)

        # Non-tensor leaf (e.g., strings/ints) are returned as-is.
        return batch

    ## @brief Infer batch size (number of samples) from a batch.
    # @details Prefers 'input_ids' when present; otherwise uses first tensor found.
    # @param batch Any Batch.
    # @return int Number of samples; 0 if cannot be inferred.
    def _infer_batch_size(self, batch: Any) -> int:
        if batch is None:
            return 0

        if isinstance(batch, Mapping):
            if "input_ids" in batch and torch.is_tensor(batch["input_ids"]):
                t = batch["input_ids"]
                return int(t.shape[0]) if t.dim() >= 1 else 0
            for v in batch.values():
                size = self._infer_batch_size(v)
                if size > 0:
                    return size
            return 0

        if isinstance(batch, (list, tuple)):
            for v in batch:
                size = self._infer_batch_size(v)
                if size > 0:
                    return size
            return 0

        if torch.is_tensor(batch):
            return int(batch.shape[0]) if batch.dim() >= 1 else 0

        return 0

    ## @brief Invoke the model forward pass given a batch.
    # @details Supports dict-based keyword batches and tuple/list positional batches.
    # @param model Any Model.
    # @param batch Any Batch on correct device.
    # @return Any Model outputs.
    def _forward(self, model: Any, batch: Any) -> Any:
        if isinstance(batch, Mapping):
            return model(**batch)
        if isinstance(batch, (list, tuple)):
            return model(*batch)
        return model(batch)

    ## @brief Run an inference loop over the dataloader for up to max_steps.
    # @details When measure=True, measures elapsed time and peak memory; otherwise only runs warmup.
    # @param model Any Model.
    # @param dataloader Any Iterable of batches.
    # @param max_steps int Maximum number of batches to run.
    # @param measure bool Whether to time and count samples for benchmarking.
    # @return _BenchmarkCounters Benchmark counters (zeros if measure=False).
    def _run_inference_loop(
        self,
        model: Any,
        dataloader: Any,
        max_steps: int,
        measure: bool,
    ) -> _BenchmarkCounters:
        steps = int(max_steps)
        if steps <= 0:
            # Still report peak memory since last reset, but without measured work.
            peak_mb = self.measure_peak_train_memory() if measure else 0.0
            return _BenchmarkCounters(
                elapsed_time_s=0.0,
                num_samples=0,
                num_batches=0,
                peak_memory_mb=float(peak_mb),
            )

        num_samples = 0
        num_batches = 0

        # Use torch.no_grad() to match inference conditions.
        # Do not modify autocast/mixed precision here; caller controls runtime settings.
        it = iter(dataloader)

        if measure:
            self._cuda_synchronize()
            start_t = time.perf_counter()

        with torch.no_grad():
            while num_batches < steps:
                try:
                    batch = next(it)
                except StopIteration:
                    break

                batch = self._move_batch_to_device(batch)
                _ = self._forward(model, batch)

                if measure:
                    num_batches += 1
                    num_samples += self._infer_batch_size(batch)
                else:
                    # Warmup loop.
                    num_batches += 1

        if measure:
            self._cuda_synchronize()
            elapsed = float(time.perf_counter() - start_t)
            peak_mb = self.measure_peak_train_memory()
            return _BenchmarkCounters(
                elapsed_time_s=elapsed,
                num_samples=int(num_samples),
                num_batches=int(num_batches),
                peak_memory_mb=float(peak_mb),
            )

        return _BenchmarkCounters(
            elapsed_time_s=0.0,
            num_samples=0,
            num_batches=0,
            peak_memory_mb=0.0,
        )
