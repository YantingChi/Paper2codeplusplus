## src/data/preprocessors.py
from __future__ import annotations

import re
from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple, Union

import numpy as np

from src.config import DataConfig, ModelConfig


## @brief Task-specific dataset preprocessing and tokenization.
# @details
# Converts raw dataset examples into tokenized model inputs consistent with ModelConfig.task_type.
#
# Supported tasks (per paper):
# - GLUE (SST-2, MNLI): sequence classification (encoder-style) and optionally T5 text-to-text.
# - SQuAD v2.0: extractive QA span supervision with overflow features.
# - CNN/DailyMail: T5 summarization (seq2seq).
# - Alpaca instruction tuning: causal LM prompt+response with label masking on prompt.
#
# Important implementation notes (paper ambiguities):
# - T5 classification is implemented as text-to-text label generation (an explicit project choice).
# - Alpaca prompt template is standardized here; paper does not specify an exact template.
# - SQuAD overflow stride is not specified in config.yaml; we use a standard stride=128
#   to enable long-context handling while keeping it deterministic.
class TaskPreprocessor:
    ## @brief Initialize TaskPreprocessor.
    # @param tokenizer Any Hugging Face tokenizer.
    # @param config DataConfig Dataset configuration.
    # @param model_config ModelConfig Model configuration.
    def __init__(self, tokenizer: Any, config: DataConfig, model_config: ModelConfig) -> None:
        self._tokenizer: Any = tokenizer
        self._cfg: DataConfig = config
        self._model_cfg: ModelConfig = model_config

        self._dataset_name: str = (self._cfg.dataset_name or "").lower().strip()
        self._dataset_config: str = (self._cfg.dataset_config_name or "").lower().strip()

        # SQuAD v2 long-context handling: stride is necessary for overflow tokenization.
        # config.yaml does not specify it; we choose a standard, deterministic value.
        self._qa_doc_stride: int = 128

        # Standardize "no answer" behavior for SQuAD v2: use CLS index.
        self._qa_pad_on_right: bool = bool(getattr(self._tokenizer, "padding_side", "right") == "right")

        # Label verbalizations for seq2seq classification tasks.
        # These are standard for GLUE tasks and deterministic.
        self._sst2_label_map: Dict[int, str] = {0: "negative", 1: "positive"}
        self._mnli_label_map: Dict[int, str] = {0: "entailment", 1: "neutral", 2: "contradiction"}

    ## @brief Preprocess a batch for encoder-style sequence classification.
    # @details
    # Tokenizes one or two text fields based on DataConfig.text_fields, and copies labels from DataConfig.label_field.
    # Uses truncation to ModelConfig.max_length and leaves padding to the data collator.
    # @param batch dict Raw dataset batch (column -> list of values).
    # @return dict Tokenized batch with optional "labels".
    def preprocess_classification(self, batch: Dict[str, Any]) -> Dict[str, Any]:
        texts_a, texts_b = self._extract_text_pair(batch=batch, fields=self._cfg.text_fields)

        tokenized: Dict[str, Any]
        if texts_b is None:
            tokenized = self._tokenizer(
                texts_a,
                truncation=True,
                max_length=int(self._model_cfg.max_length),
                padding=False,
            )
        else:
            tokenized = self._tokenizer(
                texts_a,
                texts_b,
                truncation=True,
                max_length=int(self._model_cfg.max_length),
                padding=False,
            )

        labels = self._extract_optional_labels(batch=batch, label_field=self._cfg.label_field)
        if labels is not None:
            tokenized["labels"] = labels
        return tokenized

    ## @brief Preprocess a batch for extractive QA (SQuAD v2.0 style).
    # @details
    # Produces tokenized features with overflow for long contexts, offset mappings for evaluation,
    # and span start/end positions for training if answers are present.
    #
    # This method always returns "example_id" and a filtered "offset_mapping" where offsets that
    # do not correspond to context tokens are set to None, enabling standard post-processing.
    #
    # Uses ModelConfig.max_length and a fixed doc stride (128) for deterministic overflow behavior.
    # @param batch dict Raw dataset batch (column -> list of values).
    # @return dict Tokenized features batch.
    def preprocess_qa(self, batch: Dict[str, Any]) -> Dict[str, Any]:
        # Canonical SQuAD v2 fields
        questions: List[str] = [self._normalize_question(q) for q in self._get_required_list(batch, "question")]
        contexts: List[str] = self._get_required_list(batch, "context")
        example_ids: List[str] = self._get_required_list(batch, "id")

        # Tokenize with overflow to produce multiple features per example if needed.
        # The "truncation" strategy depends on padding side; for right padding (common),
        # truncate context ("only_second") for question-context pairs.
        truncation_side = "only_second" if self._qa_pad_on_right else "only_first"

        tokenized = self._tokenizer(
            questions if self._qa_pad_on_right else contexts,
            contexts if self._qa_pad_on_right else questions,
            truncation=truncation_side,
            max_length=int(self._model_cfg.max_length),
            stride=int(self._qa_doc_stride),
            return_overflowing_tokens=True,
            return_offsets_mapping=True,
            padding=False,
        )

        # overflow_to_sample_mapping maps each feature to its original example index.
        sample_mapping: List[int] = list(tokenized.pop("overflow_to_sample_mapping"))
        offset_mapping: List[List[Tuple[int, int]]] = list(tokenized["offset_mapping"])

        # Identify token positions corresponding to the context for each feature.
        # We also filter offsets for non-context tokens by setting them to None.
        filtered_offsets: List[List[Optional[Tuple[int, int]]]] = []
        example_id_per_feature: List[str] = []

        for feature_idx, offsets in enumerate(offset_mapping):
            sample_idx = int(sample_mapping[feature_idx])
            example_id_per_feature.append(str(example_ids[sample_idx]))

            # sequence_ids indicates whether a token belongs to first(0)/second(1) sequence.
            seq_ids = tokenized.sequence_ids(feature_idx)
            context_seq_id = 1 if self._qa_pad_on_right else 0

            filt: List[Optional[Tuple[int, int]]] = []
            for token_idx, (start, end) in enumerate(offsets):
                if seq_ids[token_idx] == context_seq_id:
                    filt.append((int(start), int(end)))
                else:
                    filt.append(None)
            filtered_offsets.append(filt)

        tokenized["example_id"] = example_id_per_feature
        tokenized["offset_mapping"] = filtered_offsets

        # If answers are present, compute training labels start_positions/end_positions.
        # For SQuAD v2, empty answers => CLS index.
        if "answers" in batch:
            start_positions, end_positions = self._compute_qa_span_positions(
                batch=batch,
                tokenized=tokenized,
                sample_mapping=sample_mapping,
                filtered_offsets=filtered_offsets,
            )
            tokenized["start_positions"] = start_positions
            tokenized["end_positions"] = end_positions

        return tokenized

    ## @brief Preprocess a batch for seq2seq tasks (T5).
    # @details
    # Implements:
    # - T5 classification as text-to-text generation (project choice).
    # - T5 CNN/DailyMail summarization.
    #
    # Source/target length come from DataConfig.max_source_length / max_target_length.
    # Targets are tokenized under the tokenizer's target mode when available.
    # @param batch dict Raw dataset batch.
    # @return dict Tokenized seq2seq batch with "labels".
    def preprocess_seq2seq(self, batch: Dict[str, Any]) -> Dict[str, Any]:
        sources, targets = self._build_seq2seq_source_target(batch=batch)

        model_inputs = self._tokenizer(
            sources,
            max_length=int(self._cfg.max_source_length),
            truncation=True,
            padding=False,
        )

        labels = self._tokenize_seq2seq_targets(targets=targets, max_target_length=int(self._cfg.max_target_length))
        model_inputs["labels"] = labels["input_ids"]
        return model_inputs

    ## @brief Preprocess a batch for causal LM supervised fine-tuning (Alpaca).
    # @details
    # Formats prompt+response and masks prompt tokens in labels with -100.
    # Uses ModelConfig.max_length as the single sequence length cap.
    #
    # Prompt template (deterministic):
    # - If input non-empty:
    #   "### Instruction:\n{instruction}\n\n### Input:\n{input}\n\n### Response:\n"
    # - Else:
    #   "### Instruction:\n{instruction}\n\n### Response:\n"
    #
    # The full text is prompt + output (+ optional EOS).
    # @param batch dict Raw dataset batch.
    # @return dict Tokenized batch with input_ids/attention_mask/labels.
    def preprocess_causal_lm(self, batch: Dict[str, Any]) -> Dict[str, Any]:
        instructions: List[str] = self._get_required_list(batch, "instruction")
        inputs: List[str] = self._get_optional_list(batch, "input", default_value="")
        outputs: List[str] = self._get_required_list(batch, "output")

        prompts: List[str] = []
        full_texts: List[str] = []
        for ins, inp, out in zip(instructions, inputs, outputs):
            prompt = self._build_alpaca_prompt(instruction=str(ins), input_text=str(inp))
            response = str(out)
            eos = self._get_eos_text()
            full = prompt + response + eos
            prompts.append(prompt)
            full_texts.append(full)

        tokenized_full = self._tokenizer(
            full_texts,
            truncation=True,
            max_length=int(self._model_cfg.max_length),
            padding=False,
            add_special_tokens=True,
        )

        # Build labels: ignore prompt portion.
        # We compute prompt token lengths using identical tokenizer settings.
        tokenized_prompt = self._tokenizer(
            prompts,
            truncation=True,
            max_length=int(self._model_cfg.max_length),
            padding=False,
            add_special_tokens=True,
        )

        labels: List[List[int]] = []
        for full_ids, prompt_ids in zip(tokenized_full["input_ids"], tokenized_prompt["input_ids"]):
            prompt_len = min(len(prompt_ids), len(full_ids))
            lab = list(full_ids)
            for i in range(prompt_len):
                lab[i] = -100
            labels.append(lab)

        tokenized_full["labels"] = labels
        return tokenized_full

    ## @brief Normalize question string for SQuAD-style tokenization.
    # @param question str Raw question.
    # @return str Normalized question.
    def _normalize_question(self, question: str) -> str:
        q = str(question)
        return q.lstrip()

    ## @brief Extract one or two text fields as lists.
    # @param batch dict Batch.
    # @param fields list[str] Field names; must have length 1 or 2.
    # @return tuple[list[str], Optional[list[str]]] (text_a, text_b) where text_b is None for single-seq.
    def _extract_text_pair(
        self, batch: Dict[str, Any], fields: Sequence[str]
    ) -> Tuple[List[str], Optional[List[str]]]:
        if not fields:
            raise ValueError("DataConfig.text_fields must be non-empty for classification preprocessing.")
        if len(fields) not in (1, 2):
            raise ValueError("DataConfig.text_fields must have length 1 or 2 for classification preprocessing.")

        f0 = str(fields[0])
        if f0 not in batch:
            raise KeyError(f"Missing text field in batch: {f0}")
        a = [str(x) for x in batch[f0]]

        if len(fields) == 1:
            return a, None

        f1 = str(fields[1])
        if f1 not in batch:
            raise KeyError(f"Missing text field in batch: {f1}")
        b = [str(x) for x in batch[f1]]
        return a, b

    ## @brief Extract labels from batch if present.
    # @param batch dict Batch.
    # @param label_field str Label field.
    # @return Optional[list[int]] Labels list if present, else None.
    def _extract_optional_labels(self, batch: Dict[str, Any], label_field: str) -> Optional[List[int]]:
        lf = str(label_field)
        if not lf or lf not in batch:
            return None
        labels_raw = batch[lf]
        # Hugging Face datasets typically provide list[int] for labels in map batches.
        return [int(x) for x in labels_raw]

    ## @brief Compute SQuAD start/end positions for each tokenized feature.
    # @param batch dict Original batch with "answers".
    # @param tokenized dict Tokenized features dict (must include input_ids, offset_mapping).
    # @param sample_mapping list[int] Overflow sample mapping from tokenizer.
    # @param filtered_offsets list[list[Optional[tuple[int,int]]]] Filtered offsets per feature.
    # @return tuple[list[int], list[int]] start_positions, end_positions.
    def _compute_qa_span_positions(
        self,
        batch: Dict[str, Any],
        tokenized: Dict[str, Any],
        sample_mapping: List[int],
        filtered_offsets: List[List[Optional[Tuple[int, int]]]],
    ) -> Tuple[List[int], List[int]]:
        answers = batch["answers"]
        if not isinstance(answers, list):
            # datasets typically gives list[dict] per example in batch mode
            raise TypeError("SQuAD 'answers' field must be a list of dicts per example.")

        start_positions: List[int] = []
        end_positions: List[int] = []

        input_ids_all: List[List[int]] = list(tokenized["input_ids"])

        for feature_idx, input_ids in enumerate(input_ids_all):
            sample_idx = int(sample_mapping[feature_idx])
            answer_obj = answers[sample_idx]
            cls_index = self._find_cls_index(input_ids=input_ids)

            # SQuAD format: answer_obj["text"] and answer_obj["answer_start"] are lists.
            texts = answer_obj.get("text", [])
            starts = answer_obj.get("answer_start", [])

            if not texts or not starts:
                start_positions.append(int(cls_index))
                end_positions.append(int(cls_index))
                continue

            # Use the first answer span for supervision.
            start_char = int(starts[0])
            answer_text = str(texts[0])
            end_char = int(start_char + len(answer_text))

            offsets = filtered_offsets[feature_idx]
            # Find token start/end indices that match the character span within context tokens.
            tok_start, tok_end = self._char_span_to_token_span(
                offsets=offsets, start_char=start_char, end_char=end_char
            )
            if tok_start is None or tok_end is None:
                # If the answer cannot be found in this feature (due to windowing), mark as no-answer.
                start_positions.append(int(cls_index))
                end_positions.append(int(cls_index))
            else:
                start_positions.append(int(tok_start))
                end_positions.append(int(tok_end))

        return start_positions, end_positions

    ## @brief Map a character span to token start/end indices using offset mappings.
    # @param offsets list[Optional[tuple[int,int]]] Offset mapping (None for non-context tokens).
    # @param start_char int Start character index in context.
    # @param end_char int End character index in context.
    # @return tuple[Optional[int], Optional[int]] Token start and end indices (inclusive), or (None, None).
    def _char_span_to_token_span(
        self,
        offsets: List[Optional[Tuple[int, int]]],
        start_char: int,
        end_char: int,
    ) -> Tuple[Optional[int], Optional[int]]:
        # Find the first token whose span contains start_char, and last token whose span contains end_char-1.
        token_start: Optional[int] = None
        token_end: Optional[int] = None

        for i, off in enumerate(offsets):
            if off is None:
                continue
            s, e = off
            # start token: start_char must be within [s, e]
            if token_start is None and s <= start_char < e:
                token_start = int(i)
            # end token: end_char-1 within [s, e]
            if s < end_char <= e:
                token_end = int(i)
                break

        # If end not found by direct containment, try to find the last token that still overlaps end_char.
        if token_start is not None and token_end is None:
            for i in range(len(offsets) - 1, -1, -1):
                off = offsets[i]
                if off is None:
                    continue
                s, e = off
                if s < end_char and e >= end_char:
                    token_end = int(i)
                    break
                if s < end_char and e <= end_char:
                    # token ends before end_char but overlaps; take the last overlapping token.
                    token_end = int(i)
                    break

        if token_start is None or token_end is None or token_end < token_start:
            return None, None
        return token_start, token_end

    ## @brief Find CLS token index in tokenized input_ids.
    # @details Uses tokenizer.cls_token_id if available; otherwise uses 0.
    # @param input_ids list[int] Token ids.
    # @return int CLS index.
    def _find_cls_index(self, input_ids: List[int]) -> int:
        cls_id = getattr(self._tokenizer, "cls_token_id", None)
        if cls_id is None:
            return 0
        try:
            return int(input_ids.index(int(cls_id)))
        except ValueError:
            return 0

    ## @brief Build seq2seq sources and targets for supported tasks.
    # @details
    # Uses DataConfig.dataset_name and dataset_config_name to choose formatting when required.
    # For CNN/DailyMail, expects DataConfig.text_fields[0] = article field and DataConfig.label_field = highlights field.
    # For GLUE classification with T5, expects labels as ints and verbalizes them.
    # @param batch dict Raw dataset batch.
    # @return tuple[list[str], list[str]] sources, targets.
    def _build_seq2seq_source_target(self, batch: Dict[str, Any]) -> Tuple[List[str], List[str]]:
        dn = self._dataset_name
        dcn = self._dataset_config

        # CNN/DailyMail summarization.
        if dn in {"cnn_dailymail", "cnndm"}:
            if not self._cfg.text_fields:
                raise ValueError("For CNN/DailyMail, DataConfig.text_fields must contain the article field name.")
            src_field = str(self._cfg.text_fields[0])
            tgt_field = str(self._cfg.label_field)

            if src_field not in batch:
                raise KeyError(f"Missing CNN/DailyMail source field: {src_field}")
            if tgt_field not in batch:
                raise KeyError(
                    f"Missing CNN/DailyMail target field (configure data.label_field as highlights): {tgt_field}"
                )

            articles = [str(x) for x in batch[src_field]]
            highlights = [str(x) for x in batch[tgt_field]]

            # Standard T5 summarization prefix; paper does not specify, but is common and deterministic.
            sources = [f"summarize: {a}" for a in articles]
            targets = highlights
            return sources, targets

        # GLUE tasks as text-to-text for T5 (project decision).
        if dn == "glue":
            if dcn == "sst2":
                texts_a, _ = self._extract_text_pair(batch=batch, fields=self._cfg.text_fields)
                labels = self._extract_optional_labels(batch=batch, label_field=self._cfg.label_field)
                if labels is None:
                    raise KeyError("Missing labels for GLUE SST-2 seq2seq preprocessing.")
                sources = [f"sst2 sentence: {s}" for s in texts_a]
                targets = [self._verbalize_glue_label(task="sst2", label=int(y)) for y in labels]
                return sources, targets

            if dcn == "mnli":
                texts_a, texts_b = self._extract_text_pair(batch=batch, fields=self._cfg.text_fields)
                if texts_b is None:
                    raise ValueError("MNLI requires two text fields (premise, hypothesis) for seq2seq preprocessing.")
                labels = self._extract_optional_labels(batch=batch, label_field=self._cfg.label_field)
                if labels is None:
                    raise KeyError("Missing labels for GLUE MNLI seq2seq preprocessing.")
                sources = [f"mnli premise: {p} hypothesis: {h}" for p, h in zip(texts_a, texts_b)]
                targets = [self._verbalize_glue_label(task="mnli", label=int(y)) for y in labels]
                return sources, targets

            raise ValueError(f"Unsupported GLUE task for seq2seq preprocessing: {dcn}")

        # Generic seq2seq fallback: use text_fields as source and label_field as target text.
        if not self._cfg.text_fields:
            raise ValueError("DataConfig.text_fields must be set for seq2seq preprocessing.")
        src_field = str(self._cfg.text_fields[0])
        tgt_field = str(self._cfg.label_field)
        if src_field not in batch:
            raise KeyError(f"Missing source field for seq2seq preprocessing: {src_field}")
        if tgt_field not in batch:
            raise KeyError(f"Missing target field for seq2seq preprocessing (data.label_field): {tgt_field}")
        sources = [str(x) for x in batch[src_field]]
        targets = [str(x) for x in batch[tgt_field]]
        return sources, targets

    ## @brief Tokenize seq2seq targets using tokenizer target mode when available.
    # @param targets list[str] Target texts.
    # @param max_target_length int Maximum target length.
    # @return dict Tokenized target outputs with "input_ids".
    def _tokenize_seq2seq_targets(self, targets: List[str], max_target_length: int) -> Dict[str, Any]:
        # Newer tokenizers provide as_target_tokenizer(); newer transformers support text_target=.
        as_target = getattr(self._tokenizer, "as_target_tokenizer", None)
        if callable(as_target):
            with self._tokenizer.as_target_tokenizer():
                return self._tokenizer(
                    targets,
                    max_length=int(max_target_length),
                    truncation=True,
                    padding=False,
                )

        # Fallback for tokenizers without as_target_tokenizer (still deterministic).
        return self._tokenizer(
            targets,
            max_length=int(max_target_length),
            truncation=True,
            padding=False,
        )

    ## @brief Verbalize GLUE labels for T5 text-to-text tasks.
    # @param task str Task name ('sst2' or 'mnli').
    # @param label int Numeric label.
    # @return str Verbalized label.
    def _verbalize_glue_label(self, task: str, label: int) -> str:
        t = str(task).lower().strip()
        y = int(label)
        if t == "sst2":
            if y not in self._sst2_label_map:
                raise ValueError(f"Unexpected SST-2 label: {y}")
            return self._sst2_label_map[y]
        if t == "mnli":
            if y not in self._mnli_label_map:
                raise ValueError(f"Unexpected MNLI label: {y}")
            return self._mnli_label_map[y]
        raise ValueError(f"Unsupported GLUE task for label verbalization: {task}")

    ## @brief Build Alpaca instruction prompt from instruction and optional input.
    # @param instruction str Instruction text.
    # @param input_text str Optional input text.
    # @return str Prompt.
    def _build_alpaca_prompt(self, instruction: str, input_text: str) -> str:
        ins = str(instruction).strip()
        inp = str(input_text).strip()

        if inp:
            return f"### Instruction:\n{ins}\n\n### Input:\n{inp}\n\n### Response:\n"
        return f"### Instruction:\n{ins}\n\n### Response:\n"

    ## @brief Get EOS text to append to Alpaca examples if tokenizer defines it.
    # @details If eos_token exists, append it; otherwise append empty string.
    # @return str EOS token string or empty string.
    def _get_eos_text(self) -> str:
        eos_token = getattr(self._tokenizer, "eos_token", None)
        if eos_token is None:
            return ""
        # Ensure a single EOS is appended; do not add extra whitespace.
        return str(eos_token)

    ## @brief Get a required list field from a batch.
    # @param batch dict Batch mapping.
    # @param key str Field key.
    # @return list[str] Field values cast to string.
    def _get_required_list(self, batch: Dict[str, Any], key: str) -> List[str]:
        k = str(key)
        if k not in batch:
            raise KeyError(f"Missing required field in batch: {k}")
        vals = batch[k]
        if not isinstance(vals, list):
            raise TypeError(f"Batch field '{k}' must be a list, got {type(vals)}")
        return [str(v) for v in vals]

    ## @brief Get an optional list field from a batch or default to repeated values.
    # @param batch dict Batch mapping.
    # @param key str Field key.
    # @param default_value str Default value when field is absent.
    # @return list[str] Field values.
    def _get_optional_list(self, batch: Dict[str, Any], key: str, default_value: str) -> List[str]:
        k = str(key)
        if k in batch:
            vals = batch[k]
            if not isinstance(vals, list):
                raise TypeError(f"Batch field '{k}' must be a list, got {type(vals)}")
            return [str(v) for v in vals]
        # Infer batch size from any present list field.
        n = self._infer_batch_size(batch=batch)
        return [str(default_value) for _ in range(n)]

    ## @brief Infer batch size from the first list value in the batch.
    # @param batch dict Batch mapping.
    # @return int Batch size (0 if cannot infer).
    def _infer_batch_size(self, batch: Dict[str, Any]) -> int:
        for v in batch.values():
            if isinstance(v, list):
                return int(len(v))
        return 0
