## src/eval/lm_eval_adapter.py
from __future__ import annotations

import json
import os
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, List, Mapping, Optional, Sequence, Tuple, Union

import torch
from packaging import version
from transformers import PreTrainedModel, PreTrainedTokenizerBase

from src.config import EvalConfig, ExperimentConfig, ModelConfig, RuntimeConfig
from src.utils.logging import get_logger, save_json


## @brief Normalized lm-eval task specification.
# @details Stores mapping from paper/config task name to lm-eval-harness task id and how to extract the score.
# @param key str Canonical task key used in our outputs (e.g., "arc", "hellaswag", "mmlu", "truthfulqa").
# @param harness_task str lm-eval-harness task identifier (e.g., "arc_challenge").
# @param num_fewshot int Few-shot setting to pass to lm-eval.
# @param preferred_metrics list[str] Ordered list of metric keys to try extracting from lm-eval results.
@dataclass(frozen=True)
class _TaskSpec:
    key: str
    harness_task: str
    num_fewshot: int
    preferred_metrics: List[str]


## @brief LLaMA/lm-eval evaluation adapter.
# @details
# Bridges a HF causal LM (in-memory model+tokenizer or a pretrained path) into lm-eval-harness evaluation,
# extracting paper-required task metrics for ARC/HellaSwag/MMLU/TruthfulQA and computing the average.
#
# Paper-required evaluation (Section 5.1):
# - 25-shot ARC
# - 10-shot HellaSwag
# - 5-shot MMLU
# - 0-shot TruthfulQA
#
# Task-name ambiguity note:
# - ARC is interpreted as "arc_challenge" (Open LLM leaderboard convention; also used in config.py defaults).
# - TruthfulQA is interpreted as the multiple-choice variant task id from config defaults ("truthfulqa_mc").
# Metric-key ambiguity note:
# - We extract accuracy-like metrics with task-specific preferences (see _TASK_METRIC_PREFERENCES).
class LMEvalAdapter:
    ## @brief Initialize LMEvalAdapter.
    # @param eval_config EvalConfig Evaluation configuration containing lm_eval_tasks and lm_eval_num_fewshot.
    # @param model_config ModelConfig Model configuration (used for batch size selection by backbone name).
    # @param runtime_config RuntimeConfig Runtime configuration (device).
    def __init__(
        self,
        eval_config: EvalConfig,
        model_config: ModelConfig,
        runtime_config: RuntimeConfig,
    ) -> None:
        self._logger = get_logger(self.__class__.__name__, level=str(runtime_config.log_level))

        if not isinstance(eval_config, EvalConfig):
            raise TypeError(f"eval_config must be EvalConfig, got {type(eval_config)}")
        if not isinstance(model_config, ModelConfig):
            raise TypeError(f"model_config must be ModelConfig, got {type(model_config)}")
        if not isinstance(runtime_config, RuntimeConfig):
            raise TypeError(f"runtime_config must be RuntimeConfig, got {type(runtime_config)}")

        self._eval_cfg: EvalConfig = eval_config
        self._model_cfg: ModelConfig = model_config
        self._runtime_cfg: RuntimeConfig = runtime_config

        if str(self._model_cfg.task_type) != "causal_lm":
            raise ValueError("LMEvalAdapter is only valid for model.task_type='causal_lm'.")

    ## @brief Run lm-eval-harness and return normalized metrics.
    # @details
    # Supports two modes:
    # 1) In-memory: provide model + tokenizer (recommended right after training).
    # 2) From pretrained path: provide model_path (and optional tokenizer_path).
    #
    # The method:
    # - normalizes task names from EvalConfig.lm_eval_tasks and lm_eval_num_fewshot,
    # - chooses batch size using config.yaml rules already applied by config.py normalization,
    # - runs lm-eval-harness with the exact few-shot counts,
    # - extracts one scalar score per task and computes the arithmetic mean ("avg").
    #
    # @param model Optional[PreTrainedModel] In-memory HF causal LM.
    # @param tokenizer Optional[PreTrainedTokenizerBase] Tokenizer for in-memory model.
    # @param model_path Optional[str] Hugging Face pretrained path for model loading in lm-eval.
    # @param tokenizer_path Optional[str] Optional tokenizer path; if not provided with model_path, uses model_path.
    # @param batch_size Optional[int] Override batch size; if None, uses config.data.eval_batch_size upstream.
    # @param limit Optional[int] Optional lm-eval limit for debugging; if None, evaluate full task.
    # @param output_dir Optional[str] Optional directory to persist raw lm-eval results.
    # @return dict[str, float] Task metrics dict with keys per canonical task plus "avg".
    def run(
        self,
        model: Optional[PreTrainedModel] = None,
        tokenizer: Optional[PreTrainedTokenizerBase] = None,
        model_path: Optional[str] = None,
        tokenizer_path: Optional[str] = None,
        batch_size: Optional[int] = None,
        limit: Optional[int] = None,
        output_dir: Optional[str] = None,
    ) -> Dict[str, float]:
        task_specs = self._build_task_specs()

        # Choose batch size: must come from config-derived eval batch size (paper config.yaml),
        # unless explicitly overridden by caller.
        bs = self._resolve_batch_size(batch_size=batch_size)

        raw = self._run_lm_eval(
            task_specs=task_specs,
            model=model,
            tokenizer=tokenizer,
            model_path=model_path,
            tokenizer_path=tokenizer_path,
            batch_size=bs,
            limit=limit,
        )

        # Persist raw results if requested (reproducibility).
        if output_dir is not None:
            out_dir = Path(str(output_dir)).expanduser().resolve()
            out_dir.mkdir(parents=True, exist_ok=True)
            save_json(out_dir / "lm_eval_raw_results.json", raw)

        # Parse scalar metrics in paper reporting style.
        metrics = self._extract_task_metrics(raw_results=raw, task_specs=task_specs)
        metrics["avg"] = self._compute_avg(metrics=metrics, task_specs=task_specs)
        return metrics

    ## @brief Build normalized task specs from EvalConfig.
    # @details Uses EvalConfig.lm_eval_tasks and EvalConfig.lm_eval_num_fewshot.
    # @return list[_TaskSpec] Task specs in deterministic order.
    def _build_task_specs(self) -> List[_TaskSpec]:
        tasks = list(self._eval_cfg.lm_eval_tasks)
        fewshot_map = dict(self._eval_cfg.lm_eval_num_fewshot)

        if not tasks:
            raise ValueError("evaluation.lm_eval_tasks is empty; cannot run lm-eval.")
        if not fewshot_map:
            raise ValueError("evaluation.lm_eval_num_fewshot is empty; cannot run lm-eval.")

        specs: List[_TaskSpec] = []
        for t in tasks:
            task_id = str(t).strip()
            if not task_id:
                continue

            # Our configs already use harness-native names by default (config.py sets:
            # arc_challenge, hellaswag, mmlu, truthfulqa_mc).
            # Still, support paper-style aliases if user passed them.
            harness_task = _normalize_task_to_harness_id(task_id)

            if harness_task not in fewshot_map:
                # Config validation in config.py requires fewshot for each task in lm_eval_tasks,
                # but we keep an explicit error here for standalone use.
                raise ValueError(
                    f"Missing fewshot setting for lm-eval task '{harness_task}'. "
                    f"Available keys: {sorted(fewshot_map.keys())}"
                )

            key = _normalize_task_key_for_output(harness_task)
            preferred_metrics = _TASK_METRIC_PREFERENCES.get(harness_task, ["acc_norm", "acc", "mc2"])
            specs.append(
                _TaskSpec(
                    key=key,
                    harness_task=harness_task,
                    num_fewshot=int(fewshot_map[harness_task]),
                    preferred_metrics=list(preferred_metrics),
                )
            )

        # Deterministic order by harness task name.
        specs = sorted(specs, key=lambda s: (s.harness_task, s.key))
        if not specs:
            raise ValueError("No valid lm-eval tasks after normalization.")
        return specs

    ## @brief Resolve evaluation batch size.
    # @details Uses caller override if provided; otherwise uses config-normalized batch size from upstream.
    # @param batch_size Optional[int] Override batch size.
    # @return int Batch size.
    def _resolve_batch_size(self, batch_size: Optional[int]) -> int:
        if batch_size is not None:
            bs = int(batch_size)
            if bs <= 0:
                raise ValueError("batch_size must be > 0 when provided.")
            return bs

        # For this project, config.py normalization sets data.eval_batch_size according to config.yaml:
        # llama_7b -> 32, llama_13b -> 4. Evaluator should pass it; we still derive from model name if needed.
        # If caller doesn't provide it, we fall back to model-name-based selection using the same rule.
        name = str(self._model_cfg.backbone_name).lower()
        if "13b" in name:
            return 4
        return 32

    ## @brief Execute lm-eval-harness and return raw results.
    # @param task_specs list[_TaskSpec] Normalized tasks.
    # @param model Optional[PreTrainedModel] In-memory model.
    # @param tokenizer Optional[PreTrainedTokenizerBase] Tokenizer for in-memory model.
    # @param model_path Optional[str] Pretrained path for model loading.
    # @param tokenizer_path Optional[str] Tokenizer path.
    # @param batch_size int Evaluation batch size.
    # @param limit Optional[int] Optional evaluation limit.
    # @return dict[str, Any] Raw results returned by lm-eval-harness.
    def _run_lm_eval(
        self,
        task_specs: List[_TaskSpec],
        model: Optional[PreTrainedModel],
        tokenizer: Optional[PreTrainedTokenizerBase],
        model_path: Optional[str],
        tokenizer_path: Optional[str],
        batch_size: int,
        limit: Optional[int],
    ) -> Dict[str, Any]:
        # Import lm_eval lazily to keep project import graph light.
        try:
            import lm_eval  # type: ignore
            from lm_eval import evaluator as lm_evaluator  # type: ignore
        except Exception as e:
            raise ImportError(
                "Failed to import lm-eval-harness (package 'lm-eval'). "
                "Ensure required package 'lm-eval>=0.4.2' is installed."
            ) from e

        lm_eval_ver = getattr(lm_eval, "__version__", "")
        self._logger.info("lm-eval version: %s", str(lm_eval_ver))

        # Build tasks list and per-task fewshot config.
        tasks = [s.harness_task for s in task_specs]
        num_fewshot = {s.harness_task: int(s.num_fewshot) for s in task_specs}

        # Device: lm-eval expects a string like "cuda" or "cuda:0".
        device = str(self._runtime_cfg.device)

        # Model arguments:
        # We must support both in-memory and from-pretrained. lm-eval-harness supports the HF model loader
        # via model="hf" with model_args string.
        # For in-memory, the most robust approach across lm-eval versions is to use its HF wrapper with
        # pretrained path; however, the design requires supporting in-memory too.
        # lm-eval >=0.4 provides the "hf" model with "pretrained=...,tokenizer=..." args.
        # For in-memory, we write to a temporary directory via save_pretrained to ensure full compatibility.
        # This is not a stub; it's a faithful conversion required by lm-eval's interface.
        pretrained_path = self._resolve_pretrained_path(
            model=model,
            tokenizer=tokenizer,
            model_path=model_path,
            tokenizer_path=tokenizer_path,
        )

        # Compose model_args string for lm-eval HF wrapper.
        # We do not fabricate quantization or dtype; we rely on default HF loading and the caller's environment.
        # We must set device; batch size is passed separately.
        model_args = f"pretrained={pretrained_path},tokenizer={pretrained_path}"

        # `limit` is a harness option for debugging; if not provided, do full evaluation.
        limit_val: Optional[int] = None
        if limit is not None:
            limit_val = int(limit)
            if limit_val <= 0:
                raise ValueError("limit must be > 0 when provided.")

        # Evaluate in one call to match paper "evaluated with lm-eval-harness package".
        # We set:
        # - model = "hf"
        # - tasks = [...]
        # - num_fewshot per task (exact paper settings are in config.yaml -> EvalConfig)
        # - batch_size derived from config.yaml (via config.py normalization)
        # - device from runtime config
        # - limit optional
        #
        # API compatibility:
        # lm_eval.evaluator.simple_evaluate signature differs slightly across versions; handle both.
        raw: Dict[str, Any]
        try:
            raw = lm_evaluator.simple_evaluate(
                model="hf",
                model_args=model_args,
                tasks=tasks,
                num_fewshot=num_fewshot,
                batch_size=int(batch_size),
                device=device,
                limit=limit_val,
            )
        except TypeError:
            # Older/alternative signature: sometimes uses `batch_size` or `batch_size` in model_args.
            # We retry with minimal arguments and rely on defaults.
            raw = lm_evaluator.simple_evaluate(
                model="hf",
                model_args=model_args,
                tasks=tasks,
                num_fewshot=num_fewshot,
                device=device,
                limit=limit_val,
            )

        if not isinstance(raw, dict):
            raise TypeError(f"lm-eval simple_evaluate returned unexpected type: {type(raw)}")

        # Sanity-check expected keys.
        if "results" not in raw or not isinstance(raw["results"], dict):
            raise ValueError("lm-eval output missing 'results' dict.")

        return raw

    ## @brief Resolve a pretrained path usable by lm-eval-harness.
    # @details
    # - If model_path is provided, use it (and tokenizer_path if provided, else model_path).
    # - Else require in-memory model+tokenizer, save both to a deterministic temp directory under output_dir.
    # @param model Optional[PreTrainedModel] In-memory model.
    # @param tokenizer Optional[PreTrainedTokenizerBase] In-memory tokenizer.
    # @param model_path Optional[str] Pretrained model path.
    # @param tokenizer_path Optional[str] Pretrained tokenizer path.
    # @return str Path to a directory containing model+tokenizer in HF format.
    def _resolve_pretrained_path(
        self,
        model: Optional[PreTrainedModel],
        tokenizer: Optional[PreTrainedTokenizerBase],
        model_path: Optional[str],
        tokenizer_path: Optional[str],
    ) -> str:
        if model_path is not None:
            mp = str(model_path).strip()
            if not mp:
                raise ValueError("model_path was provided but is empty.")
            # lm-eval HF wrapper typically uses one path for both; if tokenizer differs, we would need
            # a different model_args. For this reproduction, we keep them aligned unless explicitly saved.
            if tokenizer_path is not None and str(tokenizer_path).strip() != mp:
                # Save a merged directory containing tokenizer from tokenizer_path and model from model_path.
                # This avoids inventing model_args formats; it produces a standard HF directory for both.
                merged_dir = Path(self._runtime_cfg.output_dir) / "lm_eval_pretrained_merged"
                merged_dir.mkdir(parents=True, exist_ok=True)
                return self._merge_pretrained_dirs(
                    model_dir=Path(mp),
                    tokenizer_dir=Path(str(tokenizer_path).strip()),
                    out_dir=merged_dir,
                )
            return mp

        if model is None or tokenizer is None:
            raise ValueError(
                "Must provide either model_path, or both in-memory model and tokenizer for lm-eval."
            )

        out_dir = Path(self._runtime_cfg.output_dir) / "lm_eval_pretrained_in_memory"
        out_dir.mkdir(parents=True, exist_ok=True)

        # Save HF artifacts; this is required by lm-eval's standard 'hf' model loader.
        # We do not alter weights; we simply serialize in-memory state.
        model.save_pretrained(str(out_dir))
        tokenizer.save_pretrained(str(out_dir))
        return str(out_dir)

    ## @brief Merge separate model/tokenizer pretrained directories into a single directory.
    # @details Copies tokenizer files into the model directory output to satisfy lm-eval "tokenizer=pretrained" path.
    # @param model_dir Path Directory containing model weights/config.
    # @param tokenizer_dir Path Directory containing tokenizer files.
    # @param out_dir Path Output directory to write merged assets.
    # @return str Output directory path as string.
    def _merge_pretrained_dirs(self, model_dir: Path, tokenizer_dir: Path, out_dir: Path) -> str:
        if not model_dir.exists():
            raise FileNotFoundError(f"model_dir not found: {model_dir}")
        if not tokenizer_dir.exists():
            raise FileNotFoundError(f"tokenizer_dir not found: {tokenizer_dir}")
        out_dir.mkdir(parents=True, exist_ok=True)

        # Copy model files.
        for p in model_dir.glob("*"):
            if p.is_file():
                (out_dir / p.name).write_bytes(p.read_bytes())

        # Copy tokenizer files (overwrite if necessary to ensure tokenizer matches).
        for p in tokenizer_dir.glob("*"):
            if p.is_file():
                (out_dir / p.name).write_bytes(p.read_bytes())

        return str(out_dir)

    ## @brief Extract task scalar metrics from raw lm-eval output.
    # @details
    # lm-eval output format:
    # raw["results"][task_name] is typically a dict of metric_name -> value
    # We select one scalar per task using TaskSpec.preferred_metrics order.
    # @param raw_results dict Raw output dict from lm-eval.
    # @param task_specs list[_TaskSpec] Task specs used to run evaluation.
    # @return dict[str, float] Canonical output key -> scalar score.
    def _extract_task_metrics(self, raw_results: Dict[str, Any], task_specs: List[_TaskSpec]) -> Dict[str, float]:
        results = raw_results.get("results", {})
        if not isinstance(results, dict):
            raise TypeError("lm-eval raw_results['results'] must be a dict.")

        out: Dict[str, float] = {}
        for spec in task_specs:
            task_name = spec.harness_task
            if task_name not in results:
                raise KeyError(
                    f"lm-eval results missing task '{task_name}'. "
                    f"Available tasks: {sorted(results.keys())}"
                )
            task_res = results[task_name]
            if not isinstance(task_res, dict):
                raise TypeError(f"lm-eval results for task '{task_name}' must be a dict, got {type(task_res)}")

            score = _extract_preferred_metric(
                task_metrics=task_res,
                preferred_keys=spec.preferred_metrics,
                task_name=task_name,
            )
            out[spec.key] = float(score)

        return out

    ## @brief Compute arithmetic mean of task scores.
    # @details Computes mean over the tasks actually requested by EvalConfig (paper uses 4 tasks).
    # @param metrics dict[str, float] Extracted task metrics.
    # @param task_specs list[_TaskSpec] Task specs list.
    # @return float Arithmetic mean score.
    def _compute_avg(self, metrics: Dict[str, float], task_specs: List[_TaskSpec]) -> float:
        keys = [s.key for s in task_specs]
        vals: List[float] = []
        for k in keys:
            if k not in metrics:
                raise KeyError(f"Missing metric '{k}' required to compute avg.")
            vals.append(float(metrics[k]))
        if not vals:
            raise ValueError("No task values available to compute avg.")
        return float(sum(vals) / float(len(vals)))


# Task mapping constants.
# These are consistent with config.py defaults and common Open LLM leaderboard settings.
_TASK_ALIASES_TO_HARNESS: Dict[str, str] = {
    # Paper/leaderboard-style aliases -> harness ids
    "arc": "arc_challenge",
    "arc_challenge": "arc_challenge",
    "hellaswag": "hellaswag",
    "mmlu": "mmlu",
    "truthfulqa": "truthfulqa_mc",
    "truthfulqa_mc": "truthfulqa_mc",
    "truthfulqa_mc1": "truthfulqa_mc1",
    "truthfulqa_mc2": "truthfulqa_mc2",
}

# Preferred metric keys per harness task.
# lm-eval tasks often provide both `acc` and `acc_norm`. For Open LLM leaderboard conventions:
# - ARC and HellaSwag commonly use normalized accuracy (`acc_norm`).
# - MMLU commonly uses `acc`.
# - TruthfulQA multiple-choice variants commonly report `mc2` or `acc`.
_TASK_METRIC_PREFERENCES: Dict[str, List[str]] = {
    "arc_challenge": ["acc_norm", "acc"],
    "hellaswag": ["acc_norm", "acc"],
    "mmlu": ["acc", "acc_norm"],
    "truthfulqa_mc": ["mc2", "acc", "acc_norm"],
    "truthfulqa_mc1": ["mc1", "mc2", "acc", "acc_norm"],
    "truthfulqa_mc2": ["mc2", "acc", "acc_norm"],
}


## @brief Normalize a configured task name to a harness task id.
# @param task str Task name from config.
# @return str Harness task id.
def _normalize_task_to_harness_id(task: str) -> str:
    t = str(task).strip().lower()
    if t in _TASK_ALIASES_TO_HARNESS:
        return _TASK_ALIASES_TO_HARNESS[t]
    # If task not in aliases, assume user provided a harness-native task id.
    # We still return it as-is for maximal compatibility with lm-eval-harness.
    return str(task).strip()


## @brief Normalize harness task ids to canonical output keys.
# @details Ensures output dict has stable keys for paper-style reporting.
# @param harness_task str Harness task id.
# @return str Canonical key.
def _normalize_task_key_for_output(harness_task: str) -> str:
    t = str(harness_task).strip().lower()
    if t == "arc_challenge":
        return "arc"
    if t == "hellaswag":
        return "hellaswag"
    if t == "mmlu":
        return "mmlu"
    if t.startswith("truthfulqa"):
        return "truthfulqa"
    # Fallback: use the harness task id.
    return str(harness_task).strip().lower()


## @brief Extract a single preferred scalar metric from lm-eval per-task metrics.
# @details Tries keys in order; if none found, raises an error with available keys.
# @param task_metrics dict[str, Any] Metric dict for a single lm-eval task.
# @param preferred_keys list[str] Ordered preference list of metric keys.
# @param task_name str Task name for error messages.
# @return float Extracted scalar score.
def _extract_preferred_metric(
    task_metrics: Mapping[str, Any],
    preferred_keys: Sequence[str],
    task_name: str,
) -> float:
    # First, try preferred keys in order.
    for k in preferred_keys:
        key = str(k)
        if key in task_metrics:
            v = task_metrics[key]
            try:
                return float(v)
            except Exception:
                # Try scalar tensor/numpy.
                item = getattr(v, "item", None)
                if callable(item):
                    try:
                        return float(item())
                    except Exception:
                        pass

    # Next, try any "acc*" key as a fallback for robustness.
    for k, v in task_metrics.items():
        ks = str(k).lower()
        if ks.startswith("acc"):
            try:
                return float(v)
            except Exception:
                item = getattr(v, "item", None)
                if callable(item):
                    try:
                        return float(item())
                    except Exception:
                        pass

    available = sorted([str(k) for k in task_metrics.keys()])
    raise KeyError(
        f"Could not extract a scalar metric for task '{task_name}'. "
        f"Preferred keys tried: {list(preferred_keys)}. Available keys: {available}."
    )


## @brief Convenience function for Evaluator to run lm-eval-harness with ExperimentConfig.
# @details Keeps Evaluator logic minimal while preserving design constraints.
# @param model Optional[PreTrainedModel] In-memory model.
# @param tokenizer Optional[PreTrainedTokenizerBase] Tokenizer.
# @param config ExperimentConfig Experiment config with evaluation/model/runtime settings.
# @param model_path Optional[str] Optional pretrained path.
# @param tokenizer_path Optional[str] Optional tokenizer path.
# @param limit Optional[int] Optional lm-eval limit.
# @param output_dir Optional[str] Optional output directory for raw results.
# @return dict[str, float] Normalized task metrics including avg.
def run_lm_eval_harness(
    model: Optional[PreTrainedModel],
    tokenizer: Optional[PreTrainedTokenizerBase],
    config: ExperimentConfig,
    model_path: Optional[str] = None,
    tokenizer_path: Optional[str] = None,
    limit: Optional[int] = None,
    output_dir: Optional[str] = None,
) -> Dict[str, float]:
    if not isinstance(config, ExperimentConfig):
        raise TypeError(f"config must be ExperimentConfig, got {type(config)}")

    adapter = LMEvalAdapter(
        eval_config=config.evaluation,
        model_config=config.model,
        runtime_config=config.runtime,
    )
    # Use eval batch size computed by config normalization (paper config.yaml), by passing it explicitly
    # to avoid accidental fallback changes.
    batch_size = int(config.data.eval_batch_size)
    return adapter.run(
        model=model,
        tokenizer=tokenizer,
        model_path=model_path,
        tokenizer_path=tokenizer_path,
        batch_size=batch_size,
        limit=limit,
        output_dir=output_dir,
    )
