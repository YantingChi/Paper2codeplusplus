## src/training/callbacks.py
from __future__ import annotations

import math
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Dict, List, Mapping, Optional, Tuple

from src.utils.logging import get_logger, save_json


## @brief Lightweight evaluation scheduler callback.
# @details
# Decides whether to run evaluation at the current global step based on a fixed step interval.
# This supports the paper's periodic dev-set evaluation used for best checkpoint selection and
# time-to-accuracy (TTA) tracking on small models.
class EvalSchedulerCallback:
    ## @brief Initialize evaluation scheduler.
    # @param eval_every_steps int Evaluate every N steps. If <= 0, evaluation scheduling is disabled.
    # @param start_step int Minimum global step to begin scheduling evaluations (default: 1).
    def __init__(self, eval_every_steps: int, start_step: int = 1) -> None:
        self._logger = get_logger(self.__class__.__name__)
        self._eval_every_steps: int = int(eval_every_steps)
        self._start_step: int = int(start_step)
        self._last_eval_step: int = -1

    ## @brief Decide whether to evaluate now.
    # @param global_step int Current global step (0-based).
    # @param epoch int Current epoch (0-based). Included for future extensibility.
    # @param force bool Whether to force evaluation regardless of interval.
    # @return bool True if evaluation should run.
    def should_evaluate(self, global_step: int, epoch: int, force: bool = False) -> bool:
        step = int(global_step)
        _ = int(epoch)

        if bool(force):
            self._last_eval_step = step
            return True

        if self._eval_every_steps <= 0:
            return False
        if step < self._start_step:
            return False
        if step == self._last_eval_step:
            return False
        if step % self._eval_every_steps != 0:
            return False

        self._last_eval_step = step
        return True

    ## @brief Return scheduler state for serialization.
    # @return dict[str, Any] Serializable state dict.
    def state_dict(self) -> Dict[str, Any]:
        return {
            "eval_every_steps": int(self._eval_every_steps),
            "start_step": int(self._start_step),
            "last_eval_step": int(self._last_eval_step),
        }


## @brief Periodic checkpoint scheduler and recorder.
# @details
# Decides when to save checkpoints based on a fixed step interval and records saved checkpoint paths.
# Trainer is responsible for actually saving model artifacts; this callback only schedules/records.
class CheckpointCallback:
    ## @brief Initialize checkpoint callback.
    # @param save_every_steps int Save a checkpoint every N steps. If <= 0, periodic saving is disabled.
    # @param start_step int Minimum global step to begin scheduling checkpoints (default: 1).
    # @param keep_last int Max number of recorded checkpoints to keep in metadata (does not delete files).
    # @param output_dir str Directory for writing callback metadata JSON.
    def __init__(
        self,
        save_every_steps: int,
        start_step: int = 1,
        keep_last: int = 1000,
        output_dir: str = "outputs",
    ) -> None:
        self._logger = get_logger(self.__class__.__name__)
        self._save_every_steps: int = int(save_every_steps)
        self._start_step: int = int(start_step)
        self._keep_last: int = int(keep_last)
        self._output_dir: str = str(output_dir)
        self._last_save_step: int = -1
        self._saved: List[Dict[str, Any]] = []

    ## @brief Decide whether to save a checkpoint now.
    # @param global_step int Current global step (0-based).
    # @param epoch int Current epoch (0-based). Included for metadata.
    # @param force bool Whether to force checkpoint saving regardless of interval.
    # @return bool True if a checkpoint should be saved.
    def should_save(self, global_step: int, epoch: int, force: bool = False) -> bool:
        step = int(global_step)
        _ = int(epoch)

        if bool(force):
            self._last_save_step = step
            return True

        if self._save_every_steps <= 0:
            return False
        if step < self._start_step:
            return False
        if step == self._last_save_step:
            return False
        if step % self._save_every_steps != 0:
            return False

        self._last_save_step = step
        return True

    ## @brief Record a saved checkpoint path and minimal metadata.
    # @param path str Saved checkpoint path.
    # @param step int Global step at which it was saved.
    # @param epoch int Epoch at which it was saved.
    # @param tag str Optional tag (e.g., "step", "best", "final").
    # @param stage str Optional stage label (e.g., "pruning", "recovery").
    # @return None
    def record_checkpoint(
        self,
        path: str,
        step: int,
        epoch: int,
        tag: str = "",
        stage: str = "",
    ) -> None:
        rec = {
            "path": str(path),
            "step": int(step),
            "epoch": int(epoch),
            "tag": str(tag),
            "stage": str(stage),
        }
        self._saved.append(rec)
        if self._keep_last > 0 and len(self._saved) > self._keep_last:
            self._saved = self._saved[-self._keep_last :]

    ## @brief Persist checkpoint metadata to disk as JSON.
    # @param filename str Output JSON filename (default: "checkpoints.json").
    # @return str Path to written JSON.
    def save_metadata(self, filename: str = "checkpoints.json") -> str:
        out_path = Path(self._output_dir) / str(filename)
        return save_json(out_path, self.state_dict())

    ## @brief Return callback state for serialization.
    # @return dict[str, Any] Serializable state dict.
    def state_dict(self) -> Dict[str, Any]:
        return {
            "save_every_steps": int(self._save_every_steps),
            "start_step": int(self._start_step),
            "keep_last": int(self._keep_last),
            "last_save_step": int(self._last_save_step),
            "saved_checkpoints": list(self._saved),
        }


## @brief Best-metric tracker callback.
# @details
# Tracks the best observed scalar metric and associated metadata. This supports selecting the best
# checkpoint for final reporting as used in the paper.
class BestMetricCallback:
    ## @brief Initialize best-metric tracker.
    # @param metric_name str Name of the monitored metric (e.g., "accuracy", "f1", "rougeL", "avg").
    # @param mode str Optimization mode: "max" (higher is better) or "min" (lower is better).
    # @param min_delta float Minimum change needed to qualify as an improvement.
    # @param output_dir str Directory for writing callback metadata JSON.
    def __init__(
        self,
        metric_name: str,
        mode: str = "max",
        min_delta: float = 0.0,
        output_dir: str = "outputs",
    ) -> None:
        self._logger = get_logger(self.__class__.__name__)
        self._metric_name: str = str(metric_name)
        self._mode: str = str(mode).lower().strip()
        self._min_delta: float = float(min_delta)
        self._output_dir: str = str(output_dir)

        if self._mode not in {"max", "min"}:
            raise ValueError("mode must be one of {'max','min'}")
        if math.isnan(self._min_delta) or math.isinf(self._min_delta) or self._min_delta < 0.0:
            raise ValueError("min_delta must be a finite non-negative float")

        self._best_metric: Optional[float] = None
        self._best_step: Optional[int] = None
        self._best_epoch: Optional[int] = None
        self._best_checkpoint: Optional[str] = None
        self._best_metrics: Optional[Dict[str, float]] = None
        self._best_stage: Optional[str] = None

    ## @brief Update best metric state with a new evaluation result.
    # @param metric_value float Scalar monitored metric value.
    # @param metrics dict[str, float] Full metrics dictionary for snapshotting.
    # @param step int Global step.
    # @param epoch int Epoch.
    # @param checkpoint_path Optional[str] Checkpoint path corresponding to this evaluation (if already saved).
    # @param stage str Optional stage label ("pruning" / "recovery").
    # @return bool True if this update improved the best metric.
    def update(
        self,
        metric_value: float,
        metrics: Dict[str, float],
        step: int,
        epoch: int,
        checkpoint_path: Optional[str] = None,
        stage: str = "",
    ) -> bool:
        val = float(metric_value)
        if math.isnan(val) or math.isinf(val):
            self._logger.warning("Ignoring non-finite metric update: %s=%s", self._metric_name, val)
            return False

        improved = self._is_improvement(current=val, best=self._best_metric)
        if not improved:
            return False

        self._best_metric = val
        self._best_step = int(step)
        self._best_epoch = int(epoch)
        self._best_checkpoint = str(checkpoint_path) if checkpoint_path is not None else self._best_checkpoint
        self._best_metrics = {str(k): float(v) for k, v in metrics.items()}
        self._best_stage = str(stage)
        return True

    ## @brief Record the checkpoint path after trainer saves a best checkpoint.
    # @details This should be called by Trainer right after saving the "best" checkpoint.
    # @param checkpoint_path str Path to the newly saved best checkpoint.
    # @return None
    def set_best_checkpoint_path(self, checkpoint_path: str) -> None:
        self._best_checkpoint = str(checkpoint_path)

    ## @brief Check whether a new metric is an improvement given current best.
    # @param current float Current metric.
    # @param best Optional[float] Best metric so far.
    # @return bool True if improved.
    def _is_improvement(self, current: float, best: Optional[float]) -> bool:
        if best is None:
            return True
        if self._mode == "max":
            return float(current) > float(best) + float(self._min_delta)
        return float(current) < float(best) - float(self._min_delta)

    ## @brief Persist best-metric metadata to disk as JSON.
    # @param filename str Output JSON filename (default: "best_metric.json").
    # @return str Path to written JSON.
    def save_metadata(self, filename: str = "best_metric.json") -> str:
        out_path = Path(self._output_dir) / str(filename)
        return save_json(out_path, self.state_dict())

    ## @brief Return callback state for serialization.
    # @return dict[str, Any] Serializable state dict.
    def state_dict(self) -> Dict[str, Any]:
        return {
            "metric_name": str(self._metric_name),
            "mode": str(self._mode),
            "min_delta": float(self._min_delta),
            "best_metric": None if self._best_metric is None else float(self._best_metric),
            "best_step": self._best_step,
            "best_epoch": self._best_epoch,
            "best_checkpoint": self._best_checkpoint,
            "best_stage": self._best_stage,
            "best_metrics": self._best_metrics,
        }

    ## @brief Return best checkpoint path (if any).
    # @param None
    # @return Optional[str] Best checkpoint path.
    def best_checkpoint_path(self) -> Optional[str]:
        return self._best_checkpoint

    ## @brief Return best metric value (if any).
    # @param None
    # @return Optional[float] Best metric.
    def best_metric(self) -> Optional[float]:
        return self._best_metric


## @brief Optional patience-based early stopping callback.
# @details
# Not used by default in the paper (which uses fixed epoch counts), but implemented for completeness.
# Trainer must explicitly instantiate/use it.
class EarlyStoppingCallback:
    ## @brief Initialize early stopping callback.
    # @param mode str Optimization mode: "max" (higher is better) or "min" (lower is better).
    # @param patience int Number of consecutive non-improving evaluations before stopping.
    # @param min_delta float Minimum improvement threshold.
    def __init__(self, mode: str = "max", patience: int = 0, min_delta: float = 0.0) -> None:
        self._logger = get_logger(self.__class__.__name__)
        self._mode: str = str(mode).lower().strip()
        self._patience: int = int(patience)
        self._min_delta: float = float(min_delta)

        if self._mode not in {"max", "min"}:
            raise ValueError("mode must be one of {'max','min'}")
        if self._patience < 0:
            raise ValueError("patience must be >= 0")
        if math.isnan(self._min_delta) or math.isinf(self._min_delta) or self._min_delta < 0.0:
            raise ValueError("min_delta must be a finite non-negative float")

        self._best: Optional[float] = None
        self._num_bad: int = 0
        self._should_stop: bool = False

    ## @brief Update early stopping state with a new metric.
    # @param metric_value float Current metric value.
    # @return bool True if early stopping condition is met (should stop).
    def update(self, metric_value: float) -> bool:
        val = float(metric_value)
        if math.isnan(val) or math.isinf(val):
            # Treat NaN as non-improvement.
            self._num_bad += 1
            return self.should_stop()

        if self._best is None:
            self._best = val
            self._num_bad = 0
            self._should_stop = False
            return False

        improved = False
        if self._mode == "max":
            improved = val > float(self._best) + float(self._min_delta)
        else:
            improved = val < float(self._best) - float(self._min_delta)

        if improved:
            self._best = val
            self._num_bad = 0
            self._should_stop = False
            return False

        self._num_bad += 1
        if self._patience > 0 and self._num_bad >= self._patience:
            self._should_stop = True
        return self._should_stop

    ## @brief Query whether training should stop.
    # @param None
    # @return bool True if early stopping condition has been met.
    def should_stop(self) -> bool:
        return bool(self._should_stop)

    ## @brief Return callback state for serialization.
    # @param None
    # @return dict[str, Any] Serializable state dict.
    def state_dict(self) -> Dict[str, Any]:
        return {
            "mode": str(self._mode),
            "patience": int(self._patience),
            "min_delta": float(self._min_delta),
            "best": None if self._best is None else float(self._best),
            "num_bad_evals": int(self._num_bad),
            "should_stop": bool(self._should_stop),
        }


## @brief Time-to-accuracy (TTA) tracker callback.
# @details
# Tracks the first time a monitored metric reaches a target threshold, recording elapsed time and step.
# For faithful reproduction, the target threshold itself should be computed by the Trainer based on
# "97% of full fine-tuning performance" (paper) and passed here as target_metric_value.
class TTATrackerCallback:
    ## @brief Initialize TTA tracker.
    # @param metric_name str Name of the monitored metric (e.g., "accuracy", "f1", "rougeL").
    # @param target_metric_value Optional[float] Absolute target threshold for the monitored metric.
    # @param enabled bool Whether TTA tracking is enabled.
    # @param output_dir str Directory for writing callback metadata JSON.
    def __init__(
        self,
        metric_name: str,
        target_metric_value: Optional[float] = None,
        enabled: bool = False,
        output_dir: str = "outputs",
    ) -> None:
        self._logger = get_logger(self.__class__.__name__)
        self._metric_name: str = str(metric_name)
        self._target_metric_value: Optional[float] = None if target_metric_value is None else float(target_metric_value)
        self._enabled: bool = bool(enabled)
        self._output_dir: str = str(output_dir)

        self._crossed: bool = False
        self._time_to_accuracy_s: Optional[float] = None
        self._step_at_tta: Optional[int] = None
        self._epoch_at_tta: Optional[int] = None
        self._stage_at_tta: Optional[str] = None

    ## @brief Enable TTA tracking with a target threshold.
    # @param target_metric_value float Absolute target threshold.
    # @return None
    def enable(self, target_metric_value: float) -> None:
        self._target_metric_value = float(target_metric_value)
        self._enabled = True

    ## @brief Update tracker with a new evaluation metric and elapsed time.
    # @param metric_value float Current monitored metric value.
    # @param elapsed_time_s float Elapsed training wall-clock time in seconds at this evaluation.
    # @param step int Global step.
    # @param epoch int Epoch.
    # @param stage str Optional stage label ("pruning" / "recovery").
    # @return bool True if the threshold was crossed for the first time at this update.
    def update(
        self,
        metric_value: float,
        elapsed_time_s: float,
        step: int,
        epoch: int,
        stage: str = "",
    ) -> bool:
        if not self._enabled:
            return False
        if self._crossed:
            return False
        if self._target_metric_value is None:
            return False

        val = float(metric_value)
        if math.isnan(val) or math.isinf(val):
            return False

        if val >= float(self._target_metric_value):
            self._crossed = True
            self._time_to_accuracy_s = float(elapsed_time_s)
            self._step_at_tta = int(step)
            self._epoch_at_tta = int(epoch)
            self._stage_at_tta = str(stage)
            return True

        return False

    ## @brief Persist TTA metadata to disk as JSON.
    # @param filename str Output JSON filename (default: "tta.json").
    # @return str Path to written JSON.
    def save_metadata(self, filename: str = "tta.json") -> str:
        out_path = Path(self._output_dir) / str(filename)
        return save_json(out_path, self.state_dict())

    ## @brief Return callback state for serialization.
    # @return dict[str, Any] Serializable state dict.
    def state_dict(self) -> Dict[str, Any]:
        return {
            "metric_name": str(self._metric_name),
            "enabled": bool(self._enabled),
            "target_metric_value": None if self._target_metric_value is None else float(self._target_metric_value),
            "crossed": bool(self._crossed),
            "time_to_accuracy_s": None if self._time_to_accuracy_s is None else float(self._time_to_accuracy_s),
            "step_at_tta": self._step_at_tta,
            "epoch_at_tta": self._epoch_at_tta,
            "stage_at_tta": self._stage_at_tta,
        }

    ## @brief Return whether the TTA threshold has been crossed.
    # @param None
    # @return bool True if crossed.
    def crossed(self) -> bool:
        return bool(self._crossed)

    ## @brief Get recorded time-to-accuracy if available.
    # @param None
    # @return Optional[float] Time to accuracy in seconds.
    def time_to_accuracy_s(self) -> Optional[float]:
        return self._time_to_accuracy_s


## @brief Simple callback bundle to reduce Trainer wiring complexity.
# @details
# This class is a convenience aggregator; it does not implement training logic.
# Trainer can use it to centralize scheduling and state serialization.
@dataclass
class CallbackBundle:
    ## @brief One-line description.
    # @param eval_scheduler EvalSchedulerCallback Evaluation scheduler callback.
    # @param checkpoint CheckpointCallback Checkpoint callback.
    # @param best_metric BestMetricCallback Best metric callback.
    # @param tta TTATrackerCallback TTA tracker callback.
    # @param early_stopping Optional[EarlyStoppingCallback] Early stopping callback (optional).
    eval_scheduler: EvalSchedulerCallback
    checkpoint: CheckpointCallback
    best_metric: BestMetricCallback
    tta: TTATrackerCallback
    early_stopping: Optional[EarlyStoppingCallback] = None

    ## @brief Serialize all callback states to a single JSON file.
    # @param output_dir str Output directory for JSON.
    # @param filename str Output JSON filename (default: "callbacks_state.json").
    # @return str Path to written JSON.
    def save_all(self, output_dir: str, filename: str = "callbacks_state.json") -> str:
        out_path = Path(str(output_dir)) / str(filename)
        payload: Dict[str, Any] = {
            "eval_scheduler": self.eval_scheduler.state_dict(),
            "checkpoint": self.checkpoint.state_dict(),
            "best_metric": self.best_metric.state_dict(),
            "tta": self.tta.state_dict(),
            "early_stopping": None if self.early_stopping is None else self.early_stopping.state_dict(),
        }
        return save_json(out_path, payload)
